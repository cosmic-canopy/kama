// Probe: can `Copyable` require a CTOR instead of a self-returning instance method?
type contract Dup for resource { ctor duplicate(ref This source); }

type resource Buf implements Dup {
    Ptr<int32> p = null;
    int32 n = 0;
    public ctor make(int32 n) { Buf b; b.n = n; return give b; }
    public ctor duplicate(ref Buf source) { Buf b; b.n = source.n; return give b; }
    public fn int32 size() { return this.n; }
}
fn int32 main() {
    Buf a = Buf.make(n: 7);
    Buf b = Buf.duplicate(source: a);
    return b.size();
}
