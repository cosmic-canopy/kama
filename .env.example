# Copy to .env and fill in. Loaded by `./ops` (maintainer tasks); `./dev` needs no secrets.
# Add the SAME names+values as GitHub Actions repo secrets for CI (see docs/PUBLISHING.md).

# VS Code extension publishing
VSCE_PAT=               # Azure DevOps PAT, scope: Marketplace -> Manage
OVSX_PAT=              # open-vsx.org access token

# Cloudflare (Pages deploy + OpenTofu)
CLOUDFLARE_API_TOKEN=  # scopes: Account->Cloudflare Pages:Edit, Zone->DNS:Edit (kama-lang.org)
CLOUDFLARE_ACCOUNT_ID= # Cloudflare dashboard -> Account ID

# OpenTofu vars (tofu auto-reads TF_VAR_*)
TF_VAR_account_id=     # = CLOUDFLARE_ACCOUNT_ID
TF_VAR_zone_id=        # kama-lang.org Zone ID (Cloudflare -> the domain -> Zone ID)
