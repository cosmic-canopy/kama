// The implicit prelude — library sum types + language-level contracts available to every program
// without an import. Registered in the empty (global) namespace so `Optional`/`Result`/the contracts
// resolve unqualified everywhere (like the builtin collections). Embedded into the compiler binary at
// build time (see tools/embed_prelude.sh), so a `--no-std` install still carries the language core.
// This file was the `PRELUDE_SRC` C string literal in kama.driver.cpp; keep its declaration ORDER
// (contracts before the conformances that satisfy them).

type enum Optional<T> { Some(T value), None }
type enum Result<T, E: Error> { Ok(T value), Err(E error) }
// The empty value — the payload for a fallible op that succeeds with nothing to return
// (`Result<Unit, E>`, the analogue of Rust's `Result<(), E>`). Keeps ONE error convention
// (always Result) whether or not there is a value; no dead/placeholder payload. A single-variant
// enum (like `None`) so it lives in the prelude without needing value-type ctor emission.
type enum Unit { Unit }
// The result of a three-way comparison (`Comparable.compareTo`). A single enum (not a signed int) keeps
// ordering explicit and matchable — the ordering protocol for sorted containers + `PriorityQueue`.
type enum Ordering { Less, Equal, Greater }
// Auto-deref opt-in: a type implementing Deref<T> forwards member access to its pointee `T`
// (`ptr.method()`/`ptr.field` -> the T). The contract is the gate (explicit, nominal); the smart
// pointers become ordinary kama types over this instead of compiler intrinsics.
type contract Deref<T> for both { fn ref T deref(); }
// Heap-owner opt-in: a type implementing HeapOwner<T> can be a `new T(args)` target. `new`
// placement-constructs T on the heap (0 copies) and hands the raw Ptr<T> to `adopt`, which wraps it.
// `new` stays valid ONLY into such an owner, so it can never leak a bare raw pointer.
// Construction-model (M8): `adopt` is a `ctor` — wrapping a raw block IS construction. Storing a `Ptr`
// is safe (no `unsafe`); only dereferencing is (that lives in `~Owned`/`deref`).
type contract HeapOwner<T> for resource { ctor adopt(Ptr<T> raw); }
// Ownership capability markers (compiler-recognized). EVERY owning kind is movable — `give` moves it
// (see TYPE_MODEL.md; there is no `!Movable`). `Copyable` = a public `copy` CTOR; a resource that
// implements it is ALSO duplicable. A `Copyable(bare: copy)` resource = shared-ownership: a bare
// hand-off RETAINS (constructs a copy), while `give` still MOVES the handle (the `Shared`/`Weak` model).
type contract Movable for resource { }
// `copy` is a CTOR, not a self-returning method: a copy IS a new object, so it construct-shaped like
// every other factory (M8e had already ruled that shape out for a self-returning `static fn`; this was
// the last member that escaped it by taking `self`). The source is BORROWED (`ref This`) — copying
// never consumes it. Emitted C is unchanged (`X__copy(X* source)`), so `copy x` lowers as before.
type contract Copyable<T is This> for resource { ctor copy(ref T source); }
// Hashing + equality opt-in (the `Map`/`Set` key protocol, nominal). A generic bound `<K: Hashable +
// Equatable>` is NOMINAL — the type must DECLARE `implements` (a coincidental method set isn't enough).
// `string` declares both below, like every other type: `Equatable` with an empty body (its `equals` is the
// built-in one) and `Hashable` with a pure-kama FNV-1a. Both contracts live in the prelude because they
// are language-level bounds.
//
// COMPARISON IS THESE CONTRACTS — there is no `operator==`. `a == b` / `a != b` lower to `equals`, and
// `a < b` / `>` / `<=` / `>=` lower to `compareTo`; declaring those six as operator members is a compile
// error. That is the whole point: a type cannot have an `==` that disagrees with its `<K: Equatable>`
// bound, which is how C# ended up with `operator==`, `Equals`, `IEquatable<T>` and `EqualityComparer`
// all able to give different answers. Every OTHER operator (`+`, `*`, `[]`, …) stays an ordinary
// operator member — those are concrete-type ergonomics; these two are the operators a generic bound
// must be able to NAME. Primitives are untouched: an all-primitive comparison keeps the built-in C
// operator, so `float` keeps exact IEEE semantics and pays nothing.
type contract Hashable for both { fn uint64 hash(); }
type contract Equatable<T is This> for both { fn bool equals(ref T other); }
// Total ordering opt-in (nominal, like Equatable) — the bound for sorted containers (`SortedMap`/`SortedSet`,
// B-tree) and `PriorityQueue` (binary heap). `compareTo` returns `Ordering`, three-way in ONE call (no
// separate `<`/`==`). The operand is borrowed (`ref This`) — a comparison never consumes it, and a large
// key (`string`) isn't copied; `Equatable.equals` borrows for the same reason. Primitive conformances
// below make every int/float/string universally comparable.
type contract Comparable<T is This> for both { fn Ordering compareTo(ref T other); }
// The pluggable memory source — a copyable VALUE handle (C++ `std::pmr::polymorphic_allocator`, Rust
// `&Bump`, Zig `std.mem.Allocator`). An `Owned<T, A>` box or a container carries `A alloc` BY VALUE and
// routes every allocation through `this.alloc.allocate(...)` / `this.alloc.deallocate(...)`. FOUNDATIONAL
// like the bounds above, so it lives in the global prelude — both the smart-pointer triad and the
// collections name it, and it survives `--no-std`. `for value` (a cheap copyable handle); INSTANCE
// methods (unlike `Hasher`'s static finalizer) because a stateful allocator mutates through its stored
// pointer. FALLIBLE seam (MCU step 5): `allocate` returns `Optional<Ptr>` — `None` on OOM/exhaustion,
// never panics. Infallible `new`/collections unwrap-or-panic (via `unwrapPtr`) to keep pre-step-5
// behavior; the ONE non-panic construction entry is `try new` (yields `None`). A no-heap region
// (`@noheap`/`--no-heap`) rejects this whole path at the allocation-emission site.
// The concrete STRATEGY types (`Arena`/`BumpAllocator`) stay in `std::collections` (opt-in, not core).
type contract Allocator for value {
    fn Optional<Ptr> allocate(usize bytes);
    fn void deallocate(Ptr pointer, usize bytes);
}
// The base error contract (Model C — Kama's answer to exceptions). Every fallible constructor (eventually
// every fallible fn) returns `Result<This, Error>`; a concrete error is an ordinary `type enum` that
// declares `implements Error` and is BOXED into an `Owned<Error>` fat handle at the boundary (Swift's `enum X: Error`
// model). `for both` — an error may be a value/enum or a resource. `message()` gives every error a uniform,
// dynamically-dispatched description; branch on the specific kind by recovering the concrete enum with
// `error.as<ConcreteError>()`. Language-level, so it lives in the prelude and survives `--no-std`.
type contract Error for both { fn string message(); }
// Primitive conformances (pure-kama, NO compiler blessing) — hosted here so `string`/`int32` satisfy the
// standard bounds UNIVERSALLY (a `<T: Equatable>` bound, `DynamicArray<int32>.contains`, an int-keyed
// `Map`) without importing `std::collections`. `hash()` returns a CHEAP CONTENT hash (identity for integers,
// FNV-1a for strings); the AVALANCHE/mixer is a separate, pluggable step the `Map`/`Set` apply via their
// `Hasher::finish` (default `DefaultHasher` = splitmix64, in std::collections). Splitting the two lets a
// caller swap a cheaper mixer for trusted keys. `string` Hashable = FNV-1a over its UTF-8 bytes (already a
// distributed accumulator — a string has no meaningful un-mixed scalar; the Map's finalizer re-mixes it
// harmlessly, splitmix being a bijection); its `Equatable` comes free from the built-in `equals`.
//
// A primitive declares conformance the same way every other kind does: `type intrinsic <targets>
// implements C`. The set form is what makes these ONE declaration each — `ref This other` is the target
// being decorated, so a body that is genuinely identical across widths is written once.
// `string`'s `equals` is NATIVE — the compiler supplies it — so the conformance is a declaration and
// nothing more, and the empty body is the point rather than a stub: completeness is checked against the
// type's method map, which already holds `equals`. Until this line existed the compiler had to assert this
// conformance on `string`'s behalf inside `registerCollection`, because an intrinsic had no way to say
// `implements`. That was the last conformance in the language a type did not declare for itself.
type intrinsic <string> implements Equatable<This> { }
type intrinsic <string> implements Hashable {
    public fn uint64 hash() {
        uint64 h = 2166136261ui64;
        int32 i = 0;
        while (i < cast<int32>(this.length())) {
            h = (h ^ cast<uint64>(this[i])) * 16777619ui64;
            i = i + 1;
        }
        return h;
    }
}
// Every integer width is its own content hash — `cast<uint64>(this)` (signed widths sign-extend, which is
// fine: equal values still hash equal; on uint64 the cast is the identity) + scalar `equals` — so every
// integer type is a universal `Map`/`Set` key and satisfies `<T: Hashable + Equatable>` without an import.
// The `Map`'s `Hasher::finish` supplies the avalanche; a well-behaved key sequence (0,1,2,…) maps to
// consecutive slots, which open addressing handles fine, and `FastHasher` can be selected to skip
// splitmix entirely for such keys.
type intrinsic <int8, int16, int32, int64, uint8, uint16, uint32, uint64> implements Hashable {
    public fn uint64 hash() { return cast<uint64>(this); }
}
// Floats join the `Equatable` set (exact `==`, like Rust's `PartialEq<f64>`) so `<T: Equatable>` bounds and
// `DynamicArray<float*>.contains` work — but they are NOT `Hashable`: float hash keys are a footgun
// (NaN != NaN, ±0.0), and there is no bit-reinterpret cast, so a value-cast hash would collide badly. Add
// on demand if ever needed via a bit-cast helper. `string` is absent for the opposite reason — its
// `Equatable` comes free from the built-in `equals`.
type intrinsic <int8, int16, int32, int64, uint8, uint16, uint32, uint64, float32, float64>
    implements Equatable<This> {
    public fn bool equals(ref This other) { return this == other; }
}
// `Comparable` (pure-kama, NO compiler blessing) — every int/float is totally ordered via a three-way
// `<`/`>` fold to `Ordering`, and `string` is compared lexicographically over its UTF-8 bytes (unsigned
// `s[i]`, so byte order == codepoint order for ASCII and correct byte-wise order elsewhere).
type intrinsic <int8, int16, int32, int64, uint8, uint16, uint32, uint64> implements Comparable<This> {
    public fn Ordering compareTo(ref This other) {
        if (this < other) { return Ordering::Less; }
        if (this > other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}
// Floats need a TOTAL order here, which IEEE `<`/`>` alone cannot give: with a NaN operand both are false,
// so a bare three-way fold returns `Equal` and NaN compares equal to EVERYTHING — silently corrupting the
// `SortedMap`/`SortedSet` B-tree and the `PriorityQueue` heap (lookups become insertion-order dependent).
// So NaN sorts AFTER every number and equals itself — Rust's `f64::total_cmp`. This diverges from `equals`
// (IEEE `==`, where NaN != NaN) exactly as Rust's `total_cmp` diverges from `PartialEq`, and the two never
// meet: a float is deliberately NOT `Hashable`, so the sorted containers (compareTo) and the hashed ones
// (hash + equals) never see the same key type. Raw `a < b` on two floats is untouched — an all-primitive
// comparison keeps the built-in C operator and never routes through `compareTo`.
type intrinsic <float32, float64> implements Comparable<This> {
    public fn Ordering compareTo(ref This other) {
        if (this < other) { return Ordering::Less; }
        if (this > other) { return Ordering::Greater; }
        if (this != this) { if (other != other) { return Ordering::Equal; } return Ordering::Greater; }
        if (other != other) { return Ordering::Less; }
        return Ordering::Equal;
    }
}
type intrinsic <string> implements Comparable<This> {
    public fn Ordering compareTo(ref This other) {
        int32 n = cast<int32>(this.length());
        int32 m = cast<int32>(other.length());
        int32 lim = n; if (m < n) { lim = m; }
        int32 i = 0;
        while (i < lim) {
            uint8 a = this[i]; uint8 b = other[i];
            if (a < b) { return Ordering::Less; }
            if (a > b) { return Ordering::Greater; }
            i = i + 1;
        }
        if (n < m) { return Ordering::Less; }
        if (n > m) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}
// Iteration opt-in (the `foreach` protocol, nominal). An iterator declares which it provides;
// `foreach` verifies the declaration and emits DIRECT (monomorphized) calls — no vtable, zero-cost.
// `Iterator<T>` yields each element BY VALUE (a copy); `IteratorMut<T>` yields a mutable place
// (`ref T`) so `foreach (ref T x in c)` can write through it (Optional can't carry a place, so the
// two are parallel — Rust's iter()/iter_mut() split). A container hands one out via a nullary
// `iterator()` / `iterMut()` factory method.
type contract Iterator<T> for both { fn Optional<T> next(); }
type contract IteratorMut<T> for both { fn bool hasNext(); fn ref T next(); }
// Container-side opt-in: a type that `implements Iterable<T>` hands out a by-value iterator via a
// nullary `iterator()`; `IterableMut<T>` hands out a mutable iterator via `iterMut()`. `foreach`
// requires the container to declare the matching one (nominal on both sides). A type that is its OWN
// iterator (implements `Iterator<T>` and is iterated directly) needs no `Iterable`.
type contract Iterable<T> for both { fn Iterator<T> iterator(); }
type contract IterableMut<T> for both { fn IteratorMut<T> iterMut(); }
// Serialization capability contracts (the `@generate` protocol). Like the iteration contracts these are
// language-level bounds, so they live in the prelude: `Serializer` is the pluggable output sink a backend
// (std::json, …) implements; `Serialize` is what a `@generate(Serialize)` type gets (compiler-synthesized)
// or a custom serializer hand-writes. Per-width scalar methods let a binary backend pack tight while text
// backends widen. Declaration-only — zero cost unless a program actually serializes.
type contract Serializer for resource {
    fn void beginObject(); fn void endObject(); fn void fieldName(string name);
    fn void beginArray(usize count); fn void endArray();
    fn void writeI8(int8 v); fn void writeI16(int16 v); fn void writeI32(int32 v); fn void writeI64(int64 v);
    fn void writeU8(uint8 v); fn void writeU16(uint16 v); fn void writeU32(uint32 v); fn void writeU64(uint64 v);
    fn void writeF32(float32 v); fn void writeF64(float64 v);
    fn void writeBool(bool v); fn void writeChar(char v); fn void writeString(ref string v); fn void writeNull();
    // Graph/pointer serialization framing (used only by a graph `@generate` type — see std::serialization::graph).
    // `writeRef` writes a pointer field as an integer id; `beginGraph`/`beginTableEntry`/`endTableEntry`/`endGraph`
    // frame the `{"root":id,"objects":{id:{"__type":..,..}}}` id table. Text backends widen; a binary backend packs.
    fn void writeRef(uint64 id);
    fn void beginGraph(uint64 rootId); fn void beginTableEntry(uint64 id, string ty);
    fn void endTableEntry(); fn void endGraph();
    // STICKY error model (mirror of Deserializer): a write that can't proceed — an I/O sink error, or a
    // value the format can't represent (`NaN`/`Inf` in JSON) — sets `failed()` and records a `SerError`.
    // A fallible `serialize` writes bare (no per-write branching) and checks `failed()` once at the end.
    fn bool failed(); fn void fail(); fn void failWith(SerError e); fn SerError errorCode();
}
// SerError is the write-side twin of DeError: a first-class `Error` that BOXES into `Owned<Error>` at a
// fallible-`serialize` boundary and is recovered with `err.as<SerError>()`.
type enum SerError implements Error {
    NotRepresentable, IoError;

    public fn string message() {
        return match (this) {
            case NotRepresentable:  "value not representable in this format";
            case IoError:           "serialization i/o error";
        };
    }
}
// A fallible METHOD (not a ctor — write produces nothing, so `Result<Unit, …>`; read constructs a `T`, so
// `Result<This, …>`). The ONE principled read/write asymmetry. Boxed `Owned<Error>` currency, same as read.
type contract Serialize for both { fn Result<Unit, std::memory::Owned<Error>> serialize(ref Serializer w); }
// Deserialization: `Deserializer` is the pluggable input source (a backend's reader implements it, using
// a STICKY error flag — a read on malformed input sets `failed()` and returns a default, so the generated
// `deserialize` needs no per-read branching; `tryParse` checks `failed()` once at the end). `Deserialize`
// is the per-type capability the codegen synthesizes: a static factory `deserialize(ref Deserializer)`.
// DeError is a first-class `Error`: it BOXES into `Owned<Error>` at a fallible-`deserialize` boundary
// and is recovered with `err.as<DeError>()`. (Declaring a method-carrying contract gives this
// payload-less enum a tagged repr — transparent to its by-value uses.)
type enum DeError implements Error {
    Malformed, UnexpectedEnd, TypeMismatch, MissingField, UnresolvedReference, DuplicateId;

    public fn string message() {
        return match (this) {
            case Malformed:            "malformed input";
            case UnexpectedEnd:        "unexpected end of input";
            case TypeMismatch:         "type mismatch";
            case MissingField:         "missing field";
            case UnresolvedReference:  "unresolved reference";
            case DuplicateId:          "duplicate id";
        };
    }
}
type contract Deserializer for resource {
    fn void beginObject(); fn bool moreFields(); fn string fieldName();
    fn void beginArray(); fn bool moreElems();
    fn int8 readI8(); fn int16 readI16(); fn int32 readI32(); fn int64 readI64();
    fn uint8 readU8(); fn uint16 readU16(); fn uint32 readU32(); fn uint64 readU64();
    fn float32 readF32(); fn float64 readF64();
    fn bool readBool(); fn char readChar(); fn string readString();
    fn bool readNull(); fn void skipValue(); fn bool failed(); fn void fail();
    // Graph (object-table) reads — the deserialize twin of the Serializer's writeRef/beginGraph/…: `beginGraph`
    // consumes `{"root":id,"objects":` (bookmarking the objects `{` for the two-pass rewind) and returns the
    // root id; `rewindGraph` re-enters that table for pass 2; `readRef` reads a bare id; `endGraph` closes the
    // envelope; `failWith` records a specific DeError (so a dangling ref surfaces `UnresolvedReference`, not the
    // generic `Malformed`). A non-graph backend can no-op these.
    fn uint64 beginGraph(); fn void rewindGraph(); fn uint64 entryKey(); fn uint64 readRef();
    fn void endGraph(); fn void failWith(DeError e); fn DeError errorCode();
}
// A marker contract (like Movable): the `@generate(Deserialize)` codegen supplies the static factory
// `deserialize(ref Deserializer) -> Result<This, DeError>` as an injected conformance, and `tryParse<T: Deserialize>`
// calls `T.deserialize(...)` statically. Kept method-less so its signature needn't name `This` in a
// return position (which the generic-instance machinery can't resolve outside a type).
type contract Deserialize for both { }
// Primitive Serialize/Deserialize conformances (pure-kama, like the Hashable/Equatable ones above) — so
// EVERY type is a uniform serialization participant and a collection's generic element write
// (`this[i].serialize(w)`) / read (`T.deserialize(r)`) composes for a scalar element with no compiler
// special-casing. `serialize` writes the width-appropriate scalar; the static `deserialize` factory reads
// it back (the impl static path — see the `_primConformances` branch in the `Type::method` resolver).
//
// ONE TARGET PER BLOCK, unlike the contracts above: every body names a width-specific writer/reader
// (`writeI8` vs `writeI16`), and a shared body cannot call a different function per target — kama has no
// in-body type branching by design. Nothing is gained by wrapping thirteen distinct bodies in one block's
// specialization sections. They collapse for real once the writer itself goes generic.
// Each primitive `serialize` is fallible: write (sticky), then wrap — a sink/format failure surfaces as
// `Err(SerError)` boxed into `Owned<Error>` (via `errorCode()`). Composition propagates the box.
type intrinsic <int8>    implements Serialize    { public fn Result<Unit, std::memory::Owned<Error>> serialize(ref Serializer w) { w.writeI8(v: this);   if (w.failed()) { SerError e = w.errorCode(); return Result::Err(error: e); } return Result::Ok(value: Unit::Unit); } }
type intrinsic <int16>   implements Serialize    { public fn Result<Unit, std::memory::Owned<Error>> serialize(ref Serializer w) { w.writeI16(v: this);  if (w.failed()) { SerError e = w.errorCode(); return Result::Err(error: e); } return Result::Ok(value: Unit::Unit); } }
type intrinsic <int32>   implements Serialize    { public fn Result<Unit, std::memory::Owned<Error>> serialize(ref Serializer w) { w.writeI32(v: this);  if (w.failed()) { SerError e = w.errorCode(); return Result::Err(error: e); } return Result::Ok(value: Unit::Unit); } }
type intrinsic <int64>   implements Serialize    { public fn Result<Unit, std::memory::Owned<Error>> serialize(ref Serializer w) { w.writeI64(v: this);  if (w.failed()) { SerError e = w.errorCode(); return Result::Err(error: e); } return Result::Ok(value: Unit::Unit); } }
type intrinsic <uint8>   implements Serialize    { public fn Result<Unit, std::memory::Owned<Error>> serialize(ref Serializer w) { w.writeU8(v: this);   if (w.failed()) { SerError e = w.errorCode(); return Result::Err(error: e); } return Result::Ok(value: Unit::Unit); } }
type intrinsic <uint16>  implements Serialize    { public fn Result<Unit, std::memory::Owned<Error>> serialize(ref Serializer w) { w.writeU16(v: this);  if (w.failed()) { SerError e = w.errorCode(); return Result::Err(error: e); } return Result::Ok(value: Unit::Unit); } }
type intrinsic <uint32>  implements Serialize    { public fn Result<Unit, std::memory::Owned<Error>> serialize(ref Serializer w) { w.writeU32(v: this);  if (w.failed()) { SerError e = w.errorCode(); return Result::Err(error: e); } return Result::Ok(value: Unit::Unit); } }
type intrinsic <uint64>  implements Serialize    { public fn Result<Unit, std::memory::Owned<Error>> serialize(ref Serializer w) { w.writeU64(v: this);  if (w.failed()) { SerError e = w.errorCode(); return Result::Err(error: e); } return Result::Ok(value: Unit::Unit); } }
type intrinsic <float32> implements Serialize    { public fn Result<Unit, std::memory::Owned<Error>> serialize(ref Serializer w) { w.writeF32(v: this);  if (w.failed()) { SerError e = w.errorCode(); return Result::Err(error: e); } return Result::Ok(value: Unit::Unit); } }
type intrinsic <float64> implements Serialize    { public fn Result<Unit, std::memory::Owned<Error>> serialize(ref Serializer w) { w.writeF64(v: this);  if (w.failed()) { SerError e = w.errorCode(); return Result::Err(error: e); } return Result::Ok(value: Unit::Unit); } }
type intrinsic <bool>    implements Serialize    { public fn Result<Unit, std::memory::Owned<Error>> serialize(ref Serializer w) { w.writeBool(v: this); if (w.failed()) { SerError e = w.errorCode(); return Result::Err(error: e); } return Result::Ok(value: Unit::Unit); } }
type intrinsic <char>    implements Serialize    { public fn Result<Unit, std::memory::Owned<Error>> serialize(ref Serializer w) { w.writeChar(v: this); if (w.failed()) { SerError e = w.errorCode(); return Result::Err(error: e); } return Result::Ok(value: Unit::Unit); } }
type intrinsic <string>  implements Serialize    { public fn Result<Unit, std::memory::Owned<Error>> serialize(ref Serializer w) { w.writeString(v: this); if (w.failed()) { SerError e = w.errorCode(); return Result::Err(error: e); } return Result::Ok(value: Unit::Unit); } }
// Each primitive `deserialize` is fallible: read (sticky), then wrap — a bad read surfaces as
// `Err(DeError)` boxed into `Owned<Error>` (via `errorCode()`). Composition propagates the box.
type intrinsic <int8>    implements Deserialize  { public ctor Result<int8, std::memory::Owned<Error>>    deserialize(Deserializer r) { int8    v = r.readI8();     if (r.failed()) { DeError e = r.errorCode(); return Result::Err(error: e); } return Result::Ok(value: v); } }
type intrinsic <int16>   implements Deserialize  { public ctor Result<int16, std::memory::Owned<Error>>   deserialize(Deserializer r) { int16   v = r.readI16();    if (r.failed()) { DeError e = r.errorCode(); return Result::Err(error: e); } return Result::Ok(value: v); } }
type intrinsic <int32>   implements Deserialize  { public ctor Result<int32, std::memory::Owned<Error>>   deserialize(Deserializer r) { int32   v = r.readI32();    if (r.failed()) { DeError e = r.errorCode(); return Result::Err(error: e); } return Result::Ok(value: v); } }
type intrinsic <int64>   implements Deserialize  { public ctor Result<int64, std::memory::Owned<Error>>   deserialize(Deserializer r) { int64   v = r.readI64();    if (r.failed()) { DeError e = r.errorCode(); return Result::Err(error: e); } return Result::Ok(value: v); } }
type intrinsic <uint8>   implements Deserialize  { public ctor Result<uint8, std::memory::Owned<Error>>   deserialize(Deserializer r) { uint8   v = r.readU8();     if (r.failed()) { DeError e = r.errorCode(); return Result::Err(error: e); } return Result::Ok(value: v); } }
type intrinsic <uint16>  implements Deserialize  { public ctor Result<uint16, std::memory::Owned<Error>>  deserialize(Deserializer r) { uint16  v = r.readU16();    if (r.failed()) { DeError e = r.errorCode(); return Result::Err(error: e); } return Result::Ok(value: v); } }
type intrinsic <uint32>  implements Deserialize  { public ctor Result<uint32, std::memory::Owned<Error>>  deserialize(Deserializer r) { uint32  v = r.readU32();    if (r.failed()) { DeError e = r.errorCode(); return Result::Err(error: e); } return Result::Ok(value: v); } }
type intrinsic <uint64>  implements Deserialize  { public ctor Result<uint64, std::memory::Owned<Error>>  deserialize(Deserializer r) { uint64  v = r.readU64();    if (r.failed()) { DeError e = r.errorCode(); return Result::Err(error: e); } return Result::Ok(value: v); } }
type intrinsic <float32> implements Deserialize  { public ctor Result<float32, std::memory::Owned<Error>> deserialize(Deserializer r) { float32 v = r.readF32();    if (r.failed()) { DeError e = r.errorCode(); return Result::Err(error: e); } return Result::Ok(value: v); } }
type intrinsic <float64> implements Deserialize  { public ctor Result<float64, std::memory::Owned<Error>> deserialize(Deserializer r) { float64 v = r.readF64();    if (r.failed()) { DeError e = r.errorCode(); return Result::Err(error: e); } return Result::Ok(value: v); } }
type intrinsic <bool>    implements Deserialize  { public ctor Result<bool, std::memory::Owned<Error>>    deserialize(Deserializer r) { bool    v = r.readBool();   if (r.failed()) { DeError e = r.errorCode(); return Result::Err(error: e); } return Result::Ok(value: v); } }
type intrinsic <char>    implements Deserialize  { public ctor Result<char, std::memory::Owned<Error>>    deserialize(Deserializer r) { char    v = r.readChar();   if (r.failed()) { DeError e = r.errorCode(); return Result::Err(error: e); } return Result::Ok(value: v); } }
type intrinsic <string>  implements Deserialize  { public ctor Result<string, std::memory::Owned<Error>>  deserialize(Deserializer r) { string  v = r.readString(); if (r.failed()) { DeError e = r.errorCode(); return Result::Err(error: e); } return Result::Ok(value: give v); } }
// Generic deserialize trampoline: the `@generate` codegen can't spell `DynamicArray<int32>::deserialize(r)` (a
// static on a generic instance has no surface syntax), but a turbofish on THIS free fn does
// (`__kamaDeserialize::<DynamicArray<int32>>(r)`), and inside it `T::deserialize` resolves per instantiation.
fn Result<T, std::memory::Owned<Error>> __kamaDeserialize<T: Deserialize>(Deserializer r) { return T.deserialize(r: r); }
// The `.chars()` codepoint iterator over a string's UTF-8 bytes. Decodes one Unicode scalar value
// per `next()`; the compiler constructs it from a string's bytes (a borrow — valid while the string
// is). Assumes well-formed UTF-8 (string literals/concat are); a truncated trailing sequence is
// clamped to the available bytes rather than reading past the end.
type value Chars implements Iterator<char> {
    Ptr<uint8> data; int32 len; int32 pos;
    public fn Optional<char> next() {
        if (this.pos >= this.len) { return Optional::None; }
        uint32 c0 = 0; unsafe { c0 = cast<uint32>(this.data[this.pos]); }
        uint32 cp = c0; int32 n = 1;
        if (c0 >= 240ui32) { cp = c0 & 7ui32; n = 4; }
        else if (c0 >= 224ui32) { cp = c0 & 15ui32; n = 3; }
        else if (c0 >= 192ui32) { cp = c0 & 31ui32; n = 2; }
        if (this.pos + n > this.len) { n = this.len - this.pos; }
        int32 i = 1;
        while (i < n) {
            uint32 cc = 0; unsafe { cc = cast<uint32>(this.data[this.pos + i]); }
            cp = (cp << 6ui32) | (cc & 63ui32); i = i + 1;
        }
        this.pos = this.pos + n;
        return Optional::Some(value: cast<char>(cp));
    }
}
// The `.split(separator:)` iterator over a string's UTF-8 bytes. Like `Chars` it borrows the source
// bytes (a raw `Ptr<uint8>`, so `Split` stays a POD `value` type) — valid while the source string is —
// but here it ALSO borrows the separator's bytes, and yields each piece as an OWNED string. The
// byte-range copy is done by a tiny runtime helper (kama can't allocate a string from raw bytes on its
// own). Byte semantics (a literal separator), Go `strings.Split` behaviour: consecutive/trailing
// separators yield "" pieces; an empty separator yields the whole string once.
extern fn string kama_string_from_raw(Ptr<uint8> src, int32 start, int32 len);
type value Split implements Iterator<string> {
    Ptr<uint8> data; int32 len; Ptr<uint8> sep; int32 seplen; int32 pos; bool done;
    public fn Optional<string> next() {
        if (this.done) { return Optional::None; }
        if (this.seplen == 0) {
            this.done = true;
            return Optional::Some(value: kama_string_from_raw(src: this.data, start: this.pos, len: this.len - this.pos));
        }
        int32 i = this.pos;
        while (i + this.seplen <= this.len) {
            bool m = true; int32 k = 0;
            while (k < this.seplen) {
                uint8 a = 0ui8; uint8 b = 0ui8;
                unsafe { a = this.data[i + k]; b = this.sep[k]; }
                if (a != b) { m = false; break; }
                k = k + 1;
            }
            if (m) {
                int32 st = this.pos;
                this.pos = i + this.seplen;
                return Optional::Some(value: kama_string_from_raw(src: this.data, start: st, len: i - st));
            }
            i = i + 1;
        }
        this.done = true;
        return Optional::Some(value: kama_string_from_raw(src: this.data, start: this.pos, len: this.len - this.pos));
    }
}

// ── Command-line arguments + environment (prelude floor) ──────────────────────────────────────────────
// argv/env access lives in the FLOOR (survives --no-std), so it can't hand back a std::collections type
// (DynamicArray/View aren't collected this early). `Args` is the single handle: a cursor that `foreach`
// iterates (Iterator<string>) AND supports random access via count()/get(at:). Each yielded/returned
// string is a fresh OWNED copy (like Split), so a caller may `give` it onward. The program name (argv[0])
// is NOT part of args() — it's programInvocation()/programName()/programPath(); indices are 0-based over user args only. The extern fns bind
// the kama_runtime.h helpers, exactly like kama_string_from_raw above.
extern fn int32  kama_args_count();
extern fn string kama_args_at(int32 i);
extern fn bool   kama_program_invocation(Ptr<string> dst);
extern fn bool   kama_program_name(Ptr<string> dst);
extern fn bool   kama_program_path(Ptr<string> dst);
extern fn bool   kama_env_lookup(Ptr<int8> name, Ptr<string> dst);
type value Args implements Iterator<string> {
    int32 pos;
    public ctor make() { this.pos = 0; return this; }   // a free fn can't touch the private cursor
    // foreach protocol: yield each user arg once (a fresh owned string), then None.
    public fn Optional<string> next() {
        if (this.pos >= kama_args_count()) { return Optional::None; }
        string s = kama_args_at(i: this.pos);
        this.pos = this.pos + 1;
        return Optional::Some(value: give s);
    }
    // Random access (an owned collection isn't available in the floor).
    public fn int32 count() { return kama_args_count(); }
    public fn Optional<string> get(int32 at) {
        if (at < 0 || at >= kama_args_count()) { return Optional::None; }
        return Optional::Some(value: kama_args_at(i: at));
    }
}
// The program's command-line arguments, excluding the program name.
// `foreach (string a in args())` or `args().get(at: 0)`.
fn Args args() { return Args.make(); }
// The raw invocation — argv[0] VERBATIM, exactly how the program was launched (`./app`, `/usr/bin/app`, or a
// bare `app` when found via PATH), or None if unavailable (bare-metal firmware). The unmodified string, for
// fidelity/logging or code ported from Go/Rust; use programName() for a display name, programPath() for the
// real binary location.
fn Optional<string> programInvocation() {
    string val = "";
    bool found = false;
    unsafe { found = kama_program_invocation(dst: addr(of: val)); }
    if (found) { return Optional::Some(value: give val); }
    return Optional::None;
}
// The program name — the basename of argv[0] (the name the program was invoked as: `/usr/bin/app` -> `app`,
// `.\app.exe` -> `app.exe`). This is what usage/error messages print and what a busybox-style multi-call
// binary dispatches on. `None` only where there is no argv[0] (bare-metal firmware). Spoofable (it is
// whatever the caller put in argv[0]) — for the reliable binary location use programPath().
fn Optional<string> programName() {
    string val = "";
    bool found = false;
    unsafe { found = kama_program_name(dst: addr(of: val)); }
    if (found) { return Optional::Some(value: give val); }
    return Optional::None;
}
// The OS-resolved absolute path to the running executable — reliable for locating sibling files or
// re-exec'ing (unlike argv[0], it is queried from the OS, not the caller). `None` where there is no such
// notion or no portable query: wasm (a JS/browser host), bare-metal firmware, or an unsupported platform.
fn Optional<string> programPath() {
    string val = "";
    bool found = false;
    unsafe { found = kama_program_path(dst: addr(of: val)); }
    if (found) { return Optional::Some(value: give val); }
    return Optional::None;
}
// The value of environment variable `name`, or None if unset. `envOr` is sugar for the fallback case.
fn Optional<string> env(string name) {
    if (name.length() == 0) { return Optional::None; }   // guard: cstr() of an empty/borrowed string may be NULL
    string val = "";
    bool found = false;
    unsafe { found = kama_env_lookup(name: name.cstr(), dst: addr(of: val)); }
    if (found) { return Optional::Some(value: give val); }
    return Optional::None;
}
// Calls the runtime seam directly (rather than moving a string out of env()'s Optional, which the
// ownership model disallows — a payload can be read/`copy`d but not `give`n out of an enum); `give val`
// moves the fresh LOCAL out, no copy on the hit path.
fn string envOr(string name, string dflt) {
    if (name.length() == 0) { return give dflt; }
    string val = "";
    bool found = false;
    unsafe { found = kama_env_lookup(name: name.cstr(), dst: addr(of: val)); }
    if (found) { return give val; }
    return give dflt;
}

// ── Fatal-handler hook (diagnostics floor) ──────────────────────────────────────────────────────────────
// Install a custom handler for a fatal `panic`/`assert`/bounds trap. The default runtime behavior writes the
// message to stderr and `abort()`s — useless/hostile to an end user with no terminal (a shipped game/GUI), so
// a handler can exhibit gracefully instead (show a dialog, flush a save, route to a telemetry sink). CONTRACT:
// register ONCE at startup before spawning isolates (the slot is then read-only = race-free); the handler runs
// for CLEANUP/REPORTING only — the runtime ALWAYS terminates after it (it is NOT a resume point; recovery is
// `Result`, never panic), and a re-entrant panic while handling one hard-aborts (no infinite recursion). On
// `--target embedded` there is no runtime setter — provide a strong `kama_panic_handler` symbol at link time
// instead (this call is a no-op there).
fnptr void PanicHandler();
extern fn void kama_set_panic_handler(PanicHandler h);
fn void setPanicHandler(PanicHandler handler) { kama_set_panic_handler(h: handler); }

// ── Console output (diagnostics floor) ──────────────────────────────────────────────────────────────────
// The floor print family: text to stdout (`print`/`println`, the program's data/results) or stderr
// (`eprint`/`eprintln`, prompts/progress/diagnostics — `e` for "to stderr", the Rust convention). String-only
// — formatting rides interpolation (`println("x = ${x}")`). Unbuffered line writes (v1). On `--target
// embedded` there is no fd, so both streams route to the weak `kama_log_sink` (default no-op; a firmware
// author overrides it to pipe out a UART/RTT). Survive `--no-std`. `cstr()` of an empty string may be NULL,
// but the length is 0 then, so the write is a harmless no-op.
// Each reads its own `s` by borrow (`cstr()`/`length()`) — it never re-passes the string by value, so there
// is no ownership transfer. A literal / interpolation temp binds to the by-value param directly; a NAMED
// string is passed with `copy`/`give` like anywhere else in the value model.
extern fn void kama_print_write(int32 fd, Ptr<int8> bytes, usize len);
extern fn void kama_print_nl(int32 fd);
fn void print(string s)    { unsafe { kama_print_write(fd: 1, bytes: s.cstr(), len: cast<usize>(s.length())); } }
fn void eprint(string s)   { unsafe { kama_print_write(fd: 2, bytes: s.cstr(), len: cast<usize>(s.length())); } }
fn void println(string s)  { unsafe { kama_print_write(fd: 1, bytes: s.cstr(), len: cast<usize>(s.length())); kama_print_nl(fd: 1); } }
fn void eprintln(string s) { unsafe { kama_print_write(fd: 2, bytes: s.cstr(), len: cast<usize>(s.length())); kama_print_nl(fd: 2); } }

// The default allocator (satisfies `Allocator`): a zero-size handle straight onto libc malloc/free. The
// M8 default `A: Allocator = GlobalAllocator` fills it in for `Owned<T>` / `DynamicArray<T>` / `Map<K,V>`,
// so the bare types are unchanged and pay nothing at runtime (the field carries no state — an empty
// struct). Concrete impls live at the end of the prelude, after the contracts they satisfy.
extern "<stdlib.h>";
extern fn Ptr malloc(usize n);
extern fn void free(Ptr p);
type value GlobalAllocator implements Allocator {
    // The canonical zero-arg build (construction-model M8b): marks GlobalAllocator's zero as a valid `default`
    // — it is a stateless, zero-size handle, so a defaulted `A alloc` field (`Owned`/`DynamicArray`/`Map`/…)
    // may be left unassigned for the default fill rather than requiring an explicit assignment. Coexists with
    // the nameless primary until M8d removes it.
    public default ctor make() { return this; }
    public fn Optional<Ptr> allocate(usize bytes) {
        Ptr p = null;
        unsafe { p = malloc(n: bytes); }
        if (cast<usize>(p) == cast<usize>(0)) { return Optional::None; }
        return Optional::Some(value: p);
    }
    public fn void deallocate(Ptr pointer, usize bytes) { unsafe { free(p: pointer); } }
}

// Infallible-allocation adapter (MCU step 5): unwrap a fallible allocation, panicking on OOM. This
// preserves the pre-step-5 panic-on-OOM behavior for `new`/collections while the `Allocator` contract
// itself became fallible. The ONE non-panic construction entry is `try new` (yields `None`);
// `--no-heap`/`@noheap` reject the whole allocation path at the emission site. NON-generic on purpose:
// it takes the already-produced `Optional<Ptr>` (a concrete type — `Ptr` is `void*`), so it monomorphizes
// trivially and is callable from inside the generic collections (where inferring a generic `<A>` helper
// from a type-param-typed `this.alloc` is not supported). The dead `:= cast<Ptr>(0)` after `panic`
// satisfies the value-arm checker (`panic` traps first, so it never runs).
fn Ptr unwrapPtr(Optional<Ptr> o) {
    return match (o) { case Some(value: p): p; case None: { panic(msg: "out of memory"); := cast<Ptr>(0); } };
}

// ── std::fmt core: human-facing text rendering (language-level) ──────────────────────────────────────────
// `Format` is the ONE to-text contract — the display twin of `Serialize`: a type writes its own pieces into
// a caller-owned `Formatter` sink, so a whole nested value materializes in ONE allocation (no O(n²) concat).
// `toString(x)` is the convenience wrapper on top. This lives in the prelude (survives `--no-std`) because
// string interpolation (`"${x}"`) lowers to `format` calls and so must resolve everywhere. INFALLIBLE: an
// in-memory buffer write cannot fail, so `format` returns `void` — a deliberate divergence from `serialize`
// (which has a real I/O sink + non-representable floats and so is `Result`-returning). The scalar formatters
// bind the stdio-free runtime helpers in kama_runtime.h ("Number / char -> string"), like `kama_string_from_raw`.
extern fn string kama_fmt_i64(int64 v);
extern fn string kama_fmt_u64(uint64 v);
extern fn string kama_fmt_f64(float64 v);
extern fn string kama_fmt_f32(float32 v);
extern fn string kama_fmt_char(char cp);
// Format-specifier variants (`${x:.2}` / `${n:0x}`): fixed-precision float + base-N integer. Emitted as
// Formatter fast-paths by the interpolation codegen (like writeChar), so the `Format` contract is unchanged.
extern fn string kama_fmt_f64_prec(float64 v, int32 prec, int32 width, int32 flags);
extern fn string kama_fmt_u64_radix(uint64 v, int32 radix, int32 width, int32 upper, int32 prefix);
extern fn string kama_fmt_i64_width(int64 v, int32 width, int32 flags);
extern fn string kama_fmt_u64_width(uint64 v, int32 width, int32 flags);
// Amortized-growth byte append onto the buffer (kama_runtime.h). `DynamicArray` is a std::collections library
// generic — unavailable this early (the prelude is collected before any std module), so the sink is backed by
// an owned `string` grown in place instead, which keeps ordinary string RAII (no custom destructor needed).
extern fn void kama_str_push(Ptr<string> buf, ref string src);
extern fn string kama_str_take(Ptr<string> buf);
type contract Format for both { fn void format(ref Formatter f); }
// The growable UTF-8 sink — write your pieces in, `finish()` hands back the owned string. Each scalar becomes
// its decimal/UTF-8 text via a runtime formatter, whose bytes are appended to the single backing buffer, so a
// whole nested value materializes in ONE growing allocation rather than one per `+`.
type resource Formatter {
    string buf;
    public ctor make() { this.buf = ""; }
    // Append a string's UTF-8 bytes verbatim (borrowed — reads the fat pointer, doesn't dup the bytes).
    public fn void writeStr(ref string s) { unsafe { kama_str_push(buf: addr(of: this.buf), src: s); } }
    public fn void writeI64(int64 v)   { string t = kama_fmt_i64(v: v);  this.writeStr(s: ref t); }
    public fn void writeU64(uint64 v)  { string t = kama_fmt_u64(v: v);  this.writeStr(s: ref t); }
    public fn void writeF64(float64 v) { string t = kama_fmt_f64(v: v);  this.writeStr(s: ref t); }
    public fn void writeF32(float32 v) { string t = kama_fmt_f32(v: v);  this.writeStr(s: ref t); }
    public fn void writeBool(bool v)   { string t = "false"; if (v) { t = "true"; } this.writeStr(s: ref t); }
    public fn void writeChar(char c)   { string t = kama_fmt_char(cp: c); this.writeStr(s: ref t); }
    // Format-specifier writers (interpolation fast-paths): fixed float precision + base-N integer. `upper`
    // and `prefix` are 0/1 flags; the integer is masked to `width` bits so a signed negative round-trips.
    public fn void writeF64Prec(float64 v, int32 prec, int32 width, int32 flags) { string t = kama_fmt_f64_prec(v: v, prec: prec, width: width, flags: flags); this.writeStr(s: ref t); }
    public fn void writeU64Radix(uint64 v, int32 radix, int32 width, int32 upper, int32 prefix) { string t = kama_fmt_u64_radix(v: v, radix: radix, width: width, upper: upper, prefix: prefix); this.writeStr(s: ref t); }
    public fn void writeI64Width(int64 v, int32 width, int32 flags) { string t = kama_fmt_i64_width(v: v, width: width, flags: flags); this.writeStr(s: ref t); }
    public fn void writeU64Width(uint64 v, int32 width, int32 flags) { string t = kama_fmt_u64_width(v: v, width: width, flags: flags); this.writeStr(s: ref t); }
    // Hand back the accumulated buffer as the owned result string (zero-copy move-out; the Formatter is spent).
    public fn string finish() { unsafe { return kama_str_take(buf: addr(of: this.buf)); } }
}
// Primitive conformances (pure-kama, like the Hashable/Comparable ones above) — every scalar and `string`
// renders in its natural form, so `<T: Format>` bounds and `"${x}"` compose universally without an import.
// Narrow integers widen into the widest write (JSON-style: one conversion per signedness), which is what
// lets each signedness share ONE body across its four widths — on the widest the cast is the identity.
// Every other target names a different writer, so it is its own block; see the Serialize note below.
// `char` renders as its CHARACTER — the same thing the compiler's `writeChar` fast path does for an
// interpolation hole, so the two agree whether the value arrives directly or through a `<T: Format>` bound.
type intrinsic <int8, int16, int32, int64> implements Format {
    public fn void format(ref Formatter f) { f.writeI64(v: cast<int64>(this)); }
}
type intrinsic <uint8, uint16, uint32, uint64> implements Format {
    public fn void format(ref Formatter f) { f.writeU64(v: cast<uint64>(this)); }
}
type intrinsic <float32> implements Format { public fn void format(ref Formatter f) { f.writeF32(v: this); } }
type intrinsic <float64> implements Format { public fn void format(ref Formatter f) { f.writeF64(v: this); } }
type intrinsic <bool>    implements Format { public fn void format(ref Formatter f) { f.writeBool(v: this); } }
type intrinsic <char>    implements Format { public fn void format(ref Formatter f) { f.writeChar(c: this); } }
type intrinsic <string>  implements Format { public fn void format(ref Formatter f) { f.writeStr(s: this); } }
// The convenience wrapper: build a Formatter, format into it, finish — ONE allocation for the whole value.
// A generic bound method call (like the `__kamaDeserialize` trampoline), monomorphized per `T`.
fn string toString<T: Format>(ref T x) {
    Formatter f = Formatter.make();
    x.format(f: ref f);
    return f.finish();
}

// A tagged string `html"…${x}…"` hands its trusted literal PARTS and its rendered HOLE values to a tag
// function `fn R name(ref Template t)` — kept SEPARATE so the tag can escape holes (html), dedent parts
// (stripIndent), or bind holes as out-of-band `?` params (sql, injection-safe by construction). The compiler
// materializes this over two borrowed C arrays (invariant: partCount() == holeCount() + 1) and constructs it
// ONLY in emitted code — there is no kama ctor. The `Ptr` fields are borrows: `Template` owns nothing.
type value Template {
    Ptr<string> _parts;
    int32 _nparts;
    Ptr<string> _holes;
    int32 _nholes;
    public fn int32 partCount() { return this._nparts; }
    public fn int32 holeCount() { return this._nholes; }
    // The i-th literal part / rendered hole, as a fresh owned copy (the backing bytes are borrowed, so a copy
    // is what a tag can keep, iterate, or `give` onward).
    public fn string part(int32 at) { if (at < 0 || at >= this._nparts) { panic(msg: "Template.part index out of bounds"); } unsafe { return copy this._parts[at]; } }
    public fn string hole(int32 at) { if (at < 0 || at >= this._nholes) { panic(msg: "Template.hole index out of bounds"); } unsafe { return copy this._holes[at]; } }
}
