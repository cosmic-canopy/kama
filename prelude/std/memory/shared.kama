namespace std::memory;
export { Shared };

extern "<stdlib.h>";
extern fn Ptr malloc(usize n);
extern fn void free(Ptr p);

// The strong/weak reference counts shared by a `Shared`/`Weak` family. Heap-allocated once at
// `adopt`, freed when BOTH counts reach zero. Module-internal (not exported). `usize` counts match
// the runtime `kama_ctrl` layout, so a `BindableFunctionPtr` can retain a Shared it binds.
type value Ctrl { public usize strong; public usize weak; }

// A reference-counted shared-ownership pointer (Rust's `Rc<T>`). `Copyable(bare: copy)`: a bare hand-off
// (`Shared b = a;`) RETAINS (strong++) via `copy()`; `give b = a` MOVES the handle (transfers the ref, no
// count change — every kind is movable). The pointee is released exactly once, when the last strong handle
// drops. `implements HeapOwner<T>` makes `new T(args)` a heap-placement + adopt; `Deref<T>` forwards access.
//
// The pointee AND the shared control block are drawn from the allocator `A` (M8 default `GlobalAllocator`
// → libc malloc/free, so a bare `Shared<T>` is unchanged). A placement `new(allocator: a) T(args)` draws
// the pointee from `a` (the emitter) and the ctrl block from `a` (`adoptIn`), storing the handle in
// `alloc` so BOTH frees route through the SAME allocator — letting a ref-counted graph live in a
// caller-owned arena and be bulk-reclaimed on `reset()`. Every handle (a `copy()`, a `downgrade()`'s
// `Weak`) carries a copy of the value handle `A`, so whichever handle observes `strong == 0 && weak == 0`
// frees the ctrl through an `A` equal to the one that made it (`A` is monomorphized identically across the
// `Shared`/`Weak` family). `copy()`/`downgrade()`/`tryUpgrade()` return a FRESH ctor rvalue (never a named
// local — a bare `return <local>` re-invokes `copy()` and recurses); the ctor is also how a `Weak` builds a
// `Shared` and vice versa (cross-type, so field-poke can't reach the sibling's private fields). `adopt`
// alone builds same-type by field-poke + `give` (the move avoids needing a default `A` value for the ctor).
type resource Shared<T, A: Allocator = GlobalAllocator> implements Deref<T>, HeapOwner<T>, Copyable(bare: copy),
                                    Deserialize when [T: Deserialize] {
    Ptr<T> p;
    Ptr<Ctrl> c;
    A alloc;
    public ctor make(Ptr<T> p, Ptr<Ctrl> c, A alloc) { Shared<T, A> r; r.p = p; r.c = c; r.alloc = alloc; return give r; }   // shares an existing ctrl
    // Deserialize INTO a Shared: a graph root is heap + shared-owned, so `decode::<Shared<N>>` reconstructs the
    // whole object graph and hands back the owning root handle. Delegates to `T::deserialize` — for a graph type
    // `N` the `@generate(Deserialize)` intrinsic emits `N::deserialize` returning `Shared<N>` (the two-pass graph
    // driver, emitted directly in C), so this simply forwards it (the `T: Deserialize` bound is what makes
    // `T::deserialize` resolve, exactly like the `__kamaDeserialize` trampoline). Only type-checks when
    // `N::deserialize` yields a `Shared<N>` — i.e. `N` is a graph type. Instantiating `Shared<X>::deserialize`
    // for a non-graph `X` (whose `X::deserialize` returns `X`) is a type error — decode a plain value as
    // `decode::<X>` instead.
    public static fn Result<Shared<T, A>, Owned<Error>> deserialize(Deserializer r) when [T: Deserialize] {
        return T::deserialize(r: r);
    }
    // HeapOwner: adopt a raw pointee into a box with the DEFAULT allocator (the bare-`new` path). The ctrl
    // block is drawn from libc `malloc`. Field-poke `p`/`c` then `give` the handle out — the move transfers
    // the ref (no `copy()` retain, and unlike a ctor rvalue it needs no default-`A` value to pass). `alloc`
    // is left unset: this path is only reached with `A == GlobalAllocator` — now COMPILER-ENFORCED via the
    // `when [A: default]` gate (a custom `A` box comes through `adoptIn`). `GlobalAllocator` is stateless — its
    // `deallocate` == `free` (matching the malloc) and never reads the handle, so an unset value is inert.
    public ctor adopt(Ptr<T> raw) when [A: default] {
        Ptr<Ctrl> ctrl;
        unsafe { ctrl = cast<Ptr<Ctrl>>(malloc(n: sizeof(Ctrl))); ctrl[0].strong = 1; ctrl[0].weak = 0; }
        Shared<T, A> s; s.p = raw; s.c = ctrl; return give s;
    }
    // Placement adopt: a pointee that came FROM `allocator`; draw the ctrl block from the SAME `allocator`
    // and store the handle so the dtor releases both through it (the `new(allocator: a) T(...)` path).
    public ctor adoptIn(Ptr<T> raw, A allocator) {
        Ptr<Ctrl> ctrl;
        unsafe { ctrl = cast<Ptr<Ctrl>>(allocator.allocate(bytes: sizeof(Ctrl))); ctrl[0].strong = 1; ctrl[0].weak = 0; }
        return Shared.make(p: raw, c: ctrl, alloc: allocator);
    }
    public fn ref T deref() { unsafe { return this.p[0]; } }
    public fn Shared<T, A> copy() {                                   // Copyable -> retain, carry the allocator
        unsafe { this.c[0].strong = this.c[0].strong + 1; }
        return Shared.make(p: this.p, c: this.c, alloc: this.alloc);
    }
    public fn Weak<T, A> downgrade() {
        unsafe { this.c[0].weak = this.c[0].weak + 1; }
        return Weak.make(p: this.p, c: this.c, alloc: this.alloc);        // cross-type -> Weak's public ctor
    }
    ~Shared() {
        unsafe {
            if (cast<usize>(this.c) != 0) {                           // guard a zero-initialized handle
                if (this.c[0].strong == 1) {                          // the LAST strong handle
                    // Keep `strong` at 1 while the pointee dtor runs: dropping the pointee can release a
                    // `Weak` back-edge into THIS same Ctrl (a cycle), and that `Weak` drop frees the Ctrl
                    // when `strong == 0 && weak == 0`. Releasing strong only AFTER the dtor keeps the Ctrl
                    // alive across the drop, so the final `weak == 0` check below never touches freed memory.
                    drop(value: this.deref());                        // run the pointee's dtor once
                    this.alloc.deallocate(pointer: cast<Ptr>(this.p), bytes: sizeof(T));
                    this.c[0].strong = 0;
                    if (this.c[0].weak == 0) { this.alloc.deallocate(pointer: cast<Ptr>(this.c), bytes: sizeof(Ctrl)); }
                } else {
                    this.c[0].strong = this.c[0].strong - 1;
                }
            }
        }
    }
}
