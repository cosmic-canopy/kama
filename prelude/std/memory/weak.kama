namespace std::memory;
export { Weak };

extern "<stdlib.h>";
extern fn void free(UnsafePtr p);

// M6.2: the shared refcount seam (see shared.kama) — `Weak` mutates the SAME `Ctrl` counters, so it uses
// the same flavor-selected ops. `atomic` is the per-instance compile-time constant `__kama_ctrl_atomic()`.
extern "kama_ctrl.h";
extern fn void  kama_ctrl_retain_weak(UnsafePtr c, int32 atomic);
extern fn int32 kama_ctrl_try_upgrade(UnsafePtr c, int32 atomic);
extern fn int32 kama_ctrl_release_weak(UnsafePtr c, int32 atomic);

// A non-owning weak handle into a `Shared<T>` family (Rust's `Weak<T>`). It holds the object alive for
// no one — `tryUpgrade()` returns `Some(Shared)` only while a strong handle still exists, else `None`.
// `Copyable(bare: copy)`: a bare hand-off duplicates the weak handle (weak++); `give` MOVES it. `Ctrl` and
// `free` come from the `shared.kama` sibling in this module.
//
// Carries a copy of the same allocator `A` as its `Shared` (`downgrade()` copies it through, and it is
// monomorphized identically), so a `Weak` that OUTLIVES its `Shared` and observes `strong == 0 &&
// weak == 0` frees the ctrl block through an `A` equal to the one that allocated it. Constructs by
// returning a FRESH ctor rvalue (never a named local, which would re-fire the `copy()` marker); the ctor
// is also how it rebuilds a `Shared` (cross-type — field-poke can't reach the sibling's private fields).
type resource Weak<T, A: Allocator = GlobalAllocator> implements Copyable<This>(bare: copy) {
    UnsafePtr<T> p;
    UnsafePtr<Ctrl> c;
    A alloc;
    public ctor make(UnsafePtr<T> p, UnsafePtr<Ctrl> c, A alloc) { this.p = p; this.c = c; this.alloc = alloc; }
    public unsafe ctor copy(ref Weak<T, A> source) {                                     // Copyable -> another weak handle
        kama_ctrl_retain_weak(c: cast<UnsafePtr>(source.c), atomic: __kama_ctrl_atomic());
        return Weak.make(p: source.p, c: source.c, alloc: source.alloc);
    }
    public unsafe fn Optional<Shared<T, A>> tryUpgrade() {
        // atomic-safe upgrade: a CAS loop when atomic (a plain strong>0 test-then-inc would race a
        // concurrent last drop), a guarded increment when plain. Non-zero == a strong ref was acquired.
        if (kama_ctrl_try_upgrade(c: cast<UnsafePtr>(this.c), atomic: __kama_ctrl_atomic()) != 0i32) {
            return Optional::Some(value: Shared.make(p: this.p, c: this.c, alloc: this.alloc));   // cross-type ctor
        }
        return Optional::None;
    }
    unsafe ~Weak() {
        if (cast<usize>(this.c) != 0) {                           // guard a zero-initialized handle
            if (kama_ctrl_release_weak(c: cast<UnsafePtr>(this.c), atomic: __kama_ctrl_atomic()) != 0i32) {
                this.alloc.deallocate(pointer: cast<UnsafePtr>(this.c), bytes: sizeof(Ctrl));
            }
        }
    }
}
