export { PanicInfo, PanicHandler, setPanicHandler, print, eprint, println, eprintln };

// Module `core` — the runtime capabilities: console output and the fatal-handler hook here, and the command line and
// the environment in `core::env`. A program names each one it uses in its import list (`import { core::println };`),
// like any other module's symbol; nothing here is in scope without that import (KR-87, SPEC § Modules). The two are
// apart because they are different capabilities: a module whose `importsOnly` lists `"core"` may print, and only one
// that lists `"core::env"` may read what the process was started with, so a deterministic simulation can say so.
//
// What sets it apart from `std` is only where it ships: it binds runtime globals the C runtime sets up
// before `main` (argc/argv, the panic slot, the output fds), so it is EMBEDDED in the compiler like the
// prelude and survives `--no-std` (Makefile PRELUDE_MODULES). The language's own types and contracts —
// `Optional`, `Result`, `Iterator`, `Formattable`, … — are not here: the syntax lowers into them, so they
// stay in every scope as reserved names (prelude/global.kama).

// ── Fatal-handler hook ──────────────────────────────────────────────────────────────────────────────────
// Install a custom handler for a fatal `panic`/`assert`/bounds trap. The default runtime behavior writes the
// message to stderr and `abort()`s — useless/hostile to an end user with no terminal (a shipped game/GUI), so
// a handler can exhibit gracefully instead (show a dialog, flush a save, route to a telemetry sink). CONTRACT:
// register ONCE at startup before spawning isolates (the slot is then read-only = race-free); the handler runs
// for CLEANUP/REPORTING only — the runtime ALWAYS terminates after it (it is NOT a resume point; recovery is
// `Result`, or a declared `@onPanic` region, which recovers BEFORE the hook and never reaches it), and a
// re-entrant panic while handling one hard-aborts (no infinite recursion). On
// `--target embedded` there is no runtime setter — provide a strong `kama_panic_handler` symbol at link time
// instead (this call is a no-op there).
// `@foreignEntry`: the handler runs on whichever thread panicked, which is not necessarily the isolate
// that registered it — a bounds miss in library code on any isolate, or on a thread a C library created,
// reaches this slot. So a module `static` the handler reads is a different object there.
//
// The handler is handed what went wrong, so a program with no terminal can put it in its own crash report: the
// message the runtime wrote to stderr (the text after `kama: ` and before the location) and the location, when one
// is known. Only one thread runs the handler; another that panics meanwhile waits for it, and a panic inside the
// handler hard-aborts.
@foreignEntry fnptr void PanicHandler(const ref PanicInfo info);
extern fn void kama_set_panic_handler(PanicHandler h);

// What a `PanicHandler` is handed. The runtime builds it on the panicking thread's stack, so nothing allocates on
// the way to the abort; each string it hands out borrows that storage and is valid for the handler's whole run.
@linkName("kama_panic_info")
type extern value PanicInfo {
    // The message, as stderr shows it after `kama: `: "panic: boom", "index 8 out of bounds (length 2)".
    public unsafe const fn string message() { return kama_panic_info_message(i: this); }
    // The file the fault is in, as it prints (`main.kama`), or "" when the runtime knows none.
    public unsafe const fn string file() { return kama_panic_info_file(i: this); }
    // Its line, or 0 when the runtime knows none.
    public unsafe const fn int32 line() { return kama_panic_info_line(i: this); }
}
extern fn string kama_panic_info_message(const ref PanicInfo i);
extern fn string kama_panic_info_file(const ref PanicInfo i);
extern fn int32 kama_panic_info_line(const ref PanicInfo i);
unsafe fn void setPanicHandler(PanicHandler handler) { kama_set_panic_handler(h: handler); }

// ── Console output ──────────────────────────────────────────────────────────────────────────────────────
// The print family: text to stdout (`print`/`println`, the program's data/results) or stderr
// (`eprint`/`eprintln`, prompts/progress/diagnostics — `e` for "to stderr", the Rust convention). String-only
// — formatting rides interpolation (`println("x = ${x}")`). Unbuffered, and `println`/`eprintln` write the text and
// its newline in ONE call (`kama_print_line`), so lines from two isolates, or from processes sharing a pipe, never
// interleave mid-line (up to PIPE_BUF: 512 bytes on macOS, 4096 on Linux; 4 KiB on Windows). On `--target
// embedded` there is no fd, so both streams route to the weak `kama_log_sink` (default no-op; a firmware
// author overrides it to pipe out a UART/RTT). Survive `--no-std`. `cstr()` of an empty string may be NULL,
// but the length is 0 then, so the write is a harmless no-op.
// Each reads its own `s` by borrow (`cstr()`/`length()`) — it never re-passes the string by value, so there
// is no ownership transfer. A literal / interpolation temp binds to the by-value param directly; a NAMED
// string is passed with `copy`/`give` like anywhere else in the value model.
extern fn void kama_print_write(int32 fd, UnsafeConstPtr<cchar> bytes, usize len);
extern fn void kama_print_line(int32 fd, UnsafeConstPtr<cchar> bytes, usize len);
@parks
unsafe fn void print(string s)    { kama_print_write(fd: 1, bytes: s.cstr(), len: cast<usize>(s.length())); }
@parks
unsafe fn void eprint(string s)   { kama_print_write(fd: 2, bytes: s.cstr(), len: cast<usize>(s.length())); }
@parks
unsafe fn void println(string s)  { kama_print_line(fd: 1, bytes: s.cstr(), len: cast<usize>(s.length())); }
@parks
unsafe fn void eprintln(string s) { kama_print_line(fd: 2, bytes: s.cstr(), len: cast<usize>(s.length())); }
