namespace std::math;

// Float32 matrices — column-major (GPU/WebGPU-native), column-vector convention (result = M * v). Storage is
// `InlineArray<Vec4,4>` columns: `cols[c]` is column c, `cols[c].x/.y/.z/.w` its rows. One `operator*` (matrix
// compose); vector transform is a named method. (Mat2/Mat3 added after Mat4 is proven.)
export { Mat2, Mat3, Mat4 };

@generate(of)
type value Mat2 {
    public InlineArray<Vec2, 2> cols;
    public ctor fromCols(Vec2 c0, Vec2 c1) { InlineArray<Vec2, 2> cs = [c0, c1]; return Mat2.of(cols: cs); }
    public ctor identity() {
        return Mat2::fromCols(c0: Vec2.of(x: 1.0f32, y: 0.0f32), c1: Vec2.of(x: 0.0f32, y: 1.0f32));
    }
    public fn float32 get(int32 c, int32 r) { Vec2 col = this.cols[c]; return r == 0 ? col.x : col.y; }
    public fn Vec2 transform(Vec2 v) {
        Vec2 c0 = this.cols[0]; Vec2 c1 = this.cols[1];
        return Vec2.of(x: c0.x*v.x + c1.x*v.y, y: c0.y*v.x + c1.y*v.y);
    }
    public Mat2 operator*(Mat2 r) {
        Vec2 r0 = this.transform(v: r.cols[0]); Vec2 r1 = this.transform(v: r.cols[1]);
        return Mat2::fromCols(c0: r0, c1: r1);
    }
    public fn Mat2 transpose() {
        Vec2 c0 = this.cols[0]; Vec2 c1 = this.cols[1];
        return Mat2::fromCols(c0: Vec2.of(x: c0.x, y: c1.x), c1: Vec2.of(x: c0.y, y: c1.y));
    }
    public fn float32 determinant() { Vec2 c0 = this.cols[0]; Vec2 c1 = this.cols[1]; return c0.x*c1.y - c1.x*c0.y; }
    public fn Mat2 inverse() {
        Vec2 c0 = this.cols[0]; Vec2 c1 = this.cols[1];
        float32 k = 1.0f32 / (c0.x*c1.y - c1.x*c0.y);
        return Mat2::fromCols(c0: Vec2.of(x: c1.y*k, y: 0.0f32 - c0.y*k),
                              c1: Vec2.of(x: 0.0f32 - c1.x*k, y: c0.x*k));
    }
}

@generate(of)
type value Mat3 {
    public InlineArray<Vec3, 3> cols;
    public ctor fromCols(Vec3 c0, Vec3 c1, Vec3 c2) { InlineArray<Vec3, 3> cs = [c0, c1, c2]; return Mat3.of(cols: cs); }
    public ctor identity() {
        return Mat3::fromCols(c0: Vec3.of(x: 1.0f32, y: 0.0f32, z: 0.0f32),
                              c1: Vec3.of(x: 0.0f32, y: 1.0f32, z: 0.0f32),
                              c2: Vec3.of(x: 0.0f32, y: 0.0f32, z: 1.0f32));
    }
    public fn float32 get(int32 c, int32 r) { Vec3 col = this.cols[c]; return r == 0 ? col.x : (r == 1 ? col.y : col.z); }
    public fn Vec3 transform(Vec3 v) {
        Vec3 c0 = this.cols[0]; Vec3 c1 = this.cols[1]; Vec3 c2 = this.cols[2];
        return Vec3.of(x: c0.x*v.x + c1.x*v.y + c2.x*v.z,
                    y: c0.y*v.x + c1.y*v.y + c2.y*v.z,
                    z: c0.z*v.x + c1.z*v.y + c2.z*v.z);
    }
    public Mat3 operator*(Mat3 r) {
        Vec3 r0 = this.transform(v: r.cols[0]); Vec3 r1 = this.transform(v: r.cols[1]); Vec3 r2 = this.transform(v: r.cols[2]);
        return Mat3::fromCols(c0: r0, c1: r1, c2: r2);
    }
    public fn Mat3 transpose() {
        Vec3 c0 = this.cols[0]; Vec3 c1 = this.cols[1]; Vec3 c2 = this.cols[2];
        return Mat3::fromCols(c0: Vec3.of(x: c0.x, y: c1.x, z: c2.x),
                              c1: Vec3.of(x: c0.y, y: c1.y, z: c2.y),
                              c2: Vec3.of(x: c0.z, y: c1.z, z: c2.z));
    }
    public fn float32 determinant() {
        Vec3 c0 = this.cols[0]; Vec3 c1 = this.cols[1]; Vec3 c2 = this.cols[2];
        return c0.x*(c1.y*c2.z - c2.y*c1.z) - c1.x*(c0.y*c2.z - c2.y*c0.z) + c2.x*(c0.y*c1.z - c1.y*c0.z);
    }
    public fn Mat3 inverse() {
        Vec3 c0 = this.cols[0]; Vec3 c1 = this.cols[1]; Vec3 c2 = this.cols[2];
        float32 m00=c0.x; float32 m10=c0.y; float32 m20=c0.z;   // m<r><c>
        float32 m01=c1.x; float32 m11=c1.y; float32 m21=c1.z;
        float32 m02=c2.x; float32 m12=c2.y; float32 m22=c2.z;
        float32 A00 =  (m11*m22 - m12*m21); float32 A01 = 0.0f32-(m10*m22 - m12*m20); float32 A02 =  (m10*m21 - m11*m20);
        float32 A10 = 0.0f32-(m01*m22 - m02*m21); float32 A11 =  (m00*m22 - m02*m20); float32 A12 = 0.0f32-(m00*m21 - m01*m20);
        float32 A20 =  (m01*m12 - m02*m11); float32 A21 = 0.0f32-(m00*m12 - m02*m10); float32 A22 =  (m00*m11 - m01*m10);
        float32 k = 1.0f32 / (m00*A00 + m01*A01 + m02*A02);
        // inverse column c = (cofactor[c][0], [c][1], [c][2]) * k   (adjugate = cofactorᵀ)
        return Mat3::fromCols(c0: Vec3.of(x: A00*k, y: A01*k, z: A02*k),
                              c1: Vec3.of(x: A10*k, y: A11*k, z: A12*k),
                              c2: Vec3.of(x: A20*k, y: A21*k, z: A22*k));
    }
}

@generate(of)
type value Mat4 {
    public InlineArray<Vec4, 4> cols;

    public ctor fromCols(Vec4 c0, Vec4 c1, Vec4 c2, Vec4 c3) {
        InlineArray<Vec4, 4> cs = [c0, c1, c2, c3];
        return Mat4.of(cols: cs);
    }
    public ctor identity() {
        Vec4 c0 = Vec4.of(x: 1.0f32, y: 0.0f32, z: 0.0f32, w: 0.0f32);
        Vec4 c1 = Vec4.of(x: 0.0f32, y: 1.0f32, z: 0.0f32, w: 0.0f32);
        Vec4 c2 = Vec4.of(x: 0.0f32, y: 0.0f32, z: 1.0f32, w: 0.0f32);
        Vec4 c3 = Vec4.of(x: 0.0f32, y: 0.0f32, z: 0.0f32, w: 1.0f32);
        return Mat4::fromCols(c0: c0, c1: c1, c2: c2, c3: c3);
    }
    public ctor scale(Vec3 s) {
        Vec4 c0 = Vec4.of(x: s.x,    y: 0.0f32, z: 0.0f32, w: 0.0f32);
        Vec4 c1 = Vec4.of(x: 0.0f32, y: s.y,    z: 0.0f32, w: 0.0f32);
        Vec4 c2 = Vec4.of(x: 0.0f32, y: 0.0f32, z: s.z,    w: 0.0f32);
        Vec4 c3 = Vec4.of(x: 0.0f32, y: 0.0f32, z: 0.0f32, w: 1.0f32);
        return Mat4::fromCols(c0: c0, c1: c1, c2: c2, c3: c3);
    }
    public ctor translation(Vec3 t) {
        Vec4 c0 = Vec4.of(x: 1.0f32, y: 0.0f32, z: 0.0f32, w: 0.0f32);
        Vec4 c1 = Vec4.of(x: 0.0f32, y: 1.0f32, z: 0.0f32, w: 0.0f32);
        Vec4 c2 = Vec4.of(x: 0.0f32, y: 0.0f32, z: 1.0f32, w: 0.0f32);
        Vec4 c3 = Vec4.of(x: t.x,    y: t.y,    z: t.z,    w: 1.0f32);
        return Mat4::fromCols(c0: c0, c1: c1, c2: c2, c3: c3);
    }

    // element at column c, row r (0-based)
    public fn float32 get(int32 c, int32 r) {
        Vec4 col = this.cols[c];
        return r == 0 ? col.x : (r == 1 ? col.y : (r == 2 ? col.z : col.w));
    }

    // result = M * v (column-vector): a linear combination of the columns.
    public fn Vec4 transform(Vec4 v) {
        Vec4 c0 = this.cols[0];
        Vec4 c1 = this.cols[1];
        Vec4 c2 = this.cols[2];
        Vec4 c3 = this.cols[3];
        return Vec4.of(
            x: c0.x*v.x + c1.x*v.y + c2.x*v.z + c3.x*v.w,
            y: c0.y*v.x + c1.y*v.y + c2.y*v.z + c3.y*v.w,
            z: c0.z*v.x + c1.z*v.y + c2.z*v.z + c3.z*v.w,
            w: c0.w*v.x + c1.w*v.y + c2.w*v.z + c3.w*v.w);
    }
    public fn Vec3 transformPoint(Vec3 p) {
        Vec4 pv = Vec4.of(x: p.x, y: p.y, z: p.z, w: 1.0f32);
        Vec4 r = this.transform(v: pv);
        return Vec3.of(x: r.x / r.w, y: r.y / r.w, z: r.z / r.w);
    }
    public fn Vec3 transformDir(Vec3 d) {
        Vec4 dv = Vec4.of(x: d.x, y: d.y, z: d.z, w: 0.0f32);
        Vec4 r = this.transform(v: dv);
        return Vec3.of(x: r.x, y: r.y, z: r.z);
    }

    // matrix compose: (A*B).col_j = A * B.col_j
    public Mat4 operator*(Mat4 rhs) {
        Vec4 r0 = this.transform(v: rhs.cols[0]);
        Vec4 r1 = this.transform(v: rhs.cols[1]);
        Vec4 r2 = this.transform(v: rhs.cols[2]);
        Vec4 r3 = this.transform(v: rhs.cols[3]);
        return Mat4::fromCols(c0: r0, c1: r1, c2: r2, c3: r3);
    }
    public fn Mat4 transpose() {
        Vec4 c0 = this.cols[0];
        Vec4 c1 = this.cols[1];
        Vec4 c2 = this.cols[2];
        Vec4 c3 = this.cols[3];
        Vec4 t0 = Vec4.of(x: c0.x, y: c1.x, z: c2.x, w: c3.x);
        Vec4 t1 = Vec4.of(x: c0.y, y: c1.y, z: c2.y, w: c3.y);
        Vec4 t2 = Vec4.of(x: c0.z, y: c1.z, z: c2.z, w: c3.z);
        Vec4 t3 = Vec4.of(x: c0.w, y: c1.w, z: c2.w, w: c3.w);
        return Mat4::fromCols(c0: t0, c1: t1, c2: t2, c3: t3);
    }

    // ---- rotations (right-handed, column-major) ----
    public ctor fromRotationX(float32 rad) {
        float32 c = cosf(x: rad); float32 s = sinf(x: rad);
        Vec4 c0 = Vec4.of(x: 1.0f32, y: 0.0f32, z: 0.0f32, w: 0.0f32);
        Vec4 c1 = Vec4.of(x: 0.0f32, y: c,      z: s,      w: 0.0f32);
        Vec4 c2 = Vec4.of(x: 0.0f32, y: -s,     z: c,      w: 0.0f32);
        Vec4 c3 = Vec4.of(x: 0.0f32, y: 0.0f32, z: 0.0f32, w: 1.0f32);
        return Mat4::fromCols(c0: c0, c1: c1, c2: c2, c3: c3);
    }
    public ctor fromRotationY(float32 rad) {
        float32 c = cosf(x: rad); float32 s = sinf(x: rad);
        Vec4 c0 = Vec4.of(x: c,      y: 0.0f32, z: -s,     w: 0.0f32);
        Vec4 c1 = Vec4.of(x: 0.0f32, y: 1.0f32, z: 0.0f32, w: 0.0f32);
        Vec4 c2 = Vec4.of(x: s,      y: 0.0f32, z: c,      w: 0.0f32);
        Vec4 c3 = Vec4.of(x: 0.0f32, y: 0.0f32, z: 0.0f32, w: 1.0f32);
        return Mat4::fromCols(c0: c0, c1: c1, c2: c2, c3: c3);
    }
    public ctor fromRotationZ(float32 rad) {
        float32 c = cosf(x: rad); float32 s = sinf(x: rad);
        Vec4 c0 = Vec4.of(x: c,      y: s,      z: 0.0f32, w: 0.0f32);
        Vec4 c1 = Vec4.of(x: -s,     y: c,      z: 0.0f32, w: 0.0f32);
        Vec4 c2 = Vec4.of(x: 0.0f32, y: 0.0f32, z: 1.0f32, w: 0.0f32);
        Vec4 c3 = Vec4.of(x: 0.0f32, y: 0.0f32, z: 0.0f32, w: 1.0f32);
        return Mat4::fromCols(c0: c0, c1: c1, c2: c2, c3: c3);
    }

    // ---- projections / view (WebGPU 0..1 depth, right-handed) ----
    public ctor perspective(float32 fovyRad, float32 aspect, float32 near, float32 far) {
        float32 f = 1.0f32 / tanf(x: fovyRad * 0.5f32);
        float32 nf = 1.0f32 / (near - far);
        Vec4 c0 = Vec4.of(x: f / aspect, y: 0.0f32, z: 0.0f32,          w: 0.0f32);
        Vec4 c1 = Vec4.of(x: 0.0f32,     y: f,      z: 0.0f32,          w: 0.0f32);
        Vec4 c2 = Vec4.of(x: 0.0f32,     y: 0.0f32, z: far * nf,        w: -1.0f32);
        Vec4 c3 = Vec4.of(x: 0.0f32,     y: 0.0f32, z: far * near * nf, w: 0.0f32);
        return Mat4::fromCols(c0: c0, c1: c1, c2: c2, c3: c3);
    }
    public ctor orthographic(float32 l, float32 r, float32 b, float32 t, float32 near, float32 far) {
        float32 nf = 1.0f32 / (near - far);
        Vec4 c0 = Vec4.of(x: 2.0f32/(r-l), y: 0.0f32,       z: 0.0f32,     w: 0.0f32);
        Vec4 c1 = Vec4.of(x: 0.0f32,       y: 2.0f32/(t-b), z: 0.0f32,     w: 0.0f32);
        Vec4 c2 = Vec4.of(x: 0.0f32,       y: 0.0f32,       z: nf,         w: 0.0f32);
        Vec4 c3 = Vec4.of(x: -(r+l)/(r-l), y: -(t+b)/(t-b), z: near * nf,  w: 1.0f32);
        return Mat4::fromCols(c0: c0, c1: c1, c2: c2, c3: c3);
    }
    public ctor lookAt(Vec3 eye, Vec3 center, Vec3 up) {
        Vec3 dir = center - eye;
        Vec3 f = dir.normalized();
        Vec3 sx = f.cross(r: up);
        Vec3 s = sx.normalized();
        Vec3 u = s.cross(r: f);
        Vec4 c0 = Vec4.of(x: s.x, y: u.x, z: -f.x, w: 0.0f32);
        Vec4 c1 = Vec4.of(x: s.y, y: u.y, z: -f.y, w: 0.0f32);
        Vec4 c2 = Vec4.of(x: s.z, y: u.z, z: -f.z, w: 0.0f32);
        Vec4 c3 = Vec4.of(x: -s.dot(r: eye), y: -u.dot(r: eye), z: f.dot(r: eye), w: 1.0f32);
        return Mat4::fromCols(c0: c0, c1: c1, c2: c2, c3: c3);
    }

    // ---- determinant + general inverse (MESA-style adjugate; column-major m[c][r]) ----
    public fn float32 determinant() {
        Vec4 a = this.cols[0]; Vec4 b = this.cols[1]; Vec4 c = this.cols[2]; Vec4 d = this.cols[3];
        // m<row><col>: cols[col].{x=row0,y=row1,z=row2,w=row3}
        float32 m0=a.x; float32 m4=a.y; float32 m8=a.z;  float32 m12=a.w;
        float32 m1=b.x; float32 m5=b.y; float32 m9=b.z;  float32 m13=b.w;
        float32 m2=c.x; float32 m6=c.y; float32 m10=c.z; float32 m14=c.w;
        float32 m3=d.x; float32 m7=d.y; float32 m11=d.z; float32 m15=d.w;
        float32 i0 =  m5*m10*m15 - m5*m11*m14 - m9*m6*m15 + m9*m7*m14 + m13*m6*m11 - m13*m7*m10;
        float32 i4 = -m4*m10*m15 + m4*m11*m14 + m8*m6*m15 - m8*m7*m14 - m12*m6*m11 + m12*m7*m10;
        float32 i8 =  m4*m9*m15  - m4*m11*m13 - m8*m5*m15 + m8*m7*m13 + m12*m5*m11 - m12*m7*m9;
        float32 i12= -m4*m9*m14  + m4*m10*m13 + m8*m5*m14 - m8*m6*m13 - m12*m5*m10 + m12*m6*m9;
        return m0*i0 + m1*i4 + m2*i8 + m3*i12;
    }
    public fn Mat4 inverse() {
        Vec4 a = this.cols[0]; Vec4 b = this.cols[1]; Vec4 c = this.cols[2]; Vec4 d = this.cols[3];
        float32 m0=a.x; float32 m4=a.y; float32 m8=a.z;  float32 m12=a.w;
        float32 m1=b.x; float32 m5=b.y; float32 m9=b.z;  float32 m13=b.w;
        float32 m2=c.x; float32 m6=c.y; float32 m10=c.z; float32 m14=c.w;
        float32 m3=d.x; float32 m7=d.y; float32 m11=d.z; float32 m15=d.w;
        float32 i0 =  m5*m10*m15 - m5*m11*m14 - m9*m6*m15 + m9*m7*m14 + m13*m6*m11 - m13*m7*m10;
        float32 i4 = -m4*m10*m15 + m4*m11*m14 + m8*m6*m15 - m8*m7*m14 - m12*m6*m11 + m12*m7*m10;
        float32 i8 =  m4*m9*m15  - m4*m11*m13 - m8*m5*m15 + m8*m7*m13 + m12*m5*m11 - m12*m7*m9;
        float32 i12= -m4*m9*m14  + m4*m10*m13 + m8*m5*m14 - m8*m6*m13 - m12*m5*m10 + m12*m6*m9;
        float32 i1 = -m1*m10*m15 + m1*m11*m14 + m9*m2*m15 - m9*m3*m14 - m13*m2*m11 + m13*m3*m10;
        float32 i5 =  m0*m10*m15 - m0*m11*m14 - m8*m2*m15 + m8*m3*m14 + m12*m2*m11 - m12*m3*m10;
        float32 i9 = -m0*m9*m15  + m0*m11*m13 + m8*m1*m15 - m8*m3*m13 - m12*m1*m11 + m12*m3*m9;
        float32 i13=  m0*m9*m14  - m0*m10*m13 - m8*m1*m14 + m8*m2*m13 + m12*m1*m10 - m12*m2*m9;
        float32 i2 =  m1*m6*m15  - m1*m7*m14  - m5*m2*m15 + m5*m3*m14 + m13*m2*m7  - m13*m3*m6;
        float32 i6 = -m0*m6*m15  + m0*m7*m14  + m4*m2*m15 - m4*m3*m14 - m12*m2*m7  + m12*m3*m6;
        float32 i10=  m0*m5*m15  - m0*m7*m13  - m4*m1*m15 + m4*m3*m13 + m12*m1*m7  - m12*m3*m5;
        float32 i14= -m0*m5*m14  + m0*m6*m13  + m4*m1*m14 - m4*m2*m13 - m12*m1*m6  + m12*m2*m5;
        float32 i3 = -m1*m6*m11  + m1*m7*m10  + m5*m2*m11 - m5*m3*m10 - m9*m2*m7   + m9*m3*m6;
        float32 i7 =  m0*m6*m11  - m0*m7*m10  - m4*m2*m11 + m4*m3*m10 + m8*m2*m7   - m8*m3*m6;
        float32 i11= -m0*m5*m11  + m0*m7*m9   + m4*m1*m11 - m4*m3*m9  - m8*m1*m7   + m8*m3*m5;
        float32 i15=  m0*m5*m10  - m0*m6*m9   - m4*m1*m10 + m4*m2*m9  + m8*m1*m6   - m8*m2*m5;
        float32 det = m0*i0 + m1*i4 + m2*i8 + m3*i12;
        float32 k = 1.0f32 / det;
        // inv element (row r, col c) = i[r*4+c]*k; store column-major: invCol_c = (row0,row1,row2,row3)
        Vec4 ic0 = Vec4.of(x: i0*k,  y: i4*k,  z: i8*k,  w: i12*k);
        Vec4 ic1 = Vec4.of(x: i1*k,  y: i5*k,  z: i9*k,  w: i13*k);
        Vec4 ic2 = Vec4.of(x: i2*k,  y: i6*k,  z: i10*k, w: i14*k);
        Vec4 ic3 = Vec4.of(x: i3*k,  y: i7*k,  z: i11*k, w: i15*k);
        return Mat4::fromCols(c0: ic0, c1: ic1, c2: ic2, c3: ic3);
    }
}
