namespace std::math;

// Float32 vectors — Vec2/Vec3/Vec4. Value types (stack, no alloc); layout is contiguous floats (Vec4 = 16B),
// SIMD-ready for a later backend. Operators `+ - *(scalar) /(scalar) -unary ==`; methods dot/length/etc.
// `sqrt` comes from scalar.kama (same `std::math` module).
// Construction (model M8): `@generate(of)` gives the memberwise ctor `Vec2.of(x:, y:)`; the named factories
// (`zero`/`one`/`splat`/`unitX`/`lerp`/…) are `ctor`s.
export { Vec2, Vec3, Vec4 };

@generate(of)
type value Vec2 implements Equatable<This> {
    public float32 x;
    public float32 y;
    public ctor zero()            { return Vec2.of(x: 0.0f32, y: 0.0f32); }
    public ctor one()             { return Vec2.of(x: 1.0f32, y: 1.0f32); }
    public ctor splat(float32 s)  { return Vec2.of(x: s, y: s); }
    public ctor unitX()           { return Vec2.of(x: 1.0f32, y: 0.0f32); }
    public ctor unitY()           { return Vec2.of(x: 0.0f32, y: 1.0f32); }

    public Vec2 operator+(Vec2 r)   { return Vec2.of(x: this.x + r.x, y: this.y + r.y); }
    public Vec2 operator-(Vec2 r)   { return Vec2.of(x: this.x - r.x, y: this.y - r.y); }
    public Vec2 operator*(float32 s){ return Vec2.of(x: this.x * s, y: this.y * s); }
    public Vec2 operator/(float32 s){ return Vec2.of(x: this.x / s, y: this.y / s); }
    public Vec2 operator-()         { return Vec2.of(x: -this.x, y: -this.y); }
    // `==`/`!=` come from `Equatable` (float fields compare with exact IEEE `==`, as they always did).
    public const fn bool equals(const ref Vec2 other) { return this.x == other.x && this.y == other.y; }

    public const fn float32 dot(Vec2 r)     { return this.x * r.x + this.y * r.y; }
    public const fn float32 lengthSq()      { return this.dot(r: this); }
    public const fn float32 length()        { float32 q = this.lengthSq(); return sqrt(x: q); }
    public const fn Vec2 normalized()       { float32 k = 1.0f32 / this.length(); return Vec2.of(x: this.x * k, y: this.y * k); }
    public const fn Vec2 hadamard(Vec2 r)   { return Vec2.of(x: this.x * r.x, y: this.y * r.y); }
    public const fn float32 distance(Vec2 r){ float32 dx = this.x - r.x; float32 dy = this.y - r.y; return sqrt(x: dx*dx + dy*dy); }

    public ctor lerp(Vec2 a, Vec2 b, float32 t) {
        return Vec2.of(x: a.x + (b.x-a.x)*t, y: a.y + (b.y-a.y)*t);
    }
}

@generate(of)
type value Vec3 implements Equatable<This> {
    public float32 x;
    public float32 y;
    public float32 z;
    public ctor zero()            { return Vec3.of(x: 0.0f32, y: 0.0f32, z: 0.0f32); }
    public ctor one()             { return Vec3.of(x: 1.0f32, y: 1.0f32, z: 1.0f32); }
    public ctor splat(float32 s)  { return Vec3.of(x: s, y: s, z: s); }
    public ctor unitX()           { return Vec3.of(x: 1.0f32, y: 0.0f32, z: 0.0f32); }
    public ctor unitY()           { return Vec3.of(x: 0.0f32, y: 1.0f32, z: 0.0f32); }
    public ctor unitZ()           { return Vec3.of(x: 0.0f32, y: 0.0f32, z: 1.0f32); }

    public Vec3 operator+(Vec3 r)   { return Vec3.of(x: this.x + r.x, y: this.y + r.y, z: this.z + r.z); }
    public Vec3 operator-(Vec3 r)   { return Vec3.of(x: this.x - r.x, y: this.y - r.y, z: this.z - r.z); }
    public Vec3 operator*(float32 s){ return Vec3.of(x: this.x * s, y: this.y * s, z: this.z * s); }
    public Vec3 operator/(float32 s){ return Vec3.of(x: this.x / s, y: this.y / s, z: this.z / s); }
    public Vec3 operator-()         { return Vec3.of(x: -this.x, y: -this.y, z: -this.z); }
    public const fn bool equals(const ref Vec3 other) { return this.x == other.x && this.y == other.y && this.z == other.z; }

    public const fn float32 dot(Vec3 r)     { return this.x*r.x + this.y*r.y + this.z*r.z; }
    public const fn float32 lengthSq()      { return this.dot(r: this); }
    public const fn float32 length()        { float32 q = this.lengthSq(); return sqrt(x: q); }
    public const fn Vec3 normalized()       { float32 k = 1.0f32 / this.length(); return Vec3.of(x: this.x*k, y: this.y*k, z: this.z*k); }
    public const fn Vec3 hadamard(Vec3 r)   { return Vec3.of(x: this.x*r.x, y: this.y*r.y, z: this.z*r.z); }
    public const fn Vec3 cross(Vec3 r)      { return Vec3.of(x: this.y*r.z - this.z*r.y, y: this.z*r.x - this.x*r.z, z: this.x*r.y - this.y*r.x); }
    public const fn float32 distance(Vec3 r){ float32 dx=this.x-r.x; float32 dy=this.y-r.y; float32 dz=this.z-r.z; return sqrt(x: dx*dx+dy*dy+dz*dz); }

    public ctor lerp(Vec3 a, Vec3 b, float32 t) {
        return Vec3.of(x: a.x+(b.x-a.x)*t, y: a.y+(b.y-a.y)*t, z: a.z+(b.z-a.z)*t);
    }
}

@generate(of)
type value Vec4 implements Equatable<This> {
    public float32 x;
    public float32 y;
    public float32 z;
    public float32 w;
    public ctor zero()            { return Vec4.of(x: 0.0f32, y: 0.0f32, z: 0.0f32, w: 0.0f32); }
    public ctor splat(float32 s)  { return Vec4.of(x: s, y: s, z: s, w: s); }
    public ctor fromVec3(Vec3 v, float32 w) { return Vec4.of(x: v.x, y: v.y, z: v.z, w: w); }

    public Vec4 operator+(Vec4 r)   { return Vec4.of(x: this.x+r.x, y: this.y+r.y, z: this.z+r.z, w: this.w+r.w); }
    public Vec4 operator-(Vec4 r)   { return Vec4.of(x: this.x-r.x, y: this.y-r.y, z: this.z-r.z, w: this.w-r.w); }
    public Vec4 operator*(float32 s){ return Vec4.of(x: this.x*s, y: this.y*s, z: this.z*s, w: this.w*s); }
    public Vec4 operator/(float32 s){ return Vec4.of(x: this.x/s, y: this.y/s, z: this.z/s, w: this.w/s); }
    public Vec4 operator-()         { return Vec4.of(x: -this.x, y: -this.y, z: -this.z, w: -this.w); }
    public const fn bool equals(const ref Vec4 other) { return this.x==other.x && this.y==other.y && this.z==other.z && this.w==other.w; }

    public const fn float32 dot(Vec4 r)  { return this.x*r.x + this.y*r.y + this.z*r.z + this.w*r.w; }
    public const fn float32 lengthSq()   { return this.dot(r: this); }
    public const fn float32 length()     { float32 q = this.lengthSq(); return sqrt(x: q); }
    public const fn Vec4 normalized()    { float32 k = 1.0f32 / this.length(); return Vec4.of(x: this.x*k, y: this.y*k, z: this.z*k, w: this.w*k); }
    public const fn Vec3 xyz()           { return Vec3.of(x: this.x, y: this.y, z: this.z); }
}
