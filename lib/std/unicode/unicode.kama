// Unicode beyond ASCII: normalization (UAX #15), the sibling of std::ascii.
//
// One piece of text can be spelled more than one way in code points: `é` is U+00E9, or `e` followed by U+0301 COMBINING
// ACUTE ACCENT; `ﬁ` is a ligature of `f` and `i`; a full-width `Ａ` is an `A` laid out for CJK text. Normalizing picks
// ONE spelling, so that two strings that mean the same compare equal byte for byte:
//   - NFD decomposes every precomposed character, and NFC recomposes what can be — the canonical forms, which keep
//     the text's meaning and appearance exactly (`é` either way);
//   - NFKD and NFKC also fold the COMPATIBILITY variants — ligatures, full-width and circled forms, superscripts —
//     into their plain letters, losing the difference on purpose. NFKC is what SASLprep (RFC 4013) applies to a
//     password before SCRAM hashes it, so that `Ａﬁ` and `Afi` log in alike (peer KPG-15), and what an identifier
//     comparison or a search index usually wants.
// A `string` in and a `string` out — UTF-8 both ways; the code points are an implementation detail of the module. The
// tables are the Unicode Character Database at one pinned version (include/kama_unicode.h, generated by
// tools/gen-unicode), held to the UCD's own NormalizationTest.txt by tools/check-unicode.sh, and they cost read-only
// data only in a program that imports this module. ASCII is every form's fixed point, so it is returned at once.
import { std::collections::FixedArray, std::collections::ConstView };

export { NormalizationForm, normalize, isNormalized };

extern "kama_unicode.h";
extern fn isize kama_unicode_normalize(UnsafeConstPtr<uint8> src, usize n, int32 form, UnsafePtr<uint8> into, usize cap);
extern fn string kama_string_from_raw(UnsafeConstPtr<uint8> src, isize start, isize len);

type enum NormalizationForm implements Sendable { Nfc, Nfd, Nfkc, Nfkd }

// `s` in normalization form `form`.
unsafe fn string normalize(const ref string s, NormalizationForm form) {
    isize n = s.length();
    if (n == 0) { return ""; }
    int32 f = match (form) { case Nfc: 0; case Nfd: 1; case Nfkc: 2; case Nfkd: 3; };
    isize cap = n * 3 + 16;   // most text grows little; a longer result is measured and asked for again
    borrow s.bytes() as text {
        while (true) {
            FixedArray<uint8> buf = FixedArray.make(size: cap);
            isize len = kama_unicode_normalize(src: text.dataPtr(), n: cast<usize>(n), form: f, into: buf.dataPtrMut(),
                                               cap: cast<usize>(cap));
            if (len <= cap) {
                if (len == 0) { return ""; }
                return kama_string_from_raw(src: buf.dataPtr(), start: 0, len: len);
            }
            cap = len;
        }
    }
    return "";
}

// Is `s` already in form `form` — would normalizing it change nothing?
unsafe fn bool isNormalized(const ref string s, NormalizationForm form) {
    string n = normalize(s: s, form: form);
    return n == s;
}
