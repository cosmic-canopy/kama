
// Subprocess execution (Rust `Command` / Go `os/exec` / Python `subprocess` shape). Pure library over the
// `kama_os.h` FFI seam — no compiler/language change. A `Command` builder (argv VECTOR, never a shell string,
// so injection-safe by construction) spawns an owned `Process`; `run()` is the one-shot capture. Child pipe
// ends reuse `std::fs::File`, so they compose with `std::io` (Reader/Writer) and the readiness `Poller`.
//
// Lifetime: a `Process` is a move-only RAII resource. Dropping it does a NON-BLOCKING reap (waitpid(WNOHANG)):
// reap if the child already exited, else park the pid for the runtime's reaper to sweep on a later drop —
// the destructor NEVER blocks (avoids the classic blocking-dtor-vs-undrained-pipe deadlock) and never
// leaves a growing pile of zombies either. Explicit `wait()` is the blocking reap that returns the exit
// code. POSIX and Windows both ship — the Windows seam is `CreateProcessW`, UTF-16 at the edge
// (0.9.217), and `tests/proc_*` run there; its one residual is the ≤260 cwd/executable limit noted on
// `cwd()` below. wasm has no fork/exec.

import { std::io::IoError, std::io::IoErrorKind, std::io::lastError, std::io::Descriptor, std::memory::replace, std::fs::File, std::collections::DynamicArray, std::ptr::nonNull };

export { Command, Process, ExitStatus, Output, OutputParts, Stdio, ProcessGroup };

extern "kama_os.h";
// argv/envp marshalling — kama can't build a `char*[]`, so the vector is assembled in C (strdup'd, so it
// survives the source kama-string RAII across fork). kama holds only the opaque `UnsafePtr` + scalars.
extern fn UnsafePtr   kama_argv_new(int32 n);
extern fn void  kama_argv_set(UnsafePtr v, int32 i, UnsafeConstPtr<cchar> s);
extern fn void  kama_argv_free(UnsafePtr v);
extern fn UnsafePtr   kama_envp_build(UnsafePtr overrides, int32 clear);
// pipe + spawn + wait + signal (POSIX fork/exec behind the seam)
extern fn int32 kama_pipe(UnsafePtr<int32> outRd, UnsafePtr<int32> outWr);
extern fn int32 kama_proc_spawn(UnsafePtr argv, UnsafePtr envp, UnsafeConstPtr<cchar> cwd, int32 inFd, int32 outFd, int32 errFd, int32 group, int32 pgid, UnsafePtr<isize> outHandle, UnsafePtr<int32> outPid, UnsafePtr<isize> outJob);
extern fn int32 kama_group_signal(isize job, int32 pgid, int32 sig);
extern fn void  kama_job_close(isize job);
extern fn int32 kama_proc_wait(isize handle, UnsafePtr<int32> outStatus, int32 flags);
// The POSIX wait-status accessors (WIFEXITED & co.). Windows has no such encoding: its status IS the exit code.
@compileFor(!OS_WINDOWS) extern fn int32 kama_proc_exited(int32 st);
@compileFor(!OS_WINDOWS) extern fn uint8 kama_proc_exit_code(int32 st);
@compileFor(!OS_WINDOWS) extern fn int32 kama_proc_signaled(int32 st);
@compileFor(!OS_WINDOWS) extern fn int32 kama_proc_term_signal(int32 st);
extern fn int32 kama_kill(isize handle, int32 sig);
// Non-blocking release on drop: POSIX reaps-if-exited-else-detaches (waitpid WNOHANG); Windows checks then
// CloseHandle. One platform-neutral verb so the dtor stays identical (POSIX has no handle to close).
extern fn void  kama_proc_detach(isize handle);
// Concurrent stdout+stderr drain to EOF (POSIX: poll; Windows: two threads) — see kama_os.h. Fills two heap
// buffers the caller copies out then frees with kama_free, giving back each one's capacity. Keeps run()'s kama
// one platform-neutral path.
// `UnsafePtr<UnsafePtr<uint8>>`, not `UnsafePtr<UnsafePtr>`: the seam takes `uint8_t**`, and the looser spelling lowered to
// `void**` — a real -Wincompatible-pointer-types on every `run()` build. An FFI declaration has to
// name the C type exactly; nothing else checks it.
extern fn int32 kama_capture2(int32 outFd, int32 errFd, UnsafePtr<UnsafePtr<uint8>> outBuf, UnsafePtr<usize> outLen, UnsafePtr<usize> outCap, UnsafePtr<UnsafePtr<uint8>> errBuf, UnsafePtr<usize> errLen, UnsafePtr<usize> errCap);
extern fn void  kama_free(UnsafePtr p, usize n, usize align);
extern fn int32 kama_WNOHANG();
extern fn int32 kama_SIGKILL();
extern fn int32 kama_SIGTERM();
// The platform null device (POSIX "/dev/null", Windows "NUL") for a Null-configured stream, + errno accessors.
extern fn int32 kama_open_null_read();
extern fn int32 kama_open_null_write();
extern fn int32 kama_last_error();
extern fn int32 kama_EINTR();

// Which process group a child runs in (KR-170) — what a supervisor needs to stop a child TOGETHER with everything it
// started (`Process.killGroup()`), where `kill()` stops the child alone. One value, because the choices exclude each
// other. Each OS keeps what is its own (the platform-deltas rule), so the twins differ:
//   POSIX   — `Inherit` (the parent's group), `New` (the child leads a new one: setpgid), `Join(group:)` (another
//             child's group — a pipeline's children share one), `NewSession` (setsid: a new group, and no
//             controlling terminal, so the terminal's Ctrl+C and hang-up no longer reach it).
//   Windows — `Inherit`, `New`: its own console group (the parent's Ctrl+C no longer reaches it) and a Job Object
//             holding the child and everything it starts. The job ends when its last handle closes: dropping the
//             `Process`, or the program exiting, ends the group — a supervisor's children never outlive it.
@compileFor(!OS_WINDOWS)
@nonExhaustive
type enum ProcessGroup implements Sendable { Inherit, New, Join(int32 group), NewSession }
@compileFor(OS_WINDOWS)
@nonExhaustive
type enum ProcessGroup implements Sendable { Inherit, New }

// The seam's encoding of a group: 0 inherit, 1 new, 2 join `groupJoin`, 3 new session.
@compileFor(!OS_WINDOWS)
fn int32 groupKind(const ref ProcessGroup g) { return match (g) { case Inherit: 0; case New: 1; case Join(group: _): 2; case NewSession: 3; }; }
@compileFor(!OS_WINDOWS)
fn int32 groupJoin(const ref ProcessGroup g) { return match (g) { case Join(group: p): p; case _: 0; }; }
@compileFor(OS_WINDOWS)
fn int32 groupKind(const ref ProcessGroup g) { return match (g) { case Inherit: 0; case New: 1; }; }
@compileFor(OS_WINDOWS)
fn int32 groupJoin(const ref ProcessGroup g) { return 0; }

// Where one of a child's streams goes — one value per stream says it all (KR-171):
//   `Inherit` — the parent's own; `Piped` — a pipe the parent keeps an end of (`Process.stdin()`/`stdout()`/
//   `stderr()`); `Null` — the null device; `Handle(descriptor:)` — any owned handle: a `File`, a socket, a pipe end,
//   another child's (`give file.intoDescriptor()`). The child takes it: it is closed in the parent once the child holds
//   it, so a reader of the other end sees end-of-file when the child exits, and it serves ONE `start()` — a second
//   without setting the stream again is `InvalidInput`. (Rust and Python keep the parent's copy open, a known trap.)
//   `Stdout` — stderr into stdout, `2>&1`: it means "wherever stdout goes", so it belongs to stderr alone
//   (Python's `stderr=STDOUT`), and on stdin or stdout it is `InvalidInput`.
// Move-only, since a `Handle` owns what it carries. On Windows a socket is no child's stream (its handle is
// overlapped, which a child's `ReadFile` cannot use): `InvalidInput`.
@nonExhaustive
type enum Stdio implements Sendable { Inherit, Piped, Null, Handle(Descriptor descriptor), Stdout }

// A finished child's status, in each platform's own type — the parent's side of `main`'s typed status. On POSIX a
// process either EXITS with a status the platform keeps one byte of, or is killed by a SIGNAL: exactly one, so each is
// a variant and neither needs a sentinel (this used to be `int32 code` with -1 for "signalled"). On Windows a process
// only exits, with all 32 bits of its code (an installer's 1603 or 3010). Both are `@nonExhaustive`, so portable code
// reads a code with `case Exited(code: c): …` beside a `case _:`, and `success()` is the same question on both.
@compileFor(!OS_WINDOWS) @nonExhaustive
type enum ExitStatus implements Sendable {
    Exited(uint8 code), Signaled(int32 signal);
    public const fn bool success() { return match (this) { case Exited(code: c): c == 0; case _: false; }; }
}
@compileFor(OS_WINDOWS) @nonExhaustive
type enum ExitStatus implements Sendable {
    Exited(uint32 code);
    public const fn bool success() { return match (this) { case Exited(code: c): c == 0; case _: false; }; }
}

// The captured result of `run()`: the finished status plus the fully-drained stdout/stderr bytes. Move-only
// (owns the buffers); read via the accessors — `status()` (a value copy), `stdout()`/`stderr()` (borrows,
// e.g. `out.stdout().length()`).
type resource Output implements Sendable {
    ExitStatus st;
    DynamicArray<uint8> outBytes;
    DynamicArray<uint8> errBytes;
    // Internal — produced by Command.run() (a resource ctor is type-private, so this is exposed like
    // TcpStream.make; not meant to be called directly).
    public ctor make(ExitStatus status, DynamicArray<uint8> stdout, DynamicArray<uint8> stderr) {
        this.st = status; this.outBytes = give stdout; this.errBytes = give stderr;
    }
    public const fn ExitStatus status() { return this.st; }
    public const fn const ref DynamicArray<uint8> stdout() { return this.outBytes; }
    public const fn const ref DynamicArray<uint8> stderr() { return this.errBytes; }
    // Take the result apart, consuming it (KR-261): the captured bytes move out rather than being copied off the
    // borrows — `match (give out.intoParts()) { case Parts(status: s, stdout: o, stderr: e): … }`.
    public give fn OutputParts intoParts() {
        return OutputParts::Parts(status: this.st, stdout: give this.outBytes, stderr: give this.errBytes);
    }
}

// An `Output` taken apart: the status and both captured streams, owned (`intoParts`).
type enum OutputParts implements Sendable { Parts(ExitStatus status, DynamicArray<uint8> stdout, DynamicArray<uint8> stderr); }

// Fold a raw wait-status into an ExitStatus (WIF* accessors stay in C; kama sees only the int status). A status that
// is neither an exit nor a signal is a stopped or continued child, which `kama_proc_wait` never asks to hear about
// (no WUNTRACED, no WCONTINUED) — so it cannot arrive, and if it does the seam is broken, which is a panic.
@compileFor(!OS_WINDOWS)
unsafe fn ExitStatus statusOf(int32 st) {
    if (kama_proc_exited(st: st) != 0)   { return ExitStatus::Exited(code: kama_proc_exit_code(st: st)); }
    if (kama_proc_signaled(st: st) != 0) { return ExitStatus::Signaled(signal: kama_proc_term_signal(st: st)); }
    panic(msg: "std::process: a wait status that is neither an exit nor a signal: ${st}");
}
// Windows: the status IS the 32-bit exit code `GetExitCodeProcess` answered, carried through the seam's `int32`.
@compileFor(OS_WINDOWS)
unsafe fn ExitStatus statusOf(int32 st) { return ExitStatus::Exited(code: bitcast<uint32>(st)); }

// Build a NULL-terminated argv: [program, args...]. Freed by the caller with kama_argv_free. `None` when
// the C side could not allocate the vector (a bare `calloc`; `errno` says ENOMEM).
unsafe fn Optional<UnsafePtr> buildArgv(const ref string program, ref DynamicArray<string> args) {
    isize n = 1 + args.length();
    UnsafePtr v = match (nonNull(p: kama_argv_new(n: cast<int32>(n)))) {
        case Some(value: p): p;
        case None: { return Optional::None; }
    };
    kama_argv_set(v: v, i: 0, s: program.cstr());
    isize i = 0;
    while (i < args.length()) {
        kama_argv_set(v: v, i: cast<int32>(i) + 1, s: args[i].cstr());
        i = i + 1;
    }
    return Optional::Some(value: v);
}

// Build the child's envp = inherited environ (unless `clear`) with each KEY=VALUE override applied. The
// merge (incl. replacing a matching KEY) is done in C; here we just marshal the overrides. Freed by caller.
// `None` when either C allocation failed.
unsafe fn Optional<UnsafePtr> buildEnvp(bool clear, const ref DynamicArray<string> keys, const ref DynamicArray<string> vals) {
    isize n = keys.length();
    UnsafePtr ov = match (nonNull(p: kama_argv_new(n: cast<int32>(n)))) {
        case Some(value: p): p;
        case None: { return Optional::None; }
    };
    isize i = 0;
    while (i < n) {
        string kv = keys[i] + "=" + vals[i];
        kama_argv_set(v: ov, i: cast<int32>(i), s: kv.cstr());
        i = i + 1;
    }
    Optional<UnsafePtr> envp = nonNull(p: kama_envp_build(overrides: ov, clear: clear ? 1 : 0));
    kama_argv_free(v: ov);
    return envp;
}

// Copy `n` bytes out of a raw heap buffer (produced by kama_capture2) into an owned DynamicArray<uint8>.
// The caller frees the source buffer with kama_free afterwards.
unsafe fn DynamicArray<uint8> bytesFromRaw(UnsafePtr raw, usize n) {
    isize c = cast<isize>(n);
    DynamicArray<uint8> a = DynamicArray.withCapacity(capacity: c);
    UnsafePtr<uint8> src = cast<UnsafePtr<uint8>>(raw);
    isize i = 0;
    while (i < c) { a.add(item: src[i]); i = i + 1; }
    return give a;
}

// One stream as a spawn wires it (KR-171): as set, or `dflt` when left alone — and a `Handle` is TAKEN, leaving
// `Inherit` in its place, so it goes to this child alone (`spent` then refuses it to the next).
fn Result<Stdio, IoError> streamOf(ref Stdio cfg, ref bool spent, bool set, Stdio dflt) {
    if (spent) { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); }
    if (!set) { return Result::Ok(value: give dflt); }
    bool handle = match (cfg) { case Handle(descriptor: _): true; case _: false; };
    if (handle) {
        spent = true;
        Stdio emptied = Stdio::Inherit;
        return Result::Ok(value: replace::<Stdio>(place: cfg, with: give emptied));
    }
    return match (cfg) {
        case Piped:  Result::Ok(value: Stdio::Piped);
        case Null:   Result::Ok(value: Stdio::Null);
        case Stdout: Result::Ok(value: Stdio::Stdout);
        case _:      Result::Ok(value: Stdio::Inherit);
    };
}

// A subprocess builder. Accumulates program + args + env overrides + cwd + per-stream Stdio, then
// spawn()/run(). Move-only (owns its lists/strings). Not injection-prone: args are a vector, never a shell
// string (use the explicit `shell` ctor for `sh -c`).
type resource Command implements Sendable {
    string program;
    DynamicArray<string> arguments;
    DynamicArray<string> envKeys;
    DynamicArray<string> envVals;
    bool   clearsEnv;
    string workingDir;       // empty = inherit the parent's cwd
    Stdio  inCfg;
    Stdio  outCfg;
    Stdio  errCfg;
    // Whether a stream was SET (KR-171): `run()` captures what was left alone, and an explicit `Inherit` stays the
    // parent's — so "unset" and `Inherit` are two answers. `spent`: its `Handle` went to an earlier child.
    bool inSet; bool outSet; bool errSet;
    bool inSpent; bool outSpent; bool errSpent;
    ProcessGroup grp;        // KR-170: `Inherit` unless asked

    // Build a command for `program` (PATH-resolved by execvp unless it contains '/'). Args take ownership of
    // the passed string (pass a literal, or `copy someVar`).
    public ctor make(string program) {
        this.program = give program;
        this.arguments = DynamicArray.empty();
        this.envKeys = DynamicArray.empty();
        this.envVals = DynamicArray.empty();
        this.clearsEnv = false;
        this.workingDir = "";
        this.inCfg = Stdio::Inherit; this.outCfg = Stdio::Inherit; this.errCfg = Stdio::Inherit;
        this.inSet = false; this.outSet = false; this.errSet = false;
        this.inSpent = false; this.outSpent = false; this.errSpent = false;
        this.grp = ProcessGroup::Inherit;
    }

    // Opt-in shell form: run `sh -c <line>`. The default (argv vector) stays injection-safe; this is the
    // clearly-named escape hatch when you actually want shell parsing.
    public ctor shell(string line) {
        Command c = Command.make(program: "sh");
        c.arguments.add(item: "-c");
        c.arguments.add(item: give line);
        return give c;
    }

    public fn void arg(string a) { this.arguments.add(item: give a); }
    public fn void args(ref DynamicArray<string> list) {
        isize i = 0;
        while (i < list.length()) { this.arguments.add(item: copy list[i]); i = i + 1; }
    }
    // ⚠️ On Windows a child's cwd (and its executable path) must stay under 260 characters: that is a
    // CreateProcessW limit, not a kama one, and the `\\?\` prefix does NOT lift it. Hand the child
    // absolute paths rather than a deep cwd() plus relative ones.
    public fn void cwd(string dir) { this.workingDir = give dir; }
    public fn void env(string key, string val) { this.envKeys.add(item: give key); this.envVals.add(item: give val); }
    public fn void envClear() { this.clearsEnv = true; }
    public fn void stdin(Stdio s)  { this.inCfg = give s;  this.inSet = true;  this.inSpent = false; }
    public fn void stdout(Stdio s) { this.outCfg = give s; this.outSet = true; this.outSpent = false; }
    public fn void stderr(Stdio s) { this.errCfg = give s; this.errSet = true; this.errSpent = false; }
    // The process group the child runs in (KR-170) — see `ProcessGroup`.
    public fn void processGroup(ProcessGroup group) { this.grp = group; }

    // Spawn the child and return a live Process handle. A stream left unset is the parent's (`Inherit`); a pipe or
    // the null device is opened per Piped/Null stream, and the parent keeps its end (in the Process) while the
    // child's ends close on return (RAII).
    public unsafe fn Result<Process, IoError> start() { return this.launch(capture: false); }

    // The child end of a `Handle`: the descriptor, as the File the seam hands the child. On Windows a socket's
    // descriptor is no file's — `File.adopt` answers `InvalidInput` — which is the refusal `Stdio` documents.
    unsafe fn Result<File, IoError> childEnd(Descriptor d) { return File.adopt(descriptor: give d); }

    // `capture`: `run()`'s defaults — an unset stdout and stderr are captured, an unset stdin is the null device.
    unsafe fn Result<Process, IoError> launch(bool capture) {
        Result<Stdio, IoError> ir = streamOf(cfg: ref this.inCfg, spent: ref this.inSpent, set: this.inSet,
                                                  dflt: capture ? Stdio::Null : Stdio::Inherit);
        Stdio inS = match (give ir) { case Ok(value: v): { := give v; } case Err(error: e): { return Result::Err(error: e); } };
        Result<Stdio, IoError> orr = streamOf(cfg: ref this.outCfg, spent: ref this.outSpent, set: this.outSet,
                                                   dflt: capture ? Stdio::Piped : Stdio::Inherit);
        Stdio outS = match (give orr) { case Ok(value: v): { := give v; } case Err(error: e): { return Result::Err(error: e); } };
        Result<Stdio, IoError> er = streamOf(cfg: ref this.errCfg, spent: ref this.errSpent, set: this.errSet,
                                                  dflt: capture ? Stdio::Piped : Stdio::Inherit);
        Stdio errS = match (give er) { case Ok(value: v): { := give v; } case Err(error: e): { return Result::Err(error: e); } };

        // stdin: parent WRITES inKeep; child READS inGive.
        File inKeep = File.make(fd: -1);
        File inGive = File.make(fd: -1);
        bool inPiped = false;
        match (give inS) {
            case Inherit: {}
            case Piped: {
                int32 rd = 0; int32 wr = 0;
                if (kama_pipe(outRd: addr(of: rd), outWr: addr(of: wr)) != 0) { return Result::Err(error: lastError()); }
                inGive = File.make(fd: rd); inKeep = File.make(fd: wr); inPiped = true;
            }
            case Null: {
                int32 fd = kama_open_null_read();
                if (fd < 0) { return Result::Err(error: lastError()); }
                inGive = File.make(fd: fd);
            }
            case Handle(descriptor: d): {
                Result<File, IoError> f = this.childEnd(d: give d);
                inGive = match (give f) { case Ok(value: v): { := give v; } case Err(error: e): { return Result::Err(error: e); } };
            }
            case Stdout: { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); }   // stderr's alone
        };

        // stdout: parent READS outKeep; child WRITES outGive.
        File outKeep = File.make(fd: -1);
        File outGive = File.make(fd: -1);
        match (give outS) {
            case Inherit: {}
            case Piped: {
                int32 rd = 0; int32 wr = 0;
                if (kama_pipe(outRd: addr(of: rd), outWr: addr(of: wr)) != 0) { return Result::Err(error: lastError()); }
                outGive = File.make(fd: wr); outKeep = File.make(fd: rd);
            }
            case Null: {
                int32 fd = kama_open_null_write();
                if (fd < 0) { return Result::Err(error: lastError()); }
                outGive = File.make(fd: fd);
            }
            case Handle(descriptor: d): {
                Result<File, IoError> f = this.childEnd(d: give d);
                outGive = match (give f) { case Ok(value: v): { := give v; } case Err(error: e): { return Result::Err(error: e); } };
            }
            case Stdout: { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); }   // stderr's alone
        };

        // stderr: parent READS errKeep; child WRITES errGive — or, `Stdout`, wherever stdout went (the seam's -2).
        File errKeep = File.make(fd: -1);
        File errGive = File.make(fd: -1);
        bool merge = false;
        match (give errS) {
            case Inherit: {}
            case Piped: {
                int32 rd = 0; int32 wr = 0;
                if (kama_pipe(outRd: addr(of: rd), outWr: addr(of: wr)) != 0) { return Result::Err(error: lastError()); }
                errGive = File.make(fd: wr); errKeep = File.make(fd: rd);
            }
            case Null: {
                int32 fd = kama_open_null_write();
                if (fd < 0) { return Result::Err(error: lastError()); }
                errGive = File.make(fd: fd);
            }
            case Handle(descriptor: d): {
                Result<File, IoError> f = this.childEnd(d: give d);
                errGive = match (give f) { case Ok(value: v): { := give v; } case Err(error: e): { return Result::Err(error: e); } };
            }
            case Stdout: { merge = true; }
        };

        int32 childIn  = inGive.rawFd();
        int32 childOut = outGive.rawFd();
        int32 childErr = merge ? -2 : errGive.rawFd();

        UnsafePtr argv = match (buildArgv(program: ref this.program, args: ref this.arguments)) {
            case Some(value: v): v;
            case None: { return Result::Err(error: lastError()); }
        };
        UnsafePtr envp = null;
        if (this.clearsEnv || this.envKeys.length() > 0) {
            envp = match (buildEnvp(clear: this.clearsEnv, keys: ref this.envKeys, vals: ref this.envVals)) {
                case Some(value: e): e;
                case None: { kama_argv_free(v: argv); return Result::Err(error: lastError()); }
            };
        }

        isize handle = 0;
        int32 pid = 0;
        isize job = 0;
        int32 gk = groupKind(g: this.grp);
        int32 gj = groupJoin(g: this.grp);
        int32 rc = kama_proc_spawn(argv: argv, envp: envp, cwd: this.workingDir.cstr(),
                                   inFd: childIn, outFd: childOut, errFd: childErr, group: gk, pgid: gj,
                                   outHandle: addr(of: handle), outPid: addr(of: pid), outJob: addr(of: job));
        kama_argv_free(v: argv);
        if (envp != null) { kama_argv_free(v: envp); }
        if (rc != 0) { return Result::Err(error: lastError()); }

        // inGive/outGive/errGive drop at return → close the child-side ends (so the parent's read ends see
        // EOF when the child exits). inKeep/outKeep/errKeep move into the Process.
        // The child's group: one it leads (a new group or session — its id is the child's pid), one it joined, or
        // none of its own (0 — the parent's, which a group signal must never reach).
        int32 group = gk == 1 || gk == 3 ? pid : gk == 2 ? gj : 0;
        return Result::Ok(value: Process.make(handle: handle, pid: pid, group: group, job: job,
                                              inKeep: give inKeep, outKeep: give outKeep, errKeep: give errKeep));
    }

    // One-shot: force stdout+stderr Piped, spawn, DRAIN BOTH CONCURRENTLY to EOF, then wait. The concurrent
    // capture lives in the `kama_capture2` seam (POSIX poll / Windows threads) — reading one stream to EOF
    // then the other would deadlock once the child fills the second pipe. One platform-neutral path here.
    @parks
    public unsafe fn Result<Output, IoError> run() {
        // What was SET wins (KR-171): an unset stdout and stderr are captured, an unset stdin is the null device, and
        // the `Command` is left as it was — `run()` used to force both outputs `Piped` and leave them so. A stream sent
        // elsewhere (`Inherit`, `Null`, a `Handle`, stderr's `Stdout`) captures nothing, and its buffer is empty.
        Result<Process, IoError> sp = this.launch(capture: true);
        Process p = match (give sp) {
            case Ok(value: pr): { := give pr; }
            case Err(error: e): { return Result::Err(error: e); }
        };
        p.closeStdin();   // a piped stdin nobody writes would hold a child reading to end-of-file
        UnsafePtr<uint8> outRaw = null; usize outLen = 0; usize outCap = 0;
        UnsafePtr<uint8> errRaw = null; usize errLen = 0; usize errCap = 0;
        int32 rc = kama_capture2(outFd: p.stdout().rawFd(), errFd: p.stderr().rawFd(),
                                 outBuf: addr(of: outRaw), outLen: addr(of: outLen), outCap: addr(of: outCap),
                                 errBuf: addr(of: errRaw), errLen: addr(of: errLen), errCap: addr(of: errCap));
        if (rc != 0) { return Result::Err(error: lastError()); }
        DynamicArray<uint8> outBuf = bytesFromRaw(raw: outRaw, n: outLen);
        DynamicArray<uint8> errBuf = bytesFromRaw(raw: errRaw, n: errLen);
        if (outRaw != null) { kama_free(p: outRaw, n: outCap, align: 1); }
        if (errRaw != null) { kama_free(p: errRaw, n: errCap, align: 1); }

        Result<ExitStatus, IoError> stR = p.wait();
        ExitStatus status = match (stR) {
            case Ok(value: s): s;
            case Err(error: e): { return Result::Err(error: e); }
        };
        return Result::Ok(value: Output.make(status: status, stdout: give outBuf, stderr: give errBuf));
    }
}

// A spawned child. Move-only, RAII. Holds the pid + the parent-side pipe ends (a File per Piped stream, else
// an empty File, -1, the drop-guard skips).
type resource Process implements Sendable {
    isize handle;             // OS wait handle (POSIX: pid; Windows: (isize)hProcess). != 0 live/reapable;
                              //   0 = reaped / moved-from sentinel. wait/kill/dtor act on THIS.
    int32 pid;                // the real OS pid, reported by id() on both platforms
    int32 group;              // KR-170: the process group it runs in, when it is its own (0: the parent's)
    isize job;                // KR-170, Windows: the Job Object a `New` group is (0 otherwise); closed at drop
    bool  reaped;
    File  inPipe;             // parent write end  (child stdin)  when inCfg==Piped
    File  outPipe;            // parent read end   (child stdout) when outCfg==Piped
    File  errPipe;            // parent read end   (child stderr) when errCfg==Piped

    // Internal — produced by Command.start() (exposed like TcpStream.make; not meant to be called directly).
    public ctor make(isize handle, int32 pid, int32 group, isize job, File inKeep, File outKeep, File errKeep) {
        this.handle = handle; this.pid = pid; this.group = group; this.job = job; this.reaped = false;
        this.inPipe = give inKeep; this.outPipe = give outKeep; this.errPipe = give errKeep;
    }

    // The child's process id (Rust `.id()`).
    public const fn int32 id() { return this.pid; }

    // Borrow the parent-side pipe ends (meaningful only when that stream was Piped — else it's an empty File{-1}
    // sentinel over stdin/stdout, so don't read/write a non-Piped stream). Write to stdin(), read stdout()/
    // stderr(). Call closeStdin() to send EOF to a child reading its stdin.
    public fn ref File stdin()  { return this.inPipe; }
    public fn ref File stdout() { return this.outPipe; }
    public fn ref File stderr() { return this.errPipe; }

    // Take a pipe end out, leaving the empty `File` in its place (Rust's `child.stdout.take()`): what a pipeline hands
    // the next child, `Stdio::Handle(descriptor: give out.intoDescriptor())`, or what a fiber reads apart from the
    // process. A stream that was not Piped, or was taken already, comes back empty.
    public unsafe fn File takeStdin()  { return replace(place: this.inPipe, with: File.make(fd: -1)); }
    public unsafe fn File takeStdout() { return replace(place: this.outPipe, with: File.make(fd: -1)); }
    public unsafe fn File takeStderr() { return replace(place: this.errPipe, with: File.make(fd: -1)); }

    // Close the child's stdin write end NOW → the child reading its stdin sees EOF. Explicit close (not a
    // drop) so the child (whose inherited copy of this fd is FD_CLOEXEC'd away at exec) is the last holder.
    public fn void closeStdin() { this.inPipe.close(); }

    // Blocking reap → the child's ExitStatus. EINTR-retried; sets reaped (a second wait/dtor is a no-op).
    @parks
    public unsafe fn Result<ExitStatus, IoError> wait() {
        if (this.reaped) { return Result::Err(error: IoError.of(kind: IoErrorKind::Other)); }
        int32 st = 0;
        while (true) {
            int32 r = kama_proc_wait(handle: this.handle, outStatus: addr(of: st), flags: 0);
            if (r >= 0) { this.reaped = true; this.handle = 0; this.pid = 0; return Result::Ok(value: statusOf(st: st)); }
            if (kama_last_error() != kama_EINTR()) { return Result::Err(error: lastError()); }
        }
    }

    // Non-blocking reap. Ok(Some) if the child exited (status collected), Ok(None) if still running.
    public unsafe fn Result<Optional<ExitStatus>, IoError> tryWait() {
        if (this.reaped) { return Result::Ok(value: Optional::None); }
        int32 st = 0;
        while (true) {
            int32 r = kama_proc_wait(handle: this.handle, outStatus: addr(of: st), flags: kama_WNOHANG());
            if (r == 0) { return Result::Ok(value: Optional::None); }
            if (r > 0)  { this.reaped = true; this.handle = 0; this.pid = 0; return Result::Ok(value: Optional::Some(value: statusOf(st: st))); }
            if (kama_last_error() != kama_EINTR()) { return Result::Err(error: lastError()); }
        }
    }

    // Send a signal to the child. No-op if already reaped/detached (handle == 0). On Windows any signal maps
    // to TerminateProcess — see kama_kill; `signal(sig)` fidelity is POSIX-only.
    public unsafe fn Result<Unit, IoError> signal(int32 sig) {
        if (this.handle == 0) { return Result::Ok(value: Unit::Unit); }
        if (kama_kill(handle: this.handle, sig: sig) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }
    public unsafe fn Result<Unit, IoError> kill()      { return this.signal(sig: kama_SIGKILL()); }
    public unsafe fn Result<Unit, IoError> terminate() { return this.signal(sig: kama_SIGTERM()); }

    // The process group the child runs in, when it is not the parent's (KR-170): the group it leads (`New`,
    // `NewSession` — its id is the child's pid) or the one it joined. `None` for `Inherit`. What another child's
    // `ProcessGroup::Join(group:)` takes, on POSIX.
    public const fn Optional<int32> groupId() {
        if (this.group == 0) { return Optional::None; }
        return Optional::Some(value: this.group);
    }
    // Signal the child's whole GROUP — every process in it, what the child started included (POSIX killpg; on
    // Windows the Job Object ends them all, as any signal is termination there). It keeps working after `wait()`:
    // the group outlives its leader. A child that runs in the parent's group (`Inherit`) has none of its own to
    // signal — `InvalidInput`, never the parent's own group. A group whose every process has exited is
    // `ProcessNotFound` on POSIX.
    public unsafe fn Result<Unit, IoError> signalGroup(int32 sig) {
        if (this.group == 0) { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); }
        if (kama_group_signal(job: this.job, pgid: this.group, sig: sig) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }
    public unsafe fn Result<Unit, IoError> killGroup()      { return this.signalGroup(sig: kama_SIGKILL()); }
    public unsafe fn Result<Unit, IoError> terminateGroup() { return this.signalGroup(sig: kama_SIGTERM()); }

    // Non-blocking reap/detach on drop: reap if already exited, else hand the pid to the runtime's reaper
    // park, which sweeps it on a later drop (POSIX cannot reparent a live child to init while WE are still
    // running, so an un-swept pid would stay a zombie and eventually exhaust the process table — see
    // kama_proc_detach). NEVER blocks. Then the pipe Files drop, closing any live fds.
    unsafe ~Process() {
        if (this.handle != 0 && !this.reaped) {
            kama_proc_detach(handle: this.handle);
        }
        kama_job_close(job: this.job);   // Windows: a `New` group's job — closing it ends the group (KR-170)
    }
}
