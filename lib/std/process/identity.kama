// Who a process runs as — its user and group accounts (KR-104).
//
// ONE interface on every OS (the maintainer, 2026-09-30: the primary interface is the same, and each platform's
// deltas live in the types it returns — a platform is never cut down to the common subset). `UserId` and
// `GroupId` compare with `==`, name their account with `name()` and render with `${…}` everywhere. What an
// identity IS differs, and each OS's twin keeps its own native form: a numeric uid/gid on Linux and macOS
// (`raw()`, `of(raw:)`), a security identifier on Windows (`sid()`, `fromSid(bytes:)`, and the account's
// `domain()`), whose process identity is an access token (`AccessToken`, Windows' own addition).
//
// The twins are whole types gated by `@compileFor` — a member cannot be gated, by design, so each OS's body
// lives in that OS's type rather than behind a conditional inside one.
import {
    std::io::IoError, std::io::IoErrorKind, std::io::lastError,
    std::collections::FixedArray, std::collections::DynamicArray, std::collections::ConstView,
    std::encoding::utf8::decode, std::encoding::utf8::Utf8Error, core::env, std::time::Timestamp,
};

export { UserId, GroupId, AccessToken, currentUser, currentGroup, currentProcessId, homeDirectory,
         currentDirectory, setCurrentDirectory, ProcessStamp, processStamp, processExists, processStarted, bootTime,
         processGroupExists };

extern "kama_os.h";
extern fn int32 kama_getpid();
extern fn int32 kama_proc_exists(int32 pid);
extern fn int32 kama_proc_stamp(int32 pid, UnsafePtr<uint8> boot16, UnsafePtr<uint64> start);
extern fn int32 kama_proc_started_ns(int32 pid, UnsafePtr<int64> into);
extern fn int32 kama_boot_time_ns(UnsafePtr<int64> into);
@compileFor(!OS_WINDOWS) extern fn int32 kama_pgrp_exists(int32 group);
extern fn isize kama_getcwd(UnsafePtr<uint8> into, usize cap);
extern fn int32 kama_chdir(UnsafeConstPtr<cchar> path);
@compileFor(!OS_WINDOWS) extern fn uint32 kama_getuid();
@compileFor(!OS_WINDOWS) extern fn uint32 kama_getgid();
@compileFor(!OS_WINDOWS) extern fn isize  kama_id_name(int32 group, uint32 id, UnsafePtr<uint8> into, usize cap);
@compileFor(OS_WINDOWS)  extern fn isize  kama_token_open(int32 pid);
@compileFor(OS_WINDOWS)  extern fn void   kama_token_close(isize tok);
@compileFor(OS_WINDOWS)  extern fn int32  kama_token_sid(isize tok, int32 which, UnsafePtr<uint8> into, usize cap);
@compileFor(OS_WINDOWS)  extern fn int32  kama_sid_name(UnsafeConstPtr<uint8> sid, UnsafePtr<uint8> name, usize ncap, UnsafePtr<int32> nlen,
                                                        UnsafePtr<uint8> dom, usize dcap, UnsafePtr<int32> dlen);
@compileFor(OS_WINDOWS)  extern fn isize  kama_sid_home(UnsafeConstPtr<uint8> sid, UnsafePtr<uint8> into, usize cap);

// This process's id — what `Process.id()` reports for a child, and `PeerCredentials.processId()` for the
// process on the other end of a Unix socket.
unsafe fn int32 currentProcessId() { return kama_getpid(); }

// ---- another process: alive, and the same one? (KR-219) -------------------------------------------------------------
//
// A pid alone is not a process: the OS reuses it. `ProcessStamp` is the identity a lock file or a pid file records
// beside it — `"${processStamp(id: pid)}"` written out, `ProcessStamp.parse(text:)` read back and compared — and it is
// made only of values the kernel recorded once: on Linux and macOS this boot's UUID (`boot_id`,
// `kern.bootsessionuuid`) and the process's start (`/proc/<pid>/stat`'s ticks since boot; `p_starttime`), on Windows
// the creation time, which is absolute. A wall-clock start or boot time is NOT an identity: each is "now, less the
// time since boot", recomputed when the clock is set, so after an NTP step or a VM resume a live holder's would no
// longer match (psutil's `(pid, create_time)` and Java's `ProcessHandle` equality move with Linux's `btime`).
// `processStarted` and `bootTime` answer those times for display only. A lock file itself is `File.lock`, which the
// kernel releases when its holder dies; the stamp answers what a lock cannot — WHO holds it, before a pid read from
// a file is signalled.
//
// A process that has exited but not been reaped by its parent still exists on Linux and macOS; on Windows an exited
// process is gone. A wasm target has no other processes: each call answers `Other` (ENOSYS).
@compileFor(!OS_WINDOWS)
@generate(Equatable, Hashable)
type value ProcessStamp implements Formattable, Sendable {
    uint64 bootHi;   // this boot's UUID, its first 8 bytes big-endian here...
    uint64 bootLo;   // ...and its last 8
    uint64 start;
    ctor make(uint64 bootHi, uint64 bootLo, uint64 start) { this.bootHi = bootHi; this.bootLo = bootLo; this.start = start; }
    friend processStamp[make];
    // `<boot UUID as 32 hex digits>-<start>`, the text `format` writes; anything else is `InvalidInput`.
    public ctor Result<ProcessStamp, IoError> parse(const ref string text) {
        uint64 hi = 0ui64;
        uint64 lo = 0ui64;
        uint64 st = 0ui64;
        isize n = text.length();
        if (n < 34) { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); }
        isize i = 0;
        while (i < 32) {
            int32 h = hexDigit(c: text[i]);
            if (h < 0) { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); }
            if (i < 16) { hi = (hi << 4ui64) | cast<uint64>(h); } else { lo = (lo << 4ui64) | cast<uint64>(h); }
            i = i + 1;
        }
        if (text[32] != 45ui8) { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); }   // '-'
        i = 33;
        while (i < n) {
            uint8 c = text[i];
            if (c < 48ui8 || c > 57ui8 || st > 1844674407370955160ui64) { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); }
            st = st * 10ui64 + cast<uint64>(c - 48ui8);
            i = i + 1;
        }
        return Result::Ok(value: ProcessStamp.make(bootHi: hi, bootLo: lo, start: st));
    }
    public const fn void format(ref Formatter f) {
        f.writeStr(s: hex16(v: this.bootHi)); f.writeStr(s: hex16(v: this.bootLo));
        f.writeStr(s: "-");
        f.writeU64(v: this.start);
    }
}

@compileFor(OS_WINDOWS)
@generate(Equatable, Hashable)
type value ProcessStamp implements Formattable, Sendable {
    uint64 created;
    ctor make(uint64 created) { this.created = created; }
    friend processStamp[make];
    // The creation time as decimal 100 ns ticks, the text `format` writes; anything else is `InvalidInput`.
    public ctor Result<ProcessStamp, IoError> parse(const ref string text) {
        uint64 v = 0ui64;
        isize n = text.length();
        if (n == 0) { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); }
        isize i = 0;
        while (i < n) {
            uint8 c = text[i];
            if (c < 48ui8 || c > 57ui8 || v > 1844674407370955160ui64) { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); }
            v = v * 10ui64 + cast<uint64>(c - 48ui8);
            i = i + 1;
        }
        return Result::Ok(value: ProcessStamp.make(created: v));
    }
    public const fn void format(ref Formatter f) { f.writeU64(v: this.created); }
}

fn int32 hexDigit(uint8 c) {
    if (c >= 48ui8 && c <= 57ui8) { return cast<int32>(c - 48ui8); }
    if (c >= 97ui8 && c <= 102ui8) { return cast<int32>(c - 87ui8); }
    if (c >= 65ui8 && c <= 70ui8) { return cast<int32>(c - 55ui8); }
    return 0 - 1;
}
// 16 lowercase hex digits, leading zeros kept.
fn string hex16(uint64 v) { return "${v:016x}"; }

// The identity of the live process `id`, or `None` when no process has it.
@compileFor(!OS_WINDOWS)
unsafe fn Result<Optional<ProcessStamp>, IoError> processStamp(int32 id) {
    InlineArray<uint8>#(16) boot = [0ui8; 16];
    uint64 start = 0ui64;
    int32 r = kama_proc_stamp(pid: id, boot16: addr(of: boot[0]), start: addr(of: start));
    if (r < 0) { return Result::Err(error: lastError()); }
    if (r == 0) { return Result::Ok(value: Optional::None); }
    uint64 hi = 0ui64;
    uint64 lo = 0ui64;
    isize i = 0;
    while (i < 8) { hi = (hi << 8ui64) | cast<uint64>(boot[i]); lo = (lo << 8ui64) | cast<uint64>(boot[i + 8]); i = i + 1; }
    return Result::Ok(value: Optional::Some(value: ProcessStamp.make(bootHi: hi, bootLo: lo, start: start)));
}
@compileFor(OS_WINDOWS)
unsafe fn Result<Optional<ProcessStamp>, IoError> processStamp(int32 id) {
    InlineArray<uint8>#(16) boot = [0ui8; 16];
    uint64 start = 0ui64;
    int32 r = kama_proc_stamp(pid: id, boot16: addr(of: boot[0]), start: addr(of: start));
    if (r < 0) { return Result::Err(error: lastError()); }
    if (r == 0) { return Result::Ok(value: Optional::None); }
    return Result::Ok(value: Optional::Some(value: ProcessStamp.make(created: start)));
}

// Does a process with this id exist? A cheap check — identity is `processStamp`.
unsafe fn Result<bool, IoError> processExists(int32 id) {
    int32 r = kama_proc_exists(pid: id);
    if (r < 0) { return Result::Err(error: lastError()); }
    return Result::Ok(value: r == 1);
}

// When the process `id` started, on the wall clock — for display: it moves when the clock is set (see above).
unsafe fn Result<Optional<Timestamp>, IoError> processStarted(int32 id) {
    int64 ns = 0i64;
    int32 r = kama_proc_started_ns(pid: id, into: addr(of: ns));
    if (r < 0) { return Result::Err(error: lastError()); }
    if (r == 0) { return Result::Ok(value: Optional::None); }
    return Result::Ok(value: Optional::Some(value: Timestamp.fromUnixNanos(n: ns)));
}

// When the machine booted, on the wall clock — for display, as `processStarted` is.
unsafe fn Result<Timestamp, IoError> bootTime() {
    int64 ns = 0i64;
    if (kama_boot_time_ns(into: addr(of: ns)) != 0) { return Result::Err(error: lastError()); }
    return Result::Ok(value: Timestamp.fromUnixNanos(n: ns));
}

// Does the process group exist (`kill(-group, 0)`)? POSIX only, beside `ProcessGroup`: Windows has job objects.
@compileFor(!OS_WINDOWS)
unsafe fn Result<bool, IoError> processGroupExists(int32 group) {
    int32 r = kama_pgrp_exists(group: group);
    if (r < 0) { return Result::Err(error: lastError()); }
    return Result::Ok(value: r == 1);
}

// The current directory (KR-167): what a relative path is relative to, so a path given on a command line can be
// made absolute without running `pwd`. It belongs to the PROCESS: `setCurrentDirectory` changes it for every isolate
// at once, racing any that resolves a relative path meanwhile — set it at startup, or hand on absolute paths. On
// Windows it is MAX_PATH-bound (SetCurrentDirectoryW refuses a longer one, with or without `\\?\`), as
// `Command.cwd` is; the answer drops the verbatim prefix as `std::fs::canonicalPath`'s does.
unsafe fn Result<string, IoError> currentDirectory() {
    isize cap = 1024;
    while (true) {
        FixedArray<uint8> buf = FixedArray.make(size: cap);
        isize n = kama_getcwd(into: buf.dataPtrMut(), cap: cast<usize>(cap));
        if (n < 0) { return Result::Err(error: lastError()); }
        if (n <= cap) { return textOf(bytes: buf.slice(from: 0, count: n)); }
        cap = n;   // longer than the buffer: ask again with room for it
    }
}
unsafe fn Result<Unit, IoError> setCurrentDirectory(const ref string path) {
    if (kama_chdir(path: path.cstr()) != 0) { return Result::Err(error: lastError()); }
    return Result::Ok(value: Unit::Unit);
}

// Account text off the OS is outside input: it is UTF-8 on every system kama targets, and checked as such.
fn Result<string, IoError> textOf(ConstView<uint8> bytes) {
    Result<string, Utf8Error> r = decode(bytes: bytes);
    return match (give r) { case Ok(value: s): Result::Ok(value: give s); case Err(error: e): Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); };
}

// ---- Linux, macOS (and the wasm build, whose libc answers as a single user) ---------------------------------

// The account name of a uid (`group` 0) or gid (1), or a uid's home directory (2): `NotFound` when no account has
// that id, or records no home directory.
@compileFor(!OS_WINDOWS)
unsafe fn Result<string, IoError> idName(int32 group, uint32 id) {
    isize cap = 256;
    while (true) {
        FixedArray<uint8> buf = FixedArray.make(size: cap);
        isize n = kama_id_name(group: group, id: id, into: buf.dataPtrMut(), cap: cast<usize>(cap));
        if (n < 0) { return Result::Err(error: lastError()); }
        if (n <= cap) { return textOf(bytes: buf.slice(from: 0, count: n)); }
        cap = n;   // the name is longer than the buffer: ask again with room for it
    }
}

@compileFor(!OS_WINDOWS)
type value UserId implements Equatable<This>, Formattable, Sendable {
    uint32 uid;
    public ctor of(uint32 raw) { this.uid = raw; }            // a uid is a number, and any number may be asked about
    public const fn uint32 raw() { return this.uid; }
    public fn Result<string, IoError> name() { return idName(group: 0, id: this.uid); }
    // The home directory the account database records for this user (its passwd entry's `pw_dir`).
    public fn Result<string, IoError> homeDirectory() { return idName(group: 2, id: this.uid); }
    public const fn bool equals(const ref UserId other) { return this.uid == other.uid; }
    public const fn void format(ref Formatter f) { f.writeU64(v: cast<uint64>(this.uid)); }
}

@compileFor(!OS_WINDOWS)
type value GroupId implements Equatable<This>, Formattable, Sendable {
    uint32 gid;
    public ctor of(uint32 raw) { this.gid = raw; }
    public const fn uint32 raw() { return this.gid; }
    public fn Result<string, IoError> name() { return idName(group: 1, id: this.gid); }
    public const fn bool equals(const ref GroupId other) { return this.gid == other.gid; }
    public const fn void format(ref Formatter f) { f.writeU64(v: cast<uint64>(this.gid)); }
}

// The account this process runs as, and its primary group. Fallible on every OS because Windows reads them
// from the process's token; here they cannot fail.
@compileFor(!OS_WINDOWS) unsafe fn Result<UserId, IoError> currentUser() { return Result::Ok(value: UserId.of(raw: kama_getuid())); }
@compileFor(!OS_WINDOWS) unsafe fn Result<GroupId, IoError> currentGroup() { return Result::Ok(value: GroupId.of(raw: kama_getgid())); }

// ---- Windows ------------------------------------------------------------------------------------------------

// A security identifier as the OS hands it over: revision 1, 1..15 sub-authorities, 8 + 4n bytes (at most 68).
// Anything else is `InvalidInput` — the bytes arrive from outside, so they are checked, not trusted.
@compileFor(OS_WINDOWS)
fn bool sidValid(ConstView<uint8> bytes) {
    isize n = bytes.length();
    if (n < 8 || n > 68 || bytes[0] != 1ui8) { return false; }
    return n == 8 + 4 * cast<isize>(bytes[1]);
}

// The SID's text form, `S-1-5-21-…`: revision, the 48-bit big-endian authority, then each 32-bit little-endian
// sub-authority — what `ConvertSidToStringSid` prints, written out rather than pulling in <sddl.h>.
@compileFor(OS_WINDOWS)
fn void sidText(const ref InlineArray<uint8>#(68) b, ref Formatter f) {
    f.writeStr(s: "S-");
    f.writeU64(v: cast<uint64>(b[0]));
    uint64 auth = 0ui64;
    isize i = 2;
    while (i < 8) { auth = auth * 256ui64 + cast<uint64>(b[i]); i = i + 1; }
    f.writeStr(s: "-");
    f.writeU64(v: auth);
    isize k = 0;
    while (k < cast<isize>(b[1])) {
        isize o = 8 + 4 * k;
        uint64 sub = cast<uint64>(b[o]) + cast<uint64>(b[o + 1]) * 256ui64 + cast<uint64>(b[o + 2]) * 65536ui64
                   + cast<uint64>(b[o + 3]) * 16777216ui64;
        f.writeStr(s: "-");
        f.writeU64(v: sub);
        k = k + 1;
    }
}

@compileFor(OS_WINDOWS)
fn bool sidEqual(const ref InlineArray<uint8>#(68) a, int32 alen, const ref InlineArray<uint8>#(68) b, int32 blen) {
    if (alen != blen) { return false; }
    isize i = 0;
    while (i < cast<isize>(alen)) { if (a[i] != b[i]) { return false; } i = i + 1; }
    return true;
}

// The account a SID names: `domain` false for its name, true for its domain (`MACHINE` or `DOMAIN`).
// The profile directory of the account a SID names, asking again with room when the first buffer is short.
@compileFor(OS_WINDOWS)
unsafe fn Result<string, IoError> sidHome(const ref InlineArray<uint8>#(68) b) {
    isize cap = 512;
    while (true) {
        FixedArray<uint8> buf = FixedArray.make(size: cap);
        isize n = kama_sid_home(sid: addr(of: b[0]), into: buf.dataPtrMut(), cap: cast<usize>(cap));
        if (n < 0) { return Result::Err(error: lastError()); }
        if (n <= cap) { return textOf(bytes: buf.slice(from: 0, count: n)); }
        cap = n;
    }
}

@compileFor(OS_WINDOWS)
unsafe fn Result<string, IoError> sidAccount(const ref InlineArray<uint8>#(68) b, bool domain) {
    FixedArray<uint8> name = FixedArray.make(size: 1024);
    FixedArray<uint8> dom = FixedArray.make(size: 1024);
    int32 nl = 0;
    int32 dl = 0;
    if (kama_sid_name(sid: addr(of: b[0]), name: name.dataPtrMut(), ncap: 1024, nlen: addr(of: nl),
                      dom: dom.dataPtrMut(), dcap: 1024, dlen: addr(of: dl)) != 0) { return Result::Err(error: lastError()); }
    return domain ? textOf(bytes: dom.slice(from: 0, count: cast<isize>(dl)))
                  : textOf(bytes: name.slice(from: 0, count: cast<isize>(nl)));
}

@compileFor(OS_WINDOWS)
type value UserId implements Equatable<This>, Formattable, Sendable {
    InlineArray<uint8>#(68) sidBytes;
    int32 sidLen;
    public ctor Result<UserId, IoError> fromSid(ConstView<uint8> bytes) {
        if (!sidValid(bytes: bytes)) { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); }
        InlineArray<uint8>#(68) b = [0; 68];
        isize i = 0;
        while (i < bytes.length()) { b[i] = bytes[i]; i = i + 1; }
        return Result::Ok(value: UserId.raw(bytes: b, len: cast<int32>(bytes.length())));
    }
    ctor raw(const ref InlineArray<uint8>#(68) bytes, int32 len) { this.sidBytes = bytes; this.sidLen = len; }
    public const fn string sid() { return "${this}"; }
    public fn Result<string, IoError> name() { return sidAccount(b: this.sidBytes, domain: false); }
    public fn Result<string, IoError> domain() { return sidAccount(b: this.sidBytes, domain: true); }
    // The profile directory Windows records for this account (`ProfileList`), `NotFound` when it has none here.
    public fn Result<string, IoError> homeDirectory() { return sidHome(b: this.sidBytes); }
    public const fn bool equals(const ref UserId other) { return sidEqual(a: this.sidBytes, alen: this.sidLen, b: other.sidBytes, blen: other.sidLen); }
    public const fn void format(ref Formatter f) { sidText(b: this.sidBytes, f: ref f); }
}

@compileFor(OS_WINDOWS)
type value GroupId implements Equatable<This>, Formattable, Sendable {
    InlineArray<uint8>#(68) sidBytes;
    int32 sidLen;
    public ctor Result<GroupId, IoError> fromSid(ConstView<uint8> bytes) {
        if (!sidValid(bytes: bytes)) { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); }
        InlineArray<uint8>#(68) b = [0; 68];
        isize i = 0;
        while (i < bytes.length()) { b[i] = bytes[i]; i = i + 1; }
        return Result::Ok(value: GroupId.raw(bytes: b, len: cast<int32>(bytes.length())));
    }
    ctor raw(const ref InlineArray<uint8>#(68) bytes, int32 len) { this.sidBytes = bytes; this.sidLen = len; }
    public const fn string sid() { return "${this}"; }
    public fn Result<string, IoError> name() { return sidAccount(b: this.sidBytes, domain: false); }
    public fn Result<string, IoError> domain() { return sidAccount(b: this.sidBytes, domain: true); }
    public const fn bool equals(const ref GroupId other) { return sidEqual(a: this.sidBytes, alen: this.sidLen, b: other.sidBytes, blen: other.sidLen); }
    public const fn void format(ref Formatter f) { sidText(b: this.sidBytes, f: ref f); }
}

// A process's access token — who a Windows process runs as: its user, its primary group and every group it
// belongs to. `current()` is this process's; `ofProcess(id:)` another's, which a less privileged process may
// be refused (`PermissionDenied`). Closed on drop.
@compileFor(OS_WINDOWS)
type resource AccessToken implements Sendable {
    isize handle = -1;
    ctor adopt(isize handle) { this.handle = handle; }
    public ctor Result<AccessToken, IoError> current() { return AccessToken.ofProcess(id: 0); }
    public unsafe ctor Result<AccessToken, IoError> ofProcess(int32 id) {
        isize h = kama_token_open(pid: id);
        if (h < 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: AccessToken.adopt(handle: h));
    }
    // The SID at `which` (0 user, 1 primary group, 2+i the i-th group) into `b`; its length, 0 past the end.
    unsafe fn Result<int32, IoError> sidAt(int32 which, ref InlineArray<uint8>#(68) b) {
        int32 n = kama_token_sid(tok: this.handle, which: which, into: addr(of: b[0]), cap: 68);
        if (n < 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: n);
    }
    public fn Result<UserId, IoError> user() {
        InlineArray<uint8>#(68) b = [0; 68];
        return match (this.sidAt(which: 0, b: ref b)) {
            case Err(error: e): Result::Err(error: e);
            case Ok(value: n): UserId.fromSid(bytes: b.view().slice(from: 0, count: cast<isize>(n)));
        };
    }
    public fn Result<GroupId, IoError> primaryGroup() {
        InlineArray<uint8>#(68) b = [0; 68];
        return match (this.sidAt(which: 1, b: ref b)) {
            case Err(error: e): Result::Err(error: e);
            case Ok(value: n): GroupId.fromSid(bytes: b.view().slice(from: 0, count: cast<isize>(n)));
        };
    }
    public fn Result<DynamicArray<GroupId>, IoError> groups() {
        DynamicArray<GroupId> all = DynamicArray.empty();
        int32 i = 0;
        bool more = true;
        while (more) {
            InlineArray<uint8>#(68) b = [0; 68];
            int32 n = 0;
            match (this.sidAt(which: 2 + i, b: ref b)) { case Err(error: e): { return Result::Err(error: e); } case Ok(value: v): { n = v; } };
            if (n == 0) {
                more = false;                                      // past the last group
            } else {
                match (GroupId.fromSid(bytes: b.view().slice(from: 0, count: cast<isize>(n)))) {
                    case Err(error: e): { return Result::Err(error: e); }
                    case Ok(value: g): { all.add(item: g); }
                };
                i = i + 1;
            }
        }
        return Result::Ok(value: give all);
    }
    unsafe ~AccessToken() { if (this.handle >= 0) { kama_token_close(tok: this.handle); } }
}

@compileFor(OS_WINDOWS)
fn Result<UserId, IoError> currentUser() {
    return match (AccessToken.current()) { case Ok(value: t): t.user(); case Err(error: e): Result::Err(error: e); };
}
@compileFor(OS_WINDOWS)
fn Result<GroupId, IoError> currentGroup() {
    return match (AccessToken.current()) { case Ok(value: t): t.primaryGroup(); case Err(error: e): Result::Err(error: e); };
}

// ---- the current user's home directory --------------------------------------------------------------------------

// Where the current user's own files live: the variable every program on the platform honors — `$HOME` on Linux and
// macOS, `%USERPROFILE%` on Windows — when it is set and not empty, else what the account database records for the
// user (`UserId.homeDirectory()`). The variable comes first because a service manager, a container or a test may set
// it apart from the account, and the program is meant to follow it; the account is what is left when nothing set it.
// Rust's `std::env::home_dir`, and how libpq finds `~/.pgpass`.
@compileFor(!OS_WINDOWS)
unsafe fn Result<string, IoError> homeDirectory() { return homeFrom(variable: "HOME"); }
@compileFor(OS_WINDOWS)
unsafe fn Result<string, IoError> homeDirectory() { return homeFrom(variable: "USERPROFILE"); }

unsafe fn Result<string, IoError> homeFrom(string variable) {
    Optional<string> set = env(name: give variable);
    match (give set) {
        case Some(value: h): { if (h.length() > 0) { return Result::Ok(value: give h); } }
        case None: {}
    };
    Result<UserId, IoError> me = currentUser();
    return match (me) { case Ok(value: u): u.homeDirectory(); case Err(error: e): Result::Err(error: e); };
}
