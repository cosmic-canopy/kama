
export { join, parent, fileName, stem, extension, isAbsolute, separator };

// Filesystem PATH text — six pure functions over `string`, no I/O and no allocation beyond the strings
// they return. There is deliberately no `Path` type: two string-ish types is exactly what GOALS #4 warns
// against, and Rust's `Path` earns its keep through `OsString` encoding concerns kama does not have (kama
// strings are UTF-8 everywhere).
//
// The names are the ones every MODERN successor API converged on — Rust's `Path::{parent, file_name,
// file_stem, extension, join, is_absolute}`, Python's `pathlib.{parent, name, stem, suffix}`, C#'s
// `Path.{GetDirectoryName, GetFileName, GetFileNameWithoutExtension}` — and not `dirname`/`basename`,
// which are the shell tools' names and carry the shell tools' edge cases. Python kept `os.path.dirname`
// and added `.parent` alongside it precisely because the two disagree.
//
// ⚠️ FIVE deliberate answers, each one a place a mainstream implementation surprises someone:
//
//  1. `join` NEVER discards the base. Rust's `Path::join` and Python's `os.path.join` REPLACE the whole
//     path when the right-hand side is absolute, so `join(path: userRoot, with: userInput)` escapes the root the
//     moment the input starts with a separator — the classic traversal footgun, and the reason both
//     languages' docs carry a warning instead of a fix. Here the two sides are always concatenated, with
//     the separator seam collapsed. A caller who wants replacement writes the `if` and can be seen doing
//     it. This is the one place kama disagrees with its comparator on purpose.
//  2. A DOTFILE has no extension. `extension(path: ".bashrc")` is `None`, not `"bashrc"` — the leading
//     dot starts the name, it does not separate one.
//  3. The extension EXCLUDES the dot (Rust, Go, Zig) rather than including it (Node's `extname`), so
//     recomposing is `stem + "." + extension` and says so.
//  4. Missing is `None`, never `""`. `parent(path: "file.txt")` is `None`, where Rust answers `Some("")`
//     — an empty string that then joins into something meaningless. Same for a name that is all
//     separators, and for `.`/`..`, which are directory references rather than file names (Rust agrees;
//     Go's `Base` answers `"."`).
//  5. There is NO `normalize`/`clean`. Resolving `..` lexically — Go's `filepath.Clean`, Node's
//     `path.normalize` — is wrong across a symlink, and quietly so: `a/b/../c` is not `a/c` when `b` is a
//     link. Doing it honestly needs the filesystem (`realpath`), which belongs in `std::fs`, not here.
//
// Separators: `/` everywhere, and `\` as well on Windows, where both are accepted on input and `\` is
// what `join` writes. The variance is two tiny `@compileFor` pairs rather than a runtime branch — the
// platform is known at compile time, so paying for a test on every byte would be pretending otherwise.

@compileFor(OS_WINDOWS)  fn bool isSep(uint8 c) { return c == 47ui8 || c == 92ui8; }   // '/' or '\'
@compileFor(!OS_WINDOWS) fn bool isSep(uint8 c) { return c == 47ui8; }                 // '/'

// The separator this platform writes. Reading accepts either on Windows; writing picks one.
@compileFor(OS_WINDOWS)  fn string separator() { return "\\"; }
@compileFor(!OS_WINDOWS) fn string separator() { return "/"; }

// The index one past the last non-separator byte — i.e. `text` with its trailing separators removed.
// A path that is ALL separators keeps one byte, so the root `/` survives as a root rather than emptying.
fn isize endTrimmed(const ref string text) {
    isize e = text.length();
    while (e > 1 && isSep(c: text[e - 1])) { e = e - 1; }
    if (e == 1 && isSep(c: text[0])) { return 1; }
    return e;
}

// The index of the last separator before `end`, or -1.
fn isize lastSep(const ref string text, isize end) {
    isize i = end;
    while (i > 0) {
        i = i - 1;
        if (isSep(c: text[i])) { return i; }
    }
    return -1;
}

// Is this path anchored at a root, so that resolving it does not depend on a working directory?
// POSIX: it starts with a separator. Windows: a separator (rooted on the current drive), a drive letter
// followed by one (`C:\`), or a UNC share (`\\host\share`) — the three forms `GetFullPathName` treats as
// needing no current directory.
@compileFor(!OS_WINDOWS)
fn bool isAbsolute(const ref string path) {
    return path.length() > 0 && isSep(c: path[0]);
}

@compileFor(OS_WINDOWS)
fn bool isAbsolute(const ref string path) {
    isize n = path.length();
    if (n == 0) { return false; }
    if (isSep(c: path[0])) { return true; }                       // `\file` or `\\host\share`
    if (n < 3) { return false; }
    uint8 c0 = path[0];
    bool letter = (c0 >= 65ui8 && c0 <= 90ui8) || (c0 >= 97ui8 && c0 <= 122ui8);
    return letter && path[1] == 58ui8 && isSep(c: path[2]);       // `C:\` — `C:file` is drive-RELATIVE
}

// Everything before the final component: `parent(path: "/a/b/c.txt")` is `"/a/b"`.
// `None` when there is nothing before it — a bare name, or a root, which is its own last component.
fn Optional<string> parent(const ref string path) {
    isize end = endTrimmed(text: ref path);
    isize sep = lastSep(text: ref path, end: end);
    if (sep < 0) { return Optional::None; }                       // "file.txt" — no directory part
    if (sep == 0) {
        // "/file" — the parent is the root itself, which must keep its separator to stay absolute.
        if (end == 1) { return Optional::None; }                  // "/" is its own parent
        return Optional::Some(value: path.substring(start: 0, end: 1));
    }
    isize cut = sep;
    while (cut > 1 && isSep(c: path[cut - 1])) { cut = cut - 1; }  // "/a//b" -> "/a", not "/a/"
    return Optional::Some(value: path.substring(start: 0, end: cut));
}

// The final component: `fileName(path: "/a/b/c.txt")` is `"c.txt"`.
// `None` for a root, for a path that is all separators, and for `.` / `..` — those name a DIRECTORY
// relative to another one, not a file, and answering "." invites `join(dir, name)` to build a path that
// points back where it started.
fn Optional<string> fileName(const ref string path) {
    isize end = endTrimmed(text: ref path);
    if (end == 0) { return Optional::None; }
    isize sep = lastSep(text: ref path, end: end);
    isize start = sep + 1;
    if (start >= end) { return Optional::None; }                  // "/" and friends: nothing after the sep
    string name = path.substring(start: start, end: end);
    if (name == "." || name == "..") { return Optional::None; }
    return Optional::Some(value: give name);
}

// The index of the extension's dot within `name`, or -1. Byte 0 is never it: a leading dot begins a
// dotfile's NAME. A trailing dot is not one either — "archive." has no extension, it has a stray dot.
fn isize extDot(const ref string name) {
    isize n = name.length();
    isize i = n;
    while (i > 1) {
        i = i - 1;
        if (name[i] == 46ui8) {
            if (i + 1 >= n) { return -1; }                        // "archive." — nothing follows
            return i;
        }
    }
    return -1;
}

// The final component without its extension: `stem(path: "/a/b.tar.gz")` is `"b.tar"` (the LAST dot
// splits, as everywhere else — a two-part extension is a naming convention, not a filesystem one).
fn Optional<string> stem(const ref string path) {
    match (fileName(path: ref path)) {
        case None: { return Optional::None; }
        case Some(value: name): {
            isize dot = extDot(name: ref name);
            if (dot < 0) { return Optional::Some(value: copy name); }
            return Optional::Some(value: name.substring(start: 0, end: dot));
        }
    };
    return Optional::None;
}

// The extension WITHOUT its dot: `extension(path: "/a/b.tar.gz")` is `"gz"`. `None` when there is none —
// including for a dotfile (".bashrc") and a trailing dot ("archive.").
fn Optional<string> extension(const ref string path) {
    match (fileName(path: ref path)) {
        case None: { return Optional::None; }
        case Some(value: name): {
            isize dot = extDot(name: ref name);
            if (dot < 0) { return Optional::None; }
            return Optional::Some(value: name.substring(start: dot + 1, end: name.length()));
        }
    };
    return Optional::None;
}

// Concatenate two path pieces with exactly one separator between them.
//
// ⚠️ `with` is appended even when it is absolute — see note 1 in this file's header. `join(path: "/srv",
// with: "/etc/passwd")` is `"/srv/etc/passwd"`, not `"/etc/passwd"`.
fn string join(const ref string path, const ref string with) {
    if (path.length() == 0) { return copy with; }
    if (with.length() == 0) { return copy path; }
    isize b = path.length();
    while (b > 1 && isSep(c: path[b - 1])) { b = b - 1; }          // one trailing separator at most...
    if (b == 1 && isSep(c: path[0])) { b = 0; }                    // ...and the root keeps none of its own
    else if (isSep(c: path[b - 1])) { b = b - 1; }
    isize w = 0;
    while (w < with.length() && isSep(c: with[w])) { w = w + 1; }  // ...and none leading on the right
    string left = path.substring(start: 0, end: b);
    string right = with.substring(start: w, end: with.length());
    if (right.length() == 0) { return give left; }
    return left + separator() + right;
}
