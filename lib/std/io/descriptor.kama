file @compileFor(HOSTED);
// An operating-system descriptor: hosted targets only (KR-341).
// An OWNED operating-system descriptor — the one type a descriptor has when it is not yet (or no longer) a
// `File`, a socket or a stream: what arrives over a Unix socket (`UnixStream.recvDescriptors`), what one is
// sent as (`sendDescriptors`), and the ONE door for a raw number from outside kama (`adopt(raw:, kind:)`). Rust's
// `OwnedFd` model, decided by the maintainer 2026-09-30 (KR-104):
//
// - It closes on drop, so a descriptor can never leak: one received and never adopted is closed like any value.
// - Every handle type converts both ways — `X.adopt(descriptor: give d)`, `give x.intoDescriptor()` (consuming `x`,
//   KR-261) — and `x.duplicateDescriptor()` makes a second one for the same open file or socket, which is what
//   you send when you keep your own. The receiver says what a descriptor IS by the type it adopts it into.
// - A raw number becomes one only through `Descriptor.adopt(raw:, kind:)` — `adopt`, as every ownership transfer in
//   std is spelled — so `kama query --refs` at it finds every place a program claims a number it did not get from
//   kama, whatever order its arguments are written in. That is ALL it is: kama's `unsafe` marks a dangerous BODY,
//   never a caller, and this body is two field stores, so nothing checks the claim. Adopting a number something
//   else owns (`0`, stdin) closes it twice, exactly as the per-type `make(fd:)` doors this replaced would have.
//
// One type on every OS; what differs is in `kama_os.h`. A POSIX descriptor is a small integer whatever it names.
// On Windows a file's is a C-runtime descriptor and a socket's a SOCKET, closed by different calls, so a
// `Descriptor` remembers which it is, and adopting one into the other kind of handle is `InvalidInput` there.
import { IoError, IoErrorKind, lastError };

export { Descriptor, DescriptorKind };

extern "kama_os.h";
extern fn int32 kama_desc_close(isize h, int32 kind);
extern fn isize kama_desc_dup(isize h, int32 kind);
extern fn int32 kama_desc_is_socket(isize h, int32 kind);
extern fn int32 kama_desc_kind_fits(int32 kind, int32 socket);

// What a raw descriptor is (KR-366). Only Windows tells the two apart: a file's is a C-runtime descriptor there and a
// socket's a SOCKET, closed by different calls. A program states it at every `adopt`, so code written on POSIX, where
// it changes nothing, is already right on Windows.
type enum DescriptorKind { File, Socket }

type resource Descriptor implements Sendable {
    isize handle = -1;   // the -1 empty niche: a taken or released descriptor drops as nothing
    int32 how = 0;       // 0 a file's descriptor (Windows: a C-runtime one), 1 a socket's (Windows: a SOCKET)
    ctor own(isize handle, int32 how) { this.handle = handle; this.how = how; }

    // Take ownership of a raw descriptor from outside kama — from C, or inherited — saying what it is. It is closed
    // when this drops: on Windows by the call its kind closes with.
    public ctor adopt(isize raw, DescriptorKind kind) {
        this.handle = raw;
        this.how = kind == DescriptorKind::Socket ? 1 : 0;
    }

    // The number, borrowed — this still owns it.
    public const fn isize rawHandle() { return this.handle; }
    // What it names: POSIX asks the OS, Windows knows how it was made.
    public unsafe const fn DescriptorKind kind() {
        return kama_desc_is_socket(h: this.handle, kind: this.how) != 0 ? DescriptorKind::Socket : DescriptorKind::File;
    }
    // A second descriptor for the same open file or socket, closed independently. Close-on-exec, as every
    // descriptor kama makes is.
    public unsafe fn Result<Descriptor, IoError> duplicate() {
        isize d = kama_desc_dup(h: this.handle, kind: this.how);
        if (d < 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Descriptor.own(handle: d, how: this.how));
    }
    // Give the number up, consuming this (KR-261): whoever takes it closes it from here. A program hands one to C this
    // way; a kama handle adopts the descriptor itself (`File.adopt(descriptor:)`), which also refuses the wrong kind.
    public unsafe give fn isize release() {
        isize h = this.handle;
        this.handle = -1;
        return h;
    }
    // May the number become a handle of this kind? On Windows a file's descriptor cannot become a socket or the
    // reverse; on POSIX anything fits. A handle type asks before it takes the number — std's `X.adopt(descriptor:)`
    // answer `InvalidInput`, and the descriptor closes as it drops — and so does a package's own, the same way.
    public unsafe const fn bool fits(DescriptorKind kind) {
        return kama_desc_kind_fits(kind: this.how, socket: kind == DescriptorKind::Socket ? 1 : 0) != 0;
    }

    unsafe ~Descriptor() { if (this.handle >= 0) { int32 rc = kama_desc_close(h: this.handle, kind: this.how); } }
}
