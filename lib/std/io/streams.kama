namespace std::io;

// The streaming byte substrate: a `Writer` (sink) and `Reader` (source) that serde, fs, net, and fmt all
// build on. The byte layer is BINARY-NATIVE — it moves raw `View<uint8>` with no charset assumptions, so a
// binary serializer writes bytes straight in while text backends (json/…) layer UTF-8 on top. Errors are
// `Result<_, IoError>` PER OP (the production model — Rust/Go/Zig `io`, and kama's own std::net already
// agrees); the sticky-error `Serializer`/`Deserializer` token layer sits ABOVE this and latches these
// Results. Unbounded data is first-class: read/write loop over a FIXED buffer → O(1) memory in the payload.

import std::io::{IoError};
import std::collections::{DynamicArray, FixedArray, View};

export { Writer, Reader, StringWriter, SliceReader, BufWriter, BufReader, writeAll, pump, readAll };

// A byte SINK. `write` is the partial-write PRIMITIVE: it writes UP TO bytes.length() bytes and returns the
// count actually taken (may be `< length` when the sink is full/slow — this is how backpressure is expressed;
// the caller loops, or uses the free `writeAll`). `flush` drains any buffered bytes to the ultimate
// destination (an in-memory sink no-ops). Kept to these two so every impl is trivial; `writeAll`/`copy` are
// free helpers (kama contracts carry no default methods).
type contract Writer for resource {
    fn Result<isize, IoError> write(View<uint8> bytes);
    fn Result<Unit, IoError> flush();
}

// A byte SOURCE. `read` fills UP TO into.length() bytes and returns the count read; `Ok(0)` means EOF. The
// caller loops until EOF — bounded memory regardless of how much data flows through.
type contract Reader for resource {
    fn Result<isize, IoError> read(View<uint8> into);
}

// Write EVERY byte, looping over the partial-write primitive until done (or error). A write that makes no
// progress (returns 0) on a would-block sink surfaces as `WouldBlock` rather than spinning forever.
fn Result<Unit, IoError> writeAll(Writer w, View<uint8> bytes) {
    isize total = bytes.length();
    isize off = 0;
    while (off < total) {
        Result<isize, IoError> r = w.write(bytes: bytes.slice(from: off, count: total - off));
        match (r) {
            case Err(error: e): { return Result::Err(error: e); }
            case Ok(value: n): {
                if (n == 0) { return Result::Err(error: IoError::WouldBlock); }
                off = off + cast<isize>(n);
            }
        };
    }
    return Result::Ok(value: Unit::Unit);
}

// Pump every byte from `from` to `to` through ONE fixed 4 KiB scratch buffer (= Go `io.Copy`; named `pump`
// since `copy` is a keyword) — the idiom for moving unbounded data in bounded memory. Returns the total
// byte count transferred.
fn Result<isize, IoError> pump(Reader from, Writer to) {
    FixedArray<uint8> scratch = FixedArray.make(size: 4096);
    isize total = 0;
    while (true) {
        Result<isize, IoError> rr = from.read(into: scratch.view());
        match (rr) {
            case Err(error: e): { return Result::Err(error: e); }
            case Ok(value: n): {
                if (n == 0) { return Result::Ok(value: total); }   // EOF
                Result<Unit, IoError> wr = writeAll(w: to, bytes: scratch.slice(from: 0, count: n));
                match (wr) { case Err(error: e2): { return Result::Err(error: e2); } case Ok(value: _): {} };
                total = total + n;
            }
        };
    }
}

// Drain a `Reader` fully into an owned UTF-8 string (through a `StringWriter` + `pump`). The bounded-memory
// boundary for readers that need whole-source access — e.g. serde's JSON graph decode seeks backward
// (`rewindGraph`), so `decodeFrom` reads all first. Buffers the whole source BY DESIGN (matches Go
// `encoding/json`'s buffer-a-value model); genuine record-streaming is a separate future API.
fn Result<string, IoError> readAll(Reader r) {
    StringWriter sw = StringWriter.make();
    Result<isize, IoError> pr = pump(from: r, to: sw);
    match (pr) { case Err(error: e): { return Result::Err(error: e); } case Ok(value: _): {} };
    return Result::Ok(value: sw.finish());
}

// The in-memory `Writer`: accumulates bytes in a growable buffer and hands them back as an owned UTF-8
// string via `finish()`. This is the sink behind serde's `encode -> string` sugar and fmt's to-string.
type resource StringWriter implements Writer {
    DynamicArray<uint8> buf;

    public ctor make() {
        DynamicArray<uint8> b = DynamicArray.empty();
        this.buf = give b;
    }

    public fn Result<isize, IoError> write(View<uint8> bytes) {
        isize n = bytes.length();
        isize i = 0;
        while (i < n) { this.buf.add(item: bytes[i]); i = i + 1; }
        return Result::Ok(value: n);
    }

    public fn Result<Unit, IoError> flush() { return Result::Ok(value: Unit::Unit); }

    // How many bytes have accumulated so far.
    public const fn isize length() { return this.buf.length(); }

    // Materialize the accumulated bytes as an owned string (the writer is typically dropped after).
    public unsafe fn string finish() {
        if (this.buf.length() == 0) { return ""; }
        return kama_string_from_raw(src: addr(of: this.buf[0]), start: 0, len: this.buf.length());
    }

    // Move the accumulated bytes out as a raw `DynamicArray<uint8>`, leaving the writer empty. The byte-oriented
    // twin of `finish()` — for a binary sink whose output is not valid UTF-8 (embedded nulls, arbitrary bytes),
    // so it must NOT go through `string`. Used by the binary serializer's `encode -> DynamicArray<uint8>`.
    public fn DynamicArray<uint8> takeBytes() {
        DynamicArray<uint8> taken = DynamicArray.empty();
        isize n = this.buf.length();
        isize i = 0;
        while (i < n) { taken.add(item: this.buf[i]); i = i + 1; }
        this.buf.clear();
        return give taken;
    }
}

// The in-memory `Reader`: reads out of an owned byte source (a `string`'s UTF-8 bytes). This is the source
// behind serde's `decode(string)` sugar. Single-pass, fully streamable, bounded memory in the reader's own
// buffer (the source itself is held whole — that is the caller's `string`, by design for the sugar path).
type resource SliceReader implements Reader {
    string src;
    isize pos;
    isize len;

    public ctor make(string src) {
        this.len = src.length();
        this.src = give src;
        this.pos = 0;
    }

    public fn Result<isize, IoError> read(View<uint8> into) {
        isize avail = this.len - this.pos;
        if (avail <= 0) { return Result::Ok(value: 0); }   // EOF
        isize want = into.length();
        isize k = avail < want ? avail : want;
        isize i = 0;
        while (i < k) { into[i] = this.src[this.pos + i]; i = i + 1; }
        this.pos = this.pos + k;
        return Result::Ok(value: k);
    }
}

// A buffering `Writer` wrapper: coalesces many small writes into one downstream write (kills per-field
// syscalls when serde streams to a file/socket). Owns its inner `W` BY VALUE — kama forbids stored borrows,
// so a wrapper owns its sink (exactly as a collection owns its `A: Allocator`). Flush drains the buffer
// through the inner writer's own `write` (monomorphic — no contract upcast). Its internal buffer is the
// ring-buffer layer of the substrate.
type resource BufWriter<W: Writer> implements Writer {
    W inner;
    DynamicArray<uint8> buf;
    isize cap;

    public ctor make(W inner) {
        this.inner = give inner;
        DynamicArray<uint8> b = DynamicArray.empty();
        this.buf = give b;
        this.cap = 4096;
    }

    public fn Result<isize, IoError> write(View<uint8> bytes) {
        isize n = bytes.length();
        isize i = 0;
        while (i < n) { this.buf.add(item: bytes[i]); i = i + 1; }
        if (this.buf.length() >= this.cap) {
            Result<Unit, IoError> fr = this.flush();
            match (fr) { case Err(error: e): { return Result::Err(error: e); } case Ok(value: _): {} };
        }
        return Result::Ok(value: n);
    }

    public fn Result<Unit, IoError> flush() {
        isize total = this.buf.length();
        isize off = 0;
        while (off < total) {
            Result<isize, IoError> wr = this.inner.write(bytes: this.buf.slice(from: off, count: total - off));
            match (wr) {
                case Err(error: e): { return Result::Err(error: e); }
                case Ok(value: m): {
                    // `Writer.write` answers `Result<isize, IoError>`, so `m` is already an `isize` —
                    // both casts here were residue from when it answered `usize`, and the `==` compared
                    // across the two. Nothing caught it because the payload binding had no type.
                    if (m == 0) { return Result::Err(error: IoError::WouldBlock); }
                    off = off + m;
                }
            };
        }
        this.buf.clear();
        return this.inner.flush();
    }
}

// A buffering `Reader` wrapper: reads the inner source in fixed chunks and serves callers out of the buffer,
// so many small reads cost few downstream reads. Owns its inner `R` by value (same reason as BufWriter).
type resource BufReader<R: Reader> implements Reader {
    R inner;
    FixedArray<uint8> buf;
    isize pos;    // next unread byte in buf
    isize fill;   // count of valid bytes in buf

    public ctor make(R inner) {
        this.inner = give inner;
        FixedArray<uint8> b = FixedArray.make(size: 4096);
        this.buf = give b;
        this.pos = 0;
        this.fill = 0;
    }

    public fn Result<isize, IoError> read(View<uint8> into) {
        if (this.pos >= this.fill) {
            Result<isize, IoError> rr = this.inner.read(into: this.buf.view());
            match (rr) {
                case Err(error: e): { return Result::Err(error: e); }
                case Ok(value: n): { this.fill = cast<isize>(n); this.pos = 0; }
            };
            if (this.fill == 0) { return Result::Ok(value: 0); }   // EOF
        }
        isize avail = this.fill - this.pos;
        isize want = into.length();
        isize k = avail < want ? avail : want;
        isize i = 0;
        while (i < k) { into[i] = this.buf[this.pos + i]; i = i + 1; }
        this.pos = this.pos + k;
        return Result::Ok(value: k);
    }
}
