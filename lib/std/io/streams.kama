
// The streaming byte substrate: a `Writer` (sink) and `Reader` (source) that serde, fs, net, and fmt all
// build on. The byte layer is BINARY-NATIVE — it moves raw `View<uint8>` with no charset assumptions, so a
// binary serializer writes bytes straight in while text backends (json/…) layer UTF-8 on top. Errors are
// `Result<_, IoError>` PER OP (the production model — Rust/Go/Zig `io`, and kama's own std::net already
// agrees); the sticky-error `Serializer`/`Deserializer` token layer sits ABOVE this and latches these
// Results. Unbounded data is first-class: read/write loop over a FIXED buffer → O(1) memory in the payload.

import { IoError, std::collections::DynamicArray, std::collections::FixedArray, std::collections::View, std::collections::ConstView };

export { Writer, Reader, StringWriter, SliceReader, BufWriter, BufReader, Lines, writeAll, pump, readAll };

// The runtime string constructor. An `extern` is a reference to a C symbol, not a module symbol — it keeps
// its literal C spelling, so it is never `export`ed or `import`ed and a file that names one declares it
// (SPEC; the file rung). Every declaration of it in a program must agree, which is checked.
extern fn string kama_string_from_raw(UnsafeConstPtr<uint8> src, isize start, isize len);

// A byte SINK. `write` is the partial-write PRIMITIVE: it writes UP TO bytes.length() bytes and returns the
// count actually taken (may be `< length` when the sink is full/slow — this is how backpressure is expressed;
// the caller loops, or uses the free `writeAll`). `flush` drains any buffered bytes to the ultimate
// destination (an in-memory sink no-ops). Kept to these two so every impl is trivial; `writeAll`/`copy` are
// free helpers (kama contracts carry no default methods).
type contract Writer for resource {
    fn Result<isize, IoError> write(ConstView<uint8> bytes);
    fn Result<Unit, IoError> flush();
}

// A byte SOURCE. `read` fills UP TO into.length() bytes and returns the count read; `Ok(0)` means EOF. The
// caller loops until EOF — bounded memory regardless of how much data flows through.
type contract Reader for resource {
    fn Result<isize, IoError> read(View<uint8> into);
}

// Write EVERY byte, looping over the partial-write primitive until done (or error). A write that makes no
// progress (returns 0) on a would-block sink surfaces as `WouldBlock` rather than spinning forever.
fn Result<Unit, IoError> writeAll(Writer w, ConstView<uint8> bytes) {
    isize total = bytes.length();
    isize off = 0;
    while (off < total) {
        Result<isize, IoError> r = w.write(bytes: bytes.slice(from: off, count: total - off));
        match (r) {
            case Err(error: e): { return Result::Err(error: e); }
            case Ok(value: n): {
                if (n == 0) { return Result::Err(error: IoError::WouldBlock); }
                off = off + cast<isize>(n);
            }
        };
    }
    return Result::Ok(value: Unit::Unit);
}

// Pump every byte from `from` to `to` through ONE fixed 4 KiB scratch buffer (= Go `io.Copy`; named `pump`
// since `copy` is a keyword) — the idiom for moving unbounded data in bounded memory. Returns the total
// byte count transferred.
fn Result<isize, IoError> pump(Reader from, Writer to) {
    FixedArray<uint8> scratch = FixedArray.make(size: 4096);
    isize total = 0;
    while (true) {
        Result<isize, IoError> rr = from.read(into: scratch.viewMut());
        match (rr) {
            case Err(error: e): { return Result::Err(error: e); }
            case Ok(value: n): {
                if (n == 0) { return Result::Ok(value: total); }   // EOF
                Result<Unit, IoError> wr = writeAll(w: to, bytes: scratch.slice(from: 0, count: n));
                match (wr) { case Err(error: e2): { return Result::Err(error: e2); } case Ok(value: _): {} };
                total = total + n;
            }
        };
    }
}

// Drain a `Reader` fully into an owned UTF-8 string (through a `StringWriter` + `pump`). The bounded-memory
// boundary for readers that need whole-source access — e.g. serde's JSON graph decodeJsonBuffer seeks backward
// (`rewindGraph`), so `decodeJsonStream` reads all first. Buffers the whole source BY DESIGN (matches Go
// `encoding/json`'s buffer-a-value model); genuine record-streaming is a separate future API.
fn Result<string, IoError> readAll(Reader r) {
    StringWriter sw = StringWriter.make();
    Result<isize, IoError> pr = pump(from: r, to: sw);
    match (pr) { case Err(error: e): { return Result::Err(error: e); } case Ok(value: _): {} };
    return Result::Ok(value: sw.finish());
}

// The in-memory `Writer`: accumulates bytes in a growable buffer and hands them back as an owned UTF-8
// string via `finish()`. This is the sink behind serde's `encodeJsonBuffer -> string` sugar and fmt's to-string.
type resource StringWriter implements Writer {
    DynamicArray<uint8> buf;

    public ctor make() {
        DynamicArray<uint8> b = DynamicArray.empty();
        this.buf = give b;
    }

    public fn Result<isize, IoError> write(ConstView<uint8> bytes) {
        isize n = bytes.length();
        isize i = 0;
        while (i < n) { this.buf.add(item: bytes[i]); i = i + 1; }
        return Result::Ok(value: n);
    }

    public fn Result<Unit, IoError> flush() { return Result::Ok(value: Unit::Unit); }

    // How many bytes have accumulated so far.
    public const fn isize length() { return this.buf.length(); }

    // Materialize the accumulated bytes as an owned string (the writer is typically dropped after).
    public unsafe fn string finish() {
        if (this.buf.length() == 0) { return ""; }
        return kama_string_from_raw(src: addr(of: this.buf[0]), start: 0, len: this.buf.length());
    }

    // Move the accumulated bytes out as a raw `DynamicArray<uint8>`, leaving the writer empty. The byte-oriented
    // twin of `finish()` — for a binary sink whose output is not valid UTF-8 (embedded nulls, arbitrary bytes),
    // so it must NOT go through `string`. Used by the binary serializer's `encodeJsonBuffer -> DynamicArray<uint8>`.
    public fn DynamicArray<uint8> takeBytes() {
        DynamicArray<uint8> taken = DynamicArray.empty();
        isize n = this.buf.length();
        isize i = 0;
        while (i < n) { taken.add(item: this.buf[i]); i = i + 1; }
        this.buf.clear();
        return give taken;
    }
}

// The in-memory `Reader`: reads out of an owned byte source (a `string`'s UTF-8 bytes). This is the source
// behind serde's `decodeJsonBuffer(string)` sugar. Single-pass, fully streamable, bounded memory in the reader's own
// buffer (the source itself is held whole — that is the caller's `string`, by design for the sugar path).
type resource SliceReader implements Reader {
    string src;
    isize pos;
    isize len;

    public ctor make(string src) {
        this.len = src.length();
        this.src = give src;
        this.pos = 0;
    }

    public fn Result<isize, IoError> read(View<uint8> into) {
        isize avail = this.len - this.pos;
        if (avail <= 0) { return Result::Ok(value: 0); }   // EOF
        isize want = into.length();
        isize k = avail < want ? avail : want;
        isize i = 0;
        while (i < k) { into[i] = this.src[this.pos + i]; i = i + 1; }
        this.pos = this.pos + k;
        return Result::Ok(value: k);
    }
}

// A buffering `Writer` wrapper: coalesces many small writes into one downstream write (kills per-field
// syscalls when serde streams to a file/socket). Owns its inner `W` BY VALUE — kama forbids stored borrows,
// so a wrapper owns its sink (exactly as a collection owns its `A: Allocator`). Flush drains the buffer
// through the inner writer's own `write` (monomorphic — no contract upcast). Its internal buffer is the
// ring-buffer layer of the substrate.
type resource BufWriter<W: Writer> implements Writer {
    W inner;
    DynamicArray<uint8> buf;
    isize cap;

    public ctor make(W inner) {
        this.inner = give inner;
        DynamicArray<uint8> b = DynamicArray.empty();
        this.buf = give b;
        this.cap = 4096;
    }

    public fn Result<isize, IoError> write(ConstView<uint8> bytes) {
        isize n = bytes.length();
        isize i = 0;
        while (i < n) { this.buf.add(item: bytes[i]); i = i + 1; }
        if (this.buf.length() >= this.cap) {
            Result<Unit, IoError> fr = this.flush();
            match (fr) { case Err(error: e): { return Result::Err(error: e); } case Ok(value: _): {} };
        }
        return Result::Ok(value: n);
    }

    public fn Result<Unit, IoError> flush() {
        isize total = this.buf.length();
        isize off = 0;
        while (off < total) {
            Result<isize, IoError> wr = this.inner.write(bytes: this.buf.slice(from: off, count: total - off));
            match (wr) {
                case Err(error: e): { return Result::Err(error: e); }
                case Ok(value: m): {
                    // `Writer.write` answers `Result<isize, IoError>`, so `m` is already an `isize` —
                    // both casts here were residue from when it answered `usize`, and the `==` compared
                    // across the two. Nothing caught it because the payload binding had no type.
                    if (m == 0) { return Result::Err(error: IoError::WouldBlock); }
                    off = off + m;
                }
            };
        }
        this.buf.clear();
        return this.inner.flush();
    }
}

// A buffering `Reader` wrapper: reads the inner source in fixed chunks and serves callers out of the buffer,
// so many small reads cost few downstream reads. Owns its inner `R` by value (same reason as BufWriter).
type resource BufReader<R: Reader> implements Reader {
    R inner;
    FixedArray<uint8> buf;
    isize pos;    // next unread byte in buf
    isize fill;   // count of valid bytes in buf

    public ctor make(R inner) {
        this.inner = give inner;
        FixedArray<uint8> b = FixedArray.make(size: 4096);
        this.buf = give b;
        this.pos = 0;
        this.fill = 0;
    }

    public fn Result<isize, IoError> read(View<uint8> into) {
        if (this.pos >= this.fill) {
            Result<isize, IoError> rr = this.inner.read(into: this.buf.viewMut());
            match (rr) {
                case Err(error: e): { return Result::Err(error: e); }
                case Ok(value: n): { this.fill = cast<isize>(n); this.pos = 0; }
            };
            if (this.fill == 0) { return Result::Ok(value: 0); }   // EOF
        }
        isize avail = this.fill - this.pos;
        isize want = into.length();
        isize k = avail < want ? avail : want;
        isize i = 0;
        while (i < k) { into[i] = this.buf[this.pos + i]; i = i + 1; }
        this.pos = this.pos + k;
        return Result::Ok(value: k);
    }

    // One LINE, with its terminator removed. `Ok(None)` is end of input; a final line with no terminator
    // is still returned. This is the text-framing primitive over the byte substrate, and the reason it is
    // a primitive rather than a convenience is that almost every text source is line-delimited: a log, a
    // config, stdin, a CSV, an HTTP header block. Every comparator has it (Rust `BufRead::read_line`, Go
    // `bufio.Scanner`, Python `for line in f`, Java `readLine`, C# `ReadLine`, C `getline`).
    //
    // ⚠️ CRLF is handled here, not left to the caller. A `\r` immediately before the `\n` goes with it, so
    // a Windows-authored file read on POSIX does not hand back lines with an invisible byte on the end —
    // the single most common "why does my comparison fail" in every language that made the caller do it.
    // A LONE `\r` is NOT a terminator: old-Mac line endings are gone, and treating a bare carriage return
    // as one would split binary-ish text in surprising places.
    //
    // The line is built through a `DynamicArray` rather than borrowed out of the buffer, because a line
    // may span any number of refills. A pathologically long line therefore costs its own length in
    // memory, which is the same contract `getline` and `read_line` carry.
    //
    // ⚠️ The errors stay in the `Result` where a caller has to look at them. `Lines` below is the
    // `foreach` spelling on top of this one, and it necessarily reports a failure as "no more lines" —
    // which is why it carries `error()` and this stays the primitive.
    public unsafe fn Result<Optional<string>, IoError> readLine() {
        DynamicArray<uint8> line = DynamicArray.empty();
        bool any = false;
        while (true) {
            if (this.pos >= this.fill) {
                Result<isize, IoError> rr = this.inner.read(into: this.buf.viewMut());
                match (rr) {
                    case Err(error: e): { return Result::Err(error: e); }
                    case Ok(value: n): { this.fill = cast<isize>(n); this.pos = 0; }
                };
                if (this.fill == 0) {
                    // End of input: a final unterminated line is still a line; nothing at all is None.
                    if (!any) { return Result::Ok(value: Optional::None); }
                    return Result::Ok(value: Optional::Some(value: bytesToString(bytes: ref line)));
                }
            }
            while (this.pos < this.fill) {
                uint8 c = this.buf[this.pos];
                this.pos = this.pos + 1;
                any = true;
                if (c == 10ui8) {                                  // '\n' ends the line
                    isize len = line.length();
                    if (len > 0 && line[len - 1] == 13ui8) {                         // ...and takes a CR with it
                        Optional<uint8> cr = line.pop();
                    }
                    return Result::Ok(value: Optional::Some(value: bytesToString(bytes: ref line)));
                }
                line.add(item: c);
            }
        }
        return Result::Err(error: IoError::Other(code: 0));   // unreachable: the loop only exits by return
    }
}

// The accumulated bytes as an owned string. Shared by `readLine` and anything else that builds text a
// byte at a time; empty in, empty out (`kama_string_from_raw` would be handed a pointer into an empty
// buffer otherwise, which `DynamicArray`'s own indexing correctly refuses).
unsafe fn string bytesToString(const ref DynamicArray<uint8> bytes) {
    if (bytes.length() == 0) { return ""; }
    return kama_string_from_raw(src: addr(of: bytes[0]), start: 0, len: bytes.length());
}

// Every LINE of a `Reader`, as a `foreach`-able iterator: the spelling every comparator has (Rust's
// `BufRead::lines`, Python's `for line in f`, Java's `lines()`, Go's `bufio.Scanner`). It OWNS the source
// — kama forbids stored borrows — and buffers it, so it composes with anything that reads: a `File`, a
// `TcpStream`, `stdin()`, a `SliceReader` over a string.
//
//     Lines<File> ls = Lines::<File>.make(src: give f);
//     foreach (string line in ls) { … }
//     match (ls.error()) { case Some(value: e): { … } case None: { } };
//
// ⚠️ The `error()` check is not ceremony. An iterator yields `Optional<T>`, so a read FAILURE and a clean
// end of input arrive as the same `None` — a truncated file, a reset socket and a finished stream are
// indistinguishable from inside the loop. That is true of Rust's `lines()` (whose item is a `Result`,
// which callers `unwrap`), of Go's `Scanner` (hence `Err()`), and of Python's file iterator (which
// raises). kama's answer is to keep the failure reachable AFTER the loop and to say so here; a caller who
// must not miss one uses `BufReader.readLine()`, whose `Result` cannot be ignored.
type resource Lines<R: Reader> implements Iterator<string> {
    BufReader<R> inner;
    Optional<IoError> failure;

    public ctor make(R src) {
        BufReader<R> b = BufReader::<R>.make(inner: give src);
        this.inner = give b;
        this.failure = Optional::None;
    }

    // The next line, or `None` at end of input — OR on an I/O error, which is recorded for `error()`.
    public unsafe fn Optional<string> next() {
        Result<Optional<string>, IoError> rl = this.inner.readLine();
        return match (give rl) {
            case Ok(value: line): give line;
            case Err(error: e): { this.failure = Optional::Some(value: e); := Optional::None; }
        };
    }

    // The error that ended the iteration, if one did. `None` after a clean end of input.
    public const fn Optional<IoError> error() { return copy this.failure; }
}
