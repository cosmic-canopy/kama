namespace std::io;
export { IoError, lastError };

// Bindings for the platform's last-error accessor + errno constants (see kama_os.h). The constant
// accessors let us classify without hardcoding per-OS errno numbers; they are module-internal.
extern "kama_os.h";
extern fn int32 kama_last_error();
extern fn int32 kama_ENOENT();
extern fn int32 kama_EACCES();
extern fn int32 kama_EAGAIN();
extern fn int32 kama_ECONNREFUSED();
extern fn int32 kama_ECONNRESET();
extern fn int32 kama_EADDRINUSE();
extern fn int32 kama_EINPROGRESS();
extern fn int32 kama_ETIMEDOUT();
extern fn int32 kama_EHOSTUNREACH();
extern fn int32 kama_ENETUNREACH();
extern fn int32 kama_EMSGSIZE();
extern fn int32 kama_EPIPE();

// A classified I/O error. The named kinds cover the common cases callers branch on; `Other` carries the
// raw platform error code for everything else, keeping the set small but complete. `UnexpectedEof` is a
// logical error (a read returned 0 where more was required) — it has no errno, so callers raise it directly.
// The datagram/non-blocking kinds (`InProgress`/`TimedOut`/`HostUnreachable`/`MessageTooLong`/`BrokenPipe`)
// serve std::net: a non-blocking connect in flight, a datagram over MTU, a send to a dropped peer.
// `IoError` is a first-class `Error`: a fallible ctor/fn may return it directly as
// `Result<T, IoError>` (matchable), or box it into `Owned<Error>` for a polymorphic error channel.
type enum IoError implements Error {
    NotFound,
    PermissionDenied,
    WouldBlock,
    ConnectionRefused,
    ConnectionReset,
    AddrInUse,
    UnexpectedEof,
    InProgress,
    TimedOut,
    HostUnreachable,
    MessageTooLong,
    BrokenPipe,
    Other(int32 code);

    public fn string message() {
        return match (this) {
            case NotFound:          "not found";
            case PermissionDenied:  "permission denied";
            case WouldBlock:        "would block";
            case ConnectionRefused: "connection refused";
            case ConnectionReset:   "connection reset";
            case AddrInUse:         "address in use";
            case UnexpectedEof:     "unexpected end of file";
            case InProgress:        "in progress";
            case TimedOut:          "timed out";
            case HostUnreachable:   "host unreachable";
            case MessageTooLong:    "message too long";
            case BrokenPipe:        "broken pipe";
            case Other(code: c):          "i/o error";
        };
    }
}

// Read the platform's last-error ONCE (call this immediately after a failed syscall) and classify it.
unsafe fn IoError lastError() {
    int32 e = kama_last_error();
    if (e == kama_ENOENT())       { return IoError::NotFound; }
    if (e == kama_EACCES())       { return IoError::PermissionDenied; }
    if (e == kama_EAGAIN())       { return IoError::WouldBlock; }
    if (e == kama_ECONNREFUSED()) { return IoError::ConnectionRefused; }
    if (e == kama_ECONNRESET())   { return IoError::ConnectionReset; }
    if (e == kama_EADDRINUSE())   { return IoError::AddrInUse; }
    if (e == kama_EINPROGRESS())  { return IoError::InProgress; }
    if (e == kama_ETIMEDOUT())    { return IoError::TimedOut; }
    if (e == kama_EHOSTUNREACH()) { return IoError::HostUnreachable; }
    if (e == kama_ENETUNREACH())  { return IoError::HostUnreachable; }
    if (e == kama_EMSGSIZE())     { return IoError::MessageTooLong; }
    if (e == kama_EPIPE())        { return IoError::BrokenPipe; }
    return IoError::Other(code: e);
}
