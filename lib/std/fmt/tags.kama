namespace std::fmt;

// Tagged strings (`html"…"`, `sql"…"`, `stripIndent"…"`). The compiler splits a tagged string into its trusted
// literal PARTS and its rendered HOLE values and hands them to the tag as a `Template` (invariant:
// partCount() == holeCount() + 1). Because parts and holes stay SEPARATE, a tag treats them differently:
// `html` escapes holes but not literals (XSS-safe), `sql` keeps holes out-of-band as `?` params (injection-safe
// by construction), `stripIndent` dedents the literal template but leaves interpolated values verbatim.
//
// A tag is nothing more than a function `fn R name(ref Template t)` in scope — user code can define its own.

import std::collections::{DynamicArray};

export { stripIndent, html, sql, SqlQuery };

// ---- html : escape hole values, pass literals through -----------------------------------------------------

// Escape the HTML metacharacters in a single string. Codepoint iteration re-encodes multi-byte UTF-8 faithfully
// (the specials are all ASCII, so they never collide with a continuation byte).
fn string htmlEscape(ref string s) {
    Formatter f = Formatter.make();
    foreach (char c in s.chars()) {
        if (c == '&')       { string e = "&amp;";  f.writeStr(s: ref e); }
        else if (c == '<')  { string e = "&lt;";   f.writeStr(s: ref e); }
        else if (c == '>')  { string e = "&gt;";   f.writeStr(s: ref e); }
        else if (c == '"')  { string e = "&quot;"; f.writeStr(s: ref e); }
        else if (c == '\'') { string e = "&#39;";  f.writeStr(s: ref e); }
        else                { f.writeChar(c: c); }
    }
    return f.finish();
}

// Weave the template: literal parts verbatim, each hole HTML-escaped. A `<script>` in a hole becomes inert text.
fn string html(ref Template t) {
    Formatter f = Formatter.make();
    int32 n = t.holeCount();
    int32 i = 0;
    while (i < n) {
        string p = t.part(at: i); f.writeStr(s: ref p);
        string hv = t.hole(at: i);
        string e = htmlEscape(s: ref hv); f.writeStr(s: ref e);
        i = i + 1;
    }
    string pl = t.part(at: n); f.writeStr(s: ref pl);
    return f.finish();
}

// ---- sql : parameterize holes, never splice them ----------------------------------------------------------

// A parameterized query: `text` carries `?` placeholders (from the literal template); the hole VALUES live in
// `params`, handed to a driver out-of-band. Values never enter `text`, so injection is impossible by design.
type resource SqlQuery {
    string text;
    DynamicArray<string> params;
    public ctor of(string text, DynamicArray<string> params) {
        this.text = give text; this.params = give params;
    }
    public fn ref string queryText() { return this.text; }
    public fn int32 paramCount() { return this.params.length(); }
    public fn ref string param(int32 at) { return this.params[at]; }
}

fn SqlQuery sql(ref Template t) {
    Formatter f = Formatter.make();
    DynamicArray<string> ps = DynamicArray.empty();
    int32 n = t.holeCount();
    int32 i = 0;
    while (i < n) {
        string p = t.part(at: i); f.writeStr(s: ref p);
        string q = "?"; f.writeStr(s: ref q);            // a placeholder in the query text
        string h = t.hole(at: i); ps.add(item: give h);  // the value goes out-of-band into params
        i = i + 1;
    }
    string pl = t.part(at: n); f.writeStr(s: ref pl);
    string txt = f.finish();
    return SqlQuery.of(text: give txt, params: give ps);
}

// ---- stripIndent : dedent the literal template, keep holes verbatim ----------------------------------------

// Remove the common leading-space indentation from every line of the literal template (trimIndent-style) and
// drop a single leading newline, so a multi-line string can be indented to match its surrounding source. Only
// the literal PARTS are dedented; interpolated hole values are emitted exactly as given. Indentation is spaces.
fn string stripIndent(ref Template t) {
    int32 n = t.holeCount();

    // Pass 1 — the minimum indentation across all content lines. A hole makes its line a content line.
    int32 minIndent = 1000000;
    bool atLineStart = true;
    int32 curIndent = 0;
    int32 i = 0;
    while (i <= n) {
        string p1 = t.part(at: i);
        foreach (char c in p1.chars()) {
            if (atLineStart) {
                if (c == ' ')       { curIndent = curIndent + 1; }
                else if (c == '\n') { curIndent = 0; }                                  // blank line — skip
                else                { if (curIndent < minIndent) { minIndent = curIndent; } atLineStart = false; }
            } else {
                if (c == '\n') { atLineStart = true; curIndent = 0; }
            }
        }
        if (i < n && atLineStart) { if (curIndent < minIndent) { minIndent = curIndent; } atLineStart = false; }
        i = i + 1;
    }
    if (minIndent == 1000000) { minIndent = 0; }

    // Pass 2 — emit, stripping `minIndent` leading spaces per line and one leading newline; holes verbatim.
    Formatter f = Formatter.make();
    bool lineStart = true;
    int32 skip = 0;
    bool first = true;
    i = 0;
    while (i <= n) {
        string p2 = t.part(at: i);
        foreach (char c in p2.chars()) {
            if (lineStart) {
                if (c == '\n') {
                    if (first) { first = false; } else { f.writeChar(c: c); }           // drop one leading newline
                    skip = 0;
                } else if (c == ' ' && skip < minIndent) {
                    skip = skip + 1;                                                     // consume an indent space
                } else {
                    first = false; f.writeChar(c: c); lineStart = false;
                }
            } else {
                if (c == '\n') { f.writeChar(c: c); lineStart = true; skip = 0; }
                else          { f.writeChar(c: c); }
            }
        }
        if (i < n) { string hv = t.hole(at: i); first = false; f.writeStr(s: ref hv); lineStart = false; }   // a hole is content
        i = i + 1;
    }
    return f.finish();
}
