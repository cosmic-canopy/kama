
// Number -> string. Kama has no built-in numeric formatting, so this is the one place a value becomes its
// decimal text — the prerequisite for JSON/YAML emission and (later) string interpolation. The four
// primitive conversions live in the `kama_fmt.h` bindings (integer digit loop; float via `snprintf` at
// round-trip precision); the public API here widens the narrower fixed-width types into them, so there is
// ONE conversion per signedness/width class. Every result is a fresh heap-owned `string`.
export { intStr, uintStr, i8Str, i16Str, i32Str, i64Str,
         u8Str, u16Str, u32Str, u64Str, f32Str, f64Str, boolStr };

extern "kama_fmt.h";
extern fn string kama_fmt_i64(int64 v);
extern fn string kama_fmt_u64(uint64 v);
extern fn string kama_fmt_f64(float64 v);
extern fn string kama_fmt_f32(float32 v);

// Core conversions (widest of each class).
unsafe fn string i64Str(int64 v)   { return kama_fmt_i64(v: v); }
unsafe fn string u64Str(uint64 v)  { return kama_fmt_u64(v: v); }
unsafe fn string f64Str(float64 v) { return kama_fmt_f64(v: v); }
unsafe fn string f32Str(float32 v) { return kama_fmt_f32(v: v); }

// Narrower widths widen into the core conversions (JSON is width-agnostic; binary packs tight elsewhere).
unsafe fn string i8Str(int8 v)    { return kama_fmt_i64(v: cast<int64>(v)); }
unsafe fn string i16Str(int16 v)  { return kama_fmt_i64(v: cast<int64>(v)); }
unsafe fn string i32Str(int32 v)  { return kama_fmt_i64(v: cast<int64>(v)); }
unsafe fn string u8Str(uint8 v)   { return kama_fmt_u64(v: cast<uint64>(v)); }
unsafe fn string u16Str(uint16 v) { return kama_fmt_u64(v: cast<uint64>(v)); }
unsafe fn string u32Str(uint32 v) { return kama_fmt_u64(v: cast<uint64>(v)); }

// Convenience aliases for the platform-width signed/unsigned integer.
unsafe fn string intStr(int64 v)   { return kama_fmt_i64(v: v); }
unsafe fn string uintStr(uint64 v) { return kama_fmt_u64(v: v); }

// The two boolean literals (JSON/YAML spelling).
fn string boolStr(bool b) { if (b) { return "true"; } return "false"; }
