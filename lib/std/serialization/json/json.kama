namespace std::serialization::json;

// JSON backend for the serialization framework. `JsonWriter` implements `Serializer` by accumulating UTF-8
// text in a byte buffer; `toString` is the entry point that runs a value's generated `serialize` against a
// fresh writer. A single `needComma` flag tracks whether the next value/field needs a leading comma — correct
// for arbitrary nesting because endObject/endArray leave a complete value (a following sibling gets its
// comma) while a value right after fieldName does not.

import std::collections::{List};
import std::fmt::{i8Str, i16Str, i32Str, i64Str, u8Str, u16Str, u32Str, u64Str, f32Str, f64Str, boolStr};

export { JsonWriter, JsonReader, toString, tryParse };

type resource JsonWriter implements Serializer {
    List<uint8> buf;
    bool needComma;

    public JsonWriter() {
        List<uint8> b = List();
        this.buf = give b;
        this.needComma = false;
    }

    // --- low-level byte output ---
    fn void byte(uint8 b) { this.buf.add(item: b); }
    fn void ascii(string s) {
        int32 n = cast<int32>(s.length());
        int32 i = 0;
        while (i < n) { this.buf.add(item: s[i]); i = i + 1; }
    }
    fn void sep() { if (this.needComma) { this.byte(b: 44ui8); } }   // ','
    fn uint8 hexDigit(uint8 v) {
        if (v < 10ui8) { return 48ui8 + v; }        // '0'..'9'
        return 97ui8 + (v - 10ui8);                 // 'a'..'f'
    }
    fn void uEscape(uint8 c) {                      // \u00XX for a control byte
        this.byte(b: 92ui8); this.byte(b: 117ui8);  // \u
        this.byte(b: 48ui8); this.byte(b: 48ui8);   // 00
        this.byte(b: this.hexDigit(v: (c >> 4ui8) & 15ui8));
        this.byte(b: this.hexDigit(v: c & 15ui8));
    }
    // A JSON string literal: quotes + escaping for ", \, the common control shorts, and \u00XX otherwise.
    // Bytes >= 0x20 (incl. UTF-8 continuation bytes) pass through verbatim — valid since the source is UTF-8.
    fn void quoted(ref string s) {
        this.byte(b: 34ui8);                        // "
        int32 n = cast<int32>(s.length());
        int32 i = 0;
        while (i < n) {
            uint8 c = s[i];
            if (c == 34ui8)      { this.byte(b: 92ui8); this.byte(b: 34ui8); }    // \"
            else if (c == 92ui8) { this.byte(b: 92ui8); this.byte(b: 92ui8); }    // backslash
            else if (c == 10ui8) { this.byte(b: 92ui8); this.byte(b: 110ui8); }   // \n
            else if (c == 9ui8)  { this.byte(b: 92ui8); this.byte(b: 116ui8); }   // \t
            else if (c == 13ui8) { this.byte(b: 92ui8); this.byte(b: 114ui8); }   // \r
            else if (c < 32ui8)  { this.uEscape(c: c); }
            else                 { this.byte(b: c); }
            i = i + 1;
        }
        this.byte(b: 34ui8);
    }

    // --- Serializer contract ---
    public fn void beginObject() { this.sep(); this.byte(b: 123ui8); this.needComma = false; }   // {
    public fn void endObject()   { this.byte(b: 125ui8); this.needComma = true; }                // }
    public fn void beginArray(usize count) { this.sep(); this.byte(b: 91ui8); this.needComma = false; }  // [
    public fn void endArray()    { this.byte(b: 93ui8); this.needComma = true; }                 // ]
    public fn void fieldName(string name) {
        this.sep();
        this.quoted(s: ref name);
        this.byte(b: 58ui8);                        // :
        this.needComma = false;
    }
    public fn void writeI8(int8 v)   { this.sep(); this.ascii(s: i8Str(v: v));  this.needComma = true; }
    public fn void writeI16(int16 v) { this.sep(); this.ascii(s: i16Str(v: v)); this.needComma = true; }
    public fn void writeI32(int32 v) { this.sep(); this.ascii(s: i32Str(v: v)); this.needComma = true; }
    public fn void writeI64(int64 v) { this.sep(); this.ascii(s: i64Str(v: v)); this.needComma = true; }
    public fn void writeU8(uint8 v)   { this.sep(); this.ascii(s: u8Str(v: v));  this.needComma = true; }
    public fn void writeU16(uint16 v) { this.sep(); this.ascii(s: u16Str(v: v)); this.needComma = true; }
    public fn void writeU32(uint32 v) { this.sep(); this.ascii(s: u32Str(v: v)); this.needComma = true; }
    public fn void writeU64(uint64 v) { this.sep(); this.ascii(s: u64Str(v: v)); this.needComma = true; }
    public fn void writeF32(float32 v) { this.sep(); this.ascii(s: f32Str(v: v)); this.needComma = true; }
    public fn void writeF64(float64 v) { this.sep(); this.ascii(s: f64Str(v: v)); this.needComma = true; }
    public fn void writeBool(bool v) { this.sep(); this.ascii(s: boolStr(b: v)); this.needComma = true; }
    public fn void writeString(ref string v) { this.sep(); this.quoted(s: ref v); this.needComma = true; }
    public fn void writeNull() { this.sep(); this.ascii(s: "null"); this.needComma = true; }
    public fn void writeChar(char v) {
        this.sep();
        this.byte(b: 34ui8);                        // "
        uint32 cp = cast<uint32>(v);
        if (cp < 128ui32) {
            uint8 b = cast<uint8>(cp);
            if (b == 34ui8)      { this.byte(b: 92ui8); this.byte(b: 34ui8); }
            else if (b == 92ui8) { this.byte(b: 92ui8); this.byte(b: 92ui8); }
            else if (b < 32ui8)  { this.uEscape(c: b); }
            else                 { this.byte(b: b); }
        } else {
            this.byte(b: 92ui8); this.byte(b: 117ui8);   // \u (BMP; astral chars deferred)
            this.byte(b: this.hexDigit(v: cast<uint8>((cp >> 12ui32) & 15ui32)));
            this.byte(b: this.hexDigit(v: cast<uint8>((cp >> 8ui32) & 15ui32)));
            this.byte(b: this.hexDigit(v: cast<uint8>((cp >> 4ui32) & 15ui32)));
            this.byte(b: this.hexDigit(v: cast<uint8>(cp & 15ui32)));
        }
        this.byte(b: 34ui8);
        this.needComma = true;
    }

    // Materialize the accumulated bytes as a fresh owned string.
    public fn string finish() {
        if (cast<int32>(this.buf.length()) == 0) { return ""; }
        unsafe {
            return kama_string_from_raw(src: addr(of: this.buf[0]), start: 0,
                                        len: cast<int32>(this.buf.length()));
        }
    }
}

// Serialize any `Serialize` value to a JSON string. Takes the value behind the `Serialize` interface
// (dynamic dispatch), so a concrete value auto-wraps at the call site (`json::toString(v: point)`); the
// value's vtable travels in the fat pointer, sidestepping cross-module static-vtable visibility. A `value`
// copies cheaply; pass `copy`/`give` for a `resource` you want to keep or move.
fn string toString(Serialize v) {
    JsonWriter w = JsonWriter();
    Serializer s = w;              // borrow the writer behind the Serializer interface
    v.serialize(w: ref s);
    return w.finish();
}

extern fn float64 kama_parse_f64(string s);

// A JSON reader: a recursive-descent parser over an owned source string, implementing Deserializer. It uses
// a STICKY error flag — a malformed token sets `err` and returns a default, and the caller checks `failed()`
// once at the end — so the generated `deserialize` needs no per-read error branching.
type resource JsonReader implements Deserializer {
    string src;
    int32 pos;
    int32 len;
    bool err;

    public JsonReader(string src) {
        this.len = cast<int32>(src.length());
        this.src = give src;
        this.pos = 0;
        this.err = false;
    }

    // --- low-level cursor ---
    fn uint8 peek() {
        if (this.pos >= this.len) { return 0ui8; }
        return this.src[this.pos];
    }
    fn void skipWs() {
        while (this.pos < this.len) {
            uint8 c = this.src[this.pos];
            if (c == 32ui8) { this.pos = this.pos + 1; }
            else if (c == 9ui8) { this.pos = this.pos + 1; }
            else if (c == 10ui8) { this.pos = this.pos + 1; }
            else if (c == 13ui8) { this.pos = this.pos + 1; }
            else { break; }
        }
    }
    fn void expect(uint8 b) {
        this.skipWs();
        if (this.peek() == b) { this.pos = this.pos + 1; } else { this.err = true; }
    }
    fn uint8 hexVal(uint8 c) {
        if (c >= 48ui8 && c <= 57ui8) { return c - 48ui8; }        // 0-9
        if (c >= 97ui8 && c <= 102ui8) { return c - 97ui8 + 10ui8; } // a-f
        if (c >= 65ui8 && c <= 70ui8) { return c - 65ui8 + 10ui8; }  // A-F
        this.err = true; return 0ui8;
    }
    fn string bytesToString(ref List<uint8> b) {
        if (cast<int32>(b.length()) == 0) { return ""; }
        unsafe { return kama_string_from_raw(src: addr(of: b[0]), start: 0, len: cast<int32>(b.length())); }
    }

    // --- structural (Deserializer) ---
    public fn void beginObject() { this.expect(b: 123ui8); }   // {
    public fn void beginArray()  { this.expect(b: 91ui8); }    // [
    public fn bool moreFields() {
        this.skipWs();
        uint8 c = this.peek();
        if (c == 125ui8) { this.pos = this.pos + 1; return false; }             // }
        if (c == 44ui8)  { this.pos = this.pos + 1; this.skipWs(); return true; } // ,
        return true;
    }
    public fn bool moreElems() {
        this.skipWs();
        uint8 c = this.peek();
        if (c == 93ui8) { this.pos = this.pos + 1; return false; }              // ]
        if (c == 44ui8) { this.pos = this.pos + 1; this.skipWs(); return true; } // ,
        return true;
    }
    public fn string fieldName() {
        string k = this.readString();
        this.expect(b: 58ui8);   // :
        return give k;
    }

    // --- scalars ---
    fn string numToken() {
        this.skipWs();
        int32 start = this.pos;
        while (this.pos < this.len) {
            uint8 c = this.src[this.pos];
            if ((c >= 48ui8 && c <= 57ui8) || c == 45ui8 || c == 43ui8 ||
                c == 46ui8 || c == 101ui8 || c == 69ui8) { this.pos = this.pos + 1; }
            else { break; }
        }
        if (this.pos == start) { this.err = true; return ""; }
        return this.src.substring(start: cast<usize>(start), end: cast<usize>(this.pos));
    }
    fn int64 readInt() {
        string tok = this.numToken();
        int32 n = cast<int32>(tok.length());
        if (n == 0) { return 0i64; }
        int32 i = 0;
        bool neg = false;
        if (tok[0] == 45ui8) { neg = true; i = 1; }
        int64 v = 0i64;
        while (i < n) {
            uint8 c = tok[i];
            if (c < 48ui8 || c > 57ui8) { break; }
            v = v * 10i64 + cast<int64>(c - 48ui8);
            i = i + 1;
        }
        if (neg) { return 0i64 - v; }
        return v;
    }
    fn uint64 readUint() {
        string tok = this.numToken();
        int32 n = cast<int32>(tok.length());
        uint64 v = 0ui64;
        int32 i = 0;
        while (i < n) {
            uint8 c = tok[i];
            if (c < 48ui8 || c > 57ui8) { break; }
            v = v * 10ui64 + cast<uint64>(c - 48ui8);
            i = i + 1;
        }
        return v;
    }
    public fn int8  readI8()  { return cast<int8>(this.readInt()); }
    public fn int16 readI16() { return cast<int16>(this.readInt()); }
    public fn int32 readI32() { return cast<int32>(this.readInt()); }
    public fn int64 readI64() { return this.readInt(); }
    public fn uint8  readU8()  { return cast<uint8>(this.readUint()); }
    public fn uint16 readU16() { return cast<uint16>(this.readUint()); }
    public fn uint32 readU32() { return cast<uint32>(this.readUint()); }
    public fn uint64 readU64() { return this.readUint(); }
    public fn float64 readF64() { return kama_parse_f64(s: this.numToken()); }
    public fn float32 readF32() { return cast<float32>(kama_parse_f64(s: this.numToken())); }
    public fn bool readBool() {
        this.skipWs();
        uint8 c = this.peek();
        if (c == 116ui8) { this.pos = this.pos + 4; return true; }    // true
        if (c == 102ui8) { this.pos = this.pos + 5; return false; }   // false
        this.err = true; return false;
    }
    public fn bool readNull() {
        this.skipWs();
        if (this.peek() == 110ui8) { this.pos = this.pos + 4; return true; }  // null
        return false;
    }
    public fn char readChar() {
        string s = this.readString();
        if (cast<int32>(s.length()) == 0) { return cast<char>(0ui32); }
        return cast<char>(cast<uint32>(s[0]));   // ASCII fast path (multibyte char deferred)
    }
    public fn string readString() {
        this.skipWs();
        if (this.peek() != 34ui8) { this.err = true; return ""; }   // opening "
        this.pos = this.pos + 1;
        List<uint8> acc = List();
        while (this.pos < this.len) {
            uint8 c = this.src[this.pos];
            if (c == 34ui8) { this.pos = this.pos + 1; return this.bytesToString(b: acc); }   // closing "
            if (c == 92ui8) {                                        // backslash escape
                this.pos = this.pos + 1;
                if (this.pos >= this.len) { this.err = true; break; }
                uint8 e = this.src[this.pos];
                if (e == 34ui8) { acc.add(item: 34ui8); }
                else if (e == 92ui8) { acc.add(item: 92ui8); }
                else if (e == 47ui8) { acc.add(item: 47ui8); }
                else if (e == 110ui8) { acc.add(item: 10ui8); }
                else if (e == 116ui8) { acc.add(item: 9ui8); }
                else if (e == 114ui8) { acc.add(item: 13ui8); }
                else if (e == 98ui8) { acc.add(item: 8ui8); }
                else if (e == 102ui8) { acc.add(item: 12ui8); }
                else if (e == 117ui8) { this.readUnicodeEscape(acc: ref acc); }
                else { acc.add(item: e); }
                this.pos = this.pos + 1;
            } else {
                acc.add(item: c);
                this.pos = this.pos + 1;
            }
        }
        this.err = true;
        return this.bytesToString(b: acc);
    }
    // \uXXXX -> UTF-8 (BMP; surrogate pairs deferred). Called with pos at the 'u'; leaves pos at the last hex.
    fn void readUnicodeEscape(ref List<uint8> acc) {
        if (this.pos + 4 >= this.len) { this.err = true; return; }
        uint32 cp = 0ui32;
        int32 k = 1;
        while (k <= 4) {
            cp = (cp << 4ui32) | cast<uint32>(this.hexVal(c: this.src[this.pos + k]));
            k = k + 1;
        }
        this.pos = this.pos + 4;
        if (cp < 128ui32) { acc.add(item: cast<uint8>(cp)); }
        else if (cp < 2048ui32) {
            acc.add(item: cast<uint8>(192ui32 | (cp >> 6ui32)));
            acc.add(item: cast<uint8>(128ui32 | (cp & 63ui32)));
        } else {
            acc.add(item: cast<uint8>(224ui32 | (cp >> 12ui32)));
            acc.add(item: cast<uint8>(128ui32 | ((cp >> 6ui32) & 63ui32)));
            acc.add(item: cast<uint8>(128ui32 | (cp & 63ui32)));
        }
    }
    public fn void skipValue() {
        this.skipWs();
        uint8 c = this.peek();
        if (c == 123ui8) { this.beginObject(); while (this.moreFields()) { string k = this.fieldName(); this.skipValue(); } }
        else if (c == 91ui8) { this.beginArray(); while (this.moreElems()) { this.skipValue(); } }
        else if (c == 34ui8) { string s = this.readString(); }
        else if (c == 116ui8) { bool b = this.readBool(); }
        else if (c == 102ui8) { bool b = this.readBool(); }
        else if (c == 110ui8) { bool n = this.readNull(); }
        else { string t = this.numToken(); }
    }
    public fn bool failed() { return this.err; }
}

// Deserialize a JSON string into a `Deserialize` type — the one-liner entry. Name the target with turbofish:
// `json::tryParse::<Point>(src)`. The generated `deserialize` returns the reconstructed `T` directly (bypass-
// ctor: zero-init + field-set), carrying any parse failure in the reader's sticky error flag; this wraps that
// into a `Result` after checking `failed()`.
fn Result<T, DeError> tryParse<T: Deserialize>(string src) {
    JsonReader r = JsonReader(src: give src);
    T v = T::deserialize(r: r);
    if (r.failed()) { return Result::Err(error: DeError::Malformed); }
    return Result::Ok(value: give v);
}