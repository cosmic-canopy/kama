namespace std::serialization::json;

// JSON backend for the serialization framework. `JsonWriter` implements `Serializer` by accumulating UTF-8
// text in a byte buffer; `encode` is the entry point that runs a value's generated `serialize` against a
// fresh writer. A single `needComma` flag tracks whether the next value/field needs a leading comma — correct
// for arbitrary nesting because endObject/endArray leave a complete value (a following sibling gets its
// comma) while a value right after fieldName does not.

import std::collections::{DynamicArray, FixedArray};
import std::fmt::{i8Str, i16Str, i32Str, i64Str, u8Str, u16Str, u32Str, u64Str, f32Str, f64Str, boolStr};
import std::io::{Writer, Reader, StringWriter, readAll, IoError};

export { JsonWriter, JsonReader, encode, decode, decodeFrom };   // stream-write via JsonWriter.encodeValue

// Serializes JSON tokens straight into an owned `W: Writer` sink — a file, socket, buffered writer, or the
// in-memory `StringWriter` behind `encode -> string`. Owns its sink by value (kama forbids stored borrows,
// so a serializer owns `W` exactly as a collection owns its allocator). A byte write that fails LATCHES the
// sticky `err`/`code`; the generated `serialize` surfaces it once at the end (mirror of JsonReader).
type resource JsonWriter<W: Writer> implements Serializer {
    W sink;
    FixedArray<uint8> scratch;   // size-1 staging for a single-byte `sink.write` (View can't wrap a stack local)
    bool needComma;
    bool err;              // STICKY error flag (mirror of JsonReader)
    SerError code;         // the recorded write error

    public ctor make(W sink) {
        slot JsonWriter<W> r;
        r.sink = give sink;
        r.scratch = FixedArray.make(size: 1);
        r.needComma = false;
        r.err = false;
        r.code = SerError::NotRepresentable;
        return give r;
    }

    // Borrow the underlying sink (e.g. so `encode` can `finish()` its concrete StringWriter). W-agnostic body.
    public fn ref W innerRef() { return this.sink; }

    // Stream a `Serialize` value's JSON into this writer's owned sink, then flush — the streaming twin of the
    // `encode` sugar, without materializing the whole string. The ergonomic write-to-a-sink entry (a generic
    // free fn / static method can't instantiate `JsonWriter<W>`, so this is an INSTANCE method on a writer the
    // caller builds at a concrete site):
    //   JsonWriter<StringWriter> w = JsonWriter::<StringWriter>.make(sink: give mySink);
    //   Result<Unit, Owned<Error>> r = w.encodeValue(v: myValue);
    public fn Result<Unit, std::memory::Owned<Error>> encodeValue(Serialize v) {
        Serializer s = this;   // borrow self behind the Serializer interface
        Result<Unit, std::memory::Owned<Error>> r = v.serialize(w: ref s);
        match (give r) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
        Result<Unit, IoError> fr = this.sink.flush();
        match (fr) { case Err(error: e): { return Result::Err(error: e); } case Ok(value: _): {} };
        return Result::Ok(value: Unit::Unit);
    }

    // --- low-level byte output ---
    fn void byte(uint8 b) {
        this.scratch[0] = b;
        match (this.sink.write(bytes: this.scratch.view())) {
            case Err(error: _): { this.failWith(e: SerError::IoError); }
            case Ok(value: _): {}
        };
    }
    fn void ascii(string s) {
        int32 n = cast<int32>(s.length());
        int32 i = 0;
        while (i < n) { this.byte(b: s[i]); i = i + 1; }
    }
    fn void sep() { if (this.needComma) { this.byte(b: 44ui8); } }   // ','
    fn uint8 hexDigit(uint8 v) {
        if (v < 10ui8) { return 48ui8 + v; }        // '0'..'9'
        return 97ui8 + (v - 10ui8);                 // 'a'..'f'
    }
    fn void uEscape(uint8 c) {                      // \u00XX for a control byte
        this.byte(b: 92ui8); this.byte(b: 117ui8);  // \u
        this.byte(b: 48ui8); this.byte(b: 48ui8);   // 00
        this.byte(b: this.hexDigit(v: (c >> 4ui8) & 15ui8));
        this.byte(b: this.hexDigit(v: c & 15ui8));
    }
    // A JSON string literal: quotes + escaping for ", \, the common control shorts, and \u00XX otherwise.
    // Bytes >= 0x20 (incl. UTF-8 continuation bytes) pass through verbatim — valid since the source is UTF-8.
    fn void quoted(ref string s) {
        this.byte(b: 34ui8);                        // "
        int32 n = cast<int32>(s.length());
        int32 i = 0;
        while (i < n) {
            uint8 c = s[i];
            if (c == 34ui8)      { this.byte(b: 92ui8); this.byte(b: 34ui8); }    // \"
            else if (c == 92ui8) { this.byte(b: 92ui8); this.byte(b: 92ui8); }    // backslash
            else if (c == 10ui8) { this.byte(b: 92ui8); this.byte(b: 110ui8); }   // \n
            else if (c == 9ui8)  { this.byte(b: 92ui8); this.byte(b: 116ui8); }   // \t
            else if (c == 13ui8) { this.byte(b: 92ui8); this.byte(b: 114ui8); }   // \r
            else if (c < 32ui8)  { this.uEscape(c: c); }
            else                 { this.byte(b: c); }
            i = i + 1;
        }
        this.byte(b: 34ui8);
    }

    // --- Serializer contract ---
    public fn void beginObject() { this.sep(); this.byte(b: 123ui8); this.needComma = false; }   // {
    public fn void endObject()   { this.byte(b: 125ui8); this.needComma = true; }                // }
    public fn void beginArray(usize count) { this.sep(); this.byte(b: 91ui8); this.needComma = false; }  // [
    public fn void endArray()    { this.byte(b: 93ui8); this.needComma = true; }                 // ]
    public fn void fieldName(string name) {
        this.sep();
        this.quoted(s: ref name);
        this.byte(b: 58ui8);                        // :
        this.needComma = false;
    }
    public fn void writeI8(int8 v)   { this.sep(); this.ascii(s: i8Str(v: v));  this.needComma = true; }
    public fn void writeI16(int16 v) { this.sep(); this.ascii(s: i16Str(v: v)); this.needComma = true; }
    public fn void writeI32(int32 v) { this.sep(); this.ascii(s: i32Str(v: v)); this.needComma = true; }
    public fn void writeI64(int64 v) { this.sep(); this.ascii(s: i64Str(v: v)); this.needComma = true; }
    public fn void writeU8(uint8 v)   { this.sep(); this.ascii(s: u8Str(v: v));  this.needComma = true; }
    public fn void writeU16(uint16 v) { this.sep(); this.ascii(s: u16Str(v: v)); this.needComma = true; }
    public fn void writeU32(uint32 v) { this.sep(); this.ascii(s: u32Str(v: v)); this.needComma = true; }
    public fn void writeU64(uint64 v) { this.sep(); this.ascii(s: u64Str(v: v)); this.needComma = true; }
    // JSON has no NaN/Inf literal. `(v - v) != 0` is true iff v is non-finite (NaN-NaN and Inf-Inf are both
    // NaN, which != 0; a finite v gives 0), so this catches BOTH without a dedicated intrinsic.
    public fn void writeF32(float32 v) {
        if ((v - v) != 0.0f32) { this.failWith(e: SerError::NotRepresentable); return; }
        this.sep(); this.ascii(s: f32Str(v: v)); this.needComma = true;
    }
    public fn void writeF64(float64 v) {
        if ((v - v) != 0.0) { this.failWith(e: SerError::NotRepresentable); return; }
        this.sep(); this.ascii(s: f64Str(v: v)); this.needComma = true;
    }
    public fn void writeBool(bool v) { this.sep(); this.ascii(s: boolStr(b: v)); this.needComma = true; }
    public fn void writeString(ref string v) { this.sep(); this.quoted(s: ref v); this.needComma = true; }
    public fn void writeNull() { this.sep(); this.ascii(s: "null"); this.needComma = true; }
    // --- graph/pointer framing ---
    // A pointer field is written as a bare integer id (0 = null/expired). The {"root":id,"objects":{...}}
    // envelope frames the flat id table; table-entry keys are the ids, each carrying a "__type" tag.
    public fn void writeRef(uint64 id) { this.sep(); this.ascii(s: u64Str(v: id)); this.needComma = true; }
    public fn void beginGraph(uint64 rootId) {
        this.sep(); this.byte(b: 123ui8);                          // {
        this.ascii(s: "\"root\":"); this.ascii(s: u64Str(v: rootId));
        this.ascii(s: ",\"objects\":"); this.byte(b: 123ui8);      // {
        this.needComma = false;
    }
    public fn void beginTableEntry(uint64 id, string ty) {
        this.sep();
        this.byte(b: 34ui8); this.ascii(s: u64Str(v: id)); this.byte(b: 34ui8);   // "<id>"
        this.byte(b: 58ui8); this.byte(b: 123ui8);                 // :{
        this.ascii(s: "\"__type\":"); this.quoted(s: ref ty);
        this.needComma = true;
    }
    public fn void endTableEntry() { this.byte(b: 125ui8); this.needComma = true; }                  // }
    public fn void endGraph() { this.byte(b: 125ui8); this.byte(b: 125ui8); this.needComma = true; }  // }}
    public fn void writeChar(char v) {
        this.sep();
        this.byte(b: 34ui8);                        // "
        uint32 cp = cast<uint32>(v);
        if (cp < 128ui32) {
            uint8 b = cast<uint8>(cp);
            if (b == 34ui8)      { this.byte(b: 92ui8); this.byte(b: 34ui8); }
            else if (b == 92ui8) { this.byte(b: 92ui8); this.byte(b: 92ui8); }
            else if (b < 32ui8)  { this.uEscape(c: b); }
            else                 { this.byte(b: b); }
        } else {
            this.byte(b: 92ui8); this.byte(b: 117ui8);   // \u (BMP; astral chars deferred)
            this.byte(b: this.hexDigit(v: cast<uint8>((cp >> 12ui32) & 15ui32)));
            this.byte(b: this.hexDigit(v: cast<uint8>((cp >> 8ui32) & 15ui32)));
            this.byte(b: this.hexDigit(v: cast<uint8>((cp >> 4ui32) & 15ui32)));
            this.byte(b: this.hexDigit(v: cast<uint8>(cp & 15ui32)));
        }
        this.byte(b: 34ui8);
        this.needComma = true;
    }

    // --- sticky error queries (mirror of JsonReader) ---
    public fn bool failed() { return this.err; }
    public fn void fail() { this.err = true; }
    public fn void failWith(SerError e) { this.err = true; this.code = e; }
    public fn SerError errorCode() { return this.code; }
}

// Serialize any `Serialize` value to a JSON string. Takes the value behind the `Serialize` interface
// (dynamic dispatch), so a concrete value auto-wraps at the call site (`json::encode(v: point)`); the
// value's vtable travels in the fat pointer, sidestepping cross-module static-vtable visibility. A `value`
// copies cheaply; pass `copy`/`give` for a `resource` you want to keep or move.
fn Result<string, std::memory::Owned<Error>> encode(Serialize v) {
    JsonWriter<StringWriter> w = JsonWriter::<StringWriter>.make(sink: StringWriter.make());
    Serializer s = w;              // borrow the writer behind the Serializer interface
    Result<Unit, std::memory::Owned<Error>> r = v.serialize(w: ref s);
    match (give r) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
    return Result::Ok(value: w.innerRef().finish());   // materialize the concrete StringWriter's bytes
}

// Borrows the token string (`ref` → `kama_string*`): C reads `.data` via strtod and never owns/frees it,
// so the caller keeps ownership and drops the token. (Passing an owned string BY VALUE to an extern would
// "transfer ownership" to C, which never frees it — a leak.)
extern fn float64 kama_parse_f64(ref string s);

// A JSON reader: a recursive-descent parser over an owned source string, implementing Deserializer. It uses
// a STICKY error flag — a malformed token sets `err` and returns a default, and the caller checks `failed()`
// once at the end — so the generated `deserialize` needs no per-read error branching.
type resource JsonReader implements Deserializer {
    string src;
    int32 pos;
    int32 len;
    bool err;
    int32 objMark;      // start of the graph `objects` table (for the two-pass rewind); 0 until beginGraph
    DeError code;       // the specific error `failWith` recorded; `Malformed` by default

    public ctor make(string src) {
        slot JsonReader r;
        r.len = cast<int32>(src.length());
        r.src = give src;
        r.pos = 0;
        r.err = false;
        r.objMark = 0;
        r.code = DeError::Malformed;
        return give r;
    }

    // --- low-level cursor ---
    fn uint8 peek() {
        if (this.pos >= this.len) { return 0ui8; }
        return this.src[this.pos];
    }
    fn void skipWs() {
        while (this.pos < this.len) {
            uint8 c = this.src[this.pos];
            if (c == 32ui8) { this.pos = this.pos + 1; }
            else if (c == 9ui8) { this.pos = this.pos + 1; }
            else if (c == 10ui8) { this.pos = this.pos + 1; }
            else if (c == 13ui8) { this.pos = this.pos + 1; }
            else { break; }
        }
    }
    fn void expect(uint8 b) {
        this.skipWs();
        if (this.peek() == b) { this.pos = this.pos + 1; } else { this.err = true; }
    }
    fn uint8 hexVal(uint8 c) {
        if (c >= 48ui8 && c <= 57ui8) { return c - 48ui8; }        // 0-9
        if (c >= 97ui8 && c <= 102ui8) { return c - 97ui8 + 10ui8; } // a-f
        if (c >= 65ui8 && c <= 70ui8) { return c - 65ui8 + 10ui8; }  // A-F
        this.err = true; return 0ui8;
    }
    fn string bytesToString(ref DynamicArray<uint8> b) {
        if (cast<int32>(b.length()) == 0) { return ""; }
        unsafe { return kama_string_from_raw(src: addr(of: b[0]), start: 0, len: cast<int32>(b.length())); }
    }

    // --- structural (Deserializer) ---
    public fn void beginObject() { this.expect(b: 123ui8); }   // {
    public fn void beginArray()  { this.expect(b: 91ui8); }    // [
    public fn bool moreFields() {
        if (this.err) { return false; }   // sticky failure: stop iterating (else a malformed byte loops forever)
        this.skipWs();
        uint8 c = this.peek();
        if (c == 125ui8) { this.pos = this.pos + 1; return false; }             // }
        if (c == 44ui8)  { this.pos = this.pos + 1; this.skipWs(); return true; } // ,
        return true;
    }
    public fn bool moreElems() {
        if (this.err) { return false; }   // sticky failure: stop iterating
        this.skipWs();
        uint8 c = this.peek();
        if (c == 93ui8) { this.pos = this.pos + 1; return false; }              // ]
        if (c == 44ui8) { this.pos = this.pos + 1; this.skipWs(); return true; } // ,
        return true;
    }
    public fn string fieldName() {
        string k = this.readString();
        this.expect(b: 58ui8);   // :
        return give k;
    }

    // --- scalars ---
    fn string numToken() {
        this.skipWs();
        int32 start = this.pos;
        while (this.pos < this.len) {
            uint8 c = this.src[this.pos];
            if ((c >= 48ui8 && c <= 57ui8) || c == 45ui8 || c == 43ui8 ||
                c == 46ui8 || c == 101ui8 || c == 69ui8) { this.pos = this.pos + 1; }
            else { break; }
        }
        if (this.pos == start) { this.err = true; return ""; }
        return this.src.substring(start: cast<usize>(start), end: cast<usize>(this.pos));
    }
    fn int64 readInt() {
        string tok = this.numToken();
        int32 n = cast<int32>(tok.length());
        if (n == 0) { return 0i64; }
        int32 i = 0;
        bool neg = false;
        if (tok[0] == 45ui8) { neg = true; i = 1; }
        int64 v = 0i64;
        while (i < n) {
            uint8 c = tok[i];
            if (c < 48ui8 || c > 57ui8) { break; }
            v = v * 10i64 + cast<int64>(c - 48ui8);
            i = i + 1;
        }
        if (neg) { return 0i64 - v; }
        return v;
    }
    fn uint64 readUint() {
        string tok = this.numToken();
        int32 n = cast<int32>(tok.length());
        uint64 v = 0ui64;
        int32 i = 0;
        while (i < n) {
            uint8 c = tok[i];
            if (c < 48ui8 || c > 57ui8) { break; }
            v = v * 10ui64 + cast<uint64>(c - 48ui8);
            i = i + 1;
        }
        return v;
    }
    public fn int8  readI8()  { return cast<int8>(this.readInt()); }
    public fn int16 readI16() { return cast<int16>(this.readInt()); }
    public fn int32 readI32() { return cast<int32>(this.readInt()); }
    public fn int64 readI64() { return this.readInt(); }
    public fn uint8  readU8()  { return cast<uint8>(this.readUint()); }
    public fn uint16 readU16() { return cast<uint16>(this.readUint()); }
    public fn uint32 readU32() { return cast<uint32>(this.readUint()); }
    public fn uint64 readU64() { return this.readUint(); }
    public fn float64 readF64() { string t = this.numToken(); return kama_parse_f64(s: ref t); }
    public fn float32 readF32() { string t = this.numToken(); return cast<float32>(kama_parse_f64(s: ref t)); }
    public fn bool readBool() {
        this.skipWs();
        uint8 c = this.peek();
        if (c == 116ui8) { this.pos = this.pos + 4; return true; }    // true
        if (c == 102ui8) { this.pos = this.pos + 5; return false; }   // false
        this.err = true; return false;
    }
    public fn bool readNull() {
        this.skipWs();
        if (this.peek() == 110ui8) { this.pos = this.pos + 4; return true; }  // null
        return false;
    }
    public fn char readChar() {
        string s = this.readString();
        if (cast<int32>(s.length()) == 0) { return cast<char>(0ui32); }
        return cast<char>(cast<uint32>(s[0]));   // ASCII fast path (multibyte char deferred)
    }
    public fn string readString() {
        this.skipWs();
        if (this.peek() != 34ui8) { this.err = true; return ""; }   // opening "
        this.pos = this.pos + 1;
        DynamicArray<uint8> acc = DynamicArray.empty();
        while (this.pos < this.len) {
            uint8 c = this.src[this.pos];
            if (c == 34ui8) { this.pos = this.pos + 1; return this.bytesToString(b: acc); }   // closing "
            if (c == 92ui8) {                                        // backslash escape
                this.pos = this.pos + 1;
                if (this.pos >= this.len) { this.err = true; break; }
                uint8 e = this.src[this.pos];
                if (e == 34ui8) { acc.add(item: 34ui8); }
                else if (e == 92ui8) { acc.add(item: 92ui8); }
                else if (e == 47ui8) { acc.add(item: 47ui8); }
                else if (e == 110ui8) { acc.add(item: 10ui8); }
                else if (e == 116ui8) { acc.add(item: 9ui8); }
                else if (e == 114ui8) { acc.add(item: 13ui8); }
                else if (e == 98ui8) { acc.add(item: 8ui8); }
                else if (e == 102ui8) { acc.add(item: 12ui8); }
                else if (e == 117ui8) { this.readUnicodeEscape(acc: ref acc); }
                else { acc.add(item: e); }
                this.pos = this.pos + 1;
            } else {
                acc.add(item: c);
                this.pos = this.pos + 1;
            }
        }
        this.err = true;
        return this.bytesToString(b: acc);
    }
    // \uXXXX -> UTF-8 (BMP; surrogate pairs deferred). Called with pos at the 'u'; leaves pos at the last hex.
    fn void readUnicodeEscape(ref DynamicArray<uint8> acc) {
        if (this.pos + 4 >= this.len) { this.err = true; return; }
        uint32 cp = 0ui32;
        int32 k = 1;
        while (k <= 4) {
            cp = (cp << 4ui32) | cast<uint32>(this.hexVal(c: this.src[this.pos + k]));
            k = k + 1;
        }
        this.pos = this.pos + 4;
        if (cp < 128ui32) { acc.add(item: cast<uint8>(cp)); }
        else if (cp < 2048ui32) {
            acc.add(item: cast<uint8>(192ui32 | (cp >> 6ui32)));
            acc.add(item: cast<uint8>(128ui32 | (cp & 63ui32)));
        } else {
            acc.add(item: cast<uint8>(224ui32 | (cp >> 12ui32)));
            acc.add(item: cast<uint8>(128ui32 | ((cp >> 6ui32) & 63ui32)));
            acc.add(item: cast<uint8>(128ui32 | (cp & 63ui32)));
        }
    }
    public fn void skipValue() {
        this.skipWs();
        uint8 c = this.peek();
        if (c == 123ui8) { this.beginObject(); while (this.moreFields()) { string k = this.fieldName(); this.skipValue(); } }
        else if (c == 91ui8) { this.beginArray(); while (this.moreElems()) { this.skipValue(); } }
        else if (c == 34ui8) { string s = this.readString(); }
        else if (c == 116ui8) { bool b = this.readBool(); }
        else if (c == 102ui8) { bool b = this.readBool(); }
        else if (c == 110ui8) { bool n = this.readNull(); }
        else { string t = this.numToken(); }
    }
    public fn bool failed() { return this.err; }
    public fn void fail() { this.err = true; }   // the generated enum deserialize flags an unknown tag

    // --- graph (object-table) reads: the deserialize twin of writeRef/beginGraph/beginTableEntry/… ---
    // Consume `{"root":<id>,"objects":`, leaving the cursor at the objects table's `{`. Bookmark that spot
    // (`objMark`) so `rewindGraph` can re-enter the table for the second (wire) pass. Returns the root id.
    public fn uint64 beginGraph() {
        this.beginObject();                       // {
        string k0 = this.fieldName();             // "root":
        uint64 root = this.readUint();
        bool more = this.moreFields();            // ,
        string k1 = this.fieldName();             // "objects":
        this.skipWs();
        this.objMark = this.pos;                  // at the objects table `{`
        return root;
    }
    // Re-position at the objects table for pass 2 (the JSON is single-pass, so we replay from the bookmark).
    public fn void rewindGraph() { this.pos = this.objMark; }
    // Read one table entry's key — a quoted integer id (`"7"`) followed by `:`. Leaves the cursor at the
    // entry's value object `{`.
    public fn uint64 entryKey() {
        string k = this.readString();
        this.expect(b: 58ui8);                    // :
        int32 n = cast<int32>(k.length());
        uint64 v = 0ui64; int32 i = 0;
        while (i < n) {
            uint8 c = k[i];
            if (c < 48ui8 || c > 57ui8) { break; }
            v = v * 10ui64 + cast<uint64>(c - 48ui8);
            i = i + 1;
        }
        return v;
    }
    // A pointer field's value: a bare integer id (0 = null/expired).
    public fn uint64 readRef() { return this.readUint(); }
    // Close the graph envelope: the objects table `}` was consumed by the entry loop, so this eats the outer `}`.
    public fn void endGraph() { this.expect(b: 125ui8); }
    // Record a SPECIFIC error (e.g. a dangling ref -> UnresolvedReference), so `decode` surfaces it instead of
    // the generic `Malformed`.
    public fn void failWith(DeError e) { this.err = true; this.code = e; }
    public fn DeError errorCode() { return this.code; }
}

// Deserialize a JSON string into a `Deserialize` type — the one-liner entry. Name the target with turbofish:
// `json::decode::<Point>(src)`. The generated `deserialize` returns the reconstructed `T` directly (bypass-
// ctor: zero-init + field-set), carrying any parse failure in the reader's sticky error flag; this wraps that
// into a `Result` after checking `failed()`.
fn Result<T, Owned<Error>> decode<T: Deserialize>(string src) {
    JsonReader r = JsonReader.make(src: give src);
    return T.deserialize(r: r);   // fallibility now lives inside the ctor (sticky check + boxed DeError)
}

// Deserialize from any `Reader` — the streaming twin of `decode`. Drains the reader fully into a string
// first (`readAll`), then parses: JSON graph decode seeks backward (`rewindGraph`), so the source must be
// whole — the accepted bounded-memory boundary. A read `IoError` auto-boxes into `Owned<Error>`.
fn Result<T, Owned<Error>> decodeFrom<T: Deserialize>(Reader from) {
    Result<string, IoError> rr = readAll(r: from);
    string src = match (give rr) {
        case Ok(value: s):  { := give s; }
        case Err(error: e): { return Result::Err(error: e); }   // IoError auto-boxes into Owned<Error>
    };
    JsonReader r = JsonReader.make(src: give src);
    return T.deserialize(r: r);
}