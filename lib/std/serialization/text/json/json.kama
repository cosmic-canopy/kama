
// JSON backend for the serialization framework. `JsonSerializer` implements `Serializer` by accumulating UTF-8
// text in a byte buffer; `serializeJsonBuffer` is the entry point that runs a value's generated `serialize` against a
// fresh writer. A single `needComma` flag tracks whether the next value/field needs a leading comma — correct
// for arbitrary nesting because endObject/endArray leave a complete value (a following sibling gets its
// comma) while a value right after a field key does not.

import {
    std::collections::DynamicArray,
    std::collections::FixedArray,
    std::collections::OrderedMap,
    std::fmt::parse,
    std::fmt::ParseError,
    std::fmt::i8Str,
    std::fmt::i16Str,
    std::fmt::i32Str,
    std::fmt::i64Str,
    std::fmt::u8Str,
    std::fmt::u16Str,
    std::fmt::u32Str,
    std::fmt::u64Str,
    std::fmt::f32Str,
    std::fmt::f64Str,
    std::fmt::boolStr,
    std::io::Writer,
    std::io::Reader,
    std::io::StringWriter,
    std::io::readAll,
    std::io::IoError,
};

export { JsonSerializer, JsonDeserializer, JsonValue, JsonNumber,
         serializeJsonBuffer, serializeJsonStream, deserializeJsonBuffer, deserializeJsonStream,
         mergeJsonBuffer, mergeJsonStream };

// The runtime string constructor. An `extern` is a reference to a C symbol, not a module symbol — it keeps
// its literal C spelling, so it is never `export`ed or `import`ed and a file that names one declares it
// (SPEC; the file rung). Every declaration of it in a program must agree, which is checked.
extern fn string kama_string_from_raw(UnsafeConstPtr<uint8> src, isize start, isize len);

// Serializes JSON tokens straight into an owned `W: Writer` sink — a file, socket, buffered writer, or the
// in-memory `StringWriter` behind `serializeJsonBuffer -> string`. Owns its sink by value (kama forbids stored borrows,
// so a serializer owns `W` exactly as a collection owns its allocator). A byte write that fails LATCHES the
// sticky `err`/`code`; the generated `serialize` surfaces it once at the end (mirror of JsonDeserializer).
type resource JsonSerializer<W: Writer> implements Serializer {
    W sink;
    FixedArray<uint8> scratch;   // size-1 staging for a single-byte `sink.write` (View can't wrap a stack local)
    bool needComma;
    bool err;              // STICKY error flag (mirror of JsonDeserializer)
    SerError code;         // the recorded write error

    public ctor make(W sink) {
        this.sink = give sink;
        this.scratch = FixedArray.make(size: 1);
        this.needComma = false;
        this.err = false;
        this.code = SerError::NotRepresentable;
    }

    // Lend the underlying sink while the serializer is in use. W-agnostic body.
    public const fn const ref W innerRef() { return this.sink; }   // read-only; `innerRefMut` to drive the sink
    public fn ref W innerRefMut() { return this.sink; }
    // The sink back when the serializer is done: `give w.intoInner()` (KR-261). `innerRefMut` lends it while the
    // serializer is still in use; this ends the serializer.
    public give fn W intoInner() { return give this.sink; }

    // Stream a `Serializable` value's JSON into this writer's owned sink, then flush — the streaming twin of the
    // `serializeJsonBuffer` sugar, without materializing the whole string. The ergonomic write-to-a-sink entry (a generic
    // free fn / static method can't instantiate `JsonSerializer<W>`, so this is an INSTANCE method on a writer the
    // caller builds at a concrete site):
    //   JsonSerializer<StringWriter> w = JsonSerializer::<StringWriter>.make(sink: give mySink);
    //   Result<Unit, Owned<Error>> r = w.encodeValue(v: myValue);
    public fn Result<Unit, Owned<Error>> encodeValue(Serializable v) {
        Serializer s = this;   // borrow self behind the Serializer interface
        Result<Unit, Owned<Error>> r = v.serialize(w: ref s);
        match (give r) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
        Result<Unit, IoError> fr = this.sink.flush();
        match (fr) { case Err(error: e): { return Result::Err(error: e); } case Ok(value: _): {} };
        return Result::Ok(value: Unit::Unit);
    }

    // --- low-level byte output ---
    fn void byte(uint8 b) {
        this.scratch[0] = b;
        match (this.sink.write(bytes: this.scratch.view())) {
            case Err(error: _): { this.failWith(e: SerError::IoError); }
            case Ok(value: _): {}
        };
    }
    fn void ascii(string s) {
        isize n = s.length();
        isize i = 0;
        while (i < n) { this.byte(b: s[i]); i = i + 1; }
    }
    fn void sep() { if (this.needComma) { this.byte(b: 44ui8); } }   // ','
    fn uint8 hexDigit(uint8 v) {
        if (v < 10ui8) { return 48ui8 + v; }        // '0'..'9'
        return 97ui8 + (v - 10ui8);                 // 'a'..'f'
    }
    fn void uEscape(uint8 c) {                      // \u00XX for a control byte
        this.byte(b: 92ui8); this.byte(b: 117ui8);  // \u
        this.byte(b: 48ui8); this.byte(b: 48ui8);   // 00
        this.byte(b: this.hexDigit(v: (c >> 4ui8) & 15ui8));
        this.byte(b: this.hexDigit(v: c & 15ui8));
    }
    // One codepoint -> its UTF-8 bytes. The writer's only encoder: a `string` is already UTF-8 and passes
    // through verbatim (see `quoted`), so this exists for `char`, which arrives as a scalar value.
    fn void utf8(uint32 cp) {
        if (cp < 128ui32) { this.byte(b: cast<uint8>(cp)); }
        else if (cp < 2048ui32) {
            this.byte(b: cast<uint8>(192ui32 | (cp >> 6ui32)));
            this.byte(b: cast<uint8>(128ui32 | (cp & 63ui32)));
        } else if (cp < 65536ui32) {
            this.byte(b: cast<uint8>(224ui32 | (cp >> 12ui32)));
            this.byte(b: cast<uint8>(128ui32 | ((cp >> 6ui32) & 63ui32)));
            this.byte(b: cast<uint8>(128ui32 | (cp & 63ui32)));
        } else {
            this.byte(b: cast<uint8>(240ui32 | (cp >> 18ui32)));
            this.byte(b: cast<uint8>(128ui32 | ((cp >> 12ui32) & 63ui32)));
            this.byte(b: cast<uint8>(128ui32 | ((cp >> 6ui32) & 63ui32)));
            this.byte(b: cast<uint8>(128ui32 | (cp & 63ui32)));
        }
    }
    // A JSON string literal: quotes + escaping for ", \, the common control shorts, and \u00XX otherwise.
    // Bytes >= 0x20 (incl. UTF-8 continuation bytes) pass through verbatim — valid since the source is UTF-8.
    fn void quoted(const ref string s) {
        this.byte(b: 34ui8);                        // "
        isize n = s.length();
        isize i = 0;
        while (i < n) {
            uint8 c = s[i];
            if (c == 34ui8)      { this.byte(b: 92ui8); this.byte(b: 34ui8); }    // \"
            else if (c == 92ui8) { this.byte(b: 92ui8); this.byte(b: 92ui8); }    // backslash
            else if (c == 10ui8) { this.byte(b: 92ui8); this.byte(b: 110ui8); }   // \n
            else if (c == 9ui8)  { this.byte(b: 92ui8); this.byte(b: 116ui8); }   // \t
            else if (c == 13ui8) { this.byte(b: 92ui8); this.byte(b: 114ui8); }   // \r
            else if (c < 32ui8)  { this.uEscape(c: c); }
            else                 { this.byte(b: c); }
            i = i + 1;
        }
        this.byte(b: 34ui8);
    }

    // --- Serializer contract ---
    public fn void beginObject(usize count) { this.sep(); this.byte(b: 123ui8); this.needComma = false; }   // { — count unused (self-delimiting)
    public fn void endObject()   { this.byte(b: 125ui8); this.needComma = true; }                // }
    public fn void beginArray(usize count) { this.sep(); this.byte(b: 91ui8); this.needComma = false; }  // [
    public fn void endArray()    { this.byte(b: 93ui8); this.needComma = true; }                 // ]
    // JSON is a NAMED format: it keeps the name and ignores the id.
    public fn void field(string name, uint32 id) {
        this.sep();
        this.quoted(s: ref name);
        this.byte(b: 58ui8);                        // :
        this.needComma = false;
    }
    // A variant selector is a JSON string — the externally-tagged `{"tag":"Circle",…}` form. The index is
    // what a positional/numbered backend keeps instead.
    public fn void variant(string name, uint32 index) { this.sep(); this.quoted(s: ref name); this.needComma = true; }
    public fn void writeI8(int8 v)   { this.sep(); this.ascii(s: i8Str(v: v));  this.needComma = true; }
    public fn void writeI16(int16 v) { this.sep(); this.ascii(s: i16Str(v: v)); this.needComma = true; }
    public fn void writeI32(int32 v) { this.sep(); this.ascii(s: i32Str(v: v)); this.needComma = true; }
    public fn void writeI64(int64 v) { this.sep(); this.ascii(s: i64Str(v: v)); this.needComma = true; }
    public fn void writeU8(uint8 v)   { this.sep(); this.ascii(s: u8Str(v: v));  this.needComma = true; }
    public fn void writeU16(uint16 v) { this.sep(); this.ascii(s: u16Str(v: v)); this.needComma = true; }
    public fn void writeU32(uint32 v) { this.sep(); this.ascii(s: u32Str(v: v)); this.needComma = true; }
    public fn void writeU64(uint64 v) { this.sep(); this.ascii(s: u64Str(v: v)); this.needComma = true; }
    // JSON has no NaN/Inf literal. `(v - v) != 0` is true iff v is non-finite (NaN-NaN and Inf-Inf are both
    // NaN, which != 0; a finite v gives 0), so this catches BOTH without a dedicated intrinsic.
    public fn void writeF32(float32 v) {
        if ((v - v) != 0.0f32) { this.failWith(e: SerError::NotRepresentable); return; }
        this.sep(); this.ascii(s: f32Str(v: v)); this.needComma = true;
    }
    public fn void writeF64(float64 v) {
        if ((v - v) != 0.0) { this.failWith(e: SerError::NotRepresentable); return; }
        this.sep(); this.ascii(s: f64Str(v: v)); this.needComma = true;
    }
    public fn void writeBool(bool v) { this.sep(); this.ascii(s: boolStr(b: v)); this.needComma = true; }
    public fn void writeString(const ref string v) { this.sep(); this.quoted(s: ref v); this.needComma = true; }
    // A number's exact text, as it came (`JsonNumber` holds only text that is RFC 8259's grammar).
    public fn void writeNumberText(const ref string text) { this.sep(); this.ascii(s: copy text); this.needComma = true; }
    public fn void writeSome()   { }   // JSON marks presence by the value itself not being `null`
    public fn void writeNull() { this.sep(); this.ascii(s: "null"); this.needComma = true; }
    public fn void writeChar(char v) {
        this.sep();
        this.byte(b: 34ui8);                        // "
        uint32 cp = cast<uint32>(v);
        if (cp < 128ui32) {
            uint8 b = cast<uint8>(cp);
            if (b == 34ui8)      { this.byte(b: 92ui8); this.byte(b: 34ui8); }
            else if (b == 92ui8) { this.byte(b: 92ui8); this.byte(b: 92ui8); }
            else if (b < 32ui8)  { this.uEscape(c: b); }
            else                 { this.byte(b: b); }
        } else {
            // Raw UTF-8, exactly as `quoted()` writes a string — JSON is a UTF-8 format (RFC 8259 §8.1),
            // so escaping buys nothing and costs correctness. It used to emit `\uXXXX` from the low 16
            // bits, which SILENTLY CORRUPTED any astral char: U+1F600 came out as ``, a different
            // character entirely, because a codepoint above the BMP does not fit one UTF-16 escape.
            // Emitting bytes keeps one spelling for `char` and `string` and needs no surrogate pairing.
            this.utf8(cp: cp);
        }
        this.byte(b: 34ui8);
        this.needComma = true;
    }

    // --- sticky error queries (mirror of JsonDeserializer) ---
    public const fn bool failed() { return this.err; }
    public fn void fail() { this.err = true; }
    public fn void failWith(SerError e) { this.err = true; this.code = e; }
    public const fn SerError errorCode() { return this.code; }
    // A map keyed by a `string` or an integer is a JSON object (KR-136).
    public const fn bool keyedMaps() { return true; }
}

// Serializable any `Serializable` value to a JSON string. Takes the value behind the `Serializable` interface
// (dynamic dispatch), so a concrete value auto-wraps at the call site (`json::serializeJsonBuffer(v: point)`); the
// value's vtable travels in the fat pointer, sidestepping cross-module static-vtable visibility. A `value`
// copies cheaply; pass `copy`/`give` for a `resource` you want to keep or move.
fn Result<string, Owned<Error>> serializeJsonBuffer(Serializable v) {
    JsonSerializer<StringWriter> w = JsonSerializer::<StringWriter>.make(sink: StringWriter.make());
    Serializer s = w;              // borrow the writer behind the Serializer interface
    Result<Unit, Owned<Error>> r = v.serialize(w: ref s);
    match (give r) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
    return Result::Ok(value: (give w.intoInner()).finish());   // materialize the concrete StringWriter's bytes
}

// The checked float parse `std::fmt::parse` uses (kama_fmt.h): it borrows the token string (`ref` →
// `kama_string*`), so the caller keeps ownership and drops it. (Passing an owned string BY VALUE to an extern
// would "transfer ownership" to C, which never frees it — a leak.)
extern fn int32 kama_parse_f64_ck(const ref string s, out float64 v);
extern fn int32 kama_parse_f32_ck(const ref string s, out float32 v);

// A JSON reader: a recursive-descent parser over an owned source string, implementing Deserializer. It uses
// a STICKY error flag — a malformed token sets `err` and returns a default, and the caller checks `failed()`
// once at the end — so the generated `deserialize` needs no per-read error branching.
type resource JsonDeserializer implements Deserializer {
    string src;
    isize pos;
    isize len;
    bool err;
    DeErrorKind code;       // the specific error `failWith` recorded; `Malformed` by default
    bool refuseUnknown;     // a STRICT reader: a key no field claims fails `UnknownField` (KR-126)
    isize depth;            // objects and arrays open around the cursor

    // The lenient reader: a key no field claims is skipped.
    public ctor make(string src) { return JsonDeserializer.of(src: give src, refuseUnknown: false); }
    // The strict reader, for a hand-written file: `T.deserialize(r:)` or `x.mergeFrom(r:)` through it fails on the first
    // key no field claims, naming it — ``unknown field `server.prot` `` — where `make` would skip it.
    public ctor strict(string src) { return JsonDeserializer.of(src: give src, refuseUnknown: true); }
    ctor of(string src, bool refuseUnknown) {
        this.len = src.length();
        this.src = give src;
        this.pos = 0;
        this.err = false;
        this.code = DeErrorKind::Malformed;
        this.refuseUnknown = refuseUnknown;
        this.depth = 0;
    }

    // --- low-level cursor ---
    fn uint8 peek() {
        if (this.pos >= this.len) { return 0ui8; }
        return this.src[this.pos];
    }
    fn void skipWs() {
        while (this.pos < this.len) {
            uint8 c = this.src[this.pos];
            if (c == 32ui8) { this.pos = this.pos + 1; }
            else if (c == 9ui8) { this.pos = this.pos + 1; }
            else if (c == 10ui8) { this.pos = this.pos + 1; }
            else if (c == 13ui8) { this.pos = this.pos + 1; }
            else { break; }
        }
    }
    fn void expect(uint8 b) {
        this.skipWs();
        if (this.peek() == b) { this.pos = this.pos + 1; } else { this.brokenAt(); }
    }
    // The start of a value the schema asked for (`{`, `[`): another value there is the schema disagreeing with a
    // well-formed document, not a malformed one.
    fn void expectValue(uint8 b) {
        this.skipWs();
        if (this.peek() == b) { this.pos = this.pos + 1; } else { this.wrongValue(); }
    }
    // A read that did not find the value it asked for. Another JSON value there — a string where a number belongs,
    // `"port": "x"` — is a `TypeMismatch`: the document is well formed and the schema disagrees with it. Anything
    // else is the document's own fault (brokenAt).
    fn void wrongValue() {
        if (this.pos < this.len) {
            uint8 c = this.src[this.pos];
            if (c == 34ui8 || c == 123ui8 || c == 91ui8 || c == 116ui8 || c == 102ui8 || c == 110ui8 || c == 45ui8
                || (c >= 48ui8 && c <= 57ui8)) {
                this.failWith(kind: DeErrorKind::TypeMismatch);
                return;
            }
        }
        this.brokenAt();
    }
    // The document itself is broken here: it ends (`UnexpectedEnd`), or it holds a byte JSON has no place for.
    fn void brokenAt() {
        if (this.pos >= this.len) { this.failWith(kind: DeErrorKind::UnexpectedEnd); }
        else { this.failWith(kind: DeErrorKind::Malformed); }
    }
    fn uint8 hexVal(uint8 c) {
        if (c >= 48ui8 && c <= 57ui8) { return c - 48ui8; }        // 0-9
        if (c >= 97ui8 && c <= 102ui8) { return c - 97ui8 + 10ui8; } // a-f
        if (c >= 65ui8 && c <= 70ui8) { return c - 65ui8 + 10ui8; }  // A-F
        this.err = true; return 0ui8;
    }
    unsafe fn string bytesToString(const ref DynamicArray<uint8> b) {
        if (b.length() == 0) { return ""; }
        return kama_string_from_raw(src: addr(of: b[0]), start: 0, len: b.length());
    }

    // --- structural (Deserializer) ---
    public fn void beginObject(usize count) { this.expectValue(b: 123ui8); this.enter(); }   // { — count unused
    public fn void beginArray()  { this.expectValue(b: 91ui8); this.enter(); }    // [
    // Untrusted input decides how deep a read recurses — a typed schema that holds itself, and the skip of an unknown
    // value — so a reader that follows it to any depth overflows the stack: `{"junk":` and a million `[` was a SIGSEGV.
    // 128 levels, serde_json's limit, fits the smallest stack kama runs on (a wasm isolate's 256 KiB).
    fn void enter() {
        this.depth = this.depth + 1;
        if (this.depth > 128) { this.failWith(kind: DeErrorKind::TooDeep); }
    }
    public fn void endObject() { }   // `moreFields` already consumed the `}` — self-describing, nothing to pop
    public fn bool moreFields() {
        if (this.err) { return false; }   // sticky failure: stop iterating (else a malformed byte loops forever)
        this.skipWs();
        uint8 c = this.peek();
        if (c == 125ui8) { this.pos = this.pos + 1; this.depth = this.depth - 1; return false; }   // }
        if (c == 44ui8)  { this.pos = this.pos + 1; this.skipWs(); return true; } // ,
        return true;
    }
    public fn bool moreElems() {
        if (this.err) { return false; }   // sticky failure: stop iterating
        this.skipWs();
        uint8 c = this.peek();
        if (c == 93ui8) { this.pos = this.pos + 1; this.depth = this.depth - 1; return false; }    // ]
        if (c == 44ui8) { this.pos = this.pos + 1; this.skipWs(); return true; } // ,
        return true;
    }
    // JSON keys are strings, so a JSON reader can only ever report a NAME — never an id.
    public fn FieldKey field() {
        string k = this.readString();
        this.expect(b: 58ui8);   // :
        return FieldKey::Name(name: give k);
    }
    // The externally-tagged variant selector is a bare JSON string value (no `:` follows it).
    public fn FieldKey variant() { return FieldKey::Name(name: this.readString()); }

    // --- scalars ---
    fn isize digits() {
        isize n = 0;
        while (this.pos < this.len && this.src[this.pos] >= 48ui8 && this.src[this.pos] <= 57ui8) {
            this.pos = this.pos + 1;
            n = n + 1;
        }
        return n;
    }
    // One JSON number (RFC 8259 §6) — `-`? (`0` | [1-9] digits) (`.` digits)? ([eE] [+-]? digits)? — and nothing
    // number-like straight after it. The scan used to take any run of `0-9+-.eE`, so `[007]` read 7, `[+7]` and `[-]`
    // read 0, and `1.2.3` read as a float; each is malformed input.
    fn string numToken() {
        this.skipWs();
        isize start = this.pos;
        uint8 c = this.peek();
        if (c != 45ui8 && (c < 48ui8 || c > 57ui8)) { this.wrongValue(); return ""; }   // not a number at all
        if (c == 45ui8) { this.pos = this.pos + 1; }                                  // -
        if (this.peek() == 48ui8) { this.pos = this.pos + 1; }                       // a lone leading 0
        else if (this.digits() == 0) { this.brokenAt(); return ""; }
        if (this.peek() == 46ui8) {                                                  // . fraction
            this.pos = this.pos + 1;
            if (this.digits() == 0) { this.brokenAt(); return ""; }
        }
        uint8 e = this.peek();
        if (e == 101ui8 || e == 69ui8) {                                             // e/E exponent
            this.pos = this.pos + 1;
            uint8 sign = this.peek();
            if (sign == 43ui8 || sign == 45ui8) { this.pos = this.pos + 1; }
            if (this.digits() == 0) { this.brokenAt(); return ""; }
        }
        uint8 n = this.peek();
        if ((n >= 48ui8 && n <= 57ui8) || n == 46ui8 || n == 43ui8 || n == 45ui8 || n == 101ui8 || n == 69ui8) {
            this.brokenAt(); return "";                                               // `007`, `1.2.3`
        }
        return this.src.substring(start: start, end: this.pos);
    }
    // The integer a valid token spells, as a magnitude no greater than `limit`, or `None`: a fraction or an exponent
    // is no integer (`1.5`, `1e3`), and past `limit` it does not fit. Checked before each step, so nothing overflows —
    // `9223372036854775808` into an `int64` aborted the process, and so did the valid `-9223372036854775808`.
    fn Optional<uint64> magnitude(const ref string tok, isize from, uint64 limit) {
        uint64 v = 0ui64;
        isize i = from;
        while (i < tok.length()) {
            uint8 c = tok[i];
            if (c < 48ui8 || c > 57ui8) { return Optional::None; }
            uint64 d = cast<uint64>(c - 48ui8);
            if (v > (limit - d) / 10ui64) { return Optional::None; }
            v = v * 10ui64 + d;
            i = i + 1;
        }
        return Optional::Some(value: v);
    }
    fn int64 readInt() {
        string tok = this.numToken();
        if (this.err) { return 0i64; }
        bool neg = tok[0] == 45ui8;
        Optional<uint64> m = this.magnitude(tok: tok, from: neg ? 1 : 0,
                                            limit: neg ? 9223372036854775808ui64 : 9223372036854775807ui64);
        match (m) {
            case Some(value: v): {
                if (!neg) { return cast<int64>(v); }
                if (v == 9223372036854775808ui64) { return -9223372036854775807i64 - 1i64; }
                return 0i64 - cast<int64>(v);
            }
            case None: { }
        };
        this.failWith(kind: DeErrorKind::TypeMismatch); return 0i64;
    }
    fn uint64 readUint() {
        string tok = this.numToken();
        if (this.err) { return 0ui64; }
        bool neg = tok[0] == 45ui8;
        Optional<uint64> m = this.magnitude(tok: tok, from: neg ? 1 : 0, limit: 18446744073709551615ui64);
        match (m) {
            case Some(value: v): { if (!neg || v == 0ui64) { return v; } }   // `-0` is zero; `-3` is no uint
            case None: { }
        };
        this.failWith(kind: DeErrorKind::TypeMismatch); return 0ui64;
    }
    // A number that does not FIT the field it is being read into is a bad DOCUMENT, not a bug in this
    // program — so it fails the reader, exactly like a malformed token does, and never traps. That is
    // what `try cast` is for: a plain `cast` would abort the process on `{"n": 300}` into an `int8`, and
    // a deserializer that aborts on untrusted input is not a deserializer. `TypeMismatch` is the closest
    // existing `DeErrorKind`; the range is a property of the destination type, which is what the value failed
    // to match.
    public fn int8 readI8() {
        Optional<int8> v = try cast<int8>(this.readInt());
        match (v) { case Some(value: x): { return x; } case None: {} };
        this.failWith(kind: DeErrorKind::TypeMismatch); return 0i8;
    }
    public fn int16 readI16() {
        Optional<int16> v = try cast<int16>(this.readInt());
        match (v) { case Some(value: x): { return x; } case None: {} };
        this.failWith(kind: DeErrorKind::TypeMismatch); return 0i16;
    }
    public fn int32 readI32() {
        Optional<int32> v = try cast<int32>(this.readInt());
        match (v) { case Some(value: x): { return x; } case None: {} };
        this.failWith(kind: DeErrorKind::TypeMismatch); return 0;
    }
    public fn int64 readI64() { return this.readInt(); }
    public fn uint8 readU8() {
        Optional<uint8> v = try cast<uint8>(this.readUint());
        match (v) { case Some(value: x): { return x; } case None: {} };
        this.failWith(kind: DeErrorKind::TypeMismatch); return 0ui8;
    }
    public fn uint16 readU16() {
        Optional<uint16> v = try cast<uint16>(this.readUint());
        match (v) { case Some(value: x): { return x; } case None: {} };
        this.failWith(kind: DeErrorKind::TypeMismatch); return 0ui16;
    }
    public fn uint32 readU32() {
        Optional<uint32> v = try cast<uint32>(this.readUint());
        match (v) { case Some(value: x): { return x; } case None: {} };
        this.failWith(kind: DeErrorKind::TypeMismatch); return 0ui32;
    }
    public fn uint64 readU64() { return this.readUint(); }
    // A float is held to the integers' rule above: past the destination's range the DOCUMENT is bad, and a
    // malformed token is one too. Both used to read as a number — `1e400` came back `inf`, `1.2.3` came back 1.2
    // (strtod stopped where it liked), and a float32 field rounded twice and overflowed to `inf` — through a
    // lenient parse that reported nothing. An underflow is a number: it rounds to zero or a subnormal.
    public unsafe fn float64 readF64() {
        string t = this.numToken();
        slot float64 v;
        int32 st = kama_parse_f64_ck(s: t, v: out v);
        if (st == 3) { this.failWith(kind: DeErrorKind::TypeMismatch); return 0.0; }
        if (st != 0) { this.err = true; return 0.0; }
        return v;
    }
    public unsafe fn float32 readF32() {
        string t = this.numToken();
        slot float32 v;
        int32 st = kama_parse_f32_ck(s: t, v: out v);
        if (st == 3) { this.failWith(kind: DeErrorKind::TypeMismatch); return 0.0f32; }
        if (st != 0) { this.err = true; return 0.0f32; }
        return v;
    }
    // `true`, `false` and `null` are read whole. Their first byte alone used to decide, and the rest was skipped
    // unread, so `{"a": nada}` read as null and `tzzz` as true.
    fn bool literal(const ref string word) {
        isize n = word.length();
        if (this.pos + n > this.len) { return false; }
        isize i = 0;
        while (i < n) { if (this.src[this.pos + i] != word[i]) { return false; } i = i + 1; }
        this.pos = this.pos + n;
        return true;
    }
    public fn bool readBool() {
        this.skipWs();
        uint8 c = this.peek();
        if (c == 116ui8) { if (this.literal(word: "true")) { return true; } this.brokenAt(); return false; }
        if (c == 102ui8) { if (this.literal(word: "false")) { return false; } this.brokenAt(); return false; }
        this.wrongValue(); return false;
    }
    // Consumes `null` when it is next, and answers whether it was. Any other value is left for the caller to read.
    public fn bool readNull() {
        this.skipWs();
        if (this.peek() == 110ui8) { if (this.literal(word: "null")) { return true; } this.brokenAt(); }
        return false;
    }
    // The first CODEPOINT of the string, not its first byte. `s[0]` used to be returned directly, which is
    // the UTF-8 LEAD BYTE — so any non-ASCII `char` decoded to a mangled scalar (`é` came back as 195).
    // `.chars()` is the language's own UTF-8 decoder, so this needs no second implementation of it.
    public fn char readChar() {
        string s = this.readString();
        foreach (char c in s.chars()) { return c; }
        return cast<char>(0ui32);                // empty string
    }
    public fn string readString() {
        this.skipWs();
        if (this.peek() != 34ui8) { this.wrongValue(); return ""; }   // opening "
        this.pos = this.pos + 1;
        DynamicArray<uint8> acc = DynamicArray.empty();
        while (this.pos < this.len) {
            uint8 c = this.src[this.pos];
            if (c == 34ui8) { this.pos = this.pos + 1; return this.bytesToString(b: acc); }   // closing "
            if (c == 92ui8) {                                        // backslash escape
                this.pos = this.pos + 1;
                if (this.pos >= this.len) { this.err = true; break; }
                uint8 e = this.src[this.pos];
                if (e == 34ui8) { acc.add(item: 34ui8); }
                else if (e == 92ui8) { acc.add(item: 92ui8); }
                else if (e == 47ui8) { acc.add(item: 47ui8); }
                else if (e == 110ui8) { acc.add(item: 10ui8); }
                else if (e == 116ui8) { acc.add(item: 9ui8); }
                else if (e == 114ui8) { acc.add(item: 13ui8); }
                else if (e == 98ui8) { acc.add(item: 8ui8); }
                else if (e == 102ui8) { acc.add(item: 12ui8); }
                else if (e == 117ui8) { this.readUnicodeEscape(acc: ref acc); }
                else { acc.add(item: e); }
                this.pos = this.pos + 1;
            } else {
                acc.add(item: c);
                this.pos = this.pos + 1;
            }
        }
        this.brokenAt();   // no closing `"` before the end
        return this.bytesToString(b: acc);
    }
    // Read the four hex digits of a `\uXXXX` escape. Called with pos at the 'u'; leaves pos at the last
    // hex digit. Returns the raw 16-bit code UNIT (not yet a codepoint — it may be half of a pair).
    // Failure rides the reader's existing sticky `err` flag rather than an out-param, like every other
    // read here — the caller checks `this.err`, and a truncated escape yields 0.
    fn uint32 readHex4() {
        if (this.pos + 4 >= this.len) { this.err = true; return 0ui32; }
        uint32 v = 0ui32;
        isize k = 1;
        while (k <= 4) {
            v = (v << 4ui32) | cast<uint32>(this.hexVal(c: this.src[this.pos + k]));
            k = k + 1;
        }
        this.pos = this.pos + 4;
        return v;
    }
    // `\uXXXX` -> UTF-8. Called with pos at the 'u'; leaves pos at the last hex digit.
    //
    // JSON inherited UTF-16 escapes from JavaScript (RFC 8259 §7), so a codepoint above the BMP arrives as
    // a SURROGATE PAIR — `😀` for U+1F600. Encoding each half on its own yields CESU-8 (two
    // 3-byte sequences) rather than UTF-8 (one 4-byte sequence), which is a different byte string: a
    // round-trip through such a document used to come back 2 bytes longer and unequal. This is not a
    // corner case — Python's `json.dumps` escapes ALL non-ASCII by default (`ensure_ascii=True`), and
    // JavaScript's `JSON.stringify` does when asked for ASCII output, so it is the ordinary shape of
    // JSON produced elsewhere. kama stays UTF-8-everywhere: the pair is combined HERE, at the wire edge,
    // and nothing above this line ever sees a UTF-16 code unit.
    fn void readUnicodeEscape(ref DynamicArray<uint8> acc) {
        uint32 cp = this.readHex4();
        if (this.err) { return; }
        // A HIGH surrogate (D800..DBFF) must be followed by `\u` + a LOW surrogate (DC00..DFFF).
        if (cp >= 55296ui32 && cp <= 56319ui32) {
            if (this.pos + 2 < this.len && this.src[this.pos + 1] == 92ui8 && this.src[this.pos + 2] == 117ui8) {
                this.pos = this.pos + 2;                       // consume the `\u` of the low half
                uint32 lo = this.readHex4();
                if (this.err) { return; }
                if (lo >= 56320ui32 && lo <= 57343ui32) {
                    cp = 65536ui32 + ((cp - 55296ui32) << 10ui32) + (lo - 56320ui32);
                } else {
                    this.err = true; return;                   // a high surrogate followed by a non-low one
                }
            } else {
                this.err = true; return;                       // an unpaired high surrogate
            }
        } else if (cp >= 56320ui32 && cp <= 57343ui32) {
            this.err = true; return;                           // a low surrogate with no high half
        }
        if (cp < 128ui32) { acc.add(item: cast<uint8>(cp)); }
        else if (cp < 2048ui32) {
            acc.add(item: cast<uint8>(192ui32 | (cp >> 6ui32)));
            acc.add(item: cast<uint8>(128ui32 | (cp & 63ui32)));
        } else if (cp < 65536ui32) {
            acc.add(item: cast<uint8>(224ui32 | (cp >> 12ui32)));
            acc.add(item: cast<uint8>(128ui32 | ((cp >> 6ui32) & 63ui32)));
            acc.add(item: cast<uint8>(128ui32 | (cp & 63ui32)));
        } else {
            acc.add(item: cast<uint8>(240ui32 | (cp >> 18ui32)));           // astral: 4-byte UTF-8
            acc.add(item: cast<uint8>(128ui32 | ((cp >> 12ui32) & 63ui32)));
            acc.add(item: cast<uint8>(128ui32 | ((cp >> 6ui32) & 63ui32)));
            acc.add(item: cast<uint8>(128ui32 | (cp & 63ui32)));
        }
    }
    public fn void skipValue() {
        this.skipWs();
        uint8 c = this.peek();
        if (c == 123ui8) { this.beginObject(count: 0); while (this.moreFields()) { FieldKey k = this.field(); this.skipValue(); } }
        else if (c == 91ui8) { this.beginArray(); while (this.moreElems()) { this.skipValue(); } }
        else if (c == 34ui8) { string s = this.readString(); }
        else if (c == 116ui8) { bool b = this.readBool(); }
        else if (c == 102ui8) { bool b = this.readBool(); }
        else if (c == 110ui8) { bool n = this.readNull(); }
        else { string t = this.numToken(); }
    }
    public const fn bool failed() { return this.err; }
    public fn void fail() { this.err = true; }   // the generated enum deserialize flags an unknown tag

    // Record a SPECIFIC error (e.g. a dangling ref -> UnresolvedReference), so `deserializeJsonBuffer` surfaces it instead of
    // the generic `Malformed`.
    public fn void failWith(DeErrorKind kind) { if (!this.err) { this.code = kind; } this.err = true; }   // the FIRST failure is the one reported
    // KR-126: a key no field claims. Skipped, so an older reader loads a newer writer's data — unless this reader was
    // made `strict`, for a hand-written file where a misspelt key must not do nothing silently.
    public fn void unknownField() { if (this.refuseUnknown) { this.failWith(kind: DeErrorKind::UnknownField); } else { this.skipValue(); } }
    public const fn DeErrorKind errorKind() { return this.code; }
    // A map is read as an object when one is next, and as the pair array kama wrote before KR-136 otherwise.
    public fn bool atKeyedMap() { this.skipWs(); return this.peek() == 123ui8; }   // `{`
    // The next value's kind, from its first byte; a byte no JSON value starts with is the document's fault.
    public fn ValueKind peekKind() {
        this.skipWs();
        uint8 c = this.peek();
        if (c == 123ui8) { return ValueKind::Object; }                          // {
        if (c == 91ui8)  { return ValueKind::Array; }                           // [
        if (c == 34ui8)  { return ValueKind::String; }                          // "
        if (c == 116ui8 || c == 102ui8) { return ValueKind::Bool; }             // t f
        if (c == 110ui8) { return ValueKind::Null; }                            // n
        if (c == 45ui8 || (c >= 48ui8 && c <= 57ui8)) { return ValueKind::Number; }
        this.brokenAt();
        return ValueKind::Null;
    }
    // The next number's text exactly as the document spells it, held to RFC 8259 by the one scanner every read uses.
    public fn string readNumberText() { return this.numToken(); }
}

// Deserializable a JSON string into a `Deserializable` type — the one-liner entry. Name the target with turbofish:
// `json::deserializeJsonBuffer::<Point>(src)`. The generated `deserialize` returns the reconstructed `T` directly (bypass-
// ctor: zero-init + field-set), carrying any parse failure in the reader's sticky error flag; this wraps that
// into a `Result` after checking `failed()`.
fn Result<T, Owned<Error>> deserializeJsonBuffer<T: Deserializable<T>>(string src) {
    JsonDeserializer r = JsonDeserializer.make(src: give src);
    Result<T, Owned<Error>> got = T.deserialize(r: r);
    // A reader that failed is never `Ok`, whatever the type's own `deserialize` forgot to ask.
    if (got.isOk() && r.failed()) { return Result::Err(error: DeError.of(kind: r.errorKind())); }
    return give got;
}

// Deserializable from any `Reader` — the streaming twin of `deserializeJsonBuffer`. Drains the reader fully into a string
// first (`readAll`), then parses — the buffer-a-value model (Go's `encoding/json`), a convenience rather
// than a necessity: nothing seeks. A read `IoError` auto-boxes into `Owned<Error>`.
fn Result<T, Owned<Error>> deserializeJsonStream<T: Deserializable<T>>(Reader from) {
    Result<string, IoError> rr = readAll(r: from);
    string src = match (give rr) {
        case Ok(value: s):  { := give s; }
        case Err(error: e): { return Result::Err(error: e); }   // IoError auto-boxes into Owned<Error>
    };
    JsonDeserializer r = JsonDeserializer.make(src: give src);
    Result<T, Owned<Error>> got = T.deserialize(r: r);
    // A reader that failed is never `Ok`, whatever the type's own `deserialize` forgot to ask.
    if (got.isOk() && r.failed()) { return Result::Err(error: DeError.of(kind: r.errorKind())); }
    return give got;
}

// MERGE a JSON document into a value the program already holds (KR-125): a layered config file, a live reload, a
// remote change of one setting. Only what the document carries is written — `{"mix":{"gain":0.25}}` changes `gain`
// and nothing else, where `deserializeJsonBuffer` would build a new value and reset every field the document leaves
// out. A field whose type is a derived record merges; any other field the document names is replaced whole (a list,
// a map, an `Optional`, an enum). Atomic: on an `Err` — a type mismatch, a broken document — `into` is untouched.
fn Result<Unit, Owned<Error>> mergeJsonBuffer<T: MergeDeserializable<T>>(string src, ref T into) {
    JsonDeserializer r = JsonDeserializer.make(src: give src);
    return into.mergeFrom(r: r);
}

// The streaming twin of `mergeJsonBuffer`: drains the reader, as `deserializeJsonStream` does, then merges.
fn Result<Unit, Owned<Error>> mergeJsonStream<T: MergeDeserializable<T>>(Reader from, ref T into) {
    Result<string, IoError> rr = readAll(r: from);
    string src = match (give rr) {
        case Ok(value: s):  { := give s; }
        case Err(error: e): { return Result::Err(error: e); }
    };
    JsonDeserializer r = JsonDeserializer.make(src: give src);
    return into.mergeFrom(r: r);
}

// Stream a value straight into an owned `W: Writer` sink — a file, socket or buffered writer — without
// materializing the whole encoding first. The streaming twin of `serializeJsonBuffer`, and the write-side peer of
// `deserializeJsonStream`.
//
// The sink comes back when the value is written — `Ok(sink)` — and with the error when it is not (`Unserialized`), so
// one connection carries many messages (JSON-RPC, line-delimited JSON) with no copy through memory:
// `match (serializeJsonStream(v: m, to: give sock)) { case Ok(value: s): { sock = give s; } case Err(error: e): { … } };` (KR-261).
// To write several values with one serializer, build it, call `encodeValue`, and `intoInner` when done.
fn Result<W, Unserialized<W>> serializeJsonStream<W: Writer>(Serializable v, W to) {
    JsonSerializer<W> w = JsonSerializer::<W>.make(sink: give to);
    Result<Unit, Owned<Error>> r = w.encodeValue(v: v);
    W sink = give w.intoInner();
    return match (give r) {
        case Ok(value: _): Result::Ok(value: give sink);
        case Err(error: e): Result::Err(error: Unserialized::Failed(sink: give sink, error: give e));
    };
}

// --- The untyped half (KR-110) ---------------------------------------------------------------------------------------
// A JSON document read without a schema: what a program needs when a document's KEYS are data (glTF's `extensions`, a
// response keyed by ids) or its shape is only partly known. Go has `map[string]any`, Python `dict`, .NET `JsonNode`,
// Rust serde_json's `Value`; this is kama's, one enum over JSON's six kinds:
//
//     Result<JsonValue, Owned<Error>> doc = deserializeJsonBuffer::<JsonValue>(src: text);
//
// It is an ordinary `Serializable`/`Deserializable` type, so there is no second parser: the read is the typed reader's
// (its RFC 8259 numbers, its 128-level depth limit, its errors and paths), and a typed schema may hold a `JsonValue`
// field to keep a subtree it does not model. It reads from any SELF-DESCRIBING back end — JSON, and KBIN named — and is
// refused by the numbered and positional ones, whose streams do not say what comes next.
//
//   - An object keeps its members in document order (an `OrderedMap`), so a document reads and writes back unchanged;
//     a key the document repeats keeps its first position and takes its last value, as the typed reader's last wins.
//   - A number keeps the text it was written with (`JsonNumber`): `2^63+1`, `1e400` and `1.50` all survive, and the
//     program chooses the width it reads one at — `asInt64()`, `asUint64()`, `asFloat64()`.

// A JSON number, held as its exact text — RFC 8259's grammar, which every way of making one enforces, so an invalid
// number cannot exist. Converting it is the reader's choice of width, answered `None` when the number does not fit:
// a fraction or an exponent is no integer, and `1e400` is no `float64`.
type resource JsonNumber implements Copyable<This>(bare: give), Sendable {
    string t;

    // Text a reader's own scanner has already held to the grammar — the one place a `JsonValue` read makes one.
    ctor read(string text) { this.t = give text; }
    friend JsonValue[read];
    public ctor ofInt64(int64 v) { this.t = "${v}"; }
    public ctor ofUint64(uint64 v) { this.t = "${v}"; }
    public ctor copy(ref JsonNumber source) { this.t = copy source.t; }
    // A float's shortest round-trip text; NaN and the infinities have no JSON spelling.
    public static unsafe fn Optional<JsonNumber> ofFloat64(float64 v) {
        if (v != v || v - v != 0.0) { return Optional::None; }
        return Optional::Some(value: JsonNumber.read(text: f64Str(v: v)));
    }
    // `text` as a number, when it is one: `-`? (`0` | [1-9] digits) (`.` digits)? ([eE] [+-]? digits)?, nothing else.
    public static fn Optional<JsonNumber> parse(string text) {
        if (!JsonNumber::spelled(t: text)) { return Optional::None; }
        return Optional::Some(value: JsonNumber.read(text: give text));
    }
    static fn bool spelled(const ref string t) {
        isize n = t.length();
        isize i = 0;
        if (i < n && t[i] == 45ui8) { i = i + 1; }
        if (i < n && t[i] == 48ui8) { i = i + 1; }
        else {
            isize from = i;
            while (i < n && t[i] >= 48ui8 && t[i] <= 57ui8) { i = i + 1; }
            if (i == from) { return false; }
        }
        if (i < n && t[i] == 46ui8) {
            i = i + 1;
            isize from = i;
            while (i < n && t[i] >= 48ui8 && t[i] <= 57ui8) { i = i + 1; }
            if (i == from) { return false; }
        }
        if (i < n && (t[i] == 101ui8 || t[i] == 69ui8)) {
            i = i + 1;
            if (i < n && (t[i] == 43ui8 || t[i] == 45ui8)) { i = i + 1; }
            isize from = i;
            while (i < n && t[i] >= 48ui8 && t[i] <= 57ui8) { i = i + 1; }
            if (i == from) { return false; }
        }
        return i == n;
    }

    public const fn const ref string text() { return this.t; }
    public const fn Optional<int64> asInt64() {
        Result<int64, ParseError> p = parse::<int64>(s: this.t);
        return match (p) { case Ok(value: v): Optional::Some(value: v); case Err(error: _): Optional::None; };
    }
    public const fn Optional<uint64> asUint64() {
        Result<uint64, ParseError> p = parse::<uint64>(s: this.t);
        return match (p) { case Ok(value: v): Optional::Some(value: v); case Err(error: _): Optional::None; };
    }
    // The nearest `float64` — a number with more digits than a `float64` holds rounds, as any reader's would — or
    // `None` past its range.
    public const fn Optional<float64> asFloat64() {
        Result<float64, ParseError> p = parse::<float64>(s: this.t);
        return match (p) { case Ok(value: v): Optional::Some(value: v); case Err(error: _): Optional::None; };
    }
}

type enum JsonValue implements Serializable, Deserializable<This> {
    Null, Bool(bool value), Number(JsonNumber value), String(string value),
    Array(DynamicArray<JsonValue> items), Object(OrderedMap<string, JsonValue> members);

    // An array's elements or an object's members; 0 for anything else.
    public const fn isize length() {
        match (this) {
            case Array(items: xs): { return xs.length(); }
            case Object(members: m): { return m.length(); }
            case _: { }
        };
        return 0;
    }
    // Does an object have this member? False for anything that is not an object.
    public const fn bool has(const ref string key) {
        match (this) { case Object(members: m): { return m.contains(key: key); } case _: { } };
        return false;
    }
    // A member, in place — panics when this is not an object or has no such member (guard with `has`), as
    // `OrderedMap.getRef` panics on an absent key.
    @trackCaller
    public unsafe const fn const ref JsonValue getRef(const ref string key) {
        match (this) {
            case Object(members: m): { if (m.contains(key: key)) { return m.getRef(key: key); } }
            case _: { }
        };
        panic(msg: "JsonValue.getRef: no such member");
    }
    // A member, copied — `None` when this is not an object or has no such member.
    public const fn Optional<JsonValue> get(const ref string key) {
        match (this) {
            case Object(members: m): { if (m.contains(key: key)) { return Optional::Some(value: copy m.getRef(key: key)); } }
            case _: { }
        };
        return Optional::None;
    }
    // An element, in place — panics when this is not an array or `index` is out of its range.
    @trackCaller
    public unsafe const fn const ref JsonValue at(isize index) {
        match (this) {
            case Array(items: xs): { if (index >= 0 && index < xs.length()) { return xs[index]; } }
            case _: { }
        };
        panic(msg: "JsonValue.at: no such element");
    }
    // A number at the width asked for, or `None`: not a number, or not one that fits (see `JsonNumber`).
    public const fn Optional<int64> asInt64() {
        match (this) { case Number(value: n): { return n.asInt64(); } case _: { } };
        return Optional::None;
    }
    public const fn Optional<uint64> asUint64() {
        match (this) { case Number(value: n): { return n.asUint64(); } case _: { } };
        return Optional::None;
    }
    public const fn Optional<float64> asFloat64() {
        match (this) { case Number(value: n): { return n.asFloat64(); } case _: { } };
        return Optional::None;
    }

    public unsafe const fn Result<Unit, Owned<Error>> serialize(ref Serializer w) {
        match (this) {
            case Null: { w.writeNull(); }
            case Bool(value: b): { w.writeBool(v: b); }
            case Number(value: n): { w.writeNumberText(text: n.text()); }
            case String(value: s): { w.writeString(v: s); }
            case Array(items: xs): {
                w.beginArray(count: cast<usize>(xs.length()));
                foreach (const ref JsonValue x in xs.iterConst()) {
                    Result<Unit, Owned<Error>> r = x.serialize(w: w);
                    match (give r) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
                }
                w.endArray();
            }
            case Object(members: m): {
                w.beginObject(count: cast<usize>(m.length()));
                foreach (string k in m) {   // each member borrowed in place, in order: writing copies no subtree
                    w.field(name: copy k, id: 0ui32);
                    Result<Unit, Owned<Error>> r = m.getRef(key: k).serialize(w: w);
                    match (give r) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
                }
                w.endObject();
            }
        };
        // A write that could not proceed — a number on a back end with no form for one — is sticky; report it once.
        if (w.failed()) { return Result::Err(error: w.errorCode()); }
        return Result::Ok(value: Unit::Unit);
    }

    // Whatever the reader finds next, one value deep, recursing for arrays and objects. A failure is reported where
    // it happened (`servers[2].port`), as a typed read reports one. This frame only dispatches: a read recurses once per
    // level, up to the 128 every reader allows, and wasm's 256 KiB stack gives each level 2 KiB — one function holding
    // every kind's locals overflowed it there (a debug build keeps each arm's locals in the frame).
    public ctor Result<JsonValue, Owned<Error>> deserialize(Deserializer r) {
        ValueKind k = r.peekKind();
        if (r.failed()) { return Result::Err(error: DeError.of(kind: r.errorKind())); }
        return match (k) {
            case Array: JsonValue::readArray(r: r);
            case Object: JsonValue::readObject(r: r);
            case _: JsonValue::readScalar(r: r, kind: k);
        };
    }
    static fn Result<JsonValue, Owned<Error>> readScalar(Deserializer r, ValueKind kind) {
        match (kind) {
            case Null: {
                if (!r.readNull()) { r.failWith(kind: DeErrorKind::Malformed); }
                if (r.failed()) { return Result::Err(error: DeError.of(kind: r.errorKind())); }
                return Result::Ok(value: JsonValue::Null);
            }
            case Bool: {
                bool b = r.readBool();
                if (r.failed()) { return Result::Err(error: DeError.of(kind: r.errorKind())); }
                return Result::Ok(value: JsonValue::Bool(value: b));
            }
            case Number: {
                string t = r.readNumberText();
                if (r.failed()) { return Result::Err(error: DeError.of(kind: r.errorKind())); }
                return Result::Ok(value: JsonValue::Number(value: JsonNumber.read(text: give t)));
            }
            case _: {
                string s = r.readString();
                if (r.failed()) { return Result::Err(error: DeError.of(kind: r.errorKind())); }
                return Result::Ok(value: JsonValue::String(value: give s));
            }
        };
    }
    static fn Result<JsonValue, Owned<Error>> readArray(Deserializer r) {
        r.beginArray();
        DynamicArray<JsonValue> items = DynamicArray.empty();
        isize index = 0;
        while (r.moreElems()) {
            Result<JsonValue, Owned<Error>> e = JsonValue.deserialize(r: r);
            match (give e) {
                case Ok(value: v): { items.add(item: give v); }
                case Err(error: x): { return Result::Err(error: DeError::inElement(error: give x, index: index)); }
            };
            index = index + 1;
        }
        if (r.failed()) { return Result::Err(error: DeError.of(kind: r.errorKind())); }
        return Result::Ok(value: JsonValue::Array(items: give items));
    }
    static fn Result<JsonValue, Owned<Error>> readObject(Deserializer r) {
        r.beginObject(count: 0);
        OrderedMap<string, JsonValue> members = OrderedMap.empty();
        while (r.moreFields()) {
            FieldKey fk = r.field();
            string name = match (give fk) {
                case Name(name: n): { := give n; }
                case Id(id: _): { r.fail(); := ""; }
                case Position(rank: _): { r.fail(); := ""; }
            };
            if (r.failed()) { return Result::Err(error: DeError.of(kind: r.errorKind())); }
            Result<JsonValue, Owned<Error>> e = JsonValue.deserialize(r: r);
            match (give e) {
                case Ok(value: v): { members.put(key: give name, value: give v); }
                case Err(error: x): { return Result::Err(error: DeError::inField(error: give x, name: give name)); }
            };
        }
        r.endObject();
        if (r.failed()) { return Result::Err(error: DeError.of(kind: r.errorKind())); }
        return Result::Ok(value: JsonValue::Object(members: give members));
    }
}
