namespace std::serialization::graph;

// Graph/pointer serialization runtime. A `@generate` type with a smart-pointer `@field` (`Shared`/`Weak`)
// serializes as an object graph: every distinct object gets a stable integer id, pointer fields become ids,
// and the objects are written into a flat `{"root":id,"objects":{id:{...}}}` id table. This module holds the
// write-side runtime the compiler-generated `serialize` drives; it is auto-imported into any graph-using unit.
//
// Placement: this can't live in the prelude (the prelude can't reference stdlib `List`/`Map`/`Shared`), so it
// is a normal namespaced module and the compiler injects its import wherever a graph type is declared.

import std::memory::{Shared};
import std::collections::{List, Map};

export { GraphNode, SerContext, graphWrite };

// A node in a serializable object graph. The `@generate` codegen makes each graph type implement it:
// `__serializeInto` writes the object's own fields (pointer fields as interned ids); `__typeName` tags the
// table entry so a polymorphic graph can dispatch on read-back.
type contract GraphNode for resource {
    fn void __serializeInto(ref Serializer w, ref SerContext ctx);
    fn string __typeName();
}

// Serialize-side identity + worklist state. Dedups objects by pointee address -> stable id (so two handles
// to the same object share one id and one table entry), and holds the pending objects (owning `Shared`, so
// the graph can't be freed mid-traversal) to be drained into the id table.
type resource SerContext {
    Map<uint64, uint64> ids;              // pointee address -> id
    List<Shared<GraphNode>> nodes;        // worklist (owning)
    List<uint64> nodeIds;                 // parallel ids
    uint64 nextId;

    public SerContext() {
        Map<uint64, uint64> m = Map();        this.ids = give m;
        List<Shared<GraphNode>> ns = List();  this.nodes = give ns;
        List<uint64> ni = List();             this.nodeIds = give ni;
        this.nextId = 1ui64;
    }

    // Reserve an id for the (borrowed) root, written inline by the driver — recorded for dedup, not enqueued.
    public fn uint64 reserve(uint64 pid) {
        uint64 id = this.nextId; this.nextId = this.nextId + 1ui64;
        this.ids.put(key: pid, value: id);
        return id;
    }

    // Intern a child reached via an owning handle: dedup by identity, enqueue on first sight. Returns the id.
    public fn uint64 intern(uint64 pid, Shared<GraphNode> node) {
        Optional<uint64> ex = this.ids.get(key: ref pid);
        match (ex) { case Some(v): { return v; } case None: {} };
        uint64 id = this.nextId; this.nextId = this.nextId + 1ui64;
        this.ids.put(key: pid, value: id);
        this.nodeIds.add(item: id);
        this.nodes.add(item: node);
        return id;
    }

    // Drain the worklist into id-table entries. The list grows as each entry interns more objects; the loop
    // re-checks the length so newly-reached objects are written too. Terminates because ids dedup (a cycle
    // re-interns an already-seen object -> no new entry).
    public fn void drain(ref Serializer w) {
        int32 i = 0;
        while (i < cast<int32>(this.nodes.length())) {
            w.beginTableEntry(id: this.nodeIds[i], ty: this.nodes[i].__typeName());
            this.nodes[i].__serializeInto(w: ref w, ctx: ref this);
            w.endTableEntry();
            i = i + 1;
        }
    }
}

// The graph serialize driver invoked by a graph type's generated `serialize`. Writes the
// `{"root":id,"objects":{...}}` envelope: the root inline (it is borrowed, so it can't be enqueued as an
// owning handle), then the drained worklist of everything it transitively references.
fn void graphWrite(ref Serializer w, GraphNode root, uint64 rootPid) {
    SerContext ctx = SerContext();
    uint64 rootId = ctx.reserve(pid: rootPid);
    w.beginGraph(rootId: rootId);
    w.beginTableEntry(id: rootId, ty: root.__typeName());
    root.__serializeInto(w: ref w, ctx: ref ctx);
    w.endTableEntry();
    ctx.drain(w: ref w);
    w.endGraph();
}
