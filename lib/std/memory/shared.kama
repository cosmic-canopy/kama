export { Shared };

// M6.2: the refcount seam. Every strong/weak count mutation routes through kama_ctrl.h so the two flavors
// (plain `Rc` vs Arc-correct atomic for `Shared<immutable T>`) live in one audited place. `atomic` is the
// per-instance compile-time constant `__kama_ctrl_atomic()` (0 for an ordinary Shared -> zero overhead).
extern "kama_ctrl.h";
extern fn void  kama_ctrl_retain_strong(UnsafePtr c, int32 atomic);
extern fn int32 kama_ctrl_release_strong(UnsafePtr c, int32 atomic);
extern fn int32 kama_ctrl_finish_strong(UnsafePtr c, int32 atomic);
extern fn void  kama_ctrl_retain_weak(UnsafePtr c, int32 atomic);
extern fn void  kama_ctrl_init(UnsafePtr c);
// The one-block layout (kama_runtime.h, KR-399): the counts head the object's own block.
extern fn UnsafePtr kama_ctrl_of(UnsafePtr obj);
extern fn UnsafePtr kama_head_block(UnsafePtr obj, usize hsize, usize align);
extern fn usize     kama_head_bytes(usize hsize, usize n, usize align);
extern fn usize     kama_head_align(usize halign, usize align);

// The strong/weak reference counts shared by a `Shared`/`Weak` family: the header of the object's own block
// (`HeapHeader<Ctrl>`), so `new` draws both in one allocation and `adopt` only sets them. The block is freed when BOTH
// reach zero. Module-internal (not exported). Laid out as the runtime `kama_ctrl`, so a `BindableFunctionPtr` can
// retain a Shared it binds and an iface handle can free a block made here; kama_ctrl_init sets every field.
type value Ctrl { public usize strong; public usize weak; }

// A reference-counted shared-ownership pointer (Rust's `Rc<T>`). `Copyable(bare: copy)`: a bare hand-off
// (`Shared b = a;`) RETAINS (strong++) via `copy()`; `give b = a` MOVES the handle (transfers the ref, no
// count change — every kind is movable). The pointee is released exactly once, when the last strong handle
// drops. `implements HeapOwner<T>` makes `new T(args)` a heap-placement + adopt; `Deref<T>` forwards access.
//
// The counts and the pointee are ONE block drawn from the allocator `A` (M8 default `GlobalAllocator` → libc
// malloc/free), the counts immediately before the pointee — Rust's `RcBox`, C++'s `make_shared` (KR-399). A
// placement `new(allocator: a) T(args)` draws the block from `a` and `adoptIn` stores the handle in `alloc`, so the
// free routes through the SAME allocator — letting a ref-counted graph live in a caller-owned arena and be
// bulk-reclaimed on `reset()`, and letting `try new` answer `None` for the whole box from its one draw. Every handle
// (a `copy()`, a `downgrade()`'s `Weak`) carries a copy of the value handle `A`, so whichever handle observes
// `strong == 0 && weak == 0` frees the block through an `A` equal to the one that made it (`A` is monomorphized
// identically across the `Shared`/`Weak` family). A `Weak` that outlives the pointee keeps the whole block until it
// goes, as Rust's does. `copy()`/`downgrade()`/`tryUpgrade()` return a FRESH ctor rvalue (never a named
// local — a bare `return <local>` re-invokes `copy()` and recurses); the ctor is also how a `Weak` builds a
// `Shared` and vice versa (cross-type, so field-poke can't reach the sibling's private fields). `adopt`
// alone builds same-type by field-poke + `give` (the move avoids needing a default `A` value for the ctor).
type resource Shared<T, A: Allocator = GlobalAllocator> implements Deref<T>, DerefMut<T>, HeapOwner<T>, HeapHeader<Ctrl>, Copyable<This>(bare: copy),
                                    // A shared handle may cross an isolate boundary exactly when its payload cannot
                                    // change: then the control block takes the atomic refcount flavor and every
                                    // isolate reads the same bytes. This line IS that rule — it used to be
                                    // hand-wired in the compiler, unreadable from here.
                                    Sendable when [T: Immutable, A: Sendable] {
    UnsafePtr<T> p;
    UnsafePtr<Ctrl> c;
    A alloc;
    public unsafe ctor make(UnsafePtr<T> p, UnsafePtr<Ctrl> c, A alloc) { this.p = p; this.c = c; this.alloc = alloc; }   // shares p's counts: `c` heads p's block
    // (No serde here: a `Shared` pointee is a GRAPH NODE — it can alias and cycle — and a graph is read and
    // written by `std::serialization::graph::ObjectGraph<T>`, which is what a root is spelled as.)
    // HeapOwner: adopt a raw pointee into a box with the DEFAULT allocator (the bare-`new` path, which the compiler
    // allows only for `A == GlobalAllocator`; a custom `A` box comes through `adoptIn`). Field-poke `p`/`c` then
    // `give` the handle out — the move transfers the ref (no `copy()` retain, and unlike a ctor rvalue it needs no
    // default-`A` value to pass). `when [A: default]` default-fills `alloc`, the allocator the dtor frees through.
    // `new` drew the counts with the pointee (`HeapHeader<Ctrl>`), so this allocates nothing: it sets them.
    public unsafe ctor adopt(UnsafePtr<T> raw) when [A: default] {
        UnsafePtr<Ctrl> ctrl = cast<UnsafePtr<Ctrl>>(kama_ctrl_of(obj: cast<UnsafePtr>(raw)));
        kama_ctrl_init(c: cast<UnsafePtr>(ctrl));
        this.p = raw; this.c = ctrl;
    }
    // Placement adopt: a pointee whose block came FROM `allocator`; store the handle so the dtor releases the block
    // through it (the `new(allocator: a) T(...)` path). Allocates nothing, as `adopt` does.
    public unsafe ctor adoptIn(UnsafePtr<T> raw, A allocator) {
        UnsafePtr<Ctrl> ctrl = cast<UnsafePtr<Ctrl>>(kama_ctrl_of(obj: cast<UnsafePtr>(raw)));
        kama_ctrl_init(c: cast<UnsafePtr>(ctrl));
        return Shared.make(p: raw, c: ctrl, alloc: allocator);
    }
    public unsafe const fn const ref T deref() { return this.p[0]; }   // the read-only half (prelude `Deref`)
    public unsafe fn ref T derefMut() { return this.p[0]; }            // the writable half (`DerefMut`)
    public unsafe ctor copy(ref Shared<T, A> source) {                                   // Copyable -> retain, carry the allocator
        kama_ctrl_retain_strong(c: cast<UnsafePtr>(source.c), atomic: __kama_ctrl_atomic());
        return Shared.make(p: source.p, c: source.c, alloc: source.alloc);
    }
    public unsafe fn Weak<T, A> downgrade() {
        kama_ctrl_retain_weak(c: cast<UnsafePtr>(this.c), atomic: __kama_ctrl_atomic());
        return Weak.make(p: this.p, c: this.c, alloc: this.alloc);        // cross-type -> Weak's public ctor
    }
    unsafe ~Shared() {
        if (cast<usize>(this.c) != 0) {                           // guard a zero-initialized handle
            // release one strong ref; non-zero iff this was the LAST. The seam encapsulates both flavors:
            // the plain path marks the Ctrl DROPPING across the pointee dtor (dropping the pointee may release a
            // `Weak` back-edge into THIS Ctrl, which must not free it, and nothing may upgrade to a value being
            // dropped — kama_ctrl.h), then `finish_strong` zeroes `strong` and reports whether the Ctrl should be freed; the atomic path (deeply-immutable => acyclic)
            // fetch_subs with a release store + acquire fence. A non-last release already decremented.
            if (kama_ctrl_release_strong(c: cast<UnsafePtr>(this.c), atomic: __kama_ctrl_atomic()) != 0i32) {
                usize bytes = sizeof(ptr: this.p);                // the pointee's own layout — may be a derived
                usize align = alignof(ptr: this.p);
                drop(ptr: this.p);                                // run the pointee's dtor once
                // The block — counts and pointee — goes back whole once no `Weak` holds it; else the last `Weak` frees it.
                if (kama_ctrl_finish_strong(c: cast<UnsafePtr>(this.c), atomic: __kama_ctrl_atomic()) != 0i32) {
                    this.alloc.deallocate(pointer: kama_head_block(obj: cast<UnsafePtr>(this.p), hsize: sizeof(Ctrl), align: align),
                                          bytes: kama_head_bytes(hsize: sizeof(Ctrl), n: bytes, align: align),
                                          align: kama_head_align(halign: alignof(Ctrl), align: align));
                }
            }
        }
    }
}
