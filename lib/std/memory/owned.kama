export { Owned };

// A unique-owning heap pointer (Rust's `Box<T>`). `implements HeapOwner<T>` makes it a `new T(args)`
// target (heap placement, 0 copies); `Deref<T>` forwards `.method()`/`.field` to the pointee. Move-only:
// `Owned b = give a;`. RAII frees the heap object through its allocator.
//
// The heap block is drawn from the allocator `A` (M8 default `GlobalAllocator` → libc malloc/free, so a
// bare `Owned<T>` is unchanged). A placement `new(allocator: a) T(args)` draws the block from `a` and
// stores the handle in `alloc` (via `adoptIn`), so the dtor releases it through the SAME allocator —
// letting a boxed object live in a caller-owned arena and be bulk-reclaimed on `reset()`. The allocator
// is a copyable VALUE handle carried by value (zero-size for `GlobalAllocator`).
//
// Serde: an `Owned<T>` is a unique subtree, so on the wire it is exactly a `T` — byte-identical to a
// by-value field of that type (absence is spelled `Optional<Owned<T>>`, like every other field). The
// conformances live HERE, not in the derive: the compiler's field walk reaches them through the ordinary
// composite arm (`Owned_T__serialize`), the same way it reaches a collection's. (A collection OF `Owned`
// does not yet follow: its element helper takes `const ref T`, and a `const ref` may not name a smart
// pointer even when `T` is a type parameter — a language question recorded in ROADMAP_DETAIL §4.)
// `deserialize` reads a `T` by value and heap-moves it into a fresh block; it exists only `when [A: default]`
// because the wire carries no allocator handle (the same reason `adopt` is gated).
type resource Owned<T, A: Allocator = GlobalAllocator> implements Deref<T>, DerefMut<T>, HeapOwner<T>, Sendable when [T: Sendable, A: Sendable],
                                   Serializable when [T: Serializable],
                                   Deserializable<This> when [T: Deserializable<T>, A: default] {
    UnsafePtr<T> p;
    A alloc;
    public unsafe const fn Result<Unit, Owned<Error>> serialize(ref Serializer w) when [T: Serializable] {
        return this.deref().serialize(w: w);
    }
    public unsafe ctor Result<Owned<T, A>, Owned<Error>> deserialize(Deserializer r) when [T: Deserializable<T>, A: default] {
        Result<T, Owned<Error>> inner = T.deserialize(r: r);
        T v = match (give inner) { case Ok(value: x): { := give x; } case Err(error: e): { return Result::Err(error: give e); } };
        UnsafePtr<T> block = cast<UnsafePtr<T>>(unwrapPtr(o: GlobalAllocator.make().allocate(bytes: sizeof(T))));
        block[0] = give v;
        return Result::Ok(value: Owned.adopt(raw: block));
    }
    // HeapOwner: adopt a raw block into a box with the DEFAULT allocator (the bare-`new` path). Leaves `alloc`
    // at its default, so it EXISTS only `when [A: default]` (the completeness gate would otherwise — correctly
    // — reject a custom `A` left unassigned; a custom-`A` box comes through `adoptIn`, the placement path).
    public unsafe ctor adopt(UnsafePtr<T> raw) when [A: default] { this.p = raw; return this; }
    // Placement adopt: a raw block that came FROM `allocator`, stored so the dtor releases it through the
    // same handle (the `new(allocator: a) T(...)` path).
    public unsafe ctor adoptIn(UnsafePtr<T> raw, A allocator) { this.p = raw; this.alloc = allocator; return this; }
    // The two halves of auto-deref (prelude `Deref`/`DerefMut`): a read-only place a const handle may hand
    // out, and the writable one a mutable handle uses.
    public unsafe const fn const ref T deref() { return this.p[0]; }
    public unsafe fn ref T derefMut() { return this.p[0]; }
    // The other half of `adopt` (Rust's `Box::into_raw` to its `from_raw`): give the block up to a FOREIGN
    // owner — a host API's userdata slot — and empty this handle, so the dtor below frees nothing. That is
    // how a value outlives the frame that made it: hand it over in one `unsafe fn`, borrow through the
    // pointer in the callback via a `ref T` parameter, `adopt` it back to destroy. A custom-`A` box releases
    // the same block; the host must return it to `adoptIn` with that allocator, or free it as `A` would.
    public unsafe fn UnsafePtr<T> release() { UnsafePtr<T> raw = this.p; this.p = null; return raw; }
    // run pointee dtor, then release through the allocator — guarding a null pointer (a
    // zero-initialized/moved-from handle).
    unsafe ~Owned() { if (cast<usize>(this.p) != 0) { drop(value: this.derefMut()); this.alloc.deallocate(pointer: cast<UnsafePtr>(this.p), bytes: sizeof(T)); } }
}
