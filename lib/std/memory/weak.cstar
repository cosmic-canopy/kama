namespace std::memory;
export { Weak };

extern "<stdlib.h>";
extern fn void free(Ptr p);

// A non-owning weak handle into a `Shared<T>` family (Rust's `Weak<T>`). It holds the object alive for
// no one — `tryUpgrade()` returns `Some(Shared)` only while a strong handle still exists, else `None`.
// `Copyable, !Movable` = copy-only: a bare hand-off duplicates the weak handle (weak++); `give` errors.
// `Ctrl` and `free` come from the `shared.cstar` sibling in this module.
type resource Weak<T> implements Copyable, !Movable {
    Ptr<T> p;
    Ptr<Ctrl> c;
    public Weak(Ptr<T> p, Ptr<Ctrl> c) { this.p = p; this.c = c; }
    public fn Weak<T> copy() {                                        // Copyable -> another weak handle
        unsafe { this.c[0].weak = this.c[0].weak + 1; }
        return Weak(p: this.p, c: this.c);
    }
    public fn Optional<Shared<T>> tryUpgrade() {
        unsafe {
            if (this.c[0].strong > 0) {
                this.c[0].strong = this.c[0].strong + 1;
                return Optional::Some(value: Shared(p: this.p, c: this.c));   // fresh ctor -> no marker
            }
        }
        return Optional::None;
    }
    ~Weak() {
        unsafe {
            if (cast<usize>(this.c) != 0) {                           // guard a zero-initialized handle
                this.c[0].weak = this.c[0].weak - 1;
                if (this.c[0].strong == 0 && this.c[0].weak == 0) { free(p: cast<Ptr>(this.c)); }
            }
        }
    }
}
