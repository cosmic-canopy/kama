
import { Date, Weekday, TimeError };
export { Duration, Instant, Timestamp, monotonicNow, unixNow, sleep };

// TWO clocks, and choosing between them is the only thing this module asks of a caller:
//
//   `Instant` / `monotonicNow()` — the MONOTONIC clock. An opaque counter that never runs backward and
//     has no relation to any date. Measure a SPAN with it: a timeout, a frame time, a benchmark.
//   `Timestamp` / `unixNow()`   — the WALL clock, counted from the UNIX epoch. Stamp an EVENT with it:
//     a file's mtime, a log line, a protocol timestamp. It can jump forward OR BACKWARD at any moment
//     (NTP, a user changing the clock, a laptop waking in another time zone), so the difference of two
//     `Timestamp`s is not a reliable elapsed time — that is what `Instant` is for. Every language that
//     offers only one of these gets bug reports about the other; kama offers both and names the split.
//
// `sleep(Duration)` blocks the calling thread. The three platform primitives live in kama_time.h;
// everything here is pure kama.
extern "kama_time.h";
extern fn uint64 kama_now_mono_ns();
extern fn int64 kama_now_wall_ns();
extern fn void kama_sleep_ns(uint64 ns);

// A span of time at nanosecond resolution. A `value` (stack, copied, no alloc). Signed — the delta of two
// Instants, or a countdown, may be negative.
@generate(of)
type value Duration implements Equatable<This>, Comparable<This>, Hashable, Sendable {
    public int64 nanos;

    public ctor zero()               { return Duration.of(nanos: 0i64); }
    public ctor fromNanos(int64 n)   { return Duration.of(nanos: n); }
    public ctor fromMicros(int64 us) { return Duration.of(nanos: us * 1000i64); }
    public ctor fromMillis(int64 ms) { return Duration.of(nanos: ms * 1000000i64); }
    public ctor fromSecs(int64 s)    { return Duration.of(nanos: s * 1000000000i64); }

    public const fn int64 asNanos()      { return this.nanos; }
    public const fn int64 asMicros()     { return this.nanos / 1000i64; }
    public const fn int64 asMillis()     { return this.nanos / 1000000i64; }
    public const fn int64 asSecs()       { return this.nanos / 1000000000i64; }
    public const fn float64 asSecsF()    { return cast<float64>(this.nanos) / 1000000000.0f64; }
    public const fn bool isNegative()    { return this.nanos < 0i64; }

    public Duration operator+(Duration r) { return Duration.of(nanos: this.nanos + r.nanos); }
    public Duration operator-(Duration r) { return Duration.of(nanos: this.nanos - r.nanos); }
    public Duration operator-()           { return Duration.of(nanos: -this.nanos); }
    // `==`/`<`/`>`/`<=`/`>=` come from these two contracts; conforming also makes a Duration usable as a
    // `SortedMap`/`SortedSet` key and a `PriorityQueue` element — a timeout wheel is now expressible.
    public const fn uint64 hash() { return cast<uint64>(this.nanos); }
    public const fn bool equals(const ref Duration other) { return this.nanos == other.nanos; }
    public const fn Ordering compareTo(const ref Duration other) {
        if (this.nanos < other.nanos) { return Ordering::Less; }
        if (this.nanos > other.nanos) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

// A monotonic timestamp — an opaque counter, meaningful only relative to another Instant. A `value`.
@generate(of)
type value Instant implements Equatable<This>, Comparable<This>, Hashable, Sendable {
    public uint64 rawNanos;

    // Time elapsed from an earlier Instant to this one (non-negative when `earlier` truly precedes this).
    public const fn Duration since(Instant earlier) {
        return Duration.of(nanos: cast<int64>(this.rawNanos) - cast<int64>(earlier.rawNanos));
    }
    // Time from this Instant until now.
    public const fn Duration elapsed() { return monotonicNow().since(earlier: this); }

    public Duration operator-(Instant earlier) { return this.since(earlier: earlier); }
    public Instant operator+(Duration d)       { return Instant.of(rawNanos: this.rawNanos + cast<uint64>(d.nanos)); }
    // As for Duration: comparison is the contract, and it also makes an Instant orderable in a container
    // (a deadline queue). `<=`/`>=` now work too — the raw operators only ever covered `==`/`<`/`>`.
    public const fn uint64 hash() { return cast<uint64>(this.rawNanos); }
    public const fn bool equals(const ref Instant other) { return this.rawNanos == other.rawNanos; }
    public const fn Ordering compareTo(const ref Instant other) {
        if (this.rawNanos < other.rawNanos) { return Ordering::Less; }
        if (this.rawNanos > other.rawNanos) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

// A point on the WALL clock, as signed nanoseconds from the UNIX epoch (1970-01-01T00:00:00Z). Signed, so
// a date before 1970 is representable rather than wrapping; int64 nanoseconds reach from 1677-09-21 to 2262-04-11,
// which is the same window Go's `time.Time` monotonic range and Rust's `Duration`-from-epoch idiom cover.
//
// ⚠️ It is NOT monotonic. Two readings can come back in either order, and `durationSince` can therefore be
// negative — that is the wall clock being honest, not an error. Time a span with `Instant`.
//
// It is Postgres TIMESTAMPTZ: an INSTANT, holding no zone and no offset. It reads its UTC calendar fields
// (`date()`, `hour()`, …; `calendar.kama` has `Date`) and it is RFC 3339 text both ways — `"${t}"` prints
// `2026-09-16T14:03:07Z`, and `Timestamp.parse` applies whatever offset the text carries and keeps the
// instant, as TIMESTAMPTZ does on input. It is also the one timestamp type: there is no second, field-holding
// DateTime for the same instant (Rust has both `SystemTime` and chrono's `DateTime<Utc>`, and a program must
// pick which to store). Local time needs a zone database, which is a package, as `chrono-tz` is.
@generate(of)
type value Timestamp implements Equatable<This>, Comparable<This>, Hashable, Formattable,
                                Serializable, Deserializable<This>, Sendable {
    public int64 nanos;
    // `Date.at` builds a stamp through the same range check `parse` does.
    friend Date[fromParts];

    public ctor epoch()                    { return Timestamp.of(nanos: 0i64); }
    public ctor fromUnixNanos(int64 n)     { return Timestamp.of(nanos: n); }
    public ctor fromUnixMicros(int64 us)   { return Timestamp.of(nanos: us * 1000i64); }
    public ctor fromUnixMillis(int64 ms)   { return Timestamp.of(nanos: ms * 1000000i64); }
    public ctor fromUnixSecs(int64 s)      { return Timestamp.of(nanos: s * 1000000000i64); }

    public const fn int64 asUnixNanos()    { return this.nanos; }
    public const fn int64 asUnixMicros()   { return this.nanos / 1000i64; }
    public const fn int64 asUnixMillis()   { return this.nanos / 1000000i64; }
    public const fn int64 asUnixSecs()     { return this.nanos / 1000000000i64; }

    // Time from an earlier stamp to this one. Negative when the clock moved backward between them.
    public const fn Duration durationSince(Timestamp earlier) {
        return Duration.of(nanos: this.nanos - earlier.nanos);
    }
    public Duration operator-(Timestamp earlier)  { return this.durationSince(earlier: earlier); }
    public Timestamp operator+(Duration d)        { return Timestamp.of(nanos: this.nanos + d.nanos); }
    // As for the other two: the contracts give `==`/`<`/`>`/`<=`/`>=` and make a stamp usable as a
    // `SortedMap` key — an events-by-time index is expressible without writing a comparator.
    public const fn uint64 hash() { return cast<uint64>(this.nanos); }
    public const fn bool equals(const ref Timestamp other) { return this.nanos == other.nanos; }
    public const fn Ordering compareTo(const ref Timestamp other) {
        if (this.nanos < other.nanos) { return Ordering::Less; }
        if (this.nanos > other.nanos) { return Ordering::Greater; }
        return Ordering::Equal;
    }

    // The calendar, read in UTC. Every stamp has one: 1677-09-21 to 2262-04-11 is inside `Date`'s range.
    public const fn Date date()          { return Date.fromDays(days: this.dayNumber()); }
    public const fn Weekday weekday()    { return this.date().weekday(); }
    public const fn uint8 hour()         { return truncate<uint8>(this.nanosOfDay() / 3600000000000i64); }
    public const fn uint8 minute()       { return truncate<uint8>(this.nanosOfDay() / 60000000000i64 % 60i64); }
    public const fn uint8 second()       { return truncate<uint8>(this.nanosOfDay() / 1000000000i64 % 60i64); }
    public const fn uint32 nanosecond()  { return truncate<uint32>(this.nanosOfDay() % 1000000000i64); }

    // Days from 1970-01-01, FLOORED: division truncates toward zero, which would put 1969-12-31T23:59:59Z
    // on 1970-01-01.
    const fn int64 dayNumber() {
        int64 q = this.nanos / NANOS_PER_DAY;
        if (this.nanos % NANOS_PER_DAY < 0i64) { q = q - 1i64; }
        return q;
    }
    // Nanoseconds since this stamp's UTC midnight, always in [0, NANOS_PER_DAY). A remainder rather than
    // `nanos - day * NANOS_PER_DAY`: at the earliest stamp that product is below int64's minimum.
    const fn int64 nanosOfDay() {
        int64 rem = this.nanos % NANOS_PER_DAY;
        return rem < 0i64 ? rem + NANOS_PER_DAY : rem;
    }

    // `secs` seconds and `ns` (in [0, 1e9)) nanoseconds from the epoch, or `OutOfRange` outside int64
    // nanoseconds. `secs * 1e9 + ns` is checked BEFORE the multiply, which would overflow first.
    ctor Result<Timestamp, TimeError> fromParts(int64 secs, int64 ns) {
        if (secs >= 0i64) {
            if (secs > 9223372036i64 || (secs == 9223372036i64 && ns > 854775807i64)) { return Result::Err(error: TimeError::OutOfRange); }
            return Result::Ok(value: Timestamp.of(nanos: secs * 1000000000i64 + ns));
        }
        if (secs < -9223372037i64 || (secs == -9223372037i64 && ns < 145224192i64)) { return Result::Err(error: TimeError::OutOfRange); }
        return Result::Ok(value: Timestamp.of(nanos: (secs + 1i64) * 1000000000i64 + (ns - 1000000000i64)));
    }

    // RFC 3339 in UTC: `YYYY-MM-DDTHH:MM:SS`, then a fraction only when there is one — 3, 6 or 9 digits,
    // the fewest that are exact, so a millisecond stamp reads as one and every stamp parses back to itself
    // — then `Z`. A stamp prints in UTC whatever offset it was parsed with; it never kept one.
    public const fn void format(ref Formatter f) {
        this.date().format(f: ref f);
        f.writeStr(s: "T");
        f.writeU64Radix(v: cast<uint64>(this.hour()), radix: 10, width: 8, upper: 0, prefix: 0, pad: 2, flags: 1);
        f.writeStr(s: ":");
        f.writeU64Radix(v: cast<uint64>(this.minute()), radix: 10, width: 8, upper: 0, prefix: 0, pad: 2, flags: 1);
        f.writeStr(s: ":");
        f.writeU64Radix(v: cast<uint64>(this.second()), radix: 10, width: 8, upper: 0, prefix: 0, pad: 2, flags: 1);
        uint32 ns = this.nanosecond();
        if (ns != 0ui32) {
            f.writeStr(s: ".");
            if (ns % 1000000ui32 == 0ui32)  { f.writeU64Radix(v: cast<uint64>(ns / 1000000ui32), radix: 10, width: 32, upper: 0, prefix: 0, pad: 3, flags: 1); }
            else if (ns % 1000ui32 == 0ui32) { f.writeU64Radix(v: cast<uint64>(ns / 1000ui32), radix: 10, width: 32, upper: 0, prefix: 0, pad: 6, flags: 1); }
            else                             { f.writeU64Radix(v: cast<uint64>(ns), radix: 10, width: 32, upper: 0, prefix: 0, pad: 9, flags: 1); }
        }
        f.writeStr(s: "Z");
    }

    // On the wire it is its RFC 3339 text, on every backend: a stamp is serialized to meet a database or an
    // HTTP API, and a second, binary, form would make the bytes a program writes depend on its backend.
    public const fn Result<Unit, Owned<Error>> serialize(ref Serializer w) {
        Formatter f = Formatter.make();
        this.format(f: ref f);
        string text = f.finish();
        w.writeString(v: ref text);
        if (w.failed()) { SerError e = w.errorCode(); return Result::Err(error: e); }
        return Result::Ok(value: Unit::Unit);
    }

    public ctor Result<Timestamp, Owned<Error>> deserialize(Deserializer r) {
        string text = r.readString();
        if (r.failed()) { DeError e = r.errorCode(); return Result::Err(error: e); }
        return match (Timestamp.parse(text: text)) {
            case Ok(value: v): Result::Ok(value: v);
            case Err(error: pe): { r.failWith(e: DeError::Malformed); return Result::Err(error: DeError::Malformed); }
        };
    }

    // The RFC 3339 `date-time` and what PostgreSQL writes for a TIMESTAMPTZ — one parser, because a
    // Postgres text column and a JSON API are where a stamp comes from. `YYYY-MM-DD`, then `T` or a space
    // (RFC 3339 §5.6 allows the space; Postgres writes it), `HH:MM:SS`, an optional `.` and 1-9 fraction
    // digits, then `Z` or an offset: `±HH:MM`, or Postgres's `±HH` and `±HH:MM:SS` (seconds appear for a
    // historical local mean time — `1900-01-01 00:19:32+00:19:32` in Amsterdam, measured). `T` and `Z` may
    // be lowercase. The offset is APPLIED and dropped — the result is the instant, as TIMESTAMPTZ stores it.
    // Strict otherwise: no week or ordinal dates, no compact form, no surrounding whitespace, nothing
    // trailing. A malformed byte is `InvalidCharacter` at its offset (the length, when the text ends early);
    // a field that does not exist — Feb 30, hour 24, second 60 (POSIX time has no leap second), an offset
    // past 23:59:59 — or an instant this type cannot hold is `OutOfRange`: outside int64 nanoseconds, and
    // Postgres's `infinity`, `-infinity` and ` BC` stamps.
    public ctor Result<Timestamp, TimeError> parse(const ref string text) {
        if (text == "infinity" || text == "-infinity") { return Result::Err(error: TimeError::OutOfRange); }
        Result<Date, TimeError> dr = Date.parsePrefix(text: text);
        Date d = match (dr) { case Ok(value: v): v; case Err(error: e): { return Result::Err(error: e); } };
        isize n = text.length();
        if (n <= 10 || (text[10] != 84ui8 && text[10] != 116ui8 && text[10] != 32ui8)) { return Result::Err(error: TimeError::InvalidCharacter(at: 10)); }  // T t ' '
        Result<int64, TimeError> hr = Date::digits(text: text, at: 11, count: 2);
        int64 hh = match (hr) { case Ok(value: v): v; case Err(error: e): { return Result::Err(error: e); } };
        if (n <= 13 || text[13] != 58ui8) { return Result::Err(error: TimeError::InvalidCharacter(at: 13)); }  // ':'
        Result<int64, TimeError> mr = Date::digits(text: text, at: 14, count: 2);
        int64 mm = match (mr) { case Ok(value: v): v; case Err(error: e): { return Result::Err(error: e); } };
        if (n <= 16 || text[16] != 58ui8) { return Result::Err(error: TimeError::InvalidCharacter(at: 16)); }
        Result<int64, TimeError> sr = Date::digits(text: text, at: 17, count: 2);
        int64 ss = match (sr) { case Ok(value: v): v; case Err(error: e): { return Result::Err(error: e); } };

        isize i = 19;
        int64 ns = 0i64;
        if (i < n && text[i] == 46ui8) {                                   // '.'
            i = i + 1;
            isize first = i;
            int64 scale = 1000000000i64;
            while (i < n && text[i] >= 48ui8 && text[i] <= 57ui8) {
                if (i - first == 9) { return Result::Err(error: TimeError::InvalidCharacter(at: i)); }  // a 10th digit
                scale = scale / 10i64;
                ns = ns + cast<int64>(text[i] - 48ui8) * scale;
                i = i + 1;
            }
            if (i == first) { return Result::Err(error: TimeError::InvalidCharacter(at: i)); }
        }

        if (i >= n) { return Result::Err(error: TimeError::InvalidCharacter(at: i)); }
        int64 offset = 0i64;
        uint8 z = text[i];
        if (z == 90ui8 || z == 122ui8) {                                   // Z z
            i = i + 1;
        } else if (z == 43ui8 || z == 45ui8) {                             // + -
            Result<int64, TimeError> ohr = Date::digits(text: text, at: i + 1, count: 2);
            int64 oh = match (ohr) { case Ok(value: v): v; case Err(error: e): { return Result::Err(error: e); } };
            i = i + 3;
            int64 om = 0i64;
            int64 os = 0i64;
            if (i < n && text[i] == 58ui8) {                               // `:MM`
                Result<int64, TimeError> omr = Date::digits(text: text, at: i + 1, count: 2);
                om = match (omr) { case Ok(value: v): v; case Err(error: e): { return Result::Err(error: e); } };
                i = i + 3;
                if (i < n && text[i] == 58ui8) {                           // `:SS`
                    Result<int64, TimeError> osr = Date::digits(text: text, at: i + 1, count: 2);
                    os = match (osr) { case Ok(value: v): v; case Err(error: e): { return Result::Err(error: e); } };
                    i = i + 3;
                }
            }
            if (oh > 23i64 || om > 59i64 || os > 59i64) { return Result::Err(error: TimeError::OutOfRange); }
            offset = (oh * 60i64 + om) * 60i64 + os;
            if (z == 45ui8) { offset = -offset; }
        } else {
            return Result::Err(error: TimeError::InvalidCharacter(at: i));
        }
        if (Date::bcSuffixAt(text: text, at: i)) { return Result::Err(error: TimeError::OutOfRange); }
        if (i != n) { return Result::Err(error: TimeError::InvalidCharacter(at: i)); }

        if (hh > 23i64 || mm > 59i64 || ss > 59i64) { return Result::Err(error: TimeError::OutOfRange); }
        // Local wall time minus its offset is UTC: 16:00+02:00 is 14:00Z.
        return Timestamp.fromParts(secs: d.unixDays() * 86400i64 + hh * 3600i64 + mm * 60i64 + ss - offset, ns: ns);
    }
}

comptime int64 NANOS_PER_DAY = 86400000000000i64;

// The current monotonic instant. Never runs backward; only differences are meaningful (not a wall clock).
unsafe fn Instant monotonicNow() {
    return Instant.of(rawNanos: kama_now_mono_ns());
}

// The current wall-clock time. Read the Timestamp header above before reaching for this to time anything.
unsafe fn Timestamp unixNow() {
    return Timestamp.of(nanos: kama_now_wall_ns());
}

// Block the calling thread for AT LEAST `d` — never less, possibly more (the OS schedules the wake-up, and
// a signal that cuts the nap short is resumed rather than swallowed). A zero or negative span returns
// immediately rather than yielding, so `sleep(d: deadline - now())` past its deadline is a no-op and not a
// surprise scheduler round-trip.
//
// ⚠️ On the web target this BUSY-WAITS — wasm cannot yield to the host and resume without ASYNCIFY, which
// is a whole-program cost kama will not pay for one function (kama_time.h says the rest). Correct, but it
// burns a core and freezes a browser's main thread; on an event loop, schedule instead of sleeping.
unsafe fn void sleep(Duration d) {
    if (d.nanos <= 0i64) { return; }
    kama_sleep_ns(ns: cast<uint64>(d.nanos));
}
