
export { LogLevel, LogSink, setLogSink, logEnabled,
         logError, logWarn, logInfo, logDebug, logTrace };

// Leveled, tagged diagnostics — the configurable logger (`import std::log`). Two axes suppress a call: a
// LEVEL threshold and a per-TAG override, both reconfigurable at runtime on a shipped binary via `--log`
// (primary) or the `KAMA_LOG` env var (secondary), grammar `warn,audio=debug,net=trace`. Default level Info.
//
// A library over a small runtime seam (kama_log.h): a runtime FILTER decides, a swappable SINK outputs.
// The compiler RECOGNIZES the five facade calls below and lowers each one to a guard with the message built
// INSIDE it (the v2 lowering — `emitLogFacade`, src/kama.cemit.cpp), so a filtered-out record never assembles
// its message and no manual guard is needed per call. Under `--release` a call below the compile-time floor
// is physically absent, arguments unevaluated, like `debugAssert`. The five functions here are still compiled
// as ordinary kama — they are what the lowering is defined against, not a path call sites take.
// The default sink writes `[LEVEL] tag: msg` to
// stderr (colored on a tty). Install your own with `setLogSink` (set once at startup, before spawning
// isolates). Fatal invariants are a different concern — use `assert`/`panic` (the floor), never a log call.
// Strings cross the FFI seam as borrowed byte spans (UnsafePtr<int8> + usize), never by value — the floor `print`
// discipline — so a log call never transfers ownership of the caller's message.
extern "kama_log.h";
extern fn bool kama_log_enabled(int32 level, UnsafePtr<int8> tag, usize tagLen);
extern fn void kama_log_dispatch(int32 level, UnsafePtr<int8> tag, usize tagLen, UnsafePtr<int8> msg, usize msgLen);
extern fn void kama_set_log_sink(LogSink s);

// Ordered by severity: Error is the most severe, Trace the most verbose. The ordinals ARE the filter scale
// (a call at level L prints when L <= the configured threshold), so their order is load-bearing.
type enum LogLevel { Error, Warn, Info, Debug, Trace }

// A custom sink: `fn void mySink(int32 level, string tag, string msg) { … }` then `setLogSink(s: mySink)`.
// `level` is the LogLevel ordinal (0 = Error .. 4 = Trace — see `levelBits`); a plain int32, not the enum, so
// the fnptr type has no forward-reference into the (later-emitted) enum. The filter runs upstream (in the
// facade), so a sink only ever sees enabled records.
// `@foreignEntry`: the sink is registered once and then called from whichever isolate logs, which is not
// the one that installed it. A module `static` the sink reads is that isolate's own copy, so sink state
// belongs in the record or behind an `Atomic`, never in a static the setup code assigned.
@foreignEntry fnptr void LogSink(int32 level, string tag, string msg);

fn int32 levelBits(LogLevel lv) {
    return match (lv) {
        case Error: 0i32;
        case Warn:  1i32;
        case Info:  2i32;
        case Debug: 3i32;
        case Trace: 4i32;
    };
}

unsafe fn void setLogSink(LogSink s) { kama_set_log_sink(s: s); }

// Guards a whole BLOCK: `if (logEnabled(level: LogLevel::Debug, tag: "audio")) { prepareDump(); logDebug(…) }`
// skips setup work that exists only to build the record. A single call needs no guard — the lowering inserts
// one. Reads `tag` by borrow (like `print`), never forwards it by value.
unsafe fn bool logEnabled(LogLevel level, string tag) {
    return kama_log_enabled(level: levelBits(lv: level), tag: tag.cstr(), tagLen: cast<usize>(tag.length()));
}

// The facade body. Reached only if something calls a level function through a value rather than as a plain
// statement — the lowering intercepts every ordinary call site before it gets here, so this is the definition
// the recognizer is written against, and the fallback. `tag` may be "" (untagged); a caller arriving HERE has
// already built the message, which is exactly the cost the lowering exists to avoid. The enabled-check is
// inlined against the extern (rather than calling `logEnabled`) so the owned `tag`/`msg` params are only ever
// read by borrow — a kama->kama by-value forward would transfer ownership.
unsafe fn void logAt(int32 level, const ref string tag, const ref string msg) {
    if (kama_log_enabled(level: level, tag: tag.cstr(), tagLen: cast<usize>(tag.length()))) {
        kama_log_dispatch(level: level, tag: tag.cstr(), tagLen: cast<usize>(tag.length()),
                          msg: msg.cstr(), msgLen: cast<usize>(msg.length()));
    }
}

fn void logError(string tag, string msg) { logAt(level: 0i32, tag: ref tag, msg: ref msg); }
fn void logWarn (string tag, string msg) { logAt(level: 1i32, tag: ref tag, msg: ref msg); }
fn void logInfo (string tag, string msg) { logAt(level: 2i32, tag: ref tag, msg: ref msg); }
fn void logDebug(string tag, string msg) { logAt(level: 3i32, tag: ref tag, msg: ref msg); }
fn void logTrace(string tag, string msg) { logAt(level: 4i32, tag: ref tag, msg: ref msg); }
