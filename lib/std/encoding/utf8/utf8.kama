import { std::collections::ConstView, std::collections::DynamicArray };
export { decode, decodeLossy, validate, Utf8Error };

// UTF-8 — bytes to text, CHECKED. The one direction that needs code: a `string` IS UTF-8 bytes, so the
// encode direction is `s.bytes()` (a borrow, free) and this module deliberately does not offer a second
// spelling of it. That asymmetry is the point rather than an omission — `base64` and `hex` have an
// `encode` because they compute one; here there is nothing to compute.
//
// ⚠️ THIS CLOSES A HOLE, it is not only an ergonomic addition. `string`'s UTF-8 invariant is what
// `.chars()` assumes and what `substring` traps to preserve, and the runtime argues it holds because
// "every other string operation preserves it by construction". That argument had a gap: `std::io::readAll`
// builds a `string` out of arbitrary reader bytes, so a file of `\xff\xfe\x80hello` became an 8-byte
// `string` whose `.chars()` yielded 5 bogus codepoints (measured, 0.9.431). `readAll`, `StringWriter.finish`
// and `bytesToString` all route through `decode` now, so the safe surface has no way in.
//
// Validation is FULL, not a byte scan. A lead byte in a continuation position, a truncated tail, an
// OVERLONG encoding (the classic `\xC0\x80` NUL smuggle), a UTF-16 surrogate (U+D800..DFFF is not a
// scalar value) and anything above U+10FFFF are each refused — the five ways RFC 3629 narrowed UTF-8.
// Skipping any of them is how a "validator" becomes a security bug.
//
// Erroring rather than repairing is the same choice Rust (`String::from_utf8` -> `Result`) and Python
// (`bytes.decode` raises) make, and kama already made it by claiming the invariant. The lossy U+FFFD
// variant is `decodeLossy`, a separate NAMED function (KR-169) — asked for by name, because substituting a
// replacement character corrupts data and kama has no stderr warning channel to say it happened.

// The runtime string constructor and the validator — an `extern` is a reference to a C symbol,
// redeclared per module with the one signature every declaration in the program must share
// (tools/check-extern-rung.sh).
extern fn string kama_string_from_raw(UnsafeConstPtr<uint8> src, isize start, isize len);
extern fn isize  kama_utf8_bad_offset(UnsafeConstPtr<uint8> src, isize start, isize len);

@nonExhaustive
type enum Utf8Error implements Error {
    // The byte offset where the first ill-formed sequence BEGINS — Rust's `Utf8Error::valid_up_to`.
    // A caller reporting a bad file wants to say where, not just that.
    Invalid(isize at);

    public const fn string message() {
        return match (this) {
            case Invalid(at: a): "invalid UTF-8 at byte ${a}";
        };
    }
}

// Is this run of bytes well-formed UTF-8? Total, allocates nothing, and is what `decode` asks first.
// A caller that only needs the verdict (a content sniffer, a validator at a boundary) should use this
// rather than decoding and dropping the result.
unsafe fn bool validate(ConstView<uint8> bytes) {
    if (bytes.isEmpty()) { return true; }                    // vacuously; and `dataPtr` on empty is not read
    return kama_utf8_bad_offset(src: bytes.dataPtr(), start: 0, len: bytes.length()) < 0;
}

// The bytes as an owned `string`, or where they stopped being UTF-8.
//
// NOT `@compileFor(!NOHEAP)`, unlike `base64::decode` and `hex::decode` beside it, and the difference is
// that this one has a STDLIB consumer: `std::fs::readText` calls it, and a declaration-level gate is
// refused at the IMPORT, so gating it made every `--no-heap` program that touches `std::fs` fail to
// build (caught by tests/noheap_flag_fs.d). It allocates exactly as `std::io::readAll` and
// `std::fs::readFile` do, and like them it is refused at the USE by the no-heap walk — which is the
// stdlib's convention for an allocating function something else builds on. `validate` allocates nothing
// and is available everywhere.
unsafe fn Result<string, Utf8Error> decode(ConstView<uint8> bytes) {
    if (bytes.isEmpty()) { return Result::Ok(value: ""); }   // empty in, empty out — nothing to copy
    isize bad = kama_utf8_bad_offset(src: bytes.dataPtr(), start: 0, len: bytes.length());
    if (bad >= 0) { return Result::Err(error: Utf8Error::Invalid(at: bad)); }
    return Result::Ok(value: kama_string_from_raw(src: bytes.dataPtr(), start: 0, len: bytes.length()));
}

// The bytes as text, every ill-formed sequence replaced by U+FFFD (KR-169): for text shown to a PERSON — a log line,
// a file name, a terminal — never for data that is read back, which `decode` refuses to corrupt. One replacement per
// MAXIMAL SUBPART, the Unicode §3.9 practice WHATWG's decoder and Rust's `from_utf8_lossy` follow: the longest
// prefix of a well-formed sequence that was cut short is one U+FFFD, and every other bad byte is one. So `ED A0 80`
// (an encoded surrogate, which no well-formed sequence starts that way) is three, and `F0 9F 98` (a four-byte
// sequence missing its last byte) is one. `kama_utf8_bad_offset` says only where bad bytes start, not how many
// belong to one subpart, so the walk is here, over the same bounds it checks.
unsafe fn string decodeLossy(ConstView<uint8> bytes) {
    if (bytes.isEmpty()) { return ""; }
    isize n = bytes.length();
    if (kama_utf8_bad_offset(src: bytes.dataPtr(), start: 0, len: n) < 0) {
        return kama_string_from_raw(src: bytes.dataPtr(), start: 0, len: n);   // already text: nothing to replace
    }
    DynamicArray<uint8> text = DynamicArray.withCapacity(capacity: n + 8);
    isize i = 0;
    while (i < n) {
        uint8 b = bytes[i];
        if (b < 128ui8) { text.add(item: b); i = i + 1; continue; }
        // How many continuation bytes this lead takes, and the range its FIRST one must fall in — the table in
        // Unicode §3.9 (Table 3-7), which is what rules out overlongs (E0, F0), surrogates (ED) and > U+10FFFF (F4).
        isize need = 0; uint8 lo = 128ui8; uint8 hi = 191ui8;
        if (b >= 194ui8 && b <= 223ui8)                                   { need = 1; }
        else if (b == 224ui8)                                             { need = 2; lo = 160ui8; }
        else if ((b >= 225ui8 && b <= 236ui8) || b == 238ui8 || b == 239ui8) { need = 2; }
        else if (b == 237ui8)                                             { need = 2; hi = 159ui8; }
        else if (b == 240ui8)                                             { need = 3; lo = 144ui8; }
        else if (b >= 241ui8 && b <= 243ui8)                              { need = 3; }
        else if (b == 244ui8)                                             { need = 3; hi = 143ui8; }
        isize j = i + 1; isize got = 0;
        while (got < need && j < n) {
            uint8 c = bytes[j];
            uint8 l = got == 0 ? lo : 128ui8;
            uint8 h = got == 0 ? hi : 191ui8;
            if (c < l || c > h) { break; }
            j = j + 1; got = got + 1;
        }
        if (need > 0 && got == need) {                                   // a whole scalar: as it was
            isize k = i;
            while (k < j) { text.add(item: bytes[k]); k = k + 1; }
        } else {                                                         // one maximal subpart: one U+FFFD
            text.add(item: 239ui8); text.add(item: 191ui8); text.add(item: 189ui8);
        }
        i = j;   // past the subpart (a lead no sequence starts with is a subpart of one byte)
    }
    return kama_string_from_raw(src: text.view().dataPtr(), start: 0, len: text.length());
}
