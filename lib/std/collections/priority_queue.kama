import { DynamicArray, ConstView };
export { PriorityQueue, PopOrder };

// Which element a `PriorityQueue` hands out first (KR-366): the SMALLEST — the fit for cost and time priorities, A* by
// f-score, Dijkstra, event and timer scheduling — or the LARGEST. It names what `pop` returns rather than the heap's
// shape, so a reader of `PriorityQueue.empty(order: PopOrder::SmallestFirst)` needs no "min-heap" to know.
@generate(Serializable, Deserializable)
type enum PopOrder implements Sendable { SmallestFirst, LargestFirst }

// A binary-heap priority queue over a growable array (= C++ `std::priority_queue` / Rust `BinaryHeap` /
// Java `PriorityQueue`). Orders its `Comparable` element so `peek`/`pop` reach the extreme in O(log n);
// `push` is O(log n), `length`/`peek` O(1). Move-only by default (it owns the backing `DynamicArray`) and
// deep-copies exactly when its element is `Copyable`.
//
// The heap is stored as a complete binary tree flattened into the array: `data[0]` is the root, and node
// `i`'s children are `2i+1` / `2i+2` (its parent is `(i-1)/2`). The invariant is that every parent sits
// "higher" than its children — `push` bubbles a new leaf UP and `pop` sinks the moved-in root DOWN to
// restore it.
//
// **Direction is stated at construction, every time.** Every constructor takes a required `order: PopOrder`, and
// there is no default one: an empty list has nothing to choose, but a queue built the wrong way round pops in the
// wrong order without an error. A type holding a queue sets its order in its own constructor. One implementation,
// one type; the order flips every comparison. A heap's stored order is not the order it hands elements out, so it
// isn't `Iterable`; drain it with repeated `pop`, or read the stored order through `view()`.
type resource PriorityQueue<T: Comparable<T>, A: Allocator = GlobalAllocator> implements Copyable<This>(bare: give) when [T: Copyable<T>],
                                                                                  Sendable when [T: Sendable, A: Sendable],
                                                                                  Viewable<ConstView<T>>,
                                                                                  Serializable when [T: Serializable],
                                                                                  Deserializable<This> when [T: Deserializable<T>, A: default],
                                                                                  Formattable when [T: Formattable] {
    DynamicArray<T, A> data;   // the heap-ordered backing store (data[0] = root)
    PopOrder popOrder;         // set by every constructor

    // The four constructors every collection has, each with the order (KR-366). The first two return the enclosing
    // instance's own `A`; for a non-default `A`, `withAllocator` supplies the allocator (`empty` would leave a custom
    // `A`'s handle uninitialized). Capacity presizing rides the backing `DynamicArray`, as C++'s, Java's and Rust's
    // queues take a reserve size.
    public ctor empty(PopOrder order) when [A: default] { this.popOrder = order; }
    public ctor withCapacity(PopOrder order, isize capacity) when [A: default] {
        this.data = DynamicArray.withCapacity(capacity: capacity);
        this.popOrder = order;
    }
    // Back the heap's array with a caller-owned allocator (e.g. an `Arena`). All allocation rides the embedded
    // `DynamicArray<T, A>`.
    public ctor withAllocator(PopOrder order, A allocator) {
        this.data = DynamicArray.withAllocator(allocator: allocator);   // drops the empty default-built data (cap=0)
        this.popOrder = order;
    }
    public ctor withCapacityAndAllocator(PopOrder order, A allocator, isize capacity) {
        this.data = DynamicArray.withCapacityAndAllocator(allocator: allocator, capacity: capacity);
        this.popOrder = order;
    }

    // `${q}` writes its elements `[a, b]` in heap order — the order it holds them in, not the order it hands them
    // out (Rust's `BinaryHeap` and Python's `heapq` print the same) (KR-216).
    public const fn void format(ref Formatter f) when [T: Formattable] { this.data.format(f: ref f); }

    public const fn isize length() { return this.data.length(); }
    public const fn bool isEmpty() { return this.data.length() == 0; }

    // The backing array, read-only and in stored order (Rust's `as_slice`, C#'s `UnorderedItems`): what a state hash
    // folds and an inspector lists without draining the queue. It is the heap's order, not the pop order, and it is
    // what `serialize` writes, so two queues that hash alike serialize alike. Valid only until the next `push`/`pop`.
    public const fn ConstView<T> view() { return this.data.view(); }
    // Which end comes out first. With `view()` it is the whole of a queue's state (Java's `comparator()`, C#'s `Comparer`).
    public const fn PopOrder order() { return this.popOrder; }

    // True iff `a` belongs ABOVE `b` in the heap (nearer the root): when the smallest comes out first the smaller element,
    // when the largest does the larger. Equal elements never displace each other. Both operands are borrowed `ref T` so the
    // receiver is a nameable ref that resolves `compareTo` for a primitive's adapter conformance AND a user element (like
    // `DynamicArray.indexOf`'s `equals`); a raw `data[i]` isn't a nameable receiver.
    const fn bool higher(const ref T a, const ref T b) {
        Ordering o = a.compareTo(other: b);
        return match (o) {
            case Less:    this.popOrder == PopOrder::SmallestFirst;   // a < b sits higher when the smallest comes out first
            case Greater: this.popOrder == PopOrder::LargestFirst;    // a > b sits higher when the largest does
            case Equal:   false;
        };
    }

    // Insert `item` (consumes it): append as a new leaf, then bubble it up while it outranks its parent.
    public fn void push(T item) {
        this.data.add(item: give item);
        this.siftUp(i: this.data.length() - 1);
    }

    // Bubble the node at `i` toward the root while it outranks its parent (restores the invariant after a push).
    fn void siftUp(isize i) {
        while (i > 0) {
            isize parent = (i - 1) / 2;
            if (!this.higher(a: this.data[i], b: this.data[parent])) { return; }   // in place — done
            this.data.swap(i: i, j: parent);
            i = parent;
        }
    }

    // Remove and return the root (the min or max), moved OUT; `None` when empty. Swap the root with the last
    // leaf, pop that leaf (now the old root) OUT, then sink the new root down to restore the heap.
    public fn Optional<T> pop() {
        isize n = this.data.length();
        if (n == 0) { return Optional::None; }
        if (n == 1) { return this.data.pop(); }   // sole element — pop it, nothing to restore
        this.data.swap(i: 0, j: n - 1);           // move the root to the end
        Optional<T> top = this.data.pop();        // reclaim the old root (moved OUT of the array)
        this.siftDown(i: 0);                      // sink the leaf now at the root back into place
        return top;
    }

    // Sink the node at `i` toward the leaves while a child outranks it (restores the invariant after a pop).
    fn void siftDown(isize i) {
        isize n = this.data.length();
        while (true) {
            isize l = 2 * i + 1;
            isize r = 2 * i + 2;
            isize top = i;
            if (l < n && this.higher(a: this.data[l], b: this.data[top])) { top = l; }
            if (r < n && this.higher(a: this.data[r], b: this.data[top])) { top = r; }
            if (top == i) { return; }             // parent already outranks both children — done
            this.data.swap(i: i, j: top);
            i = top;
        }
    }

    // Look at the root WITHOUT removing it — a copy (present only for a Copyable element), the value analogue
    // of `pop`. For a move-only element borrow it instead via `peekRef`.
    public const fn Optional<T> peek() when [T: Copyable<T>] {
        if (this.data.length() == 0) { return Optional::None; }
        return Optional::Some(value: copy this.data[0]);
    }

    // Borrow the root IN PLACE (any element, no Copyable bound). PANICS when empty (guard with `isEmpty` /
    // `length`), like `DynamicArray`'s `operator[]` out of bounds — the in-place read accessor for a heap of
    // move-only elements. The returned `ref T` may not escape and dangles across a `push`/`pop` that relocates.
    @trackCaller   // a miss names the caller's line (KR-179)
    public const fn const ref T peekRef() {
        if (this.data.length() == 0) { panic(msg: "PriorityQueue.peekRef: empty"); }
        return this.data[0];
    }
    @trackCaller
    public fn ref T peekRefMut() {   // the writable twin — mutate the root in place (its priority must not change)
        if (this.data.length() == 0) { panic(msg: "PriorityQueue.peekRefMut: empty"); }
        return this.data[0];
    }

    // Drop every element and reset to empty (keeps the backing buffer for reuse).
    public fn void clear() { this.data.clear(); }

    // --- Serialization (present only when the element is Serializable/Deserializable) ---
    // The heap as it is stored, beside its direction: `{"order":"SmallestFirst","items":[1,3,2]}`. The direction is on the wire
    // because the array cannot carry it: a largest-first queue written as a bare array would read back smallest-first and pop in
    // the wrong order without a word (Java writes its comparator for the same reason; Rust and C++ hold it in the
    // type). `items` is the backing array in stored order, so a round trip is exact and a loaded queue hashes, pops and
    // ties as the saved one did.
    public const fn Result<Unit, Owned<Error>> serialize(ref Serializer w) when [T: Serializable] {
        w.beginObject(count: 2ui64);
        w.field(name: "order", id: 0ui32);
        Result<Unit, Owned<Error>> __so = this.popOrder.serialize(w: w);
        match (give __so) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
        w.field(name: "items", id: 1ui32);
        Result<Unit, Owned<Error>> __si = this.data.serialize(w: w);
        match (give __si) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
        w.endObject();
        return Result::Ok(value: Unit::Unit);
    }
    // Read back as written, and refused unless `items` is a heap in that direction: an element that outranks its parent
    // is `Malformed` at `items[i]`, never repaired (Rust and Java re-heapify). A repaired heap is a different queue from
    // the one saved — another stored order, so another `view()` hash, and among equal elements another pop order — and
    // the likely cause, an element whose `compareTo` changed since the write, wants saying, as SlotMap refuses a free
    // list that is wrong. GlobalAllocator-only, like the other collections' `deserialize`.
    public ctor Result<PriorityQueue<T, A>, Owned<Error>> deserialize(Deserializer r) when [T: Deserializable<T>, A: default] {
        r.beginObject(count: 2ui64);
        if (r.failed()) { return Result::Err(error: DeError.of(kind: r.errorKind())); }   // not an object at all: say so, never an empty `Ok`
        bool __f1 = r.moreFields(); FieldKey __n1 = r.field();
        Result<PopOrder, Owned<Error>> __oi = PopOrder.deserialize(r: r);
        match (give __oi) {
            case Err(error: e): { return Result::Err(error: DeError::inField(error: give e, name: "order")); }
            case Ok(value: o):  { this.popOrder = o; }
        };
        bool __f2 = r.moreFields(); FieldKey __n2 = r.field();
        Result<DynamicArray<T, A>, Owned<Error>> __ei = DynamicArray::<T, A>.deserialize(r: r);   // bind — a match needs a named enum subject
        match (give __ei) {
            case Err(error: e): { return Result::Err(error: DeError::inField(error: give e, name: "items")); }
            case Ok(value: v):  { this.data = give v; }
        };
        bool __f3 = r.moreFields(); r.endObject();
        if (r.failed()) { return Result::Err(error: DeError.of(kind: r.errorKind())); }
        isize i = 1;
        while (i < this.data.length()) {
            if (this.higher(a: this.data[i], b: this.data[(i - 1) / 2])) {
                return Result::Err(error: DeError.at(kind: DeErrorKind::Malformed, field: "items[${i}]"));
            }
            i = i + 1;
        }
        return Result::Ok(value: give this);
    }

    // Deep-copy the whole queue (present only for a Copyable element): the backing array is cloned element by
    // element and the order carried over, so the heap invariant is preserved without re-heapifying.
    public ctor copy(ref PriorityQueue<T, A> source) when [T: Copyable<T>] {
        this.data = copy source.data;   // DynamicArray.copy carries the allocator handle over — same arena
        this.popOrder = source.popOrder;
    }
}
