import std::collections::{SortedMap, DynamicArray};
export { SortedSet };

// An ordered set over `K: Comparable` — a thin wrapper on `SortedMap<K, Unit>` (the value is the zero-size
// `Unit`), exactly as `Set` wraps `Map<K, Unit>`. Members iterate in ascending order and it answers the same
// ordered queries as the map (`first`/`last`/`floor`/`ceil`/`range`) that a hash `Set` can't. Move-only: it
// owns the backing map (and thus every key); lookups borrow the key.
type resource SortedSet<K: Comparable<K>, A: Allocator = GlobalAllocator> implements Copyable<This>(bare: give) when [K: Copyable<K>],
        Serialize when [K: Serialize, K: Copyable<K>], Deserialize<This> when [K: Deserialize<K>] {
    SortedMap<K, Unit, A> m;

    // A bare `SortedSet<K, A> r;` default-fills the inner `m` (`SortedMap.empty()` — a non-zero default that
    // builds a live B-tree root, via the M8d.1 fill); the completeness gate proves it's initialized.
    public default ctor empty() when [A: default] { }   // M8c/M8d.0: default-alloc only (custom `A` → withAllocator)

    // Back the set with a caller-owned allocator (e.g. an `Arena`) — forwards to the inner map's factory.
    public ctor withAllocator(A allocator) {
        this.m = SortedMap.withAllocator(allocator: allocator);   // drops the empty default-built inner map
    }

    public fn void add(K key) { this.m.put(key: give key, value: Unit::Unit); }   // idempotent (put overwrites)
    public const fn bool contains(const ref K key) { return this.m.contains(key: key); }
    // `SortedMap.remove` returns the removed value (`Optional<Unit>` here); a set reports presence as a bool.
    public fn bool remove(ref K key) {
        Optional<Unit> hit = this.m.remove(key: key);
        return match (hit) { case Some(value: u): true; case None: false; };
    }
    public const fn isize length() { return this.m.length(); }
    public const fn bool isEmpty() { return this.m.isEmpty(); }
    public fn void clear() { this.m.clear(); }

    // Ordered queries + iteration forward to the backing map's key views.
    public fn Optional<K> first() when [K: Copyable<K>] { return this.m.first(); }
    public fn Optional<K> last() when [K: Copyable<K>] { return this.m.last(); }
    public fn Optional<K> floor(ref K key) when [K: Copyable<K>] { return this.m.floor(key: key); }
    public fn Optional<K> ceil(ref K key) when [K: Copyable<K>] { return this.m.ceil(key: key); }
    // `foreach (K k in set.elements())` — ascending members (key copies).
    public fn DynamicArray<K> elements() when [K: Copyable<K>] { return this.m.keys(); }
    public fn DynamicArray<K> range(ref K from, ref K to) when [K: Copyable<K>] { return this.m.range(from: from, to: to); }
    public ctor copy(ref SortedSet<K, A> source) when [K: Copyable<K>] { this.m = copy source.m; }

    // Serialize as a JSON array of the members in ascending order (Serialize needs a Copyable key — the key
    // view yields copies); deserialize just `add`s each key back.
    const fn Result<Unit, Owned<Error>> serElem(const ref K k, ref Serializer w) when [K: Serialize] { return k.serialize(w: w); }
    public const fn Result<Unit, Owned<Error>> serialize(ref Serializer w) when [K: Serialize, K: Copyable<K>] {
        DynamicArray<K> es = this.m.keys();
        w.beginArray(count: cast<usize>(es.length()));
        isize i = 0;
        while (i < es.length()) {
            Result<Unit, Owned<Error>> __sr = this.serElem(k: es[i], w: w);
            match (give __sr) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
            i = i + 1;
        }
        w.endArray();
        return Result::Ok(value: Unit::Unit);
    }
    public ctor Result<SortedSet<K>, Owned<Error>> deserialize(Deserializer r) when [K: Deserialize<K>] {
        r.beginArray();
        while (r.moreElems()) {
            Result<K, Owned<Error>> __er = K.deserialize(r: r);   // bind — a match needs a named enum subject
            match (give __er) {                                     // consume: destructure-move the owning element out
                case Err(error: e): { return Result::Err(error: give e); }
                case Ok(value: v):  { this.add(key: give v); }
            };
        }
        return Result::Ok(value: give this);
    }
}
