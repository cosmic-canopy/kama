import { std::memory::AllocError, SortedMap, SortedMapKeyIter, SortedSetDrain, Drainable, CapacityFull, Entry, EntryParts };
export { SortedSet };

// An ordered set over `K: Comparable` — a thin wrapper on `SortedMap<K, Unit>` (the value is the zero-size
// `Unit`), exactly as `Set` wraps `Map<K, Unit>`. Members iterate in ascending order and it answers the same
// ordered queries as the map (`first`/`last`/`floor`/`ceil`/`range`) that a hash `Set` can't. Move-only: it
// owns the backing map (and thus every key); lookups borrow the key.
type resource SortedSet<K: Comparable<K>, A: Allocator = GlobalAllocator> implements Copyable<This>(bare: give) when [K: Copyable<K>],
        Iterable<K> when [K: Copyable<K>], Drainable<SortedSetDrain<K, Unit, A>>,
        Serializable when [K: Serializable, K: Copyable<K>], Deserializable<This> when [K: Deserializable<K>, A: default],
        Sendable when [K: Sendable, A: Sendable], Formattable when [K: Formattable, K: Copyable<K>] {
    SortedMap<K, Unit, A> m;

    // A bare `SortedSet<K, A> r;` default-fills the inner `m` (`SortedMap.empty()` — a non-zero default that
    // builds a live B-tree root, via the M8d.1 fill); the completeness gate proves it's initialized.
    public default ctor empty() when [A: default] { }   // M8c/M8d.0: default-alloc only (custom `A` → withAllocator)

    // Back the set with a caller-owned allocator (e.g. an `Arena`) — forwards to the inner map's factory.
    public ctor withAllocator(A allocator) {
        this.m = SortedMap.withAllocator(allocator: allocator);   // drops the empty default-built inner map
    }
    // Pre-sized for `capacity` members: the inner map's matching ctor reserves the boxes they can need.
    public ctor withCapacity(isize capacity) when [A: default] {
        SortedMap<K, Unit, A> inner = SortedMap.withCapacity(capacity: capacity);
        this.m = give inner;
    }
    public ctor withCapacityAndAllocator(A allocator, isize capacity) {
        SortedMap<K, Unit, A> inner = SortedMap.withCapacityAndAllocator(allocator: allocator, capacity: capacity);
        this.m = give inner;
    }

    public fn void add(K key) { this.m.put(key: give key, value: Unit::Unit); }   // idempotent (put overwrites)
    public fn void reserve(isize n) { this.m.reserve(n: n); }   // room for `n` members in all, as the map's
    // The pair (KR-423), as `Set`'s: `reserve` answering `AllocError` instead of trapping, and an add that draws nothing,
    // handing the key back in `Err(Item(key))` when the boxes it needs are not spare. A present key needs no room.
    public fn Result<Unit, AllocError> tryReserve(isize n) { return this.m.tryReserve(n: n); }
    public fn Result<Unit, CapacityFull<K>> addWithinCapacity(K key) {
        Result<Unit, CapacityFull<Entry<K, Unit>>> r = this.m.putWithinCapacity(key: give key, value: Unit::Unit);
        return match (give r) {
            case Ok(value: _): Result::Ok(value: Unit::Unit);
            case Err(error: e): SortedSet::<K, A>::keyBack(e: give e);
        };
    }
    static fn Result<Unit, CapacityFull<K>> keyBack(CapacityFull<Entry<K, Unit>> e) {
        return match (give e) { case Item(item: entry): SortedSet::<K, A>::keyOf(entry: give entry); };
    }
    static fn Result<Unit, CapacityFull<K>> keyOf(Entry<K, Unit> entry) {
        return match (give entry.intoParts()) { case Parts(key: k, value: _): Result::Err(error: CapacityFull::Item(item: give k)); };
    }
    public const fn bool contains(const ref K key) { return this.m.contains(key: key); }
    // `SortedMap.remove` returns the removed value (`Optional<Unit>` here); a set reports presence as a bool.
    public fn bool remove(const ref K key) {
        Optional<Unit> hit = this.m.remove(key: key);
        return match (hit) { case Some(value: u): true; case None: false; };
    }
    // `${s}` writes `{a, b}` in key order (KR-216). Like `serialize`, it needs a `Copyable` key (the key view copies).
    public const fn void format(ref Formatter f) when [K: Formattable, K: Copyable<K>] {
        f.writeStr(s: "{");
        bool first = true;
        foreach (K k in this.m) {
            if (!first) { f.writeStr(s: ", "); }
            first = false;
            k.format(f: ref f);
        }
        f.writeStr(s: "}");
    }

    public const fn isize length() { return this.m.length(); }
    public const fn bool isEmpty() { return this.m.isEmpty(); }
    public fn void clear() { this.m.clear(); }
    // `foreach (K k in s.drain())` — every member moved out smallest first, the set empty after the loop however it ends
    // (KR-263): the map's drain, yielding each key.
    public unsafe fn SortedSetDrain<K, Unit, A> drain() { return SortedSetDrain::<K, Unit, A>.over(m: addr(of: this.m)); }

    // Ordered queries + iteration forward to the backing map's.
    public const fn Optional<K> first() when [K: Copyable<K>] { return this.m.first(); }
    public const fn Optional<K> last() when [K: Copyable<K>] { return this.m.last(); }
    public const fn Optional<K> floor(const ref K key) when [K: Copyable<K>] { return this.m.floor(key: key); }
    public const fn Optional<K> ceil(const ref K key) when [K: Copyable<K>] { return this.m.ceil(key: key); }
    // `foreach (K k in s)` — the members ascending, each a copy, as `Set` lists; `range` the members in [from, to).
    public const fn SortedMapKeyIter<K, Unit, A> iterator() when [K: Copyable<K>] { return this.m.iterator(); }
    public const fn SortedMapKeyIter<K, Unit, A> range(const ref K from, const ref K to) when [K: Copyable<K>] { return this.m.range(from: from, to: to); }
    public ctor copy(ref SortedSet<K, A> source) when [K: Copyable<K>] { this.m = copy source.m; }

    // Serializable as a JSON array of the members in ascending order (Serializable needs a Copyable key — the key
    // view yields copies); deserialize just `add`s each key back.
    public const fn Result<Unit, Owned<Error>> serialize(ref Serializer w) when [K: Serializable, K: Copyable<K>] {
        w.beginArray(count: cast<usize>(this.m.length()));
        foreach (K k in this.m) {
            Result<Unit, Owned<Error>> __sr = k.serialize(w: w);
            match (give __sr) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
        }
        w.endArray();
        return Result::Ok(value: Unit::Unit);
    }
    public ctor Result<SortedSet<K, A>, Owned<Error>> deserialize(Deserializer r) when [K: Deserializable<K>, A: default] {
        r.beginArray();
        if (r.failed()) { return Result::Err(error: DeError.make(kind: r.errorKind())); }   // not an array/object at all: say so, never an empty `Ok`
        isize index = 0;   // the element's place on the wire — a failure inside it is reported there
        while (r.moreElems()) {
            Result<K, Owned<Error>> __er = K.deserialize(r: r);   // bind — a match needs a named enum subject
            match (give __er) {                                     // consume: destructure-move the owning element out
                case Err(error: e): { return Result::Err(error: DeError::inElement(error: give e, index: index)); }
                case Ok(value: v):  { this.add(key: give v); }
            };
            index = index + 1;
        }
        return Result::Ok(value: give this);
    }
}
