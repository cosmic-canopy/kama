namespace std::collections;
export { View };

// A by-value iterator (the `foreach (T x in view)` protocol): yields each element by value. A view is a
// FIXED borrow, so — unlike the growable containers — there is no `mods` counter to snapshot (nothing
// structural can change under it; the borrowed buffer's owner is responsible for not resizing while a
// view is live). Mirrors `FixedArrayIter`.
type value ViewIter<T> implements Iterator<T> {
    Ptr<T> data; int32 pos; int32 len;
    public ctor make(Ptr<T> data, int32 len) { slot ViewIter<T> r; r.data = data; r.pos = 0; r.len = len; return give r; }
    public fn Optional<T> next() {
        if (this.pos >= this.len) { return Optional::None; }
        int32 p = this.pos; this.pos = this.pos + 1;
        unsafe { return Optional::Some(value: copy this.data[p]); }   // yield a COPY (the view owns nothing)
    }
}

// A mutable iterator (the `foreach (ref T x in view)` protocol): hasNext() + a place-returning next().
type value ViewIterMut<T> implements IteratorMut<T> {
    Ptr<T> data; int32 pos; int32 len;
    public ctor make(Ptr<T> data, int32 len) { slot ViewIterMut<T> r; r.data = data; r.pos = 0; r.len = len; return give r; }
    public fn bool hasNext() { return this.pos < this.len; }
    public fn ref T next() { int32 p = this.pos; this.pos = this.pos + 1; unsafe { return this.data[p]; } }
}

// A non-owning, stack-only borrow of a contiguous run of `T` — a slice / span (= C++ `std::span`, Rust
// `&[T]`, C# `Span<T>`). It holds a raw `Ptr<T>` it BORROWS plus a length; it owns nothing and has no
// destructor. The `type view` kind makes it a *second-class borrow*: the escape checker forbids a
// `View<T>` from being a field, a collection element, or a return that outlives its buffer — so it can
// never dangle without a borrow checker. Get one from a container's `.view()` / `.slice(...)`; read-only
// intent is expressed at call sites with a `const View<T>` parameter. Mutating through `operator[]` /
// `iterMut()` writes back to the borrowed buffer (the view IS the buffer, windowed).
type view View<T> implements IterableMut<T>, Iterable<T> when [T: Copyable] {
    Ptr<T> data; int32 len;

    public ctor make(Ptr<T> data, int32 len) { slot View<T> r; r.data = data; r.len = len; return give r; }

    public fn int32 length() { return this.len; }
    public fn bool  isEmpty() { return this.len == 0; }

    public ref T operator[](int32 i) {
        if (i < 0 || i >= this.len) { panic(msg: "View index out of bounds"); }
        unsafe { return this.data[i]; }
    }

    // The by-value `foreach (T x in view)` yields COPIES, so it exists only for a Copyable element.
    // (Move-only elements borrow instead: `foreach (ref T x in view)`.)
    public fn ViewIter<T>    iterator() when [T: Copyable] { return ViewIter::<T>.make(data: this.data, len: this.len); }
    public fn ViewIterMut<T> iterMut() { return ViewIterMut::<T>.make(data: this.data, len: this.len); }

    // A sub-view `[from, from+count)` of this view — bounds-checked, zero copy. Returning it borrows
    // `this` (the view), which itself borrows the underlying buffer, so it's escape-safe.
    public fn View<T> slice(int32 from, int32 count) {
        if (from < 0 || count < 0 || from + count > this.len) { panic(msg: "View.slice out of bounds"); }
        if (count == 0) { return View::<T>.make(data: this.data, len: 0); }
        unsafe { return View::<T>.make(data: addr(of: this.data[from]), len: count); }
    }
}
