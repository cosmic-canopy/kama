namespace std::collections;
import std::ptr::{relocate};
export { Map, Entry, MapKeyIter, MapValueIter, MapValueIterMut, MapEntryIter };

// Buffers are drawn from the map's `A alloc` (an `Allocator` handle), not libc directly. `allocate`
// returns UNINITIALIZED bytes, so the `state` tag buffer is zeroed with `memset` after allocation
// (a bump allocator also hands back dirty reused memory, so container-side zeroing is the correct place).
extern "<string.h>";
extern fn Ptr memset(Ptr p, int32 value, usize n);

// The primitive `Hashable`/`Equatable` conformances (`string`, `int32`) now live in the PRELUDE
// (kama.driver.cpp `PRELUDE_SRC`) so they're universal — a `<T: Equatable>` bound or `DynamicArray<int32>.contains`
// resolves without importing `std::collections`. They stay pure-kama retro-impls (no compiler blessing).

// A by-value iterator over a map's KEYS (the `foreach (K k in map)` protocol; `Set` hands out the same).
// It borrows the map's key + state buffers, walks only FULL slots, and yields each key BY VALUE (a copy),
// so it exists only for a `Copyable` key. Like `DynamicArrayIter` it snapshots the map's mutation counter and
// rejects a structural change (a `put`/`remove` that could rehash) made mid-iteration.
type value MapKeyIter<K> implements Iterator<K> {
    Ptr<K> keys; Ptr<uint8> state; int32 cap; int32 pos; Ptr<int32> modsp; int32 modsAt;
    public ctor make(Ptr<K> keys, Ptr<uint8> state, int32 cap, Ptr<int32> modsp, int32 modsAt) {
        this.keys = keys; this.state = state; this.cap = cap; this.pos = 0; this.modsp = modsp; this.modsAt = modsAt;
    }
    // Deep-copy a key through a typed `ref K` borrow — a bare `copy this.keys[p]` on the raw buffer can't
    // (its element class is unknown, so the `copy` marker is dropped and it aliases). Same trick as `get`.
    fn K cloneKey(ref K k) { return copy k; }
    public fn Optional<K> next() {
        unsafe { if (this.modsp[0] != this.modsAt) { panic(msg: "Map modified during iteration"); } }
        while (this.pos < this.cap) {
            int32 p = this.pos; this.pos = this.pos + 1;
            uint8 s = 0ui8; unsafe { s = this.state[p]; }
            if (s == 1ui8) { unsafe { return Optional::Some(value: this.cloneKey(k: this.keys[p])); } }
        }
        return Optional::None;
    }
}

// A by-value iterator over a map's VALUES (`foreach (V v in map.values())`), present only for a Copyable
// value. Like `MapKeyIter` it borrows the value + state buffers, walks only FULL slots, yields each value BY
// VALUE (a copy), and rejects a structural change made mid-iteration via the `mods` snapshot.
type value MapValueIter<V> implements Iterator<V> {
    Ptr<V> vals; Ptr<uint8> state; int32 cap; int32 pos; Ptr<int32> modsp; int32 modsAt;
    public ctor make(Ptr<V> vals, Ptr<uint8> state, int32 cap, Ptr<int32> modsp, int32 modsAt) {
        this.vals = vals; this.state = state; this.cap = cap; this.pos = 0; this.modsp = modsp; this.modsAt = modsAt;
    }
    // Deep-copy a value through a typed `ref V` borrow — see `Map.cloneVal` for why a raw-buffer `copy` aliases.
    fn V cloneVal(ref V v) { return copy v; }
    public fn Optional<V> next() {
        unsafe { if (this.modsp[0] != this.modsAt) { panic(msg: "Map modified during iteration"); } }
        while (this.pos < this.cap) {
            int32 p = this.pos; this.pos = this.pos + 1;
            uint8 s = 0ui8; unsafe { s = this.state[p]; }
            if (s == 1ui8) { unsafe { return Optional::Some(value: this.cloneVal(v: this.vals[p])); } }
        }
        return Optional::None;
    }
}

// A mutable iterator over a map's VALUES (`foreach (ref V v in map.valuesMut())`), for ANY value type — the
// borrow accessor that lets a Map of move-only values be walked + mutated in place. `hasNext()` advances to
// the next FULL slot (idempotent) and runs the mid-iteration invalidation check; `next()` hands out the
// `ref V` at that slot. Same borrow safety as `DynamicArrayIterMut` (the ref may not escape; a structural
// change is caught).
type value MapValueIterMut<V> implements IteratorMut<V> {
    Ptr<V> vals; Ptr<uint8> state; int32 cap; int32 pos; Ptr<int32> modsp; int32 modsAt;
    public ctor make(Ptr<V> vals, Ptr<uint8> state, int32 cap, Ptr<int32> modsp, int32 modsAt) {
        this.vals = vals; this.state = state; this.cap = cap; this.pos = 0; this.modsp = modsp; this.modsAt = modsAt;
    }
    public fn bool hasNext() {
        unsafe { if (this.modsp[0] != this.modsAt) { panic(msg: "Map modified during iteration"); } }
        while (this.pos < this.cap) {
            uint8 s = 0ui8; unsafe { s = this.state[this.pos]; }
            if (s == 1ui8) { return true; }            // stop AT the full slot (idempotent — next() consumes it)
            this.pos = this.pos + 1;
        }
        return false;
    }
    public fn ref V next() { int32 p = this.pos; this.pos = this.pos + 1; unsafe { return this.vals[p]; } }
}

// A key-value pair yielded by entry iteration. The map has no tuple type, so this is the named pair the
// `foreach (Entry<K,V> e in map.entries())` protocol hands out — `e.key()` / `e.value()`. It OWNS both (an owned
// copy read out of the map slot), so it outlives the map and drops them at end of life — hence `type resource`
// (a `type value` may own nothing, but K/V can be owning like `string`). Keys are never mutated in place (that
// would corrupt the hash table), so there is no `ref`-yielding entry iterator — mutate values through
// `valuesMut()` / `getRef` instead. The ctor `give`s both fields in (a no-op move for a plain value K/V).
type resource Entry<K, V> {
    K k; V v;   // private (a `resource` exposes behavior through methods); read via key()/value()
    public ctor make(K key, V value) { this.k = give key; this.v = give value; }
    public fn ref K key() { return this.k; }       // borrow the key  (never moved out — the pair owns it)
    public fn ref V value() { return this.v; }      // borrow the value
}

// A by-value iterator over a map's ENTRIES (`foreach (Entry<K,V> e in map.entries())`), present only when
// BOTH key and value are Copyable — the pair analogue of `MapKeyIter`/`MapValueIter`. It borrows the key +
// value + state buffers, walks only FULL slots, yields each pair BY VALUE (a deep copy of both), and rejects
// a structural change made mid-iteration via the `mods` snapshot.
type value MapEntryIter<K, V> implements Iterator<Entry<K,V>> {
    Ptr<K> keys; Ptr<V> vals; Ptr<uint8> state; int32 cap; int32 pos; Ptr<int32> modsp; int32 modsAt;
    public ctor make(Ptr<K> keys, Ptr<V> vals, Ptr<uint8> state, int32 cap, Ptr<int32> modsp, int32 modsAt) {
        this.keys = keys; this.vals = vals; this.state = state; this.cap = cap; this.pos = 0;
        this.modsp = modsp; this.modsAt = modsAt;
    }
    // Deep-copy key/value through typed `ref` borrows — a raw-buffer `copy this.keys[p]` drops the `copy`
    // marker and aliases (unknown element class), so route through `ref K`/`ref V` (see `Map.cloneVal`).
    fn K cloneKey(ref K k) { return copy k; }
    fn V cloneVal(ref V v) { return copy v; }
    public fn Optional<Entry<K,V>> next() {
        unsafe { if (this.modsp[0] != this.modsAt) { panic(msg: "Map modified during iteration"); } }
        while (this.pos < this.cap) {
            int32 p = this.pos; this.pos = this.pos + 1;
            uint8 s = 0ui8; unsafe { s = this.state[p]; }
            if (s == 1ui8) {
                unsafe { return Optional::Some(value: Entry.make(key: this.cloneKey(k: this.keys[p]),
                                                                 value: this.cloneVal(v: this.vals[p]))); }
            }
        }
        return Optional::None;
    }
}

// A general open-addressing hash map over `K: Hashable + Equatable` -> `V`. Linear probing with
// tombstones; grows (and sheds tombstones) at a 0.75 load factor. Capacity is always a power of two
// (0, then 8·2^k — see `grow`), so the slot index is `hash & (cap-1)`, not `hash % cap` (no division).
// Move-only by default: it owns three
// parallel heap buffers (keys, values, per-slot state) and every live key/value, dropping them at end of
// life.
//
//   state[i]: 0 = EMPTY (never used), 1 = FULL (a live entry), 2 = TOMB (removed — probe past it).
//
// Keys are hashed/compared by content, so a lookup key built any way finds the stored entry. Lookups
// borrow the key (`ref K`); `put` consumes the key + value it stores (by value). `foreach (K k in m)`
// iterates the keys, and `copy m` deep-copies — each present only when its keys (and, for `copy`, values)
// are `Copyable` (multi-`when`). `entries()` yields each `Entry<K,V>` key-value pair by value.
type resource Map<K: Hashable + Equatable, V, H: Hasher = DefaultHasher, A: Allocator = GlobalAllocator>
        implements Copyable(bare: give) when [K: Copyable, V: Copyable], Iterable<K> when [K: Copyable],
                   Serialize when [K: Serialize, V: Serialize], Deserialize when [K: Deserialize, V: Deserialize] {
    Ptr<K> keys = null; Ptr<V> vals = null; Ptr<uint8> state = null;
    int32 len = 0; int32 cap = 0; int32 tombs = 0; int32 mods = 0; A alloc;

    // The bare map draws from the default `GlobalAllocator` (a zero-size field — no state, no cost). A
    // custom-allocator map is built by `withAllocator`, which sets `alloc` after construction (Kama has
    // no ctor overloading; `alloc` is a plain value, so the bare ctor need not set it).
    // The four-ctor matrix (M8c). `empty`/`withCapacity` are the default-allocator conveniences, gated
    // `when [A: default]` (M8d.0) so they don't exist for a custom `A` without a `default` (which would
    // otherwise build a zero-allocator, incomplete map). Custom `A` uses the allocator-taking ctors below.
    // A bare `Map<K,V,H,A> r;` zero-inits the primitive/`Ptr` fields and default-fills `alloc`; the M8d.1
    // completeness gate proves it's fully initialized.
    public default ctor empty() when [A: default] { }

    // Empty, but pre-sized so `capacity` entries fit without a rehash. Returns the enclosing `Map<K,V,H,A>`.
    public ctor withCapacity(int32 capacity) when [A: default] { this.reserve(n: capacity); }

    // Build an empty map whose three buffers are drawn from `allocator` (e.g. an `Arena` bump handle),
    // so all of this map's allocations route into that region. The handle is a cheap copyable value.
    public ctor withAllocator(A allocator) {
        this.alloc = allocator;
    }

    // Caller-owned allocator AND pre-sized for `capacity` — `alloc` set before `reserve` (rehash allocates
    // through `this.alloc`).
    public ctor withCapacityAndAllocator(A allocator, int32 capacity) {
        this.alloc = allocator;
        this.reserve(n: capacity);
    }

    public fn int32 length() { return this.len; }

    // `foreach (K k in map)` — a by-value key iterator (present only for a `Copyable` key). It borrows the
    // key + state buffers and a live pointer to `mods` so a mid-iteration structural change is caught.
    public fn MapKeyIter<K> iterator() when [K: Copyable] {
        return MapKeyIter::<K>.make(keys: this.keys, state: this.state, cap: this.cap,
                               modsp: addr(of: this.mods), modsAt: this.mods);
    }

    // Key hashing/equality go through these `ref K` helpers so the receiver is always a plain borrow the
    // contract dispatch resolves — for a `string` OR user key (a class receiver) and for a PRIMITIVE key
    // (`int32`, whose `hash`/`equals` are scalar-receiver retro impls). A raw-buffer element `this.keys[i]`
    // is handed in by `ref`, never used as a receiver directly.
    // `k.hash()` is the CHEAP CONTENT hash (identity for an int, FNV for a string); the pluggable
    // `H::finish` avalanches it before it is masked to a slot. `H` defaults to `DefaultHasher`
    // (splitmix64) so `Map<K,V>` is unchanged; `Map<K,V,FastHasher>` swaps in a cheaper mixer. The
    // static call resolves per monomorphization (like `K::deserialize`) — no stored hasher instance.
    fn uint64 hashKey(ref K k) { return H::finish(raw: k.hash()); }
    fn bool eqKeys(ref K a, ref K b) { return a.equals(other: b); }

    // The slot an entry lives in (or would): probe from hash(key) until the key is found (returns its
    // FULL slot) or an EMPTY slot ends the run (returns -1). Tombstones are probed past, never stop it.
    fn int32 slotOf(ref K key) {
        if (this.cap == 0) { return 0 - 1; }
        int32 i = cast<int32>(this.hashKey(k: key) & cast<uint64>(this.cap - 1));   // cap is a power of two -> mask == % cap
        while (true) {
            uint8 s = 0ui8; unsafe { s = this.state[i]; }
            if (s == 0ui8) { return 0 - 1; }                                  // EMPTY — not present
            if (s == 1ui8) { unsafe { if (this.eqKeys(a: this.keys[i], b: key)) { return i; } } }
            i = i + 1; if (i >= this.cap) { i = 0; }
        }
        return 0 - 1;
    }

    public fn bool contains(ref K key) { return this.slotOf(key: key) >= 0; }

    // Deep-copy a stored value through a typed `ref V` borrow. `copy this.vals[i]` directly can't deep-copy
    // an owning element: `this.vals` is a raw `Ptr<V>`, whose index has no known element class, so the `copy`
    // marker is dropped and it aliases (a use-after-free once both are dropped). Routing through a `ref V`
    // param gives the emitter the concrete `V`, so `copy v` emits the real element `__copy`.
    fn V cloneVal(ref V v) when [V: Copyable] { return copy v; }
    fn K cloneKey(ref K k) when [K: Copyable] { return copy k; }   // same trick for an owning key

    // Deep-copy the whole map (present only when BOTH key and value are `Copyable`): a fresh map with an
    // independent clone of every live entry. `bare: give` — a plain hand-off still MOVES.
    public ctor copy(ref Map<K,V,H,A> source) when [K: Copyable, V: Copyable] {
        this.alloc = source.alloc;                  // copy the allocator handle (a value) — same arena
        int32 i = 0;
        while (i < source.cap) {
            uint8 s = 0ui8; unsafe { s = source.state[i]; }
            if (s == 1ui8) {
                unsafe { this.put(key: source.cloneKey(k: source.keys[i]), value: source.cloneVal(v: source.vals[i])); }
            }
            i = i + 1;
        }
        return this;
    }

    public fn Optional<V> get(ref K key) when [V: Copyable] {
        int32 i = this.slotOf(key: key);
        if (i < 0) { return Optional::None; }
        unsafe { return Optional::Some(value: this.cloneVal(v: this.vals[i])); }   // hand back a copy; map keeps its own
    }

    // Borrow the stored value for `key` IN PLACE (any V, no Copyable bound) — the read/mutate accessor that
    // makes a Map of move-only values (`Owned`/`Shared`/a collection) first-class instead of write-only. A map
    // lookup is PARTIAL, so this PANICS on an absent key (guard with `contains` first), like `operator[]` panics
    // out of bounds — hence the explicit `getRef` name, not `operator[]` (which would hide the can-fail nature).
    // The returned `ref V` may not escape and dangles if held across a `put` that rehashes — the same borrow
    // boundary as an array `ref` held across `add`→realloc (the deliberate no-borrow-checker tradeoff).
    public fn ref V getRef(ref K key) {
        int32 i = this.slotOf(key: key);
        if (i < 0) { panic(msg: "Map.getRef: absent key"); }
        unsafe { return this.vals[i]; }
    }

    // `foreach (V v in map.values())` — a by-value value iterator (present only for a Copyable value), the
    // value analogue of `iterator()`. `valuesMut()` borrows instead, for any value type.
    public fn MapValueIter<V> values() when [V: Copyable] {
        return MapValueIter::<V>.make(vals: this.vals, state: this.state, cap: this.cap,
                                      modsp: addr(of: this.mods), modsAt: this.mods);
    }
    public fn MapValueIterMut<V> valuesMut() {
        return MapValueIterMut::<V>.make(vals: this.vals, state: this.state, cap: this.cap,
                                         modsp: addr(of: this.mods), modsAt: this.mods);
    }

    // `foreach (Entry<K,V> e in map.entries())` — a by-value key-value pair iterator, present only when BOTH
    // key and value are Copyable (it hands out an owned copy of each pair). The pair analogue of `iterator()`
    // (keys) and `values()`. Keys are never mutated in place, so there is no `entriesMut()`; mutate values via
    // `valuesMut()` / `getRef`.
    public fn MapEntryIter<K,V> entries() when [K: Copyable, V: Copyable] {
        return MapEntryIter::<K,V>.make(keys: this.keys, vals: this.vals, state: this.state, cap: this.cap,
                                        modsp: addr(of: this.mods), modsAt: this.mods);
    }

    // Insert or overwrite. Consumes both `key` and `value` (owns what it stores). On overwrite the
    // existing key stays, so the incoming key and the old value are dropped. The probe loop only LOCATES
    // the slot; the moves (`give`) happen after it, since `give` inside a loop is rejected (it could
    // re-move on a later iteration — here the loop can't, but the check is conservative).
    public fn void put(K key, V value) {
        if ((this.len + this.tombs + 1) * 4 >= this.cap * 3) { this.grow(); }
        int32 i = cast<int32>(this.hashKey(k: key) & cast<uint64>(this.cap - 1));   // cap is a power of two -> mask == % cap
        int32 chosen = 0 - 1;                                                   // the chosen slot (set = loop done)
        int32 free = 0 - 1;                                                   // first tomb we may reuse
        bool overwrite = false;
        while (chosen < 0) {
            uint8 s = 0ui8; unsafe { s = this.state[i]; }
            if (s == 0ui8) { chosen = free >= 0 ? free : i; }                  // EMPTY — key is new
            else if (s == 2ui8) { if (free < 0) { free = i; } }              // TOMB — remember, keep probing
            else { unsafe { if (this.eqKeys(a: this.keys[i], b: key)) { chosen = i; overwrite = true; } } }
            if (chosen < 0) { i = i + 1; if (i >= this.cap) { i = 0; } }
        }
        if (overwrite) {                                                     // replace the stored (equal) key + value
            unsafe {
                drop(value: this.keys[chosen]); drop(value: this.vals[chosen]);
                this.keys[chosen] = give key; this.vals[chosen] = give value;
            }
            this.mods = this.mods + 1;
        } else {
            if (free >= 0) { this.tombs = this.tombs - 1; }                   // reclaiming a tombstone
            unsafe { this.keys[chosen] = give key; this.vals[chosen] = give value; this.state[chosen] = 1ui8; }
            this.len = this.len + 1; this.mods = this.mods + 1;
        }
    }

    // Remove the entry for `key`, returning its VALUE moved OUT (`None` when absent). The key is dropped and
    // the slot becomes a tombstone so other keys' probe runs stay intact. Discard the result to just delete —
    // the returned `Optional<V>` drops the value cleanly (a move-out-then-drop, ASan-clean). Reclaiming the
    // value (`match`) hands the caller its ownership, so a Map of move-only values is fully symmetric.
    public fn Optional<V> remove(ref K key) {
        int32 i = this.slotOf(key: key);
        if (i < 0) { return Optional::None; }
        unsafe { drop(value: this.keys[i]); }         // key dropped (lookup `key` is a borrow, not stored)
        V v = this.takeVal(at: i);                  // value relocated OUT (the slot is now stale)
        unsafe { this.state[i] = 2ui8; }              // tombstone so the stale slot is never dropped again
        this.len = this.len - 1; this.tombs = this.tombs + 1; this.mods = this.mods + 1;
        return Optional::Some(value: give v);
    }

    // Move the value at `slot` OUT of the buffer into a fresh owned local. A direct `V v = this.vals[slot]` is
    // rejected (giving out of an element leaves a moved-from owner); instead relocate bitwise through raw
    // `Ptr<V>` aliases into a zero-init'd local, then `give`. The caller tombstones the stale slot so it's
    // never dropped again — the same move-out idiom as `Deque.takeAt`.
    fn V takeVal(int32 at) {
        slot V x;                                          // the hole `relocate`'s `out` parameter fills
        relocate(from: this.vals, at: at, into: out x);
        return give x;
    }

    public fn void clear() {
        int32 i = 0;
        while (i < this.cap) {
            unsafe { if (this.state[i] == 1ui8) { drop(value: this.keys[i]); drop(value: this.vals[i]); }
                     this.state[i] = 0ui8; }
            i = i + 1;
        }
        this.len = 0; this.tombs = 0; this.mods = this.mods + 1;
    }

    // Preallocate so at least `n` entries fit without a rehash (a no-op if already big enough). A known-size
    // build skips the incremental grow-from-8 rehash storm. `nc` is the smallest power of two whose 0.75 load
    // threshold clears `n` (`n*4/3` slots), never below 8 and never a shrink.
    public fn void reserve(int32 n) {
        if (n <= 0) { return; }
        int32 need = n * 4 / 3 + 1;                 // slots to keep the load under 0.75 for n entries
        int32 nc = 8;
        while (nc < need) { nc = nc * 2; }          // round up to a power of two (mask-indexing invariant)
        if (nc > this.cap) { this.growTo(nc: nc); }
    }


    // Grow to the next capacity (doubling) and re-home the live entries — see `growTo`.
    fn void grow() { this.growTo(nc: this.cap == 0 ? 8 : this.cap * 2); }

    // Re-home the live entries into fresh `nc`-slot buffers (which sheds all tombstones). Each entry is
    // RELOCATED bitwise into the fresh buffers — a move, not a copy or a drop — then the old buffers are
    // freed raw (no per-slot dtor: ownership already left them). Mirrors `DynamicArray`'s realloc relocation.
    // `nc` must be a power of two ≥ the live count (callers: `grow` doubles, `reserve` rounds up).
    fn void growTo(int32 nc) {
        slot Ptr<K> nk; slot Ptr<V> nv; slot Ptr<uint8> ns;
        unsafe {
            nk = cast<Ptr<K>>(unwrapPtr(o: this.alloc.allocate(bytes: cast<usize>(nc) * sizeof(K))));
            nv = cast<Ptr<V>>(unwrapPtr(o: this.alloc.allocate(bytes: cast<usize>(nc) * sizeof(V))));
            ns = cast<Ptr<uint8>>(unwrapPtr(o: this.alloc.allocate(bytes: cast<usize>(nc) * sizeof(uint8))));
            memset(p: cast<Ptr>(ns), value: 0, n: cast<usize>(nc) * sizeof(uint8));   // tag buffer starts all-EMPTY
        }
        int32 i = 0;
        while (i < this.cap) {
            uint8 s = 0ui8; unsafe { s = this.state[i]; }
            if (s == 1ui8) {
                int32 j = 0;
                unsafe {
                    j = cast<int32>(this.hashKey(k: this.keys[i]) & cast<uint64>(nc - 1));   // nc is a power of two
                    while (ns[j] == 1ui8) { j = j + 1; if (j >= nc) { j = 0; } }
                    nk[j] = this.keys[i]; nv[j] = this.vals[i]; ns[j] = 1ui8;   // bitwise relocate (no drop)
                }
            }
            i = i + 1;
        }
        if (this.cap > 0) {
            unsafe {
                this.alloc.deallocate(pointer: cast<Ptr>(this.keys),  bytes: cast<usize>(this.cap) * sizeof(K));
                this.alloc.deallocate(pointer: cast<Ptr>(this.vals),  bytes: cast<usize>(this.cap) * sizeof(V));
                this.alloc.deallocate(pointer: cast<Ptr>(this.state), bytes: cast<usize>(this.cap) * sizeof(uint8));
            }
        }
        this.keys = nk; this.vals = nv; this.state = ns; this.cap = nc; this.tombs = 0;
    }

    // --- Serialization (present only when BOTH key and value are Serialize/Deserialize) ---
    // A generic `Map<K,V>` can't emit a JSON object (`fieldName` needs a `string`, `K` is generic), so it
    // serializes as an ARRAY of `{"key":k,"value":v}` objects. Key/value go through a `ref K`/`ref V` helper
    // (like `cloneKey`/`cloneVal`) so a primitive element's retro-impl `serialize` resolves.
    fn Result<Unit, Owned<Error>> serKey(ref K k, ref Serializer w) when [K: Serialize] { return k.serialize(w: w); }
    fn Result<Unit, Owned<Error>> serVal(ref V v, ref Serializer w) when [V: Serialize] { return v.serialize(w: w); }
    public fn Result<Unit, Owned<Error>> serialize(ref Serializer w) when [K: Serialize, V: Serialize] {
        w.beginArray(count: cast<usize>(this.len));
        int32 i = 0;
        while (i < this.cap) {
            uint8 s = 0ui8; unsafe { s = this.state[i]; }
            if (s == 1ui8) {
                w.beginObject();
                w.fieldName(name: "key");
                unsafe {
                    Result<Unit, Owned<Error>> __sk = this.serKey(k: this.keys[i], w: w);
                    match (give __sk) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
                }
                w.fieldName(name: "value");
                unsafe {
                    Result<Unit, Owned<Error>> __sv = this.serVal(v: this.vals[i], w: w);
                    match (give __sv) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
                }
                w.endObject();
            }
            i = i + 1;
        }
        w.endArray();
        return Result::Ok(value: Unit::Unit);
    }
    // Reconstruct from the pair array: each entry is `{"key":k,"value":v}` (key before value on the wire),
    // read positionally — `moreFields()` consumes the object structure (commas + closing brace).
    public ctor Result<Map<K,V,H>, Owned<Error>> deserialize(Deserializer r) when [K: Deserialize, V: Deserialize] {
        r.beginArray();
        while (r.moreElems()) {
            r.beginObject();
            bool __f1 = r.moreFields(); string __n1 = r.fieldName();
            Result<K, Owned<Error>> __ek = K.deserialize(r: r);   // read both at top level (a nested generic
            K k = match (give __ek) { case Ok(value: kv): { := give kv; } case Err(error: e): { return Result::Err(error: give e); } };
            bool __f2 = r.moreFields(); string __n2 = r.fieldName();
            Result<V, Owned<Error>> __ev = V.deserialize(r: r);   // static call must not sit inside a match arm)
            V v = match (give __ev) { case Ok(value: vv): { := give vv; } case Err(error: e): { return Result::Err(error: give e); } };
            bool __f3 = r.moreFields();   // consumes the closing `}`
            this.put(key: give k, value: give v);
        }
        return Result::Ok(value: give this);
    }

    ~Map() {   // drop each live key + value, then free the three buffers
        int32 i = 0;
        while (i < this.cap) {
            unsafe { if (this.state[i] == 1ui8) { drop(value: this.keys[i]); drop(value: this.vals[i]); } }
            i = i + 1;
        }
        if (this.cap > 0) {
            unsafe {
                this.alloc.deallocate(pointer: cast<Ptr>(this.keys),  bytes: cast<usize>(this.cap) * sizeof(K));
                this.alloc.deallocate(pointer: cast<Ptr>(this.vals),  bytes: cast<usize>(this.cap) * sizeof(V));
                this.alloc.deallocate(pointer: cast<Ptr>(this.state), bytes: cast<usize>(this.cap) * sizeof(uint8));
            }
        }
    }
}
