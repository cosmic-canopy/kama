import std::ptr::{relocate};
export { Deque, DequeIter, DequeIterMut };

// A by-value iterator (the `foreach (T x in deque)` protocol): yields each element by value, front to back.
// Like the DynamicArray iterator it snapshots the deque's mutation counter and rejects a structural change
// made mid-iteration (a push may have reallocated + re-homed the buffer, so a cursor would dangle). The
// logical position `pos` maps to the physical slot `(head + pos) % cap` — the ring wraps.
type view DequeIter<T: Copyable<T>> implements Iterator<T> {
    UnsafePtr<T> data; isize head; isize cap; isize pos; isize len; UnsafePtr<uint32> modsp; uint32 modsAt;
    unsafe ctor make(UnsafePtr<T> data, isize head, isize cap, isize len, UnsafePtr<uint32> modsp, uint32 modsAt) {
        this.data = data; this.head = head; this.cap = cap; this.pos = 0; this.len = len;
        this.modsp = modsp; this.modsAt = modsAt;
    }
    public unsafe fn Optional<T> next() {
        if (this.modsp[0] != this.modsAt) { panic(msg: "Deque modified during iteration"); }
        if (this.pos >= this.len) { return Optional::None; }
        isize idx = (this.head + this.pos) % this.cap; this.pos = this.pos + 1;
        return Optional::Some(value: copy this.data[idx]);   // yield a COPY (the deque keeps its element)
    }
}

// A mutable iterator (the `foreach (ref T x in deque)` protocol): hasNext() + a place-returning next().
type view DequeIterMut<T> implements IteratorMut<T> {
    UnsafePtr<T> data; isize head; isize cap; isize pos; isize len; UnsafePtr<uint32> modsp; uint32 modsAt;
    unsafe ctor make(UnsafePtr<T> data, isize head, isize cap, isize len, UnsafePtr<uint32> modsp, uint32 modsAt) {
        this.data = data; this.head = head; this.cap = cap; this.pos = 0; this.len = len;
        this.modsp = modsp; this.modsAt = modsAt;
    }
    public unsafe const fn bool hasNext() {
        if (this.modsp[0] != this.modsAt) { panic(msg: "Deque modified during iteration"); }
        return this.pos < this.len;
    }
    public unsafe fn ref T next() {
        isize idx = (this.head + this.pos) % this.cap; this.pos = this.pos + 1;
        return this.data[idx];
    }
}

// A double-ended queue backed by a growable ring buffer (= C++ `std::deque` / Rust `VecDeque`): O(1)
// amortized push/pop at BOTH ends, contiguous storage, no per-element node. Move-only by default (it owns a
// buffer); Copyable EXACTLY when its element is (a deep, element-by-element copy). `head` is the physical
// slot of the front element; the `len` live elements occupy `data[(head + i) % cap]` for i in 0..len, so the
// window wraps around the end of the buffer. `mods` is a modification counter iterators snapshot.
type resource Deque<T, A: Allocator = GlobalAllocator> implements Copyable<This>(bare: give) when [T: Copyable<T>], IterableMut<T>, Iterable<T> when [T: Copyable<T>],
                            Serialize when [T: Serialize], Deserialize<This> when [T: Deserialize<T>] {
    UnsafePtr<T> data = null; isize head = 0; isize len = 0; isize cap = 0; uint32 mods = 0; A alloc;

    // The four-ctor matrix (M8c) — see DynamicArray. `empty()` is the `default` zero-arg build; `empty`/
    // `withCapacity` are default-allocator conveniences (custom `A` uses the allocator-taking ctors).
    public default ctor empty() when [A: default] { }
    public ctor withCapacity(isize capacity) when [A: default] { this.reserve(n: capacity); }

    // Draw the ring buffer from a caller-owned allocator (e.g. an `Arena`). The bare `Deque()` uses the
    // default zero-size `GlobalAllocator`; this sets the handle before any grow. See DynamicArray.withAllocator.
    public ctor withAllocator(A allocator) {
        this.alloc = allocator;
    }

    // Caller-owned allocator AND pre-grown for `capacity` — `alloc` set before `reserve`.
    public ctor withCapacityAndAllocator(A allocator, isize capacity) {
        this.alloc = allocator;
        this.reserve(n: capacity);
    }

    // Relinearize into a fresh `nc`-slot buffer: the wrapped window becomes a flat 0..len run at the front.
    // Element relocation goes through LOCAL pointer aliases (`nd[i] = od[…]` is a raw bitwise move that
    // leaves no owner holding a moved-from slot), the same technique DynamicArray.remove uses.
    unsafe fn void growTo(isize nc) {
        UnsafePtr<T> nd = null;
        nd = cast<UnsafePtr<T>>(unwrapPtr(o: this.alloc.allocate(bytes: cast<usize>(nc) * sizeof(T))));
        UnsafePtr<T> od = this.data;
        isize i = 0;
        while (i < this.len) { nd[i] = od[(this.head + i) % this.cap]; i = i + 1; }
        if (this.cap > 0) {
            this.alloc.deallocate(pointer: cast<UnsafePtr>(this.data), bytes: cast<usize>(this.cap) * sizeof(T));
        }
        this.data = nd; this.head = 0; this.cap = nc;
        // The buffer MOVED, so every live iterator's pointer is now stale — a structural change even
        // when `len` did not move. `reserve()` reaches here without going through `add`/`put`, which is
        // how a realloc used to happen with the counter untouched (finding 7).
        this.mods = this.mods + 1;
    }
    fn void ensureOne() { if (this.len == this.cap) { this.growTo(nc: this.cap == 0 ? 4 : this.cap * 2); } }

    // Append at the back — the common enqueue.
    public unsafe fn void pushBack(T item) {
        this.ensureOne();
        isize idx = (this.head + this.len) % this.cap;
        this.data[idx] = give item;   // relocate the element into the fresh slot (raw move)
        this.len = this.len + 1;
        this.mods = this.mods + 1;
    }
    // Prepend at the front — step `head` back one (wrapping) and drop the element in.
    public unsafe fn void pushFront(T item) {
        this.ensureOne();
        this.head = (this.head + this.cap - 1) % this.cap;
        this.data[this.head] = give item;
        this.len = this.len + 1;
        this.mods = this.mods + 1;
    }

    // Move the element at physical slot `idx` OUT of the buffer into a fresh owned local. A direct
    // `T x = d[idx]` is rejected (giving out of an element leaves a moved-from owner); instead relocate
    // bitwise through raw `UnsafePtr<T>` aliases into a zero-init'd local — the same untracked-move technique
    // DynamicArray.remove uses for `d[i] = d[i+1]`. The caller decrements `len` so the stale slot is never
    // dropped again, and `give`s out the returned local (single ownership preserved).
    unsafe fn T takeAt(isize idx) {
        slot T x;                                              // the hole `relocate`'s `out` parameter fills
        relocate(from: this.data, at: idx, into: out x);
        return give x;
    }

    // Remove + return the front element (moved out), or `None` when empty — the common dequeue.
    public fn Optional<T> popFront() {
        if (this.len == 0) { return Optional::None; }
        T x = this.takeAt(idx: this.head);
        this.head = (this.head + 1) % this.cap;
        this.len = this.len - 1;
        this.mods = this.mods + 1;
        return Optional::Some(value: give x);
    }
    // Remove + return the back element (moved out), or `None` when empty.
    public fn Optional<T> popBack() {
        if (this.len == 0) { return Optional::None; }
        T x = this.takeAt(idx: (this.head + this.len - 1) % this.cap);
        this.len = this.len - 1;
        this.mods = this.mods + 1;
        return Optional::Some(value: give x);
    }

    public const fn isize length() { return this.len; }

    // Logical index [0..len) front-to-back, bounds-checked — `dq[0]` is the front, `dq[len-1]` the back.
    public unsafe ref T operator[](isize i) {
        if (i < 0 || i >= this.len) { panic(msg: "Deque index out of bounds"); }
        isize idx = (this.head + i) % this.cap;
        return this.data[idx];
    }

    // The by-value `foreach (T x in deque)` yields COPIES, so it exists only for a Copyable element.
    public unsafe fn DequeIter<T> iterator() when [T: Copyable<T>] {
        return DequeIter::<T>.make(data: this.data, head: this.head, cap: this.cap, len: this.len,
                                   modsp: addr(of: this.mods), modsAt: this.mods);
    }
    public unsafe fn DequeIterMut<T> iterMut() {
        return DequeIterMut::<T>.make(data: this.data, head: this.head, cap: this.cap, len: this.len,
                                      modsp: addr(of: this.mods), modsAt: this.mods);
    }

    // Present ONLY for a Copyable element — a deep copy (fresh buffer, each element copied in order).
    public ctor copy(ref Deque<T, A> source) {
        this.alloc = source.alloc;                    // copy the allocator handle (a value) — same arena
        this.reserve(n: source.len);
        isize i = 0;
        while (i < source.len) { this.pushBack(item: copy source[i]); i = i + 1; }
        return this;
    }

    // Grow so at least `n` elements fit without a later reallocation (a no-op if already big enough).
    public fn void reserve(isize n) { if (n > this.cap) { this.growTo(nc: n); } }

    // Drop every live element and reset to empty (keeps the allocated buffer for reuse).
    public fn void clear() {
        isize i = 0;
        while (i < this.len) { drop(value: this[i]); i = i + 1; }
        this.len = 0; this.head = 0; this.mods = this.mods + 1;
    }

    // Membership + first logical index, by ELEMENT equality — present only when the element is `Equatable`.
    // Like DynamicArray, the element method is called through a nameable `ref T` so a PRIMITIVE element's
    // scalar intrinsic conformance resolves (a wrapped buffer element isn't a nameable receiver).
    public const fn bool contains(const ref T item) when [T: Equatable<T>] { return this.indexOf(item: item) >= 0; }
    public const fn isize indexOf(const ref T item) when [T: Equatable<T>] {
        isize i = 0;
        while (i < this.len) { if (item.equals(other: this[i])) { return i; } i = i + 1; }
        return 0 - 1;
    }

    // --- Serialization (present only when the element is Serialize/Deserialize) --- a JSON array in
    // front-to-back order. The `serElem` helper gives the element a nameable `ref T` receiver.
    const fn Result<Unit, Owned<Error>> serElem(const ref T e, ref Serializer w) when [T: Serialize] { return e.serialize(w: w); }
    public const fn Result<Unit, Owned<Error>> serialize(ref Serializer w) when [T: Serialize] {
        w.beginArray(count: cast<usize>(this.len));
        isize i = 0;
        while (i < this.len) {
            Result<Unit, Owned<Error>> __sr = this.serElem(e: this[i], w: w);
            match (give __sr) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
            i = i + 1;
        }
        w.endArray();
        return Result::Ok(value: Unit::Unit);
    }
    public ctor Result<Deque<T>, Owned<Error>> deserialize(Deserializer r) when [T: Deserialize<T>] {
        r.beginArray();
        while (r.moreElems()) {
            Result<T, Owned<Error>> __er = T.deserialize(r: r);   // bind — a match needs a named enum subject
            match (give __er) {                                     // consume: destructure-move the owning element out
                case Err(error: e): { return Result::Err(error: give e); }
                case Ok(value: v):  { this.pushBack(item: give v); }
            };
        }
        return Result::Ok(value: give this);
    }

    unsafe ~Deque() {   // drop each live element (a no-op for a value), then release the buffer via the allocator
        isize i = 0;
        while (i < this.len) { drop(value: this[i]); i = i + 1; }
        if (this.cap > 0) {
            this.alloc.deallocate(pointer: cast<UnsafePtr>(this.data), bytes: cast<usize>(this.cap) * sizeof(T));
        }
    }
}
