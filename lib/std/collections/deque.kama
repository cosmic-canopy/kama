namespace std::collections;
import std::collections::{Allocator, GlobalAllocator};
export { Deque };

// A by-value iterator (the `foreach (T x in deque)` protocol): yields each element by value, front to back.
// Like the DynamicArray iterator it snapshots the deque's mutation counter and rejects a structural change
// made mid-iteration (a push may have reallocated + re-homed the buffer, so a cursor would dangle). The
// logical position `pos` maps to the physical slot `(head + pos) % cap` — the ring wraps.
type value DequeIter<T> implements Iterator<T> {
    Ptr<T> data; int32 head; int32 cap; int32 pos; int32 len; Ptr<int32> modsp; int32 modsAt;
    public DequeIter(Ptr<T> data, int32 head, int32 cap, int32 len, Ptr<int32> modsp, int32 modsAt) {
        this.data = data; this.head = head; this.cap = cap; this.pos = 0; this.len = len;
        this.modsp = modsp; this.modsAt = modsAt;
    }
    public fn Optional<T> next() {
        unsafe { if (this.modsp[0] != this.modsAt) { panic(msg: "Deque modified during iteration"); } }
        if (this.pos >= this.len) { return Optional::None; }
        int32 idx = (this.head + this.pos) % this.cap; this.pos = this.pos + 1;
        unsafe { return Optional::Some(value: copy this.data[idx]); }   // yield a COPY (the deque keeps its element)
    }
}

// A mutable iterator (the `foreach (ref T x in deque)` protocol): hasNext() + a place-returning next().
type value DequeIterMut<T> implements IteratorMut<T> {
    Ptr<T> data; int32 head; int32 cap; int32 pos; int32 len; Ptr<int32> modsp; int32 modsAt;
    public DequeIterMut(Ptr<T> data, int32 head, int32 cap, int32 len, Ptr<int32> modsp, int32 modsAt) {
        this.data = data; this.head = head; this.cap = cap; this.pos = 0; this.len = len;
        this.modsp = modsp; this.modsAt = modsAt;
    }
    public fn bool hasNext() {
        unsafe { if (this.modsp[0] != this.modsAt) { panic(msg: "Deque modified during iteration"); } }
        return this.pos < this.len;
    }
    public fn ref T next() {
        int32 idx = (this.head + this.pos) % this.cap; this.pos = this.pos + 1;
        unsafe { return this.data[idx]; }
    }
}

// A double-ended queue backed by a growable ring buffer (= C++ `std::deque` / Rust `VecDeque`): O(1)
// amortized push/pop at BOTH ends, contiguous storage, no per-element node. Move-only by default (it owns a
// buffer); Copyable EXACTLY when its element is (a deep, element-by-element copy). `head` is the physical
// slot of the front element; the `len` live elements occupy `data[(head + i) % cap]` for i in 0..len, so the
// window wraps around the end of the buffer. `mods` is a modification counter iterators snapshot.
type resource Deque<T, A: Allocator = GlobalAllocator> implements Copyable(bare: give) when [T: Copyable], IterableMut<T>, Iterable<T> when [T: Copyable],
                            Serialize when [T: Serialize], Deserialize when [T: Deserialize] {
    Ptr<T> data; int32 head; int32 len; int32 cap; int32 mods; A alloc;

    public Deque() { unsafe { this.data = cast<Ptr<T>>(cast<usize>(0)); } this.head = 0; this.len = 0; this.cap = 0; this.mods = 0; }

    // Draw the ring buffer from a caller-owned allocator (e.g. an `Arena`). The bare `Deque()` uses the
    // default zero-size `GlobalAllocator`; this sets the handle before any grow. See DynamicArray.withAllocator.
    public static fn Deque<T, A> withAllocator(A allocator) {
        Deque<T, A> result = Deque();
        result.alloc = allocator;
        return give result;
    }

    // Relinearize into a fresh `nc`-slot buffer: the wrapped window becomes a flat 0..len run at the front.
    // Element relocation goes through LOCAL pointer aliases (`nd[i] = od[…]` is a raw bitwise move that
    // leaves no owner holding a moved-from slot), the same technique DynamicArray.remove uses.
    fn void growTo(int32 nc) {
        Ptr<T> nd;
        unsafe { nd = cast<Ptr<T>>(this.alloc.allocate(bytes: cast<usize>(nc) * sizeof(T))); }
        Ptr<T> od = this.data;
        int32 i = 0;
        unsafe { while (i < this.len) { nd[i] = od[(this.head + i) % this.cap]; i = i + 1; } }
        if (this.cap > 0) {
            unsafe { this.alloc.deallocate(pointer: cast<Ptr>(this.data), bytes: cast<usize>(this.cap) * sizeof(T)); }
        }
        this.data = nd; this.head = 0; this.cap = nc;
    }
    fn void ensureOne() { if (this.len == this.cap) { this.growTo(nc: this.cap == 0 ? 4 : this.cap * 2); } }

    // Append at the back — the common enqueue.
    public fn void pushBack(T item) {
        this.ensureOne();
        int32 idx = (this.head + this.len) % this.cap;
        unsafe { this.data[idx] = give item; }   // relocate the element into the fresh slot (raw move)
        this.len = this.len + 1;
        this.mods = this.mods + 1;
    }
    // Prepend at the front — step `head` back one (wrapping) and drop the element in.
    public fn void pushFront(T item) {
        this.ensureOne();
        this.head = (this.head + this.cap - 1) % this.cap;
        unsafe { this.data[this.head] = give item; }
        this.len = this.len + 1;
        this.mods = this.mods + 1;
    }

    // Move the element at physical slot `idx` OUT of the buffer into a fresh owned local. A direct
    // `T x = d[idx]` is rejected (giving out of an element leaves a moved-from owner); instead relocate
    // bitwise through raw `Ptr<T>` aliases into a zero-init'd local — the same untracked-move technique
    // DynamicArray.remove uses for `d[i] = d[i+1]`. The caller decrements `len` so the stale slot is never
    // dropped again, and `give`s out the returned local (single ownership preserved).
    fn T takeAt(int32 idx) {
        T x;                                              // zero-init owned local (the move-out target)
        Ptr<T> dst = addr(of: x);
        Ptr<T> d = this.data;
        unsafe { dst[0] = d[idx]; }                       // raw bitwise move out of the slot (untracked)
        return give x;
    }

    // Remove + return the front element (moved out), or `None` when empty — the common dequeue.
    public fn Optional<T> popFront() {
        if (this.len == 0) { return Optional::None; }
        T x = this.takeAt(idx: this.head);
        this.head = (this.head + 1) % this.cap;
        this.len = this.len - 1;
        this.mods = this.mods + 1;
        return Optional::Some(value: give x);
    }
    // Remove + return the back element (moved out), or `None` when empty.
    public fn Optional<T> popBack() {
        if (this.len == 0) { return Optional::None; }
        T x = this.takeAt(idx: (this.head + this.len - 1) % this.cap);
        this.len = this.len - 1;
        this.mods = this.mods + 1;
        return Optional::Some(value: give x);
    }

    public fn int32 length() { return this.len; }

    // Logical index [0..len) front-to-back, bounds-checked — `dq[0]` is the front, `dq[len-1]` the back.
    public ref T operator[](int32 i) {
        if (i < 0 || i >= this.len) { panic(msg: "Deque index out of bounds"); }
        int32 idx = (this.head + i) % this.cap;
        unsafe { return this.data[idx]; }
    }

    // The by-value `foreach (T x in deque)` yields COPIES, so it exists only for a Copyable element.
    public fn DequeIter<T> iterator() when [T: Copyable] {
        return DequeIter::<T>(data: this.data, head: this.head, cap: this.cap, len: this.len,
                              modsp: addr(of: this.mods), modsAt: this.mods);
    }
    public fn DequeIterMut<T> iterMut() {
        return DequeIterMut::<T>(data: this.data, head: this.head, cap: this.cap, len: this.len,
                                 modsp: addr(of: this.mods), modsAt: this.mods);
    }

    // Present ONLY for a Copyable element — a deep copy (fresh buffer, each element copied in order).
    public fn Deque<T, A> copy() {
        Deque<T, A> result = Deque();
        result.alloc = this.alloc;                    // copy the allocator handle (a value) — same arena
        result.reserve(n: this.len);
        int32 i = 0;
        while (i < this.len) { result.pushBack(item: copy this[i]); i = i + 1; }
        return result;
    }

    // Grow so at least `n` elements fit without a later reallocation (a no-op if already big enough).
    public fn void reserve(int32 n) { if (n > this.cap) { this.growTo(nc: n); } }

    // Drop every live element and reset to empty (keeps the allocated buffer for reuse).
    public fn void clear() {
        int32 i = 0;
        while (i < this.len) { drop(value: this[i]); i = i + 1; }
        this.len = 0; this.head = 0; this.mods = this.mods + 1;
    }

    // Membership + first logical index, by ELEMENT equality — present only when the element is `Equatable`.
    // Like DynamicArray, the element method is called through a nameable `ref T` so a PRIMITIVE element's
    // scalar retro-impl resolves (a wrapped buffer element isn't a nameable receiver).
    public fn bool contains(ref T item) when [T: Equatable] { return this.indexOf(item: item) >= 0; }
    public fn int32 indexOf(ref T item) when [T: Equatable] {
        int32 i = 0;
        while (i < this.len) { if (item.equals(other: this[i])) { return i; } i = i + 1; }
        return 0 - 1;
    }

    // --- Serialization (present only when the element is Serialize/Deserialize) --- a JSON array in
    // front-to-back order. The `serElem` helper gives the element a nameable `ref T` receiver.
    fn void serElem(ref T e, ref Serializer w) when [T: Serialize] { e.serialize(w: w); }
    public fn void serialize(ref Serializer w) when [T: Serialize] {
        w.beginArray(count: cast<usize>(this.len));
        int32 i = 0;
        while (i < this.len) { this.serElem(e: this[i], w: w); i = i + 1; }
        w.endArray();
    }
    public static fn Deque<T> deserialize(Deserializer r) when [T: Deserialize] {
        Deque<T> result = Deque();
        r.beginArray();
        while (r.moreElems()) { result.pushBack(item: T::deserialize(r: r)); }
        return give result;
    }

    ~Deque() {   // drop each live element (a no-op for a value), then release the buffer via the allocator
        int32 i = 0;
        while (i < this.len) { drop(value: this[i]); i = i + 1; }
        if (this.cap > 0) {
            unsafe { this.alloc.deallocate(pointer: cast<Ptr>(this.data), bytes: cast<usize>(this.cap) * sizeof(T)); }
        }
    }
}
