import { std::ptr::relocate };
export { SlotMap, Handle, SlotMapValueIter, SlotMapValueIterMut };

// A stable, generation-checked reference into a `SlotMap`. `index` is the slot; `generation` is the slot's
// occupancy stamp captured at insert time. A get/remove succeeds only if the slot STILL carries that same
// generation — so a handle to a slot that was removed (and possibly reused for a different value) is rejected
// rather than silently aliasing the new occupant. A plain Copyable value: keep it, copy it, pass it around.
// ⚠️ Serializable so the guarantee is USABLE: `SlotMap`'s serde promises a handle still resolves after a
// round trip, and that promise is worth nothing unless the handles a caller stored — in a scene, a
// component table, another slot map — can go on the wire beside it. The two halves ship together.
//
// ⚠️ HAND-WRITTEN rather than `@generate`d, and the compiler is right to insist: `index` is an `isize`,
// which has no wire format at all (`ptrdiff_t` is 8 bytes natively and 4 on wasm32), so a derived body
// would have had to invent one. It stays an `isize` in memory — that is what indexes the buffers — and the
// wire carries a fixed-width `int64`, casting at the boundary. That is the diagnostic's own advice, and it
// is the reason a handle written on one target reads back on another.
@generate(of)
type value Handle implements Sendable, Serializable, Deserializable<This> {
    public isize index;
    public uint32 generation;
    public const fn Result<Unit, Owned<Error>> serialize(ref Serializer w) {
        w.beginObject(count: 2ui64);
        w.field(name: "index", id: 0ui32);      w.writeI64(v: cast<int64>(this.index));
        w.field(name: "generation", id: 1ui32); w.writeU32(v: this.generation);
        w.endObject();
        return Result::Ok(value: Unit::Unit);
    }
    public ctor Result<Handle, Owned<Error>> deserialize(Deserializer r) {
        r.beginObject(count: 2ui64);
        bool __f1 = r.moreFields(); FieldKey __n1 = r.field(); int64  ix = r.readI64();
        bool __f2 = r.moreFields(); FieldKey __n2 = r.field(); uint32 gn = r.readU32();
        bool __f3 = r.moreFields();
        r.endObject();
        return Result::Ok(value: Handle.of(index: cast<isize>(ix), generation: gn));
    }
}

// A by-value iterator over a slot map's live VALUES (`foreach (V v in sm.values())`), present only for a
// Copyable value. It borrows the value + generation buffers, walks only OCCUPIED slots (odd generation), and
// yields each value BY VALUE (a copy). Rejects a structural change (insert/remove) made mid-iteration via the
// `mods` snapshot — same contract as `MapValueIter`.
type view SlotMapValueIter<V: Copyable<V>> implements Iterator<V> {
    UnsafePtr<V> values; UnsafePtr<uint32> gens; isize slotCount; isize pos; UnsafePtr<uint32> modsp; uint32 modsAt;
    unsafe ctor make(UnsafePtr<V> values, UnsafePtr<uint32> gens, isize slotCount, UnsafePtr<uint32> modsp, uint32 modsAt) {
        this.values = values; this.gens = gens; this.slotCount = slotCount; this.pos = 0;
        this.modsp = modsp; this.modsAt = modsAt;
    }
    public unsafe fn Optional<V> next() {
        if (this.modsp[0] != this.modsAt) { panic(msg: "SlotMap modified during iteration"); }
        while (this.pos < this.slotCount) {
            isize p = this.pos; this.pos = this.pos + 1;
            uint32 g = this.gens[p];
            if ((g & 1ui32) == 1ui32) { return Optional::Some(value: copy this.values[p]); }
        }
        return Optional::None;
    }
}

// A mutable iterator over a slot map's live VALUES (`foreach (ref V v in sm.valuesMut())`), for ANY value
// type — the borrow that lets a SlotMap of move-only values be walked + mutated in place. `hasNext()` advances
// to the next OCCUPIED slot (idempotent) and runs the invalidation check; `next()` hands out the `ref V`.
type view SlotMapValueIterMut<V> implements IteratorMut<V> {
    UnsafePtr<V> values; UnsafePtr<uint32> gens; isize slotCount; isize pos; UnsafePtr<uint32> modsp; uint32 modsAt;
    unsafe ctor make(UnsafePtr<V> values, UnsafePtr<uint32> gens, isize slotCount, UnsafePtr<uint32> modsp, uint32 modsAt) {
        this.values = values; this.gens = gens; this.slotCount = slotCount; this.pos = 0;
        this.modsp = modsp; this.modsAt = modsAt;
    }
    public unsafe fn bool hasNext() {
        if (this.modsp[0] != this.modsAt) { panic(msg: "SlotMap modified during iteration"); }
        while (this.pos < this.slotCount) {
            uint32 g = this.gens[this.pos];
            if ((g & 1ui32) == 1ui32) { return true; }   // stop AT the occupied slot (next() consumes it)
            this.pos = this.pos + 1;
        }
        return false;
    }
    public unsafe fn ref V next() { isize p = this.pos; this.pos = this.pos + 1; return this.values[p]; }
}

// A slot map (= Rust `slotmap`; the classic ECS entity / asset registry): `insert` returns a stable `Handle`
// you keep, and `get`/`remove`/`getRef` by handle are O(1) and REJECT a stale handle — one whose slot was
// removed (and maybe reused) — instead of aliasing whatever lives there now. That generation check is what
// turns a dangling reference into a clean `None`/panic rather than a use-after-free, so handles can outlive
// the values they point at. Move-only by default (it owns a value buffer).
//
// Three parallel heap buffers, all indexed by slot: `values` (the payloads), `gens` (a per-slot generation),
// `freeList` (a stack of vacated slot indices to reuse). A slot's generation is ODD while occupied and EVEN
// while vacant; every insert bumps it up one (even->odd to occupy), every remove bumps it up one (odd->even to
// vacate). A handle stores the odd stamp from its insert, so `valid` is just `gens[index] == handle.generation`
// — a removed slot (now even) or a reused slot (now a higher odd) both mismatch. `slotCount` is the high-water
// slot count; `freeList` is sized to `cap`, so a push never overflows (occupied + free <= slotCount <= cap).
type resource SlotMap<V, A: Allocator = GlobalAllocator>
        implements ValuesIterable<SlotMapValueIter<V>> when [V: Copyable<V>],
                   ValuesIterableMut<SlotMapValueIterMut<V>>, Sendable when [V: Sendable, A: Sendable],
                   Serializable when [V: Serializable],
                   Deserializable<This> when [V: Deserializable<V>] {
    UnsafePtr<V> values = null; UnsafePtr<uint32> gens = null; UnsafePtr<isize> freeList = null;
    isize slotCount = 0; isize freeLen = 0; isize len = 0; isize cap = 0; uint32 mods = 0; A alloc;

    // The four-ctor matrix (M8c). `empty()` is the `default` zero-arg build; `empty`/`withCapacity` are the
    // default-allocator conveniences (custom `A` uses the allocator-taking ctors). A bare `SlotMap<V, A> r;`
    // zero-inits the primitive/`UnsafePtr` fields and default-fills `alloc` — the M8d.1 gate proves completeness.
    public default ctor empty() when [A: default] { }
    public ctor withCapacity(isize capacity) when [A: default] { this.reserve(n: capacity); }

    // Draw the three parallel buffers from a caller-owned allocator (e.g. an `Arena`). The bare `SlotMap()`
    // uses the default zero-size `GlobalAllocator`; this sets the handle before any grow.
    public ctor withAllocator(A allocator) {
        this.alloc = allocator;
    }

    // Caller-owned allocator AND pre-grown for `capacity` slots — `alloc` set before `reserve`.
    public ctor withCapacityAndAllocator(A allocator, isize capacity) {
        this.alloc = allocator;
        this.reserve(n: capacity);
    }

    public const fn isize length() { return this.len; }
    public const fn bool isEmpty() { return this.len == 0; }

    // Grow the three parallel buffers so at least `n` slots fit without a later reallocation (a no-op if
    // already big enough). Lets a caller who knows the size up front skip the incremental doublings.
    public fn void reserve(isize n) { if (n > this.cap) { this.growTo(nc: n); } }

    // Insert `value` (consumes it) and return a fresh handle. Reuses a vacated slot from the free list when
    // one exists, else appends a new slot (growing the buffers first). The chosen slot's generation goes
    // even->odd (occupied) and the odd stamp is handed back in the handle.
    public unsafe fn Handle insert(V value) {
        isize idx = 0;
        if (this.freeLen > 0) {
            this.freeLen = this.freeLen - 1;
            idx = this.freeList[this.freeLen];         // reuse a vacated slot (gen is even here)
        } else {
            if (this.slotCount == this.cap) { this.grow(); }
            idx = this.slotCount; this.slotCount = this.slotCount + 1;
            this.gens[idx] = 0ui32;                   // a brand-new slot starts vacant (even)
        }
        uint32 g = 0ui32;
        g = this.gens[idx] + 1ui32; this.gens[idx] = g;   // even -> odd: occupy
        this.values[idx] = give value;                // raw store into the (empty/stale) slot
        this.len = this.len + 1; this.mods = this.mods + 1;
        return Handle.of(index: idx, generation: g);
    }

    // True iff `h` still points at its original occupant — index in range AND the slot's generation unchanged.
    unsafe const fn bool valid(Handle h) {
        if (h.index < 0 || h.index >= this.slotCount) { return false; }
        uint32 g = this.gens[h.index];
        return g == h.generation;   // handle stamps are odd, so a match implies the slot is still occupied
    }
    public const fn bool contains(Handle handle) { return this.valid(h: handle); }

    // Fetch a COPY of the value for `h` (present only for a Copyable value); `None` if the handle is stale.
    public unsafe fn Optional<V> get(Handle handle) when [V: Copyable<V>] {
        if (!this.valid(h: handle)) { return Optional::None; }
        return Optional::Some(value: copy this.values[handle.index]);
    }

    // Borrow the value for `h` IN PLACE (any V, no Copyable bound) — the read/mutate accessor for a SlotMap of
    // move-only values. PANICS on a stale/invalid handle (guard with `contains` first); the returned `ref V`
    // may not escape and dangles across an `insert`/`remove` that relocates the buffer.
    public unsafe const fn const ref V getRef(Handle handle) {
        if (!this.valid(h: handle)) { panic(msg: "SlotMap.getRef: stale or invalid handle"); }
        return this.values[handle.index];
    }
    public unsafe fn ref V getRefMut(Handle handle) {   // the writable twin
        if (!this.valid(h: handle)) { panic(msg: "SlotMap.getRefMut: stale or invalid handle"); }
        return this.values[handle.index];
    }

    // Remove the value for `h`, returning it moved OUT (`None` if stale). The slot's generation goes odd->even
    // (vacated), so every existing handle to it — including `h` — is now invalid, and the slot is pushed onto
    // the free list for reuse. Discard the result to just delete (it drops cleanly).
    public unsafe fn Optional<V> remove(Handle handle) {
        if (!this.valid(h: handle)) { return Optional::None; }
        isize idx = handle.index;
        V v = this.takeVal(at: idx);                           // value relocated OUT (slot now stale)
        this.gens[idx] = this.gens[idx] + 1ui32;      // odd -> even: vacate (stale handles mismatch)
        this.freeList[this.freeLen] = idx;            // remember the slot for reuse (always fits)
        this.freeLen = this.freeLen + 1;
        this.len = this.len - 1; this.mods = this.mods + 1;
        return Optional::Some(value: give v);
    }

    // Move the value at `slot` OUT of the buffer into a fresh owned local (the slot is left stale — the caller
    // vacates it). Bitwise-relocate through raw `UnsafePtr<V>` aliases into a zero-init'd local, then `give` — the
    // move-out idiom `Map.takeVal` / `DynamicArray.takeAt` use.
    unsafe fn V takeVal(isize at) {
        slot V x;                                          // the hole `relocate`'s `out` parameter fills
        relocate(from: this.values, at: at, into: out x);
        return give x;
    }

    // `foreach (V v in sm.values())` — a by-value iterator over the live values (Copyable value). `valuesMut()`
    // borrows instead, for any value type. (Slot order, which is insertion order with reused gaps — not sorted.)
    public unsafe fn SlotMapValueIter<V> values() when [V: Copyable<V>] {
        return SlotMapValueIter::<V>.make(values: this.values, gens: this.gens, slotCount: this.slotCount,
                                          modsp: addr(of: this.mods), modsAt: this.mods);
    }
    // Serde's graph read half rewires this container's edge elements through here. A KEYED container
    // holds its edges in its VALUES — a key cannot be rewired in place, since that would move it in the
    // ordering/hash — so the marked accessor is `valuesMut()`, not a key or entry one.
    @serializedGraphEdges
    public unsafe fn SlotMapValueIterMut<V> valuesMut() {
        return SlotMapValueIterMut::<V>.make(values: this.values, gens: this.gens, slotCount: this.slotCount,
                                             modsp: addr(of: this.mods), modsAt: this.mods);
    }

    // Drop every live value and vacate every slot (keeps the buffers). Generations keep CLIMBING (each occupied
    // slot goes odd->even), so handles minted before the clear stay invalid; the free list is rebuilt with all
    // slots. `slotCount` is retained so a live handle's index stays in range (and reads its now-even, invalid gen).
    public unsafe fn void clear() {
        isize i = 0; this.freeLen = 0;
        while (i < this.slotCount) {
            if ((this.gens[i] & 1ui32) == 1ui32) { drop(ptr: addr(of: this.values[i])); this.gens[i] = this.gens[i] + 1ui32; }
            this.freeList[this.freeLen] = i; this.freeLen = this.freeLen + 1;
            i = i + 1;
        }
        this.len = 0; this.mods = this.mods + 1;
    }

    // --- Serialization (present only when the value is Serializable/Deserializable) ---
    //
    // ⚠️ THE CONTRACT, and it is the whole design: **A HANDLE SURVIVES A ROUND TRIP.** Save a slot map,
    // load it, and every `Handle` a caller stored elsewhere still resolves to the same value — which is the
    // only reason to have handles rather than indices in the first place, and what makes a slot map the
    // thing you serialize an entity/asset registry with. Rust's `slotmap` makes the same promise for the
    // same reason ("a key remains valid for a slot map even after one or both have been serialized and
    // deserialized"). The alternative — write only the live values, rebuild dense from slot 0 — is smaller
    // on the wire and fails SILENTLY: a stale handle can then coincidentally match a rebuilt slot's index
    // and generation and alias the WRONG value, which is the exact accident the generation check exists to
    // prevent. Silence disqualified it.
    //
    // So the wire form preserves the slot LAYOUT: the per-slot generation array including vacant slots,
    // then the live values in ascending slot order.
    //
    //     {"slots":[1,0,3,5], "values":[…,…,…]}
    //
    // Two parallel arrays rather than one array of per-slot optional records, because a POSITIONAL backend
    // has no names and no delimiters — its reader is bounded only by the counts — so a per-slot shape that
    // varies (present / absent) has no unambiguous positional reading, while two fixed-length arrays do.
    // A hole costs 4 bytes of generation and no payload, so the cost is proportional to the high-water slot
    // count rather than to the live count; that is the honest price of the guarantee.
    //
    // `freeList` and `len` are DERIVED on read (`len` = the odd count, the free list = the even slots) —
    // neither goes on the wire. The free list's ORDER decides which slot the next insert reuses, which is
    // not observable through any accessor, so rebuilding it descending (lowest slot reused first) is a
    // deterministic choice rather than a lost one.
    public unsafe const fn Result<Unit, Owned<Error>> serialize(ref Serializer w) when [V: Serializable] {
        w.beginObject(count: 2ui64);
        w.field(name: "slots", id: 0ui32);
        w.beginArray(count: cast<usize>(this.slotCount));
        isize i = 0;
        while (i < this.slotCount) { w.writeU32(v: this.gens[i]); i = i + 1; }
        w.endArray();
        w.field(name: "values", id: 1ui32);
        w.beginArray(count: cast<usize>(this.len));
        i = 0;
        while (i < this.slotCount) {
            if ((this.gens[i] & 1ui32) == 1ui32) {           // occupied — ascending slot order
                Result<Unit, Owned<Error>> __sv = this.values[i].serialize(w: w);
                match (give __sv) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
            }
            i = i + 1;
        }
        w.endArray();
        w.endObject();
        return Result::Ok(value: Unit::Unit);
    }
    // Rebuild the slot layout, then fill the occupied slots in the same ascending order the write used.
    // GlobalAllocator-only (the wire carries no allocator handle) — the same convention the other
    // collections' A-ignoring deserialize follows.
    public unsafe ctor Result<SlotMap<V>, Owned<Error>> deserialize(Deserializer r) when [V: Deserializable<V>] {
        SlotMap<V> result = SlotMap.empty();
        r.beginObject(count: 2ui64);
        bool __f1 = r.moreFields(); FieldKey __n1 = r.field();
        r.beginArray();
        isize n = 0;
        while (r.moreElems()) {                       // the generations, holes included — this IS the layout
            uint32 g = r.readU32();
            if (n == result.cap) { result.reserve(n: result.cap == 0 ? 8 : result.cap * 2); }   // amortized
            result.gens[n] = g;
            n = n + 1;
            // ⚠️ Kept in step DELIBERATELY, not set once at the end: `growTo` relocates exactly
            // `slotCount` entries, so leaving it at 0 while filling `gens` made every grow silently
            // discard every generation read so far. The layout is the thing being rebuilt, so it has to
            // be true at each step, not only after the loop.
            result.slotCount = n;
        }
        bool __f2 = r.moreFields(); FieldKey __n2 = r.field();
        r.beginArray();
        isize i = 0;
        // A short or malformed values array surfaces as the element read's own boxed error — the same way
        // it does for every other container's `deserialize`, which is why there is no sticky check here.
        // ⚠️ `moreElems()` is called BEFORE each element, not to bound the loop (the slot layout bounds it)
        // but because that is what steps a self-describing backend past the separator — JSON eats the `,`
        // there. Reading the elements without it left the reader parked on the comma and the whole object
        // came back `Err`.
        while (i < n) {
            if ((result.gens[i] & 1ui32) == 1ui32) {
                bool __more = r.moreElems();
                Result<V, Owned<Error>> __ev = V.deserialize(r: r);
                match (give __ev) {
                    case Err(error: e): { return Result::Err(error: give e); }
                    case Ok(value: v):  { result.values[i] = give v; result.len = result.len + 1; }
                };
            }
            i = i + 1;
        }
        bool __f3 = r.moreElems();                    // close the values array
        bool __f4 = r.moreFields();
        r.endObject();
        // The free list, descending so the LOWEST vacant slot is reused first — derived, never on the wire.
        result.freeLen = 0;
        i = n;
        while (i > 0) {
            i = i - 1;
            if ((result.gens[i] & 1ui32) == 0ui32) { result.freeList[result.freeLen] = i; result.freeLen = result.freeLen + 1; }
        }
        return Result::Ok(value: give result);
    }

    // Grow the three buffers to the next capacity (doubling from 8) and relocate the live state.
    fn void grow() { this.growTo(nc: this.cap == 0 ? 8 : this.cap * 2); }
    unsafe fn void growTo(isize nc) {
        UnsafePtr<V> nv = null; UnsafePtr<uint32> ng = null; UnsafePtr<isize> nf = null;
        nv = cast<UnsafePtr<V>>(unwrapPtr(o: this.alloc.allocate(bytes: cast<usize>(nc) * sizeof(V))));
        ng = cast<UnsafePtr<uint32>>(unwrapPtr(o: this.alloc.allocate(bytes: cast<usize>(nc) * sizeof(uint32))));
        nf = cast<UnsafePtr<isize>>(unwrapPtr(o: this.alloc.allocate(bytes: cast<usize>(nc) * sizeof(isize))));
        isize i = 0;
        while (i < this.slotCount) { nv[i] = this.values[i]; ng[i] = this.gens[i]; i = i + 1; }  // bitwise relocate
        i = 0;
        while (i < this.freeLen) { nf[i] = this.freeList[i]; i = i + 1; }
        if (this.cap > 0) {
            this.alloc.deallocate(pointer: cast<UnsafePtr>(this.values),   bytes: cast<usize>(this.cap) * sizeof(V));
            this.alloc.deallocate(pointer: cast<UnsafePtr>(this.gens),     bytes: cast<usize>(this.cap) * sizeof(uint32));
            this.alloc.deallocate(pointer: cast<UnsafePtr>(this.freeList), bytes: cast<usize>(this.cap) * sizeof(isize));
        }
        this.values = nv; this.gens = ng; this.freeList = nf; this.cap = nc;
        // The buffer MOVED, so every live iterator's pointer is now stale — a structural change even
        // when `len` did not move. `reserve()` reaches here without going through `add`/`put`, which is
        // how a realloc used to happen with the counter untouched (finding 7).
        this.mods = this.mods + 1;
    }

    unsafe ~SlotMap() {   // drop each live (occupied) value, then release the three buffers via the allocator
        isize i = 0;
        while (i < this.slotCount) {
            if ((this.gens[i] & 1ui32) == 1ui32) { drop(ptr: addr(of: this.values[i])); }
            i = i + 1;
        }
        if (this.cap > 0) {
            this.alloc.deallocate(pointer: cast<UnsafePtr>(this.values),   bytes: cast<usize>(this.cap) * sizeof(V));
            this.alloc.deallocate(pointer: cast<UnsafePtr>(this.gens),     bytes: cast<usize>(this.cap) * sizeof(uint32));
            this.alloc.deallocate(pointer: cast<UnsafePtr>(this.freeList), bytes: cast<usize>(this.cap) * sizeof(isize));
        }
    }
}
