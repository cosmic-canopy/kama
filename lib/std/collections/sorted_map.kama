import { std::memory::Owned, std::memory::AllocError, std::memory::replace, std::memory::swap, DynamicArray, InlineDynamicArray,
         CapacityFull, ValuesIterable, ValuesIterableMut, ValuesIterableConst, EntriesIterable, Drainable, Entry, MapKeyText,
         MapKeyReader };
export { SortedMap, SortedMapKeyIter, SortedMapValueIter, SortedMapEntryIter, SortedMapValueIterMut, SortedMapValueIterConst,
         SortedMapDrain, SortedSetDrain };

// Moving a `SortedMap`'s pairs out, in ascending key order (`foreach (Entry<K, V> e in m.drain())`, KR-263): each step
// takes the minimum out of the tree (`drainNext`), so the tree stays a tree mid-drain and a `const fn` read inside the
// loop sees exactly the pairs not yet taken. When the loop is left its destructor `clear()`s the rest.
type view SortedMapDrain<K: Comparable<K>, V, A: Allocator> implements Iterator<Entry<K,V>> {
    UnsafePtr<SortedMap<K,V,A>> m;
    unsafe ctor over(UnsafePtr<SortedMap<K,V,A>> m) { this.m = m; }
    public unsafe fn Optional<Entry<K,V>> next() { return this.m[0].drainNext(); }
    unsafe ~SortedMapDrain() { this.m[0].clear(); }
}

// A `SortedSet`'s members moved out, smallest first: the map's drain yielding each key. It takes the map's own
// parameters, `V` the set's `Unit`, so the map's `friend` grant reaches it.
type view SortedSetDrain<K: Comparable<K>, V, A: Allocator> implements Iterator<K> {
    UnsafePtr<SortedMap<K,V,A>> m;
    unsafe ctor over(UnsafePtr<SortedMap<K,V,A>> m) { this.m = m; }
    public unsafe fn Optional<K> next() {
        Optional<Entry<K,V>> e = this.m[0].drainNext();
        return match (give e) {
            case Some(value: x): { := match (give x.intoParts()) { case Parts(key: k, value: v): Optional::Some(value: give k); }; }
            case None: Optional::None;
        };
    }
    unsafe ~SortedSetDrain() { this.m[0].clear(); }
}

// An ordered map over `K: Comparable` -> `V`, backed by a B-tree (peer: Rust `BTreeMap`, C++ `std::map`).
// Unlike `Map` (a hash table, unordered), a `SortedMap` keeps its keys in ascending `compareTo` order, so
// iteration yields entries sorted and it answers ordered queries (`first`/`last`/`floor`/`ceil`/`range`)
// that a hash map can't. Move-only by default (it owns the tree, which owns every key + value); deep-copies
// exactly when both key and value are `Copyable`.
//
// The tree has min-degree B = 6: every node holds 5..11 keys (a full node is 11 = 2B-1 keys / 12 children),
// except the root which may hold as few as 1. Height stays O(log_B n), so lookup / insert / remove are all
// O(log n). Insert is bottom-up, as Rust's `BTreeMap` and Abseil's `btree_map` insert: one descent finds the key or
// its leaf, and a full node splits only as the pair rises into it. Remove borrows-or-merges a thin child before
// descending (CLRS), so the tree stays balanced without a second upward pass.
//
// A node holds its keys and values inline at full fanout (`InlineDynamicArray`), and an internal node also holds a
// second box of its 12 child slots: Rust's and Abseil's leaf/internal split, with no unused child slots in a leaf. So
// an insert into a node with room, a split's moves, a merge and a remove never allocate; only a box does (KR-423). A
// child is an `Owned<BTreeNode>` box, so moving a whole subtree between parents is a single owned-pointer move, and
// dropping a node recursively frees its subtree.
//
// Every box comes from the map's `BTreeBoxes`, which draws it from `A` or hands out a spare one `reserve` made. Every
// node but the root holds at least 5 keys, so a tree of N keys has at most (N - 1)/5 + 1 nodes: a number `reserve(n)`
// can make in advance, which is what gives a B-tree the collections' no-room pair (`tryReserve`, `putWithinCapacity`).

// B-tree tuning: B = 6. A node is FULL at 2B-1 = 11 keys (split then); MINKEYS = B-1 = 5 is the floor for a
// non-root node (borrow/merge below it). MEDIAN = B-1 = 5 is the index that rises on a split.
//   (kept as small helper fns — a value read at each use, no module-level mutable state.)

// One frame of the in-order cursor below: the node being walked and the index of the NEXT key to yield
// in it. A `value` that owns nothing, so the iterator holding a stack of these owns nothing either.
type value BTreeFrame<K: Comparable<K>, V, A: Allocator = GlobalAllocator> {
    public UnsafePtr<BTreeNode<K,V,A>> node = null;
    public isize i = 0;
    public unsafe ctor at(UnsafePtr<BTreeNode<K,V,A>> node, isize i) { this.node = node; this.i = i; }
    // Elected so an iterator's `path` stack of these is filled frame by frame when it is made (KR-106: an
    // `InlineArray` has a default only element by element). A view ctor may assign only from its
    // parameters, so the fill is the one way the stack starts out as frames rather than as bytes.
    public default ctor empty() { }
}
// The read-only iterator's frame: the same, over a read-only node address.
type value BTreeConstFrame<K: Comparable<K>, V, A: Allocator = GlobalAllocator> {
    public UnsafeConstPtr<BTreeNode<K,V,A>> node = null;
    public isize i = 0;
    public unsafe ctor at(UnsafeConstPtr<BTreeNode<K,V,A>> node, isize i) { this.node = node; this.i = i; }
    public default ctor empty() { }
}

// A MUTABLE in-order iterator over a sorted map's VALUES (`foreach (ref V v in sm.valuesMut())`), for ANY
// value type — the borrow accessor that lets a SortedMap of move-only values be walked + mutated in place.
//
// It is the one container iterator in the stdlib that is NOT a flat cursor. Every other one
// (`DynamicArray`, `Deque`, `FixedArray`, `View`, `Map`, `SlotMap`) walks a raw buffer with a pointer and
// an index; a B-tree has no such buffer, so this keeps an explicit PATH STACK and does the classic
// interleaved walk: subtree kids[0], key 0, subtree kids[1], key 1, … kids[n].
//
// ⚠️ The stack is an `InlineArray`, and its depth is a PROVEN bound, not a guess. `full()` splits at 11
// keys (2B-1, B = 6), so every non-root node holds >= 5 keys and the branching factor is >= 6: a tree of
// depth d holds at least 2*6^(d-1) entries, so depth 32 needs far more entries than an `isize` can even
// address. Overflowing it is unreachable, which is why this can be a value that owns nothing — and that
// matters, because `IteratorMut` is declared `for value, view`, so an iterator may never own heap. The read-only
// iterators below walk the same way through `BTreeWalk`; this one keeps its own stack because it walks WRITABLE
// node addresses.
type view SortedMapValueIterMut<K: Comparable<K>, V, A: Allocator = GlobalAllocator> implements IteratorMut<V> {
    InlineArray<BTreeFrame<K,V,A>>#(32) path;
    isize depth;
    // The settled position `next()` is about to hand out. It is a FIELD rather than a local because a
    // `ref V` result must borrow `this` — a place read out of a local raw pointer cannot be returned.
    UnsafePtr<BTreeNode<K,V,A>> cur = null; isize curI = 0;
    UnsafePtr<BTreeNode<K,V,A>> root = null; bool primed = false;
    UnsafePtr<uint32> modsp; uint32 modsAt;

    // A view ctor may only assign fields from its parameters — it may not call a method on `this` — so the
    // cursor is PRIMED lazily on the first `hasNext()`. The `IteratorMut` protocol runs `hasNext()` before
    // every `next()`, which is the same guarantee `Map`/`SlotMap` already rely on to advance their cursors.
    unsafe ctor make(UnsafePtr<BTreeNode<K,V,A>> root, UnsafePtr<uint32> modsp, uint32 modsAt) {
        // ⚠️ EVERY borrow field must trace to a borrowable parameter here — a view ctor is checked for
        // that, and `cur` is only really set by `next()`. Seed it from the root: the same tree, so the
        // borrow is honest, and it is overwritten before it is ever read.
        this.depth = 0; this.root = root; this.cur = root; this.curI = 0; this.primed = false;
        this.modsp = modsp; this.modsAt = modsAt;
    }

    // Push the leftmost path from `n` down to a leaf — every node on it yields its key 0 first.
    unsafe fn void descend(UnsafePtr<BTreeNode<K,V,A>> n) {
        UnsafePtr<BTreeNode<K,V,A>> walk = n;
        while (this.depth < 32) {
            this.path[this.depth] = BTreeFrame::<K,V,A>.at(node: walk, i: 0);
            this.depth = this.depth + 1;
            if (walk[0].isLeaf()) { return; }
            walk = walk[0].childPtr(at: 0);
        }
        panic(msg: "SortedMap depth exceeded 32 — the tree is corrupt");
    }

    // Drop any frame whose keys are exhausted, so the top always points at a real next key (or the stack
    // is empty and iteration is over). An empty tree settles to depth 0 immediately.
    unsafe fn void settle() {
        while (this.depth > 0) {
            isize d = this.depth - 1;
            UnsafePtr<BTreeNode<K,V,A>> n = this.path[d].node;
            if (this.path[d].i < n[0].keyCount()) { return; }
            this.depth = d;
        }
    }

    // Not `const fn` — `Map`/`SlotMap`'s are not either, and this one likewise advances the cursor: it
    // primes it on the first call and settles it on every call.
    public unsafe fn bool hasNext() {
        if (this.modsp[0] != this.modsAt) { panic(msg: "SortedMap modified during iteration"); }
        if (!this.primed) { this.primed = true; this.descend(n: this.root); this.settle(); }
        return this.depth > 0;
    }

    public unsafe fn ref V next() {
        isize d = this.depth - 1;
        UnsafePtr<BTreeNode<K,V,A>> n = this.path[d].node;
        isize i = this.path[d].i;
        this.cur = n; this.curI = i;                    // the place to hand out, before the cursor moves
        this.path[d] = BTreeFrame::<K,V,A>.at(node: n, i: i + 1);
        // In-order: the subtree BETWEEN this key and the next comes before the next key.
        if (!n[0].isLeaf()) { this.descend(n: n[0].childPtr(at: i + 1)); } else { this.settle(); }
        return this.cur[0].valAt(at: this.curI);
    }
}

// The read-only in-order cursor every iterator but the mutable one walks with: the path stack above, over READ-ONLY
// node addresses, from the smallest key or from the least key >= a bound, and up to an end position or the last key.
// A `value` that owns nothing (KR-424), so a map is listed in order with no allocation, whatever allocator it names.
// Both ends of a window are found when the walk is made, as positions in the tree (Rust's `BTreeMap::range` finds its
// two leaf edges up front), so the iterator holds neither bound: a bound may be a temporary of the call.
type value BTreeWalk<K: Comparable<K>, V, A: Allocator = GlobalAllocator> {
    InlineArray<BTreeConstFrame<K,V,A>>#(32) path;
    isize depth = 0;
    UnsafeConstPtr<BTreeNode<K,V,A>> end = null; isize endI = 0;   // the first key NOT to yield; null = none
    public default ctor empty() { }

    // Push the path from `n` down to a leaf, each frame at its key 0: every node on it yields its key 0 first.
    unsafe fn void descend(UnsafeConstPtr<BTreeNode<K,V,A>> n) {
        UnsafeConstPtr<BTreeNode<K,V,A>> walk = n;
        while (this.depth < 32) {
            this.path[this.depth] = BTreeConstFrame::<K,V,A>.at(node: walk, i: 0);
            this.depth = this.depth + 1;
            if (walk[0].isLeaf()) { return; }
            walk = walk[0].childConstPtr(at: 0);
        }
        panic(msg: "SortedMap depth exceeded 32 — the tree is corrupt");
    }
    // Drop any frame whose keys are exhausted, so the top always points at a real next key (or the walk is over).
    unsafe fn void settle() {
        while (this.depth > 0) {
            isize d = this.depth - 1;
            UnsafeConstPtr<BTreeNode<K,V,A>> n = this.path[d].node;
            if (this.path[d].i < n[0].keyCount()) { return; }
            this.depth = d;
        }
    }

    // From the smallest key.
    public unsafe fn void first(UnsafeConstPtr<BTreeNode<K,V,A>> root) { this.descend(n: root); this.settle(); }
    // From the least key >= `lo`: in each node the first key >= `lo`, whose left subtree may still hold keys >= `lo`.
    public unsafe fn void seek(UnsafeConstPtr<BTreeNode<K,V,A>> root, const ref K lo) {
        UnsafeConstPtr<BTreeNode<K,V,A>> walk = root;
        while (this.depth < 32) {
            isize i = walk[0].lowerBound(key: lo);
            this.path[this.depth] = BTreeConstFrame::<K,V,A>.at(node: walk, i: i);
            this.depth = this.depth + 1;
            if (walk[0].isLeaf()) { this.settle(); return; }
            walk = walk[0].childConstPtr(at: i);
        }
        panic(msg: "SortedMap depth exceeded 32 — the tree is corrupt");
    }
    // Stop before the least key >= `hi`. Each node's first key >= `hi` is a candidate, and a deeper one, in its left
    // subtree, is a smaller key, so the last found is the end.
    public unsafe fn void stopAt(UnsafeConstPtr<BTreeNode<K,V,A>> root, const ref K hi) {
        UnsafeConstPtr<BTreeNode<K,V,A>> walk = root;
        while (true) {
            isize i = walk[0].lowerBound(key: hi);
            if (i < walk[0].keyCount()) { this.end = walk; this.endI = i; }
            if (walk[0].isLeaf()) { return; }
            walk = walk[0].childConstPtr(at: i);
        }
    }

    public unsafe const fn bool done() {
        if (this.depth == 0) { return true; }
        isize d = this.depth - 1;
        return this.path[d].node == this.end && this.path[d].i == this.endI;
    }
    // The position to yield now, and the walk moved past it: the subtree between this key and the next comes first.
    public unsafe fn BTreeConstFrame<K,V,A> step() {
        isize d = this.depth - 1;
        UnsafeConstPtr<BTreeNode<K,V,A>> n = this.path[d].node;
        isize i = this.path[d].i;
        this.path[d] = BTreeConstFrame::<K,V,A>.at(node: n, i: i + 1);
        if (!n[0].isLeaf()) { this.descend(n: n[0].childConstPtr(at: i + 1)); } else { this.settle(); }
        return BTreeConstFrame::<K,V,A>.at(node: n, i: i);
    }
}

// `foreach (K k in m)` and `m.range(from:, to:)`: a sorted map's keys in ascending order, each a copy, so present for a
// `Copyable` key — `Map`'s key iterator in key order. `SortedSet` hands out the same.
type view SortedMapKeyIter<K: Comparable<K> + Copyable<K>, V, A: Allocator = GlobalAllocator> implements Iterator<K> {
    BTreeWalk<K,V,A> walk;
    UnsafeConstPtr<BTreeNode<K,V,A>> root;
    UnsafeConstPtr<uint32> modsp; uint32 modsAt;
    unsafe ctor make(BTreeWalk<K,V,A> walk, UnsafeConstPtr<BTreeNode<K,V,A>> root, UnsafeConstPtr<uint32> modsp, uint32 modsAt) {
        this.walk = walk; this.root = root; this.modsp = modsp; this.modsAt = modsAt;
    }
    // The keys in [lo, hi) of the same map, empty when lo >= hi: a window the view mints over itself, as `View.slice`
    // does, since only the map's iteration grant may mint one from the map.
    public unsafe const fn SortedMapKeyIter<K,V,A> within(const ref K lo, const ref K hi) {
        BTreeWalk<K,V,A> w = BTreeWalk::<K,V,A>.empty();
        Ordering o = lo.compareTo(other: hi);
        bool open = match (o) { case Less: true; case Equal: false; case Greater: false; };
        if (open) { w.seek(root: this.root, lo: lo); w.stopAt(root: this.root, hi: hi); }
        return SortedMapKeyIter::<K,V,A>.make(walk: w, root: this.root, modsp: this.modsp, modsAt: this.modsAt);
    }
    public unsafe fn Optional<K> next() {
        if (this.modsp[0] != this.modsAt) { panic(msg: "SortedMap modified during iteration"); }
        if (this.walk.done()) { return Optional::None; }
        BTreeConstFrame<K,V,A> at = this.walk.step();
        UnsafeConstPtr<BTreeNode<K,V,A>> n = at.node;
        return Optional::Some(value: copy n[0].keyConst(at: at.i));
    }
}

// `foreach (V v in m.values())`: the values in key order, each a copy (present for a `Copyable` value).
type view SortedMapValueIter<K: Comparable<K>, V: Copyable<V>, A: Allocator = GlobalAllocator> implements Iterator<V> {
    BTreeWalk<K,V,A> walk;
    UnsafeConstPtr<uint32> modsp; uint32 modsAt;
    unsafe ctor make(BTreeWalk<K,V,A> walk, UnsafeConstPtr<uint32> modsp, uint32 modsAt) {
        this.walk = walk; this.modsp = modsp; this.modsAt = modsAt;
    }
    public unsafe fn Optional<V> next() {
        if (this.modsp[0] != this.modsAt) { panic(msg: "SortedMap modified during iteration"); }
        if (this.walk.done()) { return Optional::None; }
        BTreeConstFrame<K,V,A> at = this.walk.step();
        UnsafeConstPtr<BTreeNode<K,V,A>> n = at.node;
        return Optional::Some(value: copy n[0].valConst(at: at.i));
    }
}

// `foreach (Entry<K, V> e in m.entries())`: each pair in key order, both copied (present when both are `Copyable`).
type view SortedMapEntryIter<K: Comparable<K> + Copyable<K>, V: Copyable<V>, A: Allocator = GlobalAllocator> implements Iterator<Entry<K,V>> {
    BTreeWalk<K,V,A> walk;
    UnsafeConstPtr<uint32> modsp; uint32 modsAt;
    unsafe ctor make(BTreeWalk<K,V,A> walk, UnsafeConstPtr<uint32> modsp, uint32 modsAt) {
        this.walk = walk; this.modsp = modsp; this.modsAt = modsAt;
    }
    public unsafe fn Optional<Entry<K,V>> next() {
        if (this.modsp[0] != this.modsAt) { panic(msg: "SortedMap modified during iteration"); }
        if (this.walk.done()) { return Optional::None; }
        BTreeConstFrame<K,V,A> at = this.walk.step();
        UnsafeConstPtr<BTreeNode<K,V,A>> n = at.node;
        return Optional::Some(value: Entry.make(key: copy n[0].keyConst(at: at.i), value: copy n[0].valConst(at: at.i)));
    }
}

// The read-only twin of the mutable iterator (`foreach (const ref V v in sm.valuesConst())`, KR-175), for ANY value
// type: `valuesConst()` is a `const fn`, so everything it can reach is read-only, and so is every place this hands out.
type view SortedMapValueIterConst<K: Comparable<K>, V, A: Allocator = GlobalAllocator> implements IteratorConst<V> {
    BTreeWalk<K,V,A> walk;
    UnsafeConstPtr<BTreeNode<K,V,A>> cur = null; isize curI = 0;    // a field, as in the mutable twin: the result borrows `this`
    UnsafeConstPtr<uint32> modsp; uint32 modsAt;
    // `cur` is only really set by `next()`; it is seeded from the root, the same tree, so the borrow is honest.
    unsafe ctor make(BTreeWalk<K,V,A> walk, UnsafeConstPtr<BTreeNode<K,V,A>> root, UnsafeConstPtr<uint32> modsp, uint32 modsAt) {
        this.walk = walk; this.cur = root; this.curI = 0; this.modsp = modsp; this.modsAt = modsAt;
    }
    public unsafe fn bool hasNext() {
        if (this.modsp[0] != this.modsAt) { panic(msg: "SortedMap modified during iteration"); }
        return !this.walk.done();
    }
    public unsafe fn const ref V next() {
        BTreeConstFrame<K,V,A> at = this.walk.step();
        this.cur = at.node; this.curI = at.i;
        return this.cur[0].valConst(at: this.curI);
    }
}

// The most nodes a tree of `n` keys has: every node but the root holds at least 5 keys (a split leaves 5 and 5, and a
// removal refills a node before it can fall below 5), so (n - 1)/5 + 1.
fn isize btreeNodesFor(isize n) { return n <= 1 ? 1 : (n - 1) / 5 + 1; }
// The most internal nodes among `t`: every node but the root is one child, and every internal node has at least 6
// children but the root, which has at least 2, so t - 1 >= 6(i - 1) + 2.
fn isize btreeInternalsFor(isize t) { return (t + 3) / 6; }

// An element added where the tree's invariants say there is room; a refusal means the tree is corrupt.
fn void fitOrPanic<T>(Result<Unit, CapacityFull<T>> r) {
    match (give r) { case Ok(value: _): { } case Err(error: _): { panic(msg: "SortedMap: a node overflowed (the tree is corrupt)"); } };
}

// What an insert into a subtree answers its parent: the key was present and its value replaced; the pair fit; this
// node split, and the median pair and the new right sibling rise to the parent; or, within capacity, the boxes the
// insert needs are not spare, and the pair comes back untouched.
type enum BTreeInsert<K: Comparable<K>, V, A: Allocator> {
    Overwrote, Fit, Split(K key, V value, Owned<BTreeNode<K,V,A>, A> right), Refused(K key, V value)
}

// An internal node's child slots, in a box of their own so a leaf carries none.
type resource BTreeEdges<K: Comparable<K>, V, A: Allocator = GlobalAllocator> implements Sendable when [K: Sendable, V: Sendable, A: Sendable] {
    InlineDynamicArray<Owned<BTreeNode<K,V,A>, A>>#(12) kids;
    public ctor make() { this.kids = InlineDynamicArray.empty(); }
    public fn ref InlineDynamicArray<Owned<BTreeNode<K,V,A>, A>>#(12) slots() { return this.kids; }
    public const fn const ref InlineDynamicArray<Owned<BTreeNode<K,V,A>, A>>#(12) slotsConst() { return this.kids; }
    public fn void push(Owned<BTreeNode<K,V,A>, A> kid) { fitOrPanic(r: this.kids.add(item: give kid)); }
    // A child's `getRef` and `getRefMut`, the place returned from here: a returned place is judged by what its receiver
    // roots in, and `this.kids[at]` roots in this box, where a call's result (`slots()[at]`) roots nowhere.
    @trackCaller
    public const fn const ref V getRefIn(isize at, const ref K key) { return this.kids[at].getRef(key: key); }
    public fn ref V getRefMutIn(isize at, const ref K key) { return this.kids[at].getRefMut(key: key); }
}

// The boxes a map's tree is made of. Each is drawn from `alloc`, or is a spare that `tryReserve` made beforehand and
// that waits here empty until an insert takes it. `promised` is the most entries a reserve has asked room for: while
// the tree and its spares hold fewer boxes than that many entries can need, a box a removal frees comes back here
// instead of going to `alloc`, so the promise outlives removals (as `Map`'s reserve does). Each stack is sized to its
// bound when the promise is made, so a freed box always goes back without the stack growing.
type resource BTreeBoxes<K: Comparable<K>, V, A: Allocator = GlobalAllocator> implements Sendable when [K: Sendable, V: Sendable, A: Sendable] {
    A alloc;
    DynamicArray<Owned<BTreeNode<K,V,A>, A>, A> nodes;    // spare node boxes, each an empty leaf
    DynamicArray<Owned<BTreeEdges<K,V,A>, A>, A> edges;   // spare edge boxes, each empty
    isize promised = 0;
    isize nodesInUse = 0;   // in the tree, the root included
    isize edgesInUse = 0;   // one per internal node

    public default ctor empty() when [A: default] { }
    public ctor withAllocator(A allocator) {
        this.alloc = allocator;
        this.nodes = DynamicArray.withAllocator(allocator: allocator);
        this.edges = DynamicArray.withAllocator(allocator: allocator);
    }
    public const fn A allocator() { return this.alloc; }

    // A node box for the tree: a spare when one waits, else drawn, trapping at no room as `new` does.
    public fn Owned<BTreeNode<K,V,A>, A> node() {
        this.nodesInUse = this.nodesInUse + 1;
        Optional<Owned<BTreeNode<K,V,A>, A>> s = this.nodes.pop();
        match (give s) { case Some(value: n): { return give n; } case None: { } };
        Owned<BTreeNode<K,V,A>, A> b = new(allocator: this.alloc) BTreeNode<K,V,A>.make();
        return give b;
    }
    public fn Owned<BTreeEdges<K,V,A>, A> edgeBox() {
        this.edgesInUse = this.edgesInUse + 1;
        Optional<Owned<BTreeEdges<K,V,A>, A>> s = this.edges.pop();
        match (give s) { case Some(value: e): { return give e; } case None: { } };
        Owned<BTreeEdges<K,V,A>, A> b = new(allocator: this.alloc) BTreeEdges<K,V,A>.make();
        return give b;
    }
    // Are `nodes` node boxes and `edges` edge boxes spare?
    public const fn bool covers(isize nodes, isize edges) { return this.nodes.length() >= nodes && this.edges.length() >= edges; }

    // An emptied box the tree no longer holds: kept spare while the promise needs it, freed to `alloc` otherwise.
    public fn void keepNode(Owned<BTreeNode<K,V,A>, A> n) {
        this.nodesInUse = this.nodesInUse - 1;
        if (this.nodesInUse + this.nodes.length() < btreeNodesFor(n: this.promised)) { this.nodes.add(item: give n); return; }
    }
    public fn void keepEdges(Owned<BTreeEdges<K,V,A>, A> e) {
        this.edgesInUse = this.edgesInUse - 1;
        if (this.edgesInUse + this.edges.length() < btreeInternalsFor(t: btreeNodesFor(n: this.promised))) { this.edges.add(item: give e); return; }
    }

    // Room for a tree of `n` entries: the boxes it may need, made now and held spare, and the stacks sized to hold them.
    // A stack that must grow is made anew and swapped in only once every box is drawn, so an `Err` drops what this call
    // drew and leaves everything as it was.
    public fn Result<Unit, AllocError> tryReserve(isize n) {
        isize nb = btreeNodesFor(n: n);
        isize eb = btreeInternalsFor(t: nb);
        bool sized = this.nodes.capacity() >= nb && this.edges.capacity() >= eb;
        bool held = this.nodesInUse + this.nodes.length() >= nb && this.edgesInUse + this.edges.length() >= eb;
        if (!sized || !held) {
            DynamicArray<Owned<BTreeNode<K,V,A>, A>, A> ns = DynamicArray.withAllocator(allocator: this.alloc);
            Result<Unit, AllocError> rn = ns.tryReserve(n: nb);
            if (rn.isErr()) { return rn; }
            DynamicArray<Owned<BTreeEdges<K,V,A>, A>, A> es = DynamicArray.withAllocator(allocator: this.alloc);
            Result<Unit, AllocError> re = es.tryReserve(n: eb);
            if (re.isErr()) { return re; }
            while (this.nodesInUse + this.nodes.length() + ns.length() < nb) {
                Optional<Owned<BTreeNode<K,V,A>, A>> b = try new(allocator: this.alloc) BTreeNode<K,V,A>.make();
                match (give b) { case Some(value: x): { ns.add(item: give x); } case None: { return Result::Err(error: AllocError::NoRoom); } };
            }
            while (this.edgesInUse + this.edges.length() + es.length() < eb) {
                Optional<Owned<BTreeEdges<K,V,A>, A>> b = try new(allocator: this.alloc) BTreeEdges<K,V,A>.make();
                match (give b) { case Some(value: x): { es.add(item: give x); } case None: { return Result::Err(error: AllocError::NoRoom); } };
            }
            while (this.nodes.length() > 0) {
                Optional<Owned<BTreeNode<K,V,A>, A>> s = this.nodes.pop();
                match (give s) { case Some(value: x): { ns.add(item: give x); } case None: { } };
            }
            while (this.edges.length() > 0) {
                Optional<Owned<BTreeEdges<K,V,A>, A>> s = this.edges.pop();
                match (give s) { case Some(value: x): { es.add(item: give x); } case None: { } };
            }
            swap(a: this.nodes, b: ns);   // the old, emptied stacks drop at scope exit
            swap(a: this.edges, b: es);
        }
        if (n > this.promised) { this.promised = n; }
        return Result::Ok(value: Unit::Unit);
    }
}

// A single B-tree node. Internal to the module — reached only through `SortedMap` and its iterators. All the
// B-tree algorithms live here as methods so `this` touches its own `keys`/`vals` fields directly (the normal in-place
// field mutation); a child is reached through `kids()`, the slots in its edge box, and mutated via
// `this.kids()[c].method()` (auto-deref through the `Owned` box), and whole subtrees move via `takeKidAt`/`insertKidAt`.
type resource BTreeNode<K: Comparable<K>, V, A: Allocator = GlobalAllocator> implements Sendable when [K: Sendable, V: Sendable, A: Sendable] {
    // `serializeInto` below is this type's alone to expose, and `SortedMap` is the one caller: the map's
    // `serialize` hands the in-order element write down to its root node. Corresponding instances, which is
    // what a grant between two generic types means — `SortedMap<K,V,A>` reaches `BTreeNode<K,V,A>` and no
    // sibling instance does.
    friend SortedMap[serializeInto];
    friend SortedMap[formatInto];
    friend SortedMap[takeMinPair];   // the drain's step (KR-263)
    InlineDynamicArray<K>#(11) keys;
    InlineDynamicArray<V>#(11) vals;                     // parallel to keys (vals[i] belongs to keys[i])
    Optional<Owned<BTreeEdges<K,V,A>, A>> edges;         // None for a leaf; keys.length()+1 children for an internal node

    // An empty leaf. A node draws nothing itself: `BTreeBoxes` hands it every box it holds.
    public ctor make() { this.keys = InlineDynamicArray.empty(); this.vals = InlineDynamicArray.empty(); this.edges = Optional::None; }

    public const fn isize keyCount() { return this.keys.length(); }
    public const fn bool isLeaf() { return this.edges.isNone(); }
    public const fn bool full() { return this.keys.length() >= 11; }      // 2B-1

    // The child slots, through the edge box. Only an internal node has them.
    fn ref InlineDynamicArray<Owned<BTreeNode<K,V,A>, A>>#(12) kids() {
        match (this.edges) { case Some(value: e): { return e.slots(); } case None: { } };
        panic(msg: "SortedMap: a leaf has no children (the tree is corrupt)");
    }
    const fn const ref InlineDynamicArray<Owned<BTreeNode<K,V,A>, A>>#(12) kidsConst() {
        match (this.edges) { case Some(value: e): { return e.slotsConst(); } case None: { } };
        panic(msg: "SortedMap: a leaf has no children (the tree is corrupt)");
    }

    // The two accessors `SortedMapValueIterMut` needs on top of the existing `keyCount()`/`isLeaf()`. The
    // cursor walks node ADDRESSES rather than `Owned` boxes, because a path stack cannot hold borrows.
    // (Visibility is per-TYPE, so `public` here means "reachable from the iterator", not exported — the
    // node type itself is module-internal and never named outside this file.)
    public fn ref V valAt(isize at) { return this.vals[at]; }
    public unsafe fn UnsafePtr<BTreeNode<K,V,A>> childPtr(isize at) { return addr(of: this.kids()[at].derefMut()); }
    public const fn const ref V valConst(isize at) { return this.vals[at]; }                  // the read-only twins
    public unsafe const fn UnsafeConstPtr<BTreeNode<K,V,A>> childConstPtr(isize at) { return addr(of: this.kidsConst()[at].deref()); }
    public const fn const ref K keyConst(isize at) { return this.keys[at]; }
    // The index of this node's first key >= `key` (its key count when none is): where `BTreeWalk` enters a window.
    public const fn isize lowerBound(const ref K key) {
        isize i = 0; isize n = this.keys.length();
        while (i < n) {
            Ordering o = this.cmpKeys(a: this.keys[i], b: key);
            bool less = match (o) { case Less: true; case Equal: false; case Greater: false; };
            if (!less) { return i; }
            i = i + 1;
        }
        return n;
    }

    // Three-way compare through a `ref K` receiver so a primitive key's scalar adapter conformance resolves (a raw
    // `this.keys[i].compareTo(...)` receiver wouldn't) — the `Map.eqKeys` / `PriorityQueue.higher` idiom.
    const fn Ordering cmpKeys(const ref K a, const ref K b) { return a.compareTo(other: b); }

    // --- element hand-off helpers (move-only-safe, over the inline arrays; a node with no room here is corrupt) ---
    public fn void pushKeyVal(K key, V value) { this.insertKeyVal(i: this.keys.length(), key: give key, value: give value); }
    fn void insertKeyVal(isize i, K key, V value) {
        fitOrPanic(r: this.keys.insertAt(index: i, item: give key)); fitOrPanic(r: this.vals.insertAt(index: i, item: give value));
    }
    fn K takeKeyAt(isize i) { return this.keys.remove(index: i); }   // move the key out (+ shift)
    fn V takeValAt(isize i) { return this.vals.remove(index: i); }
    fn void pushKid(Owned<BTreeNode<K,V,A>, A> c) { fitOrPanic(r: this.kids().add(item: give c)); }
    fn void insertKidAt(isize i, Owned<BTreeNode<K,V,A>, A> c) { fitOrPanic(r: this.kids().insertAt(index: i, item: give c)); }
    public fn Owned<BTreeNode<K,V,A>, A> takeKidAt(isize i) { return this.kids().remove(index: i); }
    // The edge box handed out (`None` for a leaf), leaving this node a leaf; and an edge box taken in.
    public fn Optional<Owned<BTreeEdges<K,V,A>, A>> takeEdges() {
        Optional<Owned<BTreeEdges<K,V,A>, A>> none = Optional::None;
        return replace(place: this.edges, with: give none);
    }
    fn void attach(Owned<BTreeEdges<K,V,A>, A> e) { this.edges = Optional::Some(value: give e); }
    // Overwrite the value at `i` in place: move the old value out, install the new one. `old` drops at scope exit, and
    // must not also be dropped explicitly (see `tests/sorted_map_overwrite_owning`).
    fn void overwriteVal(isize i, V value) {
        V old = this.vals.remove(index: i);
        fitOrPanic(r: this.vals.insertAt(index: i, item: give value));
    }

    // --- read paths ---
    public const fn bool contains(const ref K key) {
        isize i = 0; isize n = this.keys.length();
        while (i < n) {
            Ordering o = this.cmpKeys(a: this.keys[i], b: key);
            int32 d = match (o) { case Equal: 0; case Greater: 1; case Less: 2; };
            if (d == 0) { return true; }
            if (d == 1) { if (this.isLeaf()) { return false; } return this.kidsConst()[i].contains(key: key); }
            i = i + 1;
        }
        if (this.isLeaf()) { return false; }
        return this.kidsConst()[i].contains(key: key);         // descend the rightmost child
    }

    public fn Optional<V> get(const ref K key) when [V: Copyable<V>] {
        isize i = 0; isize n = this.keys.length();
        while (i < n) {
            Ordering o = this.cmpKeys(a: this.keys[i], b: key);
            int32 d = match (o) { case Equal: 0; case Greater: 1; case Less: 2; };
            if (d == 0) { return Optional::Some(value: copy this.vals[i]); }
            if (d == 1) { if (this.isLeaf()) { return Optional::None; } return this.kids()[i].get(key: key); }
            i = i + 1;
        }
        if (this.isLeaf()) { return Optional::None; }
        return this.kids()[i].get(key: key);
    }

    // Borrow the stored value for `key` IN PLACE (any V — no Copyable bound), the read/mutate accessor that
    // makes a SortedMap of move-only values first-class. PANICS on an absent key (guard with `contains`),
    // like `Map.getRef`. The returned `ref V` chains up through each node's `getRef` (a place-returning call
    // whose receiver roots at `this`); it dangles if held across a structural change, the usual borrow rule.
    // The descent goes through a borrowing `match` on the edge box, so each step's place roots in `this`.
    @trackCaller   // a miss names the caller's line (KR-179)
    public const fn const ref V getRef(const ref K key) {
        isize i = 0; isize n = this.keys.length();
        while (i < n) {
            Ordering o = this.cmpKeys(a: this.keys[i], b: key);
            int32 d = match (o) { case Equal: 0; case Greater: 1; case Less: 2; };
            if (d == 0) { return this.vals[i]; }        // borrow the stored value in place
            if (d == 1) { break; }                      // it can only be in child i
            i = i + 1;
        }
        match (this.edges) { case Some(value: e): { return e.getRefIn(at: i, key: key); } case None: { } };
        panic(msg: "SortedMap.getRef: absent key");
    }
    // The writable twin: the same walk, handing back a place the caller may mutate through.
    public fn ref V getRefMut(const ref K key) {
        isize i = 0; isize n = this.keys.length();
        while (i < n) {
            Ordering o = this.cmpKeys(a: this.keys[i], b: key);
            int32 d = match (o) { case Equal: 0; case Greater: 1; case Less: 2; };
            if (d == 0) { return this.vals[i]; }
            if (d == 1) { break; }
            i = i + 1;
        }
        match (this.edges) { case Some(value: e): { return e.getRefMutIn(at: i, key: key); } case None: { } };
        panic(msg: "SortedMap.getRefMut: absent key");
    }

    // --- insert (bottom-up) ---
    // Insert or overwrite in this subtree. One descent finds `key` or the leaf it belongs in; a present key's value is
    // replaced where it is found, before anything splits or is drawn (`Map`'s rule). `run` counts the full nodes directly
    // above this one and `depth` all the nodes above it, so the leaf knows how many nodes the insert splits (itself and
    // the full run above it) and whether the root splits too, which costs a new root. That is the boxes it needs: a node
    // per split, an edge box per internal split, and a node and an edge box for a new root. Within capacity, the leaf
    // hands the pair back untouched when those are not spare.
    public fn BTreeInsert<K,V,A> insert(K key, V value, isize run, isize depth, bool withinCapacity, ref BTreeBoxes<K,V,A> boxes) {
        isize i = 0; isize n = this.keys.length(); int32 d = 2;   // 0 equal, 1 greater, 2 less (or no key left)
        while (i < n) {
            Ordering o = this.cmpKeys(a: this.keys[i], b: key);
            d = match (o) { case Less: 2; case Equal: 0; case Greater: 1; };
            if (d != 2) { break; }
            i = i + 1;
        }
        if (d == 0) { this.overwriteVal(i: i, value: give value); return BTreeInsert::Overwrote; }   // `key` drops at scope exit
        if (this.isLeaf()) {
            isize splits = this.full() ? run + 1 : 0;
            isize newRoot = splits == depth + 1 ? 1 : 0;
            isize internalSplits = splits > 1 ? splits - 1 : 0;
            if (withinCapacity && !boxes.covers(nodes: splits + newRoot, edges: internalSplits + newRoot)) {
                return BTreeInsert::Refused(key: give key, value: give value);
            }
            return this.place(i: i, key: give key, value: give value, right: Optional::None, boxes: ref boxes);
        }
        isize above = this.full() ? run + 1 : 0;
        BTreeInsert<K,V,A> below = this.kids()[i].insert(key: give key, value: give value, run: above, depth: depth + 1,
                                                         withinCapacity: withinCapacity, boxes: ref boxes);
        return match (give below) {
            case Split(key: k, value: v, right: z): { := this.place(i: i, key: give k, value: give v, right: Optional::Some(value: give z), boxes: ref boxes); }
            case Overwrote: BTreeInsert::Overwrote;
            case Fit: BTreeInsert::Fit;
            case Refused(key: k, value: v): BTreeInsert::Refused(key: give k, value: give v);
        };
    }

    // Put the pair at `i` and, in an internal node, `right` (the new sibling a split below made) at `i + 1`. A full
    // node splits around its old median: keys 0..4 stay, 6..10 and children 6..11 move to a new right sibling, and the
    // pair joins its side (Rust's `splitpoint`), so each half keeps at least 5 keys. The median and the sibling rise.
    fn BTreeInsert<K,V,A> place(isize i, K key, V value, Optional<Owned<BTreeNode<K,V,A>, A>> right, ref BTreeBoxes<K,V,A> boxes) {
        if (!this.full()) {
            this.placeAt(i: i, key: give key, value: give value, right: give right);
            return BTreeInsert::Fit;
        }
        Owned<BTreeNode<K,V,A>, A> z = boxes.node();
        while (this.keys.length() > 6) {
            K rk = this.takeKeyAt(i: 6); V rv = this.takeValAt(i: 6);
            z.pushKeyVal(key: give rk, value: give rv);
        }
        if (!this.isLeaf()) {
            Owned<BTreeEdges<K,V,A>, A> ze = boxes.edgeBox();
            while (this.kidCount() > 6) { Owned<BTreeNode<K,V,A>, A> gc = this.takeKidAt(i: 6); ze.push(kid: give gc); }
            z.attach(e: give ze);
        }
        K medK = this.takeKeyAt(i: 5); V medV = this.takeValAt(i: 5);
        if (i <= 5) { this.placeAt(i: i, key: give key, value: give value, right: give right); }
        else { z.placeAt(i: i - 6, key: give key, value: give value, right: give right); }
        return BTreeInsert::Split(key: give medK, value: give medV, right: give z);
    }
    // Insert the pair at `i`, and `right` at `i + 1` when there is one. The node has room.
    fn void placeAt(isize i, K key, V value, Optional<Owned<BTreeNode<K,V,A>, A>> right) {
        this.insertKeyVal(i: i, key: give key, value: give value);
        match (give right) { case Some(value: c): { this.insertKidAt(i: i + 1, c: give c); } case None: { } };
    }

    // The root split, and the tree grows a level without moving the root box (a field the map cannot hand out): what the
    // root holds, its left half, moves into `left` (its keys, and its edge box as one pointer), and the root becomes the
    // median over `left` and `right`, in the edge box `e`.
    public fn void growInPlace(K key, V value, Owned<BTreeNode<K,V,A>, A> left, Owned<BTreeNode<K,V,A>, A> right, Owned<BTreeEdges<K,V,A>, A> e) {
        while (this.keys.length() > 0) {
            K k = this.takeKeyAt(i: 0); V v = this.takeValAt(i: 0);
            left.pushKeyVal(key: give k, value: give v);
        }
        Optional<Owned<BTreeEdges<K,V,A>, A>> mine = this.takeEdges();
        match (give mine) { case Some(value: x): { left.attach(e: give x); } case None: { } };
        this.pushKeyVal(key: give key, value: give value);
        this.attach(e: give e);
        this.pushKid(c: give left);
        this.pushKid(c: give right);
    }
    // The root emptied (a merge pulled its last key down), and the tree drops a level without moving the root box: its
    // one child's keys and edge box move up into it, and the child's box and the root's old edge box go to `boxes`.
    public fn void shrinkInPlace(ref BTreeBoxes<K,V,A> boxes) {
        Owned<BTreeNode<K,V,A>, A> child = this.takeKidAt(i: 0);
        Optional<Owned<BTreeEdges<K,V,A>, A>> mine = this.takeEdges();
        match (give mine) { case Some(value: x): { boxes.keepEdges(e: give x); } case None: { } };
        while (child.keyCount() > 0) {
            K k = child.takeKeyAt(i: 0); V v = child.takeValAt(i: 0);
            this.pushKeyVal(key: give k, value: give v);
        }
        Optional<Owned<BTreeEdges<K,V,A>, A>> theirs = child.takeEdges();
        match (give theirs) { case Some(value: x): { this.attach(e: give x); } case None: { } };
        boxes.keepNode(n: give child);
    }

    // --- ordered min/max (leftmost / rightmost leaf) ---
    public const fn Optional<K> minKey() when [K: Copyable<K>] {
        if (this.isLeaf()) {
            if (this.keys.length() == 0) { return Optional::None; }
            return Optional::Some(value: copy this.keys[0]);
        }
        return this.kidsConst()[0].minKey();
    }
    public const fn Optional<K> maxKey() when [K: Copyable<K>] {
        if (this.isLeaf()) {
            isize n = this.keys.length();
            if (n == 0) { return Optional::None; }
            return Optional::Some(value: copy this.keys[n - 1]);
        }
        return this.kidsConst()[this.keys.length()].maxKey();
    }

    // Greatest key <= `key` (floor) / least key >= `key` (ceil), None if none. A root-to-leaf descent
    // tracking the best candidate at each level, preferring a closer one found deeper in the subtree.
    public const fn Optional<K> floor(const ref K key) when [K: Copyable<K>] {
        isize i = 0; isize n = this.keys.length(); isize cand = 0 - 1;
        while (i < n) {
            Ordering o = this.cmpKeys(a: this.keys[i], b: key);
            int32 d = match (o) { case Less: 0; case Equal: 1; case Greater: 2; };
            if (d == 1) { return Optional::Some(value: copy this.keys[i]); }
            if (d == 2) { break; }
            cand = i; i = i + 1;
        }
        if (!this.isLeaf()) {
            Optional<K> cf = this.kidsConst()[i].floor(key: key);
            bool got = match (cf) { case Some(value: x): true; case None: false; };
            if (got) { return cf; }
        }
        if (cand >= 0) { return Optional::Some(value: copy this.keys[cand]); }
        return Optional::None;
    }
    public const fn Optional<K> ceil(const ref K key) when [K: Copyable<K>] {
        isize i = 0; isize n = this.keys.length();
        while (i < n) {
            Ordering o = this.cmpKeys(a: this.keys[i], b: key);
            int32 d = match (o) { case Less: 0; case Equal: 1; case Greater: 2; };
            if (d == 1) { return Optional::Some(value: copy this.keys[i]); }
            if (d == 2) { break; }
            i = i + 1;
        }
        if (!this.isLeaf()) {
            Optional<K> cc = this.kidsConst()[i].ceil(key: key);
            bool got = match (cc) { case Some(value: x): true; case None: false; };
            if (got) { return cc; }
        }
        if (i < n) { return Optional::Some(value: copy this.keys[i]); }
        return Optional::None;
    }

    // --- delete helpers (each moves elements within the inline arrays; a freed box goes to `boxes`) ---
    const fn isize kidCount() { return match (this.edges) { case Some(value: e): e.slotsConst().length(); case None: 0; }; }
    fn Owned<BTreeNode<K,V,A>, A> takeFirstKid() { return this.kids().remove(index: 0); }
    fn Owned<BTreeNode<K,V,A>, A> takeLastKid() { return this.kids().remove(index: this.kidCount() - 1); }
    // Remove + return THIS node's own last (resp. first) pair — the value by return, the key via out-pointer
    // (no tuples; a `resource` pair can't expose fields). Used by the sibling rotations.
    fn V popLastOwnPair(out K outKey) {
        isize last = this.keys.length() - 1;
        K k = this.keys.remove(index: last); V v = this.vals.remove(index: last);
        outKey = give k; return give v;
    }
    fn V popFirstOwnPair(out K outKey) {
        K k = this.keys.remove(index: 0); V v = this.vals.remove(index: 0);
        outKey = give k; return give v;
    }
    // Fold `other`'s keys/vals/children onto the END of this node, consuming it: its emptied boxes go to `boxes`.
    fn void absorb(Owned<BTreeNode<K,V,A>, A> other, ref BTreeBoxes<K,V,A> boxes) {
        while (other.keyCount() > 0) {
            K k = other.takeKeyAt(i: 0); V v = other.takeValAt(i: 0);
            this.pushKeyVal(key: give k, value: give v);
        }
        Optional<Owned<BTreeEdges<K,V,A>, A>> oe = other.takeEdges();
        match (give oe) {
            case Some(value: e): {
                while (e.slots().length() > 0) { Owned<BTreeNode<K,V,A>, A> gc = e.slots().remove(index: 0); this.pushKid(c: give gc); }
                boxes.keepEdges(e: give e);
            }
            case None: { }
        };
        boxes.keepNode(n: give other);
    }
    // Remove + return the MAX (resp. MIN) pair of THIS subtree, rebalancing thin children on the way down so
    // the invariant holds — a delete of the extreme key. Value by return, key via out-pointer.
    fn V takeMaxPair(out K outKey, ref BTreeBoxes<K,V,A> boxes) {
        if (this.isLeaf()) {
            isize last = this.keys.length() - 1;
            K k = this.keys.remove(index: last); V v = this.vals.remove(index: last);
            outKey = give k; return give v;
        }
        isize lastChild = this.keys.length();
        isize t = lastChild;
        if (this.kids()[lastChild].keyCount() < 6) { t = this.fill(i: lastChild, boxes: ref boxes); }   // < B == thin
        return this.kids()[t].takeMaxPair(outKey: out outKey, boxes: ref boxes);
    }
    fn V takeMinPair(out K outKey, ref BTreeBoxes<K,V,A> boxes) {
        if (this.isLeaf()) {
            K k = this.keys.remove(index: 0); V v = this.vals.remove(index: 0);
            outKey = give k; return give v;
        }
        isize t = 0;
        if (this.kids()[0].keyCount() < 6) { t = this.fill(i: 0, boxes: ref boxes); }
        return this.kids()[t].takeMinPair(outKey: out outKey, boxes: ref boxes);
    }
    // Merge child i, separator keys[i]/vals[i], and child i+1 into child i (which then holds 2B-1 keys).
    fn void mergeChildren(isize i, ref BTreeBoxes<K,V,A> boxes) {
        K sepK = this.takeKeyAt(i: i); V sepV = this.takeValAt(i: i);   // separator out of THIS node
        Owned<BTreeNode<K,V,A>, A> right = this.takeKidAt(i: i + 1);      // right child out of THIS node
        this.kids()[i].pushKeyVal(key: give sepK, value: give sepV);
        this.kids()[i].absorb(other: give right, boxes: ref boxes);    // right's contents fold onto left child
    }
    // Rotate a key right (child i borrows from left sibling i-1) / left (borrows from right sibling i+1).
    fn void borrowFromPrev(isize i) {
        K sepK = this.takeKeyAt(i: i - 1); V sepV = this.takeValAt(i: i - 1);
        this.kids()[i].insertKeyVal(i: 0, key: give sepK, value: give sepV);            // separator to child front
        if (!this.kids()[i].isLeaf()) {
            Owned<BTreeNode<K,V,A>, A> lastKid = this.kids()[i - 1].takeLastKid();
            this.kids()[i].insertKidAt(i: 0, c: give lastKid);
        }
        slot K upK; V upV = this.kids()[i - 1].popLastOwnPair(outKey: out upK);         // sibling max up
        this.insertKeyVal(i: i - 1, key: give upK, value: give upV);
    }
    fn void borrowFromNext(isize i) {
        K sepK = this.takeKeyAt(i: i); V sepV = this.takeValAt(i: i);
        this.kids()[i].pushKeyVal(key: give sepK, value: give sepV);                     // separator to child end
        if (!this.kids()[i].isLeaf()) {
            Owned<BTreeNode<K,V,A>, A> firstKid = this.kids()[i + 1].takeFirstKid();
            this.kids()[i].pushKid(c: give firstKid);
        }
        slot K upK; V upV = this.kids()[i + 1].popFirstOwnPair(outKey: out upK);         // sibling min up
        this.insertKeyVal(i: i, key: give upK, value: give upV);
    }
    // Ensure child i has >= B keys before a descend: borrow from a rich sibling, else merge. Returns the child
    // index to descend into (a merge with the LEFT sibling shifts the target to i-1).
    fn isize fill(isize i, ref BTreeBoxes<K,V,A> boxes) {
        if (i != 0) { if (this.kids()[i - 1].keyCount() >= 6) { this.borrowFromPrev(i: i); return i; } }
        if (i != this.keys.length()) { if (this.kids()[i + 1].keyCount() >= 6) { this.borrowFromNext(i: i); return i; } }
        if (i != this.keys.length()) { this.mergeChildren(i: i, boxes: ref boxes); return i; }
        this.mergeChildren(i: i - 1, boxes: ref boxes); return i - 1;
    }

    // Remove `key` from THIS subtree (kept >= B keys by callers, or the root), returning its value moved out
    // (None if absent). CLRS 3-case delete: leaf; internal (replace with predecessor/successor, or merge);
    // descend (fill a thin child first). Nothing here allocates: a merge's freed boxes go to `boxes`.
    public fn Optional<V> removeKey(const ref K key, ref BTreeBoxes<K,V,A> boxes) {
        isize i = 0; isize n = this.keys.length();
        while (i < n) {
            Ordering o = this.cmpKeys(a: this.keys[i], b: key);
            int32 d = match (o) { case Less: 0; case Equal: 1; case Greater: 2; };
            if (d == 0) { i = i + 1; continue; }
            break;
        }
        bool found = false;
        if (i < n) {
            Ordering o2 = this.cmpKeys(a: this.keys[i], b: key);
            found = match (o2) { case Equal: true; case Less: false; case Greater: false; };
        }

        if (found) {
            if (this.isLeaf()) {                                 // CASE 1: leaf — remove in place
                K k = this.keys.remove(index: i);                 // drops at scope exit
                V v = this.vals.remove(index: i);
                return Optional::Some(value: give v);
            }
            if (this.kids()[i].keyCount() >= 6) {                // CASE 2a: predecessor from left child
                V removed = this.takeValAt(i: i); K oldk = this.takeKeyAt(i: i);   // `oldk` drops at scope exit
                slot K pk; V pv = this.kids()[i].takeMaxPair(outKey: out pk, boxes: ref boxes);
                this.insertKeyVal(i: i, key: give pk, value: give pv);
                return Optional::Some(value: give removed);
            }
            if (this.kids()[i + 1].keyCount() >= 6) {            // CASE 2b: successor from right child
                V removed = this.takeValAt(i: i); K oldk = this.takeKeyAt(i: i);   // `oldk` drops at scope exit
                slot K sk; V sv = this.kids()[i + 1].takeMinPair(outKey: out sk, boxes: ref boxes);
                this.insertKeyVal(i: i, key: give sk, value: give sv);
                return Optional::Some(value: give removed);
            }
            this.mergeChildren(i: i, boxes: ref boxes);          // CASE 2c: both thin — merge, then delete below
            return this.kids()[i].removeKey(key: key, boxes: ref boxes);
        }

        if (this.isLeaf()) { return Optional::None; }            // absent
        isize t = i;
        if (this.kids()[i].keyCount() < 6) { t = this.fill(i: i, boxes: ref boxes); }   // fill a thin child before descending
        return this.kids()[t].removeKey(key: key, boxes: ref boxes);
    }

    // Drop every key and value and empty this node to a leaf: each box below it, emptied the same way, goes to `boxes`.
    public fn void emptyInto(ref BTreeBoxes<K,V,A> boxes) {
        this.keys.clear(); this.vals.clear();
        Optional<Owned<BTreeEdges<K,V,A>, A>> oe = this.takeEdges();
        match (give oe) {
            case Some(value: e): {
                while (e.slots().length() > 0) {
                    Owned<BTreeNode<K,V,A>, A> c = e.slots().remove(index: e.slots().length() - 1);
                    c.emptyInto(boxes: ref boxes);
                    boxes.keepNode(n: give c);
                }
                boxes.keepEdges(e: give e);
            }
            case None: { }
        };
    }

    // Does every key write itself as TEXT — one string or one integer (MapKeyText)? Then the map is an object keyed by
    // that text on a back end that writes keyed maps (KR-136).
    public const fn bool keysAreText() when [K: Serializable] {
        isize i = 0; isize n = this.keys.length(); bool leaf = this.isLeaf();
        while (i < n) {
            if (!leaf && !this.kidsConst()[i].keysAreText()) { return false; }
            MapKeyText<K> kt = MapKeyText::<K>.make(slot: i);
            Serializer probe = kt;
            Result<Unit, Owned<Error>> __pk = this.keys[i].serialize(w: ref probe);
            bool ok = match (give __pk) { case Err(error: _): false; case Ok(value: _): kt.isText(); };
            if (!ok) { return false; }
            i = i + 1;
        }
        return leaf || this.kidsConst()[n].keysAreText();
    }

    // The in-order walk `SortedMap.format` writes with (KR-216); `first` threads the `, ` separator through the recursion.
    private const fn void formatInto(ref Formatter f, ref bool first) when [K: Formattable, V: Formattable] {
        isize i = 0; isize n = this.keys.length(); bool leaf = this.isLeaf();
        while (i < n) {
            if (!leaf) { this.kidsConst()[i].formatInto(f: ref f, first: ref first); }
            if (!first) { f.writeStr(s: ", "); }
            first = false;
            BTreeNode::<K, V, A>::formatKey(x: this.keys[i], f: ref f);
            f.writeStr(s: ": ");
            BTreeNode::<K, V, A>::formatValue(x: this.vals[i], f: ref f);
            i = i + 1;
        }
        if (!leaf) { this.kidsConst()[n].formatInto(f: ref f, first: ref first); }
    }
    static fn void formatKey(const ref K x, ref Formatter f) when [K: Formattable] { x.format(f: ref f); }
    static fn void formatValue(const ref V x, ref Formatter f) when [V: Formattable] { x.format(f: ref f); }

    // In-order emit of each entry: `keyed`, as `"text":v` in the object the map opened — the in-order walk IS the
    // order an object's keys are written in (KR-136) — and otherwise as a `{"key":k,"value":v}` object of a SORTED
    // pair array (key/value through a `ref` helper so a primitive element's adapter `serialize` resolves).
    //
    // ⚠️ MARKED because the element write lives HERE, not in `SortedMap.serialize`. A B-tree's entries are
    // spread over a tree of nodes, so an in-order write is a recursion over nodes — and a graph write has
    // to carry its object table into that recursion or every `Shared` value is written inline and
    // duplicated (measured: three entries, the shared leaf written twice, and a read that then failed with
    // "unresolved reference"). `Map` needs no mark on anything but its accessor because it writes its one
    // flat `vals` array in its own body. ⚠️ Reached only by `SortedMap`, which the grant above says: member
    // visibility is per TYPE, so a sibling type needs naming even inside one file, and the grant is what
    // its `@serializedGraphEdges` mark already implied.
    @serializedGraphEdges
    private const fn Result<Unit, Owned<Error>> serializeInto(ref Serializer w, bool keyed) when [K: Serializable, V: Serializable] {
        isize i = 0; isize n = this.keys.length(); bool leaf = this.isLeaf();
        while (i < n) {
            if (!leaf) {
                Result<Unit, Owned<Error>> __sc = this.kidsConst()[i].serializeInto(w: w, keyed: keyed);
                match (give __sc) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
            }
            if (keyed) {
                MapKeyText<K> kt = MapKeyText::<K>.make(slot: i);
                Serializer probe = kt;
                Result<Unit, Owned<Error>> __pk = this.keys[i].serialize(w: ref probe);
                match (give __pk) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
                w.field(name: copy kt.key(), id: 0ui32);
                Result<Unit, Owned<Error>> __kv = this.vals[i].serialize(w: w);
                match (give __kv) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
                i = i + 1;
                continue;
            }
            w.beginObject(count: 2);
            w.field(name: "key", id: 0ui32);
            Result<Unit, Owned<Error>> __sk = this.keys[i].serialize(w: w);
            match (give __sk) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
            w.field(name: "value", id: 1ui32);
            Result<Unit, Owned<Error>> __sv = this.vals[i].serialize(w: w);
            match (give __sv) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
            w.endObject();
            i = i + 1;
        }
        if (!leaf) {
            Result<Unit, Owned<Error>> __sl = this.kidsConst()[n].serializeInto(w: w, keyed: keyed);
            match (give __sl) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
        }
        return Result::Ok(value: Unit::Unit);
    }
}

// The ordered map. Its root is always a live `BTreeNode` (an empty leaf when the map is empty), so no path
// special-cases a null root; `len` is the entry count. Every structural change bumps `mods` so a live
// iterator can detect mid-iteration mutation.
type resource SortedMap<K: Comparable<K>, V, A: Allocator = GlobalAllocator>
        implements Copyable<This>(bare: give) when [K: Copyable<K>, V: Copyable<V>], Iterable<K> when [K: Copyable<K>],
                   ValuesIterable<SortedMapValueIter<K,V,A>> when [V: Copyable<V>],
                   EntriesIterable<SortedMapEntryIter<K,V,A>> when [K: Copyable<K>, V: Copyable<V>],
                   ValuesIterableMut<SortedMapValueIterMut<K,V,A>>,
                   ValuesIterableConst<SortedMapValueIterConst<K,V,A>>,
                   Drainable<SortedMapDrain<K,V,A>>,
                   Serializable when [K: Serializable, V: Serializable],
                   Deserializable<This> when [K: Deserializable<K>, V: Deserializable<V>, A: default],
                   MergeByKey<K, V> when [K: Deserializable<K>, V: Deserializable<V>, A: default],
                   Sendable when [K: Sendable, V: Sendable, A: Sendable],
                   Formattable when [K: Formattable, V: Formattable] {
    // Every node box, the root included, comes from `boxes`, which draws it from `A` or hands out a spare, so the
    // whole tree lives in the allocator it names.
    friend SortedMapDrain[drainNext];   // the drains take the minimum through the map's own step (KR-263)
    friend SortedSetDrain[drainNext];
    Owned<BTreeNode<K,V,A>, A> root;
    BTreeBoxes<K,V,A> boxes;                            // the allocator, and the spare boxes a reserve made
    isize len = 0; uint32 mods = 0;

    // The four ctors every growable collection has. `empty` is the canonical zero-arg build (M8c `default`) — a
    // NON-zero default: it builds a live B-tree root. A bare `SortedMap<K,V,A> r;` zero-inits `len`/`mods`,
    // default-fills `boxes`, and leaves the owning `root` for us to assign — the M8d.1 completeness gate REQUIRES `root`
    // be set before return, which building it satisfies. The two `withCapacity` builds `reserve` the boxes a tree of
    // `capacity` entries can need, so that many puts draw nothing.
    public default ctor empty() when [A: default] {
        Owned<BTreeNode<K,V,A>, A> r = this.boxes.node();
        this.root = give r;
    }
    public ctor withCapacity(isize capacity) when [A: default] {
        Owned<BTreeNode<K,V,A>, A> r = this.boxes.node();
        this.root = give r;
        this.reserve(n: capacity);
    }

    // Back the whole tree with a caller-owned allocator (e.g. an `Arena`): `boxes` takes the real handle, then the
    // root is drawn from it — mirrors `PriorityQueue::withAllocator`.
    public ctor withAllocator(A allocator) {
        this.boxes = BTreeBoxes.withAllocator(allocator: allocator);
        Owned<BTreeNode<K,V,A>, A> r = this.boxes.node();
        this.root = give r;
    }
    public ctor withCapacityAndAllocator(A allocator, isize capacity) {
        this.boxes = BTreeBoxes.withAllocator(allocator: allocator);
        Owned<BTreeNode<K,V,A>, A> r = this.boxes.node();
        this.root = give r;
        this.reserve(n: capacity);
    }

    // `${m}` writes `{k: v, k2: v2}` in key order (KR-216).
    public const fn void format(ref Formatter f) when [K: Formattable, V: Formattable] {
        f.writeStr(s: "{");
        bool first = true;
        this.root.formatInto(f: ref f, first: ref first);
        f.writeStr(s: "}");
    }

    public const fn isize length() { return this.len; }
    public const fn bool isEmpty() { return this.len == 0; }
    public const fn bool contains(const ref K key) { return this.root.contains(key: key); }
    public fn Optional<V> get(const ref K key) when [V: Copyable<V>] { return this.root.get(key: key); }
    @trackCaller
    public const fn const ref V getRef(const ref K key) { return this.root.getRef(key: key); }   // read-only place
    public fn ref V getRefMut(const ref K key) { return this.root.getRefMut(key: key); }        // the writable twin

    // Insert or overwrite. Consumes both key and value (the tree owns what it stores). A present key's value is
    // replaced in place, which needs no box; a new key may split nodes up to the root, each split drawing a box.
    public fn void put(K key, V value) {
        Result<Unit, CapacityFull<Entry<K, V>>> r = this.insertEntry(key: give key, value: give value, withinCapacity: false);
        match (give r) { case Ok(value: _): { } case Err(error: _): { panic(msg: "SortedMap.put: refused with no capacity asked (the tree is corrupt)"); } };
    }
    // `put` only where it draws nothing (KR-423, as `Map.putWithinCapacity`): a present key is overwritten in place,
    // which needs no room; a new one whose splits need boxes no `reserve` left spare comes back in `Err(Item(entry))`,
    // taken apart with `intoParts()`, and the map is unchanged. After `tryReserve(n)`, every put up to `n` entries fits.
    public fn Result<Unit, CapacityFull<Entry<K, V>>> putWithinCapacity(K key, V value) {
        return this.insertEntry(key: give key, value: give value, withinCapacity: true);
    }
    fn Result<Unit, CapacityFull<Entry<K, V>>> insertEntry(K key, V value, bool withinCapacity) {
        BTreeInsert<K,V,A> r = this.root.insert(key: give key, value: give value, run: 0, depth: 0,
                                                withinCapacity: withinCapacity, boxes: ref this.boxes);
        bool added = true;
        match (give r) {
            case Overwrote: { added = false; }
            case Fit: { }
            case Split(key: k, value: v, right: z): { this.growRoot(key: give k, value: give v, right: give z); }
            case Refused(key: k, value: v): { return Result::Err(error: CapacityFull::Item(item: Entry.make(key: give k, value: give v))); }
        };
        if (added) { this.len = this.len + 1; }
        this.mods = this.mods + 1;
        return Result::Ok(value: Unit::Unit);
    }
    // The root split: the one way a B-tree's height grows. It costs a node box for the root's left half and an edge box
    // for the root's two children (see `BTreeNode.growInPlace`).
    fn void growRoot(K key, V value, Owned<BTreeNode<K,V,A>, A> right) {
        Owned<BTreeNode<K,V,A>, A> left = this.boxes.node();
        Owned<BTreeEdges<K,V,A>, A> e = this.boxes.edgeBox();
        this.root.growInPlace(key: give key, value: give value, left: give left, right: give right, e: give e);
    }
    // The root emptied (a merge pulled its last key down): the tree drops a level.
    fn void shrinkRoot() {
        if (this.root.keyCount() > 0 || this.root.isLeaf()) { return; }
        this.root.shrinkInPlace(boxes: ref this.boxes);
    }

    // Room for `n` entries in all, as `DynamicArray.reserve`: the node and edge boxes a tree of `n` entries can need are
    // made now and held spare, so the puts up to `n` draw nothing, and the room survives removals (KR-423). A no-op
    // when the map holds `n` already.
    public fn void reserve(isize n) {
        match (this.tryReserve(n: n)) { case Ok(value: _): { } case Err(error: e): { panic(msg: e.message()); } };
    }
    // `reserve`, answering instead of trapping (Rust's `try_reserve`): `Err(TooLarge)` when the boxes' count does not fit
    // an `isize` (no allocator is asked), `Err(NoRoom)` when the allocator has none. On an `Err` the map is as it was.
    public fn Result<Unit, AllocError> tryReserve(isize n) {
        if (n <= this.len) { return Result::Ok(value: Unit::Unit); }
        return this.boxes.tryReserve(n: n);
    }

    // Remove the entry for `key`, returning its VALUE moved OUT (`None` when absent) — same ownership contract
    // as `Map.remove`. If the root emptied (a merge pulled its last key down), the tree drops a level.
    public fn Optional<V> remove(const ref K key) {
        Optional<V> r = this.root.removeKey(key: key, boxes: ref this.boxes);
        this.shrinkRoot();
        bool removed = match (r) { case Some(value: v): true; case None: false; };
        if (removed) { this.len = this.len - 1; this.mods = this.mods + 1; }
        return r;
    }

    // Smallest / largest key (None when empty) — O(log n) leftmost/rightmost spine walk.
    public const fn Optional<K> first() when [K: Copyable<K>] { if (this.len == 0) { return Optional::None; } return this.root.minKey(); }
    public const fn Optional<K> last() when [K: Copyable<K>] { if (this.len == 0) { return Optional::None; } return this.root.maxKey(); }

    // Greatest key <= `key` / least key >= `key` (None if none) — the ordered nearest-neighbour queries a
    // hash map can't answer (timelines, ranges, floor/ceil lookups). Java NavigableMap's floorKey/ceilingKey.
    public const fn Optional<K> floor(const ref K key) when [K: Copyable<K>] { return this.root.floor(key: key); }
    public const fn Optional<K> ceil(const ref K key) when [K: Copyable<K>] { return this.root.ceil(key: key); }

    // Ascending iteration, as `Map` lists (KR-424): `foreach (K k in m)` the keys, `values()` the values in key order,
    // `entries()` the pairs, each element a copy. Each walks the tree in place with a path stack, so listing allocates
    // nothing, whatever allocator the map names; a list to keep is a loop into a `DynamicArray` the caller names.
    public unsafe const fn SortedMapKeyIter<K,V,A> iterator() when [K: Copyable<K>] {
        BTreeWalk<K,V,A> w = BTreeWalk::<K,V,A>.empty();
        w.first(root: addr(of: this.root.deref()));
        return SortedMapKeyIter::<K,V,A>.make(walk: w, root: addr(of: this.root.deref()), modsp: addr(of: this.mods), modsAt: this.mods);
    }
    public unsafe const fn SortedMapValueIter<K,V,A> values() when [V: Copyable<V>] {
        BTreeWalk<K,V,A> w = BTreeWalk::<K,V,A>.empty();
        w.first(root: addr(of: this.root.deref()));
        return SortedMapValueIter::<K,V,A>.make(walk: w, modsp: addr(of: this.mods), modsAt: this.mods);
    }
    public unsafe const fn SortedMapEntryIter<K,V,A> entries() when [K: Copyable<K>, V: Copyable<V>] {
        BTreeWalk<K,V,A> w = BTreeWalk::<K,V,A>.empty();
        w.first(root: addr(of: this.root.deref()));
        return SortedMapEntryIter::<K,V,A>.make(walk: w, modsp: addr(of: this.mods), modsAt: this.mods);
    }

    // `foreach (ref V v in sm.valuesMut())` — an in-order MUTABLE walk of the live values, for ANY value
    // type (no `Copyable` bound: it hands out places, it copies nothing). The lazy twin of `values()`
    // above, and the reason it can exist at all is that it walks node ADDRESSES rather than materializing.
    // Serde's graph read half rewires this container's edge elements through here. A KEYED container
    // holds its edges in its VALUES — a key cannot be rewired in place, since that would move it in the
    // ordering/hash — so the marked accessor is `valuesMut()`, not a key or entry one.
    @serializedGraphEdges
    public unsafe fn SortedMapValueIterMut<K,V,A> valuesMut() {
        return SortedMapValueIterMut::<K,V,A>.make(root: addr(of: this.root.derefMut()),
                                                   modsp: addr(of: this.mods), modsAt: this.mods);
    }
    // `foreach (const ref V v in sm.valuesConst())` — the in-order walk, read-only, for ANY value type.
    public unsafe const fn SortedMapValueIterConst<K,V,A> valuesConst() {
        BTreeWalk<K,V,A> w = BTreeWalk::<K,V,A>.empty();
        w.first(root: addr(of: this.root.deref()));
        return SortedMapValueIterConst::<K,V,A>.make(walk: w, root: addr(of: this.root.deref()),
                                                     modsp: addr(of: this.mods), modsAt: this.mods);
    }

    // `foreach (K k in m.range(from:, to:))` — the keys in the half-open window [from, to), ascending, empty when
    // from >= to. A window on `foreach (K k in m)`, found in O(log n) and walked with no allocation.
    public const fn SortedMapKeyIter<K,V,A> range(const ref K from, const ref K to) when [K: Copyable<K>] {
        return this.iterator().within(lo: from, hi: to);
    }

    // Drop every entry, resetting to an empty single-leaf tree (keeps the root box; the others go to `boxes`).
    public fn void clear() { this.root.emptyInto(boxes: ref this.boxes); this.len = 0; this.mods = this.mods + 1; }

    // `foreach (Entry<K, V> e in m.drain())` — every pair moved out smallest key first, the map empty after the loop
    // however it ends (KR-263; see `SortedMapDrain`). Writes inside the loop are compile errors.
    public unsafe fn SortedMapDrain<K,V,A> drain() { return SortedMapDrain::<K,V,A>.over(m: addr(of: this)); }

    // The drain's step: the minimum pair taken out of the tree as `remove` takes one, the root shrunk when a merge
    // emptied it. O(log n) per pair, in order.
    fn Optional<Entry<K,V>> drainNext() {
        if (this.len == 0) { return Optional::None; }
        slot K k;
        V v = this.root.takeMinPair(outKey: out k, boxes: ref this.boxes);
        this.shrinkRoot();
        this.len = this.len - 1;
        return Optional::Some(value: Entry.make(key: give k, value: give v));
    }

    // Deep-copy the whole map (present only when both key and value are Copyable): a fresh tree in the SAME allocator,
    // an independent clone of every entry put in key order. `bare: give` — a plain hand-off still MOVES.
    public ctor copy(ref SortedMap<K,V,A> source) when [K: Copyable<K>, V: Copyable<V>] {
        SortedMap<K,V,A> result = SortedMap.withAllocator(allocator: source.boxes.allocator());
        foreach (Entry<K,V> e in source.entries()) {
            match (give e.intoParts()) { case Parts(key: k, value: v): { result.put(key: give k, value: give v); } };
        }
        return give result;
    }

    // Serializable in ASCENDING key order: as an object keyed by text when its keys are text on a back end that writes
    // keyed maps (`{"1":2,"2":3}` — the bytes a `Map` holding the same entries writes, KR-136), and otherwise as an
    // array of `{"key":k,"value":v}` objects. Deserializable `put`s each entry back (the tree re-sorts).
    public const fn Result<Unit, Owned<Error>> serialize(ref Serializer w) when [K: Serializable, V: Serializable] {
        bool keyed = w.keyedMaps() && this.root.keysAreText();
        if (keyed) { w.beginObject(count: cast<usize>(this.len)); } else { w.beginArray(count: cast<usize>(this.len)); }
        Result<Unit, Owned<Error>> __sr = this.root.serializeInto(w: w, keyed: keyed);
        match (give __sr) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
        if (keyed) { w.endObject(); } else { w.endArray(); }
        return Result::Ok(value: Unit::Unit);
    }
    // The key a merge names by its text (MergeByKey), read back as the object form's keys are.
    public fn Result<K, Owned<Error>> keyFromText(string text) when [K: Deserializable<K>] {
        MapKeyReader<K> kr = MapKeyReader::<K>.make(text: give text);
        return K.deserialize(r: kr);
    }
    // Deserializable is GlobalAllocator-only: the wire format carries no allocator handle, so it builds a
    // default `SortedMap<K,V>` (a stateful-A instance would bare-ctor a zero-init handle and crash on the
    // first `put`). Same convention as the other collections' A-ignoring deserialize.
    public ctor Result<SortedMap<K,V,A>, Owned<Error>> deserialize(Deserializer r) when [K: Deserializable<K>, V: Deserializable<V>, A: default] {
        SortedMap<K,V> result = SortedMap.empty();
        if (r.atKeyedMap()) {   // the keyed object (KR-136), its keys read back from their text
            r.beginObject(count: 0);
            while (r.moreFields()) {
                FieldKey fk = r.field();
                string text = match (give fk) {
                    case Name(name: n): { := give n; }
                    case Id(id: _): { r.fail(); := ""; }
                    case Position(rank: _): { r.fail(); := ""; }
                };
                if (r.failed()) { return Result::Err(error: DeError.make(kind: r.errorKind())); }
                MapKeyReader<K> kr = MapKeyReader::<K>.make(text: copy text);
                Result<K, Owned<Error>> __ok = K.deserialize(r: kr);
                K ok = match (give __ok) { case Ok(value: kv): { := give kv; } case Err(error: e): { return Result::Err(error: DeError::inField(error: give e, name: give text)); } };
                if (result.contains(key: ok)) {   // a key this object gave already: a strict reader refuses it (KR-359)
                    r.duplicateKey();
                    if (r.failed()) { return Result::Err(error: DeError.at(kind: r.errorKind(), field: give text)); }
                }
                Result<V, Owned<Error>> __ov = V.deserialize(r: r);
                V ov = match (give __ov) { case Ok(value: vv): { := give vv; } case Err(error: e): { return Result::Err(error: DeError::inField(error: give e, name: give text)); } };
                result.put(key: give ok, value: give ov);
            }
            r.endObject();
            return Result::Ok(value: give result);
        }
        r.beginArray();
        if (r.failed()) { return Result::Err(error: DeError.make(kind: r.errorKind())); }   // not an array/object at all: say so, never an empty `Ok`
        isize index = 0;   // the entry's place on the wire — a failure inside it is reported there
        while (r.moreElems()) {
            r.beginObject(count: 2);
            bool __f1 = r.moreFields(); FieldKey __n1 = r.field();
            Result<K, Owned<Error>> __ek = K.deserialize(r: r);   // read both at top level (a nested generic
            K k = match (give __ek) { case Ok(value: kv): { := give kv; } case Err(error: e): { return Result::Err(error: DeError::inElement(error: DeError::inField(error: give e, name: "key"), index: index)); } };
            if (result.contains(key: k)) {   // the pair array names a key twice: a strict reader refuses it (KR-359)
                r.duplicateKey();
                if (r.failed()) { return Result::Err(error: DeError.at(kind: r.errorKind(), field: "[${index}]")); }
            }
            bool __f2 = r.moreFields(); FieldKey __n2 = r.field();
            Result<V, Owned<Error>> __ev = V.deserialize(r: r);   // static call must not sit inside a match arm)
            V v = match (give __ev) { case Ok(value: vv): { := give vv; } case Err(error: e): { return Result::Err(error: DeError::inElement(error: DeError::inField(error: give e, name: "value"), index: index)); } };
            bool __f3 = r.moreFields();
            r.endObject();
            result.put(key: give k, value: give v);
            index = index + 1;
        }
        return Result::Ok(value: give result);
    }
}
