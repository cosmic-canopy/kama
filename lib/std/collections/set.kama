import { Map, MapKeyIter };
export { Set };

// A hash set over `K: Hashable + Equatable` — a thin wrapper on `Map<K, Unit>` (the value carries no
// information, so `Unit` is the zero-size payload). Move-only: it owns the backing map, which owns every
// key; the compiler-derived destructor drops the map (and thus the keys). Lookups borrow the key.
// `foreach (K k in set)` iterates the members (the map's key iterator), for a `Copyable` key.
type resource Set<K: Hashable + Equatable<K>, H: Hasher = DefaultHasher, A: Allocator = GlobalAllocator> implements Iterable<K> when [K: Copyable<K>],
        Serializable when [K: Serializable, K: Copyable<K>], Deserializable<This> when [K: Deserializable<K>],
        Sendable when [K: Sendable, H: Sendable, A: Sendable] {
    Map<K, Unit, H, A> m;

    // The four-ctor matrix (M8c). `Set` carries no `alloc` field (it wraps `Map<K,Unit,H,A> m`); the
    // capacity ctors build the inner map via the matching `Map` ctor. `empty`/`withCapacity` are the
    // default-allocator conveniences (custom `A` uses the allocator-taking ctors). A bare `Set<K,H,A> r;`
    // default-fills the inner `m` (`Map.empty()`); the M8d.1 completeness gate proves it's initialized.
    public default ctor empty() when [A: default] { }

    // Build an empty set whose backing map draws from `allocator` (e.g. an `Arena` bump handle). The
    // bare `Set()` builds an empty (cap-0) inner map that is dropped when replaced by the arena-backed one.
    public ctor withAllocator(A allocator) {
        Map<K, Unit, H, A> inner = Map.withAllocator(allocator: allocator);
        this.m = give inner;
    }

    public fn void add(K key) { this.m.put(key: give key, value: Unit::Unit); }   // idempotent (put overwrites)
    public fn void reserve(isize n) { this.m.reserve(n: n); }   // preallocate for a known-size build

    // Build an empty set already sized for `capacity` entries. M8c: now a `ctor` returning the enclosing
    // `Set<K,H,A>` (was a `static fn`), building the inner map via `Map::withCapacity`.
    public ctor withCapacity(isize capacity) when [A: default] {
        Map<K, Unit, H, A> inner = Map.withCapacity(capacity: capacity);
        this.m = give inner;
    }

    // Caller-owned allocator AND pre-sized — builds the inner map via `Map::withCapacityAndAllocator`.
    public ctor withCapacityAndAllocator(A allocator, isize capacity) {
        Map<K, Unit, H, A> inner = Map.withCapacityAndAllocator(allocator: allocator, capacity: capacity);
        this.m = give inner;
    }
    public const fn bool contains(const ref K key) { return this.m.contains(key: key); }
    // `Map.remove` now returns the removed VALUE moved out (`Optional<Unit>` here — the payload is nothing).
    // A Set has no value to reclaim, so it reports presence as a `bool`; the `Unit` binds and drops.
    public fn bool remove(const ref K key) {
        Optional<Unit> hit = this.m.remove(key: key);   // bind first — a method call isn't a valid match subject
        return match (hit) { case Some(value: u): true; case None: false; };
    }
    public const fn isize length() { return this.m.length(); }
    public fn void clear() { this.m.clear(); }
    public fn MapKeyIter<K> iterator() when [K: Copyable<K>] { return this.m.iterator(); }

    // Serializable as a JSON array of the members. Serializable needs a `Copyable` key (the key iterator yields
    // copies); deserialize just `add`s each key (no copy). A yielded `k` is a nameable local, so `k.serialize`
    // resolves for a primitive key directly.
    public const fn Result<Unit, Owned<Error>> serialize(ref Serializer w) when [K: Serializable, K: Copyable<K>] {
        w.beginArray(count: cast<usize>(this.m.length()));
        foreach (K k in this.m) {
            Result<Unit, Owned<Error>> __sr = k.serialize(w: w);
            match (give __sr) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
        }
        w.endArray();
        return Result::Ok(value: Unit::Unit);
    }
    public ctor Result<Set<K,H>, Owned<Error>> deserialize(Deserializer r) when [K: Deserializable<K>] {
        r.beginArray();
        while (r.moreElems()) {
            Result<K, Owned<Error>> __er = K.deserialize(r: r);   // bind — a match needs a named enum subject
            match (give __er) {                                     // consume: destructure-move the owning element out
                case Err(error: e): { return Result::Err(error: give e); }
                case Ok(value: v):  { this.add(key: give v); }
            };
        }
        return Result::Ok(value: give this);
    }
}
