namespace std::collections;
import std::collections::{Map, MapKeyIter};
export { Set };

// A hash set over `K: Hashable + Equatable` — a thin wrapper on `Map<K, Unit>` (the value carries no
// information, so `Unit` is the zero-size payload). Move-only: it owns the backing map, which owns every
// key; the compiler-derived destructor drops the map (and thus the keys). Lookups borrow the key.
// `foreach (K k in set)` iterates the members (the map's key iterator), for a `Copyable` key.
type resource Set<K: Hashable + Equatable> implements Iterable<K> when [K: Copyable],
        Serialize when [K: Serialize, K: Copyable], Deserialize when [K: Deserialize] {
    Map<K, Unit> m;

    // `this.m = Map()` won't infer the map's type args from the field, so build it in a typed local
    // first, then move it in (the tracked bare-generic-ctor-in-a-non-local-init gap).
    public Set() { Map<K, Unit> inner = Map(); this.m = give inner; }

    public fn void add(K key) { this.m.put(key: give key, value: Unit::Unit); }   // idempotent (put overwrites)
    public fn void reserve(int32 n) { this.m.reserve(n: n); }   // preallocate for a known-size build

    // Build an empty set already sized for `capacity` entries (K from the target type).
    public static fn Set<K> withCapacity(int32 capacity) {
        Set<K> s = Set();
        s.reserve(n: capacity);
        return give s;
    }
    public fn bool contains(ref K key) { return this.m.contains(key: key); }
    public fn bool remove(ref K key) { return this.m.remove(key: key); }
    public fn int32 length() { return this.m.length(); }
    public fn void clear() { this.m.clear(); }
    public fn MapKeyIter<K> iterator() when [K: Copyable] { return this.m.iterator(); }

    // Serialize as a JSON array of the members. Serialize needs a `Copyable` key (the key iterator yields
    // copies); deserialize just `add`s each key (no copy). A yielded `k` is a nameable local, so `k.serialize`
    // resolves for a primitive key directly.
    fn void serElem(ref K k, ref Serializer w) when [K: Serialize] { k.serialize(w: w); }
    public fn void serialize(ref Serializer w) when [K: Serialize, K: Copyable] {
        w.beginArray(count: cast<usize>(this.m.length()));
        foreach (K k in this.m) { this.serElem(k: k, w: w); }
        w.endArray();
    }
    public static fn Set<K> deserialize(Deserializer r) when [K: Deserialize] {
        Set<K> result = Set();
        r.beginArray();
        while (r.moreElems()) { result.add(key: K::deserialize(r: r)); }
        return give result;
    }
}
