namespace std::collections;
export { DynamicArray };

extern "<stdlib.h>";
extern fn Ptr malloc(usize n);
extern fn Ptr realloc(Ptr p, usize n);
extern fn void free(Ptr p);

// A by-value iterator (the `foreach (T x in list)` protocol): yields each element by value. It keeps a
// live pointer to the list's mutation counter + the value it saw at creation, and rejects a structural
// change (an `add`) made mid-iteration — the buffer may have reallocated, so its cursor would dangle.
type value DynamicArrayIter<T> implements Iterator<T> {
    Ptr<T> data; int32 pos; int32 len; Ptr<int32> modsp; int32 modsAt;
    public DynamicArrayIter(Ptr<T> data, int32 len, Ptr<int32> modsp, int32 modsAt) {
        this.data = data; this.pos = 0; this.len = len; this.modsp = modsp; this.modsAt = modsAt;
    }
    public fn Optional<T> next() {
        unsafe { if (this.modsp[0] != this.modsAt) { panic(msg: "DynamicArray modified during iteration"); } }
        if (this.pos >= this.len) { return Optional::None; }
        int32 p = this.pos; this.pos = this.pos + 1;
        unsafe { return Optional::Some(value: copy this.data[p]); }   // yield a COPY (the list keeps its element)
    }
}

// A mutable iterator (the `foreach (ref T x in list)` protocol): hasNext() + a place-returning next().
// The invalidation check lives in hasNext() (it runs before each next()).
type value DynamicArrayIterMut<T> implements IteratorMut<T> {
    Ptr<T> data; int32 pos; int32 len; Ptr<int32> modsp; int32 modsAt;
    public DynamicArrayIterMut(Ptr<T> data, int32 len, Ptr<int32> modsp, int32 modsAt) {
        this.data = data; this.pos = 0; this.len = len; this.modsp = modsp; this.modsAt = modsAt;
    }
    public fn bool hasNext() {
        unsafe { if (this.modsp[0] != this.modsAt) { panic(msg: "DynamicArray modified during iteration"); } }
        return this.pos < this.len;
    }
    public fn ref T next() { int32 p = this.pos; this.pos = this.pos + 1; unsafe { return this.data[p]; } }
}

// A growable, heap-owning, bounds-checked list (= C++ `std::vector` / Rust `Vec`). Move-only by
// default (it owns a buffer); Copyable EXACTLY when its element is — a deep copy, element by element.
// A bare hand-off MOVES (relocates the buffer); `copy` deep-copies; `give` moves. `mods` is a
// modification counter (bumped on structural change) that iterators snapshot to detect invalidation.
type resource DynamicArray<T> implements Copyable(bare: give) when [T: Copyable], IterableMut<T>, Iterable<T> when [T: Copyable],
                                  Serialize when [T: Serialize], Deserialize when [T: Deserialize] {
    Ptr<T> data; int32 len; int32 cap; int32 mods;

    public DynamicArray() { unsafe { this.data = cast<Ptr<T>>(cast<usize>(0)); } this.len = 0; this.cap = 0; this.mods = 0; }

    public fn void add(T item) {
        if (this.len == this.cap) {
            int32 nc = this.cap == 0 ? 4 : this.cap * 2;
            unsafe { this.data = cast<Ptr<T>>(realloc(p: cast<Ptr>(this.data), n: cast<usize>(nc) * sizeof(T))); }
            this.cap = nc;
        }
        unsafe { this.data[this.len] = give item; }   // relocate the element into the fresh slot (raw move)
        this.len = this.len + 1;
        this.mods = this.mods + 1;                     // structural change — invalidates any live iterator
    }

    public fn int32 length() { return this.len; }

    // Insert `item` at `index` (0..len), shifting the elements at `index..len` up one slot; `index == len`
    // is a plain append. The order-preserving counterpart to `remove` — for an ordered insert (e.g. a
    // sorted array or a B-tree node keeping its keys sorted). The tail shift goes through a LOCAL pointer
    // alias (`d[i] = d[i-1]`, a raw relocation) exactly like `remove`; the incoming element is the tracked
    // `give` hand-off into the opened slot (the field-ptr target, like `add`).
    public fn void insertAt(int32 index, T item) {
        if (index < 0 || index > this.len) { panic(msg: "DynamicArray.insertAt index out of bounds"); }
        if (this.len == this.cap) {
            int32 nc = this.cap == 0 ? 4 : this.cap * 2;
            unsafe { this.data = cast<Ptr<T>>(realloc(p: cast<Ptr>(this.data), n: cast<usize>(nc) * sizeof(T))); }
            this.cap = nc;
        }
        Ptr<T> d = this.data;
        int32 i = this.len;
        unsafe { while (i > index) { d[i] = d[i - 1]; i = i - 1; } }   // open slot `index` (raw tail shift)
        unsafe { this.data[index] = give item; }                      // tracked hand-off into the slot
        this.len = this.len + 1;
        this.mods = this.mods + 1;                                     // structural change — invalidates iterators
    }

    public ref T operator[](int32 i) {
        if (i < 0 || i >= this.len) { panic(msg: "DynamicArray index out of bounds"); }
        unsafe { return this.data[i]; }
    }

    // The by-value `foreach (T x in list)` yields COPIES, so it exists only for a Copyable element.
    // (Move-only elements — `DynamicArray<Owned>` — borrow instead: `foreach (ref T x in list)`.)
    // Each iterator gets a live pointer to `mods` (its own address) + the current value (a snapshot).
    public fn DynamicArrayIter<T> iterator() when [T: Copyable] {
        return DynamicArrayIter::<T>(data: this.data, len: this.len, modsp: addr(of: this.mods), modsAt: this.mods);
    }
    public fn DynamicArrayIterMut<T> iterMut() {
        return DynamicArrayIterMut::<T>(data: this.data, len: this.len, modsp: addr(of: this.mods), modsAt: this.mods);
    }

    // Present ONLY for a Copyable element — a deep copy (fresh buffer, each element copied).
    public fn DynamicArray<T> copy() {
        DynamicArray<T> result = DynamicArray();
        int32 i = 0;
        while (i < this.len) { result.add(item: copy this[i]); i = i + 1; }
        return result;
    }

    // Grow the buffer so at least `n` elements fit without a later reallocation (a no-op if already big
    // enough). Lets a caller who knows the size up front skip the incremental doublings.
    public fn void reserve(int32 n) {
        if (n > this.cap) {
            unsafe { this.data = cast<Ptr<T>>(realloc(p: cast<Ptr>(this.data), n: cast<usize>(n) * sizeof(T))); }
            this.cap = n;
        }
    }

    // Remove the element at `index`, returning it moved OUT, and shift the tail down one slot. Bounds-checked
    // (so it always yields a valid `T`, not an `Optional`). Discard the result to just delete — the returned
    // `T` drops cleanly. The element is relocated OUT bitwise via `takeAt` (the move-out idiom `Deque` uses);
    // a direct `T x = this[index]` is rejected as giving out of an element.
    public fn T remove(int32 index) {
        if (index < 0 || index >= this.len) { panic(msg: "DynamicArray.remove index out of bounds"); }
        T x = this.takeAt(idx: index);                 // move the element out (the slot is now stale)
        int32 i = index;
        // Relocate the tail down one slot through a LOCAL pointer alias: `d[i] = d[i+1]` is a raw store
        // (a bitwise move that leaves no owner holding a moved-from field), whereas `this.data[i] = …`
        // routes an owning element through the move-tracker and is rejected.
        Ptr<T> d = this.data;
        unsafe { while (i + 1 < this.len) { d[i] = d[i + 1]; i = i + 1; } }
        this.len = this.len - 1;
        this.mods = this.mods + 1;                      // structural change — invalidates any live iterator
        return give x;
    }

    // Remove + return the last element (moved out), or `None` when empty — the O(1) stack pop (no shift).
    // Matches `Deque.popBack` / Rust `Vec::pop`.
    public fn Optional<T> pop() {
        if (this.len == 0) { return Optional::None; }
        T x = this.takeAt(idx: this.len - 1);
        this.len = this.len - 1;
        this.mods = this.mods + 1;
        return Optional::Some(value: give x);
    }

    // Move the element at `idx` OUT of the buffer into a fresh owned local (the slot is left stale — the
    // caller either overwrites it by shifting or drops it by decrementing `len`). Bitwise-relocate through raw
    // `Ptr<T>` aliases into a zero-init'd local, then `give` — the same move-out idiom as `Deque.takeAt`.
    fn T takeAt(int32 idx) {
        T x;                                           // zero-init owned local (the move-out target)
        Ptr<T> dst = addr(of: x);
        Ptr<T> d = this.data;
        unsafe { dst[0] = d[idx]; }                    // raw bitwise move out of the slot (untracked)
        return give x;
    }

    // Exchange the elements at `i` and `j` IN PLACE (O(1), no copy, no drop) — the primitive in-place
    // algorithms need (heap sift, sort, shuffle). Move `d[i]` out to a local, relocate `d[j]` into slot `i`,
    // then `give` the local into slot `j`. The two raw stores go through a LOCAL `Ptr<T>` alias `d` — a
    // `this.data[i] = …` would route the owning element through the move-tracker and be rejected (see
    // `remove`). Not a structural change (len/buffer unchanged), so `mods` is untouched, like `operator[]`.
    public fn void swap(int32 i, int32 j) {
        if (i < 0 || i >= this.len || j < 0 || j >= this.len) { panic(msg: "DynamicArray.swap index out of bounds"); }
        if (i == j) { return; }
        T tmp = this.takeAt(idx: i);                   // move d[i] OUT (slot i now stale)
        Ptr<T> d = this.data;
        unsafe { d[i] = d[j]; }                        // relocate d[j] into slot i via a local alias (a raw
                                                       // `this.data[i] = …` move is move-tracker-rejected)
        unsafe { this.data[j] = give tmp; }            // tracked hand-off of tmp into slot j (like `Map.put`);
                                                       // tmp consumed, so it's not dropped again
    }

    // Drop every element and reset to empty (keeps the allocated buffer for reuse).
    public fn void clear() {
        int32 i = 0;
        while (i < this.len) { drop(value: this[i]); i = i + 1; }
        this.len = 0;
        this.mods = this.mods + 1;
    }

    // Membership + first-index, by ELEMENT equality — present only when the element is `Equatable`
    // (routes through its `equals`, so it works for `string` and any user `Equatable` element).
    public fn bool contains(ref T item) when [T: Equatable] { return this.indexOf(item: item) >= 0; }
    public fn int32 indexOf(ref T item) when [T: Equatable] {
        int32 i = 0;
        // `item.equals(other: this[i])`, not `this[i].equals(…)` — the receiver must be the `ref T`
        // identifier so a PRIMITIVE element (int32, whose `equals` is a scalar retro impl) resolves; a
        // buffer element `this[i]` isn't a nameable receiver. `equals` is symmetric.
        while (i < this.len) { if (item.equals(other: this[i])) { return i; } i = i + 1; }
        return 0 - 1;
    }

    // --- Serialization (present only when the element is Serialize/Deserialize) ---
    // The element method must be called through a NAMEABLE `ref T` (like `indexOf`'s `equals`), so a
    // primitive element's retro-impl `serialize`/`deserialize` resolves — a raw buffer element `this[i]`
    // isn't a nameable receiver. Hence the `serElem` helper.
    fn void serElem(ref T e, ref Serializer w) when [T: Serialize] { e.serialize(w: w); }
    // A JSON array: each element serialized in order.
    public fn void serialize(ref Serializer w) when [T: Serialize] {
        w.beginArray(count: cast<usize>(this.len));
        int32 i = 0;
        while (i < this.len) { this.serElem(e: this[i], w: w); i = i + 1; }
        w.endArray();
    }
    // Reconstruct from a JSON array — a fresh list, each element read via its own `deserialize` and moved in.
    public static fn DynamicArray<T> deserialize(Deserializer r) when [T: Deserialize] {
        DynamicArray<T> result = DynamicArray();
        r.beginArray();
        while (r.moreElems()) { result.add(item: T::deserialize(r: r)); }
        return give result;
    }

    ~DynamicArray() {   // drop each element (a no-op for a value), then free the buffer
        int32 i = 0;
        while (i < this.len) { drop(value: this[i]); i = i + 1; }
        unsafe { free(p: cast<Ptr>(this.data)); }
    }
}
