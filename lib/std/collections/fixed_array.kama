import { View, ConstView };
export { FixedArray, FixedArrayIter, FixedArrayIterMut };

extern "<string.h>";
extern fn UnsafePtr memset(UnsafePtr p, int32 value, usize n);

// A by-value iterator (the `foreach (T x in arr)` protocol): yields each element by value.
type view FixedArrayIter<T: Copyable<T>> implements Iterator<T> {
    UnsafePtr<T> data; isize pos; isize len;
    unsafe ctor make(UnsafePtr<T> data, isize len) { this.data = data; this.pos = 0; this.len = len; }
    public unsafe fn Optional<T> next() {
        if (this.pos >= this.len) { return Optional::None; }
        isize p = this.pos; this.pos = this.pos + 1;
        return Optional::Some(value: copy this.data[p]);   // yield a COPY (the array keeps its element)
    }
}

// A mutable iterator (the `foreach (ref T x in arr)` protocol): hasNext() + a place-returning next().
type view FixedArrayIterMut<T> implements IteratorMut<T> {
    UnsafePtr<T> data; isize pos; isize len;
    unsafe ctor make(UnsafePtr<T> data, isize len) { this.data = data; this.pos = 0; this.len = len; }
    public const fn bool hasNext() { return this.pos < this.len; }
    public unsafe fn ref T next() { isize p = this.pos; this.pos = this.pos + 1; return this.data[p]; }
}

// A fixed-size, heap-owning, bounds-checked array (= C++ `new T[n]` / a boxed slice). Every one of its
// `size` elements is live from construction (zero-initialized) to drop — unlike `DynamicArray`, which tracks a
// separate `len`. Move-only by default (it owns a buffer); Copyable EXACTLY when its element is.
type resource FixedArray<T, A: Allocator = GlobalAllocator> implements Copyable<This>(bare: give) when [T: Copyable<T>], IterableMut<T>, Iterable<T> when [T: Copyable<T>], Viewable<ConstView<T>>, ViewableMut<View<T>>,
                                  Serializable when [T: Serializable], Sendable when [T: Sendable, A: Sendable] {
    UnsafePtr<T> data = null; isize size = 0; A alloc;

    // Allocation is EAGER (a FixedArray has all `size` elements live from construction), so unlike the
    // growable containers the allocator can't be post-assigned after a bare ctor. The ctor allocates through
    // `this.alloc` — the default zero-size `GlobalAllocator` for the bare `FixedArray.make(size:)` path (gated
    // `when [A: default]`) — and the arena path goes through `withAllocator`, which sets the handle FIRST.
    public ctor make(isize size) when [A: default] { this.allocBuffer(size: size); }

    // Zero-initialized buffer from `this.alloc` (`allocate` returns UNINITIALIZED bytes, so `memset` restores
    // the documented zero-init semantics — a bump allocator also hands back dirty reused memory). `size <= 0`
    // leaves a null buffer so the dtor's guard skips a deallocate.
    unsafe fn void allocBuffer(isize size) {
        if (size > 0) {
            this.data = cast<UnsafePtr<T>>(unwrapPtr(o: this.alloc.allocate(bytes: cast<usize>(size) * sizeof(T))));
            memset(p: cast<UnsafePtr>(this.data), value: 0, n: cast<usize>(size) * sizeof(T));
        } else {
            this.data = cast<UnsafePtr<T>>(cast<usize>(0));
        }
        this.size = size;
    }

    // Build an `size`-element array drawn from a caller-owned allocator (e.g. an `Arena`). Sets the handle
    // on a bare (zero-init) local FIRST, then allocates through it — the eager-ctor analogue of
    // DynamicArray.withCapacityAndAllocator (no nameless-primary detour).
    public ctor withAllocator(A allocator, isize size) {
        this.alloc = allocator;
        this.allocBuffer(size: size);
    }

    public const fn isize length() { return this.size; }

    public unsafe ref T operator[](isize i) {
        if (i < 0 || i >= this.size) { panic(msg: "FixedArray index out of bounds"); }
        return this.data[i];
    }

    // The FixedArray->pointer bridge, in the two halves every accessor pair here has (`get`/`getRef`,
    // `iterator`/`iterMut`): the reading half is `const fn` and hands out the read-only pointer, so a
    // buffer held `const` reaches a `const T*` C API with no cast and no mutable borrow; the writing half
    // needs a mutable receiver. Obtaining either is safe; dereferencing is `unsafe`.
    public unsafe const fn UnsafeConstPtr<T> dataPtr() { return this.data; }
    public unsafe fn UnsafePtr<T> dataPtrMut() { return this.data; }

    // Borrow the whole array (or a sub-range) as a non-owning `View<T>` slice — zero copy. See
    // DynamicArray.view/slice; a `FixedArray` never resizes, so a view over it stays valid for the
    // array's lifetime (passed down, never stored — the `view` kind enforces it).
    public unsafe const fn ConstView<T> view() { return ConstView::<T>.over(at: this.data, count: this.size); }
    public unsafe fn View<T> viewMut() { return View::<T>.over(at: this.data, count: this.size); }
    public unsafe const fn ConstView<T> slice(isize from, isize count) {
        // Bounds-checked HERE so the panic names what the author called, then DERIVED: `view()` is this
        // container's single mint site, and `View.slice` is the view narrowing itself.
        if (from < 0 || count < 0 || from + count > this.size) { panic(msg: "FixedArray.slice out of bounds"); }
        return this.view().slice(from: from, count: count);
    }
    public unsafe fn View<T> sliceMut(isize from, isize count) {
        if (from < 0 || count < 0 || from + count > this.size) { panic(msg: "FixedArray.sliceMut out of bounds"); }
        return this.viewMut().slice(from: from, count: count);
    }

    // The by-value `foreach (T x in arr)` yields COPIES, so it exists only for a Copyable element.
    // (Move-only elements borrow instead: `foreach (ref T x in arr)`.)
    public unsafe const fn FixedArrayIter<T> iterator() when [T: Copyable<T>] { return FixedArrayIter::<T>.make(data: this.data, len: this.size); }
    public unsafe fn FixedArrayIterMut<T> iterMut() { return FixedArrayIterMut::<T>.make(data: this.data, len: this.size); }

    // Membership + first-index, by ELEMENT equality — present only when the element is `Equatable`
    // (routes through its `equals`, so it works for `string` and any user `Equatable` element).
    public const fn bool contains(const ref T item) when [T: Equatable<T>] { return this.indexOf(item: item) >= 0; }
    public const fn isize indexOf(const ref T item) when [T: Equatable<T>] {
        isize i = 0;
        // `item.equals(other: this[i])` (receiver is the `ref T` identifier) so a primitive element resolves
        // — see DynamicArray.indexOf. `equals` is symmetric.
        while (i < this.size) { if (item.equals(other: this[i])) { return i; } i = i + 1; }
        return 0 - 1;
    }

    // Present ONLY for a Copyable element — a deep copy (fresh buffer, each element copied).
    public ctor copy(ref FixedArray<T, A> source) {
        FixedArray<T, A> result = FixedArray.withAllocator(allocator: source.alloc, size: source.size);  // same arena
        isize i = 0;
        while (i < source.size) { result[i] = copy source[i]; i = i + 1; }
        return result;
    }

    // Serializable as a JSON array (element method via a nameable `ref T`, like `indexOf`). Deserializable is a
    // follow-up: an `FixedArray` is fixed-size but a JSON array's length is unknown until read, and transferring a
    // temp `DynamicArray`'s buffer into an `FixedArray` without double-dropping resource elements needs a buffer-steal ctor.
    public const fn Result<Unit, Owned<Error>> serialize(ref Serializer w) when [T: Serializable] {
        w.beginArray(count: cast<usize>(this.size));
        isize i = 0;
        while (i < this.size) {
            Result<Unit, Owned<Error>> __sr = this[i].serialize(w: w);
            match (give __sr) { case Err(error: e): { return Result::Err(error: give e); } case Ok(value: _): {} };
            i = i + 1;
        }
        w.endArray();
        return Result::Ok(value: Unit::Unit);
    }

    unsafe ~FixedArray() {   // drop each element (a no-op for a value), then release the buffer via the allocator
        isize i = 0;
        while (i < this.size) { drop(value: this[i]); i = i + 1; }
        if (this.size > 0) {
            this.alloc.deallocate(pointer: cast<UnsafePtr>(this.data), bytes: cast<usize>(this.size) * sizeof(T));
        }
    }
}
