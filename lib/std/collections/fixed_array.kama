namespace std::collections;
import std::collections::{View};
export { FixedArray };

extern "<string.h>";
extern fn Ptr memset(Ptr p, int32 value, usize n);

// A by-value iterator (the `foreach (T x in arr)` protocol): yields each element by value.
type value FixedArrayIter<T> implements Iterator<T> {
    Ptr<T> data; int32 pos; int32 len;
    public ctor make(Ptr<T> data, int32 len) { FixedArrayIter<T> r; r.data = data; r.pos = 0; r.len = len; return give r; }
    public fn Optional<T> next() {
        if (this.pos >= this.len) { return Optional::None; }
        int32 p = this.pos; this.pos = this.pos + 1;
        unsafe { return Optional::Some(value: copy this.data[p]); }   // yield a COPY (the array keeps its element)
    }
}

// A mutable iterator (the `foreach (ref T x in arr)` protocol): hasNext() + a place-returning next().
type value FixedArrayIterMut<T> implements IteratorMut<T> {
    Ptr<T> data; int32 pos; int32 len;
    public ctor make(Ptr<T> data, int32 len) { FixedArrayIterMut<T> r; r.data = data; r.pos = 0; r.len = len; return give r; }
    public fn bool hasNext() { return this.pos < this.len; }
    public fn ref T next() { int32 p = this.pos; this.pos = this.pos + 1; unsafe { return this.data[p]; } }
}

// A fixed-size, heap-owning, bounds-checked array (= C++ `new T[n]` / a boxed slice). Every one of its
// `size` elements is live from construction (zero-initialized) to drop — unlike `DynamicArray`, which tracks a
// separate `len`. Move-only by default (it owns a buffer); Copyable EXACTLY when its element is.
type resource FixedArray<T, A: Allocator = GlobalAllocator> implements Copyable(bare: give) when [T: Copyable], IterableMut<T>, Iterable<T> when [T: Copyable],
                                  Serialize when [T: Serialize] {
    Ptr<T> data; int32 size; A alloc;

    // Allocation is EAGER (a FixedArray has all `size` elements live from construction), so unlike the
    // growable containers the allocator can't be post-assigned after a bare ctor. The ctor allocates through
    // `this.alloc` — the default zero-size `GlobalAllocator` for the bare `FixedArray.make(size:)` path (gated
    // `when [A: default]`) — and the arena path goes through `withAllocator`, which sets the handle FIRST.
    public ctor make(int32 size) when [A: default] { FixedArray<T, A> r; r.allocBuffer(size: size); return give r; }

    // Zero-initialized buffer from `this.alloc` (`allocate` returns UNINITIALIZED bytes, so `memset` restores
    // the documented zero-init semantics — a bump allocator also hands back dirty reused memory). `size <= 0`
    // leaves a null buffer so the dtor's guard skips a deallocate.
    fn void allocBuffer(int32 size) {
        if (size > 0) {
            unsafe {
                this.data = cast<Ptr<T>>(unwrapPtr(o: this.alloc.allocate(bytes: cast<usize>(size) * sizeof(T))));
                memset(p: cast<Ptr>(this.data), value: 0, n: cast<usize>(size) * sizeof(T));
            }
        } else {
            unsafe { this.data = cast<Ptr<T>>(cast<usize>(0)); }
        }
        this.size = size;
    }

    // Build an `size`-element array drawn from a caller-owned allocator (e.g. an `Arena`). Sets the handle
    // on a bare (zero-init) local FIRST, then allocates through it — the eager-ctor analogue of
    // DynamicArray.withCapacityAndAllocator (no nameless-primary detour).
    public ctor withAllocator(A allocator, int32 size) {
        FixedArray<T, A> result;
        result.alloc = allocator;
        result.allocBuffer(size: size);
        return give result;
    }

    public fn int32 length() { return this.size; }

    public ref T operator[](int32 i) {
        if (i < 0 || i >= this.size) { panic(msg: "FixedArray index out of bounds"); }
        unsafe { return this.data[i]; }
    }

    // The safe FixedArray->pointer bridge: obtaining the buffer pointer is safe; dereferencing it is `unsafe`.
    public fn Ptr<T> dataPtr() { return this.data; }

    // Borrow the whole array (or a sub-range) as a non-owning `View<T>` slice — zero copy. See
    // DynamicArray.view/slice; a `FixedArray` never resizes, so a view over it stays valid for the
    // array's lifetime (passed down, never stored — the `view` kind enforces it).
    public fn View<T> view() { return View::<T>.make(data: this.data, len: this.size); }
    public fn View<T> slice(int32 from, int32 count) {
        if (from < 0 || count < 0 || from + count > this.size) { panic(msg: "FixedArray.slice out of bounds"); }
        if (count == 0) { return View::<T>.make(data: this.data, len: 0); }
        unsafe { return View::<T>.make(data: addr(of: this.data[from]), len: count); }
    }

    // The by-value `foreach (T x in arr)` yields COPIES, so it exists only for a Copyable element.
    // (Move-only elements borrow instead: `foreach (ref T x in arr)`.)
    public fn FixedArrayIter<T> iterator() when [T: Copyable] { return FixedArrayIter::<T>.make(data: this.data, len: this.size); }
    public fn FixedArrayIterMut<T> iterMut() { return FixedArrayIterMut::<T>.make(data: this.data, len: this.size); }

    // Membership + first-index, by ELEMENT equality — present only when the element is `Equatable`
    // (routes through its `equals`, so it works for `string` and any user `Equatable` element).
    public fn bool contains(ref T item) when [T: Equatable] { return this.indexOf(item: item) >= 0; }
    public fn int32 indexOf(ref T item) when [T: Equatable] {
        int32 i = 0;
        // `item.equals(other: this[i])` (receiver is the `ref T` identifier) so a primitive element resolves
        // — see DynamicArray.indexOf. `equals` is symmetric.
        while (i < this.size) { if (item.equals(other: this[i])) { return i; } i = i + 1; }
        return 0 - 1;
    }

    // Present ONLY for a Copyable element — a deep copy (fresh buffer, each element copied).
    public fn FixedArray<T, A> copy() {
        FixedArray<T, A> result = FixedArray::withAllocator(allocator: this.alloc, size: this.size);  // same arena
        int32 i = 0;
        while (i < this.size) { result[i] = copy this[i]; i = i + 1; }
        return result;
    }

    // Serialize as a JSON array (element method via a nameable `ref T`, like `indexOf`). Deserialize is a
    // follow-up: an `FixedArray` is fixed-size but a JSON array's length is unknown until read, and transferring a
    // temp `DynamicArray`'s buffer into an `FixedArray` without double-dropping resource elements needs a buffer-steal ctor.
    fn Result<Unit, Owned<Error>> serElem(ref T e, ref Serializer w) when [T: Serialize] { return e.serialize(w: w); }
    public fn Result<Unit, Owned<Error>> serialize(ref Serializer w) when [T: Serialize] {
        w.beginArray(count: cast<usize>(this.size));
        int32 i = 0;
        while (i < this.size) {
            Result<Unit, Owned<Error>> __sr = this.serElem(e: this[i], w: w);
            match (give __sr) { case Err(e): { return Result::Err(error: give e); } case Ok(_): {} };
            i = i + 1;
        }
        w.endArray();
        return Result::Ok(value: Unit::Unit);
    }

    ~FixedArray() {   // drop each element (a no-op for a value), then release the buffer via the allocator
        int32 i = 0;
        while (i < this.size) { drop(value: this[i]); i = i + 1; }
        if (this.size > 0) {
            unsafe { this.alloc.deallocate(pointer: cast<Ptr>(this.data), bytes: cast<usize>(this.size) * sizeof(T)); }
        }
    }
}
