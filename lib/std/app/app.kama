
export { run, TickFn, quit };

// A target-agnostic application run-loop. NATIVE: a plain `while (tick(state))` loop. WEB (wasm): driven by
// emscripten's main loop, which YIELDS to the browser/Node event loop between ticks — so async I/O (sockets,
// timers) actually makes progress (a synchronous busy-loop on the web never sees events). This is the same
// frame loop a game uses: drain input + network, step the world, render, once per tick.
//
// Opt-in: import it, or roll your own over the same primitives (a native `while`, or a direct
// `emscripten_set_main_loop`). `tick` returns 1 to continue, 0 to stop, and owns its own `state` (passed as
// `arg`, since the loop is host-driven on the web). On the web run() does NOT return — the loop is driven by
// the host and the tick ends the program itself when its work is done.
extern "kama_app.h";
// `@callerThread`: both loops call the tick on the thread that called `run` — native is a plain
// `while (tick(state))`, and emscripten drives it from the browser/Node event loop on the main thread.
// So a module `static` the tick touches is the same object `run`'s caller sees. (The reason the tick
// takes `state` at all is that it should not need one: own the frame state and pass it through.)
@callerThread fnptr int32 TickFn(UnsafePtr state);
extern fn void kama_run_loop(TickFn tick, UnsafePtr state);
extern fn void kama_app_exit(int32 code);

unsafe fn void run(TickFn tick, UnsafePtr state) { kama_run_loop(tick: tick, state: state); }

// Terminate the program with `code`, correctly on both targets. On the web a plain libc exit() is ignored
// while the run loop keeps the runtime alive, so this forces a true shutdown; on native it is exit().
unsafe fn void quit(int32 code) { kama_app_exit(code: code); }
