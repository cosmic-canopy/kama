
// Signed binary fixed-point — the no-FPU answer for audio / DSP / sensor math on cores without an FPU
// (Cortex-M0, AVR). A `value` (stack, copied, no alloc) wrapping one backing integer `raw` = the real
// number * 2^F. `Fixed<int32, 16>` is the classic Q16.16: integer part [-32768, 32767], fractional
// resolution 1/65536 (~1.5e-5). Pure library over the shipped operator overloading — no compiler support
// needed; the emitted C is plain integer arithmetic (no libcalls).
//
// Both halves of the format are parameters, and neither is a name:
//
//  * `B` is the STORAGE, and it is passed rather than computed. kama has no type-level computation, and
//    acquiring some to map a bit count onto a width would be out of proportion to one type — Rust's
//    `fixed` and C++'s `fixed_point<Rep, Exponent>` pass storage explicitly for the same reason. What `B`
//    must supply is stated once, as the `FixedBacking` bound (backing.kama), so the arithmetic below is
//    written once at no width in particular.
//  * `F` is the fraction, a CONST GENERIC parameter — an ordinary value inside these bodies, which is why
//    the scale is `1 << F` here and was a literal `65536` at eight sites in the Fixed16_16 this replaces.
//
// The pairing of the two is the part a comment cannot enforce, so it does not have to: the `comptime
// assert` below is checked once per instantiation, against the backing's own width, and `Fixed<int8, 16>`
// is a compile error naming both halves. That check is two general language features composing
// (`sizeof` folding and `comptime assert`), not a rule about this type.
//
// Overflow follows the language default: the base `+ - * /` operators TRAP on overflow in debug builds (a
// fixed-point overflow is a real bug in value math). The `sat*` methods are the explicit never-trap
// alternative (they clamp to the representable range). Model twin: std::time::Duration.
export { Fixed };

type value Fixed<B: FixedBacking<B>, const F: int32> implements Equatable<This>, Comparable<This> {
    comptime assert(cond: F > 0 && F < cast<int32>(sizeof(B)) * 8,
                    msg: "a Q-format's fractional bits must fit its backing and leave the sign bit");

    public B raw;   // the real value * 2^F

    public ctor of(B raw)              { this.raw = raw; }
    public ctor fromInt(int32 n)       { return Fixed::<B, F>.of(raw: B.fromWide(v: cast<int64>(n) << F)); }   // traps if out of range
    public ctor one()                  { return Fixed::<B, F>.of(raw: B.fromWide(v: 1i64 << F)); }
    public ctor fromFloat(float64 x)   { return Fixed::<B, F>.of(raw: B.fromWide(v: cast<int64>(x * cast<float64>(1i64 << F)))); }
    public ctor fromFloat32(float32 x) { return Fixed::<B, F>.of(raw: B.fromWide(v: cast<int64>(x * cast<float32>(1i64 << F)))); }

    // Divide rather than shift: a right shift floors, and `toInt` truncates toward zero, so the two
    // disagree on every negative fraction (-1.5 is -1, not -2).
    public const fn int32   toInt()     { return cast<int32>(this.raw.wide() / (1i64 << F)); }
    public const fn float64 toFloat()   { return cast<float64>(this.raw.wide()) / cast<float64>(1i64 << F); }
    public const fn float32 toFloat32() { return cast<float32>(this.raw.wide()) / cast<float32>(1i64 << F); }

    // Every operator is the same three steps — widen into the accumulator, do the arithmetic at width,
    // narrow back. The narrowing cast inside `fromWide` is the overflow signal.
    public This operator+(This r) { return Fixed::<B, F>.of(raw: B.fromWide(v: this.raw.wide() + r.raw.wide())); }
    public This operator-(This r) { return Fixed::<B, F>.of(raw: B.fromWide(v: this.raw.wide() - r.raw.wide())); }
    public This operator-()       { return Fixed::<B, F>.of(raw: B.fromWide(v: 0i64 - this.raw.wide())); }
    // mul/div re-scale as well as widen: a product carries 2F fractional bits, a quotient none.
    public This operator*(This r) { return Fixed::<B, F>.of(raw: B.fromWide(v: (this.raw.wide() * r.raw.wide()) >> F)); }
    public This operator/(This r) { return Fixed::<B, F>.of(raw: B.fromWide(v: (this.raw.wide() << F) / r.raw.wide())); }

    // Comparison comes from the contracts, not from `operator==` & co. — `==`/`!=` call `equals`,
    // `<`/`>`/`<=`/`>=` call `compareTo`. Conforming also makes a Fixed a `Map` key (with `Hashable`)
    // and a `SortedSet`/`PriorityQueue` element, which the raw operators never did.
    public const fn bool equals(const ref This other) { return this.raw.wide() == other.raw.wide(); }
    public const fn Ordering compareTo(const ref This other) {
        if (this.raw.wide() < other.raw.wide()) { return Ordering::Less; }
        if (this.raw.wide() > other.raw.wide()) { return Ordering::Greater; }
        return Ordering::Equal;
    }

    // Saturating variants — never trap: the accumulator is the same, only the narrowing differs.
    public const fn This satAdd(This r) { return Fixed::<B, F>.of(raw: B.clampWide(v: this.raw.wide() + r.raw.wide())); }
    public const fn This satSub(This r) { return Fixed::<B, F>.of(raw: B.clampWide(v: this.raw.wide() - r.raw.wide())); }
    public const fn This satMul(This r) { return Fixed::<B, F>.of(raw: B.clampWide(v: (this.raw.wide() * r.raw.wide()) >> F)); }
}
