
// Explicit wrapping (two's-complement) signed arithmetic — the opt-in escape hatch for INTENTIONAL
// overflow (hashing, checksums, PRNGs, bit tricks), which otherwise TRAPS in debug builds. Each is
// computed in the unsigned type — unsigned overflow is always defined-wrap and never traps — then
// reinterpreted back to signed. So these never trap, in any build.
//
// The crossings are `bitcast`, not `cast`, and the comment above is why: this is a REINTERPRET of the
// same 32 (or 64) bits, not a conversion of a value. `cast` preserves the value, so it would trap on
// exactly the inputs these exist to serve — `wrappingAddI32(int32Max(), 1)` produces 2147483648 as a
// `uint32`, which is not an `int32`. Same width, all the bits: that is `bitcast`'s definition.
export { wrappingAddI32, wrappingSubI32, wrappingMulI32, wrappingNegI32,
         wrappingAddI64, wrappingSubI64, wrappingMulI64, wrappingNegI64 };

// Each result goes through a named local because `bitcast` reads its operand's type statically and an
// arithmetic expression is not one it resolves (SPEC § bitcast: "bind it to a local first").
fn int32 wrappingAddI32(int32 a, int32 b) { uint32 r = bitcast<uint32>(a) + bitcast<uint32>(b); return bitcast<int32>(r); }
fn int32 wrappingSubI32(int32 a, int32 b) { uint32 r = bitcast<uint32>(a) - bitcast<uint32>(b); return bitcast<int32>(r); }
fn int32 wrappingMulI32(int32 a, int32 b) { uint32 r = bitcast<uint32>(a) * bitcast<uint32>(b); return bitcast<int32>(r); }
fn int32 wrappingNegI32(int32 a)          { uint32 r = 0ui32 - bitcast<uint32>(a);             return bitcast<int32>(r); }

fn int64 wrappingAddI64(int64 a, int64 b) { uint64 r = bitcast<uint64>(a) + bitcast<uint64>(b); return bitcast<int64>(r); }
fn int64 wrappingSubI64(int64 a, int64 b) { uint64 r = bitcast<uint64>(a) - bitcast<uint64>(b); return bitcast<int64>(r); }
fn int64 wrappingMulI64(int64 a, int64 b) { uint64 r = bitcast<uint64>(a) * bitcast<uint64>(b); return bitcast<int64>(r); }
fn int64 wrappingNegI64(int64 a)          { uint64 r = 0ui64 - bitcast<uint64>(a);             return bitcast<int64>(r); }
