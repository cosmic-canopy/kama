
import {
    std::io::IoError, std::io::IoErrorKind,
    std::io::Descriptor,
    std::io::lastError,
    std::io::Reader,
    std::io::Writer,
    std::collections::DynamicArray,
    std::collections::FixedArray,
    std::collections::View, std::collections::ConstView,
    std::time::Timestamp,
    std::path::parent,
    std::path::join,
    std::ptr::nonNull,
    std::encoding::utf8::decode, std::encoding::utf8::Utf8Error,
    std::process::UserId, std::process::GroupId,
};

export { File, OpenMode, Metadata, FileKind, Permissions, readFile, writeFile, readText, writeText, stat, symlinkStat,
         readDir, remove, createDir, createDirWith, createDirAll, removeDir, removeDirAll, rename, exists, setPermissions };

// POSIX/Windows file bindings — see kama_os.h. Structs (`stat`, `dirent`, `DIR`) stay opaque; kama holds
// only `int32` fds, `UnsafePtr` handles, and scalar out-params.
extern "kama_os.h";
extern fn int32  kama_open_read(UnsafeConstPtr<cchar> path);
extern fn int32  kama_open_create(UnsafeConstPtr<cchar> path);
extern fn int32  kama_open_append(UnsafeConstPtr<cchar> path);
extern fn int32  kama_open_create_mode(UnsafeConstPtr<cchar> path, uint32 mode, int32 append);
extern fn int32  kama_mkdir_mode(UnsafeConstPtr<cchar> path, uint32 mode);
extern fn int32  kama_set_permissions(UnsafeConstPtr<cchar> path, uint32 mode);
extern fn isize  kama_read(int32 fd, UnsafePtr<uint8> buf, usize n);
extern fn isize  kama_write(int32 fd, UnsafeConstPtr<uint8> buf, usize n);
extern fn int32  kama_close_fd(int32 fd);
// A stat's owner and group: a uid and gid on Linux and macOS, a SID each on Windows (a length of 0 where the file's
// security descriptor cannot be read).
@compileFor(!OS_WINDOWS)
extern fn int32  kama_path_meta(UnsafeConstPtr<cchar> path, int32 follow, UnsafePtr<uint64> outSize, UnsafePtr<int32> outKind,
                                UnsafePtr<int64> outMtimeNs, UnsafePtr<uint32> outMode, UnsafePtr<uint32> outUid,
                                UnsafePtr<uint32> outGid);
@compileFor(!OS_WINDOWS)
extern fn int32  kama_fd_meta(int32 fd, UnsafePtr<uint64> outSize, UnsafePtr<int32> outKind, UnsafePtr<int64> outMtimeNs,
                              UnsafePtr<uint32> outMode, UnsafePtr<uint32> outUid, UnsafePtr<uint32> outGid);
@compileFor(OS_WINDOWS)
extern fn int32  kama_path_meta(UnsafeConstPtr<cchar> path, int32 follow, UnsafePtr<uint64> outSize, UnsafePtr<int32> outKind,
                                UnsafePtr<int64> outMtimeNs, UnsafePtr<uint32> outMode, UnsafePtr<uint8> outOwner,
                                UnsafePtr<int32> outOwnerLen, UnsafePtr<uint8> outGroup, UnsafePtr<int32> outGroupLen);
@compileFor(OS_WINDOWS)
extern fn int32  kama_fd_meta(int32 fd, UnsafePtr<uint64> outSize, UnsafePtr<int32> outKind, UnsafePtr<int64> outMtimeNs,
                              UnsafePtr<uint32> outMode, UnsafePtr<uint8> outOwner, UnsafePtr<int32> outOwnerLen,
                              UnsafePtr<uint8> outGroup, UnsafePtr<int32> outGroupLen);
extern fn int32  kama_unlink(UnsafeConstPtr<cchar> path);
extern fn isize  kama_desc_dup(isize h, int32 kind);
extern fn int32  kama_mkdir(UnsafeConstPtr<cchar> path);
extern fn int32  kama_rmdir(UnsafeConstPtr<cchar> path);
extern fn int32  kama_is_symlink(UnsafeConstPtr<cchar> path);
extern fn int32  kama_rename(UnsafeConstPtr<cchar> from, UnsafeConstPtr<cchar> to);
extern fn int32  kama_exists(UnsafeConstPtr<cchar> path);
extern fn UnsafePtr    kama_diropen(UnsafeConstPtr<cchar> path);
extern fn string kama_dirnext(UnsafePtr dirp);
extern fn int32  kama_dirclose(UnsafePtr dirp);
extern fn int32  kama_last_error();
extern fn int32  kama_EINTR();

// How `File.open` opens. `Write` CREATES and TRUNCATES; `Append` creates and seeks to the end on every
// write, which is the only way concurrent appenders (a log from two processes) do not overwrite each
// other — a seek-then-write cannot promise that, because the two steps are not one operation.
//
// A file either one creates asks for `rw-rw-rw-` and the process umask narrows it (`rw-r--r--` under the
// usual `022`) — every language's default. On Windows it inherits its directory's access list.
type enum OpenMode { Read, Write, Append }

// The nine permission bits a file carries — read, write and execute, for its owner, its group and everyone
// else — in the Unix model on every platform (KR-92). On Windows they are written and read back as an access
// list (kama_os.h says how), and two things there have no bit: the group maps weakly (a file's group is
// usually the machine's "None", which every local user belongs to), and Administrators can take ownership of
// any file, as root can read any file.
//
// Code written by hand names the bits — `Permissions::OwnerRead | Permissions::OwnerWrite` — and a mode number
// from outside the program (a config file, a C API) goes through `fromMode`. Nothing else makes one, so a
// `Permissions` never holds a bit outside the nine: setuid, setgid and the sticky bit mean nothing on
// Windows, and a bit that does nothing on one platform is what this type exists to avoid.
@generate(Equatable)
type value Permissions implements Formattable, Sendable {
    uint32 bits;

    ctor fromBits(uint32 bits) { this.bits = bits; }
    friend metadataOf[fromBits];

    public comptime Permissions OwnerRead    = Permissions.fromBits(bits: 0o400);
    public comptime Permissions OwnerWrite   = Permissions.fromBits(bits: 0o200);
    public comptime Permissions OwnerExecute = Permissions.fromBits(bits: 0o100);
    public comptime Permissions GroupRead    = Permissions.fromBits(bits: 0o040);
    public comptime Permissions GroupWrite   = Permissions.fromBits(bits: 0o020);
    public comptime Permissions GroupExecute = Permissions.fromBits(bits: 0o010);
    public comptime Permissions OtherRead    = Permissions.fromBits(bits: 0o004);
    public comptime Permissions OtherWrite   = Permissions.fromBits(bits: 0o002);
    public comptime Permissions OtherExecute = Permissions.fromBits(bits: 0o001);

    // A mode number from outside the program — its nine bits, or `Err(InvalidInput)` when it carries anything
    // else: setuid (0o4000), setgid (0o2000), sticky (0o1000), or the file-type bits a raw `st_mode` holds.
    // Mask it yourself (`mode & 0o777`) when dropping those is what you mean; nothing drops them for you.
    public ctor Result<Permissions, IoError> fromMode(uint32 mode) {
        if ((mode & ~0o777ui32) != 0ui32) { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); }
        return Result::Ok(value: Permissions.fromBits(bits: mode));
    }

    // Every bit either side grants.
    public Permissions operator|(Permissions rhs) { return Permissions.fromBits(bits: this.bits | rhs.bits); }

    // Does this set grant every bit of `p`?
    public const fn bool has(Permissions p) { return (this.bits & p.bits) == p.bits; }

    // The mode number (`0o644`), for a log line or a C API.
    public const fn uint32 mode() { return this.bits; }

    // `rw-r--r--`: how `ls -l` shows a file's permissions, without its file-type column.
    public const fn void format(ref Formatter f) {
        uint32 bit = 0o400ui32;
        int32 i = 0;
        while (i < 9) {
            char c = i % 3 == 0 ? 'r' : (i % 3 == 1 ? 'w' : 'x');
            f.writeChar(c: (this.bits & bit) != 0ui32 ? c : '-');
            bit = bit >> 1ui32;
            i = i + 1;
        }
    }
}

// What the filesystem records about a path.
//
// `modified` is a wall-clock stamp, so comparing two of them tells you which is newer and nothing about
// how long ago; it also moves backward when the clock does (see `std::time::Timestamp`). Resolution is
// whatever the filesystem records — nanoseconds on macOS, Linux and the wasm VFS, whole seconds on
// Windows (`_stat64` has no sub-second field); kama_os.h picks the spelling per libc.
//
// `permissions` are what the file RECORDS, not what would happen: root ignores them, and on Windows an
// access list can say more than nine bits can (see `Permissions`). The one bit that used to stand alone
// here, `readOnly`, is `!permissions.has(p: Permissions::OwnerWrite)` — one way to ask it (KR-92).
//
// `owner` and `group` are the account the file belongs to and its group, from the same stat, so they describe
// the same file as `permissions` (KPG-31: libpq lets a private key be group-readable only when root owns it).
// On Linux and macOS they are the stat's `st_uid` and `st_gid`, always known. On Windows they are the SIDs the
// file's security descriptor names — the descriptor the stat reads for `permissions` anyway — and `None` where
// this account may not read it (another account's private file, where `permissions` is an approximation). A
// `symlinkStat` of a link reports the link's own. The twins are whole types, like `UserId`'s: what an owner IS
// differs by OS, and each keeps its own form.
@compileFor(!OS_WINDOWS)
@generate(of)
type value Metadata implements Sendable {
    public usize size;
    public FileKind kind;
    public Timestamp modified;
    public Permissions permissions;
    public UserId owner;
    public GroupId group;

    public const fn bool isDir() { return match (this.kind) { case Dir: true; case _: false; }; }
    public const fn bool isFile() { return match (this.kind) { case File: true; case _: false; }; }
    public const fn bool isSymlink() { return match (this.kind) { case Symlink: true; case _: false; }; }
}

@compileFor(OS_WINDOWS)
@generate(of)
type value Metadata implements Sendable {
    public usize size;
    public FileKind kind;
    public Timestamp modified;
    public Permissions permissions;
    public Optional<UserId> owner;
    public Optional<GroupId> group;

    public const fn bool isDir() { return match (this.kind) { case Dir: true; case _: false; }; }
    public const fn bool isFile() { return match (this.kind) { case File: true; case _: false; }; }
    public const fn bool isSymlink() { return match (this.kind) { case Symlink: true; case _: false; }; }
}

// What a path names: a regular file, a directory, or one of the other things a filesystem holds (peer KPG-18:
// libpq refuses a `.pgpass` that is not a plain file — `PGPASSFILE=/dev/null` turns it off, and a FIFO would block
// the connect — and `Metadata` used to say only whether it was a directory). `Symlink` is seen only by
// `symlinkStat`, which does not follow the link. Windows reports a file, a directory, a character device (`NUL`, a
// console), a pipe as `Fifo`, and a symbolic link or junction; a block device and a socket are what POSIX adds.
type enum FileKind implements Sendable { File, Dir, Symlink, Fifo, CharDevice, BlockDevice, Socket, Other }

// The seam's kind code (kama_os.h, kama__file_kind) as a FileKind.
fn FileKind fileKind(int32 code) {
    if (code == 0) { return FileKind::File; }
    if (code == 1) { return FileKind::Dir; }
    if (code == 2) { return FileKind::Symlink; }
    if (code == 3) { return FileKind::Fifo; }
    if (code == 4) { return FileKind::CharDevice; }
    if (code == 5) { return FileKind::BlockDevice; }
    if (code == 6) { return FileKind::Socket; }
    return FileKind::Other;
}

@compileFor(!OS_WINDOWS)
unsafe fn Result<Metadata, IoError> metadataOf(int32 rc, uint64 sz, int32 kind, int64 mtime, uint32 mode, uint32 uid, uint32 gid) {
    if (rc != 0) { return Result::Err(error: lastError()); }
    return Result::Ok(value: Metadata.of(size: cast<usize>(sz), kind: fileKind(code: kind), modified: Timestamp.fromUnixNanos(n: mtime),
                                         permissions: Permissions.fromBits(bits: mode & 0o777ui32),
                                         owner: UserId.of(raw: uid), group: GroupId.of(raw: gid)));
}

@compileFor(!OS_WINDOWS)
unsafe fn Result<Metadata, IoError> pathMetadata(const ref string path, int32 follow) {
    uint64 sz = 0ui64;
    int32 kind = 0;
    int64 mtime = 0i64;
    uint32 mode = 0ui32;
    uint32 uid = 0ui32;
    uint32 gid = 0ui32;
    int32 rc = kama_path_meta(path: path.cstr(), follow: follow, outSize: addr(of: sz), outKind: addr(of: kind),
                              outMtimeNs: addr(of: mtime), outMode: addr(of: mode), outUid: addr(of: uid), outGid: addr(of: gid));
    return metadataOf(rc: rc, sz: sz, kind: kind, mtime: mtime, mode: mode, uid: uid, gid: gid);
}

@compileFor(!OS_WINDOWS)
unsafe fn Result<Metadata, IoError> fdMetadata(int32 fd) {
    uint64 sz = 0ui64;
    int32 kind = 0;
    int64 mtime = 0i64;
    uint32 mode = 0ui32;
    uint32 uid = 0ui32;
    uint32 gid = 0ui32;
    int32 rc = kama_fd_meta(fd: fd, outSize: addr(of: sz), outKind: addr(of: kind), outMtimeNs: addr(of: mtime),
                            outMode: addr(of: mode), outUid: addr(of: uid), outGid: addr(of: gid));
    return metadataOf(rc: rc, sz: sz, kind: kind, mtime: mtime, mode: mode, uid: uid, gid: gid);
}

// A SID the seam copied out, as an account: `None` for a length of 0 (a descriptor this account may not read).
@compileFor(OS_WINDOWS)
fn Optional<UserId> sidUser(const ref InlineArray<uint8>#(68) b, int32 len) {
    if (len == 0) { return Optional::None; }
    return match (UserId.fromSid(bytes: b.view().slice(from: 0, count: cast<isize>(len)))) {
        case Ok(value: u): Optional::Some(value: u);
        case Err(error: e): Optional::None;
    };
}

@compileFor(OS_WINDOWS)
fn Optional<GroupId> sidGroup(const ref InlineArray<uint8>#(68) b, int32 len) {
    if (len == 0) { return Optional::None; }
    return match (GroupId.fromSid(bytes: b.view().slice(from: 0, count: cast<isize>(len)))) {
        case Ok(value: g): Optional::Some(value: g);
        case Err(error: e): Optional::None;
    };
}

@compileFor(OS_WINDOWS)
unsafe fn Result<Metadata, IoError> metadataOf(int32 rc, uint64 sz, int32 kind, int64 mtime, uint32 mode,
                                               const ref InlineArray<uint8>#(68) owner, int32 ownerLen,
                                               const ref InlineArray<uint8>#(68) grp, int32 groupLen) {
    if (rc != 0) { return Result::Err(error: lastError()); }
    return Result::Ok(value: Metadata.of(size: cast<usize>(sz), kind: fileKind(code: kind), modified: Timestamp.fromUnixNanos(n: mtime),
                                         permissions: Permissions.fromBits(bits: mode & 0o777ui32),
                                         owner: sidUser(b: owner, len: ownerLen), group: sidGroup(b: grp, len: groupLen)));
}

@compileFor(OS_WINDOWS)
unsafe fn Result<Metadata, IoError> pathMetadata(const ref string path, int32 follow) {
    uint64 sz = 0ui64;
    int32 kind = 0;
    int64 mtime = 0i64;
    uint32 mode = 0ui32;
    InlineArray<uint8>#(68) owner = [0; 68];
    InlineArray<uint8>#(68) grp = [0; 68];
    int32 ownerLen = 0;
    int32 groupLen = 0;
    int32 rc = kama_path_meta(path: path.cstr(), follow: follow, outSize: addr(of: sz), outKind: addr(of: kind),
                              outMtimeNs: addr(of: mtime), outMode: addr(of: mode), outOwner: addr(of: owner[0]),
                              outOwnerLen: addr(of: ownerLen), outGroup: addr(of: grp[0]), outGroupLen: addr(of: groupLen));
    return metadataOf(rc: rc, sz: sz, kind: kind, mtime: mtime, mode: mode, owner: owner, ownerLen: ownerLen,
                      grp: grp, groupLen: groupLen);
}

@compileFor(OS_WINDOWS)
unsafe fn Result<Metadata, IoError> fdMetadata(int32 fd) {
    uint64 sz = 0ui64;
    int32 kind = 0;
    int64 mtime = 0i64;
    uint32 mode = 0ui32;
    InlineArray<uint8>#(68) owner = [0; 68];
    InlineArray<uint8>#(68) grp = [0; 68];
    int32 ownerLen = 0;
    int32 groupLen = 0;
    int32 rc = kama_fd_meta(fd: fd, outSize: addr(of: sz), outKind: addr(of: kind), outMtimeNs: addr(of: mtime),
                            outMode: addr(of: mode), outOwner: addr(of: owner[0]), outOwnerLen: addr(of: ownerLen),
                            outGroup: addr(of: grp[0]), outGroupLen: addr(of: groupLen));
    return metadataOf(rc: rc, sz: sz, kind: kind, mtime: mtime, mode: mode, owner: owner, ownerLen: ownerLen,
                      grp: grp, groupLen: groupLen);
}

// An open file that closes its descriptor on drop (RAII). Move-only. Implements the streaming byte substrate
// (`std::io::Reader`/`Writer`), so serde streams straight to/from disk (`JsonSerializer::<File>` / `deserializeJsonStream`).
type resource File implements Reader, Writer, Sendable {
    // The empty niche is -1, not 0 (force-explicit-field-init makes the field default the place to
    // SAY so). A bare/moved-from slot therefore reads -1 and the destructor skips it, while fd 0
    // stays an ownable descriptor — stdin is a real handle, and `fd > 0` used to make it unownable
    // for no reason other than that zero doubled as "empty". Rust's `OwnedFd` niche.
    int32 fd = -1;
    // Wrap a descriptor kama itself just opened (`open`, `create`, and std::process's pipe ends — its one caller
    // outside this file, granted below). Private: a descriptor from anywhere else arrives as a
    // `std::io::Descriptor` and enters through `adopt`. -1 is an empty File.
    ctor make(int32 fd) { this.fd = fd; }
    friend std::process::Command::start[make];

    // Adopt an owned descriptor (`std::io::Descriptor`) — one received over a Unix socket, or made from a raw
    // number by `Descriptor.adopt(raw:)`. On Windows it must be a file's (`InvalidInput` for a socket's, which is closed).
    public ctor Result<File, IoError> adopt(Descriptor descriptor) {
        return match (descriptor.release(asSocket: false)) {
            case Err(error: e): Result::Err(error: e);
            case Ok(value: h): Result::Ok(value: File.make(fd: cast<int32>(h)));
        };
    }
    // Give the descriptor up as a `Descriptor`, leaving this File empty (its drop closes nothing).
    public fn Descriptor takeDescriptor() { int32 f = this.fd; this.fd = -1; return Descriptor.adopt(raw: cast<isize>(f)); }
    // A second descriptor for this same open file, closed independently — what `sendDescriptors` consumes when
    // you keep this File.
    public unsafe fn Result<Descriptor, IoError> duplicateDescriptor() {
        isize d = kama_desc_dup(h: cast<isize>(this.fd), kind: 0);
        if (d < 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Descriptor.adopt(raw: d));
    }

    // The raw descriptor (for a readiness Poller etc.), mirroring TcpStream.rawHandle(). Borrow-only — the
    // File still owns the fd and closes it on drop.
    public const fn int32 rawFd() { return this.fd; }

    // Close the descriptor NOW (idempotent) instead of waiting for drop — e.g. to send EOF down a pipe
    // (std::process closeStdin). Zeroes the fd so the destructor's `fd > 0` guard won't double-close.
    public unsafe fn void close() { if (this.fd >= 0) { int32 rc = kama_close_fd(fd: this.fd); this.fd = -1; } }

    // Open a file for reading or writing (Write creates/truncates). The returned `File` closes on drop.
    public unsafe ctor Result<File, IoError> open(const ref string path, OpenMode mode) {
        int32 fd = match (mode) {
            case Read:   kama_open_read(path: path.cstr());
            case Write:  kama_open_create(path: path.cstr());
            case Append: kama_open_append(path: path.cstr());
        };
        if (fd < 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: File.make(fd: fd));
    }

    // Open for writing with EXACTLY these permissions — the form for a file whose permissions matter (a
    // secret, a key, an executable script). `Write` creates or truncates, `Append` creates or appends; `Read`
    // creates nothing, so it takes no permissions and is `Err(InvalidInput)`.
    //
    // Exact, on every platform: the umask does not narrow what is asked for (a plain `open` is the call it
    // narrows), and a file that already exists is given the permissions BEFORE it is truncated or written —
    // so a secret never lands in a file someone else could already read. That is the gap Go documents and
    // leaves open (`O_TRUNC` keeps the old mode). A filesystem that cannot hold the permissions (FAT, some
    // network mounts) makes this an error, never a file left open; a file this call made is removed again.
    //
    // ⚠️ What no permission can revoke: a process that already had the file open before this call keeps
    // reading through its descriptor. For a secret that must never have been readable, write a new file (a
    // fresh name) and `rename` it into place.
    //
    // On Windows the bits become an access list — the owner and SYSTEM always, the group and Everyone only
    // for the bits they are given, inheriting nothing wider — see `Permissions` and kama_os.h.
    public unsafe ctor Result<File, IoError> openWith(const ref string path, OpenMode mode, Permissions permissions) {
        if (mode == OpenMode::Read) { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); }
        int32 fd = kama_open_create_mode(path: path.cstr(), mode: permissions.mode(),
                                         append: mode == OpenMode::Append ? 1 : 0);
        if (fd < 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: File.make(fd: fd));
    }

    // Read up to `into.length()` bytes into `into`; returns the count (0 = end of file). EINTR-retried.
    // The `Reader` contract shape — fills a borrowed byte view (View's `operator[]` panics on an empty view,
    // so a zero-length request short-circuits to Ok(0)).
    public unsafe fn Result<isize, IoError> read(View<uint8> into) {
        if (into.length() == 0) { return Result::Ok(value: 0); }
        while (true) {
            isize n = kama_read(fd: this.fd, buf: addr(of: into[0]), n: cast<usize>(into.length()));
            if (n >= 0) { return Result::Ok(value: n); }
            if (kama_last_error() != kama_EINTR()) { return Result::Err(error: lastError()); }
        }
    }

    // The `Writer` partial-write PRIMITIVE: one `kama_write` (EINTR-retried), returning the count actually
    // written (may be `< length`). The free `writeAll(Writer, View)` loops over this to send every byte.
    public unsafe fn Result<isize, IoError> write(ConstView<uint8> bytes) {
        if (bytes.length() == 0) { return Result::Ok(value: 0); }
        while (true) {
            isize n = kama_write(fd: this.fd, buf: bytes.dataPtr(), n: cast<usize>(bytes.length()));
            if (n >= 0) { return Result::Ok(value: n); }
            if (kama_last_error() != kama_EINTR()) { return Result::Err(error: lastError()); }
        }
    }

    // The `Writer` flush: our fs layer is unbuffered (the OS buffers), so there is nothing to drain.
    public fn Result<Unit, IoError> flush() { return Result::Ok(value: Unit::Unit); }

    // What the filesystem records about this OPEN file (`fstat`) — so a check and the read after it are about one
    // file, where checking the path first leaves a moment for it to be pointed elsewhere. libpq checks `.pgpass`
    // this way: open, then refuse it unless it is a plain file that only its owner can read (KPG-18).
    public unsafe fn Result<Metadata, IoError> metadata() { return fdMetadata(fd: this.fd); }

    // Read the whole file to EOF into an owning byte buffer.
    public unsafe fn Result<DynamicArray<uint8>, IoError> readAll() {
        DynamicArray<uint8> buf = DynamicArray.empty();
        FixedArray<uint8> scratch = FixedArray.make(size: 65536);
        bool eof = false;
        while (!eof) {
            isize n = kama_read(fd: this.fd, buf: addr(of: scratch[0]), n: cast<usize>(scratch.length()));
            if (n < 0) {
                if (kama_last_error() == kama_EINTR()) { continue; }
                return Result::Err(error: lastError());
            }
            if (n == 0) {
                eof = true;
            } else {
                int32 got = cast<int32>(n);
                int32 i = 0;
                while (i < got) { buf.add(item: scratch[i]); i = i + 1; }
            }
        }
        return Result::Ok(value: give buf);
    }

    // Write the whole buffer, looping until every byte is sent (partial writes + EINTR handled).
    public unsafe fn Result<isize, IoError> writeAll(const ref DynamicArray<uint8> bytes) {
        isize total = bytes.length();
        isize off = 0;
        while (off < total) {
            isize remaining = total - off;
            isize n = kama_write(fd: this.fd, buf: addr(of: bytes[off]), n: cast<usize>(remaining));
            if (n < 0) {
                if (kama_last_error() == kama_EINTR()) { continue; }
                return Result::Err(error: lastError());
            }
            off = off + n;
        }
        return Result::Ok(value: total);
    }

    // The test is `>= 0`, not `> 0`, and that is the point: explicit field init let the empty niche be
    // SAID (`int32 fd = -1`) instead of falling out of a zeroed struct, so **fd 0 — stdin — is an ownable
    // descriptor** rather than being unownable just because zero doubled as "empty".
    // "Drop only if live" (A/B) stops the compiler from dropping a `{0}` on a field-first-write or a
    // `match(give …)` payload extraction, and `slot` now covers the last STATIC residual: an unassigned
    // `slot File f;` has no destructor emitted at all. The guard nevertheless STAYS, for a reason no
    // static analysis can discharge — `close()` above re-arms the sentinel at runtime, so an explicitly
    // closed File still gets its ordinary drop and must not close(-1).
    unsafe ~File() { if (this.fd >= 0) { int32 rc = kama_close_fd(fd: this.fd); } }
}

// Read an entire file into an owning byte buffer (opens, reads to EOF, closes on drop).
fn Result<DynamicArray<uint8>, IoError> readFile(const ref string path) {
    Result<File, IoError> r = File.open(path: path, mode: OpenMode::Read);
    return match (r) {
        case Ok(value: f):  f.readAll();                       // f closes at arm end (RAII)
        case Err(error: e): Result::Err(error: e);
    };
}

// Create/truncate a file and write the whole buffer to it.
fn Result<isize, IoError> writeFile(const ref string path, const ref DynamicArray<uint8> bytes) {
    Result<File, IoError> r = File.open(path: path, mode: OpenMode::Write);
    return match (r) {
        case Ok(value: f):  f.writeAll(bytes: bytes);
        case Err(error: e): Result::Err(error: e);
    };
}

// Read an entire file as TEXT — the one-call form every comparator has (Rust `fs::read_to_string`, Go
// `os.ReadFile` + a conversion, Python `open().read()`). Before it, writing or reading a string meant a
// hand loop over `s[i]` into a `DynamicArray`, because the byte API was the only API.
//
// ⚠️ It VALIDATES, so a binary file read as text is `Err(InvalidInput)` rather than an ill-formed
// `string` that `.chars()` later reads garbage out of. That is Rust's `read_to_string` (`InvalidData`)
// and Python's `decode` (raises), and it is the invariant kama already claims for `string`. A caller who
// wants the bytes whatever they are has `readFile`, which is unchanged.
unsafe fn Result<string, IoError> readText(const ref string path) {
    Result<DynamicArray<uint8>, IoError> r = readFile(path: path);
    return match (r) {
        case Err(error: e): Result::Err(error: e);
        case Ok(value: b):  textOf(bytes: ref b);
    };
}

// The decode half of `readText`, split out because a `borrow` window is a statement and a `match` arm
// wants an expression. `Utf8Error` carries WHERE the bytes stopped being text; `IoError` has no variant
// that can hold an offset, so the position is lost at this boundary — a caller that needs it reads the
// file with `readFile` and calls `std::encoding::utf8::decode` itself.
unsafe fn Result<string, IoError> textOf(const ref DynamicArray<uint8> bytes) {
    borrow bytes.view() as v {
        Result<string, Utf8Error> d = decode(bytes: v);
        return match (give d) {
            case Ok(value: s):  Result::Ok(value: give s);
            case Err(error: u): Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput));
        };
    }
}

// Create/truncate a file and write a string's UTF-8 bytes to it. No conversion and no copy: `bytes()` is
// a borrow of the string's own storage, which is what made this a one-liner rather than a second loop.
unsafe fn Result<isize, IoError> writeText(const ref string path, const ref string text) {
    Result<File, IoError> r = File.open(path: path, mode: OpenMode::Write);
    return match (r) {
        case Ok(value: f):  f.write(bytes: text.bytes());
        case Err(error: e): Result::Err(error: e);
    };
}

// Everything the filesystem records about a path, in one call. A symbolic link is followed: this describes what
// it points at.
unsafe fn Result<Metadata, IoError> stat(const ref string path) { return pathMetadata(path: path, follow: 1); }

// `stat` for the link itself: a path that is a symbolic link (or a Windows junction) is `FileKind::Symlink`, with its
// own size and time, and is not followed. Any other path answers as `stat` does. Rust's `symlink_metadata`.
unsafe fn Result<Metadata, IoError> symlinkStat(const ref string path) { return pathMetadata(path: path, follow: 0); }



// Does the path exist? A plain `bool`, not a `Result`: "no" and "the lookup failed" are the same answer
// to this question, and a caller that needs to tell them apart wants `stat`.
//
// ⚠️ It is a SNAPSHOT, and acting on it is the time-of-check/time-of-use race every language's docs warn
// about: between `exists` and the `open` that follows, another process can create or delete the path. To
// use a file, open it and handle the error; `exists` is for reporting, not for guarding.
unsafe fn bool exists(const ref string path) {
    return kama_exists(path: path.cstr()) != 0;
}

// Create ONE directory. Err(AddrInUse-free) — an existing path reports the platform's error (POSIX EEXIST
// surfaces as `Other`), and a missing PARENT reports `NotFound`; `createDirAll` is the one that makes
// parents.
unsafe fn Result<Unit, IoError> createDir(const ref string path) {
    if (kama_mkdir(path: path.cstr()) != 0) { return Result::Err(error: lastError()); }
    return Result::Ok(value: Unit::Unit);
}

// Create ONE directory with EXACTLY these permissions — `createDir`'s form for a directory that must stay
// private (`0o700` for a key store). Exact as `File.openWith` is: the umask does not narrow it, and a filesystem
// that cannot hold the permissions is an error — the directory this call made is removed again.
unsafe fn Result<Unit, IoError> createDirWith(const ref string path, Permissions permissions) {
    if (kama_mkdir_mode(path: path.cstr(), mode: permissions.mode()) != 0) { return Result::Err(error: lastError()); }
    return Result::Ok(value: Unit::Unit);
}

// Set a path's permissions — exactly, and checked afterwards: a filesystem that cannot hold them is an error,
// not a silent no-op. It follows a link, as `chmod` does. Changing another user's file is PermissionDenied. On
// Windows, granting the owner write also clears the old DOS read-only attribute, which would otherwise still
// refuse the write the new permissions allow.
unsafe fn Result<Unit, IoError> setPermissions(const ref string path, Permissions permissions) {
    if (kama_set_permissions(path: path.cstr(), mode: permissions.mode()) != 0) { return Result::Err(error: lastError()); }
    return Result::Ok(value: Unit::Unit);
}

// Create a directory and every missing parent, and report success when it already exists — the
// `mkdir -p` contract, which is what makes it usable at start-up without a check first.
//
// Recursion walks PARENTS, so its depth is the path's component count, not the tree's size.
unsafe fn Result<Unit, IoError> createDirAll(const ref string path) {
    if (path.isEmpty()) { return Result::Ok(value: Unit::Unit); }
    if (kama_exists(path: path.cstr()) != 0) { return Result::Ok(value: Unit::Unit); }
    match (parent(path: path)) {
        case None: { }
        case Some(value: up): {
            match (createDirAll(path: up)) {
                case Err(error: e): { return Result::Err(error: e); }
                case Ok(value: u): { }
            };
        }
    };
    if (kama_mkdir(path: path.cstr()) != 0) {
        // Another process may have made it between the check and the call — that race is exactly what
        // `mkdir -p` is expected to absorb, so an existing directory is still success.
        if (kama_exists(path: path.cstr()) != 0) { return Result::Ok(value: Unit::Unit); }
        return Result::Err(error: lastError());
    }
    return Result::Ok(value: Unit::Unit);
}

// Remove ONE empty directory. A non-empty one is refused by the platform rather than emptied — that is
// `rmdir`, and `removeDirAll` is the one that recurses.
unsafe fn Result<Unit, IoError> removeDir(const ref string path) {
    if (kama_rmdir(path: path.cstr()) != 0) { return Result::Err(error: lastError()); }
    return Result::Ok(value: Unit::Unit);
}

// Remove a directory and everything under it — `rm -rf`, and the one function in this module that can
// destroy data it was not pointed at, so it is worth saying exactly what it will and will not do.
//
// ⚠️ It does NOT follow a symlink. An entry that is a link is UNLINKED, never descended into. Without
// that check a link inside the tree pointing anywhere at all — `/`, a home directory — gets emptied
// instead: that is CVE-2022-21658 in Rust's `remove_dir_all`, and the same bug in Go, Python and npm.
// The check is `lstat`-based, so it is honest about the type without resolving it.
//
// ⚠️ What it still cannot promise is atomicity against a racing attacker: between the type check and the
// recursion, a directory could be swapped for a link. Closing that needs `openat`/`unlinkat` against a
// directory HANDLE rather than a path, which this seam does not carry. Safe for your own temp trees;
// do not aim it at a directory another user can write to.
unsafe fn Result<Unit, IoError> removeDirAll(const ref string path) {
    match (readDir(path: path)) {
        case Err(error: e): { return Result::Err(error: e); }
        case Ok(value: names): {
            isize i = 0;
            while (i < names.length()) {
                string child = join(path: path, with: names[i]);
                i = i + 1;
                if (kama_is_symlink(path: child.cstr()) != 0) {
                    // A link: remove the LINK. Descending would delete whatever it points at.
                    if (kama_unlink(path: child.cstr()) != 0) { return Result::Err(error: lastError()); }
                    continue;
                }
                bool isDir = false;
                match (stat(path: child)) {
                    case Err(error: e2): { return Result::Err(error: e2); }
                    case Ok(value: m): { isDir = m.isDir(); }
                };
                if (isDir) {
                    match (removeDirAll(path: child)) {
                        case Err(error: e3): { return Result::Err(error: e3); }
                        case Ok(value: u): { }
                    };
                } else if (kama_unlink(path: child.cstr()) != 0) {
                    return Result::Err(error: lastError());
                }
            }
        }
    };
    return removeDir(path: path);
}

// Rename or move a path, REPLACING an existing destination — POSIX `rename`'s behaviour, which the
// Windows branch asks for explicitly so the same call does the same thing on both. Both ends must be on
// the same filesystem; a cross-device move reports the platform error rather than silently copying.
unsafe fn Result<Unit, IoError> rename(const ref string from, const ref string to) {
    if (kama_rename(from: from.cstr(), to: to.cstr()) != 0) { return Result::Err(error: lastError()); }
    return Result::Ok(value: Unit::Unit);
}

// Delete a file. Ok on success; Err(NotFound) if the path did not exist.
unsafe fn Result<Unit, IoError> remove(const ref string path) {
    if (kama_unlink(path: path.cstr()) != 0) { return Result::Err(error: lastError()); }
    return Result::Ok(value: Unit::Unit);
}

// DynamicArray a directory's entries (excluding "." and ".."), each as an owned string.
unsafe fn Result<DynamicArray<string>, IoError> readDir(const ref string path) {
    UnsafePtr dirp = match (nonNull(p: kama_diropen(path: path.cstr()))) {
        case Some(value: d): d;
        case None: { return Result::Err(error: lastError()); }
    };
    DynamicArray<string> names = DynamicArray.empty();
    while (true) {
        string name = kama_dirnext(dirp: dirp);
        if (name.isEmpty()) { break; }              // end of directory
        if (name == ".")  { continue; }
        if (name == "..") { continue; }
        names.add(item: give name);
    }
    int32 rc = kama_dirclose(dirp: dirp);
    return Result::Ok(value: give names);
}
