namespace std::fs;

import std::io::{IoError, lastError, Reader, Writer};
import std::collections::{DynamicArray, FixedArray, View};

export { File, OpenMode, Metadata, readFile, writeFile, stat, readDir, remove };

// POSIX/Windows file bindings — see kama_os.h. Structs (`stat`, `dirent`, `DIR`) stay opaque; kama holds
// only `int32` fds, `Ptr` handles, and scalar out-params.
extern "kama_os.h";
extern fn int32  kama_open_read(Ptr<int8> path);
extern fn int32  kama_open_create(Ptr<int8> path);
extern fn isize  kama_read(int32 fd, Ptr<uint8> buf, usize n);
extern fn isize  kama_write(int32 fd, Ptr<uint8> buf, usize n);
extern fn int32  kama_close_fd(int32 fd);
extern fn int32  kama_fstat_size(int32 fd, Ptr<uint64> outSize, Ptr<int32> outIsDir);
extern fn int32  kama_path_stat(Ptr<int8> path, Ptr<uint64> outSize, Ptr<int32> outIsDir);
extern fn int32  kama_unlink(Ptr<int8> path);
extern fn Ptr    kama_diropen(Ptr<int8> path);
extern fn string kama_dirnext(Ptr dirp);
extern fn int32  kama_dirclose(Ptr dirp);
extern fn int32  kama_last_error();
extern fn int32  kama_EINTR();

enum OpenMode { Read, Write }

// File metadata (extensible — mtime/permissions later).
@generate(of)
type value Metadata {
    public usize size;
    public bool isDir;
}

// An open file that closes its descriptor on drop (RAII). Move-only. Implements the streaming byte substrate
// (`std::io::Reader`/`Writer`), so serde streams straight to/from disk (`JsonWriter::<File>` / `decodeFrom`).
type resource File implements Reader, Writer {
    int32 fd;
    // Adopt an already-open fd (e.g. a child pipe end from std::process, mirroring TcpStream.make). Prefer
    // `open` for files. The File closes this fd on drop (RAII); pass 0 for an empty/moved-from sentinel.
    public ctor make(int32 fd) { File r; r.fd = fd; return give r; }

    // The raw descriptor (for a readiness Poller etc.), mirroring TcpStream.rawHandle(). Borrow-only — the
    // File still owns the fd and closes it on drop.
    public fn int32 rawFd() { return this.fd; }

    // Close the descriptor NOW (idempotent) instead of waiting for drop — e.g. to send EOF down a pipe
    // (std::process closeStdin). Zeroes the fd so the destructor's `fd > 0` guard won't double-close.
    public fn void close() { if (this.fd > 0) { int32 rc = kama_close_fd(fd: this.fd); this.fd = 0; } }

    // Open a file for reading or writing (Write creates/truncates). The returned `File` closes on drop.
    public ctor Result<File, IoError> open(ref string path, OpenMode mode) {
        int32 fd = match (mode) {
            case Read:  kama_open_read(path: path.cstr());
            case Write: kama_open_create(path: path.cstr());
        };
        if (fd < 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: File.make(fd: fd));
    }

    // Read up to `into.length()` bytes into `into`; returns the count (0 = end of file). EINTR-retried.
    // The `Reader` contract shape — fills a borrowed byte view (View's `operator[]` panics on an empty view,
    // so a zero-length request short-circuits to Ok(0)).
    public fn Result<usize, IoError> read(View<uint8> into) {
        if (into.length() == 0) { return Result::Ok(value: cast<usize>(0)); }
        while (true) {
            isize n = kama_read(fd: this.fd, buf: addr(of: into[0]), n: cast<usize>(into.length()));
            if (n >= 0) { return Result::Ok(value: cast<usize>(n)); }
            if (kama_last_error() != kama_EINTR()) { return Result::Err(error: lastError()); }
        }
    }

    // The `Writer` partial-write PRIMITIVE: one `kama_write` (EINTR-retried), returning the count actually
    // written (may be `< length`). The free `writeAll(Writer, View)` loops over this to send every byte.
    public fn Result<usize, IoError> write(View<uint8> bytes) {
        if (bytes.length() == 0) { return Result::Ok(value: cast<usize>(0)); }
        while (true) {
            isize n = kama_write(fd: this.fd, buf: addr(of: bytes[0]), n: cast<usize>(bytes.length()));
            if (n >= 0) { return Result::Ok(value: cast<usize>(n)); }
            if (kama_last_error() != kama_EINTR()) { return Result::Err(error: lastError()); }
        }
    }

    // The `Writer` flush: our fs layer is unbuffered (the OS buffers), so there is nothing to drain.
    public fn Result<Unit, IoError> flush() { return Result::Ok(value: Unit::Unit); }

    // Read the whole file to EOF into an owning byte buffer.
    public fn Result<DynamicArray<uint8>, IoError> readAll() {
        DynamicArray<uint8> buf = DynamicArray.empty();
        FixedArray<uint8> scratch = FixedArray.make(size: 65536);
        bool eof = false;
        while (!eof) {
            isize n = kama_read(fd: this.fd, buf: addr(of: scratch[0]), n: cast<usize>(scratch.length()));
            if (n < 0) {
                if (kama_last_error() == kama_EINTR()) { continue; }
                return Result::Err(error: lastError());
            }
            if (n == 0) {
                eof = true;
            } else {
                int32 got = cast<int32>(n);
                int32 i = 0;
                while (i < got) { buf.add(item: scratch[i]); i = i + 1; }
            }
        }
        return Result::Ok(value: give buf);
    }

    // Write the whole buffer, looping until every byte is sent (partial writes + EINTR handled).
    public fn Result<usize, IoError> writeAll(ref DynamicArray<uint8> bytes) {
        int32 total = cast<int32>(bytes.length());
        int32 off = 0;
        while (off < total) {
            int32 remaining = total - off;
            isize n = kama_write(fd: this.fd, buf: addr(of: bytes[off]), n: cast<usize>(remaining));
            if (n < 0) {
                if (kama_last_error() == kama_EINTR()) { continue; }
                return Result::Err(error: lastError());
            }
            off = off + cast<int32>(n);
        }
        return Result::Ok(value: cast<usize>(total));
    }

    // "Drop only if live" (A/B) now stops the compiler from dropping a `{0}` on a field-first-write or a
    // `match(give …)` payload extraction — the two paths that used to close(0) here. This guard remains for
    // the residual it does NOT cover: a bare `File f;` that reaches a drop before its fd is assigned (an
    // uninitialized/whole-reassigned local). `fd == 0` is stdin, so `fd > 0` treats the zero as the empty
    // sentinel (a real descriptor this API opens is always > 0). A future "force explicit field init" pass
    // (the language's proper answer to default assignment) would retire this guard entirely.
    ~File() { if (this.fd > 0) { int32 rc = kama_close_fd(fd: this.fd); } }
}

// Read an entire file into an owning byte buffer (opens, reads to EOF, closes on drop).
fn Result<DynamicArray<uint8>, IoError> readFile(ref string path) {
    Result<File, IoError> r = File.open(path: path, mode: OpenMode::Read);
    return match (r) {
        case Ok(f):  f.readAll();                       // f closes at arm end (RAII)
        case Err(e): Result::Err(error: e);
    };
}

// Create/truncate a file and write the whole buffer to it.
fn Result<usize, IoError> writeFile(ref string path, ref DynamicArray<uint8> bytes) {
    Result<File, IoError> r = File.open(path: path, mode: OpenMode::Write);
    return match (r) {
        case Ok(f):  f.writeAll(bytes: bytes);
        case Err(e): Result::Err(error: e);
    };
}

// Size + directory flag for a path.
fn Result<Metadata, IoError> stat(ref string path) {
    uint64 sz = 0ui64;
    int32 isdir = 0;
    int32 rc = kama_path_stat(path: path.cstr(), outSize: addr(of: sz), outIsDir: addr(of: isdir));
    if (rc != 0) { return Result::Err(error: lastError()); }
    return Result::Ok(value: Metadata.of(size: cast<usize>(sz), isDir: isdir != 0));
}

// Delete a file. Ok on success; Err(NotFound) if the path did not exist.
fn Result<Unit, IoError> remove(ref string path) {
    if (kama_unlink(path: path.cstr()) != 0) { return Result::Err(error: lastError()); }
    return Result::Ok(value: Unit::Unit);
}

// DynamicArray a directory's entries (excluding "." and ".."), each as an owned string.
fn Result<DynamicArray<string>, IoError> readDir(ref string path) {
    Ptr dirp = kama_diropen(path: path.cstr());
    if (dirp == null) { return Result::Err(error: lastError()); }
    DynamicArray<string> names = DynamicArray.empty();
    while (true) {
        string name = kama_dirnext(dirp: dirp);
        if (name.isEmpty()) { break; }              // end of directory
        if (name == ".")  { continue; }
        if (name == "..") { continue; }
        names.add(item: give name);
    }
    int32 rc = kama_dirclose(dirp: dirp);
    return Result::Ok(value: give names);
}
