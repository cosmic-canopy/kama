namespace std::net;

import std::io::{IoError, lastError};

export { Poller, Interest, Ready };

// Readiness notification over many sockets (poll(2) / WSAPoll) — the game-SERVER selector. A client with one
// or a few connections just drains each non-blocking socket; a server multiplexing hundreds waits here once
// and services whoever is ready. Native only (the browser event loop IS the selector on the web). The
// underlying pollfd[] stays opaque in C behind a Ptr.
extern "kama_os.h";
extern fn Ptr   kama_poller_create();
extern fn void  kama_poller_add(Ptr p, isize fd, int32 interest);
extern fn void  kama_poller_remove(Ptr p, isize fd);
extern fn int32 kama_poller_wait(Ptr p, int32 timeoutMs);
extern fn int32 kama_poller_ready(Ptr p, isize fd);
extern fn void  kama_poller_free(Ptr p);

// What to watch a socket for. Feed a socket's rawHandle() to add().
enum Interest { Read, Write, ReadWrite }

// A socket's readiness after wait(). `readable` also covers hangup/error (so a follow-up read sees EOF/err);
// `writable` on a connecting socket means the non-blocking connect resolved (then call checkConnected()).
@generate(of)
type value Ready {
    public bool readable;
    public bool writable;
}

// A readiness set. Move-only; frees its C cursor on drop (RAII).
type resource Poller {
    Ptr state;
    private ctor make(Ptr state) { slot Poller r; r.state = state; return give r; }

    public ctor Result<Poller, IoError> create() {
        Ptr s = kama_poller_create();
        if (s == null) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Poller.make(state: s));
    }

    // Watch `fd` (a socket's rawHandle()) for `interest`. Re-adding an fd updates its interest.
    public fn void add(isize fd, Interest interest) {
        int32 bits = match (interest) { case Read: 1; case Write: 2; case ReadWrite: 3; };
        kama_poller_add(p: this.state, fd: fd, interest: bits);
    }

    // Stop watching `fd`.
    public fn void remove(isize fd) { kama_poller_remove(p: this.state, fd: fd); }

    // Block up to `timeoutMs` (< 0 = forever) until at least one watched socket is ready. Returns the count
    // ready (0 = timed out). EINTR surfaces as Err(Other) — the caller may retry.
    public fn Result<int32, IoError> wait(int32 timeoutMs) {
        int32 n = kama_poller_wait(p: this.state, timeoutMs: timeoutMs);
        if (n < 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: n);
    }

    // The readiness of `fd` as reported by the last wait().
    public fn Ready readyFor(isize fd) {
        int32 bits = kama_poller_ready(p: this.state, fd: fd);
        return Ready.of(readable: (bits & 1) != 0, writable: (bits & 2) != 0);
    }

    ~Poller() { kama_poller_free(p: this.state); }
}
