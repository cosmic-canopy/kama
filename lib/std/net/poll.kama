
import { std::io::IoError, std::io::lastError, std::ptr::nonNull, std::time::monotonicNow, std::time::Instant };

export { Poller, Interest, Ready };

// Readiness notification over many sockets (poll(2) / WSAPoll) — the game-SERVER selector. A client with one
// or a few connections just drains each non-blocking socket; a server multiplexing hundreds waits here once
// and services whoever is ready. Native only (the browser event loop IS the selector on the web). The
// underlying pollfd[] stays opaque in C behind an UnsafePtr.
extern "kama_os.h";
extern fn UnsafePtr   kama_poller_create();
extern fn void  kama_poller_add(UnsafePtr p, isize fd, int32 interest);
extern fn void  kama_poller_remove(UnsafePtr p, isize fd);
extern fn int32 kama_poller_wait(UnsafePtr p, int32 timeoutMs);
extern fn int32 kama_poller_ready(UnsafePtr p, isize fd);
extern fn void  kama_poller_free(UnsafePtr p);

// What to watch a socket for. Feed a socket's rawHandle() to add().
type enum Interest { Read, Write, ReadWrite }

// A socket's readiness after wait(). `readable` also covers hangup/error (so a follow-up read sees EOF/err);
// `writable` on a connecting socket means the non-blocking connect resolved (then call checkConnected()).
@generate(of)
type value Ready implements Sendable {
    public bool readable;
    public bool writable;
}

// A readiness set. Move-only; frees its C cursor on drop (RAII).
type resource Poller implements Sendable {
    UnsafePtr state;
    private unsafe ctor make(UnsafePtr state) { this.state = state; }

    public unsafe ctor Result<Poller, IoError> create() {
        return match (nonNull(p: kama_poller_create())) {
            case Some(value: s): Result::Ok(value: Poller.make(state: s));
            case None: Result::Err(error: lastError());
        };
    }

    // Watch `fd` (a socket's rawHandle()) for `interest`. Re-adding an fd updates its interest.
    public unsafe fn void add(isize fd, Interest interest) {
        int32 bits = match (interest) { case Read: 1; case Write: 2; case ReadWrite: 3; };
        kama_poller_add(p: this.state, fd: fd, interest: bits);
    }

    // Stop watching `fd`.
    public unsafe fn void remove(isize fd) { kama_poller_remove(p: this.state, fd: fd); }

    // Block up to `timeoutMs` (< 0 = forever) until at least one watched socket is ready. Returns the count
    // ready (0 = timed out). A signal that interrupts the wait (EINTR — SIGCHLD from a child, a profiler's
    // SIGPROF, whatever `SA_RESTART` says) is not an I/O event, so the wait resumes with the time that is LEFT,
    // measured on the monotonic clock: the caller's deadline holds either way (KPG-17). It used to surface as
    // `Other(4)`, which a caller could tell from a real failure only by a platform's magic number.
    public unsafe fn Result<int32, IoError> wait(int32 timeoutMs) {
        Instant start = monotonicNow();
        int32 left = timeoutMs;
        while (true) {
            int32 n = kama_poller_wait(p: this.state, timeoutMs: left);
            if (n >= 0) { return Result::Ok(value: n); }
            IoError e = lastError();
            bool interrupted = match (e.kind()) { case Interrupted: true; case _: false; };
            if (!interrupted) { return Result::Err(error: e); }
            if (timeoutMs >= 0) {
                int64 spent = start.elapsed().asMillis();
                if (spent >= cast<int64>(timeoutMs)) { return Result::Ok(value: 0); }
                left = timeoutMs - cast<int32>(spent);
            }
        }
    }

    // The readiness of `fd` as reported by the last wait().
    public unsafe fn Ready readyFor(isize fd) {
        int32 bits = kama_poller_ready(p: this.state, fd: fd);
        return Ready.of(readable: (bits & 1) != 0, writable: (bits & 2) != 0);
    }

    unsafe ~Poller() { kama_poller_free(p: this.state); }
}
