
import { std::io::IoError, std::io::IoErrorKind, std::io::lastError, std::io::Descriptor, std::collections::View, std::collections::ConstView, SocketAddr, RecvFrom, IpAddr,
         std::time::Instant };

export { UdpSocket, DatagramSocket, UdpBindOptions, UdpPortShare };

// POSIX/Winsock UDP bindings — see kama_os.h. Same conventions as the TCP module: socket handles are
// `isize` (`< 0 == error`), the sockaddr fill stays in C, and an address crosses in `IpAddr.bytes`' seam form
// (family, sixteen network-order bytes, port, scope id) — in as scalars, back as scalar out-params.
extern "kama_os.h";
extern fn isize kama_desc_dup(isize h, int32 kind);
extern fn int32 kama_net_init();
extern fn isize kama_socket_udp(int32 family);
extern fn int32 kama_set_reuseaddr(isize fd);
extern fn int32 kama_set_reuseport(isize fd);
extern fn int32 kama_bind_addr(isize fd, int32 family, UnsafeConstPtr<uint8> ip, uint16 port, uint32 scopeId);
extern fn int32 kama_connect_addr(isize fd, int32 family, UnsafeConstPtr<uint8> ip, uint16 port, uint32 scopeId);
extern fn isize kama_sendto_addr(isize fd, UnsafeConstPtr<uint8> buf, usize n, int32 family, UnsafeConstPtr<uint8> ip,
                                 uint16 port, uint32 scopeId, int32 mode);
extern fn isize kama_recvfrom_addr(isize fd, UnsafePtr<uint8> buf, usize n, UnsafePtr<int32> outFamily,
                                   UnsafePtr<uint8> outIp, UnsafePtr<uint16> outPort, UnsafePtr<uint32> outScope, int32 mode);
extern fn isize kama_recv(isize fd, UnsafePtr<uint8> buf, usize n, int32 mode);
extern fn isize kama_send(isize fd, UnsafeConstPtr<uint8> buf, usize n, int32 mode);
// A socket's wait (kama_os.h, KR-3 step 5), as net.kama binds it.
extern fn int32 kama_net_ready(isize fd, UnsafePtr io, UnsafePtr<int32> mode, uint64 by);
extern fn int32 kama_net_retry(isize fd, UnsafePtr io, int32 mode, int32 interest, uint64 by);
extern fn int32 kama_net_close(isize fd, UnsafePtr io);
extern fn void kama_net_settle(isize fd, UnsafePtr io, int32 mode);
extern fn int32 kama_net_set_mode(isize fd, UnsafePtr io, UnsafePtr<int32> mode, int32 on);
extern fn int32 kama_net_adopt_mode(isize fd);
extern fn int32 kama_getsockname_addr(isize fd, UnsafePtr<int32> outFamily, UnsafePtr<uint8> outIp,
                                      UnsafePtr<uint16> outPort, UnsafePtr<uint32> outScope);
extern fn int32 kama_getpeername_addr(isize fd, UnsafePtr<int32> outFamily, UnsafePtr<uint8> outIp,
                                      UnsafePtr<uint16> outPort, UnsafePtr<uint32> outScope);
extern fn int32 kama_set_nonblocking(isize fd, int32 on);
extern fn int32 kama_set_ttl(isize fd, uint32 ttl);
extern fn int32 kama_set_broadcast(isize fd, int32 on);
extern fn int32 kama_multicast_v4(isize fd, UnsafeConstPtr<uint8> group, UnsafeConstPtr<uint8> iface, int32 join);
extern fn int32 kama_multicast_v6(isize fd, UnsafeConstPtr<uint8> group, uint32 index, int32 join);
extern fn int32 kama_multicast_if_v4(isize fd, UnsafeConstPtr<uint8> iface);
extern fn int32 kama_multicast_if_v6(isize fd, uint32 index);
extern fn int32 kama_multicast_opt(isize fd, int32 hops, uint32 value);
extern fn int32 kama_close_socket(isize fd);
extern fn int32 kama_last_error();
extern fn int32 kama_EINTR();

// An unreliable, unordered datagram endpoint, over the address type `A` its peers are named by. Native UDP, and
// the web's WebTransport datagrams and WebRTC DataChannel, are `DatagramSocket<SocketAddr>` — so game netcode
// written `fn tick<S: DatagramSocket<SocketAddr>>(ref S s)` runs unchanged on every platform — and a Unix
// datagram socket is a `DatagramSocket<UnixAddr>`, so a syslog client or a metrics emitter that sends to a local
// socket or to a UDP port by configuration is one path, `fn emit<S: DatagramSocket<A>, A>(ref S s, const ref A to)`
// (KR-108). The address is a parameter and not a default: it is what kind of socket this is, so it is always
// spelled. `setNonBlocking(false)` is a no-op on web (the browser is always non-blocking); `WouldBlock` is the
// uniform "nothing ready" signal. An empty `into` is `InvalidInput` from `recvFrom` on every implementer: it
// cannot hold a datagram, and answering one would invent a sender.
// Buffers are `ConstView<uint8>` out / `View<uint8>` in — the uniform byte-buffer type across std::net/fs/serde — so a datagram can be
// sent from (or received into) a sub-slice of a larger buffer with no copy. Datagrams are message-oriented,
// so a `DatagramSocket` is NOT a `Reader`/`Writer` (those model byte streams; a datagram is atomic).
type contract DatagramSocket<A> for resource {
    fn Result<usize, IoError> sendTo(ConstView<uint8> bytes, const ref A to);
    fn Result<RecvFrom<A>, IoError> recvFrom(View<uint8> into);
    fn Result<usize, IoError> send(ConstView<uint8> bytes);
    fn Result<usize, IoError> recv(View<uint8> into);
    fn Result<Unit, IoError> setNonBlocking(bool on);
}

// How a UDP socket shares its port (KR-228): one type on every OS, each its own OS's (the platform rule), and every
// socket on a shared port must ask for it. A plain `bind` is `Alone`, so a port another socket holds is `AddrInUse`.
// - `Group`, on every OS: every socket on the port receives each multicast and broadcast datagram sent to it, which is
//   what several programs listening to one group want. A unicast datagram reaches one of them, the one bound last on
//   Linux and macOS (measured: 32 of 32 on both). Linux and Windows `SO_REUSEADDR`; macOS and the BSDs add
//   `SO_REUSEPORT`, as Go's `ListenMulticastUDP` does.
// - `Balance`, Linux only: the kernel spreads unicast datagrams across the sockets by their sender (`SO_REUSEPORT`),
//   so each of several isolates serves its own socket. Measured: 15 and 17 of 32 senders.
@compileFor(OS_LINUX)
@nonExhaustive
type enum UdpPortShare implements Sendable { Alone, Group, Balance }
@compileFor(!OS_LINUX)
@nonExhaustive
type enum UdpPortShare implements Sendable { Alone, Group }

// The options `UdpSocket.bindWith` takes, as `ListenOptions` are a TCP listener's.
type value UdpBindOptions implements Sendable {
    public UdpPortShare share = UdpPortShare::Alone;
    public ctor make() { }
}

// The socket options `share` asks for, set before `bind`. 0, or the OS's refusal.
@compileFor(OS_LINUX)
unsafe fn int32 sharePort(isize fd, UdpPortShare share) {
    return match (share) {
        case Alone: 0;
        case Group: kama_set_reuseaddr(fd: fd);
        case Balance: kama_set_reuseport(fd: fd);
    };
}
@compileFor(OS_WINDOWS)
unsafe fn int32 sharePort(isize fd, UdpPortShare share) {
    return match (share) { case Alone: 0; case Group: kama_set_reuseaddr(fd: fd); };
}
@compileFor(!OS_LINUX, !OS_WINDOWS)
unsafe fn int32 sharePort(isize fd, UdpPortShare share) {
    return match (share) {
        case Alone: 0;
        case Group: kama_set_reuseaddr(fd: fd) != 0 ? -1 : kama_set_reuseport(fd: fd);
    };
}

// A UDP socket. Closes its handle on drop (RAII). Move-only. Blocking by default; `setNonBlocking(true)`
// makes recv/recvFrom return `Err(WouldBlock)` instead of stalling (the game-loop drain model).
type resource UdpSocket implements DatagramSocket<SocketAddr>, Sendable {
    // The empty niche is -1, not 0 (force-explicit-field-init makes the field default the place to
    // SAY so). A bare/moved-from slot therefore reads -1 and the destructor skips it, while fd 0
    // stays an ownable descriptor — stdin is a real handle, and `fd > 0` used to make it unownable
    // for no reason other than that zero doubled as "empty". Rust's `OwnedFd` niche.
    isize fd = -1;
    UnsafePtr io = null;   // how it waits, as `TcpStream`'s (net.kama)
    int32 mode = 0;
    uint64 readBy = 0;
    uint64 writeBy = 0;
    private ctor make(isize fd, int32 mode) { this.fd = fd; this.mode = mode; }

    // Bind to a numeric host:port. host ""/"0.0.0.0" = every IPv4 interface, "::" = every interface of both
    // families (IPV6_V6ONLY off, as for `TcpListener`); port 0 = OS-assigned ephemeral (read the actual port
    // back with localAddr()). Text that is not a numeric address is `Err(InvalidInput)`. A port another socket holds
    // is `AddrInUse` on every OS; `bindWith` shares one. The socket's family is the address's, for its whole life.
    // The socket closes on drop.
    public unsafe ctor Result<UdpSocket, IoError> bind(const ref string host, uint16 port) {
        return match (SocketAddr.host(text: host, port: port, forBind: true)) {
            case Err(error: e): Result::Err(error: e);
            case Ok(value: a): UdpSocket.bindTo(address: a);
        };
    }

    // `bind` to an address value — the one spelling that reaches a link-local V6 address (its `scopeId`).
    public unsafe ctor Result<UdpSocket, IoError> bindTo(const ref SocketAddr address) {
        return UdpSocket.bindShared(address: address, share: UdpPortShare::Alone);
    }

    // `bindTo` with `UdpBindOptions`: a port several sockets share, as `options.share` says.
    public unsafe ctor Result<UdpSocket, IoError> bindWith(const ref SocketAddr address, const ref UdpBindOptions options) {
        return UdpSocket.bindShared(address: address, share: options.share);
    }

    unsafe ctor Result<UdpSocket, IoError> bindShared(const ref SocketAddr address, UdpPortShare share) {
        int32 ir = kama_net_init();
        if (ir != 0) { return Result::Err(error: lastError()); }
        int32 family = address.ip.family();
        InlineArray<uint8>#(16) bytes = address.ip.bytes();
        isize fd = kama_socket_udp(family: family);
        if (fd < 0) { return Result::Err(error: lastError()); }
        // Asked for, so a refusal is the answer. Nothing is set for `Alone`: SO_REUSEADDR on every socket let a second
        // plain bind on Linux take a live port's datagrams (through 0.9.784).
        if (sharePort(fd: fd, share: share) != 0
            || kama_bind_addr(fd: fd, family: family, ip: addr(of: bytes[0]), port: address.port, scopeId: address.scopeId) != 0) {
            IoError e = lastError();                        // capture before close (close may clear errno)
            int32 rc = kama_close_socket(fd: fd);
            return Result::Err(error: e);
        }
        return Result::Ok(value: UdpSocket.make(fd: fd, mode: 0));
    }

    // Set a default peer (POSIX `connect` on a datagram socket): send/recv then need no address, and recv
    // only delivers datagrams FROM that peer (others get ICMP-refused / dropped).
    // Text that is not a numeric address is `Err(InvalidInput)`.
    public unsafe fn Result<Unit, IoError> connect(const ref string host, uint16 port) {
        return match (SocketAddr.host(text: host, port: port, forBind: false)) {
            case Err(error: e): Result::Err(error: e);
            case Ok(value: a): this.connectTo(address: a);
        };
    }

    // `connect` to an address value (a sender a datagram came from, a scoped one).
    public unsafe fn Result<Unit, IoError> connectTo(const ref SocketAddr address) {
        InlineArray<uint8>#(16) bytes = address.ip.bytes();
        if (kama_connect_addr(fd: this.fd, family: address.ip.family(), ip: addr(of: bytes[0]), port: address.port,
                              scopeId: address.scopeId) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }

    // Send the whole buffer as one datagram to `to`. Returns the byte count (a datagram is atomic — a
    // short write is unusual). EINTR-retried. `Err(MessageTooLong)` if the payload exceeds the path MTU.
    @parks
    public unsafe fn Result<usize, IoError> sendTo(ConstView<uint8> bytes, const ref SocketAddr to) {
        InlineArray<uint8>#(16) ip = to.ip.bytes();
        int32 family = to.ip.family();
        if (kama_net_ready(fd: this.fd, io: addr(of: this.io), mode: addr(of: this.mode), by: this.writeBy) != 0) { return Result::Err(error: lastError()); }
        while (true) {
            isize n = kama_sendto_addr(fd: this.fd, buf: bytes.dataPtr(), n: cast<usize>(bytes.length()),
                                       family: family, ip: addr(of: ip[0]), port: to.port, scopeId: to.scopeId, mode: this.mode);
            if (n >= 0) { return Result::Ok(value: cast<usize>(n)); }
            if (kama_net_retry(fd: this.fd, io: this.io, mode: this.mode, interest: 2, by: this.writeBy) == 0) { return Result::Err(error: lastError()); }
        }
    }

    // Receive one datagram into `into` (truncated to into.length() if larger); returns count + sender.
    // Non-blocking + nothing queued => Err(WouldBlock). An empty `into` => Err(InvalidInput). EINTR-retried.
    @parks
    public unsafe fn Result<RecvFrom<SocketAddr>, IoError> recvFrom(View<uint8> into) {
        if (into.length() == 0) { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); }
        int32 family = 4;
        InlineArray<uint8>#(16) ip = [0; 16];
        uint16 port = 0ui16;
        uint32 zone = 0ui32;
        if (kama_net_ready(fd: this.fd, io: addr(of: this.io), mode: addr(of: this.mode), by: this.readBy) != 0) { return Result::Err(error: lastError()); }
        while (true) {
            isize n = kama_recvfrom_addr(fd: this.fd, buf: addr(of: into[0]), n: cast<usize>(into.length()),
                                         outFamily: addr(of: family), outIp: addr(of: ip[0]), outPort: addr(of: port),
                                         outScope: addr(of: zone), mode: this.mode);
            if (n >= 0) { return Result::Ok(value: RecvFrom.of(count: cast<usize>(n), from: SocketAddr.raw(family: family, bytes: ip, port: port, scopeId: zone))); }
            if (kama_net_retry(fd: this.fd, io: this.io, mode: this.mode, interest: 1, by: this.readBy) == 0) { return Result::Err(error: lastError()); }
        }
    }

    // Send to the connected default peer (see connect). EINTR-retried.
    @parks
    public unsafe fn Result<usize, IoError> send(ConstView<uint8> bytes) {
        if (kama_net_ready(fd: this.fd, io: addr(of: this.io), mode: addr(of: this.mode), by: this.writeBy) != 0) { return Result::Err(error: lastError()); }
        while (true) {
            isize n = kama_send(fd: this.fd, buf: bytes.dataPtr(), n: cast<usize>(bytes.length()), mode: this.mode);
            if (n >= 0) { return Result::Ok(value: cast<usize>(n)); }
            if (kama_net_retry(fd: this.fd, io: this.io, mode: this.mode, interest: 2, by: this.writeBy) == 0) { return Result::Err(error: lastError()); }
        }
    }

    // Receive from the connected default peer. Non-blocking + empty => Err(WouldBlock). EINTR-retried.
    @parks
    public unsafe fn Result<usize, IoError> recv(View<uint8> into) {
        if (into.length() == 0) { return Result::Ok(value: cast<usize>(0)); }
        if (kama_net_ready(fd: this.fd, io: addr(of: this.io), mode: addr(of: this.mode), by: this.readBy) != 0) { return Result::Err(error: lastError()); }
        while (true) {
            isize n = kama_recv(fd: this.fd, buf: addr(of: into[0]), n: cast<usize>(into.length()), mode: this.mode);
            if (n >= 0) { return Result::Ok(value: cast<usize>(n)); }
            if (kama_net_retry(fd: this.fd, io: this.io, mode: this.mode, interest: 1, by: this.readBy) == 0) { return Result::Err(error: lastError()); }
        }
    }

    // A deadline for reads (KR-3 step 5, Go's): an absolute `Instant` after which a read fails with `Err(TimedOut)`
    // — at once if it has passed, even with bytes waiting — until it is reset; `None` clears it. It bounds every
    // read after it, so one deadline bounds an exchange of several: set it again for each, for a per-read limit.
    // On a fiber the read parks until then; on a thread it waits in a poll for the time left.
    public fn void setReadDeadline(Optional<Instant> at) {
        uint64 by = match (at) { case Some(value: i): i.rawNanos == 0 ? 1 : i.rawNanos; case None: 0; };
        this.readBy = by;
        this.mode = this.readBy != 0 || this.writeBy != 0 ? (this.mode | 4) : (this.mode & 3);
    }
    // A deadline for writes, as `setReadDeadline` is for reads (a connect's is `ConnectOptions`).
    public fn void setWriteDeadline(Optional<Instant> at) {
        uint64 by = match (at) { case Some(value: i): i.rawNanos == 0 ? 1 : i.rawNanos; case None: 0; };
        this.writeBy = by;
        this.mode = this.writeBy != 0 || this.readBy != 0 ? (this.mode | 4) : (this.mode & 3);
    }

    // Toggle non-blocking mode. In non-blocking mode, recv/recvFrom that would stall return WouldBlock — on a fiber
    // too, where a blocking one parks instead.
    public unsafe fn Result<Unit, IoError> setNonBlocking(bool on) {
        if (kama_net_set_mode(fd: this.fd, io: this.io, mode: addr(of: this.mode), on: on ? 1 : 0) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }

    // The local address (after bind port 0, this yields the OS-assigned ephemeral port), and — once `connect` has
    // fixed one — the peer's. Asking a socket where it is changes nothing, so a `const fn` may ask.
    public const fn Result<SocketAddr, IoError> localAddr() { return this.addressOf(peer: false); }
    public const fn Result<SocketAddr, IoError> peerAddr() { return this.addressOf(peer: true); }
    unsafe const fn Result<SocketAddr, IoError> addressOf(bool peer) {
        int32 family = 4;
        InlineArray<uint8>#(16) ip = [0; 16];
        uint16 port = 0ui16;
        uint32 zone = 0ui32;
        int32 rc = peer
            ? kama_getpeername_addr(fd: this.fd, outFamily: addr(of: family), outIp: addr(of: ip[0]), outPort: addr(of: port), outScope: addr(of: zone))
            : kama_getsockname_addr(fd: this.fd, outFamily: addr(of: family), outIp: addr(of: ip[0]), outPort: addr(of: port), outScope: addr(of: zone));
        if (rc != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: SocketAddr.raw(family: family, bytes: ip, port: port, scopeId: zone));
    }

    // Set the outgoing IP TTL (hop limit).
    public unsafe fn Result<Unit, IoError> setTtl(uint32 ttl) {
        if (kama_set_ttl(fd: this.fd, ttl: ttl) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }

    // Allow sending to the IPv4 broadcast address (LAN discovery). Off by default.
    public unsafe fn Result<Unit, IoError> setBroadcast(bool on) {
        int32 v = on ? 1 : 0;
        if (kama_set_broadcast(fd: this.fd, on: v) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }

    // ---- multicast ----
    // A group is joined PER INTERFACE, and the families name an interface differently — V4 by an address it
    // holds, V6 by its index (`interfaceIndex`) — so each has its own call, as in the C API. `0.0.0.0` / index 0
    // leave the choice to the OS. A group or interface of the wrong family is `Err(InvalidInput)`. Membership
    // ends when the socket closes; `leave` is for ending it sooner. None of this has a browser analogue.

    public unsafe fn Result<Unit, IoError> joinMulticastV4(const ref IpAddr group, const ref IpAddr interface) {
        return this.membershipV4(group: group, interface: interface, join: 1);
    }
    public unsafe fn Result<Unit, IoError> leaveMulticastV4(const ref IpAddr group, const ref IpAddr interface) {
        return this.membershipV4(group: group, interface: interface, join: 0);
    }
    public unsafe fn Result<Unit, IoError> joinMulticastV6(const ref IpAddr group, uint32 interfaceIndex) {
        return this.membershipV6(group: group, interfaceIndex: interfaceIndex, join: 1);
    }
    public unsafe fn Result<Unit, IoError> leaveMulticastV6(const ref IpAddr group, uint32 interfaceIndex) {
        return this.membershipV6(group: group, interfaceIndex: interfaceIndex, join: 0);
    }

    // The interface this socket's multicast SENDS leave by (IP_MULTICAST_IF / IPV6_MULTICAST_IF). Without it the
    // routing table picks, so a loopback-bound V4 socket's send goes for a real interface and fails, and a
    // multi-homed host sends on whichever it likes.
    public unsafe fn Result<Unit, IoError> setMulticastInterfaceV4(const ref IpAddr interface) {
        if (interface.family() != 4) { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); }
        InlineArray<uint8>#(16) i = interface.bytes();
        if (kama_multicast_if_v4(fd: this.fd, iface: addr(of: i[0])) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }
    public unsafe fn Result<Unit, IoError> setMulticastInterfaceV6(uint32 interfaceIndex) {
        if (kama_multicast_if_v6(fd: this.fd, index: interfaceIndex) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }

    // Whether this socket's own multicast sends are delivered back to groups it (or another socket on this host)
    // joined. On by default on every OS.
    public unsafe fn Result<Unit, IoError> setMulticastLoop(bool on) {
        uint32 v = on ? 1ui32 : 0ui32;
        if (kama_multicast_opt(fd: this.fd, hops: 0, value: v) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }

    // The hop limit of multicast sends (default 1: the local link). The unicast limit is `setTtl`.
    public unsafe fn Result<Unit, IoError> setMulticastHops(uint32 hops) {
        if (kama_multicast_opt(fd: this.fd, hops: 1, value: hops) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }

    unsafe fn Result<Unit, IoError> membershipV4(const ref IpAddr group, const ref IpAddr interface, int32 join) {
        if (group.family() != 4 || interface.family() != 4) { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); }
        InlineArray<uint8>#(16) g = group.bytes();
        InlineArray<uint8>#(16) i = interface.bytes();
        if (kama_multicast_v4(fd: this.fd, group: addr(of: g[0]), iface: addr(of: i[0]), join: join) != 0) {
            return Result::Err(error: lastError());
        }
        return Result::Ok(value: Unit::Unit);
    }

    unsafe fn Result<Unit, IoError> membershipV6(const ref IpAddr group, uint32 interfaceIndex, int32 join) {
        if (group.family() != 6) { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); }
        InlineArray<uint8>#(16) g = group.bytes();
        if (kama_multicast_v6(fd: this.fd, group: addr(of: g[0]), index: interfaceIndex, join: join) != 0) {
            return Result::Err(error: lastError());
        }
        return Result::Ok(value: Unit::Unit);
    }

    // The raw socket handle — the intended bridge for handing this socket to a std::net::Poller.
    // Adopt an owned descriptor (`std::io::Descriptor`) — one received over a Unix socket, or made from a raw
    // number by `Descriptor.adoptSocket(raw:)`. On Windows it must be a socket's (`InvalidInput`, and it is closed).
    public unsafe ctor Result<UdpSocket, IoError> adopt(Descriptor descriptor) {
        return match (give descriptor.release(asSocket: true)) {
            case Err(error: e): Result::Err(error: e);
            case Ok(value: h): Result::Ok(value: UdpSocket.make(fd: h, mode: kama_net_adopt_mode(fd: h)));
        };
    }
    // Give the socket up as a `Descriptor`, consuming this (KR-261; its destructor then finds nothing to close).
    public unsafe give fn Descriptor intoDescriptor() {
        isize h = this.fd;
        kama_net_settle(fd: h, io: this.io, mode: this.mode);
        this.fd = -1; this.io = null; this.mode = 0;
        return Descriptor.adoptSocket(raw: h);
    }
    // A second descriptor for this same socket, closed independently — what `sendDescriptors` consumes when
    // you keep this one.
    public unsafe fn Result<Descriptor, IoError> duplicateDescriptor() {
        isize d = kama_desc_dup(h: this.fd, kind: 1);
        if (d < 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Descriptor.adoptSocket(raw: d));
    }
    public const fn isize rawHandle() { return this.fd; }

    unsafe ~UdpSocket() { if (this.fd >= 0) { int32 rc = kama_net_close(fd: this.fd, io: this.io); } }   // guard: see net.kama ~TcpStream
}
