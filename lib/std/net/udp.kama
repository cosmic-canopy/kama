namespace std::net;

import std::io::{IoError, lastError};
import std::collections::{View};
import std::net::{SocketAddr, RecvFrom};

export { UdpSocket, DatagramSocket };

// POSIX/Winsock UDP bindings — see kama_os.h. Same conventions as the TCP module: socket handles are
// `isize` (`< 0 == error`), the `sockaddr_in` fill stays in C, and kama passes only the handle, a numeric
// host string, a port, and scalar out-params. `recvfrom`'s sender comes back as a host-order IPv4 + port.
extern "kama_os.h";
extern fn int32 kama_net_init();
extern fn isize kama_socket_udp();
extern fn int32 kama_set_reuseaddr(isize fd);
extern fn int32 kama_bind_inet(isize fd, UnsafePtr<int8> host, uint16 port);
extern fn int32 kama_connect_inet(isize fd, UnsafePtr<int8> host, uint16 port);
extern fn isize kama_sendto_inet(isize fd, UnsafePtr<uint8> buf, usize n, UnsafePtr<int8> host, uint16 port);
extern fn isize kama_recvfrom_inet(isize fd, UnsafePtr<uint8> buf, usize n, UnsafePtr<uint32> outIp, UnsafePtr<uint16> outPort);
extern fn isize kama_recv(isize fd, UnsafePtr<uint8> buf, usize n);
extern fn isize kama_send(isize fd, UnsafePtr<uint8> buf, usize n);
extern fn int32 kama_getsockname(isize fd, UnsafePtr<uint32> outIp, UnsafePtr<uint16> outPort);
extern fn int32 kama_set_nonblocking(isize fd, int32 on);
extern fn int32 kama_set_ttl(isize fd, uint32 ttl);
extern fn int32 kama_set_broadcast(isize fd, int32 on);
extern fn int32 kama_close_socket(isize fd);
extern fn int32 kama_last_error();
extern fn int32 kama_EINTR();

// An unreliable, unordered datagram endpoint. Native UDP satisfies it today; WebTransport datagrams (and a
// later WebRTC DataChannel) satisfy the SAME contract on other targets — so game netcode written
// `fn tick<S: DatagramSocket>(ref S s)` runs unchanged on every platform. `setNonBlocking(false)` is a
// no-op on web (the browser is always non-blocking); `WouldBlock` is the uniform "nothing ready" signal.
// Buffers are `View<uint8>` — the uniform byte-buffer type across std::net/fs/serde — so a datagram can be
// sent from (or received into) a sub-slice of a larger buffer with no copy. Datagrams are message-oriented,
// so a `DatagramSocket` is NOT a `Reader`/`Writer` (those model byte streams; a datagram is atomic).
type contract DatagramSocket for resource {
    fn Result<usize, IoError> sendTo(View<uint8> bytes, ref SocketAddr to);
    fn Result<RecvFrom, IoError> recvFrom(View<uint8> into);
    fn Result<usize, IoError> send(View<uint8> bytes);
    fn Result<usize, IoError> recv(View<uint8> into);
    fn Result<Unit, IoError> setNonBlocking(bool on);
}

// A UDP socket. Closes its handle on drop (RAII). Move-only. Blocking by default; `setNonBlocking(true)`
// makes recv/recvFrom return `Err(WouldBlock)` instead of stalling (the game-loop drain model).
type resource UdpSocket implements DatagramSocket {
    // The empty niche is -1, not 0 (force-explicit-field-init makes the field default the place to
    // SAY so). A bare/moved-from slot therefore reads -1 and the destructor skips it, while fd 0
    // stays an ownable descriptor — stdin is a real handle, and `fd > 0` used to make it unownable
    // for no reason other than that zero doubled as "empty". Rust's `OwnedFd` niche.
    isize fd = -1;
    private ctor make(isize fd) { this.fd = fd; }

    // Bind to a numeric host:port. host ""/"0.0.0.0" = all interfaces; port 0 = OS-assigned ephemeral
    // (read the actual port back with localAddr()). SO_REUSEADDR is set. The socket closes on drop.
    public unsafe ctor Result<UdpSocket, IoError> bind(ref string host, uint16 port) {
        int32 ir = kama_net_init();
        if (ir != 0) { return Result::Err(error: lastError()); }
        isize fd = kama_socket_udp();
        if (fd < 0) { return Result::Err(error: lastError()); }
        int32 ro = kama_set_reuseaddr(fd: fd);              // best-effort; ignore failure
        if (kama_bind_inet(fd: fd, host: host.cstr(), port: port) != 0) {
            IoError e = lastError();                        // capture before close (close may clear errno)
            int32 rc = kama_close_socket(fd: fd);
            return Result::Err(error: e);
        }
        return Result::Ok(value: UdpSocket.make(fd: fd));
    }

    // Set a default peer (POSIX `connect` on a datagram socket): send/recv then need no address, and recv
    // only delivers datagrams FROM that peer (others get ICMP-refused / dropped).
    public unsafe fn Result<Unit, IoError> connect(ref string host, uint16 port) {
        if (kama_connect_inet(fd: this.fd, host: host.cstr(), port: port) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }

    // Send the whole buffer as one datagram to `to`. Returns the byte count (a datagram is atomic — a
    // short write is unusual). EINTR-retried. `Err(MessageTooLong)` if the payload exceeds the path MTU.
    public unsafe fn Result<usize, IoError> sendTo(View<uint8> bytes, ref SocketAddr to) {
        string h = to.ipString();
        while (true) {
            isize n = kama_sendto_inet(fd: this.fd, buf: addr(of: bytes[0]), n: cast<usize>(bytes.length()),
                                       host: h.cstr(), port: to.port);
            if (n >= 0) { return Result::Ok(value: cast<usize>(n)); }
            if (kama_last_error() != kama_EINTR()) { return Result::Err(error: lastError()); }
        }
    }

    // Receive one datagram into `into` (truncated to into.length() if larger); returns count + sender.
    // Non-blocking + nothing queued => Err(WouldBlock). EINTR-retried.
    public unsafe fn Result<RecvFrom, IoError> recvFrom(View<uint8> into) {
        uint32 ip = 0ui32;
        uint16 port = 0ui16;
        if (into.length() == 0) { return Result::Ok(value: RecvFrom.of(count: cast<usize>(0), from: SocketAddr.fromHostIp(ip: ip, port: port))); }
        while (true) {
            isize n = kama_recvfrom_inet(fd: this.fd, buf: addr(of: into[0]), n: cast<usize>(into.length()),
                                         outIp: addr(of: ip), outPort: addr(of: port));
            if (n >= 0) { return Result::Ok(value: RecvFrom.of(count: cast<usize>(n), from: SocketAddr.fromHostIp(ip: ip, port: port))); }
            if (kama_last_error() != kama_EINTR()) { return Result::Err(error: lastError()); }
        }
    }

    // Send to the connected default peer (see connect). EINTR-retried.
    public unsafe fn Result<usize, IoError> send(View<uint8> bytes) {
        while (true) {
            isize n = kama_send(fd: this.fd, buf: addr(of: bytes[0]), n: cast<usize>(bytes.length()));
            if (n >= 0) { return Result::Ok(value: cast<usize>(n)); }
            if (kama_last_error() != kama_EINTR()) { return Result::Err(error: lastError()); }
        }
    }

    // Receive from the connected default peer. Non-blocking + empty => Err(WouldBlock). EINTR-retried.
    public unsafe fn Result<usize, IoError> recv(View<uint8> into) {
        if (into.length() == 0) { return Result::Ok(value: cast<usize>(0)); }
        while (true) {
            isize n = kama_recv(fd: this.fd, buf: addr(of: into[0]), n: cast<usize>(into.length()));
            if (n >= 0) { return Result::Ok(value: cast<usize>(n)); }
            if (kama_last_error() != kama_EINTR()) { return Result::Err(error: lastError()); }
        }
    }

    // Toggle non-blocking mode. In non-blocking mode, recv/recvFrom that would stall return WouldBlock.
    public unsafe fn Result<Unit, IoError> setNonBlocking(bool on) {
        int32 v = on ? 1 : 0;
        if (kama_set_nonblocking(fd: this.fd, on: v) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }

    // Resolve the actual local address (after bind port 0, this yields the OS-assigned ephemeral port).
    public unsafe fn Result<SocketAddr, IoError> localAddr() {
        uint32 ip = 0ui32;
        uint16 port = 0ui16;
        if (kama_getsockname(fd: this.fd, outIp: addr(of: ip), outPort: addr(of: port)) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: SocketAddr.fromHostIp(ip: ip, port: port));
    }

    // Set the outgoing IP TTL (hop limit).
    public unsafe fn Result<Unit, IoError> setTtl(uint32 ttl) {
        if (kama_set_ttl(fd: this.fd, ttl: ttl) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }

    // Allow sending to the IPv4 broadcast address (LAN discovery). Off by default.
    public unsafe fn Result<Unit, IoError> setBroadcast(bool on) {
        int32 v = on ? 1 : 0;
        if (kama_set_broadcast(fd: this.fd, on: v) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }

    // Multicast join/leave (IP_ADD_MEMBERSHIP) is deferred — broadcast covers LAN discovery for now, and
    // multicast has no browser analogue. Tracked as a later std::net milestone, not a silent gap.

    // The raw socket handle — the intended bridge for handing this socket to a std::net::Poller.
    public const fn isize rawHandle() { return this.fd; }

    unsafe ~UdpSocket() { if (this.fd >= 0) { int32 rc = kama_close_socket(fd: this.fd); } }   // guard: see net.kama ~TcpStream
}
