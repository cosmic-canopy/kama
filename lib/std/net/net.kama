namespace std::net;

import std::io::{IoError, lastError};
import std::collections::{DynamicArray, FixedArray};
import std::net::{ReliableStream};

export { TcpListener, TcpStream };

// POSIX/Winsock TCP bindings — see kama_os.h. Socket handles are `isize`: a Windows SOCKET is wider than
// int, and INVALID_SOCKET reinterpreted as isize is -1, so a uniform `< 0 == error` convention holds on
// both platforms. The sockaddr_in fill (family/htons/inet_addr/cast) all happens in C — kama passes only
// the handle, a numeric host string, and a uint16 port.
extern "kama_os.h";
extern fn int32 kama_net_init();
extern fn isize kama_socket_tcp();
extern fn int32 kama_set_reuseaddr(isize fd);
extern fn int32 kama_bind_inet(isize fd, Ptr<int8> host, uint16 port);
extern fn int32 kama_connect_inet(isize fd, Ptr<int8> host, uint16 port);
extern fn int32 kama_listen(isize fd, int32 backlog);
extern fn isize kama_accept(isize fd);
extern fn isize kama_recv(isize fd, Ptr<uint8> buf, usize n);
extern fn isize kama_send(isize fd, Ptr<uint8> buf, usize n);
extern fn int32 kama_close_socket(isize fd);
extern fn int32 kama_set_nonblocking(isize fd, int32 on);
extern fn int32 kama_set_nodelay(isize fd, int32 on);
extern fn int32 kama_socket_error(isize fd);
extern fn int32 kama_last_error();
extern fn int32 kama_EINTR();
extern fn int32 kama_EINPROGRESS();
extern fn int32 kama_EAGAIN();

// A connected TCP stream. Closes its socket on drop (RAII). Move-only. Implements the `ReliableStream`
// contract (shared with the coming WebTransport-stream / WebSocket backends). Blocking by default;
// `setNonBlocking(true)` makes read/writeAll return `Err(WouldBlock)` instead of stalling.
type resource TcpStream implements ReliableStream {
    isize fd;
    // Adopt an already-connected socket fd. This is the escape hatch used by TcpListener.accept();
    // prefer `connect` for client sockets.
    public TcpStream(isize fd) { this.fd = fd; }

    // Connect to a numeric host:port (e.g. "127.0.0.1"). The stream closes on drop.
    public ctor Result<TcpStream, IoError> connect(ref string host, uint16 port) {
        int32 ir = kama_net_init();
        if (ir != 0) { return Result::Err(error: lastError()); }
        isize fd = kama_socket_tcp();
        if (fd < 0) { return Result::Err(error: lastError()); }
        if (kama_connect_inet(fd: fd, host: host.cstr(), port: port) != 0) {
            IoError e = lastError();                        // capture before close (close may clear errno)
            int32 rc = kama_close_socket(fd: fd);
            return Result::Err(error: e);
        }
        return Result::Ok(value: TcpStream(fd: fd));
    }

    // Read up to into.length() bytes into `into`; returns the count (0 = peer closed). EINTR-retried.
    public fn Result<usize, IoError> read(ref FixedArray<uint8> into) {
        while (true) {
            isize n = kama_recv(fd: this.fd, buf: addr(of: into[0]), n: cast<usize>(into.length()));
            if (n >= 0) { return Result::Ok(value: cast<usize>(n)); }
            if (kama_last_error() != kama_EINTR()) { return Result::Err(error: lastError()); }
        }
    }

    // Write the whole buffer, looping until every byte is sent (partial sends + EINTR handled).
    public fn Result<usize, IoError> writeAll(ref DynamicArray<uint8> bytes) {
        int32 total = cast<int32>(bytes.length());
        int32 off = 0;
        while (off < total) {
            int32 remaining = total - off;
            isize n = kama_send(fd: this.fd, buf: addr(of: bytes[off]), n: cast<usize>(remaining));
            if (n < 0) {
                if (kama_last_error() == kama_EINTR()) { continue; }
                return Result::Err(error: lastError());
            }
            off = off + cast<int32>(n);
        }
        return Result::Ok(value: cast<usize>(total));
    }

    // Toggle non-blocking mode. In non-blocking mode, read/write that would stall return WouldBlock.
    public fn Result<Unit, IoError> setNonBlocking(bool on) {
        int32 v = on ? 1 : 0;
        if (kama_set_nonblocking(fd: this.fd, on: v) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }

    // Disable Nagle's algorithm (TCP_NODELAY) — send small packets immediately. Latency-critical for games.
    public fn Result<Unit, IoError> setNoDelay(bool on) {
        int32 v = on ? 1 : 0;
        if (kama_set_nodelay(fd: this.fd, on: v) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }

    // Single-syscall send — may write fewer than all bytes (or Err(WouldBlock) when the socket buffer is
    // full). For a non-blocking sender managing its own outbound buffer; blocking senders use writeAll.
    public fn Result<usize, IoError> write(ref DynamicArray<uint8> bytes) {
        isize n = kama_send(fd: this.fd, buf: addr(of: bytes[0]), n: cast<usize>(bytes.length()));
        if (n >= 0) { return Result::Ok(value: cast<usize>(n)); }
        return Result::Err(error: lastError());
    }

    // Begin a non-blocking connect. The returned stream's connection may still be in flight: poll it for
    // writability (see std::net::Poller), then call checkConnected() to learn the outcome. host "" = loopback.
    public ctor Result<TcpStream, IoError> connectNonBlocking(ref string host, uint16 port) {
        int32 ir = kama_net_init();
        if (ir != 0) { return Result::Err(error: lastError()); }
        isize fd = kama_socket_tcp();
        if (fd < 0) { return Result::Err(error: lastError()); }
        if (kama_set_nonblocking(fd: fd, on: 1) != 0) {
            IoError e = lastError();
            int32 rc = kama_close_socket(fd: fd);
            return Result::Err(error: e);
        }
        if (kama_connect_inet(fd: fd, host: host.cstr(), port: port) != 0) {
            int32 e = kama_last_error();
            // EINPROGRESS (POSIX) / EAGAIN (Winsock WSAEWOULDBLOCK) = handshake in flight — NOT an error.
            if (e != kama_EINPROGRESS() && e != kama_EAGAIN()) {
                IoError err = lastError();
                int32 rc = kama_close_socket(fd: fd);
                return Result::Err(error: err);
            }
        }
        return Result::Ok(value: TcpStream(fd: fd));   // connected instantly (loopback) or in flight
    }

    // Resolve a non-blocking connect once the socket reports writable: Ok if connected, else the cause
    // (ConnectionRefused / TimedOut / …). Reads SO_ERROR — meaningful only after writability.
    public fn Result<Unit, IoError> checkConnected() {
        if (kama_socket_error(fd: this.fd) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }

    // The raw socket handle — the intended bridge for handing this stream to a std::net::Poller.
    public fn isize rawHandle() { return this.fd; }

    ~TcpStream() { if (this.fd >= 0) { int32 rc = kama_close_socket(fd: this.fd); } }
}

// A listening TCP socket. Closes on drop (RAII). Move-only.
type resource TcpListener {
    isize fd;
    private TcpListener(isize fd) { this.fd = fd; }

    // Bind + listen on a numeric host:port. host "" or "0.0.0.0" = all interfaces. SO_REUSEADDR is set.
    public ctor Result<TcpListener, IoError> bind(ref string host, uint16 port) {
        int32 ir = kama_net_init();
        if (ir != 0) { return Result::Err(error: lastError()); }
        isize fd = kama_socket_tcp();
        if (fd < 0) { return Result::Err(error: lastError()); }
        int32 ro = kama_set_reuseaddr(fd: fd);              // best-effort; ignore failure
        if (kama_bind_inet(fd: fd, host: host.cstr(), port: port) != 0) {
            IoError e = lastError();
            int32 rc = kama_close_socket(fd: fd);
            return Result::Err(error: e);
        }
        if (kama_listen(fd: fd, backlog: 128) != 0) {
            IoError e = lastError();
            int32 rc = kama_close_socket(fd: fd);
            return Result::Err(error: e);
        }
        return Result::Ok(value: TcpListener(fd: fd));
    }

    // Accept the next incoming connection (blocking). EINTR-retried.
    public fn Result<TcpStream, IoError> accept() {
        while (true) {
            isize cfd = kama_accept(fd: this.fd);
            if (cfd >= 0) { return Result::Ok(value: TcpStream(fd: cfd)); }
            if (kama_last_error() != kama_EINTR()) { return Result::Err(error: lastError()); }
        }
    }

    // Toggle non-blocking mode. In non-blocking mode, accept() returns Err(WouldBlock) when the queue is empty.
    public fn Result<Unit, IoError> setNonBlocking(bool on) {
        int32 v = on ? 1 : 0;
        if (kama_set_nonblocking(fd: this.fd, on: v) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }

    // The raw socket handle — the intended bridge for handing this listener to a std::net::Poller.
    public fn isize rawHandle() { return this.fd; }

    ~TcpListener() { if (this.fd >= 0) { int32 rc = kama_close_socket(fd: this.fd); } }
}
