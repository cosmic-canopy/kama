
import {
    std::io::IoError, std::io::IoErrorKind,
    std::io::lastError,
    std::collections::View, std::collections::ConstView,
    ReliableStream,
    Shutdown,
    SocketAddr,
    std::time::Duration,
    std::time::Instant,
    std::io::Descriptor,
    resolve,
    std::collections::DynamicArray,
    std::fs::File,
};

export { TcpListener, TcpStream, ListenOptions, ConnectOptions };

// POSIX/Winsock TCP bindings — see kama_os.h. Socket handles are `isize`: a Windows SOCKET is wider than
// int, and INVALID_SOCKET reinterpreted as isize is -1, so a uniform `< 0 == error` convention holds on
// both platforms. The sockaddr fill happens in C; kama passes the handle and an address as `address.kama`'s
// seam form (family 4 or 6, sixteen network-order bytes, port, scope id).
extern "kama_os.h";
extern fn int32 kama_net_init();
extern fn isize kama_socket_tcp(int32 family);
extern fn int32 kama_set_listen_reuseaddr(isize fd);
extern fn int32 kama_set_reuseport(isize fd);
extern fn int32 kama_bind_addr(isize fd, int32 family, UnsafeConstPtr<uint8> ip, uint16 port, uint32 scopeId);
extern fn int32 kama_connect_addr(isize fd, int32 family, UnsafeConstPtr<uint8> ip, uint16 port, uint32 scopeId);
extern fn int32 kama_listen(isize fd, int32 backlog);
extern fn isize kama_accept(isize fd);
extern fn isize kama_recv(isize fd, UnsafePtr<uint8> buf, usize n, int32 mode);
extern fn isize kama_send(isize fd, UnsafeConstPtr<uint8> buf, usize n, int32 mode);
extern fn int32 kama_close_socket(isize fd);
extern fn int32 kama_set_nonblocking(isize fd, int32 on);
extern fn int32 kama_set_nodelay(isize fd, int32 on);
extern fn int32 kama_socket_error(isize fd);
extern fn isize kama_desc_dup(isize h, int32 kind);
extern fn int32 kama_set_keepalive(isize fd, int32 on);
extern fn int32 kama_set_keepalive_idle(isize fd, int32 secs);
extern fn int32 kama_set_keepalive_interval(isize fd, int32 secs);
extern fn int32 kama_set_keepalive_count(isize fd, int32 count);
extern fn int32 kama_set_user_timeout(isize fd, int32 millis);
extern fn int32 kama_shutdown(isize fd, int32 how);
extern fn int32 kama_getsockname_addr(isize fd, UnsafePtr<int32> outFamily, UnsafePtr<uint8> outIp, UnsafePtr<uint16> outPort, UnsafePtr<uint32> outScope);
extern fn int32 kama_getpeername_addr(isize fd, UnsafePtr<int32> outFamily, UnsafePtr<uint8> outIp, UnsafePtr<uint16> outPort, UnsafePtr<uint32> outScope);
extern fn int32 kama_last_error();
extern fn int32 kama_EINTR();
extern fn int32 kama_ENOSYS();
extern fn isize kama_send_file(isize sock, int32 fd, uint64 offset, uint64 count);
extern fn int32 kama_EINPROGRESS();
// A socket's wait (kama_os.h, KR-3 step 5): before each blocking call and after it fails, so a call on a fiber parks it
// and a deadline holds on a thread.
extern fn int32 kama_net_ready(isize fd, UnsafePtr io, UnsafePtr<int32> mode, uint64 by);
extern fn int32 kama_net_retry(isize fd, UnsafePtr io, int32 mode, int32 interest, uint64 by);
extern fn int32 kama_net_connected(isize fd, UnsafePtr io, int32 mode, uint64 by);
extern fn int32 kama_net_drained(UnsafePtr io, int32 mode, int32 interest, uint64 by);
extern fn void kama_net_short(UnsafePtr io, int32 interest, isize got, isize asked);
extern fn int32 kama_net_close(isize fd, UnsafePtr io);
extern fn void kama_net_settle(isize fd, UnsafePtr io, int32 mode);
extern fn int32 kama_net_set_mode(isize fd, UnsafePtr io, UnsafePtr<int32> mode, int32 on);
extern fn int32 kama_net_adopt_mode(isize fd);

// A duration as a socket option takes it: a POSITIVE whole count of `unit` nanoseconds, rounded UP so a
// timer never fires earlier than asked. Zero, negative, or more units than an `int32` holds is
// `InvalidInput` — an option to leave at the OS default is simply not set.
fn Result<int32, IoError> unitsUp(Duration d, int64 unit) {
    if (d.nanos <= 0i64) { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); }
    int64 n = d.nanos / unit;
    if (d.nanos % unit != 0i64) { n = n + 1i64; }
    if (n > 2147483647i64) { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); }
    return Result::Ok(value: cast<int32>(n));
}

// A local or peer address, read back from the socket (`getsockname`/`getpeername` share the seam form).
unsafe fn Result<SocketAddr, IoError> socketAddrOf(isize fd, bool peer) {
    int32 family = 4;
    InlineArray<uint8>#(16) ip = [0; 16];
    uint16 port = 0ui16;
    uint32 zone = 0ui32;
    int32 rc = peer
        ? kama_getpeername_addr(fd: fd, outFamily: addr(of: family), outIp: addr(of: ip[0]), outPort: addr(of: port), outScope: addr(of: zone))
        : kama_getsockname_addr(fd: fd, outFamily: addr(of: family), outIp: addr(of: ip[0]), outPort: addr(of: port), outScope: addr(of: zone));
    if (rc != 0) { return Result::Err(error: lastError()); }
    return Result::Ok(value: SocketAddr.raw(family: family, bytes: ip, port: port, scopeId: zone));
}

// A connected TCP stream. Closes its socket on drop (RAII). Move-only. Implements the `ReliableStream`
// contract (a `Reader` + `Writer` + `setNonBlocking`; shared with the WebSocket backend). Blocking by
// default; `setNonBlocking(true)` makes read/write return `Err(WouldBlock)` instead of stalling.
type resource TcpStream implements ReliableStream, Sendable {   // a `Reader` and a `Writer`, by refinement
    // The empty niche is -1, not 0 (force-explicit-field-init makes the field default the place to
    // SAY so). A bare/moved-from slot therefore reads -1 and the destructor skips it, while fd 0
    // stays an ownable descriptor — stdin is a real handle, and `fd > 0` used to make it unownable
    // for no reason other than that zero doubled as "empty". Rust's `OwnedFd` niche.
    isize fd = -1;
    // How it waits (kama_os.h, KR-3 step 5): its registration with this isolate's fiber scheduler, the mode bits (the
    // program's non-blocking, kama's, a deadline set) and a deadline per direction, `Instant`'s nanoseconds, 0 for none.
    UnsafePtr io = null;
    int32 mode = 0;
    uint64 readBy = 0;
    uint64 writeBy = 0;
    // Wrap a connected socket kama itself just made (`connectTo`, `TcpListener.accept`). Private: a descriptor
    // from anywhere else arrives as a `std::io::Descriptor` and enters through `adopt`.
    // prefer `connect` for client sockets.
    unsafe ctor make(isize fd, UnsafePtr io, int32 mode) { this.fd = fd; this.io = io; this.mode = mode; }
    friend TcpListener::accept[make];

    // Connect to a numeric host:port ("127.0.0.1", "::1"; "" is IPv4 loopback). Text that is not a numeric
    // address is `Err(InvalidInput)` — no lookup happens here. The stream closes on drop.
    public unsafe ctor Result<TcpStream, IoError> connect(const ref string host, uint16 port) {
        return match (SocketAddr.host(text: host, port: port, forBind: false)) {
            case Err(error: e): Result::Err(error: e);
            case Ok(value: a): TcpStream.connectTo(address: a);
        };
    }

    // Connect to an address a lookup already produced — `resolve`/`resolveOne` in this module, or the
    // sender a datagram came from. The pair is deliberate: `connect` takes numeric text and performs no
    // lookup, so a call that reads like a syscall cannot silently make a DNS round trip, and a name is
    // resolved by a function that says so and hands back every address it found.
    @parks
    public unsafe ctor Result<TcpStream, IoError> connectTo(const ref SocketAddr address) {
        return TcpStream.dial(address: address, by: 0);
    }
    // `connectTo` with `ConnectOptions`: a deadline for the connect, which otherwise waits as long as the OS does (a
    // minute or two against a host that never answers). `Err(TimedOut)` once it passes — at once if it already has.
    public unsafe ctor Result<TcpStream, IoError> connectWith(const ref SocketAddr address, const ref ConnectOptions options) {
        uint64 by = match (options.deadline) { case Some(value: i): i.rawNanos == 0 ? 1 : i.rawNanos; case None: 0; };
        return TcpStream.dial(address: address, by: by);
    }
    @parks
    unsafe ctor Result<TcpStream, IoError> dial(const ref SocketAddr address, uint64 by) {
        int32 ir = kama_net_init();
        if (ir != 0) { return Result::Err(error: lastError()); }
        int32 family = address.ip.family();
        InlineArray<uint8>#(16) bytes = address.ip.bytes();
        isize fd = kama_socket_tcp(family: family);
        if (fd < 0) { return Result::Err(error: lastError()); }
        UnsafePtr io = null;
        int32 mode = by != 0 ? 4 : 0;                       // a deadline: waited out non-blocking, on a thread too
        int32 rc = kama_net_ready(fd: fd, io: addr(of: io), mode: addr(of: mode), by: by);   // on a fiber: parks below
        if (rc == 0) { rc = kama_connect_addr(fd: fd, family: family, ip: addr(of: bytes[0]), port: address.port, scopeId: address.scopeId); }
        if (rc != 0) { rc = kama_net_connected(fd: fd, io: io, mode: mode, by: by); }      // waits out a connect in flight
        if (rc != 0) {
            IoError e = lastError();                        // capture before close (close may clear errno)
            int32 cr = kama_net_close(fd: fd, io: io);
            return Result::Err(error: e);
        }
        return Result::Ok(value: TcpStream.make(fd: fd, io: io, mode: mode & 3));   // a connect's deadline is not the stream's
    }

    // Connect to a host NAME: `resolve` it, then try each address in the resolver's order and keep the first
    // that connects. Every address failing reports the LAST failure, the one nearest the caller's intent.
    //
    // This is the call that makes a name work whichever family its server listens on. The resolver's order
    // is not "the one that is up": on macOS `localhost` is `::1` first, so connecting to only the first
    // address of `resolve("localhost")` is refused by a server bound to `127.0.0.1`, and the next address
    // would have worked. Tried one after another, not raced (no RFC 8305 happy eyeballs): an address that
    // times out rather than refusing stalls the attempts behind it.
    public unsafe ctor Result<TcpStream, IoError> connectHost(const ref string host, uint16 port) {
        DynamicArray<SocketAddr> addrs = DynamicArray.empty();
        Result<DynamicArray<SocketAddr>, IoError> found = resolve(host: host, port: port);
        match (give found) {
            case Err(error: e): { return Result::Err(error: e); }
            case Ok(value: list): { addrs = give list; }
        };
        IoError last = IoError.of(kind: IoErrorKind::HostUnreachable);   // `resolve` never succeeds empty, so an attempt replaces it
        isize i = 0;
        while (i < addrs.length()) {
            Result<TcpStream, IoError> attempt = TcpStream.connectTo(address: addrs[i]);
            match (give attempt) {
                case Ok(value: s): { return Result::Ok(value: give s); }
                case Err(error: e): { last = e; }
            };
            i = i + 1;
        }
        return Result::Err(error: last);
    }

    // `Reader`: read up to into.length() bytes into `into`; returns the count (0 = peer closed). EINTR-retried.
    @parks
    public unsafe fn Result<isize, IoError> read(View<uint8> into) {
        if (into.length() == 0) { return Result::Ok(value: 0); }
        if (kama_net_ready(fd: this.fd, io: addr(of: this.io), mode: addr(of: this.mode), by: this.readBy) != 0) { return Result::Err(error: lastError()); }
        if (kama_net_drained(io: this.io, mode: this.mode, interest: 1, by: this.readBy) != 0) { return Result::Err(error: lastError()); }
        while (true) {
            isize n = kama_recv(fd: this.fd, buf: addr(of: into[0]), n: cast<usize>(into.length()), mode: this.mode);
            if (n >= 0) { kama_net_short(io: this.io, interest: 1, got: n, asked: into.length()); return Result::Ok(value: n); }
            if (kama_net_retry(fd: this.fd, io: this.io, mode: this.mode, interest: 1, by: this.readBy) == 0) { return Result::Err(error: lastError()); }
        }
    }

    // A deadline for reads (KR-3 step 5, Go's): an absolute `Instant` after which a read fails with `Err(TimedOut)`
    // — at once if it has passed, even with bytes waiting — until it is reset; `None` clears it. It bounds every
    // read after it, so one deadline bounds an exchange of several: set it again for each, for a per-read limit.
    // On a fiber the read parks until then; on a thread it waits in a poll for the time left.
    public fn void setReadDeadline(Optional<Instant> at) {
        uint64 by = match (at) { case Some(value: i): i.rawNanos == 0 ? 1 : i.rawNanos; case None: 0; };
        this.readBy = by;
        this.mode = this.readBy != 0 || this.writeBy != 0 ? (this.mode | 4) : (this.mode & 3);
    }
    // A deadline for writes, as `setReadDeadline` is for reads (a connect's is `ConnectOptions`).
    public fn void setWriteDeadline(Optional<Instant> at) {
        uint64 by = match (at) { case Some(value: i): i.rawNanos == 0 ? 1 : i.rawNanos; case None: 0; };
        this.writeBy = by;
        this.mode = this.writeBy != 0 || this.readBy != 0 ? (this.mode | 4) : (this.mode & 3);
    }

    // Toggle non-blocking mode. In non-blocking mode, read/write that would stall return WouldBlock — on a fiber too,
    // where a blocking one parks instead.
    public unsafe fn Result<Unit, IoError> setNonBlocking(bool on) {
        if (kama_net_set_mode(fd: this.fd, io: this.io, mode: addr(of: this.mode), on: on ? 1 : 0) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }

    // Disable Nagle's algorithm (TCP_NODELAY) — send small packets immediately. Latency-critical for games.
    public unsafe fn Result<Unit, IoError> setNoDelay(bool on) {
        int32 v = on ? 1 : 0;
        if (kama_set_nodelay(fd: this.fd, on: v) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }

    // TCP keepalive (SO_KEEPALIVE): probe an idle connection, so a peer that vanished without a FIN — a NAT
    // that forgot the flow, a failed-over server — is noticed instead of a read waiting forever. Off by
    // default. The three knobs below tune it one at a time (libpq's four settings map one-to-one), each a
    // positive value in whole seconds (a count for the last); one left unset keeps the OS's.
    public unsafe fn Result<Unit, IoError> setKeepAlive(bool on) {
        if (kama_set_keepalive(fd: this.fd, on: on ? 1 : 0) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }
    // How long the connection sits idle before the first probe.
    public unsafe fn Result<Unit, IoError> setKeepAliveIdle(Duration idle) {
        int32 secs = 0;
        match (unitsUp(d: idle, unit: 1000000000i64)) { case Err(error: e): { return Result::Err(error: e); } case Ok(value: v): { secs = v; } };
        if (kama_set_keepalive_idle(fd: this.fd, secs: secs) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }
    // The gap between unanswered probes.
    public unsafe fn Result<Unit, IoError> setKeepAliveInterval(Duration interval) {
        int32 secs = 0;
        match (unitsUp(d: interval, unit: 1000000000i64)) { case Err(error: e): { return Result::Err(error: e); } case Ok(value: v): { secs = v; } };
        if (kama_set_keepalive_interval(fd: this.fd, secs: secs) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }
    // How many unanswered probes drop the connection.
    public unsafe fn Result<Unit, IoError> setKeepAliveCount(uint32 count) {
        if (count == 0ui32 || count > 2147483647ui32) { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); }
        if (kama_set_keepalive_count(fd: this.fd, count: cast<int32>(count)) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }
    // How long written data may go unacknowledged before the connection is dropped — the bound on a write
    // to a peer that stopped answering (Linux `TCP_USER_TIMEOUT`, macOS `TCP_RXT_CONNDROPTIME`, Windows
    // `TCP_MAXRT`). Milliseconds on Linux, whole seconds (rounded up) elsewhere. Positive; unset keeps the OS's.
    public unsafe fn Result<Unit, IoError> setUserTimeout(Duration timeout) {
        int32 ms = 0;
        match (unitsUp(d: timeout, unit: 1000000i64)) { case Err(error: e): { return Result::Err(error: e); } case Ok(value: v): { ms = v; } };
        if (kama_set_user_timeout(fd: this.fd, millis: ms) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }
    // Close one half of the connection (see `Shutdown`); dropping the stream closes both and the socket.
    public unsafe fn Result<Unit, IoError> shutdown(Shutdown how) {
        int32 h = match (how) { case Read: 0; case Write: 1; case Both: 2; };
        if (kama_shutdown(fd: this.fd, how: h) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }
    // This end's address (the ephemeral port a connect was given), and the peer's — how a server learns
    // who an accepted stream belongs to.
    public const fn Result<SocketAddr, IoError> localAddr() { return socketAddrOf(fd: this.fd, peer: false); }
    public const fn Result<SocketAddr, IoError> peerAddr() { return socketAddrOf(fd: this.fd, peer: true); }

    // `Writer` primitive: single-syscall send — may write fewer than all bytes (or Err(WouldBlock) when the
    // socket buffer is full). EINTR-retried. Callers wanting every byte sent use the free `std::io::writeAll`.
    @parks
    public unsafe fn Result<isize, IoError> write(ConstView<uint8> bytes) {
        if (bytes.length() == 0) { return Result::Ok(value: 0); }
        if (kama_net_ready(fd: this.fd, io: addr(of: this.io), mode: addr(of: this.mode), by: this.writeBy) != 0) { return Result::Err(error: lastError()); }
        if (kama_net_drained(io: this.io, mode: this.mode, interest: 2, by: this.writeBy) != 0) { return Result::Err(error: lastError()); }
        while (true) {
            isize n = kama_send(fd: this.fd, buf: bytes.dataPtr(), n: cast<usize>(bytes.length()), mode: this.mode);
            if (n >= 0) { kama_net_short(io: this.io, interest: 2, got: n, asked: bytes.length()); return Result::Ok(value: n); }
            if (kama_net_retry(fd: this.fd, io: this.io, mode: this.mode, interest: 2, by: this.writeBy) == 0) { return Result::Err(error: lastError()); }
        }
    }

    // Send up to `count` bytes of `file`, from `offset`, and answer the count sent: how a server answers a request with a
    // file (KR-207). Like `write`, it may send less than asked, so loop, advancing `offset`; on a non-blocking stream,
    // nothing sent is `Err(WouldBlock)`. 0 means `offset` is at or past the end of the file. The file's own cursor never
    // moves, as for `readAt`. Linux and macOS send straight from the page cache (`sendfile`; measured on macOS, about 40%
    // fewer cycles than a read and write loop). Where the OS cannot, it copies through a small buffer, with the same
    // result: Windows, whose `TransmitFile` would block a non-blocking socket for the whole count (KR-229); wasm; and a
    // file the kernel has no such path for. A peer that has gone is an error here, never a signal.
    @parks
    public unsafe fn Result<uint64, IoError> sendFile(const ref File file, uint64 offset, uint64 count) {
        if (count == 0ui64) { return Result::Ok(value: 0ui64); }
        if (kama_net_ready(fd: this.fd, io: addr(of: this.io), mode: addr(of: this.mode), by: this.writeBy) != 0) { return Result::Err(error: lastError()); }
        while (true) {
            isize n = kama_send_file(sock: this.fd, fd: file.rawFd(), offset: offset, count: count);
            if (n >= 0) { return Result::Ok(value: cast<uint64>(n)); }
            if (kama_last_error() == kama_ENOSYS()) { return this.sendFileCopy(file: file, offset: offset, count: count); }
            if (kama_net_retry(fd: this.fd, io: this.io, mode: this.mode, interest: 2, by: this.writeBy) == 0) { return Result::Err(error: lastError()); }
        }
    }
    // The buffered way, where the zero-copy one is not: one read at `offset` and one write, so a buffer's worth at most
    // per call, never more than the stream took, and nothing allocated.
    unsafe fn Result<uint64, IoError> sendFileCopy(const ref File file, uint64 offset, uint64 count) {
        InlineArray<uint8>#(8192) buf = [0ui8; 8192];
        isize want = count < 8192ui64 ? cast<isize>(count) : 8192;
        Result<isize, IoError> r = file.readAt(into: buf.viewMut().slice(from: 0, count: want), offset: offset);
        isize got = match (r) { case Ok(value: k): k; case Err(error: e): { return Result::Err(error: e); } };
        if (got == 0) { return Result::Ok(value: 0ui64); }
        Result<isize, IoError> w = this.write(bytes: buf.view().slice(from: 0, count: got));
        return match (w) { case Ok(value: k): Result::Ok(value: cast<uint64>(k)); case Err(error: e): Result::Err(error: e); };
    }

    // `Writer`: our layer is unbuffered (the OS holds the send buffer), so flush is a no-op.
    public fn Result<Unit, IoError> flush() { return Result::Ok(value: Unit::Unit); }

    // Begin a non-blocking connect. The returned stream's connection may still be in flight: poll it for
    // writability (see std::net::Poller), then call checkConnected() to learn the outcome. host "" = loopback;
    // text that is not a numeric address is `Err(InvalidInput)`.
    public unsafe ctor Result<TcpStream, IoError> connectNonBlocking(const ref string host, uint16 port) {
        return match (SocketAddr.host(text: host, port: port, forBind: false)) {
            case Err(error: e): Result::Err(error: e);
            case Ok(value: a): TcpStream.connectToNonBlocking(address: a);
        };
    }

    // `connectNonBlocking` to an address a lookup or a datagram already produced (a scoped one included).
    public unsafe ctor Result<TcpStream, IoError> connectToNonBlocking(const ref SocketAddr address) {
        int32 ir = kama_net_init();
        if (ir != 0) { return Result::Err(error: lastError()); }
        int32 family = address.ip.family();
        InlineArray<uint8>#(16) bytes = address.ip.bytes();
        isize fd = kama_socket_tcp(family: family);
        if (fd < 0) { return Result::Err(error: lastError()); }
        if (kama_set_nonblocking(fd: fd, on: 1) != 0) {
            IoError e = lastError();
            int32 rc = kama_close_socket(fd: fd);
            return Result::Err(error: e);
        }
        if (kama_connect_addr(fd: fd, family: family, ip: addr(of: bytes[0]), port: address.port, scopeId: address.scopeId) != 0) {
            int32 e = kama_last_error();
            // EINPROGRESS = handshake in flight — NOT an error. Winsock's WSAEWOULDBLOCK arrives as EINPROGRESS too
            // (the seam's connect hands it over that way), so one test serves every OS — and a Linux EAGAIN, which
            // for TCP means the routing cache is exhausted, stays the error it is.
            if (e != kama_EINPROGRESS()) {
                IoError err = lastError();
                int32 rc = kama_close_socket(fd: fd);
                return Result::Err(error: err);
            }
        }
        return Result::Ok(value: TcpStream.make(fd: fd, io: null, mode: 1));   // the program's non-blocking: connected instantly (loopback) or in flight
    }

    // Resolve a non-blocking connect once the socket reports writable: Ok if connected, else the cause
    // (ConnectionRefused / TimedOut / …). Reads SO_ERROR — meaningful only after writability.
    public unsafe fn Result<Unit, IoError> checkConnected() {
        if (kama_socket_error(fd: this.fd) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }

    // Adopt an owned descriptor (`std::io::Descriptor`) — one received over a Unix socket, or made from a raw
    // number by `Descriptor.adoptSocket(raw:)`. On Windows it must be a socket's (`InvalidInput`, and it is closed).
    // The stream keeps the mode the descriptor arrived in (read back on POSIX; Windows cannot, so there it is taken as
    // blocking, and a program that made it non-blocking says so with `setNonBlocking(true)`).
    public unsafe ctor Result<TcpStream, IoError> adopt(Descriptor descriptor) {
        return match (descriptor.release(asSocket: true)) {
            case Err(error: e): Result::Err(error: e);
            case Ok(value: h): Result::Ok(value: TcpStream.make(fd: h, io: null, mode: kama_net_adopt_mode(fd: h)));
        };
    }
    // Give the socket up as a `Descriptor`, leaving this empty (its drop closes nothing). It leaves in the mode the
    // program asked for, off any fiber scheduler.
    public unsafe fn Descriptor takeDescriptor() {
        isize h = this.fd;
        kama_net_settle(fd: h, io: this.io, mode: this.mode);
        this.fd = -1; this.io = null; this.mode = 0;
        return Descriptor.adoptSocket(raw: h);
    }
    // A second descriptor for this same socket, closed independently — what `sendDescriptors` consumes when
    // you keep this one. It shares the open socket's mode: one used on a fiber is non-blocking (KR-3 decision 13).
    public unsafe fn Result<Descriptor, IoError> duplicateDescriptor() {
        isize d = kama_desc_dup(h: this.fd, kind: 1);
        if (d < 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Descriptor.adoptSocket(raw: d));
    }
    // The raw socket handle — the intended bridge for handing this stream to a std::net::Poller. Lent as it is: on a
    // fiber, kama has made it non-blocking.
    public const fn isize rawHandle() { return this.fd; }

    // The test is `>= 0`, not `> 0` — the explicit `isize fd = -1` states the empty niche, so fd 0 is an
    // ownable descriptor rather than a second sentinel (same reconcile as std::fs::File's `~File`).
    // Unlike `File`, nothing re-arms this handle: every ctor path rejects `fd < 0` before constructing, so
    // a live socket always has `fd >= 0`, and `slot` + drop-only-if-live keep an unconstructed one from
    // reaching here at all. The guard is therefore REDUNDANT, and it stays deliberately — one predictable
    // compare in front of a syscall, standing between a future drop-tracking bug and a silent `close(0)`
    // on stdin. Cheap insurance against a catastrophic, near-undebuggable failure. Same for the two below.
    unsafe ~TcpStream() { if (this.fd >= 0) { int32 rc = kama_net_close(fd: this.fd, io: this.io); } }
}

// The options `TcpListener.bindWith` takes (KR-206): one type on every OS, each its own OS's (the platform rule). Each
// carries `backlog`, the length of the accept queue, 128 by default (what `bind` uses); the OS caps a larger one at its
// own maximum. Where a kernel lets several listeners share one port, the type says what that kernel then does, under
// its own name, because the OSes do different things:
// - Linux: `balance`. The kernel spreads new connections across every listener on the port (`SO_REUSEPORT`): an
//   isolate per core, each accepting on its own listener. Measured: 102 and 98 of 200.
// - macOS: `handOff`. Every new connection goes to the listener bound LAST (`SO_REUSEPORT` there): a graceful restart,
//   the new process binding beside the old one. Measured: 200 of 200. It is not a balancer, so it is not called one.
// - Windows and every other target: the backlog alone.
// Every listener on a shared port must ask for it. `@compileFor` gates a declaration and never a statement, so code
// that sets `balance` lives in a function or type gated to Linux.
@compileFor(OS_LINUX)
type value ListenOptions implements Sendable {
    public int32 backlog = 128;
    public bool balance = false;
    public ctor make() { }
    const fn bool sharesPort() { return this.balance; }
    friend TcpListener::bindWith[sharesPort];
}
@compileFor(OS_MACOS)
type value ListenOptions implements Sendable {
    public int32 backlog = 128;
    public bool handOff = false;
    public ctor make() { }
    const fn bool sharesPort() { return this.handOff; }
    friend TcpListener::bindWith[sharesPort];
}
@compileFor(!OS_LINUX, !OS_MACOS)
type value ListenOptions implements Sendable {
    public int32 backlog = 128;
    public ctor make() { }
    const fn bool sharesPort() { return false; }
    friend TcpListener::bindWith[sharesPort];
}

// The options a connect takes (`TcpStream.connectWith`, `UnixStream.connectWith`), as `ListenOptions` are a
// listener's: `deadline`, an absolute `Instant` by which the connect must be made, or `None` (the default) to wait as
// long as the OS does. A connect still waiting when it passes, or made after, fails with `Err(TimedOut)`.
type value ConnectOptions implements Sendable {
    public Optional<Instant> deadline = Optional::None;
    public ctor make() { }
}

// A listening TCP socket. Closes on drop (RAII). Move-only.
type resource TcpListener implements Sendable {
    isize fd = -1;   // the -1 empty niche — see ~TcpStream
    UnsafePtr io = null;   // how it waits, as `TcpStream`'s; an accept's deadline is its read's
    int32 mode = 0;
    uint64 acceptBy = 0;
    private ctor make(isize fd, int32 mode) { this.fd = fd; this.mode = mode; }

    // Bind + listen on a numeric host:port. "" or "0.0.0.0" = every IPv4 interface; "::" = every interface of
    // BOTH families (IPV6_V6ONLY is turned off on every OS, so a v4 client arrives as `::ffff:a.b.c.d`).
    // Text that is not a numeric address is `Err(InvalidInput)`. A port another listener holds is `AddrInUse` on every OS.
    // On Linux and macOS SO_REUSEADDR is set, so a restarted server rebinds a port whose old connections linger in
    // TIME_WAIT; Windows rebinds one by default, and there the option would let a second listener take a live port.
    public unsafe ctor Result<TcpListener, IoError> bind(const ref string host, uint16 port) {
        return match (SocketAddr.host(text: host, port: port, forBind: true)) {
            case Err(error: e): Result::Err(error: e);
            case Ok(value: a): TcpListener.bindTo(address: a);
        };
    }

    // `bind` to an address value — the one spelling that reaches a link-local V6 address, whose interface is
    // its `scopeId` and has no place in host text.
    public unsafe ctor Result<TcpListener, IoError> bindTo(const ref SocketAddr address) {
        return TcpListener.listenOn(address: address, backlog: 128, sharePort: false);
    }

    // `bindTo` with `ListenOptions`: the backlog, and where the OS has it, a port several listeners share. A negative
    // backlog is `InvalidInput`.
    public unsafe ctor Result<TcpListener, IoError> bindWith(const ref SocketAddr address, const ref ListenOptions options) {
        if (options.backlog < 0) { return Result::Err(error: IoError.of(kind: IoErrorKind::InvalidInput)); }
        return TcpListener.listenOn(address: address, backlog: options.backlog, sharePort: options.sharesPort());
    }

    unsafe ctor Result<TcpListener, IoError> listenOn(const ref SocketAddr address, int32 backlog, bool sharePort) {
        int32 ir = kama_net_init();
        if (ir != 0) { return Result::Err(error: lastError()); }
        int32 family = address.ip.family();
        InlineArray<uint8>#(16) bytes = address.ip.bytes();
        isize fd = kama_socket_tcp(family: family);
        if (fd < 0) { return Result::Err(error: lastError()); }
        int32 ro = kama_set_listen_reuseaddr(fd: fd);       // best-effort; ignore failure
        if (sharePort && kama_set_reuseport(fd: fd) != 0) {  // asked for, so a refusal is the answer
            IoError e = lastError();
            int32 rc = kama_close_socket(fd: fd);
            return Result::Err(error: e);
        }
        if (kama_bind_addr(fd: fd, family: family, ip: addr(of: bytes[0]), port: address.port, scopeId: address.scopeId) != 0) {
            IoError e = lastError();
            int32 rc = kama_close_socket(fd: fd);
            return Result::Err(error: e);
        }
        if (kama_listen(fd: fd, backlog: backlog) != 0) {
            IoError e = lastError();
            int32 rc = kama_close_socket(fd: fd);
            return Result::Err(error: e);
        }
        return Result::Ok(value: TcpListener.make(fd: fd, mode: 0));
    }

    // Accept the next incoming connection. EINTR-retried. The stream starts in this listener's mode on every OS:
    // from a non-blocking listener, a non-blocking stream (and `Err(WouldBlock)` here when none is queued).
    @parks
    public unsafe fn Result<TcpStream, IoError> accept() {
        if (kama_net_ready(fd: this.fd, io: addr(of: this.io), mode: addr(of: this.mode), by: this.acceptBy) != 0) { return Result::Err(error: lastError()); }
        while (true) {
            isize cfd = kama_accept(fd: this.fd);
            if (cfd >= 0) { return Result::Ok(value: TcpStream.make(fd: cfd, io: null, mode: this.mode & 3)); }   // its mode, as the OS gave it
            if (kama_net_retry(fd: this.fd, io: this.io, mode: this.mode, interest: 1, by: this.acceptBy) == 0) { return Result::Err(error: lastError()); }
        }
    }

    // A deadline for `accept`, as `setReadDeadline` is for a stream's reads: `Err(TimedOut)` once it has passed.
    public fn void setAcceptDeadline(Optional<Instant> at) {
        uint64 by = match (at) { case Some(value: i): i.rawNanos == 0 ? 1 : i.rawNanos; case None: 0; };
        this.acceptBy = by;
        this.mode = this.acceptBy != 0 ? (this.mode | 4) : (this.mode & 3);
    }

    // Toggle non-blocking mode. In non-blocking mode, accept() returns Err(WouldBlock) when the queue is empty — on a
    // fiber too, where a blocking one parks instead.
    public unsafe fn Result<Unit, IoError> setNonBlocking(bool on) {
        if (kama_net_set_mode(fd: this.fd, io: this.io, mode: addr(of: this.mode), on: on ? 1 : 0) != 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Unit::Unit);
    }

    // The address it listens on — the one way to learn the port the OS picked for `bind(host:, port: 0)`.
    public const fn Result<SocketAddr, IoError> localAddr() { return socketAddrOf(fd: this.fd, peer: false); }

    // Adopt an owned descriptor (`std::io::Descriptor`) — one received over a Unix socket, or made from a raw
    // number by `Descriptor.adoptSocket(raw:)`. On Windows it must be a socket's (`InvalidInput`, and it is closed).
    public unsafe ctor Result<TcpListener, IoError> adopt(Descriptor descriptor) {
        return match (descriptor.release(asSocket: true)) {
            case Err(error: e): Result::Err(error: e);
            case Ok(value: h): Result::Ok(value: TcpListener.make(fd: h, mode: kama_net_adopt_mode(fd: h)));
        };
    }
    // Give the socket up as a `Descriptor`, leaving this empty (its drop closes nothing), in the program's mode.
    public unsafe fn Descriptor takeDescriptor() {
        isize h = this.fd;
        kama_net_settle(fd: h, io: this.io, mode: this.mode);
        this.fd = -1; this.io = null; this.mode = 0;
        return Descriptor.adoptSocket(raw: h);
    }
    // A second descriptor for this same socket, closed independently — what `sendDescriptors` consumes when
    // you keep this one.
    public unsafe fn Result<Descriptor, IoError> duplicateDescriptor() {
        isize d = kama_desc_dup(h: this.fd, kind: 1);
        if (d < 0) { return Result::Err(error: lastError()); }
        return Result::Ok(value: Descriptor.adoptSocket(raw: d));
    }
    // The raw socket handle — the intended bridge for handing this listener to a std::net::Poller.
    public const fn isize rawHandle() { return this.fd; }

    unsafe ~TcpListener() { if (this.fd >= 0) { int32 rc = kama_net_close(fd: this.fd, io: this.io); } }   // guard: see ~TcpStream
}
