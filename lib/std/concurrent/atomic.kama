
export { Atomic, MemoryOrder };

// `Atomic<T>` — the ONE sanctioned cross-isolate shared-MUTABLE cell (M6). The concurrency analog of
// `unsafe fn`/`UnsafePtr`: an opt-in, greppable seam where a value may be read and written concurrently by
// several isolates WITHOUT a data race. Everything else in the language is shared-nothing (an isolate owns
// its state; sharing is by move (`give`) or by immutable `Shared`). When two tasks must touch the SAME
// mutable location — a counter, a done-flag, a lock-free head pointer — that location is an `Atomic<T>`.
//
// `T` is an integer primitive (`int8`…`uint64`, `usize`/`isize`) or `UnsafePtr` — a naturally-aligned lock-free
// scalar. A non-scalar element (a `resource`/`value`/contract) is a compile error: atomicity is a hardware
// property of a machine word, so a struct can't be one cell (compose several `Atomic` fields instead).
//
// Sharing model: an `Atomic<T>` is a move-only `resource` (no silent copies — a copy would be a SECOND,
// independent cell, defeating the point). Cross-isolate sharing is by `ref`-borrow inside a `scope`: the
// scope joins every child before the cell's owner drops it, so the borrow can't dangle, and — uniquely for
// `Atomic` — SEVERAL children may borrow the SAME cell (the sanctioned shared-mutable case, exempted from
// the disjoint-borrow rule that governs ordinary locals):
//
//     import std::concurrent;
//     fn void bump(ref Atomic<int32> c) { c.fetchAdd(delta: 1i32); }
//     fn int main() {
//         Atomic<int32> counter = Atomic.make(value: 0i32);
//         scope {
//             spawn bump(c: ref counter);      // many children, one shared cell — race-free
//             spawn bump(c: ref counter);
//         }                                     // barrier: both joined before `counter` drops
//         return counter.load();                // 2
//     }
//
// The bare methods (`load`/`store`/`swap`/`compareExchange`/`fetchAdd`/`fetchSub`) are sequentially
// consistent (seq-cst) — the strongest, simplest ordering, always correct; reach for these by default. Each
// has an `…Explicit` sibling taking an explicit `MemoryOrder` for the expert who wants a weaker (faster)
// ordering — mirroring C11's `atomic_load` / `atomic_load_explicit`. kama has no overloading, so the ordering
// knob is simply a distinct, explicitly-named function (the language's one-way idiom), not a default arg.
//
// The cell is one inline `T`; each method takes its address to the width-generic op layer in kama_atomic.h,
// which dispatches on `sizeof(T)` to a lock-free `__atomic_*_n` builtin (native AND wasm, one source).

// Memory ordering for an atomic op (the `…Explicit` variants). Values match the compiler's `__ATOMIC_*`
// enum, bridged by `orderBits`. `Consume` is deliberately omitted (every compiler treats it as `Acquire`;
// even C++ discourages it). A load takes Relaxed/Acquire/SeqCst; a store Relaxed/Release/SeqCst; a
// read-modify-write any of them — passing an ordering an op can't honor is a programmer error (as in C11).
type enum MemoryOrder { Relaxed, Acquire, Release, AcqRel, SeqCst }

// Bridge a `MemoryOrder` to the `__ATOMIC_*` int the seam layer expects. Private to the module.
fn int32 orderBits(MemoryOrder o) {
    return match (o) {
        case Relaxed: 0i32;
        case Acquire: 2i32;
        case Release: 3i32;
        case AcqRel:  4i32;
        case SeqCst:  5i32;
    };
}

extern "kama_atomic.h";
extern fn void   kama_atomic_load     (UnsafePtr cell, UnsafePtr dst, usize width, int32 mo);
extern fn void   kama_atomic_store    (UnsafePtr cell, UnsafePtr val, usize width, int32 mo);
extern fn void   kama_atomic_swap     (UnsafePtr cell, UnsafePtr val, UnsafePtr dst, usize width, int32 mo);
extern fn int32  kama_atomic_cas      (UnsafePtr cell, UnsafePtr expected, UnsafePtr desired, usize width, int32 smo, int32 fmo);
extern fn void   kama_atomic_fetch_add(UnsafePtr cell, UnsafePtr delta, UnsafePtr dst, usize width, int32 mo);
extern fn void   kama_atomic_fetch_sub(UnsafePtr cell, UnsafePtr delta, UnsafePtr dst, usize width, int32 mo);

type resource Atomic<T> {
    T value;   // the one shared cell; naturally aligned (a single-field struct), so the ops are lock-free

    // Build a cell holding `value`. The only constructor — an `Atomic` is always created initialized.
    public ctor make(T value) {
        this.value = value;
    }

    // Atomically read the current value (seq-cst). `loadExplicit` takes a weaker ordering.
    public fn T load() { return this.loadExplicit(order: MemoryOrder::SeqCst); }
    public fn T loadExplicit(MemoryOrder order) {
        slot T result;
        this.loadInto(order: order, dst: out result);
        return result;
    }
    // The `out` boundary over the type-erased C call: `kama_atomic_load` IS an out-parameter, just spelled
    // `void*`. Naming it that way is what lets the caller's hole be filled the one way a `slot` allows.
    unsafe fn void loadInto(MemoryOrder order, out T dst) {
        kama_atomic_load(cell: cast<UnsafePtr>(addr(of: this.value)), dst: cast<UnsafePtr>(addr(of: dst)),
                         width: sizeof(T), mo: orderBits(o: order));
    }

    // Atomically replace the value (seq-cst). `storeExplicit` takes a weaker ordering.
    public fn void store(T value) { this.storeExplicit(value: value, order: MemoryOrder::SeqCst); }
    public unsafe fn void storeExplicit(T value, MemoryOrder order) {
        kama_atomic_store(cell: cast<UnsafePtr>(addr(of: this.value)), val: cast<UnsafePtr>(addr(of: value)),
                          width: sizeof(T), mo: orderBits(o: order));
    }

    // Atomically store `value` and return the PRIOR value (atomic exchange, seq-cst).
    public fn T swap(T value) { return this.swapExplicit(value: value, order: MemoryOrder::SeqCst); }
    public fn T swapExplicit(T value, MemoryOrder order) {
        slot T result;
        this.swapInto(value: value, order: order, dst: out result);
        return result;
    }
    unsafe fn void swapInto(T value, MemoryOrder order, out T dst) {
        kama_atomic_swap(cell: cast<UnsafePtr>(addr(of: this.value)), val: cast<UnsafePtr>(addr(of: value)),
                         dst: cast<UnsafePtr>(addr(of: dst)), width: sizeof(T), mo: orderBits(o: order));
    }

    // Compare-and-swap: if the cell equals `expected`, store `desired` and return true; otherwise write the
    // observed value back through `expected` and return false. The write-back lets a CAS loop retry against
    // the fresh value without a separate reload:
    //     int32 cur = a.load();
    //     while (!a.compareExchange(expected: ref cur, desired: cur + 1i32)) { }   // cur is refreshed on failure
    // `compareExchangeExplicit` takes distinct success/failure orderings (the failure order must be no
    // stronger than success, and never Release/AcqRel — a failed CAS performs only a load, as in C11).
    public fn bool compareExchange(ref T expected, T desired) {
        return this.compareExchangeExplicit(expected: ref expected, desired: desired,
                                            success: MemoryOrder::SeqCst, failure: MemoryOrder::SeqCst);
    }
    public unsafe fn bool compareExchangeExplicit(ref T expected, T desired, MemoryOrder success, MemoryOrder failure) {
        int32 ok = 0i32;
        ok = kama_atomic_cas(cell: cast<UnsafePtr>(addr(of: this.value)), expected: cast<UnsafePtr>(addr(of: expected)),
                             desired: cast<UnsafePtr>(addr(of: desired)), width: sizeof(T),
                             smo: orderBits(o: success), fmo: orderBits(o: failure));
        return ok != 0i32;
    }

    // Atomically add `delta` and return the PRIOR value (integer elements; seq-cst). Wraps two's-complement.
    //
    // The prior value crosses the C boundary through an `out` parameter, exactly as `load` and `swap` do
    // above, rather than as a `uint64` converted on both sides. Converting was correct only while a
    // narrowing `cast` truncated; since it TRAPS, `Atomic<int8>` aborted on any negative prior and any
    // negative delta. Moving `sizeof(T)` bytes converts nothing — and it leaves no `cast<T>` in this type,
    // which is what lets an uninstantiated `Atomic<T>` be checked as thoroughly as an instantiated one.
    public fn T fetchAdd(T delta) { return this.fetchAddExplicit(delta: delta, order: MemoryOrder::SeqCst); }
    public fn T fetchAddExplicit(T delta, MemoryOrder order) {
        slot T result;
        this.fetchAddInto(delta: delta, order: order, dst: out result);
        return result;
    }
    unsafe fn void fetchAddInto(T delta, MemoryOrder order, out T dst) {
        kama_atomic_fetch_add(cell: cast<UnsafePtr>(addr(of: this.value)),
                              delta: cast<UnsafePtr>(addr(of: delta)), dst: cast<UnsafePtr>(addr(of: dst)),
                              width: sizeof(T), mo: orderBits(o: order));
    }

    // Atomically subtract `delta` and return the PRIOR value (integer elements; seq-cst). Wraps two's-complement.
    public fn T fetchSub(T delta) { return this.fetchSubExplicit(delta: delta, order: MemoryOrder::SeqCst); }
    public fn T fetchSubExplicit(T delta, MemoryOrder order) {
        slot T result;
        this.fetchSubInto(delta: delta, order: order, dst: out result);
        return result;
    }
    unsafe fn void fetchSubInto(T delta, MemoryOrder order, out T dst) {
        kama_atomic_fetch_sub(cell: cast<UnsafePtr>(addr(of: this.value)),
                              delta: cast<UnsafePtr>(addr(of: delta)), dst: cast<UnsafePtr>(addr(of: dst)),
                              width: sizeof(T), mo: orderBits(o: order));
    }

    // No destructor, deliberately. An `Atomic<T>` owns nothing — the cell is inline and a zero value is
    // drop-safe (INVARIANT #0) — and kama generates a destructor only for a type that has teardown to do,
    // transitively, whether or not one is written. An EMPTY `~Atomic() { }` was not documentation: it set
    // `hasDtor`, which makes the type `destructible`, which means "needs teardown at scope exit" — barring
    // it from a module `static`, the one place a foreign-thread callback could reach a shared cell.
}
