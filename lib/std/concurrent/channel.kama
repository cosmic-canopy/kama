
export { Channel, Sender, Receiver, SendResult };

// A typed, blocking channel for moving values BETWEEN isolates — the first sanctioned cross-isolate
// shared object in the concurrency model (M3). `Channel<T>::bounded(capacity:)` creates the queue and
// hands out a move-only `Sender<T>` / `Receiver<T>` pair; the sender moves into a spawned isolate's
// bundle while the receiver stays (or vice-versa):
//
//     import std::concurrent::{Channel, Sender, Receiver};
//     fn void producer(Sender<int32> tx) { int32 i = 0; while (i < 10) { tx.send(give i); i = i + 1; } }
//     fn int main() {
//         Channel<int32> ch = Channel.bounded(capacity: 4);
//         Sender<int32>   tx = ch.sender();
//         Receiver<int32> rx = ch.receiver();
//         spawn producer(tx: give tx);                // reuse the M2 bundle move
//         Optional<int32> v = rx.recv();              // blocks; None once drained AND the sender is dropped
//         ...
//     }
//
// All thread-safety lives in C (kama_channel.h): one mutex serializes send/recv/endpoint-drop, so no
// atomics are needed. The kama side is a thin `UnsafePtr`-handle library, exactly like the `Isolate` handle.
extern "<string.h>";
extern fn UnsafePtr memset(UnsafePtr p, int32 value, usize n);   // zero the moved-out source so its drop is a no-op

extern "kama_channel.h";
extern fn UnsafePtr   kama_channel_new(usize elemSize, usize cap);
extern fn int32 kama_channel_send(UnsafePtr ch, UnsafePtr elem);
extern fn int32 kama_channel_recv(UnsafePtr ch, UnsafePtr dst);
extern fn int32 kama_channel_try_pop(UnsafePtr ch, UnsafePtr dst);         // non-blocking pop, for teardown drain
extern fn void  kama_channel_add_sender(UnsafePtr ch);               // register one more endpoint on a side
extern fn void  kama_channel_add_receiver(UnsafePtr ch);
extern fn int32 kama_channel_close_sender(UnsafePtr ch);             // returns 1 if this endpoint is the last
extern fn int32 kama_channel_close_receiver(UnsafePtr ch);           // returns 1 if this endpoint is the last
extern fn void  kama_channel_free(UnsafePtr ch);                     // called by the last endpoint after draining

// The outcome of a `send`. `Sent` means the value was delivered (the queue now owns the sole copy).
// `Undelivered(item)` hands the value BACK to the caller intact — send failed because the receiver is
// gone, so nothing was enqueued. Modeled on Rust's `mpsc::SendError<T>`: an ownership language must
// return the value on failure rather than destroy it. (A no-payload `Sent` + a value-carrying
// `Undelivered` — the same shape as `Optional<T>`'s `None`/`Some`, but named so a match reads clearly.)
type enum SendResult<T> { Sent, Undelivered(T item) }

// The send endpoint. Move-only. Any number may share one channel (`Channel.sender()` registers each);
// dropping the LAST one closes the sender side and wakes every blocked receiver, so `recv` returns `None`
// once drained.
type resource Sender<T: Sendable> implements Sendable {
    UnsafePtr handle;   // the shared queue; null once moved-from (drop then no-ops, INVARIANT #0)

    // Wrap the shared queue handle. Called by `Channel.sender()`; not meant to be used directly.
    public unsafe ctor make(UnsafePtr handle) { this.handle = handle; }

    // Move `item` into the channel. Blocks while the ring is full and the receiver is live. On success
    // the bytes are relocated into a queue slot (the receiver's `recv` produces the sole owning copy)
    // and the moved-in `item` is zeroed so its method-end destructor is a no-op — a zero value is
    // drop-safe (INVARIANT #0) — leaving exactly one owning copy (in the queue): returns `Sent`.
    // If the receiver is gone the value is NOT enqueued; we must NOT zero it (that would silently
    // destroy the caller's resource) — instead we `give` it back in `Undelivered(item)` so the caller
    // owns it again and can re-route or drop it cleanly. The caller's `give` at the call site already
    // suppressed its drop, so exactly one owning copy survives either way.
    public unsafe fn SendResult<T> send(T item) {
        int32 r = kama_channel_send(ch: this.handle, elem: cast<UnsafePtr>(addr(of: item)));
        if (r == 0) {
            memset(p: cast<UnsafePtr>(addr(of: item)), value: 0, n: sizeof(T));
            return SendResult::Sent;
        }
        return SendResult::Undelivered(item: give item);
    }

    // The `out` boundary over the type-erased C call: `dst` IS an out-parameter, spelled `void*` across
    // the FFI. It writes only on success and reports that in the return, so the caller branches on that;
    // `addr(of: item)` here satisfies the fill obligation unconditionally, as it always did.
    unsafe fn int32 tryPopInto(out T item) {
        return kama_channel_try_pop(ch: this.handle, dst: cast<UnsafePtr>(addr(of: item)));
    }

    // Close the sender side. If this is the LAST live endpoint, the queue is now quiescent (the receiver
    // is already gone and no further send can enqueue), so we DRAIN any items still buffered — relocating
    // each into a local so its `~dtor` runs exactly once — before freeing the queue. This is the M8
    // no-leak fix: a channel abandoned with buffered resource items no longer leaks them.
    unsafe ~Sender() {
        if (this.handle != null) {
            if (kama_channel_close_sender(ch: this.handle) != 0) {
                bool more = true;
                while (more) {
                    slot T item;
                    if (this.tryPopInto(item: out item) == 0) { more = false; }   // ring empty: `item` is
                }                                     // zero, its drop a no-op. Otherwise it owns a buffered
                                                      // element and is dropped at the end of this iteration.
                kama_channel_free(ch: this.handle);
            }
        }
    }
}

// The receive endpoint. Move-only. Any number may share one channel — that is a worker pool, and each
// item goes to exactly one of them. Dropping the LAST one closes the receiver side and wakes every
// blocked sender.
type resource Receiver<T: Sendable> implements Sendable {
    UnsafePtr handle;   // the shared queue; null once moved-from

    public unsafe ctor make(UnsafePtr handle) { this.handle = handle; }

    // Block for the next value. Returns `Some(v)` (v is the sole owning copy, relocated out of the
    // queue) or `None` once the channel is closed AND drained (all senders dropped, no buffered items).
    public fn Optional<T> recv() {
        slot T dst;
        int32 r = this.recvInto(dst: out dst);
        if (r == 0) { return Optional::Some(value: give dst); }   // `give` suppresses dst's drop (moved into Some)
        return Optional::None;                            // dst was untouched (zero) → its drop is a no-op
    }

    // The `out` boundary over the type-erased C call — the blocking sibling of `tryPopInto`.
    unsafe fn int32 recvInto(out T dst) {
        return kama_channel_recv(ch: this.handle, dst: cast<UnsafePtr>(addr(of: dst)));
    }

    // The `out` boundary over the type-erased C call: `dst` IS an out-parameter, spelled `void*` across
    // the FFI. It writes only on success and reports that in the return, so the caller branches on that;
    // `addr(of: item)` here satisfies the fill obligation unconditionally, as it always did.
    unsafe fn int32 tryPopInto(out T item) {
        return kama_channel_try_pop(ch: this.handle, dst: cast<UnsafePtr>(addr(of: item)));
    }

    // Close the receiver side. Symmetric to ~Sender: if this is the last live endpoint, drain the
    // remaining buffered items (dropping each) before freeing the queue — the M8 no-leak fix.
    unsafe ~Receiver() {
        if (this.handle != null) {
            if (kama_channel_close_receiver(ch: this.handle) != 0) {
                bool more = true;
                while (more) {
                    slot T item;
                    if (this.tryPopInto(item: out item) == 0) { more = false; }   // ring empty: `item` is
                }                                     // zero, its drop a no-op. Otherwise it owns a buffered
                                                      // element and is dropped at the end of this iteration.
                kama_channel_free(ch: this.handle);
            }
        }
    }
}

// The channel factory. `bounded(capacity:)` creates the queue (capacity >= 1 is a ring buffer). The
// queue's lifetime is governed SOLELY by the endpoint COUNTS — the last Sender/Receiver to drop frees it
// — so a `Channel` is a thin factory: its own drop does NOT touch the queue (its handle is a non-owning
// copy), and it deliberately holds no share of its own. Extract the endpoints before discarding it.
//
// `sender()` / `receiver()` may each be called any number of times: every call registers another endpoint,
// which is what makes a fixed pool of worker isolates over one channel correct. The `Channel` itself is a
// move-only `resource`, so it can also be moved INTO an isolate whose worker then mints its own endpoint
// (tests/channel_mint_in_isolate) — which is why no separate `clone()` is needed on the endpoints.
// `T: Sendable` IS the sendability gate for a channel element — an undeclared element type fails this
// bound, with the reason (which field, which mutable pointee). The endpoints and the channel itself are
// Sendable: each is one thread-safe handle, which is the whole point of them.
type resource Channel<T: Sendable> implements Sendable {
    UnsafePtr handle;

    public unsafe ctor bounded(usize capacity) {
        this.handle = kama_channel_new(elemSize: sizeof(T), cap: capacity);
    }

    // Register before wrapping: the endpoint may be moved to another isolate and dropped there, and a
    // drop that outran its own registration would decrement a count it was never counted in.
    public unsafe fn Sender<T> sender() {
        kama_channel_add_sender(ch: this.handle);
        return Sender::<T>.make(handle: this.handle);
    }

    public unsafe fn Receiver<T> receiver() {
        kama_channel_add_receiver(ch: this.handle);
        return Receiver::<T>.make(handle: this.handle);
    }

    // No destructor, deliberately: the endpoints own the queue's lifetime (last-dropper-frees), so a
    // `Channel` has nothing to tear down. See the note on `Atomic` — an empty dtor is not a comment, it
    // sets `hasDtor` and makes the type `destructible`.
}
