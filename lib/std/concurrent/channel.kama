
import { std::time::Duration };
export { Channel, Sender, Receiver, SendResult, RecvResult };

// A typed, blocking channel for moving values BETWEEN isolates — the first sanctioned cross-isolate
// shared object in the concurrency model (M3). `Channel<T>::bounded(capacity:)` creates the queue and
// hands out a move-only `Sender<T>` / `Receiver<T>` pair; the sender moves into a spawned isolate's
// bundle while the receiver stays (or vice-versa):
//
//     import std::concurrent::{Channel, Sender, Receiver};
//     fn void producer(Sender<int32> tx) { int32 i = 0; while (i < 10) { tx.send(give i); i = i + 1; } }
//     fn int main() {
//         Channel<int32> ch = Channel.bounded(capacity: 4);
//         Sender<int32>   tx = ch.sender();
//         Receiver<int32> rx = ch.receiver();
//         spawn producer(tx: give tx);                // reuse the M2 bundle move
//         Optional<int32> v = rx.recv();              // blocks; None once drained AND the sender is dropped
//         ...
//     }
//
// All thread-safety lives in C (kama_channel.h): one mutex serializes send/recv/endpoint-drop, so no
// atomics are needed. The kama side is a thin `UnsafePtr`-handle library, exactly like the `Isolate` handle.
// Consume `value` without running its destructor. A send has relocated its bytes into the queue, and a receive that
// found nothing never filled it — either way the slot owns nothing, and dropping it would destroy a value that
// lives elsewhere, or one that was never made. This used to be a `memset` to zero on the claim that "a zero value is
// drop-safe", which is not the language's rule: `File`, `TcpStream`, `TcpListener` and `UdpSocket` spell empty as
// `fd = -1` so that descriptor 0 is ownable, and a zeroed one closed stdin once per send (found when
// a worker isolate's sockets died under it). An unfilled `slot T` is not zero — it holds T's field defaults — which
// is why only the send was wrong; `recv` forgets its unfilled slot anyway, so no path relies on it. Storing the
// value onto its own address with `give` is the language's own "move into a raw slot": the bytes stay, the drop goes.
unsafe fn void forget<T>(T value) {
    UnsafePtr<T> at = addr(of: value);
    at[0] = give value;
}

// The last holder of a queue — a `Sender`, a `Receiver` or the `Channel` — drops what is still buffered, each element
// once, and frees it. A channel abandoned with buffered resource items leaks none of them.
unsafe fn void release<T>(UnsafePtr handle) {
    bool more = true;
    while (more) {
        Optional<T> next = popBuffered::<T>(handle: handle);   // an element nobody will receive drops with `next`
        more = match (next) { case Some(value: buffered): true; case None: false; };
    }
    kama_channel_free(ch: handle);
}

// One buffered element, or `None` once the ring is empty. `dst` is given on BOTH paths — into `Some`, or forgotten
// when the queue left it unfilled — so no path drops a slot that holds nothing of its own.
unsafe fn Optional<T> popBuffered<T>(UnsafePtr handle) {
    slot T dst;
    if (popBufferedInto::<T>(handle: handle, item: out dst) != 0) { return Optional::Some(value: give dst); }
    forget(value: give dst);
    return Optional::None;
}

// The `out` boundary over the type-erased C call: `item` IS an out-parameter, spelled `void*` across the FFI. It is
// written only on success, reported in the return, so the caller branches on that; `addr(of: item)` here satisfies
// the fill obligation unconditionally.
unsafe fn int32 popBufferedInto<T>(UnsafePtr handle, out T item) {
    return kama_channel_try_pop(ch: handle, dst: cast<UnsafePtr>(addr(of: item)));
}

extern "kama_channel.h";
extern fn UnsafePtr   kama_channel_new(usize elemSize, usize cap);
extern fn int32 kama_channel_send(UnsafePtr ch, UnsafePtr elem);
extern fn int32 kama_channel_recv(UnsafePtr ch, UnsafePtr dst);
extern fn int32 kama_channel_try_recv(UnsafePtr ch, UnsafePtr dst);                 // 0 got, 1 empty, -1 closed
extern fn int32 kama_channel_recv_timeout(UnsafePtr ch, UnsafePtr dst, int64 nanos); // 0 got, 1 timed out, -1 closed
extern fn int32 kama_channel_try_pop(UnsafePtr ch, UnsafePtr dst);         // non-blocking pop, for teardown drain
extern fn int32 kama_channel_close_factory(UnsafePtr ch);                  // 1 = the factory was the last holder
extern fn void  kama_channel_add_sender(UnsafePtr ch);               // register one more endpoint on a side
extern fn void  kama_channel_add_receiver(UnsafePtr ch);
extern fn int32 kama_channel_close_sender(UnsafePtr ch);             // returns 1 if this endpoint is the last
extern fn int32 kama_channel_close_receiver(UnsafePtr ch);           // returns 1 if this endpoint is the last
extern fn void  kama_channel_free(UnsafePtr ch);                     // called by the queue's last holder after draining

// The outcome of a `send`. `Sent` means the value was delivered (the queue now owns the sole copy).
// `Undelivered(item)` hands the value BACK to the caller intact — send failed because the receiver is
// gone, so nothing was enqueued. Modeled on Rust's `mpsc::SendError<T>`: an ownership language must
// return the value on failure rather than destroy it. (A no-payload `Sent` + a value-carrying
// `Undelivered` — the same shape as `Optional<T>`'s `None`/`Some`, but named so a match reads clearly.)
type enum SendResult<T> { Sent, Undelivered(T item) }

// What a receive that does not block forever answers (`tryRecv`, `recvTimeout`): the value, `Empty` — none
// was there (`tryRecv`) or none arrived before the deadline (`recvTimeout`) while a sender is still live — or
// `Closed`, every sender gone and the queue drained, which is `recv`'s `None`. Three answers, because "not yet" and
// "never" want different code: a pool waiting for a returned connection retries on one and gives up on the other.
type enum RecvResult<T> { Received(T item), Empty, Closed }

// The send endpoint. Move-only. Any number may share one channel (`Channel.sender()` registers each);
// dropping the LAST one closes the sender side and wakes every blocked receiver, so `recv` returns `None`
// once drained.
type resource Sender<T: Sendable> implements Sendable {
    UnsafePtr handle;   // the shared queue; null once moved-from (drop then no-ops)

    // Wrap the shared queue handle. Called by `Channel.sender()`; not meant to be used directly.
    public unsafe ctor make(UnsafePtr handle) { this.handle = handle; }

    // Move `item` into the channel. Blocks while the ring is full and the receiver is live. On success
    // the bytes are relocated into a queue slot (the receiver's `recv` produces the sole owning copy)
    // and the moved-in `item` is forgotten, not dropped — leaving exactly one owning copy (in the
    // queue): returns `Sent`.
    // If the receiver is gone the value is NOT enqueued; we must NOT zero it (that would silently
    // destroy the caller's resource) — instead we `give` it back in `Undelivered(item)` so the caller
    // owns it again and can re-route or drop it cleanly. The caller's `give` at the call site already
    // suppressed its drop, so exactly one owning copy survives either way.
    public unsafe fn SendResult<T> send(T item) {
        int32 r = kama_channel_send(ch: this.handle, elem: cast<UnsafePtr>(addr(of: item)));
        if (r == 0) {
            forget(value: give item);
            return SendResult::Sent;
        }
        return SendResult::Undelivered(item: give item);
    }

    // Close the sender side. If this was the queue's LAST holder it is now quiescent (no receiver is left, no
    // further send can enqueue, and the factory that could mint either is gone), so `release` drains and frees it.
    unsafe ~Sender() {
        if (this.handle != null) {
            if (kama_channel_close_sender(ch: this.handle) != 0) {
                release::<T>(handle: this.handle);
            }
        }
    }
}

// The receive endpoint. Move-only. Any number may share one channel — that is a worker pool, and each
// item goes to exactly one of them. Dropping the LAST one closes the receiver side and wakes every
// blocked sender.
type resource Receiver<T: Sendable> implements Sendable {
    UnsafePtr handle;   // the shared queue; null once moved-from

    public unsafe ctor make(UnsafePtr handle) { this.handle = handle; }

    // Block for the next value. Returns `Some(v)` (v is the sole owning copy, relocated out of the
    // queue) or `None` once the channel is closed AND drained (all senders dropped, no buffered items).
    public fn Optional<T> recv() {
        slot T dst;
        int32 r = this.recvInto(dst: out dst);
        if (r == 0) { return Optional::Some(value: give dst); }   // `give` suppresses dst's drop (moved into Some)
        forget(value: give dst);                          // dst was never filled: it holds nothing to drop
        return Optional::None;
    }

    // The `out` boundary over the type-erased C call — the blocking sibling of `tryPopInto`.
    unsafe fn int32 recvInto(out T dst) {
        return kama_channel_recv(ch: this.handle, dst: cast<UnsafePtr>(addr(of: dst)));
    }

    // Take a value if one is buffered, without waiting. `Empty` when none is but a sender is live;
    // `Closed` when every sender is gone and the queue is drained.
    public fn RecvResult<T> tryRecv() {
        slot T dst;
        int32 r = this.tryRecvInto(dst: out dst);
        return this.answer(r: r, dst: give dst);
    }

    // Wait at most `timeout` for a value: the receive a pool's `acquire` needs, which must give up at a
    // deadline rather than block forever. `Empty` when the deadline passes first, `Closed` as for `tryRecv`. The
    // deadline is taken on the monotonic clock, so moving the wall clock neither stretches nor cuts it; a zero or
    // negative `timeout` is a `tryRecv`.
    public fn RecvResult<T> recvTimeout(Duration timeout) {
        slot T dst;
        int32 r = this.recvTimeoutInto(dst: out dst, nanos: timeout.asNanos());
        return this.answer(r: r, dst: give dst);
    }

    // The C calls' three answers as a `RecvResult`: `dst` is handed to `Received`, or forgotten when the call left it
    // unfilled — given on every path, so nothing drops a slot that holds nothing of its own.
    unsafe fn RecvResult<T> answer(int32 r, T dst) {
        if (r == 0) { return RecvResult::Received(item: give dst); }
        forget(value: give dst);
        if (r > 0) { return RecvResult::Empty; }
        return RecvResult::Closed;
    }

    unsafe fn int32 tryRecvInto(out T dst) {
        return kama_channel_try_recv(ch: this.handle, dst: cast<UnsafePtr>(addr(of: dst)));
    }
    unsafe fn int32 recvTimeoutInto(out T dst, int64 nanos) {
        return kama_channel_recv_timeout(ch: this.handle, dst: cast<UnsafePtr>(addr(of: dst)), nanos: nanos);
    }

    // Close the receiver side. Symmetric to ~Sender: the queue's last holder releases it.
    unsafe ~Receiver() {
        if (this.handle != null) {
            if (kama_channel_close_receiver(ch: this.handle) != 0) {
                release::<T>(handle: this.handle);
            }
        }
    }
}

// The channel factory. `bounded(capacity:)` creates the queue (capacity >= 1 is a ring buffer). The queue has three
// kinds of holder — the counted senders, the counted receivers, and this factory — and the last of them to drop
// frees it (`kama__channel_unheld`), so the factory and its endpoints may go in any order.
//
// `sender()` / `receiver()` may each be called any number of times: every call registers another endpoint,
// which is what makes a fixed pool of worker isolates over one channel correct. The `Channel` itself is a
// move-only `resource`, so it can also be moved INTO an isolate whose worker then mints its own endpoint
// (tests/channel_mint_in_isolate) — which is why no separate `clone()` is needed on the endpoints.
// `T: Sendable` IS the sendability gate for a channel element — an undeclared element type fails this
// bound, with the reason (which field, which mutable pointee). The endpoints and the channel itself are
// Sendable: each is one thread-safe handle, which is the whole point of them.
type resource Channel<T: Sendable> implements Sendable {
    UnsafePtr handle;

    public unsafe ctor bounded(usize capacity) {
        this.handle = kama_channel_new(elemSize: sizeof(T), cap: capacity);
    }

    // Register before wrapping: the endpoint may be moved to another isolate and dropped there, and a
    // drop that outran its own registration would decrement a count it was never counted in.
    public unsafe fn Sender<T> sender() {
        kama_channel_add_sender(ch: this.handle);
        return Sender::<T>.make(handle: this.handle);
    }

    public unsafe fn Receiver<T> receiver() {
        kama_channel_add_receiver(ch: this.handle);
        return Receiver::<T>.make(handle: this.handle);
    }

    // The factory is what keeps an unclaimed side open ("born open"): while it exists, `sender()` or `receiver()` may
    // still be called. Dropping it closes every side nobody claimed — a receiver waiting on a sender that can no
    // longer be minted sees `None` — and when no endpoint is left at all, the factory releases the queue. It used
    // to have no destructor, so a channel dropped before minting both sides leaked its queue in safe code, and such a
    // receiver blocked forever (tests/channel_factory_drop).
    unsafe ~Channel() {
        if (this.handle != null) {
            if (kama_channel_close_factory(ch: this.handle) != 0) {
                release::<T>(handle: this.handle);
            }
        }
    }
}
