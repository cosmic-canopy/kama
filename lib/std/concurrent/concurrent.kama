
export { Isolate, cpuCount };

// The concurrency module: the native isolate seam. The `isolate` statement is a compiler keyword, but
// importing this module is what makes the seam header (and its `-lpthread` link) available to a program:
//
//     import std::concurrent;
//     fn void worker(Payload p) { ... }              // entry: a top-level fn (no capture → shared-nothing)
//     scope { spawn worker(p: give payload); }       // the SCOPE owns the join — at its closing brace
//     Isolate h = spawn worker(p: give payload);     // handle form: an ISOLATE VALUE owns the join
//     h.join();                                       // explicit join; ~Isolate() also joins (RAII)
//
// Those are the only two forms. A bare `spawn` MUST appear inside a `scope { }` — this comment used to
// advertise a third, "fused: spawn on a new OS thread, then join", and the compiler rejects it. The
// difference between the two is who owns the join: a `scope` pins it to a brace, while an `Isolate` is a
// `resource`, so its join travels with the handle — which is what lets a long-lived service isolate keep
// its handle in a FIELD and be joined by that object's destructor rather than by a block.
//
// The bundle is MOVED into the isolate (`give`), so any post-spawn use of the source is a compile error —
// no memory is shared, which is what makes an isolate data-race-free by construction.
extern "kama_isolate.h";
@heap extern fn void kama_isolate_join_boxed(UnsafePtr h);
extern fn int32 kama_parfor_workers();

// How many isolates this machine can actually run at once — the same number `parallel_for` sizes its
// worker fan-out from, so a program that builds its own pool and one that hands work to `parallel_for`
// agree about the machine. `sysconf`/`pthread_num_processors_np`/`emscripten_num_logical_cores` per
// platform, and 1 on bare metal, where one core IS one isolate.
//
// `rawCpuCount` is `unsafe` because EVERY `extern fn` call is — that is the seam's rule, not a statement
// about this function — and it is left OUT of the export list above, so it is module-private. A core
// count names no raw memory, so the exported surface is SAFE: `unsafe` marks where the raw operation
// lives, it does not propagate to callers.
unsafe fn int32 rawCpuCount() { return kama_parfor_workers(); }
fn int32 cpuCount() { return rawCpuCount(); }

// An RAII handle to a running isolate. Produced by `Isolate h = isolate worker(...)`; owns the join.
// `join()` blocks for completion and is idempotent (it nulls the handle, so a second join — including the
// destructor's — is a no-op, avoiding a double `pthread_join`). Dropping the handle joins, so a forgotten
// join can never orphan the thread. This is the seed of the M4 structured-concurrency scope.
type resource Isolate implements Sendable {   // a join handle may itself be handed to another isolate
    UnsafePtr handle;   // heap-boxed kama_isolate_t; null once joined

    // Wrap a raw boxed handle from the isolate seam. The compiler lowers the `isolate …` expression form
    // to this ctor; it is not meant to be called directly (the handle must come from the spawn wrapper).
    unsafe ctor fromRaw(UnsafePtr handle) {
        this.handle = handle;
    }

    // Block until the isolate finishes. Safe to call more than once (and the destructor calls it).
    public unsafe fn void join() {
        if (this.handle != null) {
            kama_isolate_join_boxed(h: this.handle);
            this.handle = cast<UnsafePtr>(null);
        }
    }

    unsafe ~Isolate() {
        if (this.handle != null) { kama_isolate_join_boxed(h: this.handle); }
    }
}
