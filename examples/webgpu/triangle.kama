// triangle.kama — a WebGPU example written in Kama, compiled to WASM.
//
// Brings the whole pipeline up and draws a spinning triangle over a colour-cycling
// background: instance -> adapter -> device -> queue -> surface -> WGSL render
// pipeline -> per-frame render pass (uniform-fed rotation) -> draw.
//
//   ./kama build triangle.kama --target wasm --webgpu -o out/triangle.html
//   # open out/triangle.html in a WebGPU-capable browser (Chrome/Edge)
//
// It is pure Kama over the WebGPU C API (Emscripten's emdawnwebgpu port): opaque
// handles are `UnsafePtr`, C structs are `type extern value` (the header owns the real
// layout — Kama assigns fields by name), and the async adapter/device handshake
// rides Kama `fnptr` callbacks. App state lives on the heap (Kama has no mutable
// globals yet) and is threaded through the WebGPU `userdata` pointer.

import { std::app::run };

extern "<webgpu/webgpu.h>";
extern "<stdlib.h>";

// The platform seam (std::gpu): surface creation, present, and the per-tick pump — the only
// web-vs-native differences. Same source builds for `--target wasm` and native (see kama_gpu.h).
extern "kama_gpu.h";
extern fn UnsafePtr   kama_gpu_surface(UnsafePtr instance, uint32 width, uint32 height, UnsafePtr<int8> title);
extern fn void  kama_gpu_present(UnsafePtr surface);
extern fn int32 kama_gpu_pump(UnsafePtr device);
extern fn void  kama_gpu_sleep_ms(int32 ms);   // throttles a frame we do NOT present — see frameTick

// ----- libc -----
extern fn UnsafePtr calloc(usize count, usize size);

// ----- WebGPU C structs (only the fields we touch; the header owns the layout) -----
type extern value WGPUStringView { UnsafePtr<int8> data; usize length; }
type extern value WGPUChainedStruct { UnsafePtr next; int32 sType; }
type extern value WGPUSurfaceConfiguration {
    UnsafePtr nextInChain; UnsafePtr device; int32 format; uint64 usage;
    uint32 width; uint32 height; int32 alphaMode; int32 presentMode;
}
type extern value WGPUSurfaceTexture { UnsafePtr nextInChain; UnsafePtr texture; int32 status; }
type extern value WGPUColor { float64 r; float64 g; float64 b; float64 a; }
type extern value WGPURenderPassColorAttachment {
    UnsafePtr nextInChain; UnsafePtr view; uint32 depthSlice; UnsafePtr resolveTarget;
    int32 loadOp; int32 storeOp; WGPUColor clearValue;
}
type extern value WGPURenderPassDescriptor {
    UnsafePtr nextInChain; WGPUStringView label; usize colorAttachmentCount; UnsafePtr colorAttachments;
}

// --- M2: shader module + render pipeline ---
type extern value WGPUShaderSourceWGSL { WGPUChainedStruct chain; WGPUStringView code; }
type extern value WGPUShaderModuleDescriptor { UnsafePtr nextInChain; WGPUStringView label; }
type extern value WGPUColorTargetState { UnsafePtr nextInChain; int32 format; UnsafePtr blend; uint64 writeMask; }
type extern value WGPUVertexState {
    UnsafePtr nextInChain; UnsafePtr module; WGPUStringView entryPoint;
    usize constantCount; UnsafePtr constants; usize bufferCount; UnsafePtr buffers;
}
type extern value WGPUFragmentState {
    UnsafePtr nextInChain; UnsafePtr module; WGPUStringView entryPoint;
    usize constantCount; UnsafePtr constants; usize targetCount; UnsafePtr targets;
}
type extern value WGPUPrimitiveState {
    UnsafePtr nextInChain; int32 topology; int32 stripIndexFormat; int32 frontFace; int32 cullMode; uint32 unclippedDepth;
}
type extern value WGPUMultisampleState { UnsafePtr nextInChain; uint32 count; uint32 mask; uint32 alphaToCoverageEnabled; }
type extern value WGPURenderPipelineDescriptor {
    UnsafePtr nextInChain; WGPUStringView label; UnsafePtr layout;
    WGPUVertexState vertex; WGPUPrimitiveState primitive; UnsafePtr depthStencil;
    WGPUMultisampleState multisample; UnsafePtr fragment;
}

// --- uniform buffer + bind group (feeds the rotation angle to the shader) ---
type extern value WGPUBufferDescriptor { UnsafePtr nextInChain; WGPUStringView label; uint64 usage; uint64 size; uint32 mappedAtCreation; }
type extern value WGPUBindGroupEntry {
    UnsafePtr nextInChain; uint32 binding; UnsafePtr buffer; uint64 offset; uint64 size; UnsafePtr sampler; UnsafePtr textureView;
}
type extern value WGPUBindGroupDescriptor { UnsafePtr nextInChain; WGPUStringView label; UnsafePtr layout; usize entryCount; UnsafePtr entries; }

// The async callback shapes (message is a WGPUStringView passed by value).
fnptr void AdapterCb(int32 status, UnsafePtr adapter, WGPUStringView message, UnsafePtr userdata1, UnsafePtr userdata2);
fnptr void DeviceCb(int32 status, UnsafePtr device, WGPUStringView message, UnsafePtr userdata1, UnsafePtr userdata2);

type extern value WGPURequestAdapterCallbackInfo { UnsafePtr nextInChain; int32 mode; AdapterCb callback; UnsafePtr userdata1; UnsafePtr userdata2; }
type extern value WGPURequestDeviceCallbackInfo  { UnsafePtr nextInChain; int32 mode; DeviceCb  callback; UnsafePtr userdata1; UnsafePtr userdata2; }

// ----- WebGPU functions -----
extern fn UnsafePtr  wgpuCreateInstance(UnsafePtr descriptor);
extern fn void wgpuInstanceRequestAdapter(UnsafePtr instance, UnsafePtr options, WGPURequestAdapterCallbackInfo callbackInfo);
extern fn void wgpuAdapterRequestDevice(UnsafePtr adapter, UnsafePtr descriptor, WGPURequestDeviceCallbackInfo callbackInfo);
extern fn UnsafePtr  wgpuDeviceGetQueue(UnsafePtr device);
extern fn void wgpuSurfaceConfigure(UnsafePtr surface, UnsafePtr config);
extern fn void wgpuSurfaceGetCurrentTexture(UnsafePtr surface, UnsafePtr surfaceTexture);
extern fn UnsafePtr  wgpuTextureCreateView(UnsafePtr texture, UnsafePtr descriptor);
extern fn UnsafePtr  wgpuDeviceCreateCommandEncoder(UnsafePtr device, UnsafePtr descriptor);
extern fn UnsafePtr  wgpuCommandEncoderBeginRenderPass(UnsafePtr encoder, UnsafePtr descriptor);
extern fn void wgpuRenderPassEncoderEnd(UnsafePtr renderPassEncoder);
extern fn UnsafePtr  wgpuCommandEncoderFinish(UnsafePtr encoder, UnsafePtr descriptor);
extern fn void wgpuQueueSubmit(UnsafePtr queue, usize commandCount, UnsafePtr commands);
extern fn void wgpuRenderPassEncoderRelease(UnsafePtr renderPassEncoder);
extern fn void wgpuCommandBufferRelease(UnsafePtr commandBuffer);
extern fn void wgpuCommandEncoderRelease(UnsafePtr encoder);
extern fn void wgpuTextureViewRelease(UnsafePtr textureView);
extern fn void wgpuTextureRelease(UnsafePtr texture);
extern fn UnsafePtr  wgpuDeviceCreateShaderModule(UnsafePtr device, UnsafePtr descriptor);
extern fn UnsafePtr  wgpuDeviceCreateRenderPipeline(UnsafePtr device, UnsafePtr descriptor);
extern fn void wgpuRenderPassEncoderSetPipeline(UnsafePtr renderPassEncoder, UnsafePtr pipeline);
extern fn void wgpuRenderPassEncoderDraw(UnsafePtr renderPassEncoder, uint32 vertexCount, uint32 instanceCount, uint32 firstVertex, uint32 firstInstance);
extern fn UnsafePtr  wgpuDeviceCreateBuffer(UnsafePtr device, UnsafePtr descriptor);
extern fn void wgpuQueueWriteBuffer(UnsafePtr queue, UnsafePtr buffer, uint64 bufferOffset, UnsafePtr data, usize size);
extern fn UnsafePtr  wgpuRenderPipelineGetBindGroupLayout(UnsafePtr pipeline, uint32 groupIndex);
extern fn UnsafePtr  wgpuDeviceCreateBindGroup(UnsafePtr device, UnsafePtr descriptor);
extern fn void wgpuRenderPassEncoderSetBindGroup(UnsafePtr renderPassEncoder, uint32 groupIndex, UnsafePtr group, usize dynamicOffsetCount, UnsafePtr dynamicOffsets);

// ----- app state (heap; threaded through WebGPU userdata) -----
type value App {
    public UnsafePtr instance; public UnsafePtr surface;    public UnsafePtr adapter;
    public UnsafePtr device;   public UnsafePtr queue;      public UnsafePtr pipeline;
    public UnsafePtr uniformBuf; public UnsafePtr bindGroup;
    public int32 ready;  public int32 frame;
    // Frame-loop health (see frameTick). `needsConfigure` makes reconfiguring a response to an
    // invalidation rather than something the loop does speculatively; `failStreak` is the backstop
    // for a status that will never clear on its own; `occluded` keeps the "window hidden" log to one
    // line per episode instead of one per frame.
    public int32 needsConfigure;  public int32 failStreak;  public int32 occluded;
}

// The whole triangle: two entry points in one WGSL module, positions baked in
// (no vertex buffer). A uniform `uAngle` spins it in the vertex shader.
//
// Written as a MULTI-LINE STRING, which is what shader source wants. This used to be one enormous
// logical line, with a comment saying kama had no multi-line literal — it does, and a reader who
// believed that comment would go and build an asset-embedding step to work around it. `stripIndent`
// (std::fmt) dedents a tagged literal if you want the source indented to match its surroundings.
fn string triangleWgsl() {
    return "@group(0) @binding(0) var<uniform> uAngle: f32;
@vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4f {
    var p = array<vec2f,3>(vec2f(0.0,0.5), vec2f(-0.5,-0.5), vec2f(0.5,-0.5));
    let c = cos(uAngle);
    let s = sin(uAngle);
    let v = p[i];
    return vec4f(v.x*c - v.y*s, v.x*s + v.y*c, 0.0, 1.0);
}
@fragment fn fs() -> @location(0) vec4f {
    return vec4f(1.0, 0.4, 0.1, 1.0);
}";
}

// Build the render pipeline for the triangle (device is ready; format is the surface's).
unsafe fn UnsafePtr makePipeline(UnsafePtr device, int32 format) {
    string wgsl = triangleWgsl();
    WGPUShaderSourceWGSL src = WGPUShaderSourceWGSL();
    src.chain.sType = 2;                 // WGPUSType_ShaderSourceWGSL
    src.code.data = wgsl.cstr();
    src.code.length = cast<usize>(wgsl.length());
    WGPUShaderModuleDescriptor smDesc = WGPUShaderModuleDescriptor();
    smDesc.nextInChain = cast<UnsafePtr>(addr(of: src));
    UnsafePtr shader = wgpuDeviceCreateShaderModule(device: device, descriptor: addr(of: smDesc));

    WGPUColorTargetState colorTarget = WGPUColorTargetState();
    colorTarget.format = format;
    colorTarget.writeMask = 15;          // WGPUColorWriteMask_All (0xF)

    string fsEntry = "fs";
    WGPUFragmentState frag = WGPUFragmentState();
    frag.module = shader;
    frag.entryPoint.data = fsEntry.cstr();
    frag.entryPoint.length = cast<usize>(fsEntry.length());
    frag.targetCount = 1;
    frag.targets = cast<UnsafePtr>(addr(of: colorTarget));

    string vsEntry = "vs";
    WGPURenderPipelineDescriptor pd = WGPURenderPipelineDescriptor();
    pd.vertex.module = shader;
    pd.vertex.entryPoint.data = vsEntry.cstr();
    pd.vertex.entryPoint.length = cast<usize>(vsEntry.length());
    pd.primitive.topology = 4;           // WGPUPrimitiveTopology_TriangleList
    pd.multisample.count = 1;
    pd.multisample.mask = 4294967295ui32;    // 0xFFFFFFFF
    pd.fragment = cast<UnsafePtr>(addr(of: frag));
    return wgpuDeviceCreateRenderPipeline(device: device, descriptor: addr(of: pd));
}

// (Re)configure the surface for the device. Called once when the device is ready, and thereafter
// only when a frame has been INVALIDATED — `Outdated` or `Lost` from wgpuSurfaceGetCurrentTexture,
// which is what a native swapchain reports after a resize or a device loss. ⚠️ Note what is NOT on
// that list: any other reason for a missing texture. Reconfiguring on all of them is an unbounded
// allocation loop (see frameTick), because each call allocates a fresh set of full-screen textures.
unsafe fn void configureSurface(UnsafePtr device, UnsafePtr surface) {
    WGPUSurfaceConfiguration cfg = WGPUSurfaceConfiguration();
    cfg.device = device;
    cfg.format = 27;          // WGPUTextureFormat_BGRA8Unorm
    cfg.usage = 16;           // WGPUTextureUsage_RenderAttachment
    cfg.width = 512;
    cfg.height = 512;
    cfg.alphaMode = 0;        // WGPUCompositeAlphaMode_Auto
    cfg.presentMode = 1;      // WGPUPresentMode_Fifo
    wgpuSurfaceConfigure(surface: surface, config: addr(of: cfg));
}

// Device is ready: grab the queue, configure the surface for the canvas, go live.
unsafe fn void onDevice(int32 status, UnsafePtr device, WGPUStringView message, UnsafePtr u1, UnsafePtr u2) {
    UnsafePtr<App> st = cast<UnsafePtr<App>>(u1);
    st[0].device = device;
    st[0].queue = wgpuDeviceGetQueue(device: device);

    configureSurface(device: device, surface: st[0].surface);

    st[0].pipeline = makePipeline(device: device, format: 27);   // BGRA8Unorm

    // Uniform buffer (holds the rotation angle) + a bind group over the pipeline's auto layout.
    WGPUBufferDescriptor bd = WGPUBufferDescriptor();
    bd.usage = 72;                    // WGPUBufferUsage_Uniform (0x40) | CopyDst (0x08)
    bd.size = 16;
    UnsafePtr ubuf = wgpuDeviceCreateBuffer(device: device, descriptor: addr(of: bd));
    st[0].uniformBuf = ubuf;

    UnsafePtr bgl = wgpuRenderPipelineGetBindGroupLayout(pipeline: st[0].pipeline, groupIndex: 0);
    WGPUBindGroupEntry entry = WGPUBindGroupEntry();
    entry.binding = 0;
    entry.buffer = ubuf;
    entry.offset = 0;
    entry.size = 16;
    WGPUBindGroupDescriptor bgd = WGPUBindGroupDescriptor();
    bgd.layout = bgl;
    bgd.entryCount = 1;
    bgd.entries = cast<UnsafePtr>(addr(of: entry));
    st[0].bindGroup = wgpuDeviceCreateBindGroup(device: device, descriptor: addr(of: bgd));

    st[0].ready = 1;
}

// Adapter is ready: request a device.
unsafe fn void onAdapter(int32 status, UnsafePtr adapter, WGPUStringView message, UnsafePtr u1, UnsafePtr u2) {
    UnsafePtr<App> st = cast<UnsafePtr<App>>(u1);
    st[0].adapter = adapter;

    WGPURequestDeviceCallbackInfo ci = WGPURequestDeviceCallbackInfo();
    ci.mode = 3;              // WGPUCallbackMode_AllowSpontaneous
    ci.callback = onDevice;
    ci.userdata1 = u1;
    wgpuAdapterRequestDevice(adapter: adapter, descriptor: null, callbackInfo: ci);
}

// One frame: acquire the swapchain texture, clear it to an animated colour, submit.
//
// ⚠️ EVERY PATH THAT RETURNS WITHOUT PRESENTING MUST SLEEP. The loop's only throttle is vsync, and
// vsync applies only to a frame that is actually presented — so a path that bails out early runs at
// unbounded rate. This example used to bail out by reconfiguring the swapchain, which allocates a
// fresh set of full-screen textures each time; the first project that copied it reached 15.6 GB
// resident and panicked the machine through the kernel watchdog (watchdogd starved of CPU, not a GPU
// fault), twice. Hence the two rules encoded below: sleep on every early return, and reconfigure
// only when something actually invalidated the surface.
unsafe fn int32 frameTick(UnsafePtr state) {
    int32 keep = 1;   // 1 = keep looping; native pump flips it to 0 on window close
    UnsafePtr<App> st = cast<UnsafePtr<App>>(state);
    if (st[0].ready == 0) {
        // Still waiting on the async adapter -> device handshake. Pump so the window stays
        // responsive, then sleep — without this the handshake spins a core for its whole duration.
        keep = kama_gpu_pump(device: null);
        kama_gpu_sleep_ms(ms: 8);
        return keep;
    }

    UnsafePtr surface = st[0].surface;
    int32 frame = st[0].frame;
    st[0].frame = frame + 1;

    // Reconfigure at most once per invalidation, never speculatively per frame.
    if (st[0].needsConfigure != 0) {
        configureSurface(device: st[0].device, surface: surface);
        st[0].needsConfigure = 0;
    }

    // Spin the triangle: push the current angle into the uniform buffer.
    float32 angle = cast<float32>(frame) * 0.03;
    wgpuQueueWriteBuffer(queue: st[0].queue, buffer: st[0].uniformBuf, bufferOffset: 0,
                         data: cast<UnsafePtr>(addr(of: angle)), size: 4);

    WGPUSurfaceTexture surfTex = WGPUSurfaceTexture();
    wgpuSurfaceGetCurrentTexture(surface: surface, surfaceTexture: addr(of: surfTex));
    UnsafePtr tex = surfTex.texture;
    if (tex == null) {
        int32 status = surfTex.status;

        // OCCLUDED IS NOT AN ERROR, and getting this wrong is what took a machine down.
        //
        // 0x00030001 (196609) is `WGPUSurfaceGetCurrentTextureStatus_Occluded` — a wgpu-native
        // EXTENSION declared in webgpu/wgpu.h, not one of the six values in the standard webgpu.h
        // enum, which is why code that only reads webgpu.h never thinks to handle it. It means the
        // window simply is not visible: covered by another window, minimized, or on another Space.
        // Nothing is wrong and there is nothing to draw. Treating it as "the swapchain is stale" and
        // reconfiguring gives an unbounded allocation loop for as long as the window stays covered —
        // and putting a terminal in front of the window is enough to trigger it.
        if (status == 196609) {
            if (st[0].occluded == 0) { println(s: "triangle: window occluded — skipping frames"); }
            st[0].occluded = st[0].occluded + 1;
            keep = kama_gpu_pump(device: st[0].device);
            kama_gpu_sleep_ms(ms: 32);   // an invisible window has no deadline
            return keep;
        }

        // Outdated(4) and Lost(5) genuinely need the swapchain rebuilt — flag it, and the rebuild
        // happens once at the top of the next tick. Timeout(3) is transient and Error(6) is
        // deterministic; rebuilding on either would be the same runaway under a different name, so
        // both just skip the frame and the streak backstop below catches a status that never clears.
        if (status == 4 || status == 5) { st[0].needsConfigure = 1; }

        st[0].failStreak = st[0].failStreak + 1;
        if (st[0].failStreak > 600) {
            println(s: "triangle: no surface texture for 600 consecutive frames (status ${status}) — stopping");
            return 0;
        }
        keep = kama_gpu_pump(device: st[0].device);
        kama_gpu_sleep_ms(ms: 8);
        return keep;
    }
    st[0].failStreak = 0;
    if (st[0].occluded != 0) {
        int32 n = st[0].occluded;
        println(s: "triangle: window visible again after ${n} occluded frames");
        st[0].occluded = 0;
    }

    UnsafePtr view = wgpuTextureCreateView(texture: tex, descriptor: null);
    UnsafePtr enc = wgpuDeviceCreateCommandEncoder(device: st[0].device, descriptor: null);

    WGPURenderPassColorAttachment att = WGPURenderPassColorAttachment();
    att.view = view;
    att.depthSlice = 4294967295ui32;   // WGPU_DEPTH_SLICE_UNDEFINED
    att.loadOp = 2;                // WGPULoadOp_Clear
    att.storeOp = 1;               // WGPUStoreOp_Store
    // Full-range RGB sweep with phase offsets — an obvious colour cycle (~3.3s).
    att.clearValue.r = cast<float64>(frame % 200) / 200.0;
    att.clearValue.g = cast<float64>((frame + 66) % 200) / 200.0;
    att.clearValue.b = cast<float64>((frame + 133) % 200) / 200.0;
    att.clearValue.a = 1.0;

    WGPURenderPassDescriptor rp = WGPURenderPassDescriptor();
    rp.colorAttachmentCount = 1;
    rp.colorAttachments = cast<UnsafePtr>(addr(of: att));

    UnsafePtr pass = wgpuCommandEncoderBeginRenderPass(encoder: enc, descriptor: addr(of: rp));
    wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: st[0].pipeline);
    wgpuRenderPassEncoderSetBindGroup(renderPassEncoder: pass, groupIndex: 0, group: st[0].bindGroup, dynamicOffsetCount: 0, dynamicOffsets: null);
    wgpuRenderPassEncoderDraw(renderPassEncoder: pass, vertexCount: 3, instanceCount: 1, firstVertex: 0, firstInstance: 0);
    wgpuRenderPassEncoderEnd(renderPassEncoder: pass);
    UnsafePtr cmd = wgpuCommandEncoderFinish(encoder: enc, descriptor: null);
    wgpuQueueSubmit(queue: st[0].queue, commandCount: 1, commands: cast<UnsafePtr>(addr(of: cmd)));
    // Present through the seam: a real wgpuSurfacePresent natively, a no-op on the web (the
    // browser auto-presents the canvas each requestAnimationFrame tick — emdawnwebgpu aborts on
    // an explicit present).
    kama_gpu_present(surface: surface);

    // Release this frame's transient objects. GetCurrentTexture hands back a ref we own,
    // so release `tex` too (matches Emscripten's reference; the surface keeps its own ref) —
    // else it leaks a swapchain texture every frame.
    wgpuRenderPassEncoderRelease(renderPassEncoder: pass);
    wgpuCommandBufferRelease(commandBuffer: cmd);
    wgpuCommandEncoderRelease(encoder: enc);
    wgpuTextureViewRelease(textureView: view);
    wgpuTextureRelease(texture: tex);

    // Pump the platform: native drains window events + polls the device and returns 0 when the
    // window is closed (ending std::app's `while(tick())`); the web is a no-op that returns 1.
    keep = kama_gpu_pump(device: st[0].device);
    return keep;
}

unsafe fn int32 appMain() {
    UnsafePtr inst = wgpuCreateInstance(descriptor: null);

    // Heap app-state (zeroed) so it outlives main() once the browser drives the loop.
    UnsafePtr<App> st = cast<UnsafePtr<App>>(calloc(count: 1, size: sizeof(App)));
    st[0].instance = inst;

    // Surface via the seam: the page's <canvas id="canvas"> on the web, a real 512×512 window
    // natively. Same call, one window/canvas per app — exactly what the triangle needs.
    string title = "kama — triangle";
    UnsafePtr surface = kama_gpu_surface(instance: inst, width: 512, height: 512, title: title.cstr());
    st[0].surface = surface;

    // Kick off the async adapter request; onAdapter -> onDevice -> ready.
    WGPURequestAdapterCallbackInfo ci = WGPURequestAdapterCallbackInfo();
    ci.mode = 3;                              // WGPUCallbackMode_AllowSpontaneous
    ci.callback = onAdapter;
    ci.userdata1 = cast<UnsafePtr>(st);
    wgpuInstanceRequestAdapter(instance: inst, options: null, callbackInfo: ci);

    run(tick: frameTick, state: cast<UnsafePtr>(st));   // browser-driven render loop
    return 0;
}

// The body above is the raw work, so IT carries the marker; `main` may not be `unsafe`
// (it encloses the whole program). Calling an `unsafe fn` from safe code is allowed.
fn int32 main() { return appMain(); }
