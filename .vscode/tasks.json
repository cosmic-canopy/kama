{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "kama: build (debug)",
      "type": "shell",
      "command": "${workspaceFolder}/kama",
      "args": [
        "build",
        "${file}",
        "-o", "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "kama: build (release)",
      "type": "shell",
      "command": "${workspaceFolder}/kama",
      "args": [
        "build",
        "${file}",
        "--release",
        "-o", "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
