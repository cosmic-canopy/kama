fn int main()
{
    Optional<Optional<int32>> nn = Optional::Some(value: Optional::Some(value: 5));
    Optional<Optional<int32>> no = Optional::Some(value: Optional::None);
    int32 a = match (nn) { case Some(i): match (i) { case Some(x): x; case None: -1; }; case None: -2; };
    int32 b = match (no) { case Some(i): match (i) { case Some(x): x; case None: 99; }; case None: -2; };
    return a + b;
}
