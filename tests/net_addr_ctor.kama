// Construction-model M7.1: the net VALUE types construct dot-on-type — `RecvFrom.of` is `@generate(of)`,
// `SocketAddr.of` is hand-written (it leaves `scopeId` 0), and `SocketAddr.fromHostIp` is a `ctor`. No
// sockets — pure value construction (the nameless `SocketAddr(...)` primary was removed at M8d.2).
import { std::net::SocketAddr, std::net::RecvFrom, std::net::IpAddr };
fn int32 main() {
    // 127.0.0.1:8080 built from the host-order packed IPv4 via the `fromHostIp` ctor (dot-on-type).
    SocketAddr a = SocketAddr.fromHostIp(ip: 2130706433ui32, port: 8080ui16);   // 127.0.0.1
    SocketAddr b = SocketAddr.of(ip: IpAddr::V4(a: cast<uint8>(10), b: cast<uint8>(0),
                                                c: cast<uint8>(0), d: cast<uint8>(1)), port: 53ui16);
    RecvFrom rf = RecvFrom.of(count: cast<usize>(12), from: b);
    int32 pa = cast<int32>(a.port);          // 8080
    int32 pb = cast<int32>(b.port);          // 53
    int32 cnt = cast<int32>(rf.count);       // 12
    // The payload LABELS are the variant's field names (`a:`…`d:`); the BINDINGS may not reuse a live
    // name, and `a`/`b` are the two `SocketAddr` locals above — the subject here is the outer `a`.
    int32 octet = match (a.ip) { case V4(a: o1, b: o2, c: o3, d: o4): cast<int32>(o4); case V6(octets: o): -1; };   // 1 (127.0.0.1 -> d=1)
    return pa - pb - cnt - octet - 8014;     // 8080 - 53 - 12 - 1 - 8014 = 0
}
