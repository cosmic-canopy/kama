{
  "name": "assetselect",
  "version": "0.1.0",
  "kind": "executable",
  "entry": "src/main.kama",
  "assets": "data",
  "select": {
    "BUILD": {
      "COMMON":  { "assets": "common" },
      "HARNESS": { "inherits": "COMMON", "assets": "goldens", "default": true },
      "SHIP":    { "inherits": "COMMON", "assets": "shipped" }
    }
  },
  "modules": { ".": { "visibility": "internal" } }
}
