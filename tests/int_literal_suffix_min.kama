// The MINIMUM of every signed width has a suffixed spelling, and it is the obvious one.
//
// It did not, and the failure was not a wrong value — it was invalid C. `128i8` is one past INT8_MAX, so
// `createIntegerLiteralNode` narrowed it with a C cast to -128 and said nothing; the unary minus then
// negated a node that was ALREADY negative, and the emitter wrote `(--128)`, which C reads as a
// pre-decrement of a literal and rejects with "expression is not assignable". `kama check` passed the
// file. So INT8_MIN/INT16_MIN/INT32_MIN/INT64_MIN had no suffixed spelling at all, and only clang said so.
//
// The fix is the rule tests/int_literal_min.kama already pins for the UNSUFFIXED int32 literal, applied
// at every width: a magnitude exactly one past the maximum parks itself, the MINUS claims it, and the
// node already holds the wrapped value — which is the right answer. Unclaimed, it is an error
// (tests/xfail/int_literal_suffix_boundary_unclaimed).
//
// INT64_MIN carries a second half: `-9223372036854775808LL` is not a C literal either, because the
// magnitude is one past LLONG_MAX and no signed type holds it. The emitter writes what <stdint.h> writes.
fn int32 main() {
    int8  a = -128i8;
    int16 b = -32768i16;
    int32 c = -2147483648i32;
    int64 d = -9223372036854775808i64;

    int32 n = 0;
    if (cast<int32>(a) == -128)                     { n = n + 1; }
    if (cast<int32>(b) == -32768)                   { n = n + 1; }
    if (c == -2147483648)                           { n = n + 1; }
    if (d == -9223372036854775808i64)               { n = n + 1; }

    // Each really is the smallest of its width — a value one INSIDE the range is strictly greater.
    if (a < -127i8)                                 { n = n + 1; }
    if (b < -32767i16)                              { n = n + 1; }
    if (c < -2147483647i32)                         { n = n + 1; }
    if (d < -9223372036854775807i64)                { n = n + 1; }

    // ...and the maxima still parse, which is the boundary on the other side of the same comparison.
    if (127i8 == 127i8 && 32767i16 == 32767i16)     { n = n + 1; }
    if (2147483647i32 == 2147483647i32)             { n = n + 1; }

    return n;   // 10
}
