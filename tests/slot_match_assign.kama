// Definite assignment sees through a `match`. A match is exhaustive by construction, so exactly one arm
// runs: a destination filled by every arm that REACHES the join is filled after it.
//
// The join rule lives on the `out` PARAMETER, which is where it always mattered — a callee's promise to
// assign on every path. A `slot` LOCAL is stricter and does not need the join at all: its fill must sit on
// its own unconditional path, so the caller's side is always one straight-line `out` argument.
// `tests/xfail/slot_match_*.kama` pin the other direction.

type enum Code { Ok, Bad }
fn Code classify(int32 x) { if (x > 0) { return Code::Ok; } return Code::Bad; }

fn void fill(int32 v, out int32 dst) { dst = v; }

// (0) THE case: an `out` parameter is the callee's promise to assign on every path. A match is exhaustive,
//     so filling it in every arm IS every path — but the arms were discarded, so this was rejected with
//     "`out` parameter 'dst' is not assigned on every path before this function returns".
fn void pickInto(int32 x, out int32 dst) {
    match (classify(x: x)) {
        case Ok:  { fill(v: 1, dst: out dst); }
        case Bad: { dst = 90; }
    };
}

// (1) every arm assigns
fn void everyArm(int32 x, out int32 dst) {
    match (classify(x: x)) {
        case Ok:  { dst = 1; }
        case Bad: { dst = 90; }
    };
}

// (2) a wildcard arm counts like any other
fn void wildcardArm(int32 x, out int32 dst) {
    match (classify(x: x)) {
        case Ok: { dst = 90; }
        case _:  { dst = 2; }
    };
}

// (3) an arm that DIVERGES never reaches the join, so it constrains nothing — the remaining arm alone
//     decides. `break` leaves the loop without returning, so the out parameter's obligation is untouched
//     and the join sees only `Ok`'s assignment. (A diverging arm that RETURNS is a different matter: every
//     return must have assigned the parameter, which `tests/xfail/slot_match_diverging_only` pins.)
fn void divergingArm(int32 x, out int32 dst) {
    while (true) {
        match (classify(x: x)) {
            case Ok:  { dst = 4; }
            case Bad: { break; }             // diverges: never reaches the join
        };
        return;
    }
    dst = 91;                                // only reached when the `Bad` arm broke out
}

// (5) nested: the inner match is itself a join, so the outer one sees `dst` as assigned
fn void nestedMatch(int32 x, out int32 dst) {
    match (classify(x: x)) {
        case Ok: {
            match (classify(x: 2)) {
                case Ok:  { dst = 16; }
                case Bad: { dst = 90; }
            };
        }
        case Bad: { dst = 90; }
    };
}

fn int32 main()
{
    int32 total = 0;

    // (0) the `out` case, from the caller's side: `r` is a hole until `pickInto` fills it.
    slot int32 r;   pickInto(x: 1, dst: out r);
    total = total + r;                       // 1

    slot int32 a;   everyArm(x: 1, dst: out a);
    total = total + a;                       // 1

    slot int32 b;   wildcardArm(x: -1, dst: out b);
    total = total + b;                       // 2

    slot int32 c;   divergingArm(x: 1, dst: out c);
    total = total + c;                       // 4

    // (4) a slot's own rule is measured RELATIVE to its declaration — a slot declared AND filled inside
    //     the same match arm is on its own unconditional path, so it is fine. What is rejected is a slot
    //     declared OUTSIDE and filled inside, where a path could reach the read without the fill.
    int32 d = 0;
    match (classify(x: 1)) {
        case Ok:  { slot int32 dd; fill(v: 8, dst: out dd); d = dd; }
        case Bad: { d = 90; }
    };
    total = total + d;                       // 8

    slot int32 e;   nestedMatch(x: 1, dst: out e);
    total = total + e;                       // 16

    // (6) the same relative rule one level out: a slot declared and filled inside a lone `if` body.
    int32 g = 0;
    if (total > 0) {
        slot int32 f;   everyArm(x: 1, dst: out f);
        g = f * 32;
    }
    total = total + g;                       // 32

    return total;                            // 1 + 1 + 2 + 4 + 8 + 16 + 32 = 64
}
