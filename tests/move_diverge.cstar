// M26f-2 — branch divergence: a move inside a branch that then `return`s doesn't reach the
// join, so a later move of the same local on the fall-through path is legal (not a
// use-after-move / conditional-drop). One drop of code 2 -> 2.
extern fn void cstar_trace(int code);
extern fn int cstar_trace_get();

type resource Res {
    List<int32> items;
    public Res(int32 v) { this.items.add(item: v); }
    ~Res() { cstar_trace(code: 2); }
    public fn int32 head() { return this.items[0]; }
}

fn int32 sink(Res r) { return r.head(); }

fn int32 run(int32 c) {
    Res a = Res(v: 5);
    if (c > 0) { return sink(r: give a); }   // moves a, then returns (diverges) — join not reached
    sink(r: give a);                         // reached only when c<=0; `a` is still live here
    return 0;
}

fn int32 main() {
    int32 x = run(c: 0);
    return cstar_trace_get();                // exactly one drop -> 2
}
