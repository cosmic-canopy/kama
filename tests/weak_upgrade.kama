extern "<stdlib.h>";
extern fn UnsafePtr malloc(usize n);
extern fn void free(UnsafePtr p);

type value Ctrl { public int32 strong; public int32 weak; }
type value Counter { public int32 n; public ctor make(int32 start) { this.n = start; } }

type resource RcWeak<T> {
    UnsafePtr<T> p;
    UnsafePtr<Ctrl> c;
    public unsafe ctor make(UnsafePtr<T> p, UnsafePtr<Ctrl> c) { this.p = p; this.c = c; }   // shares an existing ctrl
    public unsafe fn Optional<Rc<T>> tryUpgrade() {
        if (this.c[0].strong > 0) {
            this.c[0].strong = this.c[0].strong + 1;
            return Optional::Some(value: Rc.make(p: this.p, c: this.c));   // fresh ctor -> no marker
        }
        return Optional::None;
    }
    unsafe ~RcWeak() {
        this.c[0].weak = this.c[0].weak - 1;
        if (this.c[0].strong == 0 && this.c[0].weak == 0) { free(p: cast<UnsafePtr>(this.c)); }
    }
}

type resource Rc<T> implements Deref<T>, DerefMut<T>, HeapOwner<T>, Copyable<This>(bare: copy) {
    UnsafePtr<T> p;
    UnsafePtr<Ctrl> c;
    public unsafe ctor make(UnsafePtr<T> p, UnsafePtr<Ctrl> c) { this.p = p; this.c = c; }       // shares an existing ctrl
    public unsafe ctor adopt(UnsafePtr<T> raw) {
        UnsafePtr<Ctrl> ctrl = null;
        ctrl = cast<UnsafePtr<Ctrl>>(malloc(n: sizeof(Ctrl))); ctrl[0].strong = 1; ctrl[0].weak = 0;
        return Rc.make(p: raw, c: ctrl);                                     // fresh ctor -> no marker
    }
    public unsafe const fn const ref T deref() { return this.p[0]; }
    public unsafe fn ref T derefMut() { return this.p[0]; }
    public unsafe ctor copy(ref Rc<T> source) {
        source.c[0].strong = source.c[0].strong + 1;
        return Rc.make(p: source.p, c: source.c);                               // retain
    }
    public unsafe fn RcWeak<T> downgrade() {
        this.c[0].weak = this.c[0].weak + 1;
        return RcWeak.make(p: this.p, c: this.c);
    }
    unsafe ~Rc() {
        this.c[0].strong = this.c[0].strong - 1;
        if (this.c[0].strong == 0) {
            drop(ptr: this.p);
            free(p: cast<UnsafePtr>(this.p));
            if (this.c[0].weak == 0) { free(p: cast<UnsafePtr>(this.c)); }
        }
    }
}

fn RcWeak<Counter> makeExpired() {
    Rc<Counter> a = new Counter.make(start: 100);
    return a.downgrade();   // `a` drops on return -> object freed -> the returned weak is expired
}

fn int32 main() {
    Rc<Counter> a = new Counter.make(start: 7);
    RcWeak<Counter> w = a.downgrade();
    Optional<Rc<Counter>> o1 = w.tryUpgrade();
    int32 alive = match (o1) { case Some(value: u): u.n; case None: -1; };   // 7 (a alive)

    RcWeak<Counter> dead = makeExpired();
    Optional<Rc<Counter>> o2 = dead.tryUpgrade();
    int32 expired = match (o2) { case Some(value: u): u.n; case None: 90; }; // 90 (expired)

    return alive + expired;   // 97
}
