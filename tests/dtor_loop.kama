extern fn void kama_trace(int code);
extern fn int kama_trace_get();
unsafe fn int traceGet() { return kama_trace_get(); }   // the FFI call, contained — `main` may not be `unsafe`

type resource Res
{
    int id;
    public ctor make(int id) { this.id = id; }
    unsafe ~Res() { kama_trace(code: id); }
}

fn int f()
{
    Res outer = Res.make(id: 1);
    while (true)
    {
        Res inner = Res.make(id: 2);
        break;
    }
    return 0;
}

fn int main()
{
    int r = f();
    return traceGet();
}
