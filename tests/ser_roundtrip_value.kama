// Full JSON round-trip (serialize -> deserialize) for a value type of scalars, via the `decodeJsonBuffer` one-liner.
import { std::serialization::json::encodeJsonBuffer, std::serialization::json::decodeJsonBuffer };
@generate(Serializable, Deserializable)
type value Vec {
    @field int32 x;
    @field int32 y;
    @field int32 z;
    public ctor make(int32 x, int32 y, int32 z) { this.x = x; this.y = y; this.z = z; }
    public fn int32 dot() { return this.x + this.y + this.z; }
}
fn int32 main() {
    Vec v = Vec.make(x: 10, y: 20, z: 12);
    Result<string, Owned<Error>> j_r = encodeJsonBuffer(v: v);
    string j = match (give j_r) { case Ok(value: __ok): give __ok; case Err(error: __e): { return 250; } };
    Result<Vec, Owned<Error>> res = decodeJsonBuffer::<Vec>(src: give j);
    return match (res) { case Ok(value: q): q.dot(); case Err(error: e): 0 - 1; };   // 42
}
