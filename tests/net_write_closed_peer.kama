// A write to a peer that has closed returns `Err(IoError::BrokenPipe)` — it used to raise SIGPIPE, whose default
// action ended the whole process (exit 141) on the second write (KPG-1, from @kama/postgres). A database client, a
// TLS stream and a web server all write through `TcpStream`, and each died when the other end hung up first.
// The first writes may succeed — the kernel buffers them until the peer's reset arrives — so it writes until one
// fails.
import { std::net::TcpListener, std::net::TcpStream, std::io::IoError, std::collections::FixedArray };

// The port the OS picked for `bind(port: 0)`. No fixture pins a port, so no two can collide (KR-105).
fn uint16 portOf(ref TcpListener l) { return match (l.localAddr()) { case Ok(value: a): a.port; case Err(error: e): 0ui16; }; }

fn int32 main() {
    string host = "127.0.0.1";
    Result<TcpListener, IoError> rl = TcpListener.bind(host: host, port: 0ui16);
    TcpListener l = match (give rl) { case Ok(value: x): give x; case Err(error: e): { return 2; } };
    uint16 port = portOf(l: l);
    Result<TcpStream, IoError> rc = TcpStream.connect(host: host, port: port);
    TcpStream c = match (give rc) { case Ok(value: x): give x; case Err(error: e): { return 3; } };
    {
        Result<TcpStream, IoError> ra = l.accept();
        TcpStream s = match (give ra) { case Ok(value: x): give x; case Err(error: e): { return 4; } };
    }   // the server end closes here
    FixedArray<uint8> buf = FixedArray.make(size: 4096);
    int32 i = 0;
    while (i < 64) {
        int32 got = match (c.write(bytes: buf.view())) {
            case Ok(value: n): 0;
            // An unmapped OS code exits 100 + its last two digits (Windows' WSAECONNABORTED, 10053, would be 153), so a
            // failure on a leg nobody can run locally names the code. The Windows leg's plain `5` at 0.9.477 did not.
            case Err(error: e): match (e) { case BrokenPipe: 1; case ConnectionReset: 1; case Other(code: code): 100 + code % 100; case _: 5; };
        };
        if (got == 1) { return 42; }
        if (got >= 5) { return got; }
        i = i + 1;
    }
    return 6;   // 64 writes of 4 KiB into a closed peer and no error
}
