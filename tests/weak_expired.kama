import std::memory::{Shared, Weak};
// Weak<T> does NOT keep the pointee alive: after the last Shared drops, tryUpgrade() returns
// None (the type makes the absence unforgettable — no sentinel to remember to check).
type value Counter
{
    int32 value;
    Counter(int32 start) { this.value = start; }
    fn int32 get() { return this.value; }
}

fn Weak<Counter> orphan()
{
    Shared<Counter> s = new Counter(start: 7);
    return s.downgrade();   // s drops at fn-end -> Counter freed (strong 1->0); ctrl kept (weak=1)
}

fn int main()
{
    Weak<Counter> w = orphan();                      // its Shared already died

    Optional<Shared<Counter>> up = w.tryUpgrade();   // expired -> None
    return match (up) {
        case Some(s2): 100;   // not taken
        case None: 5;
    };
}
