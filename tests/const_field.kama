// M24d: a `const` data member is write-once — set in the constructor (from a ctor
// arg or an inline initializer), then immutable. Writing it in a method or through
// any binding outside the ctor is a compile error (verified separately); reading it
// (incl. from a const method) is fine.
type value Widget {
    const int32 id;          // set from the ctor arg
    const int32 kind = 7;    // inline initializer
    int32 count;             // private (kind-decides); read via the accessor
    public ctor make(int32 id) { slot Widget r; r.id = id; r.count = 0; return give r; }
    public fn void tick() { this.count = this.count + 1; }    // mutating non-const field: OK
    public const fn int32 count() { return this.count; }
    public const fn int32 tag() { return this.id + this.kind; }
}
fn int32 main() {
    Widget w = Widget.make(id: 33);
    w.tick(); w.tick();
    return w.tag() + w.count();   // (33 + 7) + 2 = 42
}
