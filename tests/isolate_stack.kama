// An isolate's stack is STATED: the main thread's own — 8 MiB on a 64-bit native target,
// 256 KiB on wasm, whose stacks share one fixed memory — not the OS's thread default. Until 0.9.529 it was the OS's, 512 KiB on macOS, where a
// 20 000-deep recursion that ran on the main thread died with SIGBUS in an isolate. `spawn(stack: n)`
// asks for more in both spawn forms, and `parallel_for`'s `stack:` clause sizes each worker. Returns 0, or the
// number of the failed check.
import { std::concurrent::Isolate, std::collections::DynamicArray };

// The depths, per target. SHARED fits the stated default on both the main thread and an isolate — the motivating
// 20 000 natively; less on wasm, whose 256 KiB default holds a few thousand debug frames. DEEP is past that default
// and inside BIG, so the deep checks pass only because the clause took effect: `fat` holds over half a KiB a frame,
// so natively 40 000 levels are over 20 MiB (more under ASan) against 8 MiB, and on wasm, whose memory is fixed, a
// smaller pair. DEEP is deep in BYTES, not in calls, because ThreadSanitizer keeps a shadow call stack of 65 536
// entries a thread and corrupts its own state past it: 64 000 levels pass under it and 67 000 fault in its runtime.
@compileFor(!ARCH_WASM32) comptime int64 SHARED = 20000;
@compileFor(ARCH_WASM32) comptime int64 SHARED = 2000;
@compileFor(!ARCH_WASM32) comptime int64 DEEP = 40000;
@compileFor(ARCH_WASM32) comptime int64 DEEP = 1500;
@compileFor(!ARCH_WASM32) comptime usize BIG = 256 * 1024 * 1024;
@compileFor(ARCH_WASM32) comptime usize BIG = 2 * 1024 * 1024;

fn int64 down(int64 n) {
    if (n == 0) { return 0; }
    return down(n: n - 1) + 1;
}

// A frame of over half a KiB: the deep checks reach their bytes in few calls.
fn int64 fat(int64 n) {
    if (n == 0) { return 0; }
    InlineArray<int64>#(64) pad = [0; 64];
    pad[0] = n;
    return fat(n: n - 1) + pad[0] - n + 1;
}

type resource Job implements Sendable {
    int64 depth = 0;
    bool wide = false;
    int64 got = -1;
    public ctor make(int64 depth) { this.depth = depth; }
    public ctor deep() { this.depth = DEEP; this.wide = true; }
    public fn void run() { this.got = this.wide ? fat(n: this.depth) : down(n: this.depth); }
    public const fn int64 result() { return this.got; }
}

fn void worker(ref Job j) { j.run(); }
fn void owned(Job j) { j.run(); }

fn uint8 main() {
    // The motivating case: the same depth on the main thread and in an isolate, on the stated default.
    int64 depth = SHARED;
    if (down(n: depth) != depth) { return 1; }
    Job j = Job.make(depth: depth);
    scope { spawn worker(j: ref j); }
    if (j.result() != depth) { return 2; }

    // Deeper than the default: the scope form, sized at the spawn.
    Job deep = Job.deep();
    scope { spawn(stack: BIG) worker(j: ref deep); }
    if (deep.result() != DEEP) { return 3; }

    // The handle form — a crash here is the failure; nothing comes back over a moved bundle.
    Job handed = Job.deep();
    Isolate h = spawn(stack: BIG) owned(j: give handed);
    give h.join();

    // Each worker of a parallel loop.
    DynamicArray<Job> jobs = DynamicArray.empty();
    jobs.add(item: Job.deep());
    jobs.add(item: Job.deep());
    parallel_for (ref Job x in jobs, workers: 2, stack: BIG) { x.run(); }
    if (jobs[0].result() != DEEP || jobs[1].result() != DEEP) { return 4; }

    // A small request is rounded up to the platform's floor (64 KiB, 128 KiB on Linux arm64), not refused.
    Job tiny = Job.make(depth: 10);
    scope { spawn(stack: 1024) worker(j: ref tiny); }
    if (tiny.result() != 10) { return 5; }
    return 0;
}
