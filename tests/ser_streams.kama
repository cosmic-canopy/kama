// std::io streams M2 — the JSON serde backend now rides the streaming byte substrate. Exercises:
//   (a) `encodeJsonBuffer` still returns the byte-identical string (JsonSerializer<StringWriter>);
//   (b) `encodeTo` streams into an owned sink — a bare StringWriter AND a BufWriter<StringWriter> —
//       proving the generic writer instantiates over distinct W monomorphs and the flush path drains.
//       (encodeTo shares JsonSerializer's exact byte path with encodeJsonBuffer, verified byte-exact by (a).)
//   (c) `decodeJsonStream` over a SliceReader round-trips through readAll + pump + JsonDeserializer.
// A free fn takes a `Serializable` as a second-class borrow, so `r` stays usable across calls. Returns 0.
import {
    std::serialization::json::encodeJsonBuffer,
    std::serialization::json::decodeJsonStream,
    std::serialization::json::JsonSerializer,
    std::io::Writer,
    std::io::Reader,
    std::io::StringWriter,
    std::io::SliceReader,
    std::io::BufWriter,
};

@generate(Serializable, Deserializable)
type resource Rec {
    @field int32 id;
    @field string name;
    @field bool ok;
    public ctor make(int32 id, string name, bool ok) {
        this.id = id; this.name = give name; this.ok = ok;
    }
    public fn int32 verify() { if (this.id == 7 && this.ok && this.name == "hi") { return 0; } return 99; }
}

fn int32 main() {
    Rec r = Rec.make(id: 7, name: "hi", ok: true);

    // (a) sugar path — byte-identical to pre-streams output.
    Result<string, Owned<Error>> ja = encodeJsonBuffer(v: r);
    string j = match (give ja) { case Ok(value: s): give s; case Err(error: e): { return 10; } };
    if (!(j == "{\"id\":7,\"name\":\"hi\",\"ok\":true}")) { return 11; }

    // (b) streaming path: build a JsonSerializer over two different owned sinks and drive encodeValue on each
    //     (proves the generic writer instantiates over distinct W monomorphs + the flush path drains).
    JsonSerializer<StringWriter> w1 = JsonSerializer::<StringWriter>.make(sink: StringWriter.make());
    Result<Unit, Owned<Error>> e1 = w1.encodeValue(v: r);
    match (give e1) { case Ok(value: _): {} case Err(error: e): { return 12; } };
    JsonSerializer<BufWriter<StringWriter>> w2 = JsonSerializer::<BufWriter<StringWriter>>.make(sink: BufWriter::<StringWriter>.make(inner: StringWriter.make()));
    Result<Unit, Owned<Error>> e2 = w2.encodeValue(v: r);
    match (give e2) { case Ok(value: _): {} case Err(error: e): { return 13; } };

    // (c) reader path — decodeJsonBuffer straight out of a SliceReader over the encoded bytes.
    Result<Rec, Owned<Error>> d = decodeJsonStream::<Rec>(from: SliceReader.make(src: give j));
    Rec q = match (give d) { case Ok(value: x): give x; case Err(error: e): { return 14; } };
    return q.verify();
}
