// std::num::Q16_16 signed 16.16 fixed-point — exact-value checks (fixed-point is exact for representable
// values, so no float tolerance needed; assert .raw / .toInt() directly). Sums to 42 like num_ops.kama.
import std::num::{Q16_16};
fn int main() {
    int32 r = 0;
    if (Q16_16.fromFloat(x: 0.5f64).raw == 32768i32)                              { r = r + 4; }   // 0.5 * 65536
    if (Q16_16.one().raw == 65536i32)                                             { r = r + 4; }
    if (Q16_16.fromInt(n: 3) == Q16_16.fromInt(n: 1) + Q16_16.fromInt(n: 2))      { r = r + 4; }
    if ((Q16_16.fromInt(n: 5) - Q16_16.fromInt(n: 2)).toInt() == 3)               { r = r + 4; }
    if ((Q16_16.fromFloat(x: 1.5f64) * Q16_16.fromFloat(x: 2.0f64)) == Q16_16.fromInt(n: 3)) { r = r + 4; }  // 1.5*2.0=3.0
    if ((Q16_16.fromInt(n: 6) / Q16_16.fromInt(n: 2)) == Q16_16.fromInt(n: 3))    { r = r + 4; }
    if ((-Q16_16.fromInt(n: 4)).toInt() == 0 - 4)                                 { r = r + 4; }
    if (Q16_16.fromInt(n: 2) < Q16_16.fromInt(n: 3))                              { r = r + 4; }
    if (Q16_16.fromFloat(x: 2.5f64).toFloat() == 2.5f64)                          { r = r + 4; }   // 2.5 is exact in 16.16
    if (Q16_16.fromInt(n: 3).satMul(r: Q16_16.fromInt(n: 4)) == Q16_16.fromInt(n: 12)) { r = r + 4; }   // in-range: == operator*
    // saturating: int32Max + 1 clamps (never traps) instead of overflowing.
    if (Q16_16.of(raw: 2147483647i32).satAdd(r: Q16_16.one()).raw == 2147483647i32) { r = r + 2; }
    return r;   // 42
}
