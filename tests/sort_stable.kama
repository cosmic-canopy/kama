// M2a: `sort` is STABLE and `sortUnstable` is not required to be. Stability is what makes a two-pass
// sort (by minor key, then major) produce the answer the caller meant, so it is asserted directly:
// records sharing a major key must retain the order the first pass gave them.
import {
    std::collections::DynamicArray,
    std::collections::View,
    std::collections::sort,
    std::collections::sortWith,
    std::collections::Order,
};

type value Rec {
    public int32 dept;
    public int32 id;
    public ctor make(int32 dept, int32 id) { this.dept = dept; this.id = id; }
}

// A comparator OBJECT — the seam that replaces a capturing closure. `field` is state an `fnptr`
// comparator could not carry.
// `compareTo` comes from the `Comparable` contract, not from `int32` itself, so it is reached through
// the contract — here a BOUND, which monomorphizes to the identical direct call.
fn Ordering cmp<T: Comparable<T>>(ref T a, ref T b) { return a.compareTo(other: b); }

type value ByField implements Order<Rec> {
    int32 field;
    public ctor make(int32 field) { this.field = field; }
    public fn Ordering compare(ref Rec a, ref Rec b) {
        int32 l = this.field == 0 ? a.dept : a.id;
        int32 r = this.field == 0 ? b.dept : b.id;
        return cmp(a: l, b: r);
    }
}

fn int32 main() {
    DynamicArray<Rec> rs = DynamicArray::<Rec>.empty();
    rs.add(item: Rec.make(dept: 2, id: 1));
    rs.add(item: Rec.make(dept: 1, id: 2));
    rs.add(item: Rec.make(dept: 2, id: 3));
    rs.add(item: Rec.make(dept: 1, id: 4));
    rs.add(item: Rec.make(dept: 2, id: 5));
    ByField byId   = ByField.make(field: 1);
    ByField byDept = ByField.make(field: 0);

    int32 ok = 1;
    borrow rs.view() as v {
        sortWith(items: v, by: byId);      // by id:   1 2 3 4 5
        sortWith(items: v, by: byDept);    // by dept: dept 1 (ids 2,4), dept 2 (ids 1,3,5) — ids ASCENDING iff stable

        if (v[0].id != 2) { ok = 0; }
        if (v[1].id != 4) { ok = 0; }
        if (v[2].id != 1) { ok = 0; }
        if (v[3].id != 3) { ok = 0; }
        if (v[4].id != 5) { ok = 0; }
    }

    // a run of equal keys must survive intact, not merely be present
    DynamicArray<int32> dup = DynamicArray::<int32>.empty();
    int32 i = 0;
    while (i < 40) { dup.add(item: 7 - (i % 3)); i = i + 1; }
    int32 lo = 0;
    int32 hi = 0;
    borrow dup.view() as dv {
        sort(items: dv);
        lo = dv[0] == 5 ? 1 : 0;
        hi = dv[39] == 7 ? 1 : 0;
    }

    return ok * 40 + lo + hi;   // 42
}
