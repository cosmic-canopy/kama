// Vec2/3/4 operators + methods, exact-value checksums (Pythagorean triples for exact lengths).
import std::math::{Vec2, Vec3, Vec4};
fn int32 main() {
    Vec3 a = Vec3.of(x: 3.0f32, y: 4.0f32, z: 0.0f32);
    Vec3 b = Vec3.of(x: 1.0f32, y: 2.0f32, z: 2.0f32);
    float32 la = a.length();               // 5   (3-4-5)
    float32 lb = b.length();               // 3   (1-2-2 -> sqrt 9)
    float32 d  = a.dot(r: b);              // 11
    Vec3 s  = a + b;                       // (4,6,2)
    Vec3 sc = a * 2.0f32;                  // (6,8,0)
    Vec3 ux = Vec3.unitX();
    Vec3 uy = Vec3.unitY();
    Vec3 cr = ux.cross(r: uy);             // (0,0,1)
    Vec2 v2 = Vec2.of(x: 6.0f32, y: 8.0f32);
    float32 l2 = v2.length();              // 10  (6-8-10)
    Vec4 v4 = Vec4.of(x: 0.0f32, y: 0.0f32, z: 0.0f32, w: 2.0f32);
    float32 l4 = v4.length();              // 2
    return cast<int32>(la) + cast<int32>(lb) + cast<int32>(d)            // 5+3+11 = 19
         + cast<int32>(s.x + s.y + s.z) + cast<int32>(sc.x)              // 12 + 6 = 18
         + cast<int32>(cr.z) + cast<int32>(l2) - cast<int32>(l4);        // 1 + 10 - 2 = 9  -> 46
}
