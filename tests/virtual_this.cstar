class Shape
{
    public fn int describe() { return this.area(); }
    virtual fn int area() { return 1; }
}
class Circle extends Shape
{
    int r;
    public Circle(int r) { this.r = r; }
    override fn int area() { return r * r; }
}
fn int main()
{
    Circle c = new Circle(r: 7);
    return c.describe();
}
