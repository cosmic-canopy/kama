extern fn void kama_trace(int code);
extern fn int kama_trace_get();

type resource Res
{
    int id;
    public ctor make(int id)
    {
        this.id = id;
    }
    ~Res()
    {
        kama_trace(code: id);
    }
}

fn int main()
{
    {
        Res a = Res.make(id: 1);
        Res b = Res.make(id: 2);
    }
    return kama_trace_get();
}
