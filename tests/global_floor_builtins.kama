// The intrinsics the compiler lowers at the call site — `panic`, `assert`, `debugAssert`, `addr`, `drop` —
// are reserved words (SPEC *kama's keywords*), legal only in call position. `global::X` names the same
// intrinsic as a bare `X` (FLOOR.md), and both spellings reach it: this is the positive half; the refused
// declaration is tests/xfail/intrinsic_reserved.kama and the trapping half tests/trap/global_assert.
//
// Until the reservation, a user's `fn void assert(bool cond, string msg)` was ACCEPTED and then never
// called — every bare `assert` lowered to the trap — and `fn int32 drop(int32 n)` sat beside `drop(ptr:)`.
unsafe fn bool sameAddress(ref int32 n) {
    UnsafePtr<int32> p = addr(of: n);
    UnsafePtr<int32> q = global::addr(of: n);
    return p == q;
}

fn int32 main() {
    int32 n = 40;
    assert(cond: n == 40, msg: "bare");
    global::assert(cond: 1 < 2, msg: "qualified");
    debugAssert(cond: true, msg: "");
    global::debugAssert(cond: n > 0, msg: "");
    if (!sameAddress(n: n)) { panic(msg: "one intrinsic, two spellings"); }
    return n + 2;   // 42
}
