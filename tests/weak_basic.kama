import std::memory::{Shared, Weak};
// Weak<T>: make a weak ref from a Shared, tryUpgrade() it while alive (-> Some), and use the
// shared object through the upgraded handle. The empty-Shared sentinel is gone (M28d).
type value Counter
{
    int32 value;
    public ctor make(int32 start) { Counter r; r.value = start; return give r; }
    public fn void bump() { this.value = this.value + 1; }
    public fn int32 get() { return this.value; }
}

fn int main()
{
    Shared<Counter> s = new Counter.make(start: 40);
    Weak<Counter> w = s.downgrade();              // weak ref (does not keep alive)
    Optional<Shared<Counter>> up = w.tryUpgrade();
    return match (up) {
        case Some(s2): s2.get() + 2;              // alive -> 40 + 2 = 42
        case None: 0;
    };
}
