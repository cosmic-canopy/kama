// std::net — name resolution, and the strict numeric parser under it. `localhost` is the one name every
// machine resolves without a network (it is in /etc/hosts on POSIX and its Windows equivalent), so this
// fixture needs no DNS server and no internet. The ten flags sum to 1023; the exit code is one byte, so the
// fixture prints the flags and exits 0 only when every one is set.
import { core::print, std::net::SocketAddr, std::net::parseIp, std::net::resolve,
         std::net::resolveOne, std::net::TcpListener, std::net::TcpStream,
         std::io::IoError };

fn bool isLoopback(ref SocketAddr a) {
    return match (a.ip) {
        case V4(a: p, b: q, c: r, d: s): p == 127ui8 && q == 0ui8 && r == 0ui8 && s == 1ui8;
        case V6(octets: o): "${a.ip}" == "::1";
    };
}

fn bool rejects(const ref string text) {
    return match (parseIp(text: text)) { case Some(value: v): false; case None: true; };
}

// The end-to-end shape the API exists for: connect to a NAME, whichever family its server listens on. The
// listener is already bound, so the connect completes into the backlog without an accept.
fn bool dialName(uint16 port) {
    Result<TcpStream, IoError> rs = TcpStream.connectHost(host: "localhost", port: port);
    return match (rs) { case Ok(value: s): true; case Err(error: e): false; };
}

fn bool invalidInput(const ref string host) {
    Result<TcpStream, IoError> rs = TcpStream.connect(host: host, port: 9ui16);
    return match (rs) { case Ok(value: s): false; case Err(error: e): match (e) { case InvalidInput: true; case _: false; }; };
}

fn int32 main() {
    int32 r = 0;

    // The parser: a good address round-trips through the text renderer.
    match (parseIp(text: "192.168.1.9")) {
        case Some(value: ip): {
            SocketAddr a = SocketAddr.of(ip: ip, port: 80ui16);
            string s = "${a.ip}";
            if (s == "192.168.1.9") { r = r + 1; }
        }
        case None: { }
    };
    // ⚠️ Both of these are ACCEPTED by C's inet_addr and must not be here: a leading zero read as octal
    // (so "010.0.0.1" becomes 8.0.0.1) and the packed short form ("127.1" becoming 127.0.0.1). That
    // disagreement between a validator and a resolver is CVE-2021-29922's shape.
    if (rejects(text: "010.0.0.1") && rejects(text: "127.1"))    { r = r + 2; }
    // ...and the ordinary malformed ones.
    if (rejects(text: "1.2.3.256") && rejects(text: "1.2.3.4x")) { r = r + 4; }

    // A numeric host is answered without a lookup, and still through the strict parser.
    match (resolveOne(host: "127.0.0.1", port: 7ui16)) {
        case Err(error: e): { }
        case Ok(value: a): { if (isLoopback(a: ref a) && a.port == 7ui16) { r = r + 8; } }
    };

    // A NAME goes to the system resolver. `localhost` must come back, and as a loopback address.
    // Every answer is kept, of either family (macOS gives `::1` first, then `127.0.0.1`), and each is loopback.
    // Whether `localhost` HAS a V6 answer is the host's hosts file, not kama: macOS maps `::1 localhost`, while
    // Debian and Ubuntu map `::1` only to `ip6-localhost`, so there the name is V4 alone. Recorded for the dial below.
    bool localhostV6 = false;
    match (resolve(host: "localhost", port: 9ui16)) {
        case Err(error: e): { }
        case Ok(value: list): {
            bool all = list.length() >= 1;
            isize i = 0;
            while (i < list.length()) {
                SocketAddr each = copy list[i];
                if (!isLoopback(a: ref each) || each.port != 9ui16) { all = false; }
                match (each.ip) { case V4(a: p, b: q, c: x, d: y): { } case V6(octets: o): { localhostV6 = true; } };
                i = i + 1;
            }
            if (all) { r = r + 16; }
        }
    };

    // A name that cannot exist (the .invalid TLD is reserved by RFC 2606 precisely for this) must FAIL,
    // not come back empty — an empty success is the shape that makes a caller index a hole.
    match (resolve(host: "kama-nonexistent.invalid", port: 9ui16)) {
        case Err(error: e): { r = r + 32; }
        case Ok(value: list): { }
    };

    // ...and the whole point: connect by name. A listener on 127.0.0.1 alone is reached although the resolver
    // may put `::1` first — the localhost trap `connectHost` exists for — and one on ::1 alone is reached too,
    // WHEN the name resolves to `::1` at all. Where it does not (Debian/Ubuntu, above) there is no V6 address to
    // try, so the flag is owed only by a host that has one: requiring it there tested the hosts file, not kama.
    uint16 port = cast<uint16>(47666);            // unique across tests/ — see tools/check-fixture-ports.sh
    match (TcpListener.bind(host: "127.0.0.1", port: port)) {
        case Err(error: e): { }
        case Ok(value: listener): { if (dialName(port: port)) { r = r + 64; } }
    };
    uint16 port6 = cast<uint16>(47667);           // ditto
    match (TcpListener.bind(host: "::1", port: port6)) {
        case Err(error: e): { }
        case Ok(value: listener): { if (!localhostV6 || dialName(port: port6)) { r = r + 128; } }
    };

    // `connect` takes numeric text only: a name is refused, not looked up behind the caller's back...
    if (invalidInput(host: "localhost")) { r = r + 256; }
    // ...and so is the octal form C's `inet_addr` used to read as 8.0.0.1 here.
    if (invalidInput(host: "010.0.0.1")) { r = r + 512; }

    if (r != 1023) { print(s: "net_resolve flags=${r}, want 1023\n"); return 1; }
    return 0;
}
