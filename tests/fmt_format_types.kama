// std::fmt (P1) coverage: char UTF-8 encoding, float, the empty buffer, and the migrated `SocketAddr`
// rendering through the `Formattable` contract via `${…}`. Exit code 15 = all four checks passed.
import { std::net::SocketAddr, std::net::IpAddr };

fn int32 main() {
    int32 r = 0;

    // char -> its UTF-8 character (ASCII + a 3-byte snowman U+2603)
    Formatter fc = Formatter.make();
    fc.writeChar(c: 'A');
    char snow = cast<char>(0x2603ui32);
    fc.writeChar(c: snow);
    string cs = fc.finish();
    if (cs == "A☃") { r = r + 1; }

    // float64 round-trips at shortest precision
    Formatter ff = Formatter.make();
    ff.writeF64(v: 1.5);
    string fs = ff.finish();
    if (fs == "1.5") { r = r + 2; }

    // an untouched Formatter finishes to the empty string
    Formatter fe = Formatter.make();
    string es = fe.finish();
    if (es == "") { r = r + 4; }

    // SocketAddr now implements Formattable; `${…}` renders it through the sink
    SocketAddr a = SocketAddr.of(ip: IpAddr::V4(a: 127ui8, b: 0ui8, c: 0ui8, d: 1ui8), port: 8080ui16);
    string rendered = "${a}";
    if (rendered == "127.0.0.1:8080") { r = r + 8; }

    return r;   // 1 + 2 + 4 + 8 = 15
}
