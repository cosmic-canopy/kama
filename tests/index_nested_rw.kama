import { std::collections::DynamicArray };
// An indexed element is a PLACE (lvalue), so nested subscripts read AND write: m[i][j], m[i][j] = v.
fn int32 main() {
    InlineArray<InlineArray<int32, 2>, 2> m = [[1, 2], [3, 4]];
    m[0][1] = 50;                       // nested write (value-array nesting)
    m[1][0] = 60;
    DynamicArray<InlineArray<int32, 2>> g = DynamicArray.empty();
    InlineArray<int32, 2> row = [10, 20];
    g.add(item: row);
    g[0][1] = 5;                        // nested write through a heap collection
    return m[0][1] + m[1][0] + m[0][0] + g[0][0] + g[0][1];   // 50 + 60 + 1 + 10 + 5 = 126
}
