type contract Shape for value{
    fn int64 area();
}
type value Circle implements Shape
{
    int64 r;
    public ctor make(int64 r) { this.r = r; }
    public fn int64 area() { return r * r; }
}
fn int main()
{
    Circle c = Circle.make(r: 6);
    Shape s = c;
    int64 a = s.area();
    uint64 m = cast<uint64>(a) % 256;
    return cast<int>(m);
}
