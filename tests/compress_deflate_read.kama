// `DeflateReader` (KR-5): raw deflate (RFC 1951) decoded from a `BufReader`. Every block type, stored, fixed and
// dynamic, and a stream mixing them (python3's zlib with a sync flush and a full flush in it), plus three shapes zlib
// never writes: a copy from exactly 32,768 bytes back, a dynamic block with no distance code, and one whose distance code
// is a single one-bit code. Each is read 1, 7 and 4,096 bytes at a time and checked against python3's zlib by length
// and CRC-32. Then the stream's END: `finish` hands the `BufReader` back at the first byte after it, so two streams back
// to back decode one after the other and the bytes after them are still there; and a source that answers `WouldBlock`
// before every byte, one byte a read, decodes the same bytes, every step resumed where it stopped. Returns 42.
import { std::compress::deflate::DeflateReader, std::io::BufReader, std::io::SliceReader, std::io::Reader,
         std::io::IoError, std::io::IoErrorKind, std::collections::DynamicArray, std::collections::FixedArray,
         std::collections::View, std::encoding::hex::decode, std::digest::crc32::crc32 };

fn DynamicArray<uint8> bytesOf(const ref string text) {
    return match (decode(text: text)) { case Ok(value: b): give b; case Err(error: e): DynamicArray.empty(); };
}

fn DeflateReader<SliceReader> over(const ref string stream, uint64 limit) {
    return DeflateReader.make(source: BufReader.make(inner: SliceReader.fromBytes(bytes: bytesOf(text: stream))),
                              limit: limit);
}

// 0 for bytes, else the error's kind: 1 InvalidData, 2 UnexpectedEof, 3 LimitExceeded, 9 any other.
fn int32 kindOf(IoError e) {
    return match (e.kind()) { case InvalidData: 1; case UnexpectedEof: 2; case LimitExceeded: 3; case _: 9; };
}

// Reads `d` to its end `chunk` bytes at a time: 0 when that is `len` bytes with this CRC-32.
fn int32 drain(ref DeflateReader<SliceReader> d, int32 len, uint32 crc, isize chunk) {
    DynamicArray<uint8> got = DynamicArray.empty();
    FixedArray<uint8> buf = FixedArray.make(size: chunk);
    while (true) {
        isize n = match (d.read(into: buf.viewMut())) { case Ok(value: k): k; case Err(error: e): -1; };
        if (n < 0) { return 1; }
        if (n == 0) { break; }
        for (isize i = 0; i < n; i = i + 1) { got.add(item: buf[i]); }
    }
    if (cast<int32>(got.length()) != len) { return 2; }
    if (crc32(bytes: got.view()) != crc) { return 3; }
    return 0;
}

fn int32 check(const ref string stream, int32 len, uint32 crc) {
    DeflateReader<SliceReader> a = over(stream: stream, limit: 1000000ui64);
    DeflateReader<SliceReader> b = over(stream: stream, limit: 1000000ui64);
    DeflateReader<SliceReader> c = over(stream: stream, limit: 1000000ui64);
    return drain(d: ref a, len: len, crc: crc, chunk: 1) + drain(d: ref b, len: len, crc: crc, chunk: 7)
         + drain(d: ref c, len: len, crc: crc, chunk: 4096);
}

// A source that gives one byte per read and answers `WouldBlock` before each one.
type resource Choppy implements Reader {
    DynamicArray<uint8> bytes;
    isize pos;
    bool ready;

    public ctor make(DynamicArray<uint8> bytes) { this.bytes = give bytes; this.pos = 0; this.ready = false; }

    public fn Result<isize, IoError> read(View<uint8> into) {
        if (!this.ready) {
            this.ready = true;
            return Result::Err(error: IoError.of(kind: IoErrorKind::WouldBlock));
        }
        this.ready = false;
        if (this.pos >= this.bytes.length() || into.length() == 0) { return Result::Ok(value: 0); }
        into[0] = this.bytes[this.pos];
        this.pos = this.pos + 1;
        return Result::Ok(value: 1);
    }
}

// Two streams back to back, then "TAIL": 0 when both decode, read `chunk` bytes at a time, and the tail is left.
fn int32 twoStreams(isize chunk) {
    DeflateReader<SliceReader> one = over(stream: "cb48cdc9c957c84027017d568b6ec3200cfc95fc9a97d0a65a9a4a2d537f7f056cb0cfa69ab6160c7e9ccfc7f29e9623"
                                          + "9dd7bc2f5bba1c94d3f2cacf44f7259d9b7c25b46db757a6734dcb67999439effd087fac8f2db8358eed7f97cb9d4e17"
                                          + "40392cbf7a5d5dca463794449a45a2d0e727c882daeae778acbf63af382e158b3f72114cf6ec8491d31992aeeeb8e5f4"
                                          + "a4a36e49a535d371fa4e79dd47a6724abb97c372b4a5de56015edd97ef4633ebac74eae06b402017f8408b6f9017573e"
                                          + "1c06718d9bd87d4b6a20c1c734ce1290513330881de94600eebcfd0193a06525571a34616bf3cb5906d424cb444f8c60"
                                          + "58fa1410c03503170750dba14093b60414028c62e45629ba830aa51367a532a83db450fb06f6eb9ec790ac1d3cde7cdf"
                                          + "ceedf10e64ec1b056df58e9c089c9927451a39c739a886ab1bb575edaa9e1075a25142e9d4848da4092fb676a3fd0da0"
                                          + "33fae7952bd4312907a668aa33c1383ae5669f48610a9440bb83d86eca4c0cab758a0a5090dd1dd08c26597083b9c157"
                                          + "8a7d7575f4c127ac746f2e2a24a8313fc1111e7283b502e72a9ea956a104816e21c1ad27d2936fdfdc48bc5da50d6a54"
                                          + "e2f9e8abaf922f45535383ebb1982901459ded448d65df55d1df1f3bde8d4b64f50461fe22cca83508db7c5c83d74366"
                                          + "cd0bba06730693ea72f4ff85d09d81e06cca8e0e4d3d7c3041d0732766f078f68487de4ab5140f545ffd035441494c",
                                          limit: 1000000ui64);
    if (drain(d: ref one, len: 23, crc: 2369606115ui32, chunk: chunk) != 0) { return 1; }
    BufReader<SliceReader> rest = match (give one.finish()) { case Ok(value: b): give b; case Err(error: e): { return 2; } };
    DeflateReader<SliceReader> two = DeflateReader.make(source: give rest, limit: 1000000ui64);
    if (drain(d: ref two, len: 2817, crc: 2695899570ui32, chunk: chunk) != 0) { return 3; }
    BufReader<SliceReader> after = match (give two.finish()) { case Ok(value: b): give b; case Err(error: e): { return 4; } };
    FixedArray<uint8> t = FixedArray.make(size: 16);
    isize k = match (after.read(into: t.viewMut())) { case Ok(value: m): m; case Err(error: e): -1; };
    return (k == 4 && t[0] == 84ui8 && t[3] == 76ui8) ? 0 : 5;   // "TAIL"
}

fn uint8 main() {
    // one stored block
    if (check(stream: "011300ecff68656c6c6f2c2073746f72656420626c6f636b", len: 19, crc: 3340945396ui32) != 0) { return 1; }
    // one fixed block with a match
    if (check(stream: "cb48cdc9c957c8402701", len: 23, crc: 2369606115ui32) != 0) { return 2; }
