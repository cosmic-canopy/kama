// M2 handle form: `Isolate h = spawn worker(...)` spawns immediately and returns an RAII handle whose
// drop = join. main does its own work while the isolate runs, then joins and reads the result. `join()` is
// a happens-before barrier, so the read is race-free (KAMA_TSAN-clean) — the concurrently-observable proof
// that the fused form (spawn+join in one statement) can't show.
import std::concurrent::{Isolate};

type resource Payload {
    UnsafePtr<int32> dst;
    int32 value;

    public ctor make(UnsafePtr<int32> dst, int32 value) {
        this.dst = dst;
        this.value = value;
    }

    public unsafe fn void run() {
        this.dst[0] = this.value;
    }
}

fn void worker(Payload p) {
    p.run();
}

fn int main() {
    int32 shared = 0;
    int32 mainWork = 0;
    Payload p = Payload.make(dst: addr(of: shared), value: 42i32);
    Isolate h = spawn worker(p: give p);   // spawn — runs concurrently with the loop below
    int32 i = 0;
    while (i < 1000) { mainWork = mainWork + 1; i = i + 1; }   // main-thread work overlaps the isolate
    h.join();                                // barrier: the isolate's write is now visible
    if (shared == 42 && mainWork == 1000) { return 0; }
    return 1;
}
