// Every "do it this way" example from docs/coming-from-other-languages.md, compiled.
// That page is written for readers (and LLMs) arriving from C#/Rust/Python, whose instincts kama
// deliberately rejects. If an example there stops being true, this fixture fails and says so.
import { std::serialization::json::serializeJsonBuffer };

type contract Shown for value { fn int32 show(); }

// (1) A `resource`'s fields are ALWAYS private — expose behavior, not state.
type resource Counter {
    int32 n;                                  // no `public` — a resource guards its invariant
    public ctor make(int32 n) { this.n = n; }
    public fn int32 value() { return this.n; }
}

// (2) `@generate(Serializable)` requires EVERY field to be marked `@field` or `@skip`.
@generate(Serializable)
type value Point {
    @field int32 x;
    @skip  int32 cachedHash;
    public ctor make(int32 x) { this.x = x; this.cachedHash = 0; }
}

// (3) A free function's bounds go in the TYPE-PARAMETER LIST — `when [...]` is for a generic
//     type's methods (conditional conformance), and a free fn has no "sometimes".
fn int32 showIt<W: Shown>(W x) { return x.show(); }

type value Leaf implements Shown {
    public int32 n;
    public ctor make(int32 n) { this.n = n; }
    public fn int32 show() { return this.n; }
}

// (4) `out` fills an uninitialized `slot`; `ref` borrows something already live.
fn void split(int32 a, int32 b, out int32 q, out int32 r) { q = a / b; r = a % b; }

type enum Code { Ok, Bad }
fn Code classify(int32 x) { if (x > 0) { return Code::Ok; } return Code::Bad; }

// (8) `.` constructs, `::` resolves scope — including on a GENERIC type, where a static's turbofish is
//     mandatory (a ctor infers its instance from its arguments; a static has no receiver to infer from).
type value Box<T> {
    public T v;
    public ctor make(T v) { this.v = v; }
    public static fn int32 tag() { return 3; }
}
type value Plain {
    public ctor make() { }
    public static fn int32 tag() { return 4; }
}
fn W pick<W>(W a, W b) { if (true) { return a; } return b; }

fn int32 main()
{
    // (5) A `match` SUBJECT may be a CALL RESULT — no intermediate binding needed. (This was the page's
    //     one real gap; `tests/match_call_plain_enum.kama` covers every call shape.)
    int32 a = match (classify(x: 1)) { case Ok: 10; case Bad: 0; };

    slot int32 q; slot int32 r;
    split(a: 17, b: 5, q: out q, r: out r);          // 3, 2

    Counter k = Counter.make(n: 20);
    int32 v = k.value();                              // behavior, not a public field

    // (6) An interpolation hole is an identifier plus `.field`/`[i]` — bind a call first.
    int32 len = v + q;
    string msg = "v=${v} len=${len}";

    // (7) Named arguments everywhere; generic free fns infer their type args FROM A BOUND LOCAL —
    //     an inline ctor argument is not enough ("argument is not a literal or a locally-typed value").
    Leaf lf = Leaf.make(n: 7);
    int32 s = showIt(x: lf);

    Point p = Point.make(x: 1);
    Result<string, Owned<Error>> j = serializeJsonBuffer(v: p);
    int32 ok = match (give j) { case Ok(value: t): 2; case Err(error: e): 0; };

    // (8) The four spellings, exactly as the page prints them.
    Box<int32> bi = Box.make(v: 10);                 // ctor, T inferred from the argument
    Box<int32> bx = Box::<int32>.make(v: 10);        // ctor, T explicit — dot after the turbofish
    int32 t1 = Plain::tag();                         // static function on a type
    int32 t2 = Box::<int32>::tag();                  // static on a GENERIC type — turbofish mandatory
    int32 pk = pick::<int32>(a: 1, b: 2);            // generic FREE function with explicit type args
    int32 eight = bi.v - bx.v + t1 + t2 + pk;        // 0 + 4 + 3 + 1 = 8

    // (9) `substring` traps on an offset that splits a character; an offset from a SEARCH cannot.
    //     For one you computed yourself, `truncate` and `floorCharBoundary` are total.
    string acc = "AéZ";
    isize keep = acc.truncate(maxBytes: 2).length();          // 1 — "A", never a split é
    isize bnd  = acc.floorCharBoundary(at: 2);               // 1 — snapped down

    return a + q + r + v + s + ok - cast<int32>(msg.length()) + eight - cast<int32>(keep) - cast<int32>(bnd);
    // 33 + 8 - 1 - 1 = 39
}
