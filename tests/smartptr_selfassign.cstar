// Step 4: self-assignment on a smart pointer must be a no-op, not a use-after-free
// (it used to release the pointee then "copy" it back onto freed memory).
class Probe { int32 id; public Probe(int32 id){ this.id = id; } public fn int32 get(){ return this.id; } }
fn int main() {
    Owned<Probe> o = new Probe(id: 20);
    o = o;                                  // no-op (guarded), pointee stays alive
    Shared<Probe> s = new Probe(id: 22);
    s = s;                                  // no double-decrement
    return o.get() + s.get();               // 20 + 22 = 42
}
