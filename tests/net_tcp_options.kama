// std::net TCP options + non-blocking read — a client connects (loopback backlog), sets TCP_NODELAY and
// non-blocking, then a read with no data pending returns Err(WouldBlock) instead of stalling. Returns 55.
import std::net::{TcpListener, TcpStream};
import std::io::{IoError};
import std::collections::{Array};

fn bool isOk(Result<Unit, IoError> r) { return match (r) { case Ok(u): true; case Err(e): false; }; }
fn bool isWouldBlock(IoError e) { return match (e) { case WouldBlock: true; case _: false; }; }

fn int32 checkClient(ref TcpStream c) {
    if (!isOk(r: c.setNoDelay(on: true)))     { return 71; }
    if (!isOk(r: c.setNonBlocking(on: true))) { return 72; }
    Array<uint8> buf = Array(size: 64);
    Result<usize, IoError> rr = c.read(into: buf);
    bool wb = match (rr) { case Ok(n): false; case Err(e): isWouldBlock(e: e); };
    if (!wb) { return 73; }
    return 55;
}

fn int main() {
    string host = "127.0.0.1";
    uint16 port = cast<uint16>(47660);
    Result<TcpListener, IoError> rl = TcpListener::bind(host: host, port: port);
    return match (rl) {
        case Ok(l): {
            Result<TcpStream, IoError> rc = TcpStream::connect(host: host, port: port);
            := match (rc) { case Ok(c): checkClient(c: c); case Err(e): 70; };
        }
        case Err(e): 69;
    };
}
