// M31 — value-producing constructs in a loop condition use a loop-and-a-half transform so they
// re-evaluate each iteration (a compute-once bug would loop forever, since the ctor uses the counter).
@generate(of)
type value V implements Comparable {
    public int32 x;
    public fn Ordering compareTo(ref V other) {
        if (this.x < other.x) { return Ordering::Less; }
        if (this.x > other.x) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}
fn int32 main() {
    int32 acc = 0;
    int32 i = 0;
    while (V.of(x: i) < V.of(x: 4)) { acc = acc + 1; i = i + 1; }               // i: 0..3 -> 4 iterations
    for (int32 k = 0; V.of(x: k) < V.of(x: 3); k = k + 1) { acc = acc + 10; }   // k: 0..2 -> 3 iterations
    return acc;   // 4 + 30 = 34
}
