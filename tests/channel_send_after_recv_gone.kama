// M8 (Bug 1 regression): `send` must HAND THE ITEM BACK when the receiver is gone — never silently
// destroy it. Historically `send` unconditionally zeroed the moved-in item, so a failed delivery
// corrupted the caller's value (and skipped its destructor on garbage). Here we drop the receiver up
// front, then send an `Owned<Box>` (a unique heap pointer — a genuine resource): the send fails, the
// box is returned intact in the `Err` (`Undelivered::Item(item)`), we read 42 through it, and it frees
// exactly once at the match arm's end. ASan-clean under KAMA_SAN=1 (no leak, no double-free, no
// use-of-zeroed-garbage).
import {
    std::concurrent::Channel,
    std::concurrent::Sender,
    std::concurrent::Receiver,
    std::concurrent::Undelivered,
    std::memory::Owned,
};

type value Box implements Sendable {
    int32 v;
    public ctor make(int32 v) { this.v = v; }
    public fn int32 get() { return this.v; }
}

fn uint8 main() {
    Channel<Owned<Box>> ch = Channel.bounded(capacity: 2);
    Sender<Owned<Box>>   tx = ch.sender();

    // The receiver's life is a SCOPE. This used to be `drop(value: rx)` on a local, which ran the
    // destructor here AND again at scope exit — harmless only because `Receiver`'s tolerates it. A scope
    // is how a local's life ends early; `drop` reaches places a scope cannot (a heap pointee, an element
    // in a hand-managed buffer) and now takes an `UnsafePtr<T>` accordingly.
    { Receiver<Owned<Box>> rx = ch.receiver(); }   // receiver gone → any send now fails

    Owned<Box> b = new Box.make(v: 42);
    Result<Unit, Undelivered<Owned<Box>>> res = tx.send(item: give b);

    int32 got = 0;
    match (give res) {
        case Ok(value: _):  { got = -1; }                                   // must NOT happen — the receiver is gone
        case Err(error: u): { match (give u) { case Item(item: item): { got = item.get(); } }; }   // handed back intact → 42; frees at arm-end
    };
    return cast<uint8>(got);   // 42
}
