type value Accum
{
    int32 total;
    public ctor make(int32 init)
    {
        this.total = init;
    }
    public fn void bump()
    {
        this.total = this.total + 1;
    }
    public fn int32 run()
    {
        this.bump();
        return this.total;
    }
}
fn uint8 main()
{
    Accum a = Accum.make(init: 40);
    a.bump();
    return cast<uint8>(a.run());
}
