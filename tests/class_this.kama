type value Accum
{
    int32 total;
    public ctor make(int32 init)
    {
        this.total = init;
    }
    public fn void bump()
    {
        this.total = this.total + 1;
    }
    public fn int32 run()
    {
        this.bump();
        return this.total;
    }
}
fn int32 main()
{
    Accum a = Accum.make(init: 40);
    a.bump();
    return a.run();
}
