// Construction-model M8c: every growable collection offers the consistent four-ctor matrix —
// `empty()` / `withCapacity(n)` (default `GlobalAllocator`) and `withAllocator(a)` /
// `withCapacityAndAllocator(a, n)` (caller-owned `A`). `Map`/`Set::withCapacity` are now `ctor`s (were
// `static fn`), callable dot-on-type (generic receiver, args inferred from the LHS) or via the `::` bridge.
// PriorityQueue's capacity rides its backing array via `minHeap/maxHeapWithCapacity`. All exercised below so
// each generic ctor is actually instantiated + checked.
import std::collections::{DynamicArray, Map, Set, Deque, SlotMap, Handle, BitSet, PriorityQueue};
fn int32 main() {
    DynamicArray<int32> a = DynamicArray.empty();          // default-marked empty ctor
    a.add(item: 10); a.add(item: 20);                      // 10+20 = 30

    DynamicArray<int32> ac = DynamicArray.withCapacity(capacity: 8);   // default-alloc, presized
    ac.add(item: 5);                                       // 5

    Map<int32, int32> m = Map.withCapacity(capacity: 8);   // was static fn — now a ctor, dot-on-type
    m.put(key: 1, value: 7);                               // 7

    Set<int32> s = Set.withCapacity(capacity: 16);         // builds the wrapped Map via Map::withCapacity
    s.add(key: 3);                                         // contains → 1

    Deque<int32> d = Deque.withCapacity(capacity: 4);
    d.pushBack(item: 9);                                   // length → 1

    SlotMap<int32> sm = SlotMap.withCapacity(capacity: 8);
    Handle h = sm.insert(value: 4);                        // get(h) → 4

    BitSet bs = BitSet.withCapacity(bits: 64);
    bs.set(index: 5);                                      // count → 1

    PriorityQueue<int32> pq = PriorityQueue.minHeapWithCapacity(capacity: 8);
    pq.push(item: 99);                                     // peek → 99

    // Caller-owned allocator AND presized, via a GlobalAllocator value (the custom-`A` presize path).
    Map<int32, int32> m2 = Map.withCapacityAndAllocator(allocator: GlobalAllocator.make(), capacity: 4);
    m2.put(key: 2, value: 6);                              // 6

    Map<int32, int32> viaBridge = Map.empty();            // `::` bridge on a ctor still works
    viaBridge.put(key: 8, value: 8);                       // 8

    int32 mv  = match (m.get(key: 1))  { case Some(value: x): x; case None: 0; };   // 7
    int32 sc  = s.contains(key: 3) ? 1 : 0;                                  // 1
    int32 dl  = d.length();                                                  // 1
    int32 smv = match (sm.get(handle: h)) { case Some(value: x): x; case None: 0; };// 4
    int32 bc  = bs.count();                                                  // 1
    int32 pk  = match (pq.peek())      { case Some(value: x): x; case None: 0; };   // 99
    int32 m2v = match (m2.get(key: 2)) { case Some(value: x): x; case None: 0; };   // 6
    int32 bv  = match (viaBridge.get(key: 8)) { case Some(value: x): x; case None: 0; }; // 8

    // 30 + 5 + 7 + 1 + 1 + 4 + 1 + 99 + 6 + 8 = 162
    return a[0] + a[1] + ac[0] + mv + sc + dl + smv + bc + pk + m2v + bv - 100;   // 162 - 100 = 62
}
