// The numbered backend across the value shapes that exercise its wire format: every scalar width through
// zigzag varints (the negatives matter — sign-extension before zigzag is what keeps `int32 -9` at one byte
// instead of ten), floats through fixed32/fixed64, a length-delimited string, a nested composite and a
// collection as GROUP_START/GROUP_END subtrees, both `Optional` arms, and a tagged enum.
import {
    std::collections::DynamicArray,
    std::serialization::binary::encodeNumbered,
    std::serialization::binary::decodeNumbered,
};

@generate(Serializable, Deserializable)
type value Inner { @field public int32 n;
    public ctor make(int32 n) { this.n = n; } }

@generate(Serializable, Deserializable)
type enum Shape { Circle(int32 r), Rect(int32 w, int32 h), Empty }

@generate(Serializable, Deserializable)
type resource Rec {
    @field int8 i8;    @field int16 i16;  @field int32 i32;  @field int64 i64;
    @field uint8 u8;   @field uint16 u16; @field uint32 u32; @field uint64 u64;
    @field bool flag;  @field char ch;    @field string s;
    @field Inner nested;
    @field Optional<int32> present;
    @field Optional<int32> absent;
    @field Shape shape;
    @field DynamicArray<int32> list;

    public ctor make() {
        this.i8 = 0 - 5; this.i16 = 0 - 300; this.i32 = 0 - 70000; this.i64 = 0 - 5000000000;
        this.u8 = 200ui8; this.u16 = 60000ui16; this.u32 = 4000000000ui32; this.u64 = 18000000000000000000ui64;
        this.flag = true; this.ch = 'é'; this.s = "kama ✓";
        this.nested = Inner.make(n: 77);
        this.present = Optional::Some(value: 12);
        this.absent = Optional::None;
        this.shape = Shape::Rect(w: 3, h: 4);
        this.list = DynamicArray.empty();
        this.list.add(item: 10); this.list.add(item: 20); this.list.add(item: 30);
    }

    // A `resource` field is always private, so the check rides a method — which is the kama way and also
    // makes the fixture assert on the DECODED value from inside the type that owns it.
    public const fn int32 verify() {
        if (this.i8 != 0 - 5) { return 1; }
        if (this.i16 != 0 - 300) { return 2; }
        if (this.i32 != 0 - 70000) { return 3; }
        if (this.i64 != 0 - 5000000000) { return 4; }
        if (this.u8 != 200ui8) { return 5; }
        if (this.u16 != 60000ui16) { return 6; }
        if (this.u32 != 4000000000ui32) { return 7; }
        if (this.u64 != 18000000000000000000ui64) { return 8; }
        if (!this.flag) { return 9; }
        if (this.ch != 'é') { return 10; }
        if (!this.s.equals(other: "kama ✓")) { return 11; }
        if (this.nested.n != 77) { return 12; }
        int32 pv = match (this.present) { case Some(value: v): v; case None: 0 - 1; };
        if (pv != 12) { return 13; }
        bool wasAbsent = match (this.absent) { case Some(value: _): false; case None: true; };
        if (!wasAbsent) { return 14; }
        int32 sv = match (this.shape) { case Circle(r: _): 0 - 1; case Rect(w: w, h: h): w * 10 + h; case Empty: 0 - 2; };
        if (sv != 34) { return 15; }
        if (this.list.length() != 3) { return 16; }
        if (this.list[0] != 10 || this.list[1] != 20 || this.list[2] != 30) { return 17; }
        return 0;
    }
}

fn int32 main() {
    Result<DynamicArray<uint8>, Owned<Error>> b = encodeNumbered(v: Rec.make());
    DynamicArray<uint8> bytes = match (give b) { case Ok(value: v): give v; case Err(error: e): { return 250; } };
    Result<Rec, Owned<Error>> d = decodeNumbered::<Rec>(src: give bytes);
    Rec r = match (give d) { case Ok(value: v): give v; case Err(error: e): { return 251; } };

    int32 bad = r.verify();
    if (bad != 0) { return bad; }
    return 42;
}
