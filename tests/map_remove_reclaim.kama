// Map.remove now moves the value OUT as `Optional<V>`: RECLAIM it (match Some, take ownership) or DISCARD to
// just delete (the returned Optional drops the value cleanly). Both paths ASan-clean with a move-only value.
import std::collections::{Map};

type resource Counter {
    int32 n;
    public ctor make(int32 n) { slot Counter r; r.n = n; return give r; }
    public fn int32 get() { return this.n; }
}

fn int main() {
    Map<int32, Counter> m = Map.empty();
    m.put(key: 1, value: Counter.make(n: 10));
    m.put(key: 2, value: Counter.make(n: 20));
    m.put(key: 3, value: Counter.make(n: 30));

    int32 r = 0;
    // RECLAIM: take ownership of the removed value out of the map (bind the local, then match it).
    Optional<Counter> taken = m.remove(key: 2);
    int32 got = match (taken) { case Some(value: c): c.get(); case None: 0; };   // 20 (c drops in the arm)
    r = r + got;

    // DISCARD: delete without reclaiming — the returned Optional<Counter> drops the value.
    m.remove(key: 1);                                                 // drops Counter(10)
    m.remove(key: 99);                                               // absent -> None, no-op

    r = r + m.length();                                              // 1 (only key 3 remains)
    return r;   // 21 (m drops Counter(30) at scope exit)
}
