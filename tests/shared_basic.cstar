// Shared<T>: heap construction + control block, auto-deref, RAII (last handle frees).
class Counter
{
    int32 value;
    Counter(int32 start) { this.value = start; }
    fn void bump() { this.value = this.value + 1; }
    fn int32 get() { return this.value; }
}

fn int main()
{
    Shared<Counter> c = new Shared<Counter>(start: 40);
    c.bump();
    c.bump();
    return c.get();   // 42
}
