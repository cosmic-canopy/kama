// Construction-model M7.1: the migrated stdlib math types offer named ctors — the dot-on-type spelling
// (`Vec3.zero()`, `Mat4.identity()`, `Quat.identity()`) and the `@generate(of)` memberwise (`Vec3.of(...)`).
// The `::` bridge to named ctors still compiles (the nameless primary was removed at M8d.2).
import { std::math::Vec2, std::math::Vec3, std::math::Vec4, std::math::Quat, std::math::Mat4 };
fn int32 main() {
    Vec3 a = Vec3.of(x: 3.0f32, y: 4.0f32, z: 0.0f32);   // @generate(of) memberwise
    Vec3 z = Vec3.zero();                                 // dot-on-type ctor
    Vec2 o = Vec2.one();                                  // dot-on-type ctor
    Vec4 s = Vec4.splat(s: 2.0f32);                       // dot-on-type ctor (arg)
    Quat q = Quat.identity();                             // dot-on-type ctor
    Mat4 m = Mat4.identity();                             // dot-on-type ctor
    float32 la = a.length();                              // 5  (3-4-5)
    float32 diag = m.get(c: 2, r: 2);                     // 1  (identity)
    return cast<int32>(la)                                // 5
         + cast<int32>(z.x + z.y + z.z)                   // 0
         + cast<int32>(o.x + o.y)                         // 2
         + cast<int32>(s.x + s.y + s.z + s.w)             // 8
         + cast<int32>(q.w)                               // 1
         + cast<int32>(diag) * 26;                        // 26  -> total 42
}
