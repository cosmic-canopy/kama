extern fn void kama_trace(int code);
extern fn int kama_trace_get();

type resource Res
{
    int id;
    public ctor make(int id) { Res r; r.id = id; return give r; }
    ~Res() { kama_trace(code: id); }
}

fn int f(bool c)
{
    Res a = Res.make(id: 1);
    if (c)
    {
        Res b = Res.make(id: 2);
        return 0;
    }
    return 9;
}

fn int main()
{
    int r = f(c: true);
    return kama_trace_get();
}
