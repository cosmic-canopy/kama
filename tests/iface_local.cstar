interface IShape
{
    fn int64 area();
}
class Circle implements IShape
{
    int64 r;
    public Circle(int64 r) { this.r = r; }
    fn int64 area() { return r * r; }
}
fn int main()
{
    Circle c = new Circle(r: 6);
    IShape s = c;
    int64 a = s.area();
    uint64 m = cast<uint64>(a) % 256;
    return cast<int>(m);
}
