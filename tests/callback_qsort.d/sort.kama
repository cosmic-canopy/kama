// M21: a real libc callback driven through an `fnptr` type. `fnptr Comparator(...)`
// declares a zero-cost function-pointer type; a free function binds by name. The cast
// to the header's comparator is INTRINSIC to C's `void*`-based qsort API (the
// comparator is `int(*)(const void*, const void*)`, so the typed pointer must be
// bridged at the edge) — it is the correct idiom, not a missing feature. kama can
// spell `const T*` since M24e; for a const-pointer C API that needs NO cast, see
// tests/const_ffi.d.
import std::collections::{FixedArray};
extern "<stdlib.h>";
extern "cb.h";
fnptr int32 Comparator(UnsafePtr<int32> a, UnsafePtr<int32> b);   // a function-pointer type
extern fn void qsort(UnsafePtr buf, usize nmemb, usize size, CompareFn compar);

unsafe fn int32 cmp(UnsafePtr<int32> a, UnsafePtr<int32> b) { int32 r = 0; r = a[0] - b[0]; return r; }

unsafe fn int run()
{
    FixedArray<int32> a = FixedArray.make(size: 4);
    a[0] = 30; a[1] = 10; a[2] = 2; a[3] = 99;
    Comparator c = cmp;                                                    // bind, zero-cost
    qsort(buf: a.dataPtr(), nmemb: 4, size: 4, compar: cast<CompareFn>(c));// hand the fn ptr to C
    int32 r = 0;
    UnsafePtr<int32> p = a.dataPtr(); r = p[3] - p[0] - 55;           // sorted -> 99-2-55
    return r;
}

// The body above is the raw work, so IT carries the marker; `main` may not be `unsafe`
// (it encloses the whole program). Calling an `unsafe fn` from safe code is allowed.
fn int main() { return run(); }
