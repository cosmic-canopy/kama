// M18: a real libc callback. qsort calls back into the cstar comparator `cmp`.
// The cast spells the exact C callback type (cstar has no `const`), so there's
// no implicit/incompatible function-pointer conversion.
extern "<stdlib.h>";
extern "cb.h";
extern void qsort(Ptr buf, usize nmemb, usize size, CompareFn compar);

int32 cmp(Ptr<int32> a, Ptr<int32> b) { int32 r = 0; unsafe { r = a[0] - b[0]; } return r; }

int main()
{
    Array<int32> a = new Array<int32>(size: 4);
    a[0] = 30; a[1] = 10; a[2] = 2; a[3] = 99;
    qsort(buf: a.dataPtr(), nmemb: 4, size: 4, compar: cast<CompareFn>(funcptr(of: cmp)));
    int32 r = 0;
    unsafe { Ptr<int32> p = a.dataPtr(); r = p[3] - p[0] - 55; }   // sorted -> 99-2-55
    return r;
}
