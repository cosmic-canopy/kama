// M11b — the DEFAULT-allocator (bare) path is unchanged: a `SortedMap<K,V>` / `SortedSet<K>` written
// without an allocator arg uses the zero-size `GlobalAllocator` (filled from the M8 default), so every
// node box + array is libc malloc/free exactly as before M11b.
import { std::collections::SortedMap, std::collections::SortedSet, std::collections::DynamicArray };

fn int32 main() {
    int32 r = 0;

    SortedMap<int32, int32> sm = SortedMap.empty();
    int32 i = 0;
    while (i < 20) { sm.put(key: (i * 13) % 20, value: (i * 13) % 20); i = i + 1; }
    if (sm.length() == 20) { r = r + 10; }
    Optional<int32> g = sm.get(key: 7);
    int32 gv = match (g) { case Some(value: x): x; case None: 0 - 1; };
    if (gv == 7) { r = r + 10; }

    // copy threads the (default) allocator and clones the whole tree independently
    SortedMap<int32, int32> cp = copy sm;
    sm.clear();
    if (cp.length() == 20 && sm.length() == 0) { r = r + 10; }

    SortedSet<int32> ss = SortedSet.empty();
    i = 0;
    while (i < 15) { ss.add(key: i); i = i + 1; }
    DynamicArray<int32> es = ss.elements();
    if (ss.length() == 15 && es.length() == 15 && ss.contains(key: 9)) { r = r + 10; }

    return r;   // 4 asserts * 10 = 40
}
