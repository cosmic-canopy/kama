// Round-trip a resource with a string field, a @field(name:) rename, and a @skip field (ctor-initialized).
import std::serialization::json::{encode, decode};
@generate(Serialize, Deserialize, noOnConstruction)
type resource User {
    @field(name: "user_name") string name;
    @field int32 id;
    @skip int32 loginCount;
    public User(string name, int32 id) { this.name = give name; this.id = id; this.loginCount = 0; }
    public fn int32 tag() { return this.id + cast<int32>(this.name.length()); }
}
fn int main() {
    User u = User(name: "kai", id: 39);
    Result<string, Owned<Error>> j_r = encode(v: u);
    string j = match (give j_r) { case Ok(__ok): give __ok; case Err(__e): { return 250; } };                       // {"user_name":"kai","id":39}
    Result<User, Owned<Error>> res = decode::<User>(src: give j);
    return match (res) { case Ok(q): q.tag(); case Err(e): 0 - 1; };   // 39 + 3 = 42
}
