extern fn void kama_trace(int32 code);
extern fn int32 kama_trace_get();
unsafe fn int32 traceGet() { return kama_trace_get(); }   // the FFI call, contained — `main` may not be `unsafe`

// Destructor chaining through inheritance (Derived's dtor runs, then Base's).
// M25b: extension is opt-in, so Base is a `virtual class`; the dtor chain is unchanged.
type virtual(maxDepth: 1) resource Base
{
    public ctor make() { }
    unsafe ~Base() { kama_trace(code: 1); }
    protected virtual fn int32 kind() { return 0; }
}
type final resource Derived extends Base
{
    public ctor make() { this.base = Base.make(); }
    unsafe ~Derived() { kama_trace(code: 2); }
    protected override fn int32 kind() { return 1; }
}
fn int32 main()
{
    {
        Derived d = Derived.make();
    }
    return traceGet();
}
