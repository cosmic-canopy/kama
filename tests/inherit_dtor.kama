extern fn void kama_trace(int code);
extern fn int kama_trace_get();

// Destructor chaining through inheritance (Derived's dtor runs, then Base's).
// M25b: extension is opt-in, so Base is a `virtual class`; the dtor chain is unchanged.
type virtual resource Base
{
    public ctor make() { slot Base r;  return give r; }
    ~Base() { kama_trace(code: 1); }
    protected virtual fn int kind() { return 0; }
}
type final resource Derived extends Base
{
    public ctor make() { slot Derived r;  return give r; }
    ~Derived() { kama_trace(code: 2); }
    protected override fn int kind() { return 1; }
}
fn int main()
{
    {
        Derived d = Derived.make();
    }
    return kama_trace_get();
}
