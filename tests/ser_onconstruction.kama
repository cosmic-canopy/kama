// onConstruction() runs on EVERY construction of a @generate(Deserialize) type: the compiler injects it at the
// END of the constructor AND the deserialize codegen calls it after field-set (deserialize bypasses the ctor).
// A @skip `born` field is written only by the hook (stays 0 otherwise), proving it fired on BOTH the
// hand-built instance and the deserialized one. onConstruction may be private.
import std::serialization::json::{encode, decode};
@generate(Serialize, Deserialize)
type value Widget {
    @field int32 x;
    @skip int32 born;
    public Widget(int32 x) { this.x = x; }
    fn void onConstruction() { this.born = 7; }
    public fn int32 check() { return this.born; }
}
fn int main() {
    Widget a = Widget(x: 5);                          // ctor-end injection -> born = 7
    int32 h = a.check();                              // 7
    string j = encode(v: a);                        // {"x":5}  (born is @skip, omitted)
    Result<Widget, Owned<Error>> res = decode::<Widget>(src: give j);
    int32 d = match (res) { case Ok(q): q.check(); case Err(e): 0; };   // deserialize path -> born = 7
    return h + d;                                     // 7 + 7 = 14
}
