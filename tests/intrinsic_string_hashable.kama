// Universal `Hashable` for the PRIMITIVE `string`: the conformance is a pure-kama `type intrinsic` block
// hosted in the PRELUDE (NO compiler blessing), so `string` satisfies the bound WITHOUT
// importing `std::collections`. Exercises a generic bound `<K: Hashable + Equatable>` with a primitive
// `string` arg and `Equatable` satisfied STRUCTURALLY through string's built-in `equals`. The key invariant
// (what `Map<string, V>` relies on): a DIFFERENTLY-sourced key — a concat with a distinct data pointer —
// hashes AND compares equal to the literal (content-based, not pointer-based). Returns 42. (User code can no
// longer declare `Hashable` for `string` — the prelude already provides it.)

fn uint64 hashOf<K: Hashable>(K k) { return k.hash(); }    // string satisfies the bound via the prelude

fn bool sameKey<K: Hashable + Equatable<K>>(K a, K b) {
    return a.hash() == b.hash() && a.equals(other: b);
}

fn int main() {
    int32 r = 0;
    if (hashOf(k: "kama") == hashOf(k: "kama")) { r = r + 10; }   // deterministic — equal keys hash equal
    if (hashOf(k: "kama") != hashOf(k: "lang")) { r = r + 11; }   // distinct content differs (FNV-1a)
    if (sameKey(a: "kam" + "a", b: "kama"))      { r = r + 10; }  // content-based: concat == literal
    if (!sameKey(a: "kama", b: "lang"))          { r = r + 11; }  // different content, not equal
    return r;                                                      // 42
}
