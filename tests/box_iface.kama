// Polymorphic library ownership — Rust's Box<dyn Trait>. `Box<Shape>` owns a concrete Circle/Square
// behind the contract's fat pointer, dispatches area() virtually, and drops via the vtable. The library
// Box<T> is ONE type; the compiler routes the contract instance through the interface-owner path.
extern "<stdlib.h>";
extern fn void free(Ptr p);

type contract Shape for both { fn int32 area(); }
type value Circle implements Shape { int32 r; public ctor make(int32 r) { slot Circle x; x.r = r; return give x; } public fn int32 area() { return this.r * this.r; } }
type value Square implements Shape { int32 s; public ctor make(int32 s) { slot Square x; x.s = s; return give x; } public fn int32 area() { return this.s * this.s; } }

type resource Box<T> implements Deref<T>, HeapOwner<T> {
    Ptr<T> p;
    public ctor adopt(Ptr<T> raw) { slot Box<T> b; b.p = raw; return b; }
    public fn ref T deref() { unsafe { return this.p[0]; } }
    ~Box() { unsafe { free(p: cast<Ptr>(this.p)); } }
}

fn int32 main() {
    Box<Shape> a = new Circle.make(r: 5);   // 25
    Box<Shape> b = new Square.make(s: 4);   // 16 (heterogeneous — different concrete types, one Box<Shape>)
    return a.area() + b.area();        // 41 (virtual dispatch)
}
