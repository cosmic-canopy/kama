// Polymorphic library ownership — Rust's Box<dyn Trait>. `Box<Shape>` owns a concrete Circle/Square
// behind the contract's fat pointer, dispatches area() virtually, and drops via the vtable. The library
// Box<T> is ONE type; the compiler routes the contract instance through the interface-owner path.
extern "<stdlib.h>";
extern fn void free(UnsafePtr p);

type contract Shape for value { fn int32 area(); }
type value Circle implements Shape { int32 r; public ctor make(int32 r) { this.r = r; } public fn int32 area() { return this.r * this.r; } }
type value Square implements Shape { int32 s; public ctor make(int32 s) { this.s = s; } public fn int32 area() { return this.s * this.s; } }

type resource Box<T> implements Deref<T>, DerefMut<T>, HeapOwner<T> {
    UnsafePtr<T> p;
    public unsafe ctor adopt(UnsafePtr<T> raw) { this.p = raw; return this; }
    public unsafe const fn const ref T deref() { return this.p[0]; }
    public unsafe fn ref T derefMut() { return this.p[0]; }
    unsafe ~Box() { free(p: cast<UnsafePtr>(this.p)); }
}

fn int32 main() {
    Box<Shape> a = new Circle.make(r: 5);   // 25
    Box<Shape> b = new Square.make(s: 4);   // 16 (heterogeneous — different concrete types, one Box<Shape>)
    return a.area() + b.area();        // 41 (virtual dispatch)
}
