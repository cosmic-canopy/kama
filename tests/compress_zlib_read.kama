    // a sync flush and a full flush inside
    if (check(stream: "789cca48cdc9c957c8402701000000ffff7c568b6ec3200cfc95fc9a97d0a65a9a4a2d537f7f056cb0cfa69ab6160c7e"
        + "9ccfc7f29e96239dd7bc2f5bba1c94d3f2cacf44f7259d9b7c25b46db757a6734dcb679994b978e323fcb13eb6e0d638"
        + "b6ff5d2e773a5d00e5b0fcea7575291bdd5012691689429f9f200b6aab9fe3b1fe8ebde2b8542cfec84530d9b313464e"
        + "6748babae396d3938eba2595d64cc7e93be5751f99ca29ed5e0ecbd1967a5b0578755fbe1bcdacb3d2a983af01815ce0"
        + "032dbe415e5cf97018c4356e62f72da981041fd3384b4046cdc02076a41b01b8f3f6074c8296955c69d084adcd2f6719"
        + "50932c133d318261e9534000d70c5c1c406d87024dda125008308a915ba5e80e2a944e9c95caa0f6d042ed1bd8af7b1e"
        + "43b276f078f37d3bb7c73b90b16f14b4d53b722270669e1469e41ce7a01aae6ed4d6b5ab7a42d4894609a55313369226"
        + "bcd8da8df63780cee89f57ae50c7a41c98a2a9ce04e3e8949b7d2285fde45972406c37652686d53a450528c8ee0e6846"
        + "932cb8c1dce02bc5beba3afae01356ba37171512d4989fe0080fb9c15a817315cf54ab508240b790e0d6930a41f0e646"
        + "e2ed2a6d50a312cf475f7d957c299a9a1a5c8fc54c0928ea6c276a2cfbae8afefed8f16e5c22ab2708f3176146ad41d8"
        + "e6e31abc1e326b5ed0359833985497a3ff2f84ee0c046753767468eae18309829e3b3183c7b3273cf456aaa578a0faea"
        + "1f0000ffffcb48cdc9c957c8402701f3800d36", len: 2863, crc: 4268997289ui32) != 0) { return 8; }
    // 6,000 bytes of 0xFF: Adler-32's two sums are taken modulo 65521 along the way
    if (check(stream: "78daedc13101000000c2a0fea967085fa0000000000080d700a49759ea", len: 6000, crc: 3078791141ui32) != 0) { return 9; }
    // Each `finish` leaves the source at the next stream. 64 bytes at a time and 4,096: the second is where the decoder takes
    // bytes ahead and must hand them back before the trailer is read.
    if (twoStreams(chunk: 64) != 0) { return 20; }
    if (twoStreams(chunk: 4096) != 0) { return 21; }
    if (stalled() != 0) { return 22; }

    // A read of nothing is not the end: before the header, and once every byte is delivered and the trailer is unread.
    FixedArray<uint8> none = FixedArray.make(size: 0);
    FixedArray<uint8> buf = FixedArray.make(size: 23);
    ZlibReader<SliceReader> quiet = over(stream: "789ccb48cdc9c957c8402701680308b1", limit: 1000000ui64);
    isize q0 = match (quiet.read(into: none.viewMut())) { case Ok(value: k): k; case Err(error: e): -1; };
    if (q0 != 0) { return 30; }
    isize q1 = match (quiet.read(into: buf.viewMut())) { case Ok(value: k): k; case Err(error: e): -1; };
    if (q1 != 23) { return 31; }
    isize q2 = match (quiet.read(into: none.viewMut())) { case Ok(value: k): k; case Err(error: e): -1; };
    if (q2 != 0) { return 32; }
    isize q3 = match (quiet.read(into: buf.viewMut())) { case Ok(value: k): k; case Err(error: e): -1; };
    if (q3 != 0) { return 33; }
    int32 qf = match (give quiet.finish()) { case Ok(value: b): 0; case Err(error: u): 1; };
    if (qf != 0) { return 34; }

    // `finish` before the checksum has been checked, here with nothing read, answers `InvalidInput`, and that reader reads on.
    bool cameBack = false;
    ZlibReader<SliceReader> early = over(stream: "789ccb48cdc9c957c8402701680308b1", limit: 1000000ui64);
    if (finishKind(z: give early, cameBack: ref cameBack) != 1) { return 40; }
    if (!cameBack) { return 41; }

    // `abandon` hands the source back wherever the stream has got to.
    ZlibReader<SliceReader> dropped = over(stream: "789ccb48cdc9c957c8402701680308b1", limit: 1000000ui64);
    FixedArray<uint8> two = FixedArray.make(size: 2);
    isize d0 = match (dropped.read(into: two.viewMut())) { case Ok(value: k): k; case Err(error: e): -1; };
    if (d0 != 2) { return 43; }
    BufReader<SliceReader> left = give dropped.abandon();

    // `limit`: the whole stream at exactly its size, and with one less every byte up to it and then `LimitExceeded`.
    ZlibReader<SliceReader> whole = over(stream: "789ccb48cdc9c957c8402701680308b1", limit: 23ui64);
    if (drain(d: ref whole, len: 23, crc: 2369606115ui32, chunk: 7) != 0) { return 50; }
