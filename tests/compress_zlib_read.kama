    isize cutTotal = 0;
    int32 cutKind = 0;
    while (cutKind == 0) {
        isize n = match (cut.read(into: buf.viewMut())) { case Ok(value: k): k; case Err(error: e): { cutKind = kindOf(e: e); := 0; } };
        if (n == 0 && cutKind == 0) { return 51; }
        cutTotal = cutTotal + n;
    }
    if (cutTotal != 22 || cutKind != 4) { return 52; }
    return 42;
}
