        + "d3f2cacf44f7259d9b7c25b46db757a6734dcb67999439effd087fac8f2db8358eed7f97cb9d4e1740392cbf7a5d5dca"
        + "463794449a45a2d0e727c882daeae778acbf63af382e158b3f72114cf6ec8491d31992aeeeb8e5f4a4a36e49a535d371"
        + "fa4e79dd47a6724abb97c372b4a5de56015edd97ef4633ebac74eae06b402017f8408b6f9017573e1c06718d9bd87d4b"
        + "6a20c1c734ce1290513330881de94600eebcfd0193a06525571a34616bf3cb5906d424cb444f8c6058fa1410c0350317"
        + "0750dba14093b60414028c62e45629ba830aa51367a532a83db450fb06f6eb9ec790ac1d3cde7cdfceedf10e64ec1b05"
        + "6df58e9c089c9927451a39c739a886ab1bb575edaa9e1075a25142e9d4848da4092fb676a3fd0da033fae7952bd43129"
        + "07a668aa33c1383ae5669f48613f79961c10db4d998961b54e51010ab2bb039ad1240b6e3037f84ab1afae8e3ef88495"
        + "eecd45850435e62738c2436eb056e05cc533d52a9420d02d24b8f5a44210bcb99178bb4a1bd4a8c4f3d1575f255f8aa6"
        + "a606d7633153028a3adb891acbbeaba2bf3f76bc1b97c8ea09c2fc4598516b10b6f9b806af87cc9a17740de60c26d5e5"
        + "e8ff0ba13b03c1d9941d1d9a7af86082a0e74ecce0f1ec090fbd956a291ea8befa071d37fbc7", len: 2817, crc: 2695899570ui32) != 0) { return 4; }
    // level 9, header 78 DA
    if (check(stream: "78da7d568b6ec3200cfc95fc9a97d0a65a9a4a2d537f7f056cb0cfa69ab6160c7e9ccfc7f29e96239dd7bc2f5bba1c94"
        + "d3f2cacf44f7259d9b7c25b46db757a6734dcb67999439effd087fac8f2db8358eed7f97cb9d4e1740392cbf7a5d5dca"
        + "463794449a45a2d0e727c882daeae778acbf63af382e158b3f72114cf6ec8491d31992aeeeb8e5f4a4a36e49a535d371"
        + "fa4e79dd47a6724abb97c372b4a5de56015edd97ef4633ebac74eae06b402017f8408b6f9017573e1c06718d9bd87d4b"
        + "6a20c1c734ce1290513330881de94600eebcfd0193a06525571a34616bf3cb5906d424cb444f8c6058fa1410c0350317"
        + "0750dba14093b60414028c62e45629ba830aa51367a532a83db450fb06f6eb9ec790ac1d3cde7cdfceedf10e64ec1b05"
        + "6df58e9c089c9927451a39c739a886ab1bb575edaa9e1075a25142e9d4848da4092fb676a3fd0da033fae7952bd43129"
        + "07a668aa33c1383ae5669f48610a9440bb83d86eca4c0cab758a0a5090dd1dd08c26597083b9c1578a7d7575f4c127ac"
        + "746f2e2a24a8313fc1111e7283b502e72a9ea956a104816e21c1ad27d2936fdfdc48bc5da50d6a54e2f9e8abaf922f45"
        + "535383ebb1982901459ded448d65df55d1df1f3bde8d4b64f50461fe22cca83508db7c5c83d74366cd0bba06730693ea"
        + "72f4ff85d09d81e06cca8e0e4d3d7c3041d0732766f078f68487de4ab5140f545ffd031d37fbc7", len: 2817, crc: 2695899570ui32) != 0) { return 5; }
    // the empty stream, whose checksum is 1
    if (check(stream: "789c030000000001", len: 0, crc: 0ui32) != 0) { return 6; }
    // a header declaring a 512-byte window
