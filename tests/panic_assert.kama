// A passing `assert`/`debugAssert` is a no-op; a `panic` behind an untaken guard doesn't fire. (An
// actually-firing trap writes to stderr + aborts — not asserted here, to keep the fixture ASan-clean.)
// `msg:` is mandatory (empty allowed); `debugAssert` is the `--release`-stripped variant.
fn int32 main() {
    int32 x = 42;
    assert(cond: x == 42, msg: "");
    assert(cond: x > 0, msg: "x sanity");
    debugAssert(cond: x == 42, msg: "");
    if (x < 0) { panic(msg: "impossible"); }
    return x;   // 42
}
