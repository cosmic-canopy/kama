import std::collections::{DynamicArray};
// M27 — a generic RESOURCE whose destructibility comes from an OWNING FIELD, not an explicit ~dtor:
// `type resource Wrap<T>` holds a `DynamicArray<T>`, so each `Wrap<int32>` is move-only and gets a SYNTHESIZED
// dtor that drops the list. Exercises computeDestructible under type substitution (the T-field's
// destructibility must be seen through the subst), plus move-into-a-param + param-drop. ASan proves
// the buffer is freed exactly once (the moved-from `a` is suppressed; only the callee's `w` drops).
// (A `type value Wrap<T>` here is correctly rejected — a value can't own a resource; see the xfail.)
type resource Wrap<T> {
    DynamicArray<T> items;
    public ctor make(T a, T b) { Wrap<T> r; r.items.add(item: a); r.items.add(item: b); return give r; }
    public fn T first() { return this.items[0]; }
    public fn int32 size() { return this.items.length(); }
}
fn int32 total(Wrap<int32> w) { return w.first() + w.size(); }   // moved-in w drops at fn-end
fn int32 main() {
    Wrap<int32> a = Wrap.make(a: 40, b: 99);
    return total(w: give a);   // 40 + 2 = 42; the moved-in Wrap's list freed exactly once
}
