// Element-dtor chaining: an Array<Probe> of destructible elements must run
// Probe's destructor on every live element when the array leaves scope (RAII),
// then free the buffer. Each element dtor traces a constant code; the trace
// fold proves exactly `size` dtor calls fired.
extern void cstar_trace(int code);
extern int cstar_trace_get();

class Probe
{
    int id;
    ~Probe() { cstar_trace(code: 5); }
}

int build()
{
    Array<Probe> a = new Array<Probe>(size: 3);
    return 0;   // `a` drops here -> Array_Probe__dtor -> 3x Probe__dtor
}

int main()
{
    int r = build();
    return cstar_trace_get();
}
