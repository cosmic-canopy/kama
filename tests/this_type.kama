// M27c-2 — the `This` self-type. In a `type contract` the self-type is declared as a PINNED type
// parameter (`<T is This>`) and written `T`, because a contract value erases the self-type and a slot
// has to give it one concrete type. Used as a BOUND, `a.equals(b)` monomorphizes to a STATIC
// `Point__equals(&a, b)`. Inside a type's OWN body `This` stays legal and means that type — nothing is
// erased there — so `Point` still writes `equals(This other)` and returns `This` from `clone()`.
type contract Equatable<T is This> for value { fn bool equals(T other); }
type value Point implements Equatable<This> {
    int32 x;
    public ctor make(int32 x) { this.x = x; }
    public fn bool equals(This other) { return this.x == other.x; }   // This -> Point
    public fn This clone() { This c = Point.make(x: this.x); return c; }   // self-returning (This local + return)
}
fn bool same<T: Equatable<T>>(T a, T b) { return a.equals(other: b); }  // static dispatch via the bound
fn int32 main() {
    Point p = Point.make(x: 7);
    Point q = p.clone();          // This -> Point: q == Point(7)
    Point r = Point.make(x: 9);
    int32 s = 0;
    if (same(a: p, b: q)) { s = s + 40; }    // 7 == 7 -> +40
    if (same(a: p, b: r)) { s = s + 100; }   // 7 == 9 -> no
    return s + 2;                            // 40 + 2 = 42
}
