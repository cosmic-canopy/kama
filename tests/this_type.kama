// M27c-2 — the `This` self-type. In a `type contract`, `This` is the implementing type: `Equatable`
// declares `equals(This other)`. Used as a BOUND, `a.equals(b)` monomorphizes to a STATIC
// `Point__equals(&a, b)` (the concrete method's `This` param resolved to `Point`). A class may also
// return `This` (`fn This clone()`), resolving to itself.
type contract Equatable for both { fn bool equals(This other); }
type value Point implements Equatable {
    int32 x;
    public ctor make(int32 x) { slot Point r; r.x = x; return give r; }
    public fn bool equals(This other) { return this.x == other.x; }   // This -> Point
    public fn This clone() { This c = Point.make(x: this.x); return c; }   // self-returning (This local + return)
}
fn bool same<T: Equatable>(T a, T b) { return a.equals(other: b); }  // static dispatch via the bound
fn int32 main() {
    Point p = Point.make(x: 7);
    Point q = p.clone();          // This -> Point: q == Point(7)
    Point r = Point.make(x: 9);
    int32 s = 0;
    if (same(a: p, b: q)) { s = s + 40; }    // 7 == 7 -> +40
    if (same(a: p, b: r)) { s = s + 100; }   // 7 == 9 -> no
    return s + 2;                            // 40 + 2 = 42
}
