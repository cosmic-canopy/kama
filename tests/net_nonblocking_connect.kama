// std::net non-blocking connect — connectNonBlocking returns a stream whose connect may still be IN FLIGHT.
// The outcome is read by checkConnected() (SO_ERROR), which is only meaningful ONCE the socket reports ready
// (writable on success, except/error on failure) — so we poll until it resolves, THEN check. On loopback:
// connecting to a listening port resolves writable+connected (Ok); connecting to a dead port resolves with
// ConnectionRefused — synchronously from connectNonBlocking on Linux, or after the poll on macOS/Windows
// where the connect is async. Returns 55.
//
// The poll must LOOP with a generous deadline, not read SO_ERROR after a single short timeout: a Windows
// loopback connect to an unbound port is refused only after ~1-5s (Linux/macOS refuse in microseconds), so
// a one-shot 1s poll would time out while the handshake is still pending and mis-read SO_ERROR 0 as
// "connected". Linux/macOS resolve on the first wait, so they return at once.
import std::net::{TcpListener, TcpStream, Poller, Interest, Ready};
import std::io::{IoError};

fn bool okUnit(Result<Unit, IoError> r) { return match (r) { case Ok(value: u): true; case Err(error: e): false; }; }
fn bool isRefused(IoError e) { return match (e) { case ConnectionRefused: true; case _: false; }; }

// Block until a non-blocking connect RESOLVES (the socket reports ready), then read its outcome. Polls in
// short slices up to a generous overall deadline; stops as soon as the poller reports readiness (writable on
// success, or except/error on failure), then reads checkConnected(). A bare timeout is NOT "connected" —
// SO_ERROR is 0 while the handshake is still in flight.
fn Result<Unit, IoError> resolve(ref TcpStream s) {
    match (Poller.create()) {
        case Ok(value: p): {
            p.add(fd: s.rawHandle(), interest: Interest::Write);
            int32 tries = 0;
            bool ready = false;
            while ((tries < 24) && !ready) {                       // up to ~12s (24 * 500ms)
                Result<int32, IoError> w = p.wait(timeoutMs: 500);
                int32 n = match (w) { case Ok(value: k): k; case Err(error: e): 0 - 1; };
                if (n != 0) { ready = true; }                      // >0 resolved / <0 error — stop; 0 = keep waiting
                tries += 1;
            }
        }
        case Err(error: e): { }
    };
    return s.checkConnected();
}

// Connect (non-blocking) to a listening port and resolve it. Returns 0 on success.
fn int32 connectListening(uint16 port) {
    string host = "127.0.0.1";
    Result<TcpStream, IoError> r = TcpStream.connectNonBlocking(host: host, port: port);
    return match (r) {
        case Ok(value: s):  (okUnit(r: resolve(s: s)) ? 0 : 1);
        case Err(error: e): 2;
    };
}

// Connect (non-blocking) to a port with nothing listening; expect ConnectionRefused. Returns 0 when refused.
fn int32 connectDead(uint16 port) {
    string host = "127.0.0.1";
    Result<TcpStream, IoError> r = TcpStream.connectNonBlocking(host: host, port: port);
    int32 rc = -1;
    match (r) {
        case Ok(value: s): {                                  // in flight — poll until resolved, then SO_ERROR
            Result<Unit, IoError> cc = resolve(s: s);
            match (cc) { case Ok(value: u): { rc = 3; } case Err(error: e): { rc = isRefused(e: e) ? 0 : 4; } };
        }
        case Err(error: e): { rc = isRefused(e: e) ? 0 : 5; }   // synchronous refusal (Linux loopback)
    };
    return rc;
}

fn int main() {
    string host = "127.0.0.1";
    uint16 live = cast<uint16>(47662);
    uint16 dead = cast<uint16>(47669);                 // nothing bound here
    Result<TcpListener, IoError> rl = TcpListener.bind(host: host, port: live);
    return match (rl) {
        case Ok(value: l): {
            int32 a = connectListening(port: live);
            int32 b = connectDead(port: dead);
            := ((a == 0) && (b == 0)) ? 55 : (90 + a * 4 + b);
        }
        case Err(error: e): 80;
    };
}
