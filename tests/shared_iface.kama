import { std::collections::DynamicArray, std::memory::Shared, std::memory::Weak };
// M26g-2 / M28d — `Shared<Shape>` / `Weak<Shape>`: ref-counted owning smart pointers over an
// INTERFACE. A `Weak<I>` observes without keeping alive and `tryUpgrade()`s to `Optional<Shared<I>>`
// (Some while the object lives, None after it dies). Polymorphic dispatch through the fat handle.
type contract Shape for resource { fn int32 area(); }
type resource Sq implements Shape {
    DynamicArray<int32> side;                                       // owns heap -> destructible impl
    public ctor make(int32 s) { this.side.add(item: s); }
    public fn int32 area() { return this.side[0] * this.side[0]; }
}
fn Weak<Shape> orphan() {                                  // returns an already-expired weak
    Shared<Shape> s = new Sq.make(s: 5);
    Weak<Shape> w = s;
    return give w;                                          // s dies at fn-end
}
fn int32 main() {
    Shared<Shape> a = new Sq.make(s: 6);                        // area 36
    Shared<Shape> b = a;                                   // retain: a and b share one Sq
    Weak<Shape> live = a;                                  // weak to the live Sq
    Optional<Shared<Shape>> lu = live.tryUpgrade();        // Some while a/b alive
    int32 luv = match (lu) { case Some(value: u): u.area(); case None: 0; };   // 36
    int32 sum = a.area() + b.area() + luv;                  // 36 + 36 + 36 = 108

    Weak<Shape> dead = orphan();                           // its Shared already died
    Optional<Shared<Shape>> du = dead.tryUpgrade();        // None (expired)
    int32 duv = match (du) { case Some(value: d): 0; case None: 1; };   // 1
    return sum + duv;                                       // 109; each Sq freed exactly once
}
