// The stdlib shape: a heap-owning `resource` over a raw `UnsafePtr` buffer defines a place-returning
// `operator[]` (bounds are the author's responsibility inside `unsafe`), with RAII freeing the buffer.
// This is what lets a `Vec`-like collection be written IN kama.
extern "<stdlib.h>";
// `malloc`/`free` are declared with their TRUE C signatures (`void*`), not pre-typed to the pointee this
// fixture wants: one C symbol has one signature program-wide, so narrowing it here would re-type it for
// every other declaration of it — including the prelude's, which `GlobalAllocator` calls. Casting at the
// use site is the stdlib's own idiom (lib/std/collections/allocator.kama).
extern fn UnsafePtr malloc(usize n);
extern fn void free(UnsafePtr p);

type resource IntVec {
    UnsafePtr<int32> data;
    int32 len;
    public unsafe ctor make(int32 n) {
        this.data = cast<UnsafePtr<int32>>(malloc(n: cast<usize>(n) * 4));
        this.len = n;
        int32 i = 0; while (i < n) { this.data[i] = 0; i = i + 1; }
    }
    public unsafe ref int32 operator[](int32 i) { return this.data[i]; }
    public fn int32 length() { return this.len; }
    unsafe ~IntVec() { free(p: cast<UnsafePtr>(this.data)); }
}
fn int32 main() {
    IntVec v = IntVec.make(n: 4);
    v[0] = 100;
    v[1] = 20;
    v[2] += 3;
    int32 s = 0;
    int32 i = 0;
    while (i < v.length()) { s = s + v[i]; i = i + 1; }   // 100 + 20 + 3 + 0
    return s;              // 123 — buffer freed by RAII (ASan-clean)
}
