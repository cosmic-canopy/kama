// The stdlib shape: a heap-owning `resource` over a raw `Ptr` buffer defines a place-returning
// `operator[]` (bounds are the author's responsibility inside `unsafe`), with RAII freeing the buffer.
// This is what lets a `Vec`-like collection be written IN kama.
extern "<stdlib.h>";
extern fn Ptr<int32> malloc(usize n);
extern fn void free(Ptr<int32> p);

type resource IntVec {
    Ptr<int32> data;
    int32 len;
    public IntVec(int32 n) {
        this.data = malloc(n: cast<usize>(n) * 4);
        this.len = n;
        unsafe { int32 i = 0; while (i < n) { this.data[i] = 0; i = i + 1; } }
    }
    public ref int32 operator[](int32 i) { unsafe { return this.data[i]; } }
    public fn int32 length() { return this.len; }
    ~IntVec() { free(p: this.data); }
}
fn int32 main() {
    IntVec v = IntVec(n: 4);
    v[0] = 100;
    v[1] = 20;
    v[2] += 3;
    int32 s = 0;
    int32 i = 0;
    while (i < v.length()) { s = s + v[i]; i = i + 1; }   // 100 + 20 + 3 + 0
    return s;              // 123 — buffer freed by RAII (ASan-clean)
}
