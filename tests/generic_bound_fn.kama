// M27c-1 — a contract BOUND on a generic FUNCTION: `<T: Weighable>` lets the body call the contract
// method `weight()` on a type-param value. Monomorphization emits a STATIC `Rock__weight(&a)` (zero
// cost, no vtable). Enforcement: the concrete `Rock` must satisfy `Weighable`.
type contract Weighable for both { fn int32 weight(); }
type value Rock implements Weighable {
    int32 g;
    public ctor make(int32 g) { slot Rock r; r.g = g; return give r; }
    public fn int32 weight() { return this.g; }
}
fn T heavier<T: Weighable>(T a, T b) {
    return a.weight() >= b.weight() ? a : b;
}
fn int32 main() {
    Rock a = Rock.make(g: 20);
    Rock b = Rock.make(g: 17);
    Rock h = heavier(a: a, b: b);   // the heavier Rock (g = 20)
    return h.weight();              // 20
}
