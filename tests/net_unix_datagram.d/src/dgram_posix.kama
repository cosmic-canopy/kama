file @compileFor(!OS_WINDOWS);
// Datagrams where they exist. A bound socket receives from an unbound one (whose name reads back unnamed) and
// from a bound one (whose path reads back); a connected pair sends and receives without addresses; a second
// bind of a live path is `AddrInUse`; and each bound socket removes its file when it drops.
//
// And it is a `DatagramSocket<UnixAddr>` (KR-108): `emit` below is ONE generic path that sends through a Unix
// datagram socket and through a UDP socket alike — a syslog client's `/dev/log` or UDP 514 by configuration —
// and `count` reaches one through a contract value. An empty buffer is `InvalidInput` from `recvFrom`, as UDP's.
import {
    std::net::UnixDatagram, std::net::UnixAddr, std::net::RecvFrom, std::net::DatagramSocket,
    std::net::UdpSocket, std::net::SocketAddr,
    std::io::IoError, std::io::IoErrorKind, std::collections::FixedArray, std::collections::ConstView,
    std::collections::View, std::fs::exists,
};
export { datagrams };

fn usize emit<S: DatagramSocket<A>, A>(ref S s, ConstView<uint8> line, const ref A to) {
    return match (s.sendTo(bytes: line, to: to)) { case Ok(value: n): n; case Err(error: e): 0; };
}

fn usize count(DatagramSocket<UnixAddr> d, View<uint8> into) {
    return match (d.recvFrom(into: into)) { case Ok(value: r): r.count; case Err(error: e): 0; };
}

fn bool emptyIsInvalid<S: DatagramSocket<A>, A>(ref S s) {
    FixedArray<uint8> none = FixedArray.make(size: 0);
    return match (s.recvFrom(into: none.viewMut())) {
        case Err(error: e): match (e.kind()) { case InvalidInput: true; case _: false; };
        case Ok(value: r): false;
    };
}

fn int32 datagrams() {
    {
        Result<UnixDatagram, IoError> rs = UnixDatagram.bind(path: "server.sock");
        UnixDatagram server = match (give rs) { case Ok(value: x): give x; case Err(error: e): { return 11; } };
        Result<UnixDatagram, IoError> ru = UnixDatagram.unbound();
        UnixDatagram anon = match (give ru) { case Ok(value: x): give x; case Err(error: e): { return 12; } };
        UnixAddr to = match (UnixAddr.fromPath(path: "server.sock")) { case Ok(value: a): a; case Err(error: e): { return 13; } };
        FixedArray<uint8> msg = FixedArray.filled(size: 4, value: 5ui8);
        usize sent = match (anon.sendTo(bytes: msg.view(), to: to)) { case Ok(value: n): n; case Err(error: e): 0; };
        if (sent != 4) { return 14; }
        FixedArray<uint8> buf = FixedArray.make(size: 16);
        Result<RecvFrom<UnixAddr>, IoError> rr = server.recvFrom(into: buf.viewMut());
        RecvFrom<UnixAddr> got = match (rr) { case Ok(value: x): x; case Err(error: e): { return 15; } };
        if (got.count != 4 || buf[3] != 5ui8) { return 16; }
        if (!got.from.isUnnamed()) { return 17; }                 // the sender never bound a name
        // A bound sender is named by its path, and a connected pair needs no addresses.
        Result<UnixDatagram, IoError> rc = UnixDatagram.bind(path: "client.sock");
        UnixDatagram client = match (give rc) { case Ok(value: x): give x; case Err(error: e): { return 18; } };
        if (match (client.connectTo(address: to)) { case Ok(value: u): false; case Err(error: e): true; }) { return 19; }
        if (match (client.send(bytes: msg.view())) { case Ok(value: n): n != 4; case Err(error: e): true; }) { return 20; }
        Result<RecvFrom<UnixAddr>, IoError> rb = server.recvFrom(into: buf.viewMut());
        bool fromClient = match (rb) {
            case Ok(value: x): match (x.from.path()) { case Some(value: p): p == "client.sock"; case None: false; };
            case Err(error: e): false;
        };
        if (!fromClient) { return 21; }
        bool inUse = match (UnixDatagram.bind(path: "server.sock")) {
            case Err(error: e): match (e.kind()) { case AddrInUse: true; case _: false; };
            case Ok(value: x): false;
        };
        if (!inUse) { return 22; }
        // One generic path over both kinds of datagram socket, and a contract value of the Unix one.
        if (emit(s: ref anon, line: msg.view(), to: to) != 4) { return 24; }
        if (count(d: server, into: buf.viewMut()) != 4) { return 25; }
        Result<UdpSocket, IoError> ra = UdpSocket.bind(host: "127.0.0.1", port: 0ui16);
        UdpSocket ua = match (give ra) { case Ok(value: x): give x; case Err(error: e): { return 26; } };
        Result<UdpSocket, IoError> rb2 = UdpSocket.bind(host: "127.0.0.1", port: 0ui16);
        UdpSocket ub = match (give rb2) { case Ok(value: x): give x; case Err(error: e): { return 27; } };
        SocketAddr ubAddr = match (ub.localAddr()) { case Ok(value: a): a; case Err(error: e): { return 28; } };
        if (emit(s: ref ua, line: msg.view(), to: ubAddr) != 4) { return 29; }
        if (!emptyIsInvalid(s: ref server) || !emptyIsInvalid(s: ref ub)) { return 30; }
    }   // both bound sockets drop here, and their files with them
    if (exists(path: "server.sock") || exists(path: "client.sock")) { return 23; }
    return 0;
}
