// std::fs's Watcher (KR-330): a file made, written and removed in a watched directory each arrive as their event; a
// deadline with nothing changing is `Failed(TimedOut)`, after the time and not before; and after `unwatch` nothing more
// of the root is handed out. Each wait is bounded by a deadline, so a lost event fails rather than hangs. What one change
// arrives as differs by OS (a write can be one event or several), so each check waits for ITS event and skips the rest.
import { std::fs::Watcher, std::fs::WatchEvent, std::fs::WatchError, std::fs::TempDir, std::fs::writeText, std::fs::remove,
         std::io::IoError, std::io::IoErrorKind, std::path::join, std::time::monotonicNow, std::time::Duration,
         std::time::Instant };

fn string describe(const ref WatchEvent e) {
    return match (e) {
        case Created(root: _, path: p, directory: _): "created " + p;
        case Modified(root: _, path: p, directory: _): "modified " + p;
        case Removed(root: _, path: p, directory: _): "removed " + p;
        case Renamed(root: _, from: f, to: t, directory: _): "renamed " + f + " " + t;
        case Rescan(root: _): "rescan";
        case RootGone(root: _): "gone";
    };
}

// Does `wanted` arrive within five seconds? Every other event is skipped.
unsafe fn bool arrives(ref Watcher w, const ref string wanted) {
    w.setReadDeadline(at: Optional::Some(value: monotonicNow() + Duration.fromMillis(ms: 5000)));
    while (true) {
        match (w.next()) {
            case Ok(value: e): { if (describe(e: e) == wanted) { return true; } }
            case Err(error: e): { return false; }
        };
    }
}

fn uint8 main() {
    TempDir t = match (TempDir.make(prefix: "kama-watch-")) { case Ok(value: d): give d; case Err(error: e): panic(msg: "TempDir.make failed"); };
    string root = t.path();
    Watcher w = match (Watcher.open()) { case Ok(value: x): give x; case Err(error: e): panic(msg: "Watcher.open failed"); };
    match (w.watch(path: root, recursive: false)) { case Ok(value: u): { } case Err(error: e): { return 1; } };

    string f = join(path: root, with: "a.txt");
    match (writeText(path: f, text: "one")) { case Ok(value: n): { } case Err(error: e): { return 2; } };
    if (!arrives(w: ref w, wanted: "created a.txt")) { return 3; }
    match (writeText(path: f, text: "two, longer")) { case Ok(value: n): { } case Err(error: e): { return 4; } };
    if (!arrives(w: ref w, wanted: "modified a.txt")) { return 5; }
    match (remove(path: f)) { case Ok(value: u): { } case Err(error: e): { return 6; } };
    if (!arrives(w: ref w, wanted: "removed a.txt")) { return 7; }

    // Nothing changes: the deadline, and not before it.
    w.setReadDeadline(at: Optional::Some(value: monotonicNow() + Duration.fromMillis(ms: 200)));
    Instant start = monotonicNow();
    bool timedOut = match (w.next()) {
        case Ok(value: e): false;
        case Err(error: e): match (e) { case Failed(error: io): match (io.kind()) { case TimedOut: true; case _: false; }; case _: false; };
    };
    if (!timedOut) { return 8; }
    if (start.elapsed().asMillis() < 200) { return 9; }

    // A watch on what is watched already is refused; unwatch ends the root, and a second unwatch has nothing to end.
    bool again = match (w.watch(path: root, recursive: false)) { case Ok(value: u): false; case Err(error: e): true; };
    if (!again) { return 10; }
    match (w.unwatch(path: root)) { case Ok(value: u): { } case Err(error: e): { return 11; } };
    bool twice = match (w.unwatch(path: root)) { case Ok(value: u): false; case Err(error: e): true; };
    if (!twice) { return 12; }
    match (writeText(path: f, text: "unwatched")) { case Ok(value: n): { } case Err(error: e): { return 13; } };
    w.setReadDeadline(at: Optional::Some(value: monotonicNow() + Duration.fromMillis(ms: 300)));
    bool quiet = match (w.next()) { case Ok(value: e): false; case Err(error: e): true; };
    if (!quiet) { return 14; }
    return 0;
}
