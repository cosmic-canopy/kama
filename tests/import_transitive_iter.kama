// Session E (hardening) work item 2 — importing `BitSet` ALONE is enough to iterate it: the
// concrete iterator type (`BitSetIter`) is never named at the use site, so it needs no separate import.
// The return type resolves in its DECLARING module (std::collections) via the method signature, not the
// caller's import scope. (Explicitly naming the iterator type still requires the import — see the xfail.)
import std::collections::{BitSet};
fn int32 main() {
    BitSet bs = BitSet.empty();
    bs.set(index: 3); bs.set(index: 7);
    isize sum = 0;                                 // a sum of bit INDICES, which the iterator yields as `isize`
    foreach (isize i in bs) { sum = sum + i; }
    return cast<int32>(sum);   // 3 + 7 = 10
}
