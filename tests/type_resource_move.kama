import std::collections::{List};
// M26h — a `type resource` value is move-only (declared, not inferred from destructibility): a bare
// hand-off moves and the source is consumed. Here `give` moves it into the callee, which drops it
// once (ASan-clean). An empty resource would be move-only too, by identity.
type resource Box {
    List<int32> sides;
    public Box(int32 v) { this.sides.add(item: v); }
    public fn int32 head() { return this.sides[0]; }
}
fn int32 take(Box b) { return b.head(); }      // b owned by the callee, dropped at fn-end
fn int32 main() {
    Box a = Box(v: 42);
    return take(b: give a);                     // move a into the callee; freed exactly once
}
