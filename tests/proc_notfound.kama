// std::process — spawning a nonexistent program is handled gracefully. The failure manifests differently by
// platform (a documented divergence): on POSIX the child's execvp fails post-fork so it _exit(127)s (the
// shell "command not found" convention) and run() returns Ok with empty output + code 127; on Windows
// CreateProcess fails in the PARENT (no fork), so start()/run() return Err. Both are accepted as success.
import { std::process::Command, std::process::Output, std::io::IoError, std::process::ExitStatus };

// The exit code, or -1 when the child did not exit (a signal): `ExitStatus` is a per-platform enum (`uint8` code on
// POSIX, `uint32` on Windows), read with `match` — widened here so one comparison serves both.
fn int64 codeOf(ExitStatus s) { return match (s) { case Exited(code: c): cast<int64>(c); case _: -1; }; }

fn int32 main() {
    Command c = Command.make(program: "this_binary_does_not_exist_xyzzy");
    Result<Output, IoError> r = c.run();
    return match (give r) {
        case Ok(value: o): (codeOf(s: o.status()) == 127 ? 42 : 130);   // POSIX: 127 convention
        case Err(error: e): 42;                                    // Windows: CreateProcess failed in-parent
    };
}
