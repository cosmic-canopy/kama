// M26g-2 — `Shared<IShape>` / `Weak<IShape>`: ref-counted owning smart pointers over an INTERFACE.
// Retain shares one concrete object (freed once, by the last strong handle, via the vtable's
// `__dtor`); a `Weak<I>` observes without keeping alive and `upgrade()`s to a live `Shared<I>` or an
// empty one after the object dies. Polymorphic dispatch through the fat handle. ASan-clean.
interface IShape { fn int32 area(); }
class Sq implements IShape {
    List<int32> side;                                       // owns heap -> destructible impl
    public Sq(int32 s) { this.side.add(item: s); }
    public fn int32 area() { return this.side[0] * this.side[0]; }
}
fn Weak<IShape> orphan() {                                  // returns an already-expired weak
    Shared<IShape> s = new Sq(s: 5);
    Weak<IShape> w = s;
    return give w;                                          // s dies at fn-end
}
fn int32 main() {
    Shared<IShape> a = new Sq(s: 6);                        // area 36
    Shared<IShape> b = a;                                   // retain: a and b share one Sq
    Weak<IShape> live = a;                                  // weak to the live Sq
    Shared<IShape> u = live.upgrade();                      // valid while a/b alive
    int32 sum = a.area() + b.area();                        // 36 + 36 = 72
    if (u.valid()) { sum = sum + u.area(); }                // + 36 = 108

    Weak<IShape> dead = orphan();                           // its Shared already died
    Shared<IShape> d = dead.upgrade();                      // empty (expired)
    if (dead.expired()) { sum = sum + 1; }                  // 109
    return sum;                                             // 109; each Sq freed exactly once
}
