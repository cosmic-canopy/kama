// M26g-2 / M28d — `Shared<IShape>` / `Weak<IShape>`: ref-counted owning smart pointers over an
// INTERFACE. A `Weak<I>` observes without keeping alive and `tryUpgrade()`s to `Optional<Shared<I>>`
// (Some while the object lives, None after it dies). Polymorphic dispatch through the fat handle.
type contract IShape { fn int32 area(); }
type resource Sq implements IShape {
    List<int32> side;                                       // owns heap -> destructible impl
    public Sq(int32 s) { this.side.add(item: s); }
    public fn int32 area() { return this.side[0] * this.side[0]; }
}
fn Weak<IShape> orphan() {                                  // returns an already-expired weak
    Shared<IShape> s = new Sq(s: 5);
    Weak<IShape> w = s;
    return give w;                                          // s dies at fn-end
}
fn int32 main() {
    Shared<IShape> a = new Sq(s: 6);                        // area 36
    Shared<IShape> b = a;                                   // retain: a and b share one Sq
    Weak<IShape> live = a;                                  // weak to the live Sq
    Optional<Shared<IShape>> lu = live.tryUpgrade();        // Some while a/b alive
    int32 luv = match (lu) { case Some(u): u.area(); case None: 0; };   // 36
    int32 sum = a.area() + b.area() + luv;                  // 36 + 36 + 36 = 108

    Weak<IShape> dead = orphan();                           // its Shared already died
    Optional<Shared<IShape>> du = dead.tryUpgrade();        // None (expired)
    int32 duv = match (du) { case Some(d): 0; case None: 1; };   // 1
    return sum + duv;                                       // 109; each Sq freed exactly once
}
