// `try new` — the non-panic construction entry (M-step5). Success path yields Some(owned box).
type resource Box {
    int32 v;
    public ctor make(int32 v) { this.v = v; }
    public fn int32 get() { return this.v; }
}

fn int32 main() {
    Optional<Owned<Box>> b = try new Box.make(v: 7);
    return match (b) { case Some(value: x): x.get(); case None: 0 - 1; };
}
