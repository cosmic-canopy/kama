import { std::memory::Owned, std::memory::Shared };

// `Allocator.deallocate(pointer, bytes, align)` promises the layout the block was ALLOCATED with. A size-class pool
// or a header-free MCU pool trusts it, so a wrong `bytes` is memory corruption, not a missed optimization. This
// allocator stores each block's size and alignment in a header and counts every `deallocate` that disagrees.
//
// Every box below once got it wrong (measured at 0.9.359): a base handle holding a derived object handed back
// `sizeof(Base)` (`Owned`, `Shared`, and the contract upcast's `objsize`), and a `BindableFunctionPtr` bound
// from a custom-allocator box released the block with libc `free` — a crash, since `Check` hands out an
// interior pointer. The size now comes from the object itself (`sizeof(ptr:)`, a vtable slot for a class with
// virtuals), and a bindable releases through the handle it was bound from.
//
// Exit: the number of frees when every size matched (10), else 100 + mismatches.

static int32 mismatches = 0;
static int32 frees = 0;

type value Check implements Allocator {
    int32 unused = 0;
    public default ctor make() { return this; }
    // The header is two words (16 bytes on a 64-bit target) and the block starts right after it, aligned by
    // aligning the whole allocation: every alignment this fixture asks for is at most 16.
    public unsafe fn Optional<UnsafePtr> allocate(usize bytes, usize align) {
        GlobalAllocator g = GlobalAllocator.make();
        match (g.allocate(bytes: bytes + 2 * sizeof(usize), align: 16)) {
            case Some(value: p): {
                UnsafePtr<usize> h = cast<UnsafePtr<usize>>(p);
                h[0] = bytes; h[1] = align;
                return Optional::Some(value: cast<UnsafePtr>(addr(of: h[2])));
            }
            case None: { return Optional::None; }
        };
    }
    public unsafe fn void deallocate(UnsafePtr pointer, usize bytes, usize align) {
        UnsafePtr<usize> h = cast<UnsafePtr<usize>>(pointer);
        UnsafePtr<usize> hdr = cast<UnsafePtr<usize>>(addr(of: h[-2]));
        frees = frees + 1;
        if (hdr[0] != bytes || hdr[1] != align) { mismatches = mismatches + 1; }
        GlobalAllocator g = GlobalAllocator.make();
        g.deallocate(pointer: cast<UnsafePtr>(hdr), bytes: bytes + 2 * sizeof(usize), align: 16);
    }
}

type contract Area for resource { fn int32 area(); }

type virtual(maxDepth: 1) resource Base implements Area {
    int32 a;
    public ctor make(int32 a) { this.a = a; }
    public fn int32 area() { return this.extra(); }
    protected virtual fn int32 extra() { return this.a; }
}
type final resource Derived extends Base {
    int64 x1; int64 x2; int64 x3;               // make Derived measurably bigger than Base
    public ctor make(int32 a) { this.base = Base.make(a: a); this.x1 = 1; this.x2 = 2; this.x3 = 3; }
    protected override fn int32 extra() { return cast<int32>(this.x3); }
}

fnptr int32 Get(int32 d);
type final resource Plain {
    int32 v;
    public ctor make(int32 v) { this.v = v; }
    fn int32 read(int32 d) { return this.v + d; }
}

fn int32 main() {
    { Owned<Derived, Check> d = new(allocator: Check.make()) Derived.make(a: 1); }                 // 1 free
    { Owned<Base, Check> b = new(allocator: Check.make()) Derived.make(a: 1); }                    // 1
    { Shared<Base, Check> s = new(allocator: Check.make()) Derived.make(a: 1); }                   // 2 (+ctrl)
    { Owned<Base, Check> b = new(allocator: Check.make()) Derived.make(a: 1); Owned<Area, Check> c = give b; }  // 1
    {
        Owned<Plain, Check> p = new(allocator: Check.make()) Plain.make(v: 1);
        BindableFunctionPtr<Get> g = BindableFunctionPtr.bind(obj: p, method: Plain::read);         // 1
        if (g(d: 1) != 2) { return 90; }
    }
    {
        Shared<Plain, Check> p = new(allocator: Check.make()) Plain.make(v: 2);
        BindableFunctionPtr<Get> g = BindableFunctionPtr.bind(obj: p, method: Plain::read);         // 2 (+ctrl), last ref
        if (g(d: 1) != 3) { return 91; }
    }
    { Shared<Base, Check> s = new(allocator: Check.make()) Derived.make(a: 1); Shared<Base, Check> t = copy s; }  // 2, once
    if (mismatches != 0) { return 100 + mismatches; }
    return frees;
}
