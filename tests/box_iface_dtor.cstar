// A DESTRUCTIBLE implementer owned polymorphically: Box<Shape> drop must run Circle's ~dtor through the
// vtable's __dtor slot, freeing its heap buffer. ASan/LeakSanitizer-clean == the virtual dtor ran.
extern "<stdlib.h>";
extern fn Ptr malloc(usize n);
extern fn void free(Ptr p);

type contract Shape for both { fn int32 area(); }
type resource Circle implements Shape {
    Ptr<int32> buf;
    public Circle(int32 r) { unsafe { this.buf = cast<Ptr<int32>>(malloc(n: sizeof(int32))); this.buf[0] = r; } }
    public fn int32 area() { unsafe { return this.buf[0] * this.buf[0]; } }
    ~Circle() { unsafe { free(p: cast<Ptr>(this.buf)); } }   // must run via vtbl->__dtor
}
type resource Box<T> implements Deref<T>, HeapOwner<T> {
    Ptr<T> p;
    public static fn Box<T> adopt(Ptr<T> raw) { Box<T> b; b.p = raw; return b; }
    public fn ref T deref() { unsafe { return this.p[0]; } }
    ~Box() { unsafe { free(p: cast<Ptr>(this.p)); } }
}
fn int32 main() {
    Box<Shape> a = new Circle(r: 6);
    return a.area();   // 36; at return, Box drops -> vtbl->__dtor(Circle) frees buf
}
