// `final override` seals a slot: no subclass may re-override it, and a call to it lowers to a direct
// call. Inside `midGo`, `this` is a `Leaf` whose `tick` is `final` -> direct Leaf__tick.
//
// ⚠️ This used to isolate devirtualization trigger 2 (`mi->isFinal`) from triggers 1 (`final` receiver
// class) and 3 (nobody overrides the slot), with a NON-final `virtual resource Mid` in the middle. The
// inheritance depth cap makes that shape unrepresentable — at KAMA_INHERIT_DEPTH=1 a deriving type is
// `final`, so trigger 1 always fires first (emitDispatch short-circuits left to right).
//
// That makes the `final` METHOD modifier DORMANT at depth 1 — not dead. Sealing a slot only matters when
// someone below could re-override it, and at depth 1 nobody can (a leaf is already a `final class`; a
// root's non-virtual method is already un-redefinable, since shadowing is an error). At depth 2 the
// middle layer exists and the modifier is the only thing that does its job. So it stays, and this fixture
// keeps it covered: `final override` parses, seals (tests/xfail/override_final), and dispatches directly.
type virtual resource Base
{
    public ctor make() { slot Base r;  return give r; }
    public fn int32 midGo() { return this.run(); }       // public surface, on the root (decision A)
    protected virtual fn int32 run() { return this.tick(); }
    protected virtual fn int32 tick() { return 1; }
}
type final resource Leaf extends Base
{
    public ctor make() { slot Leaf r;  return give r; }
    protected final override fn int32 tick() { return 5; }
    protected override fn int32 run() { return this.tick(); }   // `this` is a Leaf; tick is final -> direct
}
fn int main()
{
    Leaf m = Leaf.make();
    return m.midGo();
}
