// KBIN round-trip of an externally-tagged enum (payload variant) nested in a value type. Exercises the
// beginObject/field/variant(tag)/nested-object token path + the enum deserialize close-via-moreFields.
// Returns 23 (id 3 + w*h 4*5).
import {
    std::serialization::binary::encodeNamed,
    std::serialization::binary::decodeNamed,
    std::collections::DynamicArray,
};

@generate(Serializable, Deserializable)
type enum Geo { Circle(int32 r), Rect(int32 w, int32 h), Empty }

@generate(Serializable, Deserializable)
@generate(of)
type value Drawing { @field public int32 id; @field public Geo shape; }

fn int32 main() {
    Drawing d = Drawing.of(id: 3, shape: Geo::Rect(w: 4, h: 5));
    Result<DynamicArray<uint8>, Owned<Error>> e_r = encodeNamed(v: d);
    DynamicArray<uint8> bytes = match (give e_r) { case Ok(value: b): give b; case Err(error: __e): { return 250; } };
    Result<Drawing, Owned<Error>> res = decodeNamed::<Drawing>(src: give bytes);
    return match (res) {
        case Ok(value: b): b.id + (match (b.shape) { case Rect(w: w, h: h): w * h; case Circle(r: r): r; case Empty: 0; });
        case Err(error: e): 0 - 1;
    };
}
