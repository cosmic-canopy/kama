// A1: a value-producing variant constructor used directly as a `match` SUBJECT — `match (Optional::Some(x))`
// with `x` a param or local. The concrete instance (`Optional<int32>`) is inferred from the payload during
// the discovery pass (so its C struct emits) and reused at emit. Previously this hard-errored ("`match`
// requires an enum subject") and forced binding to a typed local first — that workaround still works too.
fn int32 firstOr(int32 x) {
    return match (Optional::Some(value: x)) {   // subject inferred as Optional<int32> from the param `x`
        case Some(value: v): v;
        case None:    0 - 1;
    };
}
fn int32 main() {
    int32 y = 40;
    int32 got = match (Optional::Some(value: y)) {   // subject inferred from the local `y`
        case Some(value: v): v + 2;                          // 42
        case None:    0 - 1;
    };
    Optional<int32> o = Optional::Some(value: 0);     // the "bind to a local first" workaround still compiles
    int32 w = match (o) { case Some(value: v): v; case None: 0 - 1; };
    return got + firstOr(x: w);   // 42 + 0 = 42
}
