// Box<T> is a `type resource`, so it is MOVE-ONLY for free: `give a` transfers the heap object; the
// moved-from `a` is not freed (no double-free). Nothing smart-pointer-specific — general resource RAII.
extern "<stdlib.h>";
extern fn void free(UnsafePtr p);
type value Counter { public int32 n; public ctor make(int32 s) { this.n = s; } public fn int32 get() { return this.n; } }
type resource Box<T> implements Deref<T>, HeapOwner<T> {
    UnsafePtr<T> p;
    public unsafe ctor adopt(UnsafePtr<T> raw) { this.p = raw; return this; }
    public unsafe fn ref T deref() { return this.p[0]; }
    unsafe ~Box() { free(p: cast<UnsafePtr>(this.p)); }
}
fn int32 main() {
    Box<Counter> a = new Counter.make(s: 7);
    Box<Counter> b = give a;   // move — a consumed, only b owns the heap object
    return b.get();            // 7 (b frees on drop; a does not)
}
