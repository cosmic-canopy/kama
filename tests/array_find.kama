// FixedArray completion: contains / indexOf over an Equatable element. Uses a user `value` element (Tag) — its
// `equals` routes the same generic `when T: Equatable` path as `string`; a value element also sidesteps the
// still-open owning-element place-store (`FixedArray<string>` `a[i] = <owned>`, ROADMAP_DETAIL §1).
import std::collections::{FixedArray};

type value Tag implements Equatable<This> {
    int32 id;
    public ctor make(int32 id) { this.id = id; }
    public const fn bool equals(const ref Tag other) { return this.id == other.id; }
}

fn int32 main() {
    FixedArray<Tag> a = FixedArray.make(size: 3);
    Tag t0 = Tag.make(id: 10); Tag t1 = Tag.make(id: 20); Tag t2 = Tag.make(id: 30);
    a[0] = t0; a[1] = t1; a[2] = t2;
    isize r = 0;
    Tag q20 = Tag.make(id: 20);
    Tag q30 = Tag.make(id: 30);
    Tag q99 = Tag.make(id: 99);
    if (a.contains(item: q20)) { r = r + 10; }   // +10
    r = r + a.indexOf(item: q30);                // +2 -> 12
    if (a.indexOf(item: q99) < 0) { r = r + 8; } // +8 -> 20 (absent)
    return cast<int32>(r);   // 20
}
