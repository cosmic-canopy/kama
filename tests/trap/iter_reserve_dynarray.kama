// `reserve()` reallocs, which invalidates every live iterator — but it reaches `growTo` without going
// through `add`, so the mods counter used to stay untouched and the loop read the freed buffer (an
// ASan-proven use-after-free with zero `unsafe` tokens; finding 7 of the safe-kama boundary spike).
// Bumping in `growTo` puts the counter where the relocation actually happens.
//
// `foreach` is where this still matters after the view window shipped: it creates no source-level local,
// so the window rule never sees it, and this runtime guard is the whole defense.
import std::collections::{DynamicArray};

fn int main() {
    DynamicArray<int32> d = DynamicArray.withCapacity(capacity: 2);
    d.add(item: 1); d.add(item: 2);
    int32 t = 0;
    foreach (int32 x in d) { d.reserve(n: 4096); t = t + x; }
    return t;
}
