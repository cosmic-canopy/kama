// KR-211: a view minted for a call is held by the call over the field it views. `sum` grows the value through `b`
// while it holds `v`: the access to `items` traps. Through 0.9.707 `v[0]` read the freed buffer.
import { std::memory::Shared, std::collections::DynamicArray, std::collections::ConstView };
type resource Core {
    DynamicArray<int32> items;
    public ctor make() { this.items = DynamicArray.empty(); this.items.add(item: 1); }
    public fn void grow() { for (int32 i = 0; i < 64; i++) { this.items.add(item: i); } }
    public fn int32 go(Shared<Core> b) { return sum(v: this.items.view(), b: b); }
}
fn int32 sum(ConstView<int32> v, Shared<Core> b) { b.grow(); return v[0]; }
fn uint8 main() { Shared<Core> a = new Core.make(); Shared<Core> b = a; return cast<uint8>(a.go(b: b)); }
