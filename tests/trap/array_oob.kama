// A dynamic (non-constant) FixedArray index out of range traps at runtime. (A constant out-of-range index is
// instead a compile error — see xfail/constgen_oob.) The index is runtime-opaque so it isn't folded.
import std::collections::{FixedArray};
import std::num::{int32Max};
fn int main() {
    FixedArray<int32> a = FixedArray(size: 3);
    int32 i = int32Max() - int32Max() + 9;   // 9, opaque; past size 3
    return a[i];                              // out-of-bounds -> bounds trap
}
