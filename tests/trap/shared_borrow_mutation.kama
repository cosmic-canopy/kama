// KR-211: a borrow through one `Shared` handle, and a mutation of the same value through another. `grow` reallocates
// the buffer `x` points into: through 0.9.697 this wrote into freed memory (ASan: heap-use-after-free, WRITE of size
// 4; release: silent). It now traps at the mutation, naming both sites, in every build.
import { std::memory::Shared, std::collections::DynamicArray };
type resource Core {
    DynamicArray<int32> items;
    public ctor make() { this.items = DynamicArray.empty(); this.items.add(item: 1); }
    public fn ref int32 first() { return this.items[0]; }
    public fn void grow() { int32 i = 0; while (i < 1000) { this.items.add(item: i); i = i + 1; } }
}
fn uint8 main() {
    Shared<Core> a = new Core.make();
    Shared<Core> b = a;
    borrow a.first() as x {
        b.grow();
        x = 7;
    }
    return 0;
}
