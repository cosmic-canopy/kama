// A negative size names no array, so it traps (KR-422). Through 0.9.994 `make(size: -1)` answered length -1.
import { std::collections::FixedArray };
fn uint8 main() {
    isize most = cast<isize>((~cast<usize>(0)) >> 1);   // isize's largest value, on a 32- or 64-bit target
    FixedArray<int32> f = FixedArray.make(size: most - most - 1);
    return 0;
}
