// KR-179: std's indexing is `@trackCaller`, so a `DynamicArray` miss names the line that indexed — it named
// `std/collections/dynamic_array.kama:230`, a line in std, for the commonest crash a shipped program reports.
import { std::collections::DynamicArray };
fn uint8 main() {
    DynamicArray<int32> xs = DynamicArray.empty();
    xs.add(item: 1);
    isize i = xs.length() + 2;
    return cast<uint8>(xs[i]);   // reported here
}
