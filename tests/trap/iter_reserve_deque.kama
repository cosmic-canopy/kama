// The `Deque` arm of the same defect — `reserve` -> `growTo` relocates the ring buffer.
import std::collections::{Deque};

fn int main() {
    Deque<int32> q = Deque.withCapacity(capacity: 2);
    q.pushBack(item: 1); q.pushBack(item: 2);
    int32 t = 0;
    foreach (int32 x in q) { q.reserve(n: 4096); t = t + x; }
    return t;
}
