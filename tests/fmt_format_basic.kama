// std::fmt core (P1): the `Format` contract + `Formatter` sink + `toString<T: Format>`. A user type writes
// its pieces into a caller-owned Formatter (one buffer, no per-field allocation); primitives render in their
// natural form; nested formatting shares the single buffer. Exit code encodes which checks passed (15 = all).
type value Point implements Format {
    int32 x; int32 y;
    public ctor make(int32 x, int32 y) { this.x = x; this.y = y; return this; }
    public const fn void format(ref Formatter f) {
        f.writeStr(s: "(");
        f.writeI64(v: cast<int64>(this.x));
        f.writeStr(s: ", ");
        f.writeI64(v: cast<int64>(this.y));
        f.writeStr(s: ")");
    }
}

fn int32 main() {
    int32 r = 0;

    // a primitive renders through its Format conformance
    int32 n = 42i32;
    string a = "${n}";                             // "42"
    if (a == "42") { r = r + 1; }
    bool t = true;
    string b = "${t}";                             // "true"
    if (b == "true") { r = r + 2; }

    // a user type renders through its own Format impl
    Point p = Point.make(x: 3i32, y: 4i32);
    string ps = "${p}";                            // "(3, 4)"
    if (ps == "(3, 4)") { r = r + 4; }

    // Formatter directly: nested value + a negative int share ONE buffer
    Formatter f = Formatter.make();
    f.writeStr(s: "p=");
    p.format(f: ref f);
    f.writeStr(s: " n=");
    f.writeI64(v: -7i64);
    string s = f.finish();                         // "p=(3, 4) n=-7"
    if (s == "p=(3, 4) n=-7") { r = r + 8; }

    return r;                                       // 1 + 2 + 4 + 8 = 15
}
