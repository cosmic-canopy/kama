// A type parameter named only in ANOTHER parameter's bound is read off that parameter's conformance: in
// `fn A pull<S: Source<A>, A>(ref S s)`, `S` is bound to `Ints` by the argument, `Ints` implements exactly one
// `Source<…>` — `Source<int32>` — and so `A` is `int32`, with no turbofish. Rust infers the same from a single
// applicable impl. One binding can open the next bound: in `pullUnboxed`, `A` comes off `S` and then `B` off `A`.
// A type with two conformances to the contract leaves the parameter open
// (tests/xfail/generic_infer_bound_ambiguous.kama). Found by `DatagramSocket<A>` (KR-108).
type contract Source<A> for value, resource { fn A next(); }

type value Ints implements Source<int32> {
    int32 n;
    public ctor make() { this.n = 4; }
    public fn int32 next() { this.n += 1; return this.n; }
}

type resource Words implements Source<string> {
    int32 n;
    public ctor make() { this.n = 0; }
    public fn string next() { this.n += 1; return "ab"; }
}

type contract Boxed<B> for value { fn B unbox(); }

type value Cell implements Boxed<int32> {
    int32 v;
    public ctor make(int32 v) { this.v = v; }
    public fn int32 unbox() { return this.v; }
}

type value Cells implements Source<Cell> {
    int32 made;
    public ctor make() { this.made = 0; }
    public fn Cell next() { this.made += 1; return Cell.make(v: 9); }
}

fn A pull<S: Source<A>, A>(ref S s) { return s.next(); }

fn B pullUnboxed<S: Source<A>, A: Boxed<B>, B>(ref S s) {
    A a = s.next();
    return a.unbox();
}

fn int32 main() {
    Ints i = Ints.make();
    Words w = Words.make();
    Cells c = Cells.make();
    int32 a = pull(s: ref i);                    // 5
    string b = pull(s: ref w);                   // "ab"
    int32 d = pullUnboxed(s: ref c);             // 9
    return a + cast<int32>(b.length()) + d;      // 16
}
