// A window package's wait cannot see the loop's fibers, and std ends it for them (KR-409; KR-281 decision 5): a thread
// watches the fiber scheduler's queue while the loop waits in the package's, and posts to the package when a fiber's
// socket has bytes. The return is a pass and no tick, so the reader takes the first byte without one; it asks for a
// tick at the second, and that tick comes before any input does, and before the timer fiber's deadline: the bytes ended
// the wait themselves (exit 9 when the timer's did). A read a pass queued reaches the OS before the package's wait
// (kqueue's changelist, Windows' AFD queue), and the ring's watcher sees the socket, not the ring's eventfd (KR-412):
// until 0.9.981 a 30 ms timer here hid both. A fiber's timer bounds the package's deadline, so the timer fiber runs
// too. Input then wakes the app through its `Waker`, as a window package does on every host (5e): one more tick.
// The test's clock is the loop's own waits: each byte is written once the loop waits in the package's queue, and the
// input once the timer fiber has run and the loop waits again. Sleeps here exited 9 on macOS's CI runner with every
// wake on time: a throttled process's timers are coalesced, and under `taskpolicy -b` the writer's 60 ms sleeps took
// 240 ms each, so the bytes came after the 300 ms timer (KR-415).
// Natively only: wasm has no fibers yet and no package's wait. Exit 55, or the failed check's number.
import { std::app::App, std::app::Lifecycle, std::app::Pace, std::app::run, std::app::requestTick, std::app::waker,
         std::app::setEventWait, std::concurrent::Fiber, std::concurrent::Waker, std::net::TcpListener,
         std::net::TcpStream, std::io::IoError, std::io::writeAll, std::time::Instant, std::time::Duration,
         std::time::monotonicNow, std::time::sleep, std::collections::FixedArray };
extern "fakewin.h";
extern fn bool fakewin_wait(int64 ns, bool forever);
extern fn void fakewin_post();
extern fn void fakewin_input();
extern fn int32 fakewin_posts();
extern fn int32 fakewin_inputs();
extern fn int32 fakewin_await(int32 after);
extern fn void fakewin_timer();
extern fn int32 fakewin_timer_waits();

// The package's wait: its input wakes the app, as any other source does.
unsafe fn bool waitOnQueue(Optional<Instant> until) {
    return match (until) {
        case Some(value: t): fakewin_wait(ns: (t - monotonicNow()).asNanos(), forever: false);
        case None: fakewin_wait(ns: 0i64, forever: true);
    };
}
fn void packageWait(Optional<Instant> until) {
    if (waitOnQueue(until: until)) { waker().wake(); }
}
unsafe fn void postToQueue() { fakewin_post(); }
fn void packageWake() { postToQueue(); }

static int32 result = 0;
static int32 bytes = 0;      // what the reader fiber took
static bool timed = false;   // the timer fiber ran, asking for nothing
static bool ended = false;   // `run` returned: after a failed check the reader may still be waiting

fn uint16 portOf(const ref TcpListener l) { return match (l.localAddr()) { case Ok(value: a): a.port; case Err(error: e): 0ui16; }; }

unsafe fn int32 waiting(int32 after) { return fakewin_await(after: after); }
fn void writer(uint16 port) {
    Result<TcpStream, IoError> c = TcpStream.connect(host: "127.0.0.1", port: port);
    TcpStream s = match (give c) { case Ok(value: x): give x; case Err(error: e): { return; } };
    FixedArray<uint8> b = FixedArray.make(size: 1);
    int32 w = waiting(after: 0);   // the loop waits in the package's queue, which cannot see the socket
    b[0] = 1ui8;
    _ = writeAll(w: s, bytes: b.view());
    _ = waiting(after: w);         // and waits again, after the pass that took the first byte
    b[0] = 2ui8;
    _ = writeAll(w: s, bytes: b.view());
}
unsafe fn void deliverInput() { fakewin_input(); }
unsafe fn int32 timerWaits() { return fakewin_timer_waits(); }
fn void typist() {
    _ = waiting(after: timerWaits());   // the timer fiber ran, and the loop waits again
    deliverInput();
}

unsafe fn void timer() {
    sleep(d: Duration.fromMillis(ms: 300i64));
    timed = true;
    fakewin_timer();
}
unsafe fn void reader(ref TcpStream s) {
    FixedArray<uint8> b = FixedArray.make(size: 1);
    for (int32 i = 0; i < 2; i = i + 1) {
        Result<isize, IoError> r = s.read(into: b.viewMut());
        bytes = bytes + 1;
        if (b[0] == 2ui8 && !ended) { requestTick(at: monotonicNow()); }
    }
}

type resource Window implements App {
    int32 ticks;
    public ctor make() { this.ticks = 0; }
    public fn bool tick() {
        this.ticks = this.ticks + 1;
        if (this.ticks == 1) { return true; }
        if (this.ticks == 2) { return second(); }
        result = third();
        return false;
    }
    public fn void lifecycle(Lifecycle event) {
        if (event == Lifecycle::SurfaceReady) { setEventWait(owner: "test/fakewin", wait: packageWait, wake: packageWake); }
    }
}
unsafe fn bool second() {
    if (fakewin_inputs() != 0) { result = 2; return false; }   // the reader's request, before any input
    if (bytes != 2) { result = 3; return false; }               // the first byte was taken, with no tick
    if (timed) { result = 9; return false; }                    // the bytes ended the wait, not the timer
    if (fakewin_posts() < 1) { result = 5; return false; }      // the watcher posted to the package
    return true;
}
unsafe fn int32 third() {
    if (fakewin_inputs() < 1) { return 6; }                     // input, through the app's `Waker`
    if (!timed) { return 4; }                                   // the timer fiber ran under the package's wait
    return 55;
}

unsafe fn uint8 go() {
    Result<TcpListener, IoError> rl = TcpListener.bind(host: "127.0.0.1", port: 0ui16);
    TcpListener l = match (give rl) { case Ok(value: x): give x; case Err(error: e): { return 7; } };
    uint16 port = portOf(l: l);
    scope {
        spawn writer(port: port);
        spawn typist();
        Result<TcpStream, IoError> a = l.accept();
        TcpStream s = match (give a) { case Ok(value: x): give x; case Err(error: e): { return 8; } };
        scope {
            spawn fiber reader(s: ref s);
            spawn fiber timer();
            run(app: new Window.make(), pace: Pace::OnDemand);
            ended = true;
        }
    }
    return cast<uint8>(result);
}

fn uint8 main() { return go(); }
