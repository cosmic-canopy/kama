// An enum declares its conformance INLINE — `type enum E implements C { variants; methods }`. An enum is a
// full type kind, so it takes the same `implements` clause every other kind takes; before this it had no
// such clause at all, which is the only reason the retroactive `implements C for E` block existed. That
// block is gone; this is the one spelling.
//
// Covers both halves that used to need the lazy "Model C" promotion: a payload-less enum gains a member
// ClassInfo so it can carry a method (it stays its integer; the method takes it by value), and it gains an `<E>__as_Error` vtbl so ONE `Error`-typed call site
// dispatches to the right impl at runtime. Distinct message lengths prove the dispatch is dynamic rather
// than a static collapse. Kept < 256 so the exit code isn't truncated.
//
// The counterpart with payload variants is enum_implements_tagged.kama.

type enum IoError implements Error {
    NotFound, Denied;

    public const fn string message() {
        return match (this) {
            case NotFound: "nf";      // 2
            case Denied:   "denied";  // 6
        };
    }
}

// Also pins the tag width, and uses the VALUE-producing match to do it — the same form `IoError` above
// uses. This spelling used to be impossible: an explicit `: IntType` lowers to a plain `uint8_t` tag, so
// clang could not prove the switch exhaustive and rejected the uninitialized match temp. The `default:`
// arm of such a match now diverges, which is what lets clang drop that edge. See enum_match_intty.kama.
type enum ParseError : uint8 implements Error {
    BadToken, Eof;

    public const fn string message() {
        return match (this) {
            case BadToken: "bad";   // 3
            case Eof:      "eof";   // 3
        };
    }
}

// One monomorphic function over the base contract — the vtbl is what makes `.message()` dynamic.
fn isize describe(Error e) { string m = e.message(); return m.length(); }

fn int32 main() {
    IoError a    = IoError::NotFound;
    ParseError b = ParseError::BadToken;
    IoError c    = IoError::Denied;
    // 2*100 + 3*10 + 6 = 236 — only correct if each dispatched to its own impl.
    return cast<int32>(describe(e: a) * 100 + describe(e: b) * 10 + describe(e: c));
}
