// M-step5 flagship — a game-engine-style FRAME ALLOCATOR (also the real-time-audio pattern).
// Two allocation-discipline features compose here, neither MCU-specific:
//   1. FALLIBLE allocation: entities are bump-allocated into a fixed per-frame arena; when the arena is
//      exhausted the fallible `allocate` yields `None`, so the frame stops spawning GRACEFULLY instead of
//      trapping. `reset()` bulk-frees the whole frame in O(1) for the next tick.
//   2. `@noheap` guarantee: the per-tick update runs with ZERO heap allocation — the compiler REJECTS any
//      `new`/interpolation/etc. inside it (the "no malloc in the audio callback / frame tick" rule).
import std::collections::{Arena, BumpAllocator};

// The hot path: a fixed-work update the compiler proves never touches the heap.
@noheap fn int32 tick(int32 liveEntities) {
    int32 acc = 0; int32 i = 0;
    while (i < liveEntities) { acc = acc + i * 2; i = i + 1; }
    return acc;
}

fn int32 main() {
    Arena frame = Arena.make(capacity: 128);   // a tiny per-frame budget
    BumpAllocator a = frame.handle();

    // Spawn fixed-size (32-byte, 8-aligned) "entities" until the arena is exhausted — no trap on OOM.
    int32 spawned = 0;
    bool full = false;
    while (!full) {
        Optional<Ptr> block = a.allocate(bytes: 32ui64);
        bool none = match (block) { case Some(value: p): false; case None: true; };
        if (none) { full = true; } else { spawned = spawned + 1; }
    }

    frame.reset();                        // bulk-free — reuse the region next frame
    return spawned + tick(liveEntities: spawned);   // 4 spawned + (0+2+4+6) = 4 + 12 = 16
}
