// A node's NESTED parts are walked inline: a by-value field whose type itself reaches a `Shared`, and an
// `Owned<X>` pointee that does, contribute their edges to the OWNER's table entry — one table, one id per
// pointee, shared across the nesting. (The old emitter wrote a whole nested envelope inside the entry, with
// colliding ids, and the round trip still reported Ok — measured 2026-09-09.) Re-encode is exact.
import { std::serialization::json::serializeJsonBuffer, std::serialization::json::deserializeJsonBuffer,
         std::memory::Shared, std::memory::Owned };

@generate(Serializable, Deserializable)
type resource Leaf { @field int32 v; public ctor make(int32 v) { this.v = v; } }

@generate(Serializable, Deserializable)
type resource Inner { @field Shared<Leaf> l; public ctor make(Shared<Leaf> l) { this.l = give l; } }

@generate(Serializable, Deserializable)
type resource Pair {
    @field Inner x;            // a by-value part that reaches a Shared
    @field Owned<Inner> y;     // an Owned pointee that does — inline too, never a table entry
    public ctor make(Inner x, Owned<Inner> y) { this.x = give x; this.y = give y; }
}

fn int32 main() {
    Shared<Leaf> leaf = new Leaf.make(v: 42);
    Shared<Leaf> l2 = leaf;
    Shared<Pair> p = new Pair.make(x: Inner.make(l: give leaf), y: new Inner.make(l: give l2));
    Shared<Pair> graph = p;
    Result<string, Owned<Error>> jr = serializeJsonBuffer(v: graph);
    string j = match (give jr) { case Ok(value: x): give x; case Err(error: e): { return 250; } };
    // ONE table: the Pair (its nested parts inline) and the one Leaf both parts share.
    if (j != "{\"root\":1,\"objects\":[{\"id\":1,\"type\":\"Pair\",\"value\":{\"x\":{\"l\":2},\"y\":{\"l\":2}}},{\"id\":2,\"type\":\"Leaf\",\"value\":{\"v\":42}}]}") {
        return cast<int32>(j.length());
    }
    Result<Shared<Pair>, Owned<Error>> back = deserializeJsonBuffer::<Shared<Pair>>(src: copy j);
    match (back) {
        case Ok(value: og): {
            Result<string, Owned<Error>> j2r = serializeJsonBuffer(v: graph);
            string j2 = match (give j2r) { case Ok(value: x): give x; case Err(error: e): { return 1; } };
            return j2 == j ? 0 : 2;
        }
        case Err(error: e): { return 3; }
    };
    return 4;
}
