// An element store whose RHS is VALUE-PRODUCING, on every shape that is. `InlineArray` is the only type in
// the language whose element store depends on `__set` rather than on a place-returning `operator[]` (every
// kama-side container declares `ref T operator[]`), so it is the only type that could show this — and it
// did, in four ways at once:
//
//   xs[2] = Frame::<int32>.at(e: 7)            a generic-instance ctor        -> `__get(…) = …`, bad C
//   xs[2] = Optional::Some(value: 7)           a qualified variant construction  -> bad C
//   xs[1] = [4, 5]                             an array literal               -> bad C
//   ns[2] = match (o) { … }                    a value-producing `match`, primitive element
//                                              -> refused in kama: "needs a typed assignment target"
//
// One branch owned all four: it claims the statement on the RHS KIND and then spelled the left side with
// `emitExpression`, which for an element access is the by-value `Coll__get(…)`. Assigning to a copy is not
// assignable C, so the first three failed LOUDLY at the C compiler; the fourth failed earlier and more
// confusingly, because `exprClass` of an element access answers "" for a primitive element and the branch
// then had no type to thread into the match.
//
// ⚠️ THE DISCRIMINATOR IS THE PAIR, which is why this is not a one-line fixture: a plain fn call returning
// the SAME type worked, and so did a plain-class ctor. Both are in here as controls — they passed before
// the fix and must keep passing after it, since the fix is on the shared path. The workaround was to bind
// the RHS to a local first, which `sorted_map.kama` did at two sites; this fixture is what let those be
// deleted.
//
// A `DynamicArray` element store is the third control: a kama-side container declares `ref T operator[]` and
// so takes the place path, which was never broken. It was left out of this file until `0.9.306`, because an
// `InlineArray` over a generic-instance element could not share a program with `DynamicArray` at all
// (KR-11, tests/inline_array_user_elem_view).

import { std::collections::DynamicArray };

type value Frame<P> { public P e; public ctor at(P e) { this.e = e; } }
type value Plain    { public int32 e; public ctor at(int32 e) { this.e = e; } }

fn Frame<int32> viaCall(int32 v) { return Frame::<int32>.at(e: v); }

type value Holder {
    public InlineArray<Frame<int32>>#(4) gs;             // element is a generic instance
    public InlineArray<Optional<int32>>#(4) os;          // …a prelude generic instance
    public InlineArray<InlineArray<int32>#(2)>#(3) rows; // …a nested InlineArray
    public InlineArray<int32>#(4) ns;                    // …a primitive
    public InlineArray<Plain>#(4) ps;                    // …a plain class (the control)

    public ctor make(Optional<int32> o) {
        this.gs[2] = Frame::<int32>.at(e: 7);            // 1. generic-instance ctor
        this.gs[3] = viaCall(v: 5);                      //    control: a plain call of the same type
        this.os[2] = Optional::Some(value: 11);          // 2. qualified variant construction
        this.rows[1] = [4, 5];                           // 3. array literal
        this.ns[2] = match (o) { case Some(value: v): v; case None: 1; };   // 4. match, primitive element
        this.ps[2] = Plain.at(e: 3);                     //    control: a plain-class ctor
    }
}

fn int32 main() {
    Holder h = Holder.make(o: Optional::Some(value: 13));
    if (h.gs[2].e != 7) { return 240; }
    if (h.gs[3].e != 5) { return 241; }
    // ⚠️ A SECOND SITE OF THE SAME DEFECT, found by writing this fixture. A `match` borrows its subject by
    // pointer, and the emitter already CLASSIFIES an element access as an lvalue — then spelled it as an
    // expression and took the address of the by-value `__get(…)`. Identical shape to the store above:
    // classify one way, spell the other. It also failed only at the C compiler.
    int32 got = match (h.os[2]) { case Some(value: v): v; case None: -1; };
    if (got != 11) { return 242; }
    if (h.rows[1][0] != 4 || h.rows[1][1] != 5) { return 243; }
    if (h.ns[2] != 13) { return 244; }
    if (h.ps[2].e != 3) { return 245; }

    // The same four shapes into a LOCAL InlineArray rather than a field — the branch does not look at the
    // holder, so this is the other half of the reach.
    Holder h2 = Holder.make(o: Optional::None);
    if (h2.ns[2] != 1) { return 246; }                   // the None arm, through the element store

    DynamicArray<Frame<int32>> d = DynamicArray.empty();
    d.add(item: Frame::<int32>.at(e: 0));
    d[0] = Frame::<int32>.at(e: 9);                      // control: the place path, beside an InlineArray
    if (d[0].e != 9) { return 247; }

    return h.gs[2].e + h.ns[2] + h.rows[1][1];           // 7 + 13 + 5
}
