// An `fnptr` typedef comes after every type it names (KR-139). The signature typedefs were written after the class
// forward typedefs and BEFORE the enum typedefs, so `fnptr State PollFn(…)` — an enum of the same module as its
// return, and equally as a parameter — passed `kama check` and failed in clang ("type specifier missing" / "a
// parameter list without types"); an enum has no forward declaration to lean on. And the signatures went out in name
// order, so `Apply(Op f)` came before `Op`. Each case below is bound and called.
import { std::memory::Owned };

type enum State : uint8 { Idle, Busy }
type value Box { public int32 v; public ctor make(int32 v) { this.v = v; } }

fnptr State PollFn(int32 ctx);                 // an enum return
fnptr int32 ScoreFn(State s);                  // an enum parameter
fnptr int32 Op(int32 x);
fnptr int32 Apply(Op f, int32 x);              // names `Op`, and sorts before it
fnptr int32 SumFn(InlineArray<int32>#(3) xs);  // a value by value
fnptr int32 TakeFn(Owned<Box> b);              // a collection's `_TYPE` by value
type value Holder { public SumFn f; public ctor make(SumFn f) { this.f = f; } }   // a struct holding one

fn State poll(int32 ctx) { if (ctx > 0) { return State::Busy; } return State::Idle; }
fn int32 score(State s) { if (s == State::Busy) { return 7; } return 3; }
fn int32 twice(int32 x) { return x * 2; }
fn int32 apply(Op f, int32 x) { return f(x: x); }
fn int32 sum3(InlineArray<int32>#(3) xs) { return xs[0] + xs[1] + xs[2]; }
fn int32 take(Owned<Box> b) { return b.v; }

fn int32 main() {
    PollFn p = poll;
    ScoreFn s = score;
    Apply a = apply;
    TakeFn t = take;
    Holder h = Holder.make(f: sum3);
    InlineArray<int32>#(3) xs = [1, 2, 3];
    Owned<Box> b = new Box.make(v: 10);
    int32 n = s(s: p(ctx: 1));                 // 7
    n = n + a(f: twice, x: 4);                 // 15
    n = n + h.f(xs: xs);                       // 21
    return n + t(b: give b);                   // 31
}
