// A GENERIC free `fn ref T first<T>(ref Pair<T>)` place return — monomorphized per T (here `ref int32`
// -> `int32*`). The escape check is on the root binding (a `ref` param), orthogonal to T. T is passed
// with turbofish (it can't be inferred through the `Pair<T>` param).
type value Pair<T> {
    public T a;
    public T b;
    public ctor make(T x, T y) { this.a = x; this.b = y; }
}
fn ref T first<T>(ref Pair<T> p) { return p.a; }
fn int32 main() {
    Pair<int32> p = Pair.make(x: 3, y: 4);
    first::<int32>(p: ref p) = 10;              // write through the generic place
    first::<int32>(p: ref p) += 0;             // compound through it
    return first::<int32>(p: ref p) + p.b;     // 10 + 4 = 14
}
