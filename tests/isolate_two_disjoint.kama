// M2 shared-nothing PROOF (run under KAMA_TSAN=1): spawn two isolates over DISJOINT moved state and join
// both. Each isolate writes only through the raw slot inside its own moved bundle — no memory is shared —
// so a correct isolate seam is TSan-clean. Also exercises trampoline dedup: both spawns share one worker,
// so exactly one `__kama_iso_*` trampoline is emitted.
import std::concurrent;

type resource Payload {
    Ptr<int32> slot;
    int32 value;

    public ctor make(Ptr<int32> slot, int32 value) {
        Payload r;
        r.slot = slot;
        r.value = value;
        return give r;
    }

    public fn void run() {
        unsafe { this.slot[0] = this.value; }
    }
}

fn void worker(Payload p) {
    p.run();
}

fn int main() {
    int32 a = 0;
    int32 b = 0;
    Payload pa = Payload::make(slot: addr(of: a), value: 10i32);
    Payload pb = Payload::make(slot: addr(of: b), value: 20i32);
    spawn worker(p: give pa);   // disjoint slot `a`
    spawn worker(p: give pb);   // disjoint slot `b`
    if (a == 10 && b == 20) { return 0; }
    return 1;
}
