// Graph deserialize surfaces a TYPE MISMATCH: a polymorphic `Shared<Shape>` edge references a node whose wire
// `__type` (`Tag`) does not implement `Shape`. The two-pass rebuild recovers the pointee's concrete type from
// its `__type`, finds no `Shape` conformance for it, and `decode` returns `DeError::TypeMismatch` (not the
// generic `Malformed`). `Tag` is a real graph node (a concrete `Shared<Tag>` pointee) with no pointer fields,
// so only the mismatching edge fails — mirroring `ser_graph_dangling.kama`'s specific-error assertion.
import std::serialization::json::{decode};
import std::memory::{Shared};

type contract Shape for both { fn int32 area(); }

@generate(Serialize, Deserialize)
type resource Sq implements Shape {
    @field int32 side;
    public ctor make(int32 side) { slot Sq r; r.side = side; return give r; }
    public fn int32 area() { return this.side * this.side; }
}

@generate(Serialize, Deserialize)
type resource Tag { @field int32 n; public ctor make(int32 n) { slot Tag r; r.n = n; return give r; } }   // a NON-Shape graph node

@generate(Serialize, Deserialize)
type resource Scene {
    @field Shared<Shape> a;   // polymorphic edge
    @field Shared<Tag> t;     // concrete edge -> makes `Tag` a graph node
    public ctor make(Shared<Shape> a, Shared<Tag> t) { slot Scene r; r.a = give a; r.t = give t; return give r; }
}

fn int main() {
    // `a` (a `Shared<Shape>`) wrongly points at id 2, whose `__type` is `Tag` (not a `Shape` implementor).
    string j = "{\"root\":1,\"objects\":{\"1\":{\"__type\":\"Scene\",\"a\":2,\"t\":2},\"2\":{\"__type\":\"Tag\",\"n\":9}}}";
    Result<Shared<Scene>, Owned<Error>> res = decode::<Shared<Scene>>(src: give j);
    match (res) {
        case Ok(value: sh): { return 1; }                          // must NOT succeed
        case Err(error: e): {
            match (e.as<DeError>()) {                        // recover the concrete deserialize error
                case Some(value: ec): { match (ec) {
                    case TypeMismatch: { return 0; }         // expected
                    case Malformed: { return 2; }
                    case UnexpectedEnd: { return 3; }
                    case UnresolvedReference: { return 4; }
                    case MissingField: { return 5; }
                    case DuplicateId: { return 6; }
                }; }
                case None: { return 8; }                     // not a DeError
            };
        }
    };
    return 7;
}
