// M6.3: disjoint-slice `parallel_for` — the third safe-sharing primitive. Splits a `DynamicArray` into K
// non-overlapping sub-Views (auto-`.view()`), one per worker isolate, and doubles each element IN PLACE
// through the `ref int32 e` binding. Because the slices are disjoint and joined at the closing brace, no
// two workers ever touch the same cell — race-free by construction, deterministic regardless of K. Run
// under KAMA_TSAN=1 (0 data races) and KAMA_SAN=1.
import std::concurrent;
import std::collections::{DynamicArray, View};

fn int main() {
    DynamicArray<int32> a = DynamicArray.empty();
    int32 i = 0;
    while (i < 10) { a.add(item: i); i = i + 1; }   // [0,1,2,...,9]

    parallel_for (ref int32 e in a) {                // auto .view(); disjoint slices, one per worker
        e = e * 2;                                   // mutate only this slice's element — cannot race
    }                                                // BARRIER: all slices joined here

    int32 s = 0;
    int32 j = 0;
    while (j < a.length()) { s = s + a[j]; j = j + 1; }   // 0+2+4+...+18 = 90
    return s % 256;                                       // 90
}
