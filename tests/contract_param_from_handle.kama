// A handle over a contract reaches a parameter of that contract, as a handle over a concrete type does: `pull(r: erased)`
// with `Owned<Reader> erased` borrows the object behind the handle for the call. It was refused ("`Owned<Reader>` does
// not implement it"), and the two ways round it each refused the other's advice: a `ref Reader` parameter said to bind
// the handle to a `Reader` local, and the local said it would borrow a handle that can be reseated. An `Owned<Reader>`
// is held as the contract's own {obj, vtbl}, so it is lent as it is; a refining contract's handle lends its parent's
// slot. A `ref` contract parameter still takes no handle, now saying why (xfail/contract_ref_param_from_handle).
import { std::memory::Owned, std::memory::Shared };

type contract Drawable for resource { fn int32 area(); }
type contract Animated for resource implements Drawable { fn int32 step(); }

type resource Sprite implements Animated {
    int32 w;
    public ctor make(int32 w) { this.w = w; }
    public fn int32 area() { this.w = this.w + 1; return this.w; }   // writes through the borrow
    public fn int32 step() { return 1; }
}

fn int32 draw(Drawable d) { return d.area(); }
fn int32 animate(Animated a) { return a.step() + a.area(); }
fn Owned<Drawable> fresh() { return new Sprite.make(w: 100); }

fn uint8 main() {
    Owned<Drawable> o = new Sprite.make(w: 1);
    Shared<Drawable> s = new Sprite.make(w: 10);
    Owned<Animated> a = new Sprite.make(w: 20);
    int32 t = draw(d: o);       // 2
    t = t + draw(d: o);         // 3: the write stuck, through the handle's own object
    t = t + draw(d: s);         // 11
    t = t + draw(d: a);         // 21, the refined handle as its parent
    t = t + animate(a: a);      // 1 + 22
    t = t + draw(d: fresh());   // 101, a handle made for the call and dropped after it
    return t == 2 + 3 + 11 + 21 + 23 + 101 ? 42 : 1;
}
