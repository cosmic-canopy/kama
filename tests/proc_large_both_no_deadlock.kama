// std::process — the ANTI-DEADLOCK guard. A child emits >64 KiB to BOTH stdout and stderr; a naive
// read-stdout-then-stderr would deadlock when the child blocks filling the second pipe. run() drains both
// concurrently (kama_capture2), so both are captured in full. The helper's `spew 8000` = 8000 lines * 20
// bytes = 160000 each (19 'A'+\n to stdout, 19 'B'+\n to stderr).
import { core::envOr, std::process::Command, std::process::Output, std::io::IoError, std::collections::DynamicArray };

fn int32 main() {
    Command c = Command.make(program: envOr(name: "KAMA_PROCUTIL", dflt: "procutil"));
    c.arg(a: "spew"); c.arg(a: "8000");
    Result<Output, IoError> r = c.run();
    return match (give r) {
        case Ok(value: o): {
            isize n = o.stdout().length();
            isize e = o.stderr().length();
            int32 code = 42;
            if (n != 160000) { code = 70; }
            else if (e != 160000) { code = 71; }
            := code;
        }
        case Err(error: x): 72;
    };
}
