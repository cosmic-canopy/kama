// Tagged strings — `stripIndent"…"`: the literal template is dedented (the COMMON leading-space indentation is
// removed from every line, and one leading newline is dropped) while interpolated hole values are emitted
// VERBATIM — even when a value contains its own leading spaces. Exit code is a bitset of the checks (7 = all).
import { std::fmt::stripIndent };

fn int32 main() {
    string name = "Bob";
    string indented = "    x";            // a value carrying its own leading spaces — must survive untouched
    int32 r = 0;

    string s = stripIndent"
        line one
        line two ${name}
        line three";
    if (s == "line one\nline two Bob\nline three") { r = r + 1; }        // 1: dedent + leading-\n drop, hole woven

    string s2 = stripIndent"
    a
      b";
    if (s2 == "a\n  b") { r = r + 2; }                                   // 2: only the COMMON indent removed

    string s3 = stripIndent"
        val=${indented}";
    if (s3 == "val=    x") { r = r + 4; }                                // 3: a hole value's own spaces stay verbatim

    return r;
}
