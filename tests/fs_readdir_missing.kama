// std::fs — readDir on a path that does not exist is an `Err`, not a crash: `kama_diropen` returns null
// there, and the null is read as `None` at the seam (std::ptr::nonNull). The only nullable-extern path a
// fixture can force cheaply, so it is the one that pins the seam. Returns 7.
import { std::fs::readDir, std::io::IoError, std::collections::DynamicArray };

fn int32 main() {
    string missing = "/nonexistent-kama-dir-3f9a/x";
    return match (readDir(path: missing)) { case Ok(value: names): 30; case Err(error: e): 7; };
}
