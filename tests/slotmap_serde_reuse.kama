// A `SlotMap` read back from its wire form reuses the SAME slot the live map would.
//
// Which slot the next insert takes is decided by the free list's order, and `Handle.index` and `values()` both
// show it. The list used to be rebuilt on read lowest-first, while a live map reuses the slot vacated LAST:
// insert 0–3, remove 1 then 3, round-trip, insert 9, and the live map took slot 3 and iterated `0 2 9` while the
// reloaded one took slot 1 and iterated `0 9 2` (0.9.805). A world saved, loaded and stepped was then not the
// world saved and stepped, which is what replay, rollback and a save game need it to be. The free list is on
// the wire now; this pins its order through JSON and the positional kbin backend, and that a list naming a slot
// twice, an occupied slot, a slot out of range, too few or too many slots is `Malformed` rather than a map
// whose next insert overwrites a live value.
import { std::serialization::text::json::serializeJsonBuffer,
         std::serialization::text::json::deserializeJsonBuffer,
         std::serialization::binary::kbin::serializeKbinPositionalBuffer,
         std::serialization::binary::kbin::deserializeKbinPositionalBuffer,
         std::collections::SlotMap, std::collections::Handle, std::collections::DynamicArray };

// Slots 0–3 hold 0–3, then slot 1 and slot 3 are vacated, in that order: slot 3 is the next one reused.
fn SlotMap<int32> world() {
    SlotMap<int32> sm = SlotMap.empty();
    Handle h0 = sm.insert(value: 0);
    Handle h1 = sm.insert(value: 1);
    Handle h2 = sm.insert(value: 2);
    Handle h3 = sm.insert(value: 3);
    Optional<int32> r1 = sm.remove(handle: h1);
    Optional<int32> r3 = sm.remove(handle: h3);
    return give sm;
}

fn string order(const ref SlotMap<int32> sm) {
    string s = "";
    foreach (int32 v in sm.values()) { s = s + "${v} "; }
    return s;
}

fn bool malformed(string json) {
    Result<SlotMap<int32>, Owned<Error>> res = deserializeJsonBuffer::<SlotMap<int32>>(src: give json);
    return match (res) {
        case Ok(value: x): false;
        case Err(error: e): match (e.as<DeError>()) {
            case Some(value: de): de.kind() == DeErrorKind::Malformed;
            case None: false;
        };
    };
}

fn uint8 main() {
    SlotMap<int32> live = world();
    Result<string, Owned<Error>> jr = serializeJsonBuffer(v: live);
    string j = match (give jr) { case Ok(value: x): give x; case Err(error: e): { return 10; } };
    if (j != "{\"slots\":[1,2,1,2],\"values\":[0,2],\"free\":[1,3]}") { return 11; }
    Result<SlotMap<int32>, Owned<Error>> jb = deserializeJsonBuffer::<SlotMap<int32>>(src: give j);
    SlotMap<int32> fromJson = match (give jb) { case Ok(value: x): give x; case Err(error: e): { return 12; } };

    Handle a = live.insert(value: 9);
    Handle b = fromJson.insert(value: 9);
    if (a.index != 3) { return 13; }                                   // live: the slot vacated last
    if (b.index != a.index || b.generation != a.generation) { return 14; }
    if (order(sm: live) != "0 2 9 ") { return 15; }
    if (order(sm: fromJson) != order(sm: live)) { return 16; }
    Handle a2 = live.insert(value: 8);
    Handle b2 = fromJson.insert(value: 8);
    if (a2.index != 1 || b2.index != 1) { return 17; }                 // …and then the one before it

    // The positional backend, bounded only by the counts: the third array reads back the same way.
    SlotMap<int32> live2 = world();
    Result<DynamicArray<uint8>, Owned<Error>> pr = serializeKbinPositionalBuffer(v: live2);
    DynamicArray<uint8> bytes = match (give pr) { case Ok(value: x): give x; case Err(error: e): { return 20; } };
    Result<SlotMap<int32>, Owned<Error>> pb = deserializeKbinPositionalBuffer::<SlotMap<int32>>(src: give bytes);
    SlotMap<int32> fromKbin = match (give pb) { case Ok(value: x): give x; case Err(error: e): { return 21; } };
    Handle c = live2.insert(value: 9);
    Handle d = fromKbin.insert(value: 9);
    if (c.index != 3 || d.index != 3 || d.generation != c.generation) { return 22; }
    if (order(sm: fromKbin) != "0 2 9 ") { return 23; }

    // A free list must name every vacant slot exactly once, and nothing else.
    if (!malformed(json: "{\"slots\":[1,2,1,2],\"values\":[0,2],\"free\":[1,1]}"))    { return 30; }   // a slot twice
    if (!malformed(json: "{\"slots\":[1,2,1,2],\"values\":[0,2],\"free\":[1,2]}"))    { return 31; }   // an occupied slot
    if (!malformed(json: "{\"slots\":[1,2,1,2],\"values\":[0,2],\"free\":[1,4]}"))    { return 32; }   // out of range
    if (!malformed(json: "{\"slots\":[1,2,1,2],\"values\":[0,2],\"free\":[-1,3]}"))   { return 33; }
    if (!malformed(json: "{\"slots\":[1,2,1,2],\"values\":[0,2],\"free\":[3]}"))      { return 34; }   // too few
    if (!malformed(json: "{\"slots\":[1,2,1,2],\"values\":[0,2],\"free\":[1,3,1]}"))  { return 35; }   // too many
    // More values than occupied slots is an error too, not an `Ok` that drops the rest; so is the form before `free`.
    Result<SlotMap<int32>, Owned<Error>> extra = deserializeJsonBuffer::<SlotMap<int32>>(src: "{\"slots\":[1],\"values\":[5,6],\"free\":[]}");
    if (match (give extra) { case Ok(value: x): true; case Err(error: e): false; }) { return 36; }
    Result<SlotMap<int32>, Owned<Error>> old = deserializeJsonBuffer::<SlotMap<int32>>(src: "{\"slots\":[1,2],\"values\":[5]}");
    if (match (give old) { case Ok(value: x): true; case Err(error: e): false; }) { return 37; }
    return 0;
}
