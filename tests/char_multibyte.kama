// A multibyte UTF-8 source char literal decodes to its Unicode scalar value — identical to the `'\u{…}'`
// escape form. `char` is exactly one codepoint, so a 4-byte emoji is one `char` too.
fn int main() {
    char e = 'é';                                // U+00E9 = 233 (2-byte UTF-8)
    char smile = '😀';                            // U+1F600 = 128512 (4-byte UTF-8)
    int32 r = 0;
    if (e == '\u{E9}') { r = r + 1; }            // direct literal == escape form
    if (cast<int32>(e) == 233) { r = r + 20; }
    if (cast<int32>(smile) == 128512) { r = r + 21; }
    return r;                                     // 42
}
