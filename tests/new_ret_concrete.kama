import std::memory::{Owned};
// B4 — inline `new` in RETURN position (library HeapOwner, concrete element): the box is malloc+ctor+adopt'd
// into a hoisted temp and moved out to the caller (single owner; no bind-to-local needed).
type value Counter { int32 n; public ctor make(int32 n){ Counter r; r.n = n; return give r; } public fn int32 get(){ return this.n; } }
fn Owned<Counter> make(int32 n) { return new Counter.make(n: n); }
fn int32 main() { Owned<Counter> a = make(n: 42); return a.get(); }
