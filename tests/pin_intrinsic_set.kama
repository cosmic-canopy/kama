// A PINNED contract over the intrinsic SET form. One block declares the conformance for three types, and
// the pin makes each of them a DIFFERENT contract instance (`Weighable_int8`, `Weighable_int16`,
// `Weighable_int32`) — so the contract name has to resolve per target, not once for the block.
//
// The impl body still spells `This`: at a declaration the implementing type is statically known, which is
// exactly where `This` is legal. It is a USE site that must name the type. Returns 42.
type contract Weighable<T is This> for both { fn int32 weigh(ref T other); }

type intrinsic <int8, int16, int32> implements Weighable<This> {
    public fn int32 weigh(ref This other) { return cast<int32>(this) + cast<int32>(other); }
}

fn int32 total<T: Weighable<T>>(T a, T b) { return a.weigh(other: b); }

fn int32 main() {
    int8 e = 1i8; int8 f = 2i8;
    int16 c = 3i16; int16 d = 4i16;
    if (total::<int8>(a: e, b: f) != 3)  { return 1; }
    if (total::<int16>(a: c, b: d) != 7) { return 2; }
    return total::<int32>(a: 20, b: 22);
}
