// The proof has to PASS as well as fail: a `@noheap` entry point calling a chain of ordinary,
// un-annotated helpers compiles, because the compiler can see every one of them and none allocates.
// No annotation is needed on a callee whose body is visible — that is what keeps the rule usable
// without `@noheap` spreading across the whole stdlib.
fn int32 scale(int32 x) { return x * 2; }
fn int32 bias(int32 x) { return scale(x: x) + 1; }
@noheap fn int32 tick(int32 n) { int32 acc = 0; int32 i = 0; while (i < n) { acc = acc + bias(x: i); i = i + 1; } return acc; }
fn int32 main() { return tick(n: 4); }   // (1)+(3)+(5)+(7) = 16
