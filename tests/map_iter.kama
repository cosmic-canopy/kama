// Map/Set key iteration: `foreach (K k in map)` / `foreach (K k in set)` yields each key by value (a
// by-value iterator, present for a Copyable key) and guards against mid-iteration structural change.
import std::collections::{Map, Set};

fn int32 main() {
    Map<int32, int32> m = Map.empty();
    int32 i = 0;
    while (i < 10) { m.put(key: i, value: i * i); i = i + 1; }

    int32 ksum = 0; int32 vsum = 0;
    foreach (int32 k in m) {                          // every FULL slot's key, once
        ksum = ksum + k;
        int32 got = match (m.get(key: k)) { case Some(value: x): x; case None: 0; };
        vsum = vsum + got;
    }
    int32 r = 0;
    if (ksum == 45)  { r = r + 10; }                  // 0+1+…+9
    if (vsum == 285) { r = r + 10; }                  // 0+1+4+…+81

    Set<string> s = Set.empty();
    s.add(key: "aa"); s.add(key: "bbb"); s.add(key: "c"); s.add(key: "bbb");  // dup ignored
    isize lensum = 0; int32 count = 0;
    foreach (string x in s) { lensum = lensum + x.length(); count = count + 1; }
    if (count == 3)  { r = r + 10; }                  // 3 distinct
    if (lensum == 6) { r = r + 12; }                  // 2+3+1
    return r;   // 42
}
