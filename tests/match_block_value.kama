import std::memory::{Shared};
type resource Probe { int32 id; public Probe(int32 id){this.id=id;} ~Probe(){} public fn int32 val(){return this.id;} }
enum E { A(int32 n), B }
fn int main()
{
    E e = E::A(n: 5);
    int32 r = match (e) {
        case A(n): { Shared<Probe> p = new Probe(id: n * 2); := p.val(); }
        case B: 0;
    };
    return r;
}
