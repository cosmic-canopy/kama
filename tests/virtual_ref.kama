// Virtual dispatch through a `ref Shape` parameter (the base object borrowed by ref).
// M25b: the virtual is a `protected` hook (`compute`); `area` is the public surface a
// free function may call. Dispatch still resolves to the most-derived override.
type virtual(maxDepth: 1) resource Shape
{
    public ctor make() { }
    public fn int32 area() { return this.compute(); }
    protected virtual fn int32 compute() { return 1; }
}
type final resource Square extends Shape
{
    int32 s;
    public ctor make(int32 s) { this.base = Base.make(); this.s = s; }
    protected override fn int32 compute() { return s * s; }
}
fn int32 measure(ref Shape sh)
{
    return sh.area();
}
fn int32 main()
{
    Square sq = Square.make(s: 6);
    return measure(sh: ref sq);
}
