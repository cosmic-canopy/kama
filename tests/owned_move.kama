import std::memory::{Owned};
// Owned<T> move: initializing/assigning from an Owned lvalue transfers ownership
// and invalidates the source, so the pointee is destructed exactly once.
extern fn void kama_trace(int code);
extern fn int kama_trace_get();

type resource Probe
{
    int32 id;
    public ctor make(int32 id) { Probe r; r.id = id; kama_trace(code: 1); return give r; }
    ~Probe() { kama_trace(code: 2); }
}

fn int build()
{
    Owned<Probe> a = new Probe.make(id: 9);   // construct once -> 1
    Owned<Probe> b = a;                          // MOVE: a now null
    return 0;
    // scope exit: ~b (real -> 2), ~a (no-op, ptr null)
}

fn int main()
{
    int r = build();
    return kama_trace_get();   // fold(1,2) = 33
}
