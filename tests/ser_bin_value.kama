// KBIN binary round-trip for a value type of mixed scalars: encode -> DynamicArray<uint8> -> decode.
// Exercises the tag+LE-payload path for i32 / f32 (exact bits) / bool / string / i64. Returns 55.
import std::serialization::binary::{encode, decode};
import std::collections::{DynamicArray};

@generate(Serialize, Deserialize)
type resource Rec {   // owns a `string` -> must be a resource (move-only)
    @field int32 x;
    @field float32 f;
    @field bool b;
    @field string name;
    @field int64 big;
    public ctor make(int32 x, float32 f, bool b, string name, int64 big) {
        Rec r; r.x = x; r.f = f; r.b = b; r.name = give name; r.big = big; return give r;
    }
    public fn int32 score() {
        int32 ok = 0;
        if (this.x == 42) { ok = ok + 1; }
        if (this.f == 1.5f32) { ok = ok + 1; }                                  // 1.5 is exact -> bit round-trip
        if (this.b) { ok = ok + 1; }
        if (cast<int32>(this.name.length()) == 4 && this.name[0] == 107ui8 && this.name[3] == 110ui8) { ok = ok + 1; }  // "kbin"
        if (this.big == 9000000000i64) { ok = ok + 1; }                         // > 2^32, exercises the 8-byte path
        return ok;
    }
}

fn int main() {
    Rec v = Rec.make(x: 42, f: 1.5f32, b: true, name: "kbin", big: 9000000000i64);
    Result<DynamicArray<uint8>, Owned<Error>> e_r = encode(v: v);
    DynamicArray<uint8> bytes = match (give e_r) { case Ok(b): give b; case Err(__e): { return 250; } };
    Result<Rec, Owned<Error>> res = decode::<Rec>(src: give bytes);
    return match (res) { case Ok(q): ((q.score() == 5) ? 55 : 40); case Err(e): 0 - 1; };
}
