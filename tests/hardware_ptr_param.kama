// MCU step 2: a `hardware UnsafePtr<T>` parameter lowers to `volatile T*` — the driver-fn idiom for writing
// a memory-mapped register (the write must not be optimized away or reordered under -O2).
unsafe fn void poke(hardware UnsafePtr<uint32> reg, uint32 v) { reg[0] = v; }

unsafe fn int32 run() {
    uint32 cell = 0;
    poke(reg: addr(of: cell), v: 42);
    return cast<int32>(cell);   // 42
}

// The body above is the raw work, so IT carries the marker; `main` may not be `unsafe`
// (it encloses the whole program). Calling an `unsafe fn` from safe code is allowed.
fn int32 main() { return run(); }
