fn int32 unwrap(Optional<int32> o, int32 dflt)
{
    return match (o) {
        case Some(value: v): v;
        case None: dflt;
    };
}
fn uint8 main()
{
    Optional<int32> a = Optional::Some(value: 42);
    Optional<int32> b = Optional::None;
    return cast<uint8>(unwrap(o: a, dflt: 0) + unwrap(o: b, dflt: -1));
}
