// SlotMap<V> — stable handles with generation-checked stale detection (the ECS/asset-registry structure).
// insert hands back a Handle; get/contains/remove reject a handle whose slot was removed or reused; values()
// iterates live entries; a move-only value rides through insert/getRef/remove with ownership intact (ASan).
import { std::collections::SlotMap, std::collections::Handle };

type resource Counter {
    int32 n;
    public ctor make(int32 n) { this.n = n; }
    public fn void bump() { this.n = this.n + 1; }
    public const fn int32 get() { return this.n; }
}

fn int32 main() {
    int32 r = 0;

    // (a) core: stable handles; get/contains/remove; stale-handle + slot-reuse detection.
    SlotMap<int32> sm = SlotMap.empty();
    Handle a = sm.insert(value: 10);
    Handle b = sm.insert(value: 20);
    Handle c = sm.insert(value: 30);
    if (sm.length() == 3) { r = r + 5; }
    int32 va = match (sm.get(handle: a)) { case Some(value: x): x; case None: 0 - 1; };
    if (va == 10) { r = r + 5; }
    if (sm.contains(handle: b)) { r = r + 5; }

    int32 rb = match (sm.remove(handle: b)) { case Some(value: x): x; case None: 0 - 1; };
    if (rb == 20) { r = r + 5; }                       // remove moves the value out
    if (sm.length() == 2) { r = r + 5; }
    bool gone = match (sm.get(handle: b)) { case Some(value: x): false; case None: true; };
    if (gone) { r = r + 5; }                           // removed handle -> None
    if (!sm.contains(handle: b)) { r = r + 5; }

    Handle d = sm.insert(value: 40);
    if (d.index == b.index) { r = r + 5; }             // the vacated slot is reused
    bool stillGone = match (sm.get(handle: b)) { case Some(value: x): false; case None: true; };
    if (stillGone) { r = r + 5; }                      // old handle to the reused slot rejected (generation bumped)
    int32 vd = match (sm.get(handle: d)) { case Some(value: x): x; case None: 0 - 1; };
    if (vd == 40) { r = r + 5; }                       // live now: a=10, c=30, d=40

    // (b) iterate live values (copy iterator over occupied slots).
    int32 sum = 0; int32 cnt = 0;
    foreach (int32 v in sm.values()) { sum = sum + v; cnt = cnt + 1; }
    if (sum == 80) { r = r + 5; }                      // 10 + 30 + 40
    if (cnt == 3) { r = r + 5; }

    // (c) move-only value: getRef mutates in place; remove reclaims ownership; the rest drop at scope exit.
    SlotMap<Counter> cm = SlotMap.empty();
    Handle h1 = cm.insert(value: Counter.make(n: 100));
    Handle h2 = cm.insert(value: Counter.make(n: 200));
    cm.getRefMut(handle: h1).bump();                      // 100 -> 101, through the borrow
    int32 g1 = cm.getRef(handle: h1).get();
    if (g1 == 101) { r = r + 5; }
    int32 taken = match (cm.remove(handle: h2)) { case Some(value: ctr): ctr.get(); case None: 0 - 1; };
    if (taken == 200) { r = r + 5; }                   // reclaimed Counter read, then dropped
    if (cm.length() == 1) { r = r + 5; }               // h1's Counter still owned; drops at scope exit

    return r;   // 15 asserts * 5 = 75 (kept < 256 — exit codes are 8-bit)
}
