// A pointer-free type is a VALUE on the wire, behind a handle or not. There is no root wrapper any more,
// so nothing can declare `Pt` a one-node graph: `serializeJsonBuffer(v: sharedPt)` derefs the handle and
// writes `{"x":…,"y":…}` — the same bytes a bare `Pt` writes, through every backend. Reading one back as
// `Shared<Pt>` is refused (`graph_handle_not_a_node`); it is read by value.
import { std::serialization::json::serializeJsonBuffer, std::serialization::json::deserializeJsonBuffer,
         std::serialization::binary::serializeBinaryNamedBuffer, std::serialization::binary::deserializeBinaryNamedBuffer,
         std::collections::DynamicArray, std::memory::Shared };

@generate(Serializable, Deserializable)
type value Pt { @field int32 x; @field int32 y; public ctor make(int32 x, int32 y) { this.x = x; this.y = y; } public const fn int32 sum() { return this.x + this.y; } }

fn int32 main() {
    Result<string, Owned<Error>> plain = serializeJsonBuffer(v: Pt.make(x: 1, y: 2));
    string pj = match (give plain) { case Ok(value: s): give s; case Err(error: e): { return 250; } };
    if (pj != "{\"x\":1,\"y\":2}") { return 249; }

    // Behind a `Shared`, byte-identical: the handle is walked through, never framed as a table.
    Shared<Pt> p = new Pt.make(x: 1, y: 2);
    Result<string, Owned<Error>> jr = serializeJsonBuffer(v: p);
    string j = match (give jr) { case Ok(value: s): give s; case Err(error: e): { return 248; } };
    if (j != pj) { return cast<int32>(j.length()); }

    Result<Pt, Owned<Error>> back = deserializeJsonBuffer::<Pt>(src: give j);
    int32 a = match (give back) { case Ok(value: v): v.sum(); case Err(error: e): { return 247; } };

    // …and the same through the named binary backend, from a handle out and a value back in.
    Shared<Pt> q = new Pt.make(x: 10, y: 20);
    Result<DynamicArray<uint8>, Owned<Error>> br = serializeBinaryNamedBuffer(v: q);
    DynamicArray<uint8> bytes = match (give br) { case Ok(value: b): give b; case Err(error: e): { return 246; } };
    Result<Pt, Owned<Error>> bback = deserializeBinaryNamedBuffer::<Pt>(src: give bytes);
    int32 b = match (give bback) { case Ok(value: v): v.sum(); case Err(error: e): { return 245; } };
    return a + b;   // 3 + 30
}
