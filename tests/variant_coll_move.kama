import { std::collections::DynamicArray };
type enum Bag { Items(DynamicArray<int32> xs), Empty }
fn uint8 main()
{
    DynamicArray<int32> xs = DynamicArray.empty();
    xs.add(item: 40); xs.add(item: 2);
    Bag b = Bag::Items(xs: give xs);
    return match (b) { case Items(xs: ys): cast<uint8>(ys[0] + ys[1]); case Empty: 0; };
}
