// M4: spawn ONE isolate over a MOVED bundle inside a `scope`, observe its effect. The bundle carries a
// raw pointer to a slot main owns plus the value to write; the worker writes through it on its own thread.
// The `scope` joins the child at its closing brace, and that join happens-before main's read — so there is
// no data race (this fixture is the KAMA_TSAN shared-nothing proof) while still proving the worker ran.
import std::concurrent;

type resource Payload {
    Ptr<int32> dst;
    int32 value;

    public ctor make(Ptr<int32> dst, int32 value) {
        slot Payload r;
        r.dst = dst;
        r.value = value;
        return give r;
    }

    // Write the value through the slot — runs on the isolate's own thread.
    public fn void run() {
        unsafe { this.dst[0] = this.value; }
    }
}

fn void worker(Payload p) {   // owns the bundle by value (the caller `give`s it in)
    p.run();
}

fn int main() {
    int32 result = 0;
    Payload p = Payload.make(dst: addr(of: result), value: 42i32);
    scope {
        spawn worker(p: give p);   // deferred-join child on a fresh OS thread with the moved bundle
    }                              // BARRIER: the child is joined here, before `result` is read
    return result;               // 42 iff the isolate ran
}
