// Milestone A — every integer width is now a universal Map/Set key (splitmix64 hash + scalar equals in
// the prelude, no import), and floats are Equatable (exact ==) for `contains` / `<T: Equatable>` bounds
// though intentionally NOT hashable. Exercises the newly-added int64 / uint32 / float32 conformances.
import std::collections::{Map, Set, DynamicArray};

fn int32 main() {
    int32 r = 0;

    // int64 keys — large values that would collide if truncated to int32
    Map<int64, int64> big = Map.empty();
    int64 i = 0i64;
    while (i < 50i64) { big.put(key: i * 1000000000i64, value: i); i = i + 1i64; }
    int64 k = 7i64 * 1000000000i64;
    int64 v = match (big.get(key: k)) { case Some(value: x): x; case None: 0i64 - 1i64; };
    if (v == 7i64) { r = r + 10; }
    if (big.length() == 50) { r = r + 5; }

    // uint32 Set — idempotent add + membership
    Set<uint32> s = Set.empty();
    s.add(key: 4000000000ui32); s.add(key: 4000000000ui32); s.add(key: 1ui32);
    if (s.length() == 2) { r = r + 5; }
    if (s.contains(key: 4000000000ui32)) { r = r + 5; }

    // float32 Equatable via DynamicArray.contains (exact ==, no hashing)
    DynamicArray<float32> fs = DynamicArray.empty();
    fs.add(item: 1.5f32); fs.add(item: 2.5f32);
    if (fs.contains(item: 2.5f32)) { r = r + 5; }
    if (!fs.contains(item: 9.9f32)) { r = r + 5; }

    return r;   // 10+5+5+5+5+5 = 35
}
