// `@field(id:)` and POSITION are one thing. The derive emits fields in ascending id, so an explicit id
// reorders the positional wire form — and because both ends are derived from the same declarations, the
// round trip still holds. This is the property that makes a single derived body serve every addressing: a
// named backend keys by the name, a numbered one by the id VALUE, a positional one by the id's ORDER.
//
// `Wire` declares its fields in one order and numbers them in another. `Mirror` declares them in the order
// `Wire` NUMBERS them, with default ids — so the two must produce byte-identical positional streams, and
// each must decode the other's. Under a NAMED backend that would be false (the names differ in order but
// not in content, so JSON would round-trip both too — which is exactly why the check below is on the bytes).
import {
    std::collections::DynamicArray,
    std::serialization::binary::encodePositional,
    std::serialization::binary::decodePositional,
};

@generate(Serializable, Deserializable)
type value Wire {
    @field(id: 30) public int32 declaredFirst;    // emitted LAST
    @field(id: 20) public int32 declaredSecond;
    @field(id: 10) public int32 declaredThird;    // emitted FIRST
    public ctor make(int32 a, int32 b, int32 c) {
        this.declaredFirst = a; this.declaredSecond = b; this.declaredThird = c;
    }
}

@generate(Serializable, Deserializable)
type value Mirror {
    @field public int32 third;    // ids default to 0,1,2 — the order `Wire` emits in
    @field public int32 second;
    @field public int32 first;
    public ctor make(int32 t, int32 s, int32 f) { this.third = t; this.second = s; this.first = f; }
}

fn int32 main() {
    // Wire: declared (1,2,3), emitted ascending-id => 3, 2, 1
    Result<DynamicArray<uint8>, Owned<Error>> w = encodePositional(v: Wire.make(a: 1, b: 2, c: 3));
    DynamicArray<uint8> wb = match (give w) { case Ok(value: v): give v; case Err(error: e): { return 250; } };
    if (wb.length() != 12) { return 251; }

    // Mirror written in that same emitted order must be byte-identical.
    Result<DynamicArray<uint8>, Owned<Error>> m = encodePositional(v: Mirror.make(t: 3, s: 2, f: 1));
    DynamicArray<uint8> mb = match (give m) { case Ok(value: v): give v; case Err(error: e): { return 252; } };
    if (mb.length() != wb.length()) { return 253; }
    isize i = 0;
    while (i < wb.length()) { if (wb[i] != mb[i]) { return 254; } i = i + 1; }

    // and Wire's bytes decode as Mirror, in the emitted order
    Result<Mirror, Owned<Error>> dm = decodePositional::<Mirror>(src: give wb);
    int32 mv = match (dm) { case Ok(value: q): q.third * 100 + q.second * 10 + q.first; case Err(error: e): 0 - 1; };
    if (mv != 321) { return 255; }

    // and Wire round-trips itself, fields landing back on the names they were declared with
    Result<DynamicArray<uint8>, Owned<Error>> w2 = encodePositional(v: Wire.make(a: 7, b: 8, c: 9));
    DynamicArray<uint8> wb2 = match (give w2) { case Ok(value: v): give v; case Err(error: e): { return 240; } };
    Result<Wire, Owned<Error>> dw = decodePositional::<Wire>(src: give wb2);
    int32 wv = match (dw) {
        case Ok(value: q): q.declaredFirst * 100 + q.declaredSecond * 10 + q.declaredThird;
        case Err(error: e): 0 - 1;
    };
    if (wv != 789) { return 241; }
    return 42;
}
