// KBIN round-trip of NEGATIVE signed scalars at every width. The corpus had no such fixture, and that is
// why this broke silently when a narrowing `cast` began to trap: a signed scalar goes onto the wire as its
// unsigned peer's bit pattern, and `cast<uint8>(-56)` is not a conversion that can succeed — -56 is not a
// `uint8`. The crossings are `bitcast` (same width, all the bits), which is what they always meant.
//
// The values are chosen to exercise the SIGN BIT at each width, since a value that fits both signednesses
// would round-trip either way and prove nothing.
import std::serialization::binary::{encode, decode};
import std::collections::{DynamicArray};

@generate(Serialize, Deserialize)
type value Neg {
    @field int8  a;
    @field int16 b;
    @field int32 c;
    @field int64 d;
    public ctor make(int8 a, int16 b, int32 c, int64 d) { this.a = a; this.b = b; this.c = c; this.d = d; }
    public const fn int32 score() {
        int32 ok = 0;
        if (this.a == 0i8 - 56i8)          { ok = ok + 1; }   // 0xC8 as a byte
        if (this.b == 0i16 - 300i16)       { ok = ok + 1; }
        if (this.c == 0 - 70000)           { ok = ok + 1; }
        if (this.d == 0i64 - 9000000000i64){ ok = ok + 1; }   // past 2^32, the 8-byte path
        return ok;
    }
}

fn int32 main() {
    Neg v = Neg.make(a: 0i8 - 56i8, b: 0i16 - 300i16, c: 0 - 70000, d: 0i64 - 9000000000i64);
    Result<DynamicArray<uint8>, Owned<Error>> e_r = encode(v: v);
    DynamicArray<uint8> bytes = match (give e_r) { case Ok(value: b): give b; case Err(error: __e): { return 250; } };
    Result<Neg, Owned<Error>> res = decode::<Neg>(src: give bytes);
    return match (res) { case Ok(value: q): ((q.score() == 4) ? 42 : 40); case Err(error: e): 0 - 1; };
}
