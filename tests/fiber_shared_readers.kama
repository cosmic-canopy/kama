// Fibers of one `scope` that only read share a place too (KR-288), on one isolate with no `Sendable` gate. The twin
// on isolates is scope_shared_readers.
import { std::concurrent::Fiber, std::collections::DynamicArray };

fn void sum(const ref DynamicArray<int32> d) {
    int32 t = 0;
    foreach (const ref int32 x in d) { t = t + x; }
    if (t != 6) { panic(msg: "the reader saw the wrong sum"); }
}
fn void size(const ref DynamicArray<int32> d) { if (d.length() != 3) { panic(msg: "the reader saw the wrong size"); } }

fn uint8 main() {
    DynamicArray<int32> d = DynamicArray::<int32>.empty();
    d.add(item: 1); d.add(item: 2); d.add(item: 3);
    scope {
        spawn fiber sum(d: ref d);
        spawn fiber size(d: ref d);
        for (int32 i = 0; i < 2; i = i + 1) { spawn fiber sum(d: ref d); }
    }
    return 42;
}
