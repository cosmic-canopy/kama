fn uint8 main() {
    Optional<string> s = Optional::Some(value: "hello");
    match (s) { case Some(value: v): { println(s: "v=${v}"); } case None: {} };
    return cast<uint8>(f0(x: 1) + f63(x: 1));   // 2 + 65
}
