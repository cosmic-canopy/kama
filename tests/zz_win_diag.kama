// TEMPORARY (removed with the fix), round 3: round 2 showed ordered_map_basic's crash is in what it does beside the
// puts, removes, copies and arena — the loops that build strings and the matches over `first()`/`last()`/`remove`.
// Each now runs in its own function over its own map, with a marker after it returns: the first one missing names it.
import { core::eprintln, std::collections::OrderedMap, std::collections::Entry };

fn OrderedMap<string, int32> three() {
    OrderedMap<string, int32> m = OrderedMap.withCapacity(capacity: 4);
    m.put(key: "zeta", value: 1); m.put(key: "alpha", value: 2); m.put(key: "mid", value: 3);
    return give m;
}
fn int32 keysLoop() {
    OrderedMap<string, int32> m = three();
    string seen = "";
    foreach (string k in m) { seen = seen + k + ","; }
    return seen == "zeta,alpha,mid," ? 1 : 0;
}
fn int32 entriesLoop() {
    OrderedMap<string, int32> m = three();
    string again = "";
    foreach (Entry<string, int32> e in m.entries()) { int32 v = e.value(); again = again + e.key() + "=${v},"; }
    return again == "zeta=1,alpha=2,mid=3," ? 1 : 0;
}
fn int32 lookups() {
    OrderedMap<string, int32> m = three();
    int32 g = match (m.get(key: "alpha")) { case Some(value: v): v; case None: 0; };
    return g == 2 && m.getRef(key: "mid") == 3 && m.contains(key: "mid") ? 1 : 0;
}
fn int32 ends() {
    OrderedMap<string, int32> m = three();
    bool e = match (m.first()) { case Some(value: k): k == "zeta"; case None: false; }
          && match (m.last()) { case Some(value: k): k == "mid"; case None: false; };
    return e ? 1 : 0;
}
fn int32 removes() {
    OrderedMap<string, int32> m = three();
    int32 taken = match (m.remove(key: "alpha")) { case Some(value: v): v; case None: 0; };
    bool miss = match (m.remove(key: "alpha")) { case Some(value: _): false; case None: true; };
    string rest = "";
    foreach (string k in m) { rest = rest + k + ","; }
    return taken == 2 && miss && rest == "zeta,mid," ? 1 : 0;
}
fn int32 valuesLoop() {
    OrderedMap<string, int32> m = three();
    string after = "";
    foreach (int32 v in m.values()) { after = after + "${v},"; }
    return after == "1,2,3," ? 1 : 0;
}
fn int32 copyLoop() {
    OrderedMap<string, int32> m = three();
    OrderedMap<string, int32> c2 = copy m;
    string copied = "";
    foreach (string k in c2) { copied = copied + k + ","; }
    return copied == "zeta,alpha,mid," ? 1 : 0;
}
fn int32 clearMatch() {
    OrderedMap<string, int32> m = three();
    m.clear();
    bool empty = m.length() == 0 && match (m.first()) { case Some(value: _): false; case None: true; };
    return empty ? 1 : 0;
}
fn int32 main() {
    int32 n = keysLoop();    eprintln(s: "kama: after keysLoop");
    n = n + entriesLoop();   eprintln(s: "kama: after entriesLoop");
    n = n + lookups();       eprintln(s: "kama: after lookups");
    n = n + ends();          eprintln(s: "kama: after ends");
    n = n + removes();       eprintln(s: "kama: after removes");
    n = n + valuesLoop();    eprintln(s: "kama: after valuesLoop");
    n = n + copyLoop();      eprintln(s: "kama: after copyLoop");
    n = n + clearMatch();    eprintln(s: "kama: after clearMatch");
    return n;   // 8
}
