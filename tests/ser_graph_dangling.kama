// Graph deserialize surfaces a DANGLING reference: the objects table references id 2 (the shared leaf) but
// never defines it, so the two-pass wire can't resolve it and `decode` returns `DeError::UnresolvedReference`
// (not the generic `Malformed`) — the reader records the specific error via `failWith`.
import std::serialization::json::{decode};
import std::memory::{Shared};

@generate(Serialize, Deserialize)
type resource Leaf { @field int32 v; public ctor make(int32 v) { Leaf r; r.v = v; return give r; } }

@generate(Serialize, Deserialize)
type resource Pair {
    @field Shared<Leaf> a;
    @field Shared<Leaf> b;
    public ctor make(Shared<Leaf> a, Shared<Leaf> b) { Pair r; r.a = give a; r.b = give b; return give r; }
}

fn int main() {
    // id 2 (the Leaf that `a`/`b` reference) is MISSING from the objects table -> dangling.
    string j = "{\"root\":1,\"objects\":{\"1\":{\"__type\":\"Pair\",\"a\":2,\"b\":2}}}";
    Result<Shared<Pair>, Owned<Error>> res = decode::<Shared<Pair>>(src: give j);
    match (res) {
        case Ok(sh): { return 1; }                          // must NOT succeed
        case Err(e): {
            match (e.as<DeError>()) {                        // recover the concrete deserialize error
                case Some(ec): { match (ec) {
                    case UnresolvedReference: { return 0; }  // expected
                    case Malformed: { return 2; }
                    case UnexpectedEnd: { return 3; }
                    case TypeMismatch: { return 4; }
                    case MissingField: { return 5; }
                    case DuplicateId: { return 7; }
                }; }
                case None: { return 8; }                     // not a DeError
            };
        }
    };
    return 6;
}
