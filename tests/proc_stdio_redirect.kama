// A child's streams sent anywhere (KR-171): `Stdio::Handle(descriptor:)` gives a child any owned handle — a file, a
// pipe end, another child's stdout — and `Stdio::Stdout` sends stderr wherever stdout goes (`2>&1`). `run()` captures
// only what was left unset, and leaves the `Command` as it was. A `Handle` serves one `start()`. Returns 42.
import { core::envOr, std::process::Command, std::process::Process, std::process::Stdio, std::process::Output,
         std::process::ExitStatus, std::fs::File, std::fs::OpenMode, std::fs::readText, std::fs::writeText, std::fs::remove,
         std::io::IoError, std::io::Descriptor, std::collections::DynamicArray, std::collections::ConstView,
         std::encoding::utf8::decode, std::encoding::utf8::Utf8Error };

fn string util() { return envOr(name: "KAMA_PROCUTIL", dflt: "procutil"); }
fn string text(ConstView<uint8> b) { Result<string, Utf8Error> t = decode(bytes: b); return match (give t) { case Ok(value: s): { := give s; } case Err(error: e): { := "?"; } }; }
fn string fileText(const ref string path) { Result<string, IoError> r = readText(path: path); return match (give r) { case Ok(value: s): { := give s; } case Err(error: e): { := "?"; } }; }
unsafe fn Descriptor opened(const ref string path, OpenMode mode) {   // an empty one (-1) if the open failed
    Result<File, IoError> r = File.open(path: path, mode: mode);
    return match (give r) { case Ok(value: f): f.takeDescriptor(); case Err(error: e): Descriptor.adopt(raw: -1); };
}
fn int32 kindIsInvalid(Result<Process, IoError> r) {
    return match (give r) { case Ok(value: p): 1; case Err(error: e): match (e.kind()) { case InvalidInput: 0; case _: 2; }; };
}

unsafe fn int32 run() {
    // 1. A file as a child's stdout.
    Command a = Command.make(program: util()); a.arg(a: "echo"); a.arg(a: "hello");
    a.stdout(s: Stdio::Handle(descriptor: opened(path: "kr171-out.txt", mode: OpenMode::Write)));
    Result<Process, IoError> ar = a.start();
    Process ap = match (give ar) { case Ok(value: v): { := give v; } case Err(error: e): { return 1; } };
    Result<ExitStatus, IoError> aw = ap.wait();
    if (fileText(path: "kr171-out.txt") != "hello\n") { return 2; }
    // ...and a Handle serves ONE start: the second is refused, not silently inherited.
    if (kindIsInvalid(r: a.start()) != 0) { return 3; }

    // 2. 2>&1 through run(): both lines in the captured stdout, nothing in stderr.
    Command b = Command.make(program: util()); b.arg(a: "echo2"); b.arg(a: "out"); b.arg(a: "err");
    b.stderr(s: Stdio::Stdout);
    Result<Output, IoError> br = b.run();
    Output bo = match (give br) { case Ok(value: v): { := give v; } case Err(error: e): { return 4; } };
    string both = text(b: bo.stdout().view());
    if (!both.contains(substring: "out\n") || !both.contains(substring: "err\n")) { return 5; }
    if (bo.stderr().length() != 0) { return 6; }

    // 3. run() honours what was SET: stderr to the null device captures nothing; stdout, unset, is captured.
    Command c = Command.make(program: util()); c.arg(a: "echo2"); c.arg(a: "kept"); c.arg(a: "dropped");
    c.stderr(s: Stdio::Null);
    Result<Output, IoError> cr = c.run();
    Output co = match (give cr) { case Ok(value: v): { := give v; } case Err(error: e): { return 7; } };
    if (text(b: co.stdout().view()) != "kept\n" || co.stderr().length() != 0) { return 8; }

    // 4. A file as a child's stdin, captured by run().
    Result<isize, IoError> wt = writeText(path: "kr171-in.txt", text: "from a file");
    Command d = Command.make(program: util()); d.arg(a: "cat");
    d.stdin(s: Stdio::Handle(descriptor: opened(path: "kr171-in.txt", mode: OpenMode::Read)));
    Result<Output, IoError> dr = d.run();
    Output dout = match (give dr) { case Ok(value: v): { := give v; } case Err(error: e): { return 9; } };
    if (text(b: dout.stdout().view()) != "from a file") { return 10; }

    // 5. A pipeline: one child's stdout is the next one's stdin.
    Command e = Command.make(program: util()); e.arg(a: "echo"); e.arg(a: "piped");
    e.stdout(s: Stdio::Piped);
    Result<Process, IoError> er = e.start();
    Process ep = match (give er) { case Ok(value: v): { := give v; } case Err(error: x): { return 11; } };
    Command f = Command.make(program: util()); f.arg(a: "cat");
    f.stdin(s: Stdio::Handle(descriptor: ep.stdout().takeDescriptor()));
    Result<Output, IoError> fr = f.run();
    Output fo = match (give fr) { case Ok(value: v): { := give v; } case Err(error: x): { return 12; } };
    Result<ExitStatus, IoError> ew = ep.wait();
    if (text(b: fo.stdout().view()) != "piped\n") { return 13; }

    // 6. `Stdout` belongs to stderr alone.
    Command g = Command.make(program: util()); g.arg(a: "echo"); g.arg(a: "x");
    g.stdout(s: Stdio::Stdout);
    if (kindIsInvalid(r: g.start()) != 0) { return 14; }

    Result<Unit, IoError> r1 = remove(path: "kr171-out.txt");
    Result<Unit, IoError> r2 = remove(path: "kr171-in.txt");
    return 42;
}

fn int32 main() { return run(); }
