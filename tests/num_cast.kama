// Numeric conversions + shifts at the bounds we expect, all DEFINED (no UB): widening sign/zero-extends,
// float->int truncates toward zero, a signed left shift into the sign bit is defined, and unsigned
// overflow wraps. (Overflow/div-by-zero/out-of-range float-cast TRAP instead of wrapping — not exercised
// here since a trap aborts.)
//
// The two wrapping cases below say `truncate`, and that is the whole of milestone 7 in one line: a
// NARROWING `cast` whose value does not fit now TRAPS (tests/trap/cast_narrow_*.kama) rather than binding
// a different number, so keeping the low bits is a verb of its own. They still take their operand through
// a LOCAL, because a constant that does not fit is rejected earlier still, at compile time
// (tests/xfail/cast_const_oob.kama). The three verbs together are tests/cast_verbs.kama.
import { std::num::int32Min };
fn int32 main() {
    int32 r = 0;
    int32 n300 = 300; int32 n511 = 511;
    if (truncate<int8>(n300) == 44i8)                { r = r + 4; }   // 300 - 256
    if (truncate<uint8>(n511) == 255ui8)             { r = r + 4; }   // 511 & 0xFF
    if (cast<int64>(0i32 - 5i32) == 0i64 - 5i64)     { r = r + 4; }   // sign-extend
    if (cast<int32>(cast<uint8>(200i32)) == 200)     { r = r + 4; }   // zero-extend (unsigned widen)
    if (cast<int32>(3.9f64) == 3)                    { r = r + 4; }   // truncate toward zero
    if (cast<int32>(0.0f64 - 3.9f64) == 0 - 3)       { r = r + 4; }   // toward zero (negative)
    if ((1i32 << 31) < 0)                            { r = r + 4; }   // sign bit set (defined)
    if ((1i32 << 31) == int32Min())                  { r = r + 4; }   // == INT_MIN
    uint8 u = 255ui8; u = u + 1ui8;
    if (u == 0ui8)                                   { r = r + 5; }   // unsigned wrap (defined)
    uint32 big = 4000000000ui32; big = big + big;                     // 8e9 wraps in uint32
    if (big == 3705032704ui32)                       { r = r + 5; }   // (8e9 mod 2^32)
    return r;   // 42
}
