// A variant may be named `Tag`. Its tag constant is `<Enum>__Tag` in C, and through 0.9.704 the enum's tag TYPE was
// `<Enum>_Tag`, which the constant then was too: `kama check` passed and clang refused the redefinition. The type is
// `<Enum>__kama_tag` now, a name no variant can take, since a variant may not begin `kama_` (KR-306).
type enum Validator { Tag(int32 id), Date(int64 secs) }

fn uint8 main() {
    Validator v = Validator::Tag(id: 7);
    int32 got = match (v) { case Tag(id: i): i; case Date(secs: s): 0; };
    Validator d = Validator::Date(secs: 9i64);
    int32 other = match (d) { case Tag(id: i): 100; case Date(secs: s): cast<int32>(s); };
    return cast<uint8>(got - 7 + other - 9);
}
