// Refcounted polymorphic ownership with a DESTRUCTIBLE implementer: the concrete object's ~dtor runs
// once, via the vtable __dtor slot, when strong hits 0 (despite two Rc<Shape> handles). LeakSan-clean.
extern "<stdlib.h>";
extern fn Ptr malloc(usize n);
extern fn void free(Ptr p);
type value Ctrl { public int32 strong; public int32 weak; }
type contract Shape for both { fn int32 area(); }
type resource Circle implements Shape {
    Ptr<int32> buf;
    public ctor make(int32 r) { slot Circle rr; unsafe { rr.buf = cast<Ptr<int32>>(malloc(n: sizeof(int32))); rr.buf[0] = r; } return give rr; }
    public fn int32 area() { unsafe { return this.buf[0] * this.buf[0]; } }
    ~Circle() { unsafe { free(p: cast<Ptr>(this.buf)); } }
}
type resource Rc<T> implements Deref<T>, HeapOwner<T>, Copyable(bare: copy) {
    Ptr<T> p; Ptr<Ctrl> c;
    public ctor make(Ptr<T> p, Ptr<Ctrl> c) { slot Rc<T> r; r.p = p; r.c = c; return give r; }
    public ctor adopt(Ptr<T> raw) { slot Ptr<Ctrl> k; unsafe { k = cast<Ptr<Ctrl>>(malloc(n: sizeof(Ctrl))); k[0].strong = 1; k[0].weak = 0; } return Rc.make(p: raw, c: k); }
    public fn ref T deref() { unsafe { return this.p[0]; } }
    public ctor copy(ref Rc<T> source) { unsafe { source.c[0].strong = source.c[0].strong + 1; } return Rc.make(p: source.p, c: source.c); }
    ~Rc() { unsafe { this.c[0].strong = this.c[0].strong - 1; if (this.c[0].strong == 0) { drop(value: this.deref()); free(p: cast<Ptr>(this.p)); if (this.c[0].weak == 0) { free(p: cast<Ptr>(this.c)); } } } }
}
fn int32 main() {
    Rc<Shape> a = new Circle.make(r: 6);
    Rc<Shape> b = copy a;      // strong = 2, one Circle
    return a.area();           // 36 (Circle __dtor runs once at strong=0 via vtbl->__dtor)
}
