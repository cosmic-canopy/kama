// Refcounted polymorphic ownership with a DESTRUCTIBLE implementer: the concrete object's ~dtor runs
// once, via the vtable __dtor slot, when strong hits 0 (despite two Rc<Shape> handles). LeakSan-clean.
extern "<stdlib.h>";
extern fn UnsafePtr malloc(usize n);
extern fn void free(UnsafePtr p);
type value Ctrl { public int32 strong; public int32 weak; }
type contract Shape for both { fn int32 area(); }
type resource Circle implements Shape {
    UnsafePtr<int32> buf;
    public ctor make(int32 r) { unsafe { this.buf = cast<UnsafePtr<int32>>(malloc(n: sizeof(int32))); this.buf[0] = r; } }
    public fn int32 area() { unsafe { return this.buf[0] * this.buf[0]; } }
    ~Circle() { unsafe { free(p: cast<UnsafePtr>(this.buf)); } }
}
type resource Rc<T> implements Deref<T>, HeapOwner<T>, Copyable<This>(bare: copy) {
    UnsafePtr<T> p; UnsafePtr<Ctrl> c;
    public ctor make(UnsafePtr<T> p, UnsafePtr<Ctrl> c) { this.p = p; this.c = c; }
    public ctor adopt(UnsafePtr<T> raw) { UnsafePtr<Ctrl> k = null; unsafe { k = cast<UnsafePtr<Ctrl>>(malloc(n: sizeof(Ctrl))); k[0].strong = 1; k[0].weak = 0; } return Rc.make(p: raw, c: k); }
    public fn ref T deref() { unsafe { return this.p[0]; } }
    public ctor copy(ref Rc<T> source) { unsafe { source.c[0].strong = source.c[0].strong + 1; } return Rc.make(p: source.p, c: source.c); }
    ~Rc() { unsafe { this.c[0].strong = this.c[0].strong - 1; if (this.c[0].strong == 0) { drop(value: this.deref()); free(p: cast<UnsafePtr>(this.p)); if (this.c[0].weak == 0) { free(p: cast<UnsafePtr>(this.c)); } } } }
}
fn int32 main() {
    Rc<Shape> a = new Circle.make(r: 6);
    Rc<Shape> b = copy a;      // strong = 2, one Circle
    return a.area();           // 36 (Circle __dtor runs once at strong=0 via vtbl->__dtor)
}
