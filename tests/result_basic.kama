type enum DivErr implements Error {
    DivByZero;

    public const fn string message() { return "div by zero"; }
}
fn int divide(int32 a, int32 b)
{
    Result<int32, DivErr> r = b == 0 ? Result::Err(error: DivErr::DivByZero) : Result::Ok(value: a / b);
    return match (r) {
        case Ok(value: v): v;
        case Err(error: e): 0 - 1;
    };
}
fn int main()
{
    return divide(a: 20, b: 4) + divide(a: 1, b: 0);
}
