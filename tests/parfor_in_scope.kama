// M6.3: `parallel_for` COMPOSES inside a `scope { }`. The parallel_for self-joins at its OWN brace (it owns
// its dynamic K-way fan-out); the sibling `spawn` is a deferred-join child of the scope, joined at the
// scope's closing brace. Both borrow enclosing locals soundly — the join-before-drop ordering holds for
// each. Deterministic; TSan-clean.
import { std::concurrent::Isolate, std::collections::DynamicArray, std::collections::View, std::concurrent::cpuCount };

fn void bump(ref int32 x) { x = x + 100; }

fn int32 main() {
    int32 side = 0;
    DynamicArray<int32> a = DynamicArray.empty();
    int32 i = 0;
    while (i < 6) { a.add(item: 1i32); i = i + 1; }   // six 1s

    scope {
        spawn bump(x: ref side);                       // sibling task, borrows `side`
        parallel_for (ref int32 e in a, workers: cpuCount()) {              // joins at its own brace, before the scope's
            e = e + 1;                                 // six 1s -> six 2s
        }
    }                                                  // scope barrier: `bump` joined here

    int32 s = side;                                    // 100
    isize j = 0;
    while (j < a.length()) { s = s + a[j]; j = j + 1; }   // 100 + 6*2 = 112
    return cast<int32>(s % 256);                                       // 112
}
