// M11a: placement `new(allocator: a)` in ARGUMENT and RETURN position (the hoisted-new path) — the
// allocator must be threaded there too, or the block leaks. ASan-clean over one arena.
import std::memory::{Owned};
import std::collections::{Arena, BumpAllocator};

type value Node {
    int32 v;
    public ctor make(int32 v) { this.v = v; }
    public fn int32 get() { return this.v; }
}

// takes an arena-backed box by value (consumes it) — exercises placement `new` in an ARG position
fn int32 consume(Owned<Node, BumpAllocator> b) { return b.get(); }

// returns an arena-backed box — exercises placement `new` in a RETURN position
fn Owned<Node, BumpAllocator> make(BumpAllocator a, int32 v) {
    return new(allocator: a) Node.make(v: v);
}

fn int32 main() {
    Arena arena = Arena.make(capacity: 4096);
    int32 r = consume(b: new(allocator: arena.handle()) Node.make(v: 42));   // arg position → 42
    Owned<Node, BumpAllocator> m = make(a: arena.handle(), v: 100);     // return position
    r = r + m.get();                                                    // 142
    return r;                                                           // 142
}
