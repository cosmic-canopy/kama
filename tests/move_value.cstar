import std::collections::{List};
// M26f-2 — a `resource` (destructible) VALUE is move-only. `give` transfers ownership into
// the callee (which drops it at fn-end); the source's dtor is suppressed, so the pointee is
// dropped exactly once. cstar_trace folds each drop (acc*31+code); a single drop of 5 -> 5.
extern fn void cstar_trace(int code);
extern fn int cstar_trace_get();

type resource Res {
    List<int32> items;                                  // owns a heap buffer
    public Res(int32 v) { this.items.add(item: v); }
    ~Res() { cstar_trace(code: 5); }                    // observable drop (+ the List frees)
    public fn int32 head() { return this.items[0]; }
}

fn int32 consume(Res r) { return r.head(); }            // r owned by callee, drops at fn-end

fn int32 main() {
    Res a = Res(v: 1);        // fresh rvalue — bare, legal
    consume(r: give a);       // move a into the callee; a's dtor suppressed in main
    return cstar_trace_get();  // exactly one drop -> 5   (a silent copy would fold to 160)
}
