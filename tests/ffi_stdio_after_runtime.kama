// A program that asks for <stdio.h> must build on every libc (peer KB-40). The runtime parses a float back to check
// its shortest spelling, through `sscanf`, which glibc declares with an asm label (`__isoc99_sscanf`); a block-scope
// declaration in the runtime, followed by this include, was "cannot apply asm label to function after its first use"
// on Linux from 0.9.517 to 0.9.523 — macOS, whose SDK labels nothing here, built. A float is formatted as well, so
// the parse runs, not only compiles. Returns 0.
extern "<stdio.h>";

fn int32 main() {
    float64 x = 0.1;
    string s = "${x}";
    return s == "0.1" ? 0 : 1;
}
