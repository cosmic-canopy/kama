// Graph deserialize enforces GIVE-ONCE for `Owned` edges: a hand-crafted wire aliases one uniquely-owned
// object (id 2) from TWO `Owned` fields. The first claim transfers it; the second finds the id already
// claimed and `deserializeJsonBuffer` returns `DeError::DuplicateId` (an owned object can have exactly one owner).
import { std::serialization::json::deserializeJsonBuffer, std::memory::Shared, std::memory::Owned };

@generate(Serializable, Deserializable)
type resource Child { @field int32 v; public ctor make(int32 v) { this.v = v; } }

@generate(Serializable, Deserializable)
type resource Twin {
    @field Owned<Child> a;
    @field Owned<Child> b;
    public ctor make(Owned<Child> a, Owned<Child> b) { this.a = give a; this.b = give b; }
}

fn int32 main() {
    // Both `a` and `b` reference id 2 — a single owned Child claimed twice.
    string j = "{\"root\":1,\"objects\":{\"1\":{\"__type\":\"Twin\",\"a\":2,\"b\":2},\"2\":{\"__type\":\"Child\",\"v\":5}}}";
    Result<Shared<Twin>, Owned<Error>> res = deserializeJsonBuffer::<Shared<Twin>>(src: give j);
    match (res) {
        case Ok(value: sh): { return 1; }                          // must NOT succeed
        case Err(error: e): {
            match (e.as<DeError>()) {                        // recover the concrete deserialize error
                case Some(value: ec): { match (ec) {
                    case DuplicateId: { return 0; }          // expected
                    case UnresolvedReference: { return 2; }
                    case Malformed: { return 3; }
                    case UnexpectedEnd: { return 4; }
                    case TypeMismatch: { return 5; }
                    case MissingField: { return 6; }
                }; }
                case None: { return 8; }                     // not a DeError
            };
        }
    };
    return 7;
}
