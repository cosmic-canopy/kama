import std::memory::{Owned};
// A bare owning local becomes definitely assigned after an unconditional (top-level) assignment.
type value Box { int32 v; public Box(int32 v) { this.v = v; } public fn int32 get() { return this.v; } }
fn int32 main() {
    Owned<Box> b;
    Owned<Box> t = new Box(v: 42);
    b = give t;                    // top-level assign -> 'b' now definitely assigned
    return b.get();   // 42
}
