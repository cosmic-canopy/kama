// 6b-2 Stage A: a function-local `const` drives a const-generic array SIZE and a fill COUNT, both
// resolving at compile time — the same size-registration path 6b-1 fixed for const-generic params,
// now reached through a named local const (`CAP`) instead of a template param.
fn int32 main() {
    const int32 CAP = 4;
    InlineArray<int32, (CAP)> buf = [0; (CAP)];   // type size AND fill count both fold CAP -> 4
    int32 i = 0;
    while (i < CAP) { buf[i] = i + 1; i = i + 1; } // 1, 2, 3, 4
    int32 t = 0;
    foreach (int32 e in buf) { t = t + e; }
    return t + cast<int32>(buf.length());          // (1+2+3+4) + 4 = 14
}
