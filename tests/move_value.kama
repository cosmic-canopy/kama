import std::collections::{DynamicArray};
// M26f-2 — a `resource` (destructible) VALUE is move-only. `give` transfers ownership into
// the callee (which drops it at fn-end); the source's dtor is suppressed, so the pointee is
// dropped exactly once. kama_trace folds each drop (acc*31+code); a single drop of 5 -> 5.
extern fn void kama_trace(int code);
extern fn int kama_trace_get();
unsafe fn int traceGet() { return kama_trace_get(); }   // the FFI call, contained — `main` may not be `unsafe`

type resource Res {
    DynamicArray<int32> items;                                  // owns a heap buffer
    public ctor make(int32 v) { this.items.add(item: v); }
    unsafe ~Res() { kama_trace(code: 5); }                    // observable drop (+ the DynamicArray frees)
    public fn int32 head() { return this.items[0]; }
}

fn int32 consume(Res r) { return r.head(); }            // r owned by callee, drops at fn-end

fn int32 main() {
    Res a = Res.make(v: 1);        // fresh rvalue — bare, legal
    consume(r: give a);       // move a into the callee; a's dtor suppressed in main
    return traceGet();  // exactly one drop -> 5   (a silent copy would fold to 160)
}
