// Object-graph round-trip with a UNIQUELY-OWNED child: a `Parent` owns a `Child` via `Owned<Child>` (a
// pointer field, so `Parent` is graph mode). Serialize writes the child once (id 2) and the owner's field as
// its id; deserialize rebuilds into a `Shared<Parent>`, transferring the child by GIVE-ONCE (the reconstructed
// child is moved out of its shell into the `Owned` field — no refcount) — proven by a re-encode that
// reproduces the exact wire, and ASan proves the single-owner path frees the child exactly once.
import std::serialization::json::{encode, decode};
import std::memory::{Shared, Owned};

@generate(Serialize, Deserialize)
type resource Child { @field int32 v; public ctor make(int32 v) { this.v = v; } }

@generate(Serialize, Deserialize)
type resource Parent {
    @field Owned<Child> kid;
    public ctor make(Owned<Child> kid) { this.kid = give kid; }
}

fn int main() {
    Owned<Child> c = new Child.make(v: 7);
    Parent p = Parent.make(kid: give c);
    Result<string, Owned<Error>> j_r = encode(v: p);
    string j = match (give j_r) { case Ok(value: __ok): give __ok; case Err(error: __e): { return 250; } };
    if (j != "{\"root\":1,\"objects\":{\"1\":{\"__type\":\"Parent\",\"kid\":2},\"2\":{\"__type\":\"Child\",\"v\":7}}}") {
        return cast<int32>(j.length());
    }
    Result<Shared<Parent>, Owned<Error>> res = decode::<Shared<Parent>>(src: copy j);
    match (res) {
        case Ok(value: sh): { Result<string, Owned<Error>> j2_r = encode(v: sh); string j2 = match (give j2_r) { case Ok(value: __ok): give __ok; case Err(error: __e): { return 1; } }; if (j2 == j) { return 0; } return 1; }
        case Err(error: e): { return 2; }
    };
    return 3;
}
