// A `@noheap` body may call a contract member that is not itself `@noheap` (KR-39): the slot is no blind seam. The call
// graph reads every vtable instance the program emitted, so `s.write` is an edge to each implementer's `write` — here
// only `Counter.write`, which allocates nothing — and the walk proves the call as it proves a direct one. An
// implementer that allocated would be refused with the chain through the slot (tests/xfail/noheap_contract_impl_slot).
// `@noheap` on the member stays, as a promise checked at every implementer (tests/noheap_contract.kama). Returns 7.
type contract Sink for value { fn int32 write(int32 x); }
type value Counter implements Sink {
    public ctor make() { return this; }
    public fn int32 write(int32 x) { return x + 1; }
}
@noheap fn int32 tick(Sink s, int32 n) { return s.write(x: n); }
fn int32 main() { Counter c = Counter.make(); return tick(s: c, n: 6); }
