// Owning keys AND owning values: Map<string, DynamicArray<string>>. Exercises the ownership-critical paths that
// must stay leak/double-free-free under ASan: storing owned keys+values, OVERWRITE (drop the old key +
// value, install the new), deep-copy `get` (hand back an independent DynamicArray), `remove` (moves the value
// OUT as Optional; here the reclaimed DynamicArray + old key drop), and end-of-scope drop of everything live.
import std::collections::{Map, DynamicArray};

fn DynamicArray<string> mk(string a, string b) {
    DynamicArray<string> xs = DynamicArray.empty();
    xs.add(item: give a); xs.add(item: give b);
    return xs;
}

fn int32 main() {
    Map<string, DynamicArray<string>> m = Map.empty();
    m.put(key: "fruits",  value: mk(a: "apple", b: "pear"));
    m.put(key: "veggies", value: mk(a: "kale",  b: "corn"));
    m.put(key: "fruits",  value: mk(a: "mango", b: "fig"));   // overwrite: old key + old DynamicArray dropped

    int32 r = 0;
    r = r + cast<int32>(m.length());                                       // 2
    int32 n = match (m.get(key: "fruits")) { case Some(value: xs): cast<int32>(xs.length()); case None: 0; };  // deep-copied out
    r = r + n;                                                // +2 -> 4
    bool rmv = match (m.remove(key: "veggies")) { case Some(value: xs): true; case None: false; };  // reclaimed DynamicArray + key drop
    if (rmv) { r = r + 1; }                                  // -> 5
    r = r + cast<int32>(m.length());                                      // +1 -> 6
    return cast<int32>(r);   // 6 (m's remaining entry dropped at scope exit)
}
