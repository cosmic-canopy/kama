// `std::fs::readText` / `writeText`, and the hole they close.
//
// Before KR-82 the fs API was bytes-only: `writeFile` took a `DynamicArray<uint8>` and `readFile`
// returned one, with no `string`↔bytes conversion anywhere outside `std::io`'s internals — so writing a
// string to a file was a hand loop over `s[i]`. Every comparator has the one-call form (Go
// `os.WriteFile`, Rust `fs::write` / `read_to_string`, Python `open().read()`).
//
// ⚠️ THE SECOND HALF IS THE IMPORTANT ONE. `std::io::readAll` was documented as draining a reader "into
// an owned UTF-8 string" and validated nothing, so a binary file read as text produced an ill-formed
// `string` and `.chars()` read garbage out of it — measured at 0.9.431: 8 bytes in, 5 bogus codepoints
// out, from entirely safe code. `readText` refuses it now, and `readFile` still accepts it, because
// "these bytes are not text" is an answer about the FILE, not a reason to refuse the bytes.
//
// Exit 0, or the number of the first check that failed.
import { std::fs::readText, std::fs::writeText, std::fs::readFile, std::fs::writeFile,
         std::fs::remove, std::fs::exists, std::io::IoError, std::io::readAll,
         std::fs::File, std::fs::OpenMode, std::collections::DynamicArray };

unsafe fn int32 run() {
    string path = "_fs_text_probe.txt";

    // 1-3: a round trip that is not ASCII — the bytes and the codepoints differ, so a byte-length bug
    // would show here and not on "hello".
    string body = "héllo\nwörld\n😀\n";
    match (writeText(path: path, text: body)) {
        case Err(error: e): { return 1; }
        case Ok(value: n): { if (n != body.length()) { return 2; } }     // BYTES written, not codepoints
    };
    match (readText(path: path)) {
        case Err(error: e): { return 3; }
        case Ok(value: s): { if (!s.equals(other: body)) { return 4; } }
    };

    // 5: writeText TRUNCATES, like writeFile — a shorter second write leaves no tail behind.
    match (writeText(path: path, text: "ok")) { case Err(error: e): { return 5; } case Ok(value: n): { } };
    match (readText(path: path)) {
        case Err(error: e): { return 6; }
        case Ok(value: s): { if (!s.equals(other: "ok")) { return 7; } }
    };

    // 8: the empty string is a legal file, and reads back empty rather than failing.
    match (writeText(path: path, text: "")) { case Err(error: e): { return 8; } case Ok(value: n): { } };
    match (readText(path: path)) {
        case Err(error: e): { return 9; }
        case Ok(value: s): { if (!s.isEmpty()) { return 10; } }
    };

    // 11-13: NOT TEXT. Write bytes that are not UTF-8 (a lone 0xFF, an overlong C0 80, a bare
    // continuation), then read the same file both ways: `readFile` succeeds, `readText` does not.
    DynamicArray<uint8> junk = DynamicArray::<uint8>.empty();
    junk.add(item: 255ui8); junk.add(item: 254ui8); junk.add(item: 128ui8);
    junk.add(item: 104ui8); junk.add(item: 105ui8);                      // ...then "hi", so it is not all bad
    match (writeFile(path: path, bytes: junk)) { case Err(error: e): { return 11; } case Ok(value: n): { } };
    match (readFile(path: path)) {
        case Err(error: e): { return 12; }
        case Ok(value: b): { if (b.length() != 5) { return 13; } }       // the bytes are readable as bytes
    };
    match (readText(path: path)) {
        case Ok(value: s):  { return 14; }                               // must NOT hand back a string
        case Err(error: e): { match (e) { case InvalidInput: { } case _: { return 15; } }; }
    };

    // 16: and the same through the READER path, which is where the hole actually was — `readAll` on the
    // same file used to return Ok with an ill-formed string.
    match (File.open(path: path, mode: OpenMode::Read)) {
        case Err(error: e): { return 16; }
        case Ok(value: f): {
            match (readAll(r: f)) {
                case Ok(value: s):  { return 17; }
                case Err(error: e): { match (e) { case InvalidInput: { } case _: { return 18; } }; }
            };
        }
    };

    // 19: a missing path is an error, not an empty string.
    match (readText(path: "_fs_text_absent_.txt")) {
        case Ok(value: s):  { return 19; }
        case Err(error: e): { }
    };

    match (remove(path: path)) { case Err(error: e): { return 20; } case Ok(value: u): { } };
    if (exists(path: path)) { return 21; }
    return 0;
}

fn int32 main() { return run(); }
