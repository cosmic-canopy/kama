// KBIN polymorphic object-graph round-trip: a Scene holds two `Shared<Shape>` edges where Shape is a CONTRACT
// with two `@generate` implementors (Sq, Circle). Each node carries its concrete `__type`; decode rebuilds the
// correct concrete behind each contract edge and re-forms the fat handle — proven by a byte-identical re-encode
// AND by dynamic dispatch (area()) surviving the trip. ASan proves each concrete frees once. Returns 55.
import std::serialization::binary::{encode, decode};
import std::collections::{DynamicArray};
import std::memory::{Shared};

type contract Shape for resource { fn int32 area(); }

@generate(Serialize, Deserialize)
type resource Sq implements Shape {
    @field int32 side;
    public ctor make(int32 side) { this.side = side; }
    public fn int32 area() { return this.side * this.side; }
}

@generate(Serialize, Deserialize)
type resource Circle implements Shape {
    @field int32 r;
    public ctor make(int32 r) { this.r = r; }
    public fn int32 area() { return 3 * this.r * this.r; }
}

@generate(Serialize, Deserialize)
type resource Scene {
    @field Shared<Shape> a;
    @field Shared<Shape> b;
    public ctor make(Shared<Shape> a, Shared<Shape> b) { this.a = give a; this.b = give b; }
    public fn int32 areaA() { return this.a.area(); }
    public fn int32 areaB() { return this.b.area(); }
}

fn DynamicArray<uint8> clone(ref DynamicArray<uint8> src) {
    DynamicArray<uint8> c = DynamicArray.empty();
    int32 i = 0; int32 n = cast<int32>(src.length());
    while (i < n) { c.add(item: src[i]); i = i + 1; }
    return give c;
}
fn bool bytesEqual(ref DynamicArray<uint8> a, ref DynamicArray<uint8> b) {
    if (a.length() != b.length()) { return false; }
    int32 i = 0; int32 n = cast<int32>(a.length());
    while (i < n) { if (a[i] != b[i]) { return false; } i = i + 1; }
    return true;
}

fn int main() {
    Shared<Sq> sq = new Sq.make(side: 4);
    Shared<Shape> sa = sq;                 // retain-upcast into the fat contract handle
    Shared<Circle> ci = new Circle.make(r: 2);
    Shared<Shape> sb = ci;
    Scene sc = Scene.make(a: give sa, b: give sb);
    Result<DynamicArray<uint8>, Owned<Error>> e1 = encode(v: sc);
    DynamicArray<uint8> b1 = match (give e1) { case Ok(value: b): give b; case Err(error: __e): { return 250; } };

    Result<Shared<Scene>, Owned<Error>> res = decode::<Shared<Scene>>(src: clone(src: ref b1));
    match (res) {
        case Ok(value: sh): {
            Result<DynamicArray<uint8>, Owned<Error>> e2 = encode(v: sh);
            DynamicArray<uint8> b2 = match (give e2) { case Ok(value: b): give b; case Err(error: __e): { return 1; } };
            if (!bytesEqual(a: ref b1, b: ref b2)) { return 40; }
            if (sh.areaA() != 16) { return 41; }   // Sq: 4*4
            if (sh.areaB() != 12) { return 42; }   // Circle: 3*2*2
            return 55;
        }
        case Err(error: e): { return 4; }
    };
    return 5;
}
