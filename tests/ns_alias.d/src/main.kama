// A renamed symbol import used in both TYPE and CALL position — the coverage this fixture has always
// carried, now through the one alias form that survives.
import { nsalias::graphics::Texture as Tex, nsalias::graphics::scale as gscale };

fn int32 main()
{
    Tex t = Tex.make(id: 20);            // alias in type + ctor position
    return t.get() + gscale(x: 11);      // 20 + 22 = 42
}
