// std::process — tryWait() is the non-blocking reap: None while the child runs, then wait() collects the
// exit. `sleep 1` is alive at the immediate tryWait, exits 0 after wait().
import std::process::{Command, Process, ExitStatus};
import std::io::{IoError};

fn int main() {
    Command c = Command.make(program: "sleep");
    c.arg(a: "1");
    Result<Process, IoError> sr = c.start();
    Process p = match (give sr) { case Ok(pr): { := give pr; } case Err(e): { return 110; } };

    Result<Optional<ExitStatus>, IoError> tw = p.tryWait();
    int32 phase1 = match (tw) {
        case Ok(opt): match (opt) { case None: 0; case Some(s): 111; };   // expect still-running
        case Err(e): 112;
    };
    if (phase1 != 0) { return phase1; }

    Result<ExitStatus, IoError> wr = p.wait();
    return match (wr) { case Ok(s): (s.success() ? 42 : 113); case Err(e): 114; };
}
