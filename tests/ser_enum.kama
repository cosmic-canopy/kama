// @generate on an enum: externally-tagged {"tag":"V"[,"value":{fields}]}, here as a nested field.
// Exercises a payload field named `w` (which must not shadow the Serializer parameter).
import std::serialization::json::{encode, decode};
@generate(Serialize, Deserialize)
enum Geo { Circle(int32 r), Rect(int32 w, int32 h), Empty }
@generate(Serialize, Deserialize, noOnConstruction)
type value Drawing { @field public int32 id; @field public Geo shape;
    public Drawing(int32 id, Geo shape) { this.id = id; this.shape = shape; } }
fn int main() {
    Drawing d = Drawing(id: 3, shape: Geo::Rect(w: 4, h: 5));
    Result<string, Owned<Error>> j_r = encode(v: d);
    string j = match (give j_r) { case Ok(__ok): give __ok; case Err(__e): { return 250; } };
    if (!j.equals(other: "{\"id\":3,\"shape\":{\"tag\":\"Rect\",\"value\":{\"w\":4,\"h\":5}}}")) { return 1; }
    Result<Drawing, Owned<Error>> res = decode::<Drawing>(src: give j);
    return match (res) { case Ok(b): b.id + (match (b.shape) { case Rect(w,h): w*h; case Circle(r): r; case Empty: 0; }); case Err(e): 0 - 1; };  // 23
}
