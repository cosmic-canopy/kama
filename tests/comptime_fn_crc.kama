// const-eval 6b-3 Stage 3 — the flagship: a `comptime fn` computes a 256-entry CRC-8 lookup table at
// COMPILE TIME and the compiler bakes it into a `static const` aggregate (.rodata / flash), zero runtime
// cost. This program then recomputes the same table at runtime and asserts every entry matches the baked
// one — so it proves the compile-time evaluation is bit-identical to the runtime algorithm.
//
// Exercises the whole array subsystem: a fixed-array local (`[0; 256]`), nested loops, narrow-integer wrap
// on cast, a ternary, and an array-element write `t[i] = …` (the table-fill primitive).

comptime fn InlineArray<uint8, 256> crcTable() {
    InlineArray<uint8, 256> t = [0; 256];
    for (int32 i = 0; i < 256; i = i + 1) {
        uint8 c = cast<uint8>(i);
        for (int32 k = 0; k < 8; k = k + 1) {
            c = ((c & 1) != 0) ? cast<uint8>((c >> 1) ^ 0x8C) : cast<uint8>(c >> 1);   // Dallas/Maxim poly
        }
        t[i] = c;
    }
    return t;
}

comptime InlineArray<uint8, 256> CRC = crcTable();   // baked: static const InlineArray_uint8_256 CRC = {.v={…}};

fn int main() {
    int32 mismatches = 0;
    for (int32 i = 0; i < 256; i = i + 1) {
        uint8 c = cast<uint8>(i);
        for (int32 k = 0; k < 8; k = k + 1) {
            c = ((c & 1) != 0) ? cast<uint8>((c >> 1) ^ 0x8C) : cast<uint8>(c >> 1);
        }
        if (CRC.get(index: i) != c) { mismatches = mismatches + 1; }
    }
    return mismatches;   // 0 — the baked (comptime) table equals the runtime computation
}
