// M26f-4 — a `resource` (destructible) VALUE opts into the `Copyable` contract by declaring a
// public nullary `copy` returning its own type. Its presence makes the give/copy marker MANDATORY
// ("scream when ambiguous"): `copy x` deep-copies (the source stays valid), `give x` moves. This
// exercises all four hand-off sites — init, argument, return, assignment — plus the give/copy split.
// Independence is proved by keeping every copy live to scope exit: a shallow copy would double-free
// (ASan traps), a deep copy frees N distinct heap buffers cleanly.

type resource Res implements Copyable {
    List<int32> items;                                      // owns a heap buffer
    public Res(int32 v) { this.items.add(item: v); }
    ~Res() { }                                              // resource (move-only); frees `items` too
    public fn Res copy() { Res r = Res(v: this.items[0]); return give r; }  // opt into Copyable
    public fn int32 head() { return this.items[0]; }
}

fn int32 twice(Res r) { return r.head() * 2; }              // r owned by callee, dropped at fn-end
fn Res clone(Res src) { return copy src; }                  // return a `copy`; src drops at fn-end

fn int32 main() {
    Res a = Res(v: 7);
    Res b = copy a;                 // init copy: a stays valid, b has its own buffer
    int32 t = twice(r: copy a);     // argument copy: fresh copy into the callee; a still valid
    Res c = clone(src: give b);     // argument give (move b into clone) + return copy
    Res d = Res(v: 100);
    d = copy a;                     // assignment copy: drop d's old value, deep-copy a into it
    return a.head() + c.head() + d.head() + t;   // 7 + 7 + 7 + 14 = 35   (a, c, d all drop cleanly)
}
