// `importsOnly` (KR-308) restricts the module that writes it and nobody else: the root writes none, so it
// imports every module its `visibility` lets it. The refusals are `xfail/mod_imports_only_*.d`.
import {
    imponly::audio::play,
    imponly::render::draw,
    imponly::render::detail::mix,
};

fn uint8 main() { return cast<uint8>(play() + draw() + mix()); }   // 3 + 10 + 23 = 36
