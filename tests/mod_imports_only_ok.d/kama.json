{
  "name": "imponly", "version": "0.1.0", "kind": "executable", "entry": "src/main.kama",
  "dependencies": { "units": { "path": "./vendor/units" } },

  "modules": {
    ".":      { "visibility": "internal" },
    "frame":  { "visibility": "internal" },
    "world":  { "visibility": "internal", "importsOnly": [] },
    "audio":  { "visibility": "internal", "importsOnly": ["frame", "world"] },
    "render": { "visibility": "internal", "importsOnly": ["frame", "world"],
                "modules": { "detail": { "visibility": "internal" } } },
    "sim":    { "visibility": "internal", "importsOnly": ["world", "std::math", "core", "units"] }
  }
}
