// RFC 6455 § 4.2.2: Sec-WebSocket-Accept = base64(SHA1(Sec-WebSocket-Key + GUID)) — the handshake the
// first external project needed a digest for, spelled with std::digest + std::encoding. Exit 0 on the
// RFC's own example.
import { std::digest::sha1::Sha1, std::encoding::base64::encode as b64Encode };

fn int32 main() {
    string key = "dGhlIHNhbXBsZSBub25jZQ==";
    string guid = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
    Sha1 h = Sha1.make();
    h.update(bytes: key.bytes());      // the string's own bytes, borrowed — no DynamicArray in sight
    h.update(bytes: guid.bytes());
    InlineArray<uint8>#(20) d = h.finish();
    string accept = b64Encode(bytes: d.view());
    return accept.equals(other: "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=") ? 0 : 1;
}
