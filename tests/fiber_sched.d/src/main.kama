// The fiber scheduler (KR-3, docs/design/fibers.md §8 step 2), driven from C until `spawn fiber` lands: park and
// unpark, round-robin yields, sleeps that wake in deadline order and never early, join, sockets that park a reader on
// an empty buffer and a writer on a full one, a read deadline, a wake from another thread, I/O polled while a fiber is
// always ready, the root parking (a join, a `scope`'s wait, a sleep) with a scope inside a fiber, and ten thousand
// short fibers. Run twice — on this host's own arm (epoll or kqueue, registered once) and on the Poller arm that
// Windows and poll(2) take — so both are tested here. Returns 42; else the failed check, plus 100 on the Poller arm.
extern "kama_sched.h";
extern "schedtest.h";
extern fn int32 fiber_sched_selftest();
extern fn int32 fiber_sched_selftest_poller();

unsafe fn int32 own() { return fiber_sched_selftest(); }
unsafe fn int32 poller() { return fiber_sched_selftest_poller(); }

fn uint8 main() {
    int32 a = own();
    if (a != 0) { return cast<uint8>(a); }
    int32 b = poller();
    return b == 0 ? 42 : cast<uint8>(100 + b);
}
