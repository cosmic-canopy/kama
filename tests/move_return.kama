import std::collections::{DynamicArray};
// M26f-2 — the factory case: `return give r` moves the local OUT (its dtor is suppressed in
// the factory), so the returned value is dropped exactly once by the caller — not twice (the
// "factory landmine"). One drop of code 3 -> trace 3.
extern fn void kama_trace(int32 code);
extern fn int32 kama_trace_get();
unsafe fn int32 traceGet() { return kama_trace_get(); }   // the FFI call, contained — `main` may not be `unsafe`

type resource Res {
    DynamicArray<int32> items;
    public ctor make(int32 v) { this.items.add(item: v); }
    unsafe ~Res() { kama_trace(code: 3); }
    public fn int32 head() { return this.items[0]; }
}

fn Res make(int32 n) {
    Res r = Res.make(v: n);
    return give r;            // move out — r's dtor suppressed here; the caller owns it
}

fn int32 build() {
    Res x = make(n: 9);       // fresh rvalue (call result) — bare
    return x.head();          // 9;  x drops at build's end -> exactly one trace(3)
}

fn int32 main() {
    int32 h = build();
    return h + traceGet();   // 9 + 3 = 12   (a double-drop would fold to 9 + 96)
}
