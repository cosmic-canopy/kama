// The POSITIVE case the conduit argument rests on: naming `Allocator` as a BOUND is perfectly safe.
// No `UnsafePtr` value exists here — the contract member is never invoked — so nothing needs a marker.
import { std::collections::DynamicArray };

type resource Holder<A: Allocator = GlobalAllocator> {
    int32 n;
    public ctor make() { this.n = 0; return this; }
    public fn int32 count() { return this.n; }
}

fn int32 main() {
    Holder h = Holder.make();
    DynamicArray<int32> xs = DynamicArray.empty();
    xs.add(item: 7);
    return h.count() + xs[0] - 7;
}
