import { std::collections::DynamicArray };
// Operator overloading combined with collections: sum a DynamicArray of `value` vectors via `+` in a foreach.
@generate(of)
type value Vec2
{
    public int32 x;
    public int32 y;
    public Vec2 operator+(Vec2 rhs) { return Vec2.of(x: this.x + rhs.x, y: this.y + rhs.y); }
}
fn int32 main()
{
    DynamicArray<Vec2> vs = DynamicArray.empty();
    vs.add(item: Vec2.of(x: 1, y: 2));
    vs.add(item: Vec2.of(x: 3, y: 4));
    vs.add(item: Vec2.of(x: 5, y: 6));
    Vec2 sum = Vec2.of(x: 0, y: 0);
    foreach (Vec2 v in vs) { sum = sum + v; }
    return sum.x * 10 + sum.y;   // (9,12) -> 102
}
