// A foreach BINDING is a locally-typed value, so passing one to a generic function must infer its type
// argument — exactly as passing a local does. It did not: the generics scan recorded a local declaration
// and a parameter, but never the loop variable, so a generic call inside a `foreach` demanded an explicit
// turbofish while the identical call one line outside the loop did not.
//
// This is a general hole in inference — it had nothing to do with contracts, and reproduced on the
// prelude's own generic. It surfaced while rewriting a fixture for the contract-scope rule, which is the
// only reason anyone noticed. Returns 42.
import { std::collections::DynamicArray };

fn Ordering cmp<T: Comparable<T>>(ref T a, ref T b) { return a.compareTo(other: b); }
fn T echoOf<T>(ref T x) { return copy x; }          // an unbounded generic — no contract involved

fn int32 main() {
    DynamicArray<int32> xs = DynamicArray::<int32>.empty();
    xs.add(item: 7); xs.add(item: 9);

    int32 total = 0;
    foreach (int32 v in xs) {
        total = total + echoOf(x: v);               // no turbofish
    }
    if (total != 16) { return 1; }

    // the same for a BOUNDED generic whose argument is the loop variable
    DynamicArray<string> ws = DynamicArray::<string>.empty();
    ws.add(item: "a"); ws.add(item: "b");
    string prev = "";
    bool ordered = true;
    foreach (string w in ws) {
        Ordering o = cmp(a: w, b: prev);            // no turbofish
        bool gt = match (o) { case Greater: true; case Less: false; case Equal: false; };
        if (!gt) { ordered = false; }
        prev = give w;
    }
    if (!ordered) { return 2; }

    return 42;
}
