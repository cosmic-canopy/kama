// A hand-written `ctor deserialize` override reads each field by naming the type — `T.deserialize(r: r)`,
// the same spelling the stdlib's own `decode<T>` uses — composing with the flat destructure-move
// `match (give …)` — Ok binds the value,
// Err propagates its boxed `Owned<Error>`. Proves: the override wins over the synth, a nested composite
// reads through the same spelling, and a malformed field surfaces as `Err(nothing)` via `.as<DeError>()`.
import { std::serialization::json::encode, std::serialization::json::decode };

@generate(Serializable, Deserializable)
type value Point {
    @field int32 x;
    @field int32 y;
    public ctor make(int32 x, int32 y) { this.x = x; this.y = y; }
    public fn int32 sum() { return this.x + this.y; }
}

@generate(Serializable, Deserializable)
type value Line {
    @field Point start;
    @field Point end;
    public ctor make(Point start, Point end) { this.start = start; this.end = end; }
    public fn int32 total() { return this.start.sum() + this.end.sum(); }

    // Hand-written deserialize: reads both Point fields by naming the type — the one way to spell it.
    public ctor Result<Line, Owned<Error>> deserialize(Deserializer r) {
        Point s = Point.make(x: 0, y: 0);
        Point e = Point.make(x: 0, y: 0);
        r.beginObject(count: 2);
        while (r.moreFields()) {
            // The two-arm read, which is the whole point of `FieldKey`: a NAMED backend reports the wire
            // name, a numbered or positional one reports an id, and a hand-written reader answers both so
            // the same body works with every backend — exactly as the derive does.
            FieldKey key = r.field();
            bool isStart = match (key) {
                case Name(name: n): n.equals(other: "start");
                case Id(id: i):     i == 0ui32;
            };
            Result<Point, Owned<Error>> __pr = Point.deserialize(r: r);
            Point p = match (give __pr) {
                case Ok(value: v):   { := give v; }                                // read succeeded -> bind the Point
                case Err(error: er): { return Result::Err(error: give er); }       // propagate the boxed error
            };
            if (isStart) { s = p; } else { e = p; }
        }
        Line ln = Line.make(start: s, end: e);
        return Result::Ok(value: ln);
    }
}

fn int32 main() {
    // good input -> the override reads both Points, round-trips to Ok
    Line ln = Line.make(start: Point.make(x: 30, y: 12), end: Point.make(x: 3, y: 5));
    Result<string, Owned<Error>> j_r = encode(v: ln);
    string j = match (give j_r) { case Ok(value: __ok): give __ok; case Err(error: __e): { return 250; } };
    Result<Line, Owned<Error>> good = decode::<Line>(src: give j);
    int32 okv = match (good) { case Ok(value: q): q.total(); case Err(error: e): 0 - 1; };   // 42 + 8 = 50

    // malformed start.x -> the sugar's read fails, the override returns Err(nothing)
    string bad = "{\"start\":{\"x\":!,\"y\":2},\"end\":{\"x\":3,\"y\":5}}";
    Result<Line, Owned<Error>> fail = decode::<Line>(src: give bad);
    int32 errv = match (fail) {
        case Ok(value: q): 0 - 2;                                   // must NOT succeed
        case Err(error: e): match (e.as<DeError>()) {               // recover the concrete deserialize error
            case Some(value: de): 100;
            case None:     0 - 3;
        };
    };
    return okv + errv;   // 50 + 100 = 150
}
