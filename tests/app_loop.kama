// std::app's loop on every host (KR-283): the app hears `Resumed`, then `SurfaceReady`, before its first tick, ticks
// until it says false, and is dropped when `run` returns, so `main` reads 55 from what it left behind. On the web `run`
// never returns (the host drives the loop), so the fifth tick quits with the code itself. Exit 55 either way.
import { std::app::App, std::app::Lifecycle, std::app::run, std::app::quit };

static int32 result = 0;

type resource Counter implements App {
    int32 ticks;
    int32 heard;   // 1 after Resumed, 2 after SurfaceReady; anything else out of order is 9
    public ctor make() { this.ticks = 0; this.heard = 0; }
    public fn bool tick() {
        if (this.heard != 2) { result = 1; return false; }   // a tick before both events
        this.ticks = this.ticks + 1;
        return this.ticks < 5 || done(code: 55);
    }
    public fn void lifecycle(Lifecycle event) {
        match (event) {
            case Resumed: { this.heard = this.heard == 0 ? 1 : 9; }
            case SurfaceReady: { this.heard = this.heard == 1 ? 2 : 9; }
            case _: { this.heard = 9; }
        };
    }
    ~Counter() { if (this.ticks == 5) { result = 55; } }
}

// The last tick: natively it ends the loop; on the web nothing after `run` will ever execute, so it quits.
@compileFor(!ARCH_WASM32) fn bool done(uint8 code) { return false; }
@compileFor(ARCH_WASM32)  fn bool done(uint8 code) { quit(code: code); return false; }

fn uint8 main() {
    Owned<App> app = new Counter.make();
    run(app: give app);
    return cast<uint8>(result);
}
