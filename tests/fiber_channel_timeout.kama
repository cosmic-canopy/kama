// A timed receive on a fiber parks with a deadline (KR-3 step 6): with nothing sent it answers `Err(Empty)` no earlier
// than asked, and the isolate's other fibers run while it waits; then it receives what a sibling sends late. On a fiber
// the deadline is the scheduler's timer, so the wait costs the core nothing.
// A fiber's 1 ms sleep resolves to the system timer on Windows, ~16 ms, until KR-3 step 8's high-resolution timer, so the
// waits here are long enough to hold several ticks there, and a few ticks are all the proof needs: blocked, it saw none.
import { std::concurrent::Fiber, std::concurrent::join, std::concurrent::Channel, std::concurrent::Sender,
         std::concurrent::Receiver, std::concurrent::RecvError, std::time::sleep, std::time::Duration,
         std::time::Instant, std::time::monotonicNow };

static int32 ticks = 0;
static bool done = false;

// 1 = an item (its value added to *got), 2 = Empty, 3 = Closed.
fn int32 kind(Result<int32, RecvError> r, ref int32 got) {
    return match (r) {
        case Ok(value: v): { got = got + v; := 1; }
        case Err(error: e): e == RecvError::Empty ? 2 : 3;
    };
}
fn int32 timed(Receiver<int32> rx) {
    int32 got = 0;
    Instant t = monotonicNow();
    if (kind(r: rx.recvTimeout(timeout: Duration.fromMillis(ms: 20i64)), got: ref got) != 2) { return 1; }
    if (t.elapsed().asMillis() < 20i64) { return 2; }                       // never early
    if (kind(r: rx.recvTimeout(timeout: Duration.fromSecs(s: 5i64)), got: ref got) != 1) { return 3; }
    done = true;
    return got;
}
fn void late(Sender<int32> tx) {
    sleep(d: Duration.fromMillis(ms: 100i64));
    _ = tx.send(item: 42);
}
fn void ticker(int64 every) {
    while (!done) { ticks = ticks + 1; sleep(d: Duration.fromMillis(ms: every)); }
}

fn uint8 main() {
    Channel<int32> ch = Channel.bounded(capacity: 1);
    Fiber<int32> t = spawn fiber timed(rx: ch.receiver());
    scope {
        spawn fiber late(tx: ch.sender());
        spawn fiber ticker(every: 1);
    }
    int32 r = join(fiber: give t);
    if (r != 42) { return cast<uint8>(r); }
    if (ticks < 3) { return 4; }                                           // the core ran the ticker meanwhile
    return 42;
}
