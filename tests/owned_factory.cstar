// Owned<T> factory: a function that returns an Owned<T> moves ownership out to
// the caller — the pointee survives the callee's unwind and is freed exactly
// once at the caller's scope exit (no callee-free, no leak, no double-free).
extern void cstar_trace(int code);
extern int cstar_trace_get();

class Node
{
    int32 id;
    Node(int32 id) { this.id = id; cstar_trace(code: 5); }
    ~Node() { cstar_trace(code: 6); }
}

Owned<Node> make(int32 v)
{
    Owned<Node> n = new Owned<Node>(id: v);   // construct -> 5
    return n;                                  // MOVE OUT (make's unwind no-ops)
}

int main()
{
    {
        Owned<Node> p = make(v: 7);   // p owns the Node
    }                                  // p drops here -> ~Node -> 6
    return cstar_trace_get();          // fold(5,6) = 161
}
