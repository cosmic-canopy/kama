// Construction-model M4b: fallible `new Type.name(...)` over a `Result`-returning ctor produces
// `Result<Owned<T>, E>` — allocate only on `Ok`, box the payload, propagate `Err` with no leak. Exercises
// the local-decl form (`Owned` + `Shared`) and the return position; the boxed handle is used then dropped
// (SAN leak-clean on BOTH the Ok path — the box is freed by the `Result`'s dtor — and the Err path, where
// nothing is allocated).
import std::memory::{Owned, Shared};

enum GaugeErr { Negative }
implements Error for GaugeErr { public fn string message() { return "negative"; } }

type resource Gauge {
    int32 v;
    public ctor Result<Gauge, GaugeErr> open(int32 v) {
        if (v < 0) { return Result::Err(error: GaugeErr::Negative); }   slot // fail before the object exists (no allocation)
        Gauge g; g.v = v; return Result::Ok(value: g);
    }
    public fn int32 get() { return this.v; }
}

// return-position fallible `new`: a resource-acquiring factory returns `Result<Owned<Gauge>, GaugeErr>`.
fn Result<Owned<Gauge>, GaugeErr> acquire(int32 v) {
    return new Gauge.open(v: v);
}

fn int32 main() {
    Result<Owned<Gauge>, GaugeErr>  ok  = new Gauge.open(v: 10);   // Ok  -> boxed `Owned`
    Result<Owned<Gauge>, GaugeErr>  bad = new Gauge.open(v: -5);   // Err -> propagated, nothing allocated
    Result<Shared<Gauge>, GaugeErr> sh  = new Gauge.open(v: 20);   // Ok  -> `Shared` box (ctrl block)
    Result<Owned<Gauge>, GaugeErr>  ret = acquire(v: 7);           // Ok  -> return-position `new`

    int32 a = match (ok)  { case Ok(value: g): g.get(); case Err(error: e): 0 - 1; };    // 10
    int32 b = match (bad) { case Ok(value: g): 100;     case Err(error: e): 0 - 1; };    // -1
    int32 c = match (sh)  { case Ok(value: g): g.get(); case Err(error: e): 0 - 1; };    // 20
    int32 d = match (ret) { case Ok(value: g): g.get(); case Err(error: e): 0 - 1; };    // 7
    return a + b + c + d;   // 10 - 1 + 20 + 7 = 36
}
