// A primitive's constructors are called on its name, as any type's are: `int32.parse(text: t)`, as `Date.parse(text: t)`.
// They come from the primitive's `type adapter` conformances (`Parseable` and `ParseableRadix` in std::fmt, `Ranged` in
// std::random), the same constructors a generic reaches through its parameter, `T.parse(text: s)`. Up to 0.9.910 only
// that second spelling compiled: the grammar refused a primitive's name before `.`, so std reached these constructors
// through free generic functions (`parse::<int32>(s: t)`), a second way to write what every other type writes as a
// constructor.
import { std::fmt::ParseError, std::fmt::Parseable, std::random::Rng };

fn T orZero<T: Parseable<T>>(const ref string s, T zero) {
    return match (T.parse(text: s)) { case Ok(value: v): v; case Err(error: e): zero; };
}

fn uint8 main() {
    int32 a = match (int32.parse(text: "-40")) { case Ok(value: v): v; case Err(error: e): 0; };                 // -40
    uint8 b = match (uint8.parse(text: "200")) { case Ok(value: v): v; case Err(error: e): 0ui8; };              // 200
    float64 c = match (float64.parse(text: "2.5")) { case Ok(value: v): v; case Err(error: e): 0.0; };           // 2.5
    bool d = match (bool.parse(text: "true")) { case Ok(value: v): v; case Err(error: e): false; };              // true
    int64 e = match (int64.parseRadix(text: "-ff", radix: 16ui64)) { case Ok(value: v): v; case Err(error: x): 0i64; };   // -255
    bool tooBig = match (uint8.parse(text: "256")) { case Ok(value: v): false; case Err(error: x): true; };      // OutOfRange
    int16 f = orZero::<int16>(s: "12", zero: 0i16);                                                            // 12, generically
    Rng g = Rng.fromSeed(seed: 7ui64);
    int32 h = int32.between(rng: g, lo: 3, hi: 4);                                                            // 3, the one value
    if (a != -40 || b != 200ui8 || c != 2.5 || !d || e != -255i64 || !tooBig || f != 12i16 || h != 3) { return 1; }
    return 42;
}
