import std::memory::{Owned};
// Owned<T>: heap construction, auto-deref method calls, RAII free.
type value Counter
{
    int32 value;
    public ctor make(int32 start) { this.value = start; }
    public fn void bump() { this.value = this.value + 1; }
    public fn int32 get() { return this.value; }
}

fn int32 main()
{
    Owned<Counter> c = new Counter.make(start: 40);
    c.bump();
    c.bump();
    return c.get();   // 42
}
