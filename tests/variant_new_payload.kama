import std::memory::{Shared};
type resource Probe { int32 id; public ctor make(int32 id){ this.id=id; } ~Probe(){} public fn int32 val(){return this.id;} }
// A `Shared` factory — `new` heap-places into a local owner that moves out as a fresh rvalue,
// handed straight into the variant payload with no marker.
fn Shared<Probe> mk(int32 id) { Shared<Probe> s = new Probe.make(id: id); return s; }
fn int main()
{
    Optional<Shared<Probe>> o = Optional::Some(value: mk(id: 42));
    Optional<Shared<Probe>> e = Optional::None;
    int32 a = match (o) { case Some(value: p): p.val(); case None: 0; };
    int32 b = match (e) { case Some(value: p): p.val(); case None: 7; };
    return a + b;
}
