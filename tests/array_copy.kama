import { std::collections::FixedArray };
// `copy` of an `FixedArray<T>` whose element is Copyable makes a deep, independent copy (fresh buffer,
// each element copied). Mutating the copy must not touch the original. ASan proves independence:
// a shallow copy would alias + double-free the one buffer at scope exit.
fn int32 main() {
    FixedArray<int32> a = FixedArray.make(size: 3);
    a[0] = 10; a[1] = 20; a[2] = 12;
    FixedArray<int32> b = copy a;     // deep copy — b owns its own buffer
    b[0] = 0;                    // mutate the copy only
    return a[0] + a[1] + a[2] + b[1] + b[2];   // 10+20+12 + 20+12 = 74
}
