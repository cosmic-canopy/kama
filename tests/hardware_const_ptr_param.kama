// MCU step 2: `const hardware UnsafePtr<T>` lowers to `const volatile T*` — a read-only status register
// (volatile so each read re-fetches; const so the driver can't write through it).
unsafe fn uint32 peek(const hardware UnsafePtr<uint32> reg) { return reg[0]; }

unsafe fn int32 main() {
    uint32 cell = 42;
    return cast<int32>(peek(reg: addr(of: cell)));   // 42
}
