import std::memory::{Owned};
// B4 — inline `new Concrete` returned as an Owned<Contract>: the fat box {obj, vtbl} is built in a hoisted
// temp and moved out; dispatch/drop go through the vtable.
type contract Shape for both { fn int32 area(); }
type value Square implements Shape { int32 s; public ctor make(int32 s){ slot Square r; r.s = s; return give r; } public fn int32 area(){ return this.s*this.s; } }
fn Owned<Shape> make(int32 s) { return new Square.make(s: s); }
fn int32 main() { Owned<Shape> a = make(s: 7); return a.area(); }
