// M6.1: store / load / swap across an isolate boundary. A child stores 1 into a shared flag; after the
// scope barrier main loads it (1), then atomically swaps in 5 (returning the prior 1) and loads again (5).
// Covers the non-arithmetic ops (store, load, swap) that also apply to a `Ptr` cell. 1 + 1 + 5 = 7.
import std::concurrent::{Atomic};

fn void setter(ref Atomic<int32> f) { f.store(value: 1i32); }

fn int main() {
    Atomic<int32> flag = Atomic::make(value: 0i32);
    scope { spawn setter(f: ref flag); }     // BARRIER: the store is visible after the join
    int32 seen = flag.load();                // 1
    int32 prev = flag.swap(value: 5i32);     // prior value 1
    return seen + prev + flag.load();        // 1 + 1 + 5 = 7
}
