// Construction-model M4b FOLLOW-ON: fallible placement `new(allocator: a) Type.name(...)` — the pointee is
// drawn from a caller-owned arena ONLY on `Ok` and adopted through `adoptIn`; the `Err` path allocates
// nothing. Exercises BOTH axes: a concrete `Owned<Gauge, BumpAllocator>` (library HeapOwner, `adoptIn`) AND
// the cross-product interface `Owned<Shape, BumpAllocator>` (fat handle drawn from the arena). SAN/arena
// leak-clean on both paths.
import std::memory::{Owned};
import std::collections::{Arena, BumpAllocator};

type enum OpenErr implements Error {
    Negative;

    public fn string message() { return "negative"; }
}

type value Gauge {
    int32 v;
    public ctor Result<Gauge, OpenErr> open(int32 v) {
        if (v < 0) { return Result::Err(error: OpenErr::Negative); }
        this.v = v; return Result::Ok(value: this);
    }
    public fn int32 get() { return this.v; }
}

type contract Shape for both { fn int32 area(); }

type value Circle implements Shape {
    int32 r;
    public ctor Result<Circle, OpenErr> open(int32 r) {
        if (r < 0) { return Result::Err(error: OpenErr::Negative); }
        this.r = r; return Result::Ok(value: this);
    }
    public fn int32 area() { return this.r * this.r; }
}

fn int32 main() {
    Arena arena = Arena.make(capacity: 1 << 12);   // declared FIRST → drops LAST (outlives the boxes)

    // concrete + placement: `adoptIn(raw, alloc)` into a library HeapOwner box
    Result<Owned<Gauge, BumpAllocator>, OpenErr> g  = new(allocator: arena.handle()) Gauge.open(v: 10);
    Result<Owned<Gauge, BumpAllocator>, OpenErr> gb = new(allocator: arena.handle()) Gauge.open(v: -1);  // Err, no alloc

    // interface + placement (cross-product): fat handle drawn from the arena
    Result<Owned<Shape, BumpAllocator>, OpenErr> s  = new(allocator: arena.handle()) Circle.open(r: 6);
    Result<Owned<Shape, BumpAllocator>, OpenErr> sb = new(allocator: arena.handle()) Circle.open(r: -1); // Err, no alloc

    int32 a = match (g)  { case Ok(value: x): x.get();  case Err(error: e): 0 - 1; };   // 10
    int32 b = match (gb) { case Ok(value: x): 100;      case Err(error: e): 0 - 1; };   // -1
    int32 c = match (s)  { case Ok(value: x): x.area(); case Err(error: e): 0 - 1; };   // 36
    int32 d = match (sb) { case Ok(value: x): 100;      case Err(error: e): 0 - 1; };   // -1
    return a + b + c + d;   // 10 - 1 + 36 - 1 = 44
}
