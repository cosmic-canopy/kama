// Regression: dropping a `Shared` cycle with a `Weak` back-edge must not use-after-free the shared control
// block. Node `a` owns `b` (Shared forward edge); `b` holds a `Weak` back-edge to `a`. When `a` (the root)
// drops, its pointee dtor drops `b`, whose dtor drops the `Weak` back into `a`'s Ctrl — that `Weak` drop must
// NOT free the Ctrl while `a`'s own drop still needs it (the last strong handle releases `strong` only AFTER
// the pointee dtor). Latent before the fix: benign at -O0, a UAF crash at -O2 / on wasm. Each node owns a
// heap `List` so the pointee dtor is non-trivial. Returns a.val() = 10.
import std::memory::{Shared, Weak};
import std::collections::{List};

type resource Node {
    List<int32> data;                                  // owns heap -> a real pointee dtor runs on cycle drop
    Optional<Shared<Node>> next;                       // forward edge (owns)
    Optional<Weak<Node>> back;                          // back edge (weak) — breaks the ownership cycle
    public Node(int32 v) { this.data.add(item: v); this.next = Optional::None; this.back = Optional::None; }
    public fn void setNext(Shared<Node> n) { this.next = Optional::Some(value: give n); }
    public fn void setBack(Weak<Node> w) { this.back = Optional::Some(value: give w); }
    public fn int32 val() { return this.data[0]; }
}

fn int main() {
    Shared<Node> a = new Node(v: 10);
    Shared<Node> b = new Node(v: 20);
    b.setBack(w: a.downgrade());                        // b -> a (weak back-edge)
    a.setNext(n: give b);                               // a -> b (owns); a is the root
    return a.val();                                     // 10; `a` drops here -> cycle teardown
}
