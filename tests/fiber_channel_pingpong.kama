// Two fibers on one isolate talking over channels (KR-3 step 6, fibers.md decision 8). A receive with nothing queued
// parks the fiber, not the thread, so the isolate's other fiber runs and answers. Before 0.9.751 the first `recv` blocked
// the thread on a condition variable, and the only fiber that could send never ran again: the isolate deadlocked.
// Both directions are a rendezvous (capacity 0), so every send parks too, until its value is taken.
import { std::concurrent::Fiber, std::concurrent::Channel, std::concurrent::Sender,
         std::concurrent::Receiver };

// One side of the conversation: where it speaks and where it listens.
type resource Ends {
    Sender<int32> to;
    Receiver<int32> back;
    public ctor make(Sender<int32> to, Receiver<int32> back) { this.to = give to; this.back = give back; }
    public fn bool say(int32 v) {
        return match (this.to.send(item: v)) { case Ok(value: u): true; case Err(error: e): false; };
    }
    public fn int32 hear() {
        return match (this.back.recv()) { case Some(value: v): v; case None: -1; };
    }
}

// Sends 1..1000 and checks each answer is one more; the sum of the answers comes back.
fn int32 ping(Ends e) {
    int32 sum = 0;
    for (int32 i = 1; i <= 1000; i = i + 1) {
        if (!e.say(v: i)) { return -1; }
        int32 a = e.hear();
        if (a != i + 1) { return -2; }
        sum = sum + a;
    }
    return sum;
}

// Answers each value with one more until its listener closes.
fn int32 pong(Ends e) {
    int32 n = 0;
    int32 v = e.hear();
    while (v >= 0) {
        if (!e.say(v: v + 1)) { return -1; }
        n = n + 1;
        v = e.hear();
    }
    return n;
}

fn uint8 main() {
    Channel<int32> there = Channel.bounded(capacity: 0);
    Channel<int32> back = Channel.bounded(capacity: 0);
    Ends a = Ends.make(to: there.sender(), back: back.receiver());
    Ends b = Ends.make(to: back.sender(), back: there.receiver());
    Fiber<int32> p = spawn fiber pong(e: give b);
    Fiber<int32> q = spawn fiber ping(e: give a);
    int32 sum = give q.join();      // ping ends, its sender drops, and pong hears the close
    int32 answered = give p.join();
    if (sum != 501500) { return 1; }      // 2 + 3 + … + 1001
    if (answered != 1000) { return 2; }
    return 42;
}
