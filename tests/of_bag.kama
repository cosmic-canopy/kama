// Construction-model M6: `@generate(of)` synthesizes a memberwise ctor `V.of(f: …)` on a transparent value
// (a data bag — all fields public). Exercises direct construction, public-field read-back, and `new V.of(...)`
// composing with the synthesized ctor to box into `Owned<V>` (field access forwarded through `Deref`).
import std::memory::{Owned};

@generate(of)
type value Point {
    public int32 x;
    public int32 y;
}

fn int32 main() {
    Point p = Point.of(x: 30, y: 12);           // synthesized memberwise ctor
    Owned<Point> o = new Point.of(x: 5, y: 5);   // `new` composes with the bag ctor
    return p.x + p.y + o.x + o.y;                // 42 + 10 = 52
}
