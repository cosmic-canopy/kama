// Nested @generate(Deserializable) — the bypass-ctor payoff: a nested resource field, an Optional<nested>, and a
// DynamicArray<nested> all reconstruct via direct in-place field-set (`result.child = Child::deserialize(r)`), no ctor
// and no move-out-of-holder — which the old all-args-ctor model couldn't express for a nested resource.
import { std::serialization::json::serializeJsonBuffer, std::serialization::json::deserializeJsonBuffer, std::collections::DynamicArray };

@generate(Serializable, Deserializable)
type resource Child {
    @field int32 v;
    @field string tag;
    public ctor make(int32 v, string tag) { this.v = v; this.tag = give tag; }
    public fn int32 weight() { return this.v + cast<int32>(this.tag.length()); }
}

@generate(Serializable, Deserializable)
type resource Parent {
    @field int32 id;
    @field Child main;                 // nested resource field (direct)
    @field Optional<Child> maybe;      // Optional<nested>
    @field DynamicArray<Child> kids;           // DynamicArray<nested>
    public ctor make(int32 id, Child main, Optional<Child> maybe, DynamicArray<Child> kids) { this.id = id; this.main = give main; this.maybe = give maybe; this.kids = give kids; }
    public fn int32 total() {
        int32 s = this.id + this.main.weight();
        int32 m = match (this.maybe) { case Some(value: c): c.weight(); case None: 0; };
        s = s + m;
        for (isize i = 0; i < this.kids.length(); i = i + 1) { s = s + this.kids[i].weight(); }
        return cast<int32>(s);
    }
}

fn int32 main() {
    Child mainC = Child.make(v: 5, tag: "xyz");            // weight 8
    Child kid1  = Child.make(v: 1, tag: "a");              // weight 2
    Child kid2  = Child.make(v: 2, tag: "bb");             // weight 4
    DynamicArray<Child> ks = DynamicArray.empty();
    ks.add(item: give kid1);
    ks.add(item: give kid2);
    Child mc = Child.make(v: 3, tag: "qq");                // weight 5
    Optional<Child> mb = Optional::Some(value: give mc);
    Parent p = Parent.make(id: 10, main: give mainC, maybe: give mb, kids: give ks);
    Result<string, Owned<Error>> j_r = serializeJsonBuffer(v: p);
    string j = match (give j_r) { case Ok(value: __ok): give __ok; case Err(error: __e): { return 250; } };
    Result<Parent, Owned<Error>> res = deserializeJsonBuffer::<Parent>(src: give j);
    return match (res) { case Ok(value: q): q.total(); case Err(error: e): 0 - 1; };   // 10 + 8 + 5 + (2+4) = 29
}
