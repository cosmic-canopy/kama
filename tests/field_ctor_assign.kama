// Milestone B1 — a bare in-place ctor assigned to a class-typed lvalue (`this.m = Map.empty()`, `x = Point(...)`)
// constructs directly into the place, like a local-init stackCtor. Covers: a generic ctor into a field
// (Map/DynamicArray), a reassignment that re-inits (drops the old value — ASan-checked), and a non-generic ctor
// with args into a field + a local reassignment. Previously each required "bind to a local first".
import std::collections::{Map, DynamicArray};

@generate(of)
type value Point {
    public int32 x; public int32 y;
    public fn int32 sum() { return this.x + this.y; }
}

type resource Registry {
    Map<int32, int32> m;
    DynamicArray<int32> log;
    Point origin;
    public ctor make() { slot Registry r; r.m = Map.empty(); r.log = DynamicArray.empty(); r.origin = Point.of(x: 1, y: 2); return give r; }
    public fn void put(int32 k, int32 v) { this.m.put(key: k, value: v); this.log.add(item: k); }
    public fn void reset() { this.m = Map.empty(); }                 // re-init: drops the old map, builds a fresh one
    public fn void moveOrigin(int32 x, int32 y) { this.origin = Point.of(x: x, y: y); }
    public fn int32 score() { return this.m.length() + this.log.length() + this.origin.sum(); }
}

fn int32 main() {
    Registry r = Registry.make();
    r.put(k: 1, v: 10); r.put(k: 2, v: 20); r.put(k: 1, v: 99);   // m:{1,2}, log:[1,2,1]
    r.reset();                                                     // m:{}
    r.put(k: 5, v: 50);                                            // m:{5}, log:[1,2,1,5]
    r.moveOrigin(x: 3, y: 4);                                      // origin sum 7

    // a local reassignment to a fresh generic ctor, too
    Map<int32, int32> local = Map.empty();
    local.put(key: 9, value: 9);
    local = Map.empty();                                                 // re-init the local
    local.put(key: 8, value: 8); local.put(key: 7, value: 7);

    return r.score() + local.length();   // (1 + 4 + 7) + 2 = 14
}
