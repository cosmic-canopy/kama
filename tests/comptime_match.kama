// `match` at compile time (KR-417), by the run-time rules: a plain enum, an enum with payloads bound by field name (a `_`
// binds nothing), an `Optional`, an arm's expression or block whose `:=` is its value, and `_`. Inside an arm,
// `return` leaves the `comptime fn`, and `break` and `continue` reach its loop, from a `match` used as a value and as a
// statement, from a call's argument and from a nested `match`, as at run time. It runs in a `comptime fn`, in a value
// type's method run at compile time, and as the initializer of a module `comptime`, a `static` and a `comptime` local,
// which are typed positions as a local's initializer is. Through 0.9.1009 every `match` there was an "unsupported
// expression", so an enum held at compile time could be read only at run time.
//
// Two defects the same values went through, fixed with it: an enum declared `: int64` was 32 bits at compile time, so
// `Wide::Hi` (5000000000) handed to a `comptime fn` came back 705032704 and `Wide::Lo` (int64's minimum) came back 0;
// and a type's constant of enum type was taken for a number, so `match (Pen::DEF)` was refused even at run time.
//
// Exit 42, or the failed check's number.
type enum Color { Red, Green, Blue }
type enum Shape { Circle(int32 r), Rect(int32 w, int32 h), Dot }
type enum Wide : int64 { Lo = -9223372036854775807i64 - 1i64, Hi = 5000000000i64 }
type enum Byte : uint8 { P = 200, Q = 255 }

comptime fn int32 code(Color c) { return match (c) { case Red: 1; case Green: 2; case Blue: 3; }; }
comptime fn int32 area(Shape s) {
    return match (s) { case Circle(r: r): 3 * r * r; case Rect(w: w, h: h): w * h; case Dot: 0; };
}
comptime fn int32 width(Shape s) { return match (s) { case Rect(w: w, h: _): w; case _: -1; }; }
comptime fn int32 plusOne(Optional<int32> o) { return match (o) { case Some(value: v): v + 1; case None: -1; }; }
comptime fn int32 blockArm(Shape s) {
    int32 t = match (s) {
        case Rect(w: w, h: h): { int32 q = w + h; := q * 2; }
        case _: 7;
    };
    return t;
}
comptime fn int32 asStatement(Color c) {
    int32 x = 0;
    match (c) {
        case Red: x = 10;
        case _: { x = 20; }
    };
    return x;
}

// Flow out of an arm: the run-time answers are 2, 40, 300000 and 2002, 4040, 3300000.
comptime fn int32 flowValue(Color c) {
    int32 t = 0;
    for (int32 i = 0; i < 5; i = i + 1) {
        int32 x = match (c) {
            case Red: { if (i == 2) { break; } := 1; }
            case Green: { if (i == 1) { continue; } := 10; }
            case Blue: { if (i == 3) { return t * 1000; } := 100; }
        };
        t = t + x;
    }
    return t;
}
comptime fn int32 flowStatement(Color c) {
    int32 t = 0;
    for (int32 i = 0; i < 5; i = i + 1) {
        match (c) {
            case Red: { if (i == 2) { break; } t = t + 1; }
            case Green: { if (i == 1) { continue; } t = t + 10; }
            case Blue: { if (i == 3) { return t * 1000; } t = t + 100; }
        };
        t = t + 1000;
    }
    return t;
}
comptime fn int32 id(int32 v) { return v; }
comptime fn int32 nested(Shape s, Color c) {
    int32 a = id(v: match (s) { case Dot: { return -5; } case _: 3; });   // from a call's argument
    int32 b = match (c) {
        case Red: match (s) { case Rect(w: w, h: _): w; case _: 0; };
        case _: { int32 q = match (s) { case Circle(r: r): { return r * 7; } case _: 2; }; := q + 1; }
    };
    return a * 100 + b;
}
// A variant's place types the arm's value (`Optional::None`), and an enum's value is a value of it.
comptime fn int32 typed(Color c) {
    Optional<int32> o = match (c) { case Red: Optional::Some(value: 4); case _: Optional::None; };
    Color d = match (c) { case Red: Color::Blue; case Green: Color::Red; case Blue: Color::Green; };
    int32 e = match (d) { case Green: 1; case _: 2; };
    int32 p = c == Color::Red ? match (o) { case Some(value: v): v; case None: 9; } : 7;
    return e * 10 + p;
}

comptime fn int64 wideOf(Wide w) { return cast<int64>(w); }
comptime fn int64 wideLocal(Wide w) { Wide l = w; return cast<int64>(l); }
comptime fn int32 wideArm(Wide w) { return match (w) { case Lo: 10; case Hi: 20; }; }
comptime fn int32 byteArm(Byte b) { return match (b) { case P: 1; case Q: 2; }; }

type value Pen {
    public Color c;
    public Wide w;
    public InlineArray<Color>#(3) all;
    public ctor make(Color c) {
        this.c = c;
        this.w = Wide::Hi;
        InlineArray<Color>#(3) t = [Color::Red, Color::Green, Color::Blue];
        this.all = t;
    }
    public fn int32 code() { return match (this.c) { case Red: 100; case Green: 200; case Blue: 300; }; }
    public fn int32 sum() {
        int32 t = 0;
        foreach (Color x in this.all) { int32 d = match (x) { case Red: 1; case Green: 10; case Blue: 100; }; t = t + d; }
        return t;
    }
    public fn int64 wide() { return cast<int64>(this.w); }
    public comptime Color DEF = Color::Blue;
}

comptime Color C = Color::Green;
comptime Shape S = Shape::Rect(w: 2, h: 5);
comptime int32 CODE = code(c: Color::Green);
comptime int32 AREA = area(s: Shape::Rect(w: 3, h: 4));
comptime int32 AREA_S = area(s: S);
comptime int32 WIDTH = width(s: Shape::Rect(w: 6, h: 1));
comptime int32 PLUS = plusOne(o: Optional::Some(value: 41));
comptime int32 BLOCK = blockArm(s: Shape::Rect(w: 2, h: 3));
comptime int32 STMT = asStatement(c: Color::Red);
comptime int32 FV_R = flowValue(c: Color::Red);
comptime int32 FV_G = flowValue(c: Color::Green);
comptime int32 FV_B = flowValue(c: Color::Blue);
comptime int32 FS_R = flowStatement(c: Color::Red);
comptime int32 FS_G = flowStatement(c: Color::Green);
comptime int32 FS_B = flowStatement(c: Color::Blue);
comptime int32 N1 = nested(s: Shape::Dot, c: Color::Red);
comptime int32 N2 = nested(s: Shape::Rect(w: 6, h: 1), c: Color::Red);
comptime int32 N3 = nested(s: Shape::Circle(r: 3), c: Color::Green);
comptime int32 N4 = nested(s: Shape::Rect(w: 6, h: 1), c: Color::Blue);
comptime int32 T1 = typed(c: Color::Red);
comptime int32 T2 = typed(c: Color::Green);
comptime int64 W_HI = wideOf(w: Wide::Hi);
comptime int64 W_LO = wideLocal(w: Wide::Lo);
comptime int32 W_ARM = wideArm(w: Wide::Lo);
comptime int32 B_ARM = byteArm(b: Byte::Q);
comptime int32 PEN_CODE = Pen.make(c: Color::Red).code();
comptime int32 PEN_SUM = Pen.make(c: Color::Red).sum();
comptime int64 PEN_WIDE = Pen.make(c: Color::Red).wide();

// A constant's initializer is a typed position: its value is the arm's, and a loop inside an arm block is its own.
comptime int32 DIRECT = match (C) { case Red: 1; case Green: 2; case Blue: 3; };
comptime int32 DIRECT_S = match (S) { case Rect(w: w, h: h): w * h; case _: 0; };
comptime int32 DIRECT_TYPE = match (Pen::DEF) { case Blue: 7; case _: 0; };
comptime int32 DIRECT_WIDE = match (Wide::Hi) { case Lo: 1; case Hi: 2; };
comptime int32 LOOPED = match (Color::Green) {
    case Green: {
        int32 t = 0;
        for (int32 i = 0; i < 10; i = i + 1) { if (i == 4) { break; } if (i == 1) { continue; } t = t + i; }
        := t;
    }
    case _: 0;
};
static int32 g_static = match (C) { case Green: 20; case _: 0; };

fn uint8 main() {
    comptime int32 LOCAL = match (C) { case Green: 5; case _: 0; };
    if (CODE != 2 || AREA != 12 || AREA_S != 10 || WIDTH != 6 || PLUS != 42) { return 1; }
    if (BLOCK != 10 || STMT != 10) { return 2; }
    if (FV_R != 2 || FV_G != 40 || FV_B != 300000) { return 3; }
    if (FS_R != 2002 || FS_G != 4040 || FS_B != 3300000) { return 4; }
    if (N1 != -5 || N2 != 306 || N3 != 21 || N4 != 303) { return 5; }
    if (T1 != 24 || T2 != 27) { return 6; }
    if (W_HI != 5000000000i64 || W_LO != -9223372036854775807i64 - 1i64) { return 7; }
    if (W_ARM != 10 || B_ARM != 2) { return 8; }
    if (PEN_CODE != 100 || PEN_SUM != 111 || PEN_WIDE != 5000000000i64) { return 9; }
    if (DIRECT != 2 || DIRECT_S != 10 || DIRECT_TYPE != 7 || DIRECT_WIDE != 2 || LOOPED != 5) { return 10; }
    if (g_static != 20 || LOCAL != 5) { return 11; }
    // The same type constant as a run-time subject.
    int32 rt = match (Pen::DEF) { case Blue: 8; case _: 0; };
    if (rt != 8) { return 12; }
    return 42;
}
