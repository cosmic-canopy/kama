// A GENERIC heap smart pointer written in kama: `Own<T> implements Deref<T>, DerefMut<T>` — a generic class
// implementing a generic contract parameterized by its OWN type param. When `Own<Point>` monomorphizes,
// `implements Deref<T>, DerefMut<T>` resolves to `Deref_Point` and auto-deref forwards `o.sum()`/`o.x` to the heap
// pointee. This is the exact shape a library `Owned<T>` needs — the prerequisite for porting the
// intrinsic smart pointers out of the compiler.
extern "<stdlib.h>";
extern fn UnsafePtr malloc(usize n);
extern fn void free(UnsafePtr p);

@generate(of)
type value Point {
    public int32 x; public int32 y;
    public fn int32 sum() { return this.x + this.y; }
}

type resource Own<T> implements Deref<T>, DerefMut<T> {
    UnsafePtr<T> p;
    public unsafe ctor make(T v) { this.p = cast<UnsafePtr<T>>(malloc(n: sizeof(T))); this.p[0] = v; }
    public unsafe const fn const ref T deref() { return this.p[0]; }
    public unsafe fn ref T derefMut() { return this.p[0]; }
    unsafe ~Own() { free(p: cast<UnsafePtr>(this.p)); }
}

fn int32 main() {
    Own<Point> o = Own.make(v: Point.of(x: 30, y: 12));
    return o.sum() + o.x;   // 42 + 30 = 72 (RAII frees the heap Point)
}
