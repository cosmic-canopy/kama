// Weak polymorphic ref + a DESTRUCTIBLE implementer: the object's ~dtor runs (via vtbl->__dtor) when
// strong hits 0 even with an outstanding weak; the control block frees when the last weak drops.
// LeakSanitizer-clean == both freed exactly once across the strong/weak lifetimes.
extern "<stdlib.h>";
extern fn UnsafePtr malloc(usize n);
extern fn void free(UnsafePtr p);
type value Ctrl { public int32 strong; public int32 weak; }
type contract Shape for resource { fn int32 area(); }
type resource Circle implements Shape {
    UnsafePtr<int32> buf;
    public unsafe ctor make(int32 r) { this.buf = cast<UnsafePtr<int32>>(malloc(n: sizeof(int32))); this.buf[0] = r; }
    public unsafe fn int32 area() { return this.buf[0] * this.buf[0]; }
    unsafe ~Circle() { free(p: cast<UnsafePtr>(this.buf)); }
}
type resource RcWeak<T> {
    UnsafePtr<T> p; UnsafePtr<Ctrl> c;
    public unsafe ctor make(UnsafePtr<T> p, UnsafePtr<Ctrl> c) { this.p = p; this.c = c; }
    public unsafe fn Optional<Rc<T>> tryUpgrade() {
        if (this.c[0].strong > 0) { this.c[0].strong = this.c[0].strong + 1; return Optional::Some(value: Rc.make(p: this.p, c: this.c)); }
        return Optional::None;
    }
    unsafe ~RcWeak() { this.c[0].weak = this.c[0].weak - 1; if (this.c[0].strong == 0 && this.c[0].weak == 0) { free(p: cast<UnsafePtr>(this.c)); } }
}
type resource Rc<T> implements Deref<T>, HeapOwner<T>, Copyable<This>(bare: copy) {
    UnsafePtr<T> p; UnsafePtr<Ctrl> c;
    public unsafe ctor make(UnsafePtr<T> p, UnsafePtr<Ctrl> c) { this.p = p; this.c = c; }
    public unsafe ctor adopt(UnsafePtr<T> raw) { UnsafePtr<Ctrl> k = null; k = cast<UnsafePtr<Ctrl>>(malloc(n: sizeof(Ctrl))); k[0].strong = 1; k[0].weak = 0; return Rc.make(p: raw, c: k); }
    public unsafe fn ref T deref() { return this.p[0]; }
    public unsafe ctor copy(ref Rc<T> source) { source.c[0].strong = source.c[0].strong + 1; return Rc.make(p: source.p, c: source.c); }
    public unsafe fn RcWeak<T> downgrade() { this.c[0].weak = this.c[0].weak + 1; return RcWeak.make(p: this.p, c: this.c); }
    unsafe ~Rc() { this.c[0].strong = this.c[0].strong - 1; if (this.c[0].strong == 0) { drop(value: this.deref()); free(p: cast<UnsafePtr>(this.p)); if (this.c[0].weak == 0) { free(p: cast<UnsafePtr>(this.c)); } } }
}
// Build the strong ref, hand back a weak one through `out`, and let the strong drop on the way out —
// which is what makes the weak dangle for the upgrade attempt below.
fn int32 makeAndWeaken(int32 r, out RcWeak<Shape> w) {
    Rc<Shape> a = new Circle.make(r: r);
    w = a.downgrade();
    return a.area();            // 49, read while `a` is still live
}   // a drops: strong 0 -> Circle __dtor frees buf; ctrl stays (weak=1)

fn int32 main() {
    slot RcWeak<Shape> w;
    int32 v = makeAndWeaken(r: 7, w: out w);
    Optional<Rc<Shape>> o = w.tryUpgrade();
    int32 up = match (o) { case Some(value: r): r.area(); case None: 0; };   // 0 (expired)
    return v + up;                  // 49
}
