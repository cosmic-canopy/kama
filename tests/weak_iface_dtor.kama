// Weak polymorphic ref + a DESTRUCTIBLE implementer: the object's ~dtor runs (via vtbl->__dtor) when
// strong hits 0 even with an outstanding weak; the control block frees when the last weak drops.
// LeakSanitizer-clean == both freed exactly once across the strong/weak lifetimes.
extern "<stdlib.h>";
extern fn Ptr malloc(usize n);
extern fn void free(Ptr p);
type value Ctrl { public int32 strong; public int32 weak; }
type contract Shape for both { fn int32 area(); }
type resource Circle implements Shape {
    Ptr<int32> buf;
    public ctor make(int32 r) { unsafe { this.buf = cast<Ptr<int32>>(malloc(n: sizeof(int32))); this.buf[0] = r; } }
    public fn int32 area() { unsafe { return this.buf[0] * this.buf[0]; } }
    ~Circle() { unsafe { free(p: cast<Ptr>(this.buf)); } }
}
type resource RcWeak<T> {
    Ptr<T> p; Ptr<Ctrl> c;
    public ctor make(Ptr<T> p, Ptr<Ctrl> c) { this.p = p; this.c = c; }
    public fn Optional<Rc<T>> tryUpgrade() {
        unsafe { if (this.c[0].strong > 0) { this.c[0].strong = this.c[0].strong + 1; return Optional::Some(value: Rc.make(p: this.p, c: this.c)); } }
        return Optional::None;
    }
    ~RcWeak() { unsafe { this.c[0].weak = this.c[0].weak - 1; if (this.c[0].strong == 0 && this.c[0].weak == 0) { free(p: cast<Ptr>(this.c)); } } }
}
type resource Rc<T> implements Deref<T>, HeapOwner<T>, Copyable(bare: copy) {
    Ptr<T> p; Ptr<Ctrl> c;
    public ctor make(Ptr<T> p, Ptr<Ctrl> c) { this.p = p; this.c = c; }
    public ctor adopt(Ptr<T> raw) { Ptr<Ctrl> k = null; unsafe { k = cast<Ptr<Ctrl>>(malloc(n: sizeof(Ctrl))); k[0].strong = 1; k[0].weak = 0; } return Rc.make(p: raw, c: k); }
    public fn ref T deref() { unsafe { return this.p[0]; } }
    public ctor copy(ref Rc<T> source) { unsafe { source.c[0].strong = source.c[0].strong + 1; } return Rc.make(p: source.p, c: source.c); }
    public fn RcWeak<T> downgrade() { unsafe { this.c[0].weak = this.c[0].weak + 1; } return RcWeak.make(p: this.p, c: this.c); }
    ~Rc() { unsafe { this.c[0].strong = this.c[0].strong - 1; if (this.c[0].strong == 0) { drop(value: this.deref()); free(p: cast<Ptr>(this.p)); if (this.c[0].weak == 0) { free(p: cast<Ptr>(this.c)); } } } }
}
// Build the strong ref, hand back a weak one through `out`, and let the strong drop on the way out —
// which is what makes the weak dangle for the upgrade attempt below.
fn int32 makeAndWeaken(int32 r, out RcWeak<Shape> w) {
    Rc<Shape> a = new Circle.make(r: r);
    w = a.downgrade();
    return a.area();            // 49, read while `a` is still live
}   // a drops: strong 0 -> Circle __dtor frees buf; ctrl stays (weak=1)

fn int32 main() {
    slot RcWeak<Shape> w;
    int32 v = makeAndWeaken(r: 7, w: out w);
    Optional<Rc<Shape>> o = w.tryUpgrade();
    int32 up = match (o) { case Some(value: r): r.area(); case None: 0; };   // 0 (expired)
    return v + up;                  // 49
}
