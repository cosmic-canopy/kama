// std::num integer abs/sign (int32 + int64); min/max/clamp are the generics in tests/generic_min_max_clamp.
import { std::num::absI32, std::num::signI32, std::num::absI64, std::num::signI64 };
fn int32 main() {
    int32 r = 0;
    if (absI32(x: 0 - 9) == 9)                 { r = r + 8; }
    if (signI32(x: 0 - 4) == 0 - 1)            { r = r + 8; }
    if (signI32(x: 0) == 0)                    { r = r + 10; }
    if (absI64(x: 0i64 - 100i64) == 100i64)    { r = r + 8; }
    if (signI64(x: 7i64) == 1i64)              { r = r + 8; }
    return r;   // 42
}
