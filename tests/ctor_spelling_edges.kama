// The `.` vs `::` boundary, pinned so the two can never be mixed up again. Construction is ALWAYS
// dot-on-type; `::` is ALWAYS scope resolution. Each spelling below is the only one that compiles for
// its case — the rejections are xfail/scope_op_on_ctor (a ctor via `::`) and xfail/dot_on_type_not_ctor
// (a static fn via `.`). Returns 42.
type contract Spawnable for both { }

type enum Tag { Red, Blue }

type enum MakeErr implements Error {
    TooBig;

    public fn string message() { return "too big"; }
}

type value Cell implements Spawnable {
    public int32 v;

    public ctor make(int32 v) { this.v = v; return this; }                       // construction -> `.`
    public ctor Result<Cell, MakeErr> checked(int32 v) {                           // FALLIBLE construction -> `.`
        if (v > 100) { return Result::Err(error: MakeErr::TooBig); }
        return Result::Ok(value: Cell.make(v: v));
    }
    public static fn int32 twice(int32 n) { return n * 2; }                        // utility -> `::`
}

// A ctor reached through a generic TYPE PARAMETER is still construction, so it is still a dot.
fn int32 viaTypeParam<T: Spawnable>(int32 n) {
    T t = T.make(v: n);
    return t.v;
}

fn int main()
{
    Cell a = Cell.make(v: 10);                    // 1. ctor, dot-on-type
    int32 b = Cell::twice(n: 5);                  // 2. static fn, scope resolution -> 10
    Tag t = Tag::Blue;                            // 3. enum variant stays on `::`

    // 4. a fallible ctor is a first-class `match` subject INLINE — no typed binding first. This is the
    //    spelling that used to require the `::` bridge, so banning `::` for ctors depends on it working.
    int32 c = match (Cell.checked(v: 7))   { case Ok(value: x): x.v; case Err(error: e): 0 - 1; };   // 7
    int32 d = match (Cell.checked(v: 999)) { case Ok(value: x): x.v; case Err(error: e): 5; };       // 5 (the Err arm)

    int32 e = viaTypeParam::<Cell>(n: 9);         // 5. ctor through a type parameter -> 9

    int32 f = match (t) { case Red: 0; case Blue: 1; };   // 1
    return a.v + b + c + d + e + f;               // 10 + 10 + 7 + 5 + 9 + 1 = 42
}
