// A method called on an enum member written in place — `Light::On.lit()`. Until 0.9.644 the call read the
// member as an unknown name ("cannot resolve `On`, the receiver of `lit`") whenever it carried no payload,
// while `Shape::Circle(r: 7).n()` (a call, typed by what it returns) and the same member held in a local
// both worked. A payload-less member of a plain enum and of a tagged one are each one receiver.
type enum Light : uint8 {
    Off, On;
    public const fn bool lit() { return match (this) { case Off: false; case On: true; }; }
}

type enum Shape {
    Dot, Circle(int32 r);
    public const fn int32 size() { return match (this) { case Dot: 1; case Circle(r: r): r; }; }
}

fn uint8 main() {
    int32 n = 0;
    if (Light::On.lit()) { n += 1; }
    if (!Light::Off.lit()) { n += 2; }
    n += Shape::Dot.size() * 4;                                            // 4
    n += Shape::Circle(r: 2).size() * 4;                                   // 8
    return cast<uint8>(n);   // 15
}
