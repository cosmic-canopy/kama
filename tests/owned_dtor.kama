import std::memory::{Owned};
// Owned<T> RAII: the heap pointee's destructor fires exactly once on drop.
extern fn void kama_trace(int code);
extern fn int kama_trace_get();

type resource Probe
{
    int32 id;
    public ctor make(int32 id) { slot Probe r; r.id = id; return give r; }
    ~Probe() { kama_trace(code: 7); }
}

fn int build()
{
    Owned<Probe> p = new Probe.make(id: 1);
    return 0;   // p drops -> Owned_Probe__dtor -> Probe__dtor + free
}

fn int main()
{
    int r = build();
    return kama_trace_get();   // fold(7) = 7
}
