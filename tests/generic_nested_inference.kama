// A generic call infers from another generic call's result. `abs(x: sin(x: t))` was refused —
// "cannot infer generic type parameter 'T'" — on the stated ground that the inner call returns "the very `T`
// being resolved". It does not: the inner call is solved first (its arguments are scanned before it), so it
// returns its instance's type. The explicit `abs(x: sin::<float64>(x: t))` was refused too. Covered here:
// a nested call, one inside a generic body (solved per instantiation), a generic TYPE returned, and the
// argument shapes inference had no arm for — a ternary, a field, an element. The cross-module twin is
// tests/generic_nested_inference.d.
import { std::math::abs, std::math::sin, std::math::Real, std::collections::DynamicArray };

type value V { public float64 f = -2.5; public ctor make() { } }
type value Box<T> { public T v; public ctor of(T v) { this.v = v; } }
type value Pt { int32 x = 4; public ctor make() { } public fn int32 gx() { return this.x; } }

fn T id<T>(T x) { return x; }
fn Box<T> wrap<T>(T v) { return Box::<T>.of(v: v); }
fn int32 takeBox<T>(Box<T> b) { return 7; }
fn T g<T: Real<T>>(T x) { return abs(x: sin(x: x)); }     // nested, inside a generic body
fn T twice<T>(T x) { return id(x: id(x: x)); }

fn int32 main() {
    float64 t = -1.0;
    V v = V.make();
    InlineArray<float64>#(2) arr = [-3.0, 4.0];
    DynamicArray<float64> dyn = DynamicArray.empty();
    dyn.add(item: -6.0);
    Box<int32> b = Box::<int32>.of(v: 9);
    Pt p = Pt.make();
    int32 n = 0;
    if (abs(x: sin(x: t)) > 0.8) { n = n + 1; }                 // the peer's shape
    if (abs(x: sin::<float64>(x: t)) > 0.8) { n = n + 2; }      // ...and its explicit spelling
    if (id(x: id(x: 3)) == 3) { n = n + 4; }
    if (takeBox(b: wrap(v: 3)) == 7) { n = n + 8; }             // a generic TYPE returned
    if (id(x: wrap(v: 5)).v == 5) { n = n + 16; }               // ...bound to a bare `T`, then a field read
    if (g::<float64>(x: t) > 0.8 && g(x: -1.0f32) > 0.8f32) { n = n + 32; }
    if (twice(x: 6) == 6) { n = n + 64; }
    float64 s = abs(x: t > 0.0 ? t : t) + abs(x: v.f) + abs(x: arr[0]) + abs(x: dyn[0]) + cast<float64>(id(x: b.v));
    if (s == 1.0 + 2.5 + 3.0 + 6.0 + 9.0) { n = n + 128; }     // ternary, field, elements
    if (id(x: p).gx() == 4) { n = n + 256; }                    // a method on a generic call's result
    return n == 511 ? 0 : n;
}
