// A lock hands its value back once it is the last handle (KR-262): `intoInner()` consumes a handle, and the one whose
// release is the LAST gets `Some(value)`, any other `None`. Before it the payload could only be borrowed, so what the
// workers built could not leave when they were done. Cases, one bit each; returns 0:
//   1  joined workers: four isolates count into a `Locked<Map>`, and the caller, last after the scope, takes the map;
//   2  `None` to a handle that is not last, and the value lives on in the one that remains;
//   4  the same on a `ReadWriteLocked`;
//   8  every holder calls it at once: eight isolates release together, 50 rounds, and exactly one gets the value
//      each round (Rust added `Arc::into_inner` because `try_unwrap` loses the value in this race).
// Payloads own heap memory, so the sanitizer leg sees every one dropped exactly once.
import { std::concurrent::Locked, std::concurrent::ReadWriteLocked, std::concurrent::Isolate,
         std::collections::DynamicArray, std::collections::Map };

type value Counter implements Sendable { public int32 n; public ctor zero() { this.n = 0; } }

type resource Hits implements Sendable {
    Locked<Map<string, int32>> hits;
    string key;
    public ctor make(Locked<Map<string, int32>> h, string k) { this.hits = give h; this.key = give k; }
    public fn void run() {
        int32 i = 0;
        while (i < 100) {
            borrow this.hits.lock().value() as m {
                int32 now = match (m.get(key: this.key)) { case Some(value: v): v; case None: 0; };
                m.put(key: copy this.key, value: now + 1);
            }
            i = i + 1;
        }
    }
}
fn void count(Hits h) { h.run(); }

type resource Racer implements Sendable {
    Locked<DynamicArray<string>> items;
    Locked<Counter> wins;
    public ctor make(Locked<DynamicArray<string>> b, Locked<Counter> w) { this.items = give b; this.wins = give w; }
    public give fn void run() {
        Optional<DynamicArray<string>> got = give this.items.intoInner();
        if (got.isSome()) { borrow this.wins.lock().value() as w { w.n = w.n + 1; } }
    }
}
fn void race(Racer r) { give r.run(); }

fn int32 joined() {
    Locked<Map<string, int32>> hits = Locked.make(value: Map.empty());
    scope {
        Hits a = Hits.make(h: copy hits, k: "a");
        spawn count(h: give a);
        Hits b = Hits.make(h: copy hits, k: "b");
        spawn count(h: give b);
        Hits c = Hits.make(h: copy hits, k: "a");
        spawn count(h: give c);
        Hits d = Hits.make(h: copy hits, k: "b");
        spawn count(h: give d);
    }
    Optional<Map<string, int32>> all = give hits.intoInner();   // joined: this is the last handle
    return match (give all) {
        case Some(value: m): {
            int32 a = match (m.get(key: "a")) { case Some(value: v): v; case None: 0; };
            int32 b = match (m.get(key: "b")) { case Some(value: v): v; case None: 0; };
            := a == 200 && b == 200 ? 0 : 1;
        }
        case None: { := 1; }
    };
}

fn DynamicArray<string> bag() {
    DynamicArray<string> d = DynamicArray.empty();
    d.add(item: "kept");
    return d;
}

fn int32 notLast() {
    Locked<DynamicArray<string>> h = Locked.make(value: bag());
    Locked<DynamicArray<string>> other = copy h;
    Optional<DynamicArray<string>> first = give h.intoInner();
    if (first.isSome()) { return 2; }
    borrow other.lock().value() as v { v.add(item: "after"); }   // the value lives on
    Optional<DynamicArray<string>> last = give other.intoInner();
    return match (give last) { case Some(value: v): v.length() == 2 ? 0 : 2; case None: 2; };
}

fn int32 notLastShared() {
    ReadWriteLocked<DynamicArray<string>> h = ReadWriteLocked.make(value: bag());
    ReadWriteLocked<DynamicArray<string>> other = copy h;
    Optional<DynamicArray<string>> first = give h.intoInner();
    if (first.isSome()) { return 4; }
    int32 seen = 0;
    borrow other.lockShared().value() as v { seen = cast<int32>(v.length()); }
    Optional<DynamicArray<string>> last = give other.intoInner();
    return seen == 1 && last.isSome() ? 0 : 4;
}

fn int32 racing() {
    int32 round = 0;
    while (round < 50) {
        Locked<Counter> wins = Locked.make(value: Counter.zero());
        Locked<DynamicArray<string>> b = Locked.make(value: bag());
        Racer r1 = Racer.make(b: copy b, w: copy wins);
        Racer r2 = Racer.make(b: copy b, w: copy wins);
        Racer r3 = Racer.make(b: copy b, w: copy wins);
        Racer r4 = Racer.make(b: copy b, w: copy wins);
        Racer r5 = Racer.make(b: copy b, w: copy wins);
        Racer r6 = Racer.make(b: copy b, w: copy wins);
        Racer r7 = Racer.make(b: copy b, w: copy wins);
        Racer r8 = Racer.make(b: give b, w: copy wins);   // the eighth takes the caller's own handle
        scope {
            spawn race(r: give r1);
            spawn race(r: give r2);
            spawn race(r: give r3);
            spawn race(r: give r4);
            spawn race(r: give r5);
            spawn race(r: give r6);
            spawn race(r: give r7);
            spawn race(r: give r8);
        }
        int32 n = 0;
        borrow wins.lock().value() as w { n = w.n; }
        if (n != 1) { return 8; }
        round = round + 1;
    }
    return 0;
}

fn uint8 main() {
    return cast<uint8>(joined() | notLast() | notLastShared() | racing());
}
