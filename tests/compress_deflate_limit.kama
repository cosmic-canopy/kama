// `DeflateReader`'s `limit` (KR-5): the decoded bytes it may deliver, required, because a few kilobytes of deflate can
// decode to gigabytes. A stream of exactly `limit` bytes decodes whole; with `limit` one less, every byte up to it is
// delivered and the read after answers `LimitExceeded`, and so does every read after that, and `finish`. An empty stream
// passes a zero limit, and a one-byte stream does not. Returns 42.
import { std::compress::deflate::DeflateReader, std::io::BufReader, std::io::SliceReader, std::io::Reader,
         std::io::IoError, std::io::IoErrorKind, std::collections::DynamicArray, std::collections::FixedArray,
         std::collections::View, std::encoding::hex::decode, std::digest::crc32::crc32 };

fn DynamicArray<uint8> bytesOf(const ref string text) {
    return match (decode(text: text)) { case Ok(value: b): give b; case Err(error: e): DynamicArray.empty(); };
}

fn DeflateReader<SliceReader> over(const ref string stream, uint64 limit) {
    return DeflateReader.make(source: BufReader.make(inner: SliceReader.fromBytes(bytes: bytesOf(text: stream))),
                              limit: limit);
}

// 0 for bytes, else the error's kind: 1 InvalidData, 2 UnexpectedEof, 3 LimitExceeded, 9 any other.
fn int32 kindOf(IoError e) {
    return match (e.kind()) { case InvalidData: 1; case UnexpectedEof: 2; case LimitExceeded: 3; case _: 9; };
}

// How many bytes reading `stream` delivers before it ends (`kind` 0) or fails (`kind` its kind), 100 bytes at a time.
fn isize upTo(ref DeflateReader<SliceReader> d, ref int32 kind) {
    FixedArray<uint8> buf = FixedArray.make(size: 100);
    isize total = 0;
    while (true) {
        isize n = match (d.read(into: buf.viewMut())) { case Ok(value: k): k; case Err(error: e): { kind = kindOf(e: e); := -1; } };
        if (n <= 0) { return total; }
        total = total + n;
    }
}

fn uint8 main() {
    string big = "7d568b6ec3200cfc95fc9a97d0a65a9a4a2d537f7f056cb0cfa69ab6160c7e9ccfc7f29e96239dd7bc2f5bba1c94d3f2"
                 + "cacf44f7259d9b7c25b46db757a6734dcb67999439effd087fac8f2db8358eed7f97cb9d4e1740392cbf7a5d5dca4637"
                 + "94449a45a2d0e727c882daeae778acbf63af382e158b3f72114cf6ec8491d31992aeeeb8e5f4a4a36e49a535d371fa4e"
                 + "79dd47a6724abb97c372b4a5de56015edd97ef4633ebac74eae06b402017f8408b6f9017573e1c06718d9bd87d4b6a20"
                 + "c1c734ce1290513330881de94600eebcfd0193a06525571a34616bf3cb5906d424cb444f8c6058fa1410c03503170750"
                 + "dba14093b60414028c62e45629ba830aa51367a532a83db450fb06f6eb9ec790ac1d3cde7cdfceedf10e64ec1b056df5"
                 + "8e9c089c9927451a39c739a886ab1bb575edaa9e1075a25142e9d4848da4092fb676a3fd0da033fae7952bd4312907a6"
                 + "68aa33c1383ae5669f48610a9440bb83d86eca4c0cab758a0a5090dd1dd08c26597083b9c1578a7d7575f4c127ac746f"
                 + "2e2a24a8313fc1111e7283b502e72a9ea956a104816e21c1ad27d2936fdfdc48bc5da50d6a54e2f9e8abaf922f455353"
                 + "83ebb1982901459ded448d65df55d1df1f3bde8d4b64f50461fe22cca83508db7c5c83d74366cd0bba06730693ea72f4"
                 + "ff85d09d81e06cca8e0e4d3d7c3041d0732766f078f68487de4ab5140f545ffd03";   // 2817 bytes
    int32 kind = 0;
    DeflateReader<SliceReader> whole = over(stream: big, limit: 2817ui64);
    if (upTo(d: ref whole, kind: ref kind) != 2817 || kind != 0) { return 1; }

    DeflateReader<SliceReader> cut = over(stream: big, limit: 2816ui64);
    if (upTo(d: ref cut, kind: ref kind) != 2816 || kind != 3) { return 2; }
    kind = 0;
    if (upTo(d: ref cut, kind: ref kind) != 0 || kind != 3) { return 3; }
    int32 fin = match (give cut.finish()) { case Ok(value: b): 0; case Err(error: e): kindOf(e: e); };
    if (fin != 3) { return 4; }

    // `finish` decodes what was not read, and the limit holds there too.
    DeflateReader<SliceReader> early = over(stream: big, limit: 100ui64);
    int32 early3 = match (give early.finish()) { case Ok(value: b): 0; case Err(error: e): kindOf(e: e); };
    if (early3 != 3) { return 5; }

    kind = 0;
    DeflateReader<SliceReader> none = over(stream: "0300", limit: 0ui64);
    if (upTo(d: ref none, kind: ref kind) != 0 || kind != 0) { return 6; }
    DeflateReader<SliceReader> one = over(stream: "ab0000", limit: 0ui64);
    if (upTo(d: ref one, kind: ref kind) != 0 || kind != 3) { return 7; }
    return 42;
}
