// The counterpart to xfail/interp_no_format: the advice that diagnostic gives actually works. One
// `@generate(Format)` makes a value interpolatable — the derived `format` renders every field. Returns 42.
@generate(of, Format)
type value Point { public int32 x; public int32 y; }

fn int32 main() {
    Point p = Point.of(x: 3, y: 4);
    string bare   = "${p}";
    string woven  = "point ${p} here";
    if (!bare.equals(other: "Point { x: 3, y: 4 }"))         { return 1; }
    if (!woven.equals(other: "point Point { x: 3, y: 4 } here")) { return 2; }
    return 42;
}
