// M2 — Deque<T>, a growable ring buffer with O(1) push/pop at both ends. Verifies FIFO + LIFO ordering,
// wraparound (pop-then-push past the physical end), logical indexing, growth relinearization, deep copy,
// mid-iteration invalidation, RAII drop of an OWNED element (ASan gate), and a serialize round-trip.
import std::collections::{Deque, DynamicArray};
import std::serialization::json::{encode, decode};

fn int32 unwrap(Optional<int32> o) { return match (o) { case Some(x): x; case None: 0 - 1; }; }

fn int32 main() {
    int32 r = 0;

    // pushBack then popFront == FIFO order.
    Deque<int32> q = Deque();
    q.pushBack(item: 1); q.pushBack(item: 2); q.pushBack(item: 3);
    if (q.length() == 3 && unwrap(o: q.popFront()) == 1 && unwrap(o: q.popFront()) == 2) { r = r + 10; }

    // pushFront then popFront == LIFO on the front; popBack takes the tail.
    Deque<int32> d = Deque();
    d.pushFront(item: 10); d.pushFront(item: 20); d.pushBack(item: 5);   // logical: [20, 10, 5]
    if (d[0] == 20 && d[1] == 10 && d[2] == 5) { r = r + 10; }
    if (unwrap(o: d.popFront()) == 20 && unwrap(o: d.popBack()) == 5 && d.length() == 1) { r = r + 10; }

    // Wraparound: on a small cap, alternate pop-front / push-back so the live window straddles the buffer end.
    Deque<int32> w = Deque();
    w.reserve(n: 4);
    int32 i = 0; while (i < 4) { w.pushBack(item: i); i = i + 1; }        // [0,1,2,3], full
    if (unwrap(o: w.popFront()) == 0 && unwrap(o: w.popFront()) == 1) { r = r + 5; }   // free two front slots
    w.pushBack(item: 4); w.pushBack(item: 5);                            // wrap into freed slots -> logical [2,3,4,5]
    if (w[0] == 2 && w[1] == 3 && w[2] == 4 && w[3] == 5) { r = r + 5; }

    // Growth past capacity relinearizes the wrapped window correctly.
    w.pushBack(item: 6); w.pushBack(item: 7);                            // forces a grow; order must survive
    if (w.length() == 6 && w[0] == 2 && w[5] == 7) { r = r + 10; }

    // Iteration yields front-to-back order; sum 2+3+4+5+6+7 = 27.
    int32 sum = 0;
    foreach (int32 x in w) { sum = sum + x; }
    if (sum == 27) { r = r + 10; }

    // Deep copy is independent (mutating the copy leaves the original intact).
    Deque<int32> c = copy w;
    c.pushBack(item: 99);
    if (c.length() == 7 && w.length() == 6) { r = r + 10; }

    // contains via element Equatable.
    if (w.contains(item: 4) && !w.contains(item: 42)) { r = r + 10; }

    // RAII: a deque of OWNED elements drops the un-popped ones on scope exit (ASan-verified). Pop some,
    // leave the rest for the destructor.
    Deque<DynamicArray<int32>> owned = Deque();
    int32 j = 0;
    while (j < 3) { DynamicArray<int32> row = DynamicArray(); row.add(item: j); owned.pushBack(item: give row); j = j + 1; }
    Optional<DynamicArray<int32>> first = owned.popFront();   // moved out + dropped here
    if (owned.length() == 2) { r = r + 10; }                 // two remain for ~Deque to drop

    // Serialize round-trip through JSON (front-to-back array).
    Deque<int32> s = Deque();
    s.pushBack(item: 7); s.pushBack(item: 8); s.pushBack(item: 9);
    Result<Deque<int32>, DeError> res = decode::<Deque<int32>>(src: give encode(v: s));
    int32 okc = match (res) { case Ok(b): (b[0] + b[2] + b.length()); case Err(e): 0 - 1; };
    if (okc == 7 + 9 + 3) { r = r + 10; }   // 19

    return r;   // 10+10+10+5+5+10+10+10+10+10+10 = 100
}
