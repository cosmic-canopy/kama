// SortedMap<K: Comparable, V> — a B-tree ordered map. Insert enough keys to force multiple splits (a
// multi-level tree), read them back, borrow-in-place with getRef, delete a scrambled half (forcing borrows,
// merges, predecessor/successor swaps, and root shrink), then exercise the ordered queries (first/last/
// floor/ceil/range), sorted iteration, clear, and deep copy. Exit code sums the asserts.
import std::collections::{SortedMap, DynamicArray};

fn int32 main() {
    int32 r = 0;
    SortedMap<int32, int32> m = SortedMap.empty();

    // insert 0..199 in a scrambled order (37 coprime with 200) -> many splits
    int32 i = 0;
    while (i < 200) { int32 k = (i * 37) % 200; m.put(key: k, value: k * 10); i = i + 1; }
    if (m.length() == 200) { r = r + 5; }

    // read every key back
    bool allGet = true; i = 0;
    while (i < 200) {
        int32 g = match (m.get(key: i)) { case Some(v): v; case None: 0 - 1; };
        if (g != i * 10) { allGet = false; }
        i = i + 1;
    }
    if (allGet) { r = r + 5; }

    // overwrite keeps length; getRef borrows in place
    m.put(key: 100, value: 9999);
    int32 ov = match (m.get(key: 100)) { case Some(v): v; case None: 0 - 1; };
    if (ov == 9999 && m.length() == 200) { r = r + 5; }
    int32 br = m.getRef(key: 55);
    if (br == 550) { r = r + 5; }

    // delete all even keys (scrambled) -> forces borrows/merges/root-shrink
    i = 0;
    while (i < 200) {
        int32 k = (i * 37) % 200;
        if (k % 2 == 0) {
            Optional<int32> got = m.remove(key: k);
            bool ok = match (got) { case Some(v): true; case None: false; };
            if (!ok) { r = r + 1000; }              // poison a wrong/absent removal
        }
        i = i + 1;
    }
    if (m.length() == 100) { r = r + 5; }

    // every odd remains, every even gone
    bool presence = true; i = 0;
    while (i < 200) {
        bool has = m.contains(key: i);
        if (i % 2 == 1) { if (!has) { presence = false; } } else { if (has) { presence = false; } }
        i = i + 1;
    }
    if (presence) { r = r + 5; }

    // ordered queries over the surviving odd keys {1,3,..,199}
    int32 fst = match (m.first()) { case Some(x): x; case None: 0 - 1; };
    int32 lst = match (m.last()) { case Some(x): x; case None: 0 - 1; };
    if (fst == 1 && lst == 199) { r = r + 5; }
    int32 q = 50;
    int32 fl = match (m.floor(key: q)) { case Some(x): x; case None: 0 - 1; };   // greatest odd <= 50 = 49
    int32 ce = match (m.ceil(key: q)) { case Some(x): x; case None: 0 - 1; };    // least odd >= 50 = 51
    if (fl == 49 && ce == 51) { r = r + 5; }

    // sorted iteration
    int32 prev = 0 - 1; bool sorted = true; int32 cnt = 0;
    DynamicArray<int32> ks = m.keys();
    foreach (int32 k in ks) { if (k <= prev) { sorted = false; } prev = k; cnt = cnt + 1; }
    if (sorted && cnt == 100) { r = r + 5; }

    // range [40, 60) over odds -> {41,43,45,47,49,51,53,55,57,59} = 10 keys
    int32 lo = 40; int32 hi = 60;
    DynamicArray<int32> rg = m.range(from: lo, to: hi);
    if (rg.length() == 10) { r = r + 5; }

    // deep copy independence
    SortedMap<int32,int32> cp = copy m;
    m.remove(key: 99); m.put(key: 1000, value: 1);
    if (cp.length() == 100 && cp.contains(key: 99) && !cp.contains(key: 1000)) { r = r + 5; }

    // clear + reuse (copy untouched)
    m.clear();
    if (m.length() == 0 && m.isEmpty()) { r = r + 5; }
    m.put(key: 7, value: 77);
    int32 re = match (m.get(key: 7)) { case Some(v): v; case None: 0 - 1; };
    if (re == 77 && cp.length() == 100) { r = r + 5; }

    return r;   // 13 asserts * 5 = 65 (poison adds 1000s if delete is wrong)
}
