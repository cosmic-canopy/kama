import { std::collections::DynamicArray };
// A2 (C×E soundness) — a place-returning FREE fn used as a method receiver. `pick()` returns `ref Widget`
// (a borrow of `x`); its result must go through addrOfOperand and NOT be materialized+dropped, else the
// borrowed Widget's buffer would be freed twice (double-free with `x`'s own drop). ASan-clean == no dup free.
type resource Widget { DynamicArray<int32> parts; public ctor make(int32 s){ this.parts.add(item: s); } public fn int32 area(){ return this.parts[0]*this.parts[0]; } }
fn ref Widget pick(ref Widget w) { return w; }
fn int32 main() { Widget x = Widget.make(s: 6); return pick(w: ref x).area(); }
