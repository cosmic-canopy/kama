// std::net over the io::streams substrate — a TCP socket now IS a Reader + Writer (ReliableStream refines
// them), so the GENERIC free helpers drive it with zero net-specific code: the client sends its whole payload
// through `writeAll(Writer, View)`, the server drains to EOF through `readAll(Reader) -> string`. Single
// process, client-first (buffered send + FIN on drop), then accept. Verifies the round-tripped bytes. Returns 55.
import std::net::{TcpListener, TcpStream};
import std::io::{IoError, writeAll, readAll};
import std::collections::{DynamicArray};

fn DynamicArray<uint8> payload() {
    string msg = "hello streams";
    DynamicArray<uint8> data = DynamicArray.empty();
    int32 i = 0;
    while (i < cast<int32>(msg.length())) { data.add(item: msg[i]); i = i + 1; }
    return give data;
}

// Client: connect, write the whole payload via the GENERIC writeAll (loops the Writer primitive), close (FIN).
fn int32 clientSend(uint16 port) {
    string host = "127.0.0.1";
    Result<TcpStream, IoError> rc = TcpStream::connect(host: host, port: port);
    return match (rc) {
        case Ok(c): {
            DynamicArray<uint8> data = payload();
            := match (writeAll(w: c, bytes: data.view())) { case Ok(u): data.length(); case Err(e): -1; };
        }
        case Err(e): -1;
    };
}

// Server: drain the socket fully via the GENERIC readAll (Reader -> string, reads until peer FIN = EOF).
fn int32 serverRecv(ref TcpStream srv) {
    return match (readAll(r: srv)) {
        case Ok(s): {
            DynamicArray<uint8> want = payload();
            bool ok = cast<int32>(s.length()) == want.length();
            int32 i = 0;
            while (ok && i < want.length()) { if (s[i] != want[i]) { ok = false; } i = i + 1; }
            := ok ? 55 : 40;
        }
        case Err(e): 43;
    };
}

fn int32 run(ref TcpListener l, uint16 port) {
    int32 sent = clientSend(port: port);               // completes first (buffered send + FIN), then accept
    if (sent != 13) { return 41; }
    Result<TcpStream, IoError> ra = l.accept();
    return match (ra) { case Ok(srv): serverRecv(srv: srv); case Err(e): 42; };
}

fn int main() {
    string host = "127.0.0.1";
    uint16 port = cast<uint16>(47665);
    Result<TcpListener, IoError> rl = TcpListener::bind(host: host, port: port);
    return match (rl) { case Ok(l): run(l: l, port: port); case Err(e): 80; };
}
