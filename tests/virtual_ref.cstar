class Shape
{
    virtual fn int area() { return 1; }
}
class Square extends Shape
{
    int s;
    Square(int s) { this.s = s; }
    override fn int area() { return s * s; }
}
fn int measure(ref Shape sh)
{
    return sh.area();
}
fn int main()
{
    Square sq = new Square(s: 6);
    return measure(sh: ref sq);
}
