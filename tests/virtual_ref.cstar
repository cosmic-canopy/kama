// Virtual dispatch through a `ref Shape` parameter (the base object borrowed by ref).
// M25b: the virtual is a `protected` hook (`compute`); `area` is the public surface a
// free function may call. Dispatch still resolves to the most-derived override.
virtual class Shape
{
    public fn int area() { return this.compute(); }
    protected virtual fn int compute() { return 1; }
}
final class Square extends Shape
{
    int s;
    public Square(int s) { this.s = s; }
    protected override fn int compute() { return s * s; }
}
fn int measure(ref Shape sh)
{
    return sh.area();
}
fn int main()
{
    Square sq = new Square(s: 6);
    return measure(sh: ref sq);
}
