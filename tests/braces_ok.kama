// Mandatory braces, the POSITIVE side — the two things the rule deliberately does NOT forbid.
// The rejections live in tests/xfail/brace_*.kama; a rule needs both halves guarded, because an
// over-strict check passes every xfail while breaking the corpus.
//
// 1. `else if` chains stay legal. The `else` arm accepts a block OR another `if`: the chain link IS the
//    branch, and forcing `else { if (…) { … } }` would nest every chain for no safety gain.
// 2. A braced body on ONE line stays legal. The rule is about the braces, not about line breaks —
//    `if (x) { return; }` cannot silently acquire a second statement, which is the whole point.

fn int32 classify(int32 n) {
    if (n > 100) { return 4; }
    else if (n > 10) { return 3; }        // chain link — an `if` in the else arm, not a bare body
    else if (n > 0) { return 2; }
    else if (n == 0) { return 1; }
    else { return 0; }
}

fn int32 main() {
    int32 sum = 0;
    sum = sum + classify(n: 500);         // 4
    sum = sum + classify(n: 50);          // 3
    sum = sum + classify(n: 5);           // 2
    sum = sum + classify(n: 0);           // 1
    sum = sum + classify(n: 0 - 5);       // 0

    // One-line braced bodies, every construct the rule touches.
    int32 i = 0;
    while (i < 3) { i = i + 1; }
    do { i = i + 1; } while (i < 5);
    for (int32 k = 0; k < 2; k = k + 1) { i = i + 1; }
    InlineArray<int32, 2> a = [1; 2];
    foreach (int32 e in a) { i = i + e; }

    return sum + i - 19;                  // 10 + 9 - 19 == 0
}
