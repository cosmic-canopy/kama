// KBIN round-trip of a bare collection (a DynamicArray is a first-class Serialize/Deserialize value). Returns 60.
import std::serialization::binary::{encode, decode};
import std::collections::{DynamicArray};
fn int main() {
    DynamicArray<int32> xs = DynamicArray.empty();
    xs.add(item: 10); xs.add(item: 20); xs.add(item: 30);
    Result<DynamicArray<uint8>, Owned<Error>> e_r = encode(v: xs);
    DynamicArray<uint8> bytes = match (give e_r) { case Ok(b): give b; case Err(__e): { return 250; } };
    Result<DynamicArray<int32>, Owned<Error>> res = decode::<DynamicArray<int32>>(src: give bytes);
    return match (res) { case Ok(b): b[0] + b[1] + b[2]; case Err(e): 0 - 1; };   // 60
}
