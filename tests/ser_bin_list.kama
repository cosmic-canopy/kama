// KBIN round-trip of a bare collection (a DynamicArray is a first-class Serializable/Deserializable value). Returns 60.
import {
    std::serialization::binary::encodeNamed,
    std::serialization::binary::decodeNamed,
    std::collections::DynamicArray,
};
fn int32 main() {
    DynamicArray<int32> xs = DynamicArray.empty();
    xs.add(item: 10); xs.add(item: 20); xs.add(item: 30);
    Result<DynamicArray<uint8>, Owned<Error>> e_r = encodeNamed(v: xs);
    DynamicArray<uint8> bytes = match (give e_r) { case Ok(value: b): give b; case Err(error: __e): { return 250; } };
    Result<DynamicArray<int32>, Owned<Error>> res = decodeNamed::<DynamicArray<int32>>(src: give bytes);
    return match (res) { case Ok(value: b): b[0] + b[1] + b[2]; case Err(error: e): 0 - 1; };   // 60
}
