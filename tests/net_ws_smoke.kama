// std::net::web WebSocket build/link smoke — connect() reaches the JS glue and returns a handle (proving
// the --js-library wiring + handle table). The async connection outcome is irrelevant here; we exit at once.
import std::net::web::{WsConnection, WsState};
import std::io::{IoError};

fn int main() {
    string url = "ws://127.0.0.1:47670";
    Result<WsConnection, IoError> r = WsConnection::connect(url: url);
    return match (r) { case Ok(c): 55; case Err(e): 40; };
}
