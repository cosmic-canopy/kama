type enum Msg { Move(int32 dx, int32 dy), Stop, Reset }
fn int32 main()
{
    Msg a = Msg::Move(dx: 3, dy: 4);
    int32 total = 100;
    match (a) {
        case Move(dx: dx, dy: dy): { total = total + dx; total = total + dy; total = total * 2; }
        case Stop: { total = 0; }
        case Reset: { total = 1; }
    };
    return total;
}
