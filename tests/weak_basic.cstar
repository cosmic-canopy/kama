// Weak<T>: make a weak ref from a Shared, upgrade it (lock) while alive, and use
// the shared object through the upgraded handle.
class Counter
{
    int32 value;
    Counter(int32 start) { this.value = start; }
    void bump() { this.value = this.value + 1; }
    int32 get() { return this.value; }
}

int main()
{
    Shared<Counter> s = new Shared<Counter>(start: 40);
    Weak<Counter> w = s;            // weak ref (does not keep alive)
    Shared<Counter> s2 = w.lock();  // upgrade -> valid (s is alive)
    int32 r = 0;
    if (s2.valid()) { r = 1; }      // confirm the upgrade succeeded
    s2.bump();
    s2.bump();
    return s2.get() + r - 1;        // 42 + 1 - 1 = 42
}
