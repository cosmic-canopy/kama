// `foreach (ref T x in v)` uses a MUTABLE iterator: `iterMut()` + `hasNext()` + a place-returning
// `next()` — mutation persists. (Optional can't carry a place, so mutable is a parallel iterator,
// Rust's iter()/iter_mut() split.)
extern "<stdlib.h>";
extern fn UnsafePtr malloc(usize n);
extern fn void free(UnsafePtr p);
type value VecIterMut<T> implements IteratorMut<T> {
    UnsafePtr<T> data; int32 pos; int32 len;
    public ctor make(UnsafePtr<T> data, int32 len) { this.data = data; this.pos = 0; this.len = len; }
    public fn bool hasNext() { return this.pos < this.len; }
    public fn ref T next() { int32 p = this.pos; this.pos = this.pos + 1; unsafe { return this.data[p]; } }
}
type resource Vec<T> implements IterableMut<T> {
    UnsafePtr<T> data; int32 len;
    public ctor make(int32 n) { this.data = cast<UnsafePtr<T>>(malloc(n: cast<usize>(n) * sizeof(T))); this.len = n; }
    public ref T operator[](int32 i) { unsafe { return this.data[i]; } }
    public fn VecIterMut<T> iterMut() { return VecIterMut.make(data: this.data, len: this.len); }
    ~Vec() { free(p: cast<UnsafePtr>(this.data)); }
}
fn int32 main() {
    Vec<int32> v = Vec.make(n: 3);
    v[0] = 1; v[1] = 2; v[2] = 3;
    foreach (ref int32 x in v) { x = x * 10; }
    return v[0] + v[1] + v[2];   // 60
}
