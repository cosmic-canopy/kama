// M17: the safe FixedArray->pointer bridge (dataPtr() needs no unsafe); deref needs unsafe.
import std::collections::{FixedArray};
fn int main()
{
    FixedArray<int32> a = FixedArray(size: 3);
    a[0] = 40; a[1] = 1; a[2] = 1;
    Ptr<int32> p = a.dataPtr();        // safe to obtain
    int32 s = 0;
    unsafe { s = p[0] + p[1] + p[2]; } // raw read needs unsafe
    return s;   // 42
}
