// M17: the safe FixedArray->pointer bridge (dataPtr() needs no unsafe); deref needs unsafe.
import { std::collections::FixedArray };
unsafe fn int32 run()
{
    FixedArray<int32> a = FixedArray.make(size: 3);
    a[0] = 40; a[1] = 1; a[2] = 1;
    UnsafeConstPtr<int32> p = a.dataPtr();   // safe to obtain — the reading half; `dataPtrMut()` is the writable one
    int32 s = 0;
    s = p[0] + p[1] + p[2]; // raw read needs unsafe
    return s;   // 42
}

// The body above is the raw work, so IT carries the marker; `main` may not be `unsafe`
// (it encloses the whole program). Calling an `unsafe fn` from safe code is allowed.
fn int32 main() { return run(); }
