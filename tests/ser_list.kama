// A bare collection is a first-class Serializable/Deserializable value — encode/decode a DynamicArray directly.
import { std::serialization::text::json::serializeJsonBuffer, std::serialization::text::json::deserializeJsonBuffer, std::collections::DynamicArray };
fn int32 main() {
    DynamicArray<int32> xs = DynamicArray.empty();
    xs.add(item: 10); xs.add(item: 20); xs.add(item: 30);
    Result<string, Owned<Error>> j_r = serializeJsonBuffer(v: xs);
    string j = match (give j_r) { case Ok(value: __ok): give __ok; case Err(error: __e): { return 250; } };
    if (!j.equals(other: "[10,20,30]")) { return 1; }
    Result<DynamicArray<int32>, Owned<Error>> res = deserializeJsonBuffer::<DynamicArray<int32>>(src: give j);
    return match (res) { case Ok(value: b): b[0] + b[1] + b[2]; case Err(error: e): 0 - 1; };   // 60
}
