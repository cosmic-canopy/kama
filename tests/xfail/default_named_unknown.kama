// M8: naming a type-arg that is not a parameter of the template is a compile-time error.
type value Wrap<T, U = int32> { public T a; public U b; public ctor make(T x, U y){ slot Wrap<T, U> r; r.a = x; r.b = y; return give r; } }
fn int main() { Wrap<int32, Z: float64> w = Wrap.make(x: 1, y: 2.0); return 0; }
