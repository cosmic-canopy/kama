extern "<stdlib.h>";
extern fn void free(Ptr p);
type value Counter { public int32 n; public Counter(int32 s) { this.n = s; } public fn int32 get() { return this.n; } }
type resource Box<T> implements Deref<T>, HeapOwner<T> {
    Ptr<T> p;
    public ctor adopt(Ptr<T> raw) { Box<T> b; b.p = raw; return b; }
    public fn ref T deref() { unsafe { return this.p[0]; } }
    ~Box() { unsafe { free(p: cast<Ptr>(this.p)); } }
}
fn int32 main() {
    Box<Counter> a = new Counter(s: 7);
    Box<Counter> b = give a;
    return a.get();   // ERROR: use after move
}
