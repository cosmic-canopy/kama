// M6.3 (reject): a `parallel_for` body may NOT write to a non-atomic captured local. `acc` would be
// shared by pointer across all K workers, so `acc = acc + e` is a data race. The write-through-capture
// gate rejects it and names the culprit; the fix is an `Atomic<T>` (see parfor_atomic) or writing only
// through the disjoint loop element `e`.
import std::concurrent;
import std::collections::{DynamicArray, View};

fn int32 main() {
    int32 acc = 0;
    DynamicArray<int32> a = DynamicArray.empty();
    a.add(item: 1i32);
    parallel_for (ref int32 e in a) {
        acc = acc + e;                 // rejected: shared mutable capture across workers
    }
    return acc % 256;
}
