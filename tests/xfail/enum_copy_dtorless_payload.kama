// A resource without a destructor still has an identity, so an enum holding one copies only if the resource
// declares `Copyable`. This was let through to C (an undeclared `P__copy`) until the copy rule stopped reading
// `destructible`; it is refused by kama, naming the payload.
type resource Plain { int32 id; public ctor make(int32 id) { this.id = id; } }
type enum P { Q(Plain p), N }
fn int32 main() {
    P a = P::Q(p: Plain.make(id: 5));
    P b = copy a;
    return 0;
}
