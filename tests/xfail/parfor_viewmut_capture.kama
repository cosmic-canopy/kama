// A mutable view of a capture hands every worker the same elements; `view()` is the read-only form.
import { std::collections::DynamicArray, std::concurrent::Isolate };
fn uint8 main() {
    DynamicArray<int64> xs = DynamicArray.empty();
    xs.add(item: 1i64);
    DynamicArray<int64> ys = DynamicArray.empty();
    ys.add(item: 0i64);
    parallel_for (ref int64 e in xs, workers: 2) {
        borrow ys.viewMut() as v { v[0] = 1; }
    }
    return 0;
}
