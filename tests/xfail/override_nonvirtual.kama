// `override` requires a virtual method in a base class (Step 3) — else malformed vtable.
type virtual resource Base {
    public ctor make() { Base r; return give r; }
    public fn int32 plain() { return 1; }            // NON-virtual
    protected virtual fn int32 hook() { return 0; }  // makes Base a valid virtual class
}
type final resource Derived extends Base {
    public ctor make() { Derived r; return give r; }
    protected override fn int32 plain() { return 2; }   // ERROR: plain is not virtual
}
fn int main() { Derived d = Derived.make(); return 0; }
