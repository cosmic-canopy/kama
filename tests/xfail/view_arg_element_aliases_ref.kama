// A view argument into an element and a mutable argument naming that element's container hand the callee a window
// into storage it may free (`d[0] = …` drops the buffer `v` views; ASan through 0.9.727).
import { std::collections::DynamicArray, std::collections::ConstView };
fn int32 g(ConstView<int32> v, ref DynamicArray<DynamicArray<int32>> d) { DynamicArray<int32> e = DynamicArray.empty(); d[0] = give e; return v[0]; }
fn uint8 main()
{
    DynamicArray<DynamicArray<int32>> arr = DynamicArray.empty();
    DynamicArray<int32> one = DynamicArray.empty();
    one.add(item: 1);
    arr.add(item: give one);
    int32 r = 0;
    r = g(v: arr[0].view(), d: ref arr);
    return cast<uint8>(r);
}
