// A collection whose ELEMENT is a graph node. The WRITE half now works — see `tests/ser_graph_coll_write`:
// the container's own `serialize` is emitted a second time as a graph-carrying twin, each element interns
// its pointee and writes an id, and discovery runs that body against a discard sink so the table's length
// is exact before `beginArray`. Identity and aliasing survive the wire.
//
// What remains is the READ half, and it is a different question. Pass 1 can build the container through its
// own `deserialize` — it already knows how — stashing each element's id in the handle's own pointer slot.
// Pass 2 is the problem: it has to revisit those elements to turn the stashed ids into live handles, and a
// container's elements are not fields, so the per-shell field walk cannot see them. The answer is mutable
// iteration (`IterableMut<T>`, the same contract `foreach (ref T x in c)` already requires).
//
// ⚠️ Do not "fix" this by recording each element's ADDRESS during pass 1: `DynamicArray.deserialize` grows
// via `add`, so the buffer reallocs while elements are being read and every recorded address dangles. The
// stash survives realloc because it moves WITH the element.
import { std::serialization::json::serializeJsonBuffer, std::memory::Shared, std::collections::DynamicArray };

@generate(Serializable, Deserializable)
type resource Leaf { @field int32 v; public ctor make(int32 v) { this.v = v; } }

@generate(Serializable, Deserializable)
type resource Bag {
    @field DynamicArray<Shared<Leaf>> kids;
    public ctor make(DynamicArray<Shared<Leaf>> kids) { this.kids = give kids; }
}

fn int32 main() {
    Shared<Leaf> a = new Leaf.make(v: 1);
    DynamicArray<Shared<Leaf>> xs = DynamicArray.empty();
    xs.add(item: a);
    Shared<Bag> b = new Bag.make(kids: give xs);
    Result<string, Owned<Error>> j = serializeJsonBuffer(v: b);
    return match (give j) { case Ok(value: x): 0; case Err(error: e): 1; };
}
