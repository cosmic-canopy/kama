// A collection whose ELEMENT is a graph node. Reach sees it — a generic instance's type arguments are
// walked, so the owner IS a graph node and the field is named correctly — and the language gate that used
// to fire first is gone: a container now writes elements through `this[i].serialize(w)`, so no `const ref T`
// names a smart pointer. What remains is the serde half, which is the real question: a container's
// `serialize` receives a `Serializer` and nothing else, so an element write has nowhere to get the walker's
// id table from and cannot intern its pointee. Refused rather than written wrong.
import { std::serialization::json::serializeJsonBuffer, std::memory::Shared, std::collections::DynamicArray };

@generate(Serializable, Deserializable)
type resource Leaf { @field int32 v; public ctor make(int32 v) { this.v = v; } }

@generate(Serializable, Deserializable)
type resource Bag {
    @field DynamicArray<Shared<Leaf>> kids;
    public ctor make(DynamicArray<Shared<Leaf>> kids) { this.kids = give kids; }
}

fn int32 main() {
    Shared<Leaf> a = new Leaf.make(v: 1);
    DynamicArray<Shared<Leaf>> xs = DynamicArray.empty();
    xs.add(item: a);
    Shared<Bag> b = new Bag.make(kids: give xs);
    Result<string, Owned<Error>> j = serializeJsonBuffer(v: b);
    return match (give j) { case Ok(value: x): 0; case Err(error: e): 1; };
}
