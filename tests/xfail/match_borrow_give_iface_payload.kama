// SOUNDNESS (1.0 blocker): `give` an owning payload out of a BORROWING `match (x)` double-frees in safe
// code — the arm binding aliases the box the subject still owns. The interface-element fat-handle repr
// (`Owned<Error>`) is the exact `encode`-class case. The compiler must REJECT it; the correct idiom is the
// consuming `match (give r)` (destructure-move).
fn Result<int32, Owned<Error>> rewrap(Result<int32, Owned<Error>> r) {
    match (r) {                                          // BORROWING — `e` only aliases r's box
        case Ok(v):  { return Result::Ok(value: v); }
        case Err(e): { return Result::Err(error: give e); } // give the aliased fat handle out -> double free
    };
    return Result::Ok(value: 0);
}
fn int main() {
    Result<int32, Owned<Error>> r = Result::Err(error: DeError::Malformed);
    Result<int32, Owned<Error>> res = rewrap(r: give r);
    match (res) { case Ok(v): { } case Err(e): { } };
    return 0;
}
