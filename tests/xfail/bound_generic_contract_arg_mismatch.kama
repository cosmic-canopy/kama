// A bound on a generic contract names its ARGUMENTS too: `Nums` implements `Source<int32>`, which is not
// `Source<string>`. The bound read only the template name and accepted it (KR-15).
type contract Source<X> for value { fn X pull(); }
type value Nums implements Source<int32> {
    int32 n;
    public ctor of(int32 n) { this.n = n; }
    public fn int32 pull() { return this.n; }
}
fn int32 take<P: Source<string>>(P p) { return 1; }
fn uint8 main() { return cast<uint8>(take::<Nums>(p: Nums.of(n: 5))); }
