// A split over a view writes the storage the view's host owns, so the host is held as the view is: `xs[0]` here reads an
// element another worker writes through `v`.
import { std::collections::DynamicArray, std::concurrent::Isolate };
fn uint8 main() {
    DynamicArray<int64> xs = DynamicArray.empty();
    xs.add(item: 1i64); xs.add(item: 2i64);
    borrow xs.viewMut() as v {
        parallel_for (ref int64 e in v, workers: 2) { e = e + xs[0]; }
    }
    return 0;
}
