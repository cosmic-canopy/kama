// A type implementing a refining contract must supply the INHERITED methods too (not just the own ones).
type contract Drawable for resource { fn int32 area(); }
type contract Animated for resource implements Drawable { fn int32 step(); }
type resource Bad implements Animated {
    public ctor make() { }
    public fn int32 step() { return 1; }   // missing the inherited `area()`
}
fn int32 main() { Bad b = Bad.make(); return b.step(); }
