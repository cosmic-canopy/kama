// `type intrinsic <…>` was the conformance block's name until 0.9.510, when it became `type adapter <…>`. The old
// spelling is refused with the new one, rather than as an unknown kind word.
type contract Counted for intrinsic { const fn int32 count(); }
type intrinsic <int32> implements Counted { public const fn int32 count() { return this; } }
fn int32 main() { return 0; }
