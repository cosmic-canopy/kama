// A `match` arm is a hand-off (tests/match_arm_handoff.kama): a named `string` there says `give` or `copy`. Bare,
// it once moved `t` silently, where `string u = t;` is refused for want of a marker — and a later read of `t`
// was then blamed on a `give` nobody wrote.
type enum E { A, B }
fn uint8 main() {
    E e = E::A;
    string t = "abc";
    string u = match (e) { case A: t; case B: "q"; };   // ERROR: say `give t` or `copy t`
    return cast<uint8>(u.length() + t.length());
}
