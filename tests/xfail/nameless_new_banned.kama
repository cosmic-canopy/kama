// M8 Phase E — nameless `new Type(args)` is no longer allowed; construct through a named ctor.
type value C { int32 n; public ctor make(int32 n) { this.n = n; } public fn int32 g(){ return this.n; } }
fn int32 main() {
    Owned<C> a = new C(n: 5);       // ERROR: use `new C.make(n: 5)`
    return a.g();
}
