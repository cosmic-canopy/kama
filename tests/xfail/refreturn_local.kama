// A `ref T` result must borrow `this` or a `ref` parameter — a place into a local would dangle.
type value B {
    InlineArray<int32, 4> d;
    public ctor make() { slot B r; r.d = [0; 4]; return give r; }
    public fn ref int32 bad(usize i) { InlineArray<int32, 4> local = [0; 4]; return local[i]; }
}
fn int32 main() { B b = B.make(); return b.bad(i: 0); }
