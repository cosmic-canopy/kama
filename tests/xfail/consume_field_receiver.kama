// A field is not the caller's to consume: it would leave its owner holding a moved-from value (KR-261, a consuming method: `give fn`; tests/consume_basic is the accepted shape).
type resource Box { int32 v; public ctor make(int32 v) { this.v = v; } public const fn int32 get() { return this.v; } ~Box() { } }
type resource Wrap { Box inner; Box spare;
    public ctor make(Box inner) { this.inner = give inner; this.spare = Box.make(v: 0); }
    public give fn Box unwrap() { return give this.inner; }
    public fn void poke() { }
}
type resource Outer { Wrap w; public ctor make() { this.w = Wrap.make(inner: Box.make(v: 1)); } public fn Box take() { return give this.w.unwrap(); } }   // -> REJECT
fn uint8 main() { return 0; }
