// The park rule (KR-3 step 4) follows sockets once they park (step 5): on an isolate that runs fibers, a socket read
// switches fibers, so a lasting access to `Shared` storage may not make one. `Conn.tally` iterates `this.xs` — reached
// through the `Shared` the fiber was handed — and reads the stream inside the loop, so while it waits for bytes another
// fiber could grow `xs` and free the buffer the loop is reading. Through `0.9.744` that read blocked the whole thread
// and was no park (SPEC *Fibers* said so); now it parks only its fiber.
import { std::net::TcpListener, std::net::TcpStream, std::io::IoError, std::concurrent::Fiber,
         std::memory::Shared, std::collections::DynamicArray, std::collections::FixedArray };
type resource Conn {
    DynamicArray<int32> xs;
    TcpStream s;
    public ctor make(TcpStream s) { this.xs = DynamicArray::<int32>.empty(); this.xs.add(item: 1); this.s = give s; }
    public unsafe fn int32 tally() {
        FixedArray<uint8> buf = FixedArray.make(size: 1);
        int32 total = 0;
        foreach (int32 x in this.xs) {
            Result<isize, IoError> r = this.s.read(into: buf.viewMut());   // ERROR: a fiber's wait on a socket, inside the window
            total = total + x;
        }
        return total;
    }
}
fn int32 walk(Shared<Conn> c) { return c.tally(); }
unsafe fn uint8 run() {
    Result<TcpListener, IoError> rl = TcpListener.bind(host: "127.0.0.1", port: 0ui16);
    TcpListener l = match (give rl) { case Ok(value: x): give x; case Err(error: e): { return 2; } };
    Result<TcpStream, IoError> ra = l.accept();
    TcpStream s = match (give ra) { case Ok(value: x): give x; case Err(error: e): { return 4; } };
    Shared<Conn> c = new Conn.make(s: give s);
    Fiber<int32> w = spawn fiber walk(c: copy c);
    return cast<uint8>(give w.join());
}
fn uint8 main() { return run(); }
