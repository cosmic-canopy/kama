// KR-87: a module path is written only in an `import` — this position spells an EXPORTED name of `geo` qualified, never imported. Refused, naming the import.
type contract Holds<X> for value { fn int32 cm(); }
type value W implements Holds<geo::ShownVal> { int32 a; public ctor make() { this.a = 1; } public fn int32 cm() { return this.a; } }
fn int32 main() { W w = W.make(); return w.cm() - 1; }
