// A parallel loop's clauses are each said once: two `chunks:` would be two answers to one question.
import { std::collections::DynamicArray };
fn uint8 main() {
    DynamicArray<int32> xs = DynamicArray.empty();
    xs.add(item: 1);
    parallel_for (ref int32 e in xs, chunks: 2, chunks: 3) { e = e * 2; }
    return 0;
}
