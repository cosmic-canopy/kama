// A view that closes its window (KR-124) lives only as the alias of the `borrow` that minted it; as an enum payload it
// would be copied in and out of the enum, and nothing would run the copy's destructor.
@viewable type contract Transacts for resource { fn Tx begin(); }
type view Tx {
    UnsafePtr<int32> log;
    unsafe ctor over(UnsafePtr<int32> log) { this.log = log; }
    unsafe ~Tx() { this.log[0] = 2; }
}
type enum Step { Open(Tx tx), Done }
fn uint8 main() { return 0; }
