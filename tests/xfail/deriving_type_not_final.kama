// A deriving type must be WRITTEN `final`, not merely be a leaf by arithmetic.
//
// At KAMA_INHERIT_DEPTH=1 nothing may extend `Derived` anyway, so the compiler could infer this. It
// deliberately does not: `final` is an EARLY, VISIBLE, INTENTIONAL marker that you have reached the hard
// limit, so you meet it while writing the type rather than being surprised by it later, the first time
// you try to extend that type once more.
type virtual resource Base
{
    public ctor make() { slot Base r; return give r; }
    public fn int32 rank() { return this.step(); }
    protected virtual fn int32 step() { return 1; }
}
type virtual resource Derived extends Base        // must be `type final resource Derived`
{
    public ctor make() { slot Derived r; return give r; }
    protected override fn int32 step() { return 2; }
}
fn int main() { Derived d = Derived.make(); return d.rank(); }
