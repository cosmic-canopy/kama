// A deriving type must state its own budget, and it may be AT MOST one less than its base's. `Base`
// allows 1 more level, so `Derived` may allow 0 — which is spelled `final`, the only spelling for 0.
//
// The compiler could infer this and deliberately does not. `final` is an EARLY, VISIBLE, INTENTIONAL
// marker that the chain ends here, met while writing the type rather than discovered later, the first
// time someone tries to extend it once more.
type virtual(maxDepth: 1) resource Base
{
    public ctor make() { }
    public fn int32 rank() { return this.step(); }
    protected virtual fn int32 step() { return 1; }
}
type virtual(maxDepth: 1) resource Derived extends Base        // must be `type final resource Derived`
{
    public ctor make() { this.base = Base.make(); }
    protected override fn int32 step() { return 2; }
}
fn int32 main() { Derived d = Derived.make(); return d.rank(); }
