// M26e — a collection of interface fat pointers would store borrows that dangle.
// Store owning handles instead: a `List<Shared<IShape>>` (M26f).
interface IShape { fn int32 area(); }
class Sq implements IShape { int32 s; public Sq(int32 s){ this.s = s; } public fn int32 area(){ return this.s * this.s; } }
fn int32 main() { List<IShape> xs; return 0; }
