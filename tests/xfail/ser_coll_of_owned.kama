// A collection of `Owned<X>` is a plain by-value tree — no graph, no ids — and the WRITE half now works:
// `Owned<X>` is `Serializable` exactly when its pointee is, and a container writes elements through
// `this[i].serialize(w)` directly, so nothing hops through a `const ref T` any more. What is left is the
// READ half: `T.deserialize(r)` has nothing to call, because `Owned<X>` carries no `deserialize` — and it
// must not, since a method on a handle shadows the pointee's through auto-deref. The mechanism that fills
// that gap without putting a member on the triad is what this fixture is waiting for.
import { std::serialization::json::serializeJsonBuffer, std::memory::Owned, std::collections::DynamicArray };

@generate(Serializable, Deserializable)
type resource Leaf { @field int32 v; public ctor make(int32 v) { this.v = v; } }

@generate(Serializable, Deserializable)
type resource Bag {
    @field DynamicArray<Owned<Leaf>> kids;
    public ctor make(DynamicArray<Owned<Leaf>> kids) { this.kids = give kids; }
}

fn int32 main() {
    DynamicArray<Owned<Leaf>> xs = DynamicArray.empty();
    xs.add(item: new Leaf.make(v: 7));
    Bag b = Bag.make(kids: give xs);
    Result<string, Owned<Error>> j = serializeJsonBuffer(v: b);
    return match (give j) { case Ok(value: x): 0; case Err(error: e): 1; };
}
