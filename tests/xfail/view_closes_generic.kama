// A generic may copy, store or return its `T`, so a closing view is no type argument (KR-124).
@viewable type contract Transacts for resource { fn Tx begin(); }
type view Tx {
    UnsafePtr<int32> log; bool done;
    unsafe ctor over(UnsafePtr<int32> log) { this.log = log; this.done = false; }
    public unsafe fn void commit() { this.log[0] = 1; this.done = true; }
    unsafe ~Tx() { if (!this.done) { this.log[0] = 2; } }
}
type resource Conn implements Transacts {
    InlineArray<int32>#(1) log;
    public ctor make() { this.log = [0; 1]; }
    public unsafe fn Tx begin() { return Tx.over(log: addr(of: this.log[0])); }
}
fn int32 peek<T>(const ref T x) { return 1; }
fn int32 main()
{
    Conn c = Conn.make();
    borrow c.begin() as tx { int32 k = peek(x: tx); }
    return 0;
}
