// No park inside an `@onPanic` region (KR-3 decision 15): a recovered panic is a longjmp, and one across a fiber switch
// would land on another fiber's stack, so the region is refused with the chain to the switch. Today the same program also
// trips `@noheap` (a spawn allocates) and the region's destructor rule (a `Fiber` owns one); the park walk is the one
// that will still hold when a park that neither owns nor allocates arrives (KR-3 step 5's sockets).
import { std::concurrent::Fiber, std::concurrent::join };
fn int32 child(int32 n) { return n; }
fn int32 waitOne() {
    Fiber<int32> f = spawn fiber child(n: 1);
    return join(fiber: give f);
}
@noheap @onPanic(recover: 0)
fn int32 region(isize i) { return waitOne(); }   // ERROR: region -> waitOne -> join, which switches fibers
fn uint8 main() { return cast<uint8>(region(i: 0)); }
