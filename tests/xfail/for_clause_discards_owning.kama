// A statement that discards an owning value drops it where the statement ends. A `for` clause is one C expression
// with no statement after it, so a call there that returns an owning value could not be dropped — refused, rather
// than leaked as every discarded owning value was through 0.9.675.
type resource H {
    int32 id;
    public ctor make(int32 id) { this.id = id; }
    ~H() { }
}
fn H mkh(int32 id) { return H.make(id: id); }
fn int32 main() {
    int32 n = 0;
    for (int32 i = 0; i < 3; mkh(id: i)) { n = n + 1; i = i + 1; }
    return n;
}
