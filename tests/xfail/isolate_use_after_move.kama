// M2/M4: the moved bundle is consumed by the spawn — reusing it afterward MUST be rejected. `spawn
// worker(p: give p)` moves `p` into the new isolate (shared-nothing), so the post-scope `p.get()` is a
// use-after-move, caught by the same move seam that guards every other `give`. This must fail to compile.
import { std::concurrent::Isolate };

type resource Payload {
    int32 value;

    public ctor make(int32 value) {
        this.value = value;
    }

    public fn int32 get() { return this.value; }
}

fn void worker(Payload p) {
    int32 x = p.get();
}

fn int32 main() {
    Payload p = Payload.make(value: 7i32);
    scope {
        spawn worker(p: give p);   // `p` is moved into the child here
    }
    return p.get();              // ERROR: use of `p` after it was moved
}
