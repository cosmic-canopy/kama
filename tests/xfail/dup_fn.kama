// The same rule for a plain function. This was rejected before — but by CLANG, as
// `redefinition of '_F4__id'`, pointing at generated C for a mistake kama can see itself. The
// diagnostic now names the kama function and both declaration sites.
fn int32 id(int32 x) { return x; }
fn int32 id(int32 x) { return x + 1; }

fn int32 main() { return id(x: 3); }
