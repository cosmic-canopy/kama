// KR-181. Inside a loop a use that comes first in the text runs after the write on the next pass.
import { std::collections::DynamicArray };
type enum U { A(DynamicArray<int64> xs), B(int64 p, int64 n, int64 c, int64 m) }
fn U mk() { DynamicArray<int64> xs = DynamicArray.empty(); xs.add(item: 7i64); return U::A(xs: give xs); }
fn uint8 main() {
    U u = mk(); int64 n = 0i64; int32 i = 0;
    match (u) { case A(xs: a): { while (i < 2) { n = n + a[0]; u = U::B(p: 1i64, n: 1i64, c: 1i64, m: 0i64); i = i + 1; } } case B(p: p, n: q, c: c, m: m): { } };
    return cast<uint8>(n);
}
