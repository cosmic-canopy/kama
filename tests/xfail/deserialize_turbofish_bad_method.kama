// A METHOD takes no type arguments. There is one way to name a type argument on a call and it is on the
// callee — a free fn (`deserializeJsonBuffer::<T>(…)`) or a type (`T.deserialize(r:)`, `T::<Arg>.make(…)`).
//
// `r.deserialize::<T>()` used to be the single exception, lowered through a `__kamaDeserialize<T>`
// trampoline. It was pure sugar for `T.deserialize(r: r)` — the spelling the stdlib's own `deserializeJsonBuffer<T>`
// already uses — so the exception, the trampoline, and the prelude name all went together.
import { std::serialization::text::json::deserializeJsonBuffer };

@generate(Serializable, Deserializable)
type value Bad {
    @field int32 v;
    public ctor make(int32 v) { this.v = v; }
    public ctor Result<Bad, Owned<Error>> deserialize(Deserializer r) {
        r.beginObject(count: 1);
        r.moreFields();
        FieldKey k = r.field();
        int32 v = r.readI32::<int32>();   // ERROR: a method takes no type arguments
        return Result::Ok(value: Bad.make(v: v));
    }
}

fn int32 main() {
    Result<Bad, Owned<Error>> b = deserializeJsonBuffer::<Bad>(src: give "{\"v\":1}");
    return 0;
}
