// P4 Landing B: the receiver-turbofish `recv.method::<T>()` is only valid for `deserialize` (the one
// generic member call today). A turbofish on any other reader method is a compile error pointing at the
// only supported form — mirroring the free-fn turbofish reject.
import std::serialization::json::{decode};

@generate(Serialize, Deserialize, noOnConstruction)
type value Bad {
    @field int32 v;
    public Bad(int32 v) { this.v = v; }
    public ctor Result<Bad, Owned<Error>> deserialize(Deserializer r) {
        r.beginObject();
        r.moreFields();
        string k = r.fieldName();
        int32 v = r.readI32::<int32>();   // ERROR: turbofish only valid on `deserialize`
        return Result::Ok(value: Bad(v: v));
    }
}

fn int main() {
    Result<Bad, Owned<Error>> b = decode::<Bad>(src: give "{\"v\":1}");
    return 0;
}
