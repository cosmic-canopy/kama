// A concrete class can't be passed by `ref`/`out` to an interface parameter — it would
// need a throwaway temp (reseat would be lost). Bind it to the interface first.
type contract Shape for value { fn int64 area(); }
type value Circle implements Shape {
    int64 r;
    public ctor make(int64 r) { this.r = r; }
    public fn int64 area() { return r * r; }
}
fn int64 read(ref Shape sh) { return sh.area(); }
fn int main() {
    Circle c = Circle.make(r: 6);
    return cast<int>(read(sh: ref c));   // ERROR: ref a concrete Circle to `ref Shape`
}
