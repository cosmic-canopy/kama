// A multi-`when` gate is AND: `Box2<int32, Owned>` fails the `B: Copyable` condition (Owned is move-only),
// so `Box2`'s `copy()` is ABSENT for this instance — `copy p` must be a clean compile error, not a
// half-copy. Guards the multi-condition gate's AND semantics.
type resource Owned { int32 x; public ctor make(int32 x) { this.x = x; } }

type resource Box2<A, B> implements Copyable(bare: give) when [A: Copyable, B: Copyable] {
    A a; B b;
    public ctor make(A a, B b) { this.a = give a; this.b = give b; }
    public ctor copy(ref Box2<A,B> source) when [A: Copyable, B: Copyable] { return Box2::<A,B>.make(a: copy source.a, b: copy source.b); }
}

fn int main() {
    Box2<int32, Owned> p = Box2.make(a: 3, b: Owned.make(x: 1));
    Box2<int32, Owned> q = copy p;   // B=Owned not Copyable -> copy() absent -> REJECTED
    return 0;
}
