// M4.2: a child may only `ref`-borrow a local that OUTLIVES the scope's join barrier. Here `tmp` is
// declared in an INNER block nested in the scope, so it is destroyed at the inner block's close, BEFORE
// the scope joins the child — the borrowed pointer would dangle. This must fail to compile.
//
// The hazard is unchanged; the rule that catches it moved one step EARLIER. A bare `spawn` must now be a
// direct statement of its `scope { }`, so this program is refused for its shape before the borrow is ever
// examined — and that rule is why the borrow can no longer escape at all: a name visible to a direct
// statement of the scope is declared at scope level or outer, hence outlives the barrier. `isolatePrep`'s
// own escape check is kept as the guard that would catch this again if a nested `spawn` were ever
// readmitted. See tests/xfail/spawn_in_nested_block.kama for the shape rule itself.
import { std::concurrent::Isolate };

type value Acc {
    int32 total;
    int32 lo;
    int32 hi;
    public ctor range(int32 lo, int32 hi) { this.total = 0; this.lo = lo; this.hi = hi; return this; }
    public fn void run() { int32 i = this.lo; while (i < this.hi) { this.total = this.total + i; i = i + 1; } }
}

fn void accumulate(ref Acc a) { a.run(); }

fn int32 main() {
    scope {
        {
            Acc tmp = Acc.range(lo: 0, hi: 50);   // declared in an INNER block — drops before the barrier
            spawn accumulate(a: ref tmp);          // ERROR: borrow escapes `tmp`'s lifetime
        }
    }
    return 0;
}
