// A call host freezes its RECEIVER for the block (KR-123): `m.put` could grow or rehash the map and move the entry `v`
// names. Write through `v`, or after the window closes.
import { std::collections::Map, std::collections::DynamicArray };
fn uint8 main()
{
    Map<string, int32> m = Map.empty();
    m.put(key: "a", value: 1);
    borrow m.getRefMut(key: "a") as v { m.put(key: "b", value: 2); }
    return 0;
}
