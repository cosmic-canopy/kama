// The RECEIVER form of the same aliasing. A non-`const fn` borrows its receiver mutably, so
// `b.eat(v: b.view())` hands `eat` a window over the very object it may grow — and the receiver never
// reaches the argument-overlap test, which only ever compares arguments with each other.
import { std::collections::View, std::collections::DynamicArray };

type resource Box {
    DynamicArray<int32> buf;
    public ctor make() { this.buf = DynamicArray.withCapacity(capacity: 2); this.buf.add(item: 1); }
    public unsafe fn View<int32> view() { return this.buf.view(); }
    public fn int32 eat(View<int32> v) { this.buf.reserve(n: 64); return v[0]; }
}

fn int32 main() {
    Box b = Box.make();
    return b.eat(v: b.view());
}
