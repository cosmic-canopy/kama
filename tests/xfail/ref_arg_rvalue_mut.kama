// A class RVALUE (a factory result) passed to a NON-const `ref` parameter is a clean compile
// error: the callee's mutation would be lost into a discarded temp — bind to a local first.
type value Vec2 {
    int32 x; int32 y;
    public Vec2(int32 x, int32 y) { this.x = x; this.y = y; }
}
fn Vec2 makeVec() { return Vec2(x: 1, y: 2); }
fn int32 bump(ref Vec2 v) { v.x = v.x + 1; return v.x; }
fn int32 main() {
    return bump(v: makeVec());   // non-const ref temporary -> rejected
}
