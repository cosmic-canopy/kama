// KR-211: a window reached through a `Shared` handle counts a live borrow in the value's block until it closes. A
// recovered panic is a longjmp that would skip the close and leave every later mutation of that value trapping — so a
// `@onPanic` region may not hold one, as it may not own a destructor.
import { std::memory::Shared };
type resource Core { int32 n; public ctor make() { this.n = 1; } public fn ref int32 first() { return this.n; } }
type resource Host {
    Shared<Core> s;
    public ctor make() { Shared<Core> c = new Core.make(); this.s = give c; }
    @noheap @onPanic(recover: 0)
    public fn int32 region() { borrow this.s.first() as x { return x; } }
}
fn uint8 main() { Host h = Host.make(); return cast<uint8>(h.region() - 1); }
