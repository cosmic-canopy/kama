// A concrete class can't be passed by `ref`/`out` to an interface parameter — it would
// need a throwaway temp (reseat would be lost). Bind it to the interface first.
type contract IShape { fn int64 area(); }
type value Circle implements IShape {
    int64 r;
    public Circle(int64 r) { this.r = r; }
    public fn int64 area() { return r * r; }
}
fn int64 read(ref IShape sh) { return sh.area(); }
fn int main() {
    Circle c = Circle(r: 6);
    return cast<int>(read(sh: ref c));   // ERROR: ref a concrete Circle to `ref IShape`
}
