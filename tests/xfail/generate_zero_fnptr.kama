// KR-416. An `fnptr` has no default: zero is no function. Through 0.9.986 `zero` wrote a null one, and the call below
// crashed (SIGSEGV) in safe code.
fnptr int32 F(int32 x);
@generate(zero)
type value Z { public F f; public int32 n; }
fn uint8 main() { Z z = Z.zero(); return cast<uint8>(z.f(x: 1)); }
