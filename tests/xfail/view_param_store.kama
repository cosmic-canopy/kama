// A by-value view parameter roots in what the caller handed in, and it stays a valid return root only while that is
// all it holds. Through 0.9.720 a store into it was never checked: `v = loc.view()` made it a view of a local, and
// returning it handed the caller a view of freed memory (ASan: heap-use-after-free).
import { std::collections::DynamicArray, std::collections::ConstView };

fn ConstView<int32> g(ConstView<int32> v) {
    DynamicArray<int32> loc = DynamicArray.empty();
    loc.add(item: 1);
    v = loc.view();
    return v;
}

fn uint8 main() {
    DynamicArray<int32> a = DynamicArray.empty();
    a.add(item: 9);
    int32 r = 0;
    borrow a.view() as w { ConstView<int32> x = g(v: w); r = x[0]; }
    return cast<uint8>(r);
}
