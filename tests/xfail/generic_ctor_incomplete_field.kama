// M8d.1 — the completeness gate must FIRE for a GENERIC factory. `Widget<A>` has a non-default-fillable
// `alloc: A` field; `bad()` returns a bare local via `give` without assigning `alloc`. Instantiated at a
// custom `A: BumpAllocator` (no `default`), that builds a garbage-allocator object — the gate must reject it.
// (Before M8d.1 the gate was INERT for generics: the monomorph-name mismatch + missing `give` unwrap made it
// silently skip every generic factory, so this compiled with a garbage `alloc`.)
import std::collections::{Arena, BumpAllocator};

type resource Widget<A: Allocator = GlobalAllocator> {
    A alloc;
    int32 x;
    public ctor bad() { this.x = 5; }   // FORGETS `w.alloc`
    public fn int32 get() { return this.x; }
}

fn int32 main() {
    Arena arena = Arena.make(capacity: 1 << 12);
    Widget<BumpAllocator> w = Widget.bad();   // custom `A` → `bad()` force-emitted → gate rejects it
    return w.get();
}
