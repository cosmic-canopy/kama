// A friend may touch ONLY the granted members — not every private.
type value Account {
    int64 balance;
    int32 pin;
    public ctor make(int64 b, int32 p) { slot Account r; r.balance = b; r.pin = p; return give r; }
    friend audit[balance];   // granted balance only
}
fn int32 audit(ref Account a) { return a.pin; }   // ERROR: pin is not in the grant
fn int main() { Account acc = Account.make(b: 1, p: 2); return audit(a: ref acc); }
