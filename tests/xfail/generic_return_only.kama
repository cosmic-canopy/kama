// M27a — a type parameter that appears only in the return type cannot be inferred from the
// arguments; explicit type arguments (make<int32>()) are not yet supported, so this is rejected.
fn T make<T>() { return 0; }
fn uint8 main()
{
    int32 x = make();   // ERROR: cannot infer T (return-only)
    return cast<uint8>(x);
}
