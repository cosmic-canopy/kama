// A `parallel_for` binds an element by reference, `ref T e` or `const ref T e`, or a chunk as its view, `View<T>` or
// `ConstView<T>` (KR-3 decision 16). A binding that is neither, here an element by value, is refused by name.
import { std::collections::DynamicArray };

fn uint8 main() {
    DynamicArray<int32> xs = DynamicArray.empty();
    xs.add(item: 1); xs.add(item: 2);
    parallel_for (int32 e in xs, chunks: 2) { }   // -> REJECT
    return 0;
}
