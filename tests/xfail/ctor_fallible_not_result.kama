// Construction-model M2: a fallible `ctor` must return `Result<T,E>` (carries *why*), never `Optional`.
// A ctor returns its own type (infallible) or Result (fallible) — nothing else.
type value Percent {
    public int32 v;
    public ctor make(int32 v) { slot Percent r; r.v = v; return give r; }
    public ctor Optional<Percent> of(int32 v) {   // ERROR: fallible construction must be Result, not Optional
        if (v < 0) { return Optional::None; }
        return Optional::Some(value: Percent.make(v: v));
    }
}
fn int32 main() { return 0; }
