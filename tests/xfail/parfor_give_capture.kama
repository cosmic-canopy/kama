// A `give` moves the capture out from under the other workers, so it is a write.
import { std::collections::DynamicArray, std::concurrent::Isolate };
fn uint8 main() {
    DynamicArray<int64> xs = DynamicArray.empty();
    xs.add(item: 1i64);
    DynamicArray<int64> ys = DynamicArray.empty();
    parallel_for (ref int64 e in xs, chunks: 2) {
        DynamicArray<int64> z = give ys;
    }
    return 0;
}
