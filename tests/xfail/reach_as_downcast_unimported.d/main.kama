// KR-46: an `.as<X>()` downcast target, naming a name `geo` exports that this file does not import. Must be rejected with the import that fixes it.
fn int32 main() { Result<int32, Owned<Error>> r = Result::Err(error: DeError::Malformed); return match (r) { case Ok(value: v): 0; case Err(error: e): match (e.as<ShownErr>()) { case Some(value: x): 1; case None: 0; }; }; }
