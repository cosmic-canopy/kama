// Granting a public member is redundant — flag it rather than let it mislead.
type value Account {
    int64 balance;
    public ctor make(int64 b) { this.balance = b; }
    public fn int64 get() { return this.balance; }
    friend audit[get];   // get is already public
}
fn int64 audit(ref Account a) { return a.get(); }
fn int32 main() { Account acc = Account.make(b: 1); return cast<int32>(audit(a: ref acc)); }
