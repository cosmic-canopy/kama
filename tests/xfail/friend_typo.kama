// A grant must name real members (catches typos).
type value Account { int64 balance; public ctor make(int64 b){ this.balance = b; } friend audit[blance]; }
fn int64 audit(ref Account a) { return a.balance; }
fn int32 main() { Account acc = Account.make(b: 1); return cast<int32>(audit(a: ref acc)); }
