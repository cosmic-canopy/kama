// The same dangle laundered through one method call. `peek()` is a legal mint — it returns a view over
// `this`, which the view-return rule allows — but the RESULT is still a view of storage the caller can
// name and grow. A view roots through its receiver, so `b.peek()` roots at `b` exactly as `b.buf.view()`
// would, and neither is bounded.
import { std::collections::View, std::collections::DynamicArray };

type resource Box {
    DynamicArray<int32> buf;
    public ctor make() { this.buf = DynamicArray.withCapacity(capacity: 2); this.buf.add(item: 1); }
    public unsafe fn View<int32> peek() { return this.buf.view(); }
    public fn void push(int32 v) { this.buf.add(item: v); }
}

fn int32 main() {
    Box b = Box.make();
    View<int32> v = b.peek();
    b.push(v: 2); b.push(v: 3); b.push(v: 4);   // reallocs
    return v[0];
}
