// A method call on an element of a raw `UnsafePtr<T>` — `p[0].get()` — is refused with the two spellings
// (borrow it through a `ref T` parameter, or own it). A raw element is deliberately untyped to ownership
// so a store through it stays a bitwise relocate; this used to say "its type is not known here", which
// reads as a scope bug. The first consumer's KB-14.
extern fn UnsafePtr malloc(usize n);

type resource Big {
    int32 n;
    public ctor sized(int32 n) { this.n = n; return this; }
    public fn int32 get() { return this.n; }
    ~Big() { }
}

unsafe fn int32 run() {
    UnsafePtr<Big> p = cast<UnsafePtr<Big>>(malloc(n: cast<usize>(sizeof(Big))));
    p[0] = Big.sized(n: 14);
    return p[0].get();   // rejected: borrow it (`f(x: ref p[0])`) or own it
}

fn int32 main() { return run(); }
