import std::memory::{Owned};
// `new` now names the ELEMENT type, not the smart-pointer wrapper (M26a).
type value Box { int32 v; public ctor make(int32 v) { slot Box r; r.v = v; return give r; } }
fn int main() { Owned<Box> p = new Owned<Box>(v: 1); return 0; }   // ERROR: write `new Box.make(v: 1)`
