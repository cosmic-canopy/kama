// A `foreach` calls its container's `iterator()` itself; a non-`const` one is a write to the container, refused over a
// read-only place as the same call written out is (`b.iterator()` on a `const ref`).
type view Cursor implements Iterator<int32> {
    UnsafePtr<int32> at; int32 left;
    unsafe ctor over(UnsafePtr<int32> at) { this.at = at; this.left = 2; }
    public unsafe fn Optional<int32> next() { if (this.left == 0) { return Optional::None; } this.left -= 1; return Optional::Some(value: copy this.at[0]); }
}
type resource Bag implements Iterable<int32> {
    InlineArray<int32>#(1) v;
    public ctor make() { this.v = [7; 1]; }
    public unsafe fn Cursor iterator() { this.v[0] = this.v[0] + 1; return Cursor.over(at: addr(of: this.v[0])); }
}
fn int32 total(const ref Bag b) { int32 s = 0; foreach (int32 x in b) { s += x; } return s; }
fn uint8 main() { Bag b = Bag.make(); return cast<uint8>(total(b: b)); }
