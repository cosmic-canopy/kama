// An enum copies exactly when every payload does. `Res` is a resource that never chose to be copyable, so
// `Handle` cannot be copied — and an enum cannot declare `Copyable` itself, so the message names the payload rather
// than suggesting a `copy` ctor.
type resource Res { int32 v; public ctor make(int32 v) { this.v = v; } ~Res() { } }
type enum Handle { Open(Res r), Closed }

fn int32 main() {
    Handle h = Handle::Open(r: Res.make(v: 1));
    Handle h2 = copy h;
    return 0;
}
