// A Fixed element must own nothing (a `value`). A `resource` element would leak (Fixed has no
// per-element dtor) — rejected; wrap it in an owning Array/List instead.
type resource Handle { public int32 fd; public Handle(int32 fd) { this.fd = fd; } }
fn int32 main() {
    Fixed<Handle, 2> h = [Handle(fd: 1), Handle(fd: 2)];
    return 0;
}
