// KR-8. A contract member is public by definition: a call through the contract reaches it on every
// implementer. `public` used to parse and be dropped, so it said nothing.
type contract Tok for value { public fn int32 hidden(); }

type value Impl implements Tok {
    int32 v;
    public ctor make() { this.v = 42; }
    public fn int32 hidden() { return this.v; }
}

fn int32 outsider(Tok t) { return t.hidden(); }

fn uint8 main()
{
    Impl i = Impl.make();
    return cast<uint8>(outsider(t: i));
}
