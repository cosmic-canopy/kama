// The same rule reached by the OTHER construction route — assigning the field by name, which is how the
// in-tree WebGPU example writes it (examples/webgpu/triangle.kama: `ci.callback = onAdapter;`). Its
// sibling tests/xfail/foreign_callback_in_extern_struct goes through a `ctor` argument instead, and both
// must be refused: the check lives at the one funnel every bind position passes through, so the route
// cannot matter. Deleting `@foreignEntry` from the real example's `AdapterCb` produces this message.
fnptr void Cb(int32 status);

type extern value CallbackInfo { public Cb callback; public int32 mode; }

extern fn void c_request(CallbackInfo ci);

fn void onDone(int32 status) { }

unsafe fn void request() {
    CallbackInfo ci = CallbackInfo();
    ci.mode     = 3;
    ci.callback = onDone;   // ERROR: `Cb` reaches C through `CallbackInfo.callback` and says no thread
    c_request(ci: ci);
}

fn int32 main() { request(); return 0; }
