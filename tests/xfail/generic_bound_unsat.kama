// M27c-1 — a type argument that does NOT satisfy a contract bound is rejected at instantiation, with a
// clean diagnostic (instead of a downstream "class missing method"). `Feather` has no `weight()`.
type contract Weighable for both { fn int32 weight(); }
type value Feather {
    int32 g;
    public ctor make(int32 g) { this.g = g; }
}
fn int32 heft<T: Weighable>(T x) { return x.weight(); }
fn int32 main() {
    Feather f = Feather.make(g: 1);
    return heft(x: f);   // ERROR: Feather does not satisfy bound Weighable
}
