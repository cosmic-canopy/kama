// KR-46: an `.as<X>()` downcast target, naming a name declared nowhere. Must be rejected, naming it.
fn uint8 main() { Result<int32, Owned<Error>> r = Result::Err(error: DeError.of(kind: DeErrorKind::Malformed)); return cast<uint8>(match (r) { case Ok(value: v): 0; case Err(error: e): match (e.as<Zork>()) { case Some(value: x): 1; case None: 0; }; }); }
