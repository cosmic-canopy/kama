// A handle's pointee is not the caller's to consume (KR-261, a consuming method: `give fn`; tests/consume_basic is the accepted shape).
import { std::memory::Owned };
type resource Box { int32 v; public ctor make(int32 v) { this.v = v; } public const fn int32 get() { return this.v; } ~Box() { } }
type resource Wrap { Box inner; Box spare;
    public ctor make(Box inner) { this.inner = give inner; this.spare = Box.make(v: 0); }
    public give fn Box unwrap() { return give this.inner; }
    public fn void poke() { }
}
type resource E { Box b; public ctor make() { this.b = Box.make(v: 1); } public give fn Box finish() { return give this.b; } }
fn uint8 main() { Owned<E> o = new E.make(); Box b = give o.finish(); return 0; }   // -> REJECT
