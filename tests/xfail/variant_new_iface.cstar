type contract IShape { fn int32 area(); }
type resource Sq implements IShape { List<int32> side; public Sq(int32 s){this.side.add(item: s);} public fn int32 area(){return this.side[0]*this.side[0];} }
fn int main()
{
    Optional<Shared<IShape>> o = Optional::Some(value: new Sq(s: 5));
    return 0;
}
