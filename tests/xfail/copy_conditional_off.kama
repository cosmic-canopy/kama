// `Cell<T> implements Copyable when [T: Copyable]` — for a move-only element the capability is OFF, so
// `copy` on a `Cell<MoveOnly>` is a compile error (its copy() was never emitted), even though the
// Cell is otherwise usable.
type resource Cell<T> implements Copyable<This>(bare: give) when [T: Copyable<T>] {
    T value;
    public ctor make(T v) { this.value = give v; }
    public ctor copy(ref Cell<T> source) { return Cell.make(v: copy source.value); }
    ~Cell() { drop(value: this.value); }
}
type resource MoveOnly { int32 n; public ctor make(int32 n){this.n=n;} ~MoveOnly(){} public fn int32 val(){return this.n;} }
fn int32 main() {
    Cell<MoveOnly> m = Cell.make(v: MoveOnly.make(n: 9));
    Cell<MoveOnly> c = copy m;   // ERROR: Cell<MoveOnly> is not Copyable
    return 0;
}
