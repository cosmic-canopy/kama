// A pinned contract's argument is DETERMINED — it can only be the implementing type — so there is exactly
// one always-correct spelling, `This`. Naming the type concretely is rejected rather than accepted-when-
// equal, so every conformance reads the same; it is also the only spelling the intrinsic SET form can
// write, where one block serves many types.
type contract Weighable<T is This> for both { fn int32 weigh(ref T other); }

type value Widget implements Weighable<Widget> {
    public int32 w;
    public ctor make(int32 w) { this.w = w; }
    public fn int32 weigh(ref Widget other) { return this.w + other.w; }
}

fn int32 main() { return 0; }
