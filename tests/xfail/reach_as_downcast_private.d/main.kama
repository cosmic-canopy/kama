// KR-46: an `.as<X>()` downcast target, naming a name private to `geo/lib.kama`, spelled bare. Must be rejected, naming it.
fn int32 main() { Result<int32, Owned<Error>> r = Result::Err(error: DeError::Malformed); return match (r) { case Ok(value: v): 0; case Err(error: e): match (e.as<HidErr>()) { case Some(value: x): 1; case None: 0; }; }; }
