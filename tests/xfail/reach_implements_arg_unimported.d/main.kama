// KR-46: a type argument of an `implements` contract, naming a name `geo` exports that this file does not import. Must be rejected with the import that fixes it.
type contract Holds<X> for value { fn int32 cm(); }
type value W implements Holds<ShownVal> { int32 a; public ctor make() { this.a = 1; } public fn int32 cm() { return this.a; } }
fn int32 main() { W w = W.make(); return w.cm() - 1; }
