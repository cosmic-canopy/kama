// A subclass cannot reach a base class's PRIVATE field (only protected/public).
virtual class Base { int32 secret; public Base(int32 s){ this.secret = s; } }
final class Derived extends Base {
    public Derived(int32 s){ this.secret = s; }       // ERROR: secret is private in Base
    public fn int32 leak() { return this.secret; }
}
fn int main() { return 0; }
