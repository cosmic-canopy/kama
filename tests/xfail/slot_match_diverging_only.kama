// An arm that DIVERGES contributes nothing to the join — but it must not be mistaken for an arm that
// ASSIGNS. Here the only non-diverging arm leaves the slot a hole, so the read after must still fail.
enum Code { Ok, Bad }
fn Code classify(int32 x) { if (x > 0) { return Code::Ok; } return Code::Bad; }
fn int main() {
    slot int32 a;
    match (classify(x: 1)) {
        case Ok:  { }              // reaches the join, assigns nothing
        case Bad: { return 5; }    // diverges
    };
    return a;
}
