// KR-93. An enum is sealed, so `virtual`/`abstract`/`override`/`final` on its method mean nothing — polymorphism
// over an enum is a `contract`. All four were silently accepted on an enum's method.
type enum E { A, B;
    public final fn int32 one() { return 1; }
}

fn uint8 main() { E e = E::A; return cast<uint8>(e.one() - 1); }
