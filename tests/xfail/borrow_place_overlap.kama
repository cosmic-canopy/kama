// Two bindings of one `borrow` over one container are two names for one storage (KR-123): `xs[0]` and `xs[1]` are
// distinct only when the indices are, which nothing proves in general. Borrow it once.
import { std::collections::Map, std::collections::DynamicArray };
fn uint8 main()
{
    DynamicArray<int32> xs = DynamicArray.empty();
    xs.add(item: 1);
    xs.add(item: 2);
    borrow xs[0] as a, xs[1] as b { }
    return 0;
}
