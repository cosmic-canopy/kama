// A `const` receiver's place is read-only: writing through `g[i]` is rejected (const is deep).
type value G {
    InlineArray<int32, 4> d;
    public ctor make() { slot G r; r.d = [0; 4]; return give r; }
    public ref int32 operator[](usize i) { return this.d[i]; }
}
fn int32 main() {
    const G g = G.make();
    g[0] = 9;   // ERROR
    return 0;
}
