// A type argument that does NOT satisfy a generic-contract bound is rejected at instantiation.
// `Widget` has no `compareTo`, so it cannot satisfy `Ranked<int32>`. The bound is checked by
// method NAME against the contract TEMPLATE — no `Ranked<int32>` instance is even needed.
type contract Ranked<T> for value { fn int32 compareTo(T other); }

type value Widget {
    int32 id;
    public ctor make(int32 id) { this.id = id; }
}

fn int32 pick<T: Ranked<int32>>(T a) { return 0; }

fn int32 main() {
    Widget w = Widget.make(id: 1);
    return pick(a: w);   // ERROR: Widget does not satisfy bound Ranked
}
