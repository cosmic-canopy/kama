// `parallel_for` binds each element `ref` — every worker writes its slice — so its operand must be the
// writable window. A `ConstView<T>` handed to it is refused by name, not by the missing `iterMut()` the
// lowering would otherwise trip over.
import { std::collections::View, std::collections::ConstView, std::concurrent::Isolate };

fn int32 main() {
    InlineArray<int32>#(4) a = [1, 2, 3, 4];
    borrow a.view() as cv {
        parallel_for (ref int32 e in cv, workers: 2) { e = e * 2; }   // -> REJECT
    }
    return 0;
}
