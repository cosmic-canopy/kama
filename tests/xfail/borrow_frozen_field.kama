// The field form. `this.hits` stays mutable inside the window (a distinct field cannot overlap — see
// tests/borrow_freeze_disjoint), but `this.buf` IS the borrowed place, so growing it is rejected.
import std::collections::{View, DynamicArray};

fn int32 sum(View<int32> xs) { int32 t = 0; foreach (int32 x in xs) { t = t + x; } return t; }

type resource Box {
    DynamicArray<int32> buf;
    public ctor make() { this.buf = DynamicArray.withCapacity(capacity: 2); this.buf.add(item: 1); }
    public fn int32 total() {
        borrow this.buf.view() as b {
            this.buf.add(item: 2);   // the borrowed place itself
            return sum(xs: b);
        }
    }
}

fn int32 main() { Box bx = Box.make(); return bx.total(); }
