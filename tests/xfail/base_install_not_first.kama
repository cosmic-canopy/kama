// The install must be the FIRST statement: until it runs, every inherited member reads a half-built base.
type virtual(maxDepth: 1) resource Base {
    int32 n;
    public ctor make(int32 n) { this.n = n; }
    protected virtual fn int32 tag() { return 0; }
    public fn int32 rank() { return this.n + this.tag(); }
}
type final resource Leaf extends Base {
    int32 own;
    public ctor make(int32 own) { this.own = own; this.base = Base.make(n: 2); }
    protected override fn int32 tag() { return this.own; }
}
fn int32 main() { Leaf l = Leaf.make(own: 1); return l.rank(); }
