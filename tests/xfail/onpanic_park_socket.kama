// No park inside an `@onPanic` region (KR-3 decision 15), and since step 5 a socket call on an isolate that runs fibers
// is a park: `region` reads a stream, which parks the fiber until bytes arrive. A recovered panic is a longjmp, and one
// across that switch would land on another fiber's stack. The same region in a program with no fibers compiles
// (onpanic_socket_no_fibers). A socket's first wait on a fiber also registers it, which allocates, so `@noheap` refuses
// the region too (decision 15, as corrected).
import { std::net::TcpListener, std::net::TcpStream, std::io::IoError, std::concurrent::Fiber };
fn int32 child(int32 n) { return n; }
type resource Peer {
    TcpStream s;
    public ctor make(TcpStream s) { this.s = give s; }
    @noheap @onPanic(recover: -1)
    public unsafe fn int32 region(isize i) {
        InlineArray<uint8>#(4) buf = [0; 4];
        Result<isize, IoError> r = this.s.read(into: buf.viewMut());   // ERROR: region -> read -> a fiber's wait on a socket
        return cast<int32>(buf[i]);
    }
}
unsafe fn uint8 run() {
    Result<TcpListener, IoError> rl = TcpListener.bind(host: "127.0.0.1", port: 0ui16);
    TcpListener l = match (give rl) { case Ok(value: x): give x; case Err(error: e): { return 2; } };
    Result<TcpStream, IoError> ra = l.accept();
    TcpStream s = match (give ra) { case Ok(value: x): give x; case Err(error: e): { return 4; } };
    Peer p = Peer.make(s: give s);
    Fiber<int32> f = spawn fiber child(n: 1);                       // this isolate runs fibers
    return cast<uint8>(p.region(i: 0) + (give f.join()));
}
fn uint8 main() { return run(); }
