// KR-93. A `comptime` member already belongs to its type (read `V::K`), so `static` on one adds nothing —
// and it was silently accepted, a second spelling of the same declaration.
type value V {
    public int32 x;
    public static comptime int32 K = 4;
    public ctor make() { this.x = 1; }
}

fn uint8 main() { V v = V.make(); return cast<uint8>(V::K - 4); }
