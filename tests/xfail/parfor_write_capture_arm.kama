// A write to a capture inside a `match` arm is a write like any other.
import { std::collections::DynamicArray, std::concurrent::Isolate };
type enum Kind { A(int64 v), B }
fn Kind pick(int64 x) { if (x > 0) { return Kind::A(v: x); } return Kind::B; }
fn uint8 main() {
    DynamicArray<int64> xs = DynamicArray.empty();
    xs.add(item: 1i64);
    int64 k = 3;
    parallel_for (ref int64 e in xs, workers: 2) {
        match (pick(x: e)) { case A(v: n): { k = n; } case B: { } };
    }
    return 0;
}
