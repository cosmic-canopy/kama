// KR-46: a method return type's type argument, naming a name private to `geo/lib.kama`, spelled bare. Must be rejected, naming it.
type value W { public int32 a; public ctor make() { this.a = 1; } public fn Optional<HidErr> m() { return Optional::None; } }
fn uint8 main() { W w = W.make(); return cast<uint8>(w.a - 1); }
