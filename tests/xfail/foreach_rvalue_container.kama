// The general form of the same defect: `foreach` calls `iterator()` on its operand, which takes the
// operand's ADDRESS, and a temporary has none. Bind it to a local and iterate that. An operand that IS
// its own iterator (`"ab".chars()`, `m.valuesMut()`) is copied by value and stays legal.
import { std::collections::DynamicArray };

fn DynamicArray<int32> make() {
    DynamicArray<int32> d = DynamicArray.withCapacity(capacity: 2);
    d.add(item: 1);
    return give d;
}

fn int32 main() {
    int32 t = 0;
    foreach (int32 x in make()) { t = t + x; }
    return t;
}
