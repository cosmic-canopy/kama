// The same bind, in ARGUMENT position. It is a separate fixture because it is a separate code path, and
// for a long time it was an UNCHECKED one: `emitFnPtrBind` — the only place a bind was signature-checked
// — is called from a local declaration and nowhere else, so an assignment, an argument, a return, a
// field and a module `static` all bound through `emitExpression`'s bare function-name arm, which checked
// nothing at all. A promise enforced at one of six bind positions is not a promise.
@noheap fnptr int32 Op(int32 x);
fn int32 plain(int32 x) { return x + x; }
@noheap fn int32 tick(Op f, int32 n) { return f(x: n); }
fn int32 main() { return tick(f: plain, n: 21); }
