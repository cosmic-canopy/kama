// KR-181. A write on ONE path through the arm is enough: the use after the `if` may follow it.
import { std::collections::DynamicArray };
type enum U { A(DynamicArray<int64> xs), B(int64 p, int64 n, int64 c, int64 m) }
fn U mk() { DynamicArray<int64> xs = DynamicArray.empty(); xs.add(item: 7i64); return U::A(xs: give xs); }
fn uint8 main() { int32 argc = knob();
    U u = mk(); int64 n = 0i64;
    match (u) { case A(xs: a): { if (argc > 5) { u = U::B(p: 1i64, n: 1i64, c: 1i64, m: 0i64); } n = a[0]; } case B(p: p, n: q, c: c, m: m): { } };
    return cast<uint8>(n);
}
fn int32 knob() { return 3; }
