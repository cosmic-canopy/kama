// A constructor's value is `this`, and `this` is the ONLY way to name it: declaring uninitialized storage
// of the type being built is a second name for the same thing, and a ctor has no way to hand two of them
// back. This is what makes "one value per ctor" unrepresentable rather than merely rejected.
//
// An INITIALIZED local of the same type stays legal — see tests/ctor_local_of_own_type.kama. The
// restriction is on uninitialized storage, not on the type.
type value P {
    public int32 x;
    public ctor make(int32 x) { P r; r.x = x; return give r; }
}
fn int main() { P p = P.make(x: 1); return p.x; }
