// Two fields with the same wire NAME. The field names differ, so the KB-21 duplicate-member check does not
// see it — a named backend would write the key twice and read back whichever landed last.
@generate(Serializable, Deserializable)
type value R { @field(name: "k") int32 a; @field(name: "k") int32 b; }
fn int32 main() { return 0; }
