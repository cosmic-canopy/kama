import { std::memory::Shared, std::memory::Weak };
// You can't borrow the object through a Weak (it may be dead) — tryUpgrade to a Shared first.
type value Counter { int32 n; public ctor make(int32 n){ this.n = n; } public fn int32 get(){ return this.n; } }
fn int32 read(ref Counter c) { return c.get(); }
fn uint8 main() {
    Shared<Counter> s = new Counter.make(n: 1);
    Weak<Counter> w = s.downgrade();
    return cast<uint8>(read(c: ref w));   // ERROR: borrow through a Weak
}
