// An adapter method off a collection element, never naming Hashable. Refused (scope rule) (KR-370). This MUST fail to compile.
import { std::collections::DynamicArray };
fn uint8 main() {
    DynamicArray<int32> a = DynamicArray.empty();
    a.add(item: 7);
    uint64 h = a[0].hash();
    return h == 0ui64 ? 1 : 42;
}
