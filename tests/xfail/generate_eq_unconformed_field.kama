// A derived `equals` is a field WALK, not a bitwise compare — so every field must itself be comparable.
// `Plain` opts into nothing, so the derive cannot walk it and says which field type is the problem
// (rather than emitting a memcmp that would compare padding and be wrong for any type whose equality
// is not its representation).
type value Plain { public int32 v; }

@generate(Equatable)
type value Holder {
    public int32 id;
    public Plain p;      // not Equatable
}
fn int32 main() { Holder h; return h.id; }
