// KR-46: a method return type's type argument, naming a name `geo` exports that this file does not import. Must be rejected with the import that fixes it.
type value W { public int32 a; public ctor make() { this.a = 1; } public fn Optional<ShownErr> m() { return Optional::None; } }
fn uint8 main() { W w = W.make(); return cast<uint8>(w.a - 1); }
