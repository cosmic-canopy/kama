extern "<stdlib.h>";
extern fn UnsafePtr malloc(usize n);
extern fn void free(UnsafePtr p);
type value Ctrl { public int32 strong; public int32 weak; }
type value Counter { public int32 n; public ctor make(int32 s){ this.n=s; } public fn int32 get(){return this.n;} }
type resource RcWeak<T> {
    UnsafePtr<T> p; UnsafePtr<Ctrl> c;
    public unsafe ctor make(UnsafePtr<T> p, UnsafePtr<Ctrl> c) { this.p = p; this.c = c; }
    unsafe ~RcWeak() { this.c[0].weak = this.c[0].weak - 1; }
}
type resource Rc<T> implements Deref<T>, HeapOwner<T> {
    UnsafePtr<T> p; UnsafePtr<Ctrl> c;
    public unsafe ctor make(UnsafePtr<T> p, UnsafePtr<Ctrl> c) { this.p = p; this.c = c; }
    public unsafe ctor adopt(UnsafePtr<T> raw) { UnsafePtr<Ctrl> k = null; k = cast<UnsafePtr<Ctrl>>(malloc(n: sizeof(Ctrl))); k[0].strong = 1; k[0].weak = 0; return Rc.make(p: raw, c: k); }
    public unsafe fn ref T deref() { return this.p[0]; }
    public unsafe fn RcWeak<T> downgrade() { this.c[0].weak = this.c[0].weak + 1; return RcWeak.make(p: this.p, c: this.c); }
    unsafe ~Rc() { this.c[0].strong = this.c[0].strong - 1; }
}
fn int32 main() {
    Rc<Counter> a = new Counter.make(s: 5);
    RcWeak<Counter> w = a.downgrade();
    return w.get();   // ERROR: RcWeak is not Deref -> `get` is unknown (must tryUpgrade first)
}
