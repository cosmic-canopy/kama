// A type's forms of one operator are told apart by operand type (0.9.947), so a contract's `operator+(int32 rhs)`
// is met only by a form taking `int32`: `operator+(int64 rhs)` is another form, and the contract's is missing.
// The diagnostic names the form as written and the one the type has. Until 0.9.948 it named the operator's C key
// instead: "missing method `kama_op_add::int32`".
type contract Addable for value { int32 operator+(int32 rhs); }
type value N implements Addable {
    int32 v;
    public ctor of(int32 v) { this.v = v; }
    public int64 operator+(int64 rhs) { return cast<int64>(this.v) + rhs; }   // another operand type -> REJECT
}
fn uint8 main() { N a = N.of(v: 1); return 0; }
