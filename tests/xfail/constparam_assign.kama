// A const generic parameter is a compile-time value, not storage, so it cannot be written. This used
// to emit `((int32_t)16) = 3` and die as clang's "expression is not assignable", pointing at generated
// C with no kama diagnostic.
//
// The check sits in `checkConstWrite`, which is on every write path there is — so `F += 1`, `F++` and
// passing `F` to a `ref`/`out` parameter are rejected by the same line.
fn int32 f<comptime F: int32>(int32 x) {
    F = 3;   // ERROR: `F` is a const generic parameter
    return x;
}
fn int32 main() { return f::<16>(x: 1); }
