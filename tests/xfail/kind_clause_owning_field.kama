// A kind clause's value instance owns nothing, so a field whose type its parameters do not decide — a `string`
// owns its bytes for every `T` — makes the clause false for every instance, and the declaration is refused where an
// instance first says so.
type resource P<T> value when [T: value] {
    T a;
    string name;
    public ctor make(T a) { this.a = a; this.name = ""; }
}
fn uint8 main() {
    P<int32> p = P.make(a: 1);
    return 0;
}
