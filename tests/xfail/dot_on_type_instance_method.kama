// Dot-on-type calls a CONSTRUCTOR. `inst` is an instance method, and the message must say so — it used
// to assert "`inst` is a static function" without ever checking which kind it was, then advise
// `Plain::inst(...)`, which produced a SECOND error saying the opposite. One hop, correct the first time.
type value Plain {
    public ctor make() { }
    public fn int32 inst() { return 1; }
}
fn int32 main() { return Plain.inst(); }
