// KR-91: a kama source file is UTF-8 throughout, so a byte that is not is refused when the file is read,
// naming its line, column and byte offset. (The bad bytes are written by a script; an editor would repair them.)
// Here a lone CONTINUATION byte (0x80), which can only follow a lead byte, never start a character.
fn int32 main() {
    string s = "a€b";
    return cast<int32>(s.length());
}
