// KR-87: a module path is written only in an `import` — this position spells an EXPORTED name of `geo` qualified, never imported. Refused, naming the import.
type value W { public int32 a; public ctor make() { this.a = 1; } public fn Optional<geo::ShownErr> m() { return Optional::None; } }
fn int32 main() { W w = W.make(); return w.a - 1; }
