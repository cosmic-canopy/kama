// A field a `borrow` holds still cannot leave inside the window (KR-261, a consuming method: `give fn`; tests/consume_basic is the accepted shape).
import { std::collections::DynamicArray };
type resource Box { int32 v; public ctor make(int32 v) { this.v = v; } public const fn int32 get() { return this.v; } ~Box() { } }
type resource Wrap { Box inner; Box spare;
    public ctor make(Box inner) { this.inner = give inner; this.spare = Box.make(v: 0); }
    public give fn Box unwrap() { return give this.inner; }
    public fn void poke() { }
}
type resource Xs { DynamicArray<int32> xs; public ctor make() { this.xs = DynamicArray.empty(); }
    public give fn DynamicArray<int32> drain() { borrow this.xs.view() as v { DynamicArray<int32> t = give this.xs; } return DynamicArray.empty(); } }   // -> REJECT
fn uint8 main() { return 0; }
