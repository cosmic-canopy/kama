// M26f-2 — using a `resource` value after it was `give`n is a compile error (use-after-move).
import { std::collections::DynamicArray };
type resource Res { DynamicArray<int32> items; public ctor make(int32 v){ this.items.add(item: v); } ~Res(){} public fn int32 head(){ return this.items[0]; } }
fn int32 take(Res r) { return r.head(); }
fn int32 main() {
    Res a = Res.make(v: 1);
    take(r: give a);
    return a.head();   // ERROR: use of `a` after it was moved
}
