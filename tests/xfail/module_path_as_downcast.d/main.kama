// KR-87: a module path is written only in an `import` — this position spells an EXPORTED name of `geo` qualified, never imported. Refused, naming the import.
fn int32 main() { Result<int32, Owned<Error>> r = Result::Err(error: DeError::Malformed); return match (r) { case Ok(value: v): 0; case Err(error: e): match (e.as<geo::ShownErr>()) { case Some(value: x): 1; case None: 0; }; }; }
