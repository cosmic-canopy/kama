// The CONTAINER side is nominal too: a type with a valid `iterator()` (returning a proper
// `implements Iterator<T>` iterator) is still rejected in `foreach` unless the container itself
// declares `implements Iterable<T>`.
type value RangeIter implements Iterator<int32> {
    int32 cur; int32 end;
    public RangeIter(int32 cur, int32 end) { this.cur = cur; this.end = end; }
    public fn Optional<int32> next() {
        if (this.cur >= this.end) { return Optional::None; }
        int32 v = this.cur; this.cur = this.cur + 1; return Optional::Some(value: v);
    }
}
type value Range {                       // has iterator() but does NOT `implements Iterable<int32>`
    int32 n;
    public Range(int32 n) { this.n = n; }
    public fn RangeIter iterator() { return RangeIter(cur: 0, end: this.n); }
}
fn int32 main() {
    Range r = Range(n: 3);
    int32 s = 0;
    foreach (int32 x in r) { s = s + x; }   // ERROR: Range does not `implements Iterable<int32>`
    return s;
}
