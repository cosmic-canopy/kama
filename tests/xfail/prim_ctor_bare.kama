// A primitive has no constructors of its own: `parse` is the contract `Parseable`'s, reached through a bound, and
// std's `parse::<int32>(text: t)` is that bound. Written off the bare name it is refused, naming that call; a `match`
// over it reaches the same sentence rather than "the subject's type could not be resolved". This MUST fail to compile.
import { std::fmt::ParseError };

fn uint8 main() {
    int32 a = match (int32.parse(text: "5")) { case Ok(value: v): v; case Err(error: e): 0; };
    return cast<uint8>(a);
}
