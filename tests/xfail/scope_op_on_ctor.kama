// Construction has exactly ONE spelling: dot-on-type. A `ctor` is static (it takes no `self`), so without
// an explicit guard it would also answer to `::` — two ways to say one thing, and `grep '\.make('` would
// silently miss half the construction sites. This is the mirror of xfail/dot_on_type_not_ctor (a static fn
// called with a dot); together they close both directions.
type value Point {
    public int32 x;
    public ctor make(int32 x) { Point p; p.x = x; return p; }
}
fn int32 main() {
    Point p = Point::make(x: 42);   // ERROR: `::` is scope resolution — construct with `Point.make(...)`
    return p.x;
}
