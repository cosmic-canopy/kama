// `global::` reaches the always-in-scope FLOOR and nothing else (design/module-system.md §2f.29).
// It used to have a second job — `global::a::b::X`, naming a module absolutely, past this file's own
// `import … as` aliases — and that job is gone with the `namespace` declaration: `global` is an ordinary
// reserved PROJECT name now, so `global::std::collections::X` would have to mean module `std/collections`
// OF a project called `global`. The escape it provided is fixed at its source instead — an alias may no
// longer claim a project name (tests/xfail/import_alias_shadows_project.kama).
import { std::collections::DynamicArray };

fn int32 main() {
    global::std::collections::DynamicArray<int32> d = DynamicArray.empty();
    return 0;
}
