// KPG-20's `Result` half: a value of either argument type is not a `Result`; the arm is named. Each says which.
import { std::io::IoError };
fn Result<int32, IoError> ok() { return 5; }
fn Result<int32, IoError> bad() { return IoError::NotFound; }
fn int32 main() {
    Result<int32, IoError> r = IoError::NotFound;
    return 0;
}
