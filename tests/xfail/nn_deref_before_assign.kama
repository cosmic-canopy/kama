// Reading an `Owned` field before it is assigned in the constructor — never-null violation.
import std::memory::{Owned};
type value Box { int32 v; public Box(int32 v) { this.v = v; } public fn int32 get() { return this.v; } }
type resource Bad {
    Owned<Box> a;
    public Bad(int32 seed) {
        int32 x = this.a.get() + seed;         // reads `a` before it is assigned
        Owned<Box> n = new Box(v: x);
        this.a = give n;
    }
}
fn int main() { Bad b = Bad(seed: 5); return 0; }
