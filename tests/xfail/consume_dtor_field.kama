// A type with a destructor may not lose a field: its destructor runs at the method's end and must find every field (Rust E0509) (KR-261, a consuming method: `give fn`; tests/consume_basic is the accepted shape).
type resource Box { int32 v; public ctor make(int32 v) { this.v = v; } public const fn int32 get() { return this.v; } ~Box() { } }
type resource Wrap { Box inner; Box spare;
    public ctor make(Box inner) { this.inner = give inner; this.spare = Box.make(v: 0); }
    public give fn Box unwrap() { return give this.inner; }
    public fn void poke() { }
}
type resource Fd { Box b; public ctor make() { this.b = Box.make(v: 1); } public give fn Box t() { return give this.b; } ~Fd() { } }   // -> REJECT
fn uint8 main() { return 0; }
