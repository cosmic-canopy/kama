// The park rule holds the ROOT too (KR-3 step 4, ruled 2026-10-25): `main` runs fibers, so its own code is in the rule,
// not only what a fiber entry reaches. Here only the root's window parks — `grower` never parks — and before the rule
// the program built and panicked at run time, when `grower` grew `xs` under the root's suspended loop.
import { std::concurrent::Fiber, std::memory::Shared, std::collections::DynamicArray };
fn int32 child(int32 n) { return n; }
type resource Box {
    DynamicArray<int32> xs;
    public ctor make() { this.xs = DynamicArray::<int32>.empty(); this.xs.add(item: 1); this.xs.add(item: 2); }
    public fn int32 sum() {
        int32 total = 0;
        foreach (int32 x in this.xs) {
            Fiber<int32> f = spawn fiber child(n: x);
            total = total + (give f.join());
        }
        return total;
    }
    public fn void grow() { this.xs.add(item: 3); }
}
fn int32 grower(Shared<Box> s) { s.grow(); return 0; }
fn uint8 main() {
    Shared<Box> a = new Box.make();
    Fiber<int32> g = spawn fiber grower(s: copy a);
    int32 t = a.sum();
    return cast<uint8>(t + (give g.join()));
}
