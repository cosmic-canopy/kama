// The same cause at the `borrow` gate: `borrow s.bytes() as v` blamed the string for not being a container
// ("has no nullary `.bytes()`, so it cannot open a window"). A string is one; the program lacks the view type.
fn uint8 main() {
    string s = "abc";
    borrow s.bytes() as v { return cast<uint8>(v[0]); }
}
