// A read-only place gives a `const` alias (KR-123): `getRef` returns `const ref V`, so `cv` cannot be written.
import { std::collections::Map, std::collections::DynamicArray };
fn uint8 main()
{
    Map<string, int32> m = Map.empty();
    m.put(key: "a", value: 1);
    borrow m.getRef(key: "a") as cv { cv = 3; }
    return 0;
}
