// A format specifier on a user-type hole is a compile error — specifiers apply only to numeric holes (the
// `Format` contract itself stays spec-less; specs are primitive Formatter fast-paths).
type value Pt implements Format {
    public int32 x;
    public ctor make(int32 x) { slot Pt p; p.x = x; return p; }
    public fn void format(ref Formatter f) { f.writeI64(v: cast<int64>(this.x)); }
}

fn int main() {
    Pt p = Pt.make(x: 5i32);
    string s = "${p:0x}";
    return 0;
}
