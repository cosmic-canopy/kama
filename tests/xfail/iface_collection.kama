// M26e — a collection of interface fat pointers would store borrows that dangle.
// Store owning handles instead: a `DynamicArray<Shared<Shape>>` (M26f).
import { std::collections::DynamicArray };
type contract Shape for value { fn int32 area(); }
type value Sq implements Shape { int32 s; public Sq(int32 s){ this.s = s; } public fn int32 area(){ return this.s * this.s; } }
fn int32 main() { DynamicArray<Shape> xs = DynamicArray.empty(); return 0; }
