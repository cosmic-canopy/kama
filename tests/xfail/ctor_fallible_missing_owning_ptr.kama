import { std::memory::Owned };
// Construction-model M3: wrapping an incomplete object in `Result::Ok(value: …)` does NOT excuse it — the
// checker unwraps `Ok` and still requires every owning field set. (Infallible counterpart: ctor_missing_owning_ptr.)
type enum HolderErr implements Error {
    Negative;

    public const fn string message() { return "negative"; }
}
type value Box { int32 v; public ctor make(int32 v) { this.v = v; } }
type resource Holder {
    Owned<Box> a;
    public ctor Result<Holder, HolderErr> make(int32 v) {
        if (v < 0) { return Result::Err(error: HolderErr::Negative); }
        return Result::Ok(value: this);   // ERROR: `a` never set
    }
}
fn int32 main() { return 0; }
