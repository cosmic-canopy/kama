// Two exposed functions cannot share an exported symbol, whether the symbol is the one kama derives (the
// module path, or in a loose file the file name, joined to the name with `_`) or a `@linkName` — uniqueness
// is over what the host sees.
expose fn int32 update() { return 1; }                                  // exports `linkname_dup_expose_update`
@linkName("linkname_dup_expose_update") expose fn int32 tick() { return 2; }
fn int32 main() { return 0; }
