// M26d — returning a smart-pointer FIELD must say `give` (move it out, nulling the
// field) or `copy` (retain — the field stays valid). A bare `return this.c` would
// shallow-copy the handle without a refcount bump → a later double-decrement.
class C { int32 n; public C(int32 n){ this.n = n; } }
class H {
    Shared<C> c;
    public H() { }
    public fn Shared<C> leak() { return this.c; }
}
fn int32 main() { return 0; }
