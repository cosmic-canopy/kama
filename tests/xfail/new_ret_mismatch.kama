import std::memory::{Owned};
type value C { int32 n; public ctor make(int32 n){ slot C r; r.n=n; return give r; } }
type value D { int32 m; public ctor make(int32 m){ slot D r; r.m=m; return give r; } }
fn Owned<C> make(){ return new D.make(m: 1); }   // ERROR: Owned<C> owns C, got new D
fn int32 main(){ Owned<C> a = make(); return 0; }
