// A `foreach (ref …)` writes through to what it loops over, so over a capture every worker writes the same elements. It passed
// the gate to 0.9.850, which saw only a read of `ys`: eight workers adding 100,000 each to one element ended at 300,000.
import { std::collections::DynamicArray, std::concurrent::Isolate };
fn uint8 main() {
    DynamicArray<int64> xs = DynamicArray.empty();
    xs.add(item: 1i64);
    DynamicArray<int64> ys = DynamicArray.empty();
    ys.add(item: 0i64);
    parallel_for (ref int64 e in xs, workers: 2) {
        foreach (ref int64 y in ys) { y = y + 1; }
    }
    return 0;
}
