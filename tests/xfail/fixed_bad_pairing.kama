// `Fixed<B>#(const F)` takes its storage and its fraction as two independent parameters, so nothing about
// the SPELLING stops you pairing 16 fractional bits with an 8-bit backing. `Fixed<int8>#(16)` would
// otherwise compile and then produce garbage at run time: every value would shift its whole magnitude out
// of the backing.
//
// The rejection is not a rule the compiler knows about this type. It is one `comptime assert` in the
// type's own body, reading `sizeof(B)` — two general language features composing, which is why a user's
// own generic can state its own invariants the same way, and why nothing in the compiler mentions `Fixed`.
import { std::num::Fixed };

fn int32 main() {
    Fixed<int32>#(16) ok  = Fixed::<int32>#(16).one();   // 16 fractional bits in 32 — fine
    Fixed<int8>#(16)  bad = Fixed::<int8>#(16).one();    // 16 in 8 — the assert fails, naming BOTH halves
    return ok.raw + cast<int32>(bad.raw);
}
