// Contract first on a member WITH a receiver. Refused naming the contract value (KR-370). This MUST fail to compile.
type contract W<T is This> for intrinsic { const fn int32 code(); }
type adapter <int32> implements W<This> { public const fn int32 code() { return 1; } }
fn uint8 main() { return cast<uint8>(W::<int32>.code()); }
