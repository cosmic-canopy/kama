import std::memory::{Owned};
// Definite-assignment for locals: reading an owning FIELD of a slot (`h.a`) before the slot is filled is a
// null-deref -> rejected. The fill below is real — this pins the ORDER. (Positive: def_assign_field_ok.)
type value Box { int32 v; public ctor make(int32 v) { this.v = v; } public fn int32 get() { return this.v; } }
type resource Holder {
    Owned<Box> a;
    public ctor make(Owned<Box> a) { this.a = give a; }
    static fn void into(Owned<Box> a, out Holder dst) { dst = Holder.make(a: give a); }
    public static fn int32 broken() {
        slot Holder h;
        int32 r = h.a.get();       // ERROR: 'h.a' used before it is assigned
        Owned<Box> b = new Box.make(v: 1);
        Holder::into(a: give b, dst: out h);
        return r;
    }
}
fn int32 main() { return Holder::broken(); }
