import std::memory::{Owned};
// Definite-assignment for locals: reading an owning FIELD of a bare resource local (`h.a`) before it is
// assigned is a null-deref -> rejected. (Positive: def_assign_field_ok.)
type value Box { int32 v; public Box(int32 v) { this.v = v; } public fn int32 get() { return this.v; } }
type resource Holder {
    Owned<Box> a;
    public Holder(Owned<Box> a) { this.a = give a; }
    public static fn int32 broken() {
        Holder h;              // h.a is null
        return h.a.get();      // ERROR: 'h.a' used before it is assigned
    }
}
fn int32 main() { return Holder::broken(); }
