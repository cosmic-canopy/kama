// An adapter member written `private`. Refused (an adapter's members are its contract's, so public) (KR-370). This MUST fail to compile.
type contract Tagged for intrinsic { const fn int32 tag(); }
type adapter <int32> implements Tagged { private const fn int32 tag() { return 5; } }
fn int32 via<T: Tagged>(T x) { return x.tag(); }
fn uint8 main() { int32 n = 0; return cast<uint8>(via(x: n)); }
