// A subclass cannot reach a base class's PRIVATE field (only protected/public).
type virtual resource Base { int32 secret; public ctor make(int32 s){ slot Base r; r.secret = s; return give r; } }
type final resource Derived extends Base {
    public ctor make(int32 s){ slot Derived r; r.secret = s; return give r; }       // ERROR: secret is private in Base
    public fn int32 leak() { return this.secret; }
}
fn int main() { return 0; }
