// A `parallel_for` chunk may not wait on an `Atomic` (KR-3 decision 5): `wait` sleeps until another task stores and
// notifies, and that task may be a chunk queued behind this one. Reading or updating one is fine.
import { std::collections::DynamicArray, std::concurrent::Atomic };
fn uint8 main() {
    DynamicArray<int32> xs = DynamicArray.empty();
    xs.add(item: 1);
    parallel_for (ref int32 e in xs, chunks: 1) {
        Atomic<int32> flag = Atomic.make(value: 0);
        e = flag.wait(whileEquals: 1);
    }
    return 0;
}
