// A chunk is bound as the view it is: `xs` splits into `View<int32>` chunks, and a `View<int64>` binding is refused,
// rather than reading each chunk as some other element type.
import { std::collections::DynamicArray, std::collections::View };

fn uint8 main() {
    DynamicArray<int32> xs = DynamicArray.empty();
    xs.add(item: 1); xs.add(item: 2);
    parallel_for (View<int64> part in xs, chunks: 2) { }   // -> REJECT
    return 0;
}
