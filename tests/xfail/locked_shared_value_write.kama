// A shared window is read-only: its `value()` is a `const ref`, since readers hold it at once (KR-226).
import { std::concurrent::Locked, std::concurrent::ReadWriteLocked };
type value Counter implements Sendable { public int32 n; public ctor zero() { this.n = 0; } }
fn uint8 main() {
    ReadWriteLocked<Counter> c = ReadWriteLocked.make(value: Counter.zero());
    borrow c.lockShared().value() as v { v.n = 1; }
    return 0;
}
