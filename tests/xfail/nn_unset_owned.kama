// An `Owned` field left unset by the constructor — `Owned`/`Shared` are never-null.
// NOTE: legacy instance ctor retained deliberately — this exercises the legacy `checkCtorNeverNull`
// path; migrate at the Phase-E enforcement flip (named-ctor equivalent: xfail/ctor_missing_owning_ptr).
import std::memory::{Owned};
type value Box { public Box() { } }
type resource Bad {
    Owned<Box> a;
    public Bad() { }              // leaves `a` unset
}
fn int main() { Bad b = Bad(); return 0; }
