// M8a: a contract's `ctor` requirement is enforced like any other contract member — a type that
// `implements Factory` but omits `ctor create(...)` is rejected (missing contract method).
type contract Factory for value { ctor create(int32 seed); }

type value Broken implements Factory {
    public int32 v;
}

fn int32 main() {
    Broken b = Broken.create(seed: 1);
    return b.v;
}
