// `copyElements` copies each element as `copy x` would, so an element that does not copy — a resource that never
// opted into `Copyable` — is refused, naming the type.
type resource Token { int32 v; public ctor make() { this.v = 1; } ~Token() { } }
unsafe fn void fill(UnsafePtr<Token> d, UnsafePtr<Token> s) {
    copyElements(ptr: d, from: s, count: 1);
}
fn int32 main() { return 0; }
