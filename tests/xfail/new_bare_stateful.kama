import { std::memory::Owned, std::collections::Arena, std::collections::BumpAllocator };
type value Node { int32 v; public ctor make(int32 v){ this.v=v; } public fn int32 get(){ return this.v; } }
fn int32 main() {
    Arena arena = Arena.make(capacity: 1024);
    Owned<Node, BumpAllocator> x = new Node.make(v: 1);   // ERROR: stateful allocator needs new(allocator: …)
    return x.get();
}
