// M31b — arity picks the form: 0 params = unary. `*` has no unary form, so `operator*()` is rejected.
type value Vec2 {
    public int32 x;
    public ctor make(int32 x) { this.x = x; }
    public Vec2 operator*() { return Vec2.make(x: this.x); }   // `*` has no unary form
}
fn int32 main() { return 0; }
