import std::memory::{Owned};
// Definite-assignment for locals: a bare owning (`Owned`) slot read (here via auto-deref `.get()`) before
// its `out` fill is a null-deref in safe code -> rejected. (Positive: def_assign_assign_then_read.)
type value Box { int32 v; public ctor make(int32 v) { this.v = v; } public fn int32 get() { return this.v; } }
fn void build(out Owned<Box> b) { Owned<Box> t = new Box.make(v: 1); b = give t; }
fn int32 main() {
    slot Owned<Box> b;        // zero-inited -> null Owned
    int32 r = b.get();   // ERROR: 'b' used before it is assigned
    build(b: out b);
    return r;
}
