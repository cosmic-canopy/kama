// The budget runs out. `Widget` allows 2 more levels, so `Control` may allow at most 1 — and it does —
// but that leaves `Button` a budget of 0, which is spelled `final`. Asking for one more is the
// Widget -> Control -> Button -> ... archetype the cap exists to stop, and it is refused at the type that
// asks, naming the number it may have.
//
// The chain length is bounded by the ROOT's budget by construction, so there is no separate arithmetic:
// each level states what it passes down, and the sum cannot exceed what the root opened with.
// tests/vtable_depth3 is the accepted three-level form.
type virtual(maxDepth: 2) resource Widget
{
    public ctor make() { }
    public fn int32 rank() { return this.step(); }
    protected virtual fn int32 step() { return 1; }
}
type virtual(maxDepth: 1) resource Control extends Widget
{
    public ctor make() { this.base = Base.make(); }
    protected override fn int32 step() { return base.step() + 10; }
}
type virtual(maxDepth: 1) resource Button extends Control       // one level too far — must be `final`
{
    public ctor make() { this.base = Base.make(); }
    protected override fn int32 step() { return base.step() + 100; }
}
fn int32 main() { Button b = Button.make(); return b.rank(); }
