// M31c — the bound is enforced: a type without the operators cannot satisfy the prelude's `Arithmetic`.

type value Plain {
    public int32 v;
    public ctor make(int32 v) { this.v = v; }   // no operator+
}

fn T sum<T: Arithmetic<T>>(T a, T b) { return a + b; }

fn uint8 main() {
    Plain p = Plain.make(v: 1);
    Plain q = Plain.make(v: 2);
    Plain r = sum(a: p, b: q);   // Plain does not satisfy Arithmetic
    return cast<uint8>(r.v);
}
