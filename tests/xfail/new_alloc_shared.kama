import std::memory::{Shared};
import std::collections::{Arena, BumpAllocator};
type value Node { int32 v; public Node(int32 v){ this.v=v; } public fn int32 get(){ return this.v; } }
fn int32 main() {
    Arena arena = Arena(capacity: 1 << 10);
    Shared<Node> s = new(allocator: arena.handle()) Node(v: 1);   // ERROR: allocator-aware new is Owned-only
    return s.get();
}
