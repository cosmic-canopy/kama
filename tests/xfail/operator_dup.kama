// M31 — operators may distinguish OPERAND TYPES (mat*vec vs mat*mat — the sanctioned exception), but
// two operators with the SAME symbol AND the same operand type are a genuine duplicate → clean error.
type value Vec2 {
    public int32 x;
    public ctor make(int32 x) { this.x = x; }
    public Vec2 operator+(Vec2 rhs)   { return Vec2.make(x: this.x + rhs.x); }   // op_add (same-type)
    public Vec2 operator+(Vec2 other) { return Vec2.make(x: this.x - other.x); } // op_add AGAIN — duplicate
}
fn int32 main() { return 0; }
