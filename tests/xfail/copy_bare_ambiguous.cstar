// M26f-4 — a `resource` that opted into `Copyable` (a public nullary `copy` returning its own
// type) makes the give/copy marker MANDATORY: a bare hand-off is now ambiguous (both move and
// copy are plausible) and must be a compile error. Say `give` (move) or `copy` (duplicate).
type resource Res {
    int32 n;
    public Res(int32 v) { this.n = v; }
    ~Res() { }                                              // resource (move-only)
    public fn Res copy() { Res r = Res(v: this.n); return give r; }   // opt into Copyable
    public fn int32 head() { return this.n; }
}
fn int32 main() {
    Res a = Res(v: 1);
    Res b = a;            // ERROR: ambiguous — a is copyable; say `give` or `copy`
    return b.head();
}
