// `@linkName` on a field binds a C member, and only a `type extern value`'s fields are C's to name. On a type
// kama lays out, the attribute would rename nothing a reader can see — kama spells those fields itself.
type value Pt {
    @linkName("x_pos") public int32 x;
    public ctor make(int32 x) { this.x = x; }
}
fn int32 main() { Pt p = Pt.make(x: 1); return p.x; }
