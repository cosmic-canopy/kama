// A subclass that leaves an inherited pure method un-overridden is itself abstract.
type abstract resource Shape { protected abstract fn int32 area(); }
type final resource Bad extends Shape { int32 x; public ctor make(int32 x){ Bad r; r.x = x; return give r; } }   // forgot to override area
fn int main() { Bad b = Bad.make(x: 1); return 0; }
