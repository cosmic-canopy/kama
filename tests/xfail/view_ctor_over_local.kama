// A `type view` ctor is a factory that returns the view it builds — but it may only borrow its
// PARAMETERS (caller-owned memory that outlives the call), never a ctor-LOCAL buffer. Here `r.p`
// borrows a local `int32` whose storage dies at return, so the view would dangle: rejected.
// (This is exactly the footgun the sound escape check closes — a view ctor is NOT blindly trusted.)
type view Span {
    UnsafePtr<int32> p; int32 n;
    unsafe ctor make() {
        int32 buf = 7;
        this.n = 1;
        this.p = addr(of: buf);   // borrows a LOCAL -> would dangle
    }
}
// The rejection is at the CONSTRUCTOR's declaration, so nothing has to call it to observe it.
fn int32 main() { return 0; }
