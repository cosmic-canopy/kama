// `addr(of: …)` on a const root hands back an `UnsafeConstPtr<T>` — a read-only pointer, which is what a
// `const fn` may honestly return. Returning it AS an `UnsafePtr<T>` is the launder deep const forbids,
// and it is refused at the `return`, by the same rule that refuses it at a local, an assignment or an
// argument (tests/xfail/const_ptr_to_mut_*). The const-typed twin — `const fn UnsafeConstPtr<int32>
// peek()` — is tests/unsafe_const_ptr.kama.
type value Cell {
    int32 n;
    public ctor make() { this.n = 5; }
    public unsafe const fn UnsafePtr<int32> leak() { return addr(of: this.n); }   // -> REJECT
}
fn int32 main() { Cell c = Cell.make(); return 0; }
