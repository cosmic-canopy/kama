// `this.base` is not a general assignment: a base part is built by its own constructor or not at all.
// Base fields are private, so there would be nothing to adjust afterwards anyway.
type virtual resource Base {
    int32 n;
    public ctor make(int32 n) { this.n = n; }
    protected virtual fn int32 tag() { return 0; }
    public fn int32 rank() { return this.n + this.tag(); }
}
fn Base makeOne() { return Base.make(n: 4); }
type final resource Leaf extends Base {
    int32 own;
    public ctor make(int32 own) { this.base = makeOne(); this.own = own; }
    protected override fn int32 tag() { return this.own; }
}
fn int main() { Leaf l = Leaf.make(own: 1); return l.rank(); }
