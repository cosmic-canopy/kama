// The park rule (KR-3 step 4) follows `sleep` once it parks (step 5): on an isolate that runs fibers, a sleep switches
// fibers, so a lasting access to `Shared` storage may not make one. `Clock.pace` iterates `this.ticks` — reached
// through the `Shared` the fiber was handed — and sleeps inside the loop, so another fiber could grow `ticks` and free
// the buffer the loop is reading while this one sleeps.
import { std::concurrent::Fiber, std::memory::Shared, std::collections::DynamicArray,
         std::time::sleep, std::time::Duration };
type resource Clock {
    DynamicArray<int32> ticks;
    public ctor make() { this.ticks = DynamicArray::<int32>.empty(); this.ticks.add(item: 1); }
    public fn int32 pace() {
        int32 total = 0;
        foreach (int32 t in this.ticks) {
            sleep(d: Duration.fromMillis(ms: 1));   // ERROR: a fiber's sleep, inside the window
            total = total + t;
        }
        return total;
    }
}
fn int32 walk(Shared<Clock> c) { return c.pace(); }
fn uint8 main() {
    Shared<Clock> c = new Clock.make();
    Fiber<int32> w = spawn fiber walk(c: copy c);
    return cast<uint8>(give w.join());
}
