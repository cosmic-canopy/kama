// A base's method sees only the base's fields, so consuming through it would drop part of a derived value (ruled 2026-10-30) (KR-261, a consuming method: `give fn`; tests/consume_basic is the accepted shape).
type resource Box { int32 v; public ctor make(int32 v) { this.v = v; } public const fn int32 get() { return this.v; } ~Box() { } }
type resource Wrap { Box inner; Box spare;
    public ctor make(Box inner) { this.inner = give inner; this.spare = Box.make(v: 0); }
    public give fn Box unwrap() { return give this.inner; }
    public fn void poke() { }
}
type virtual(maxDepth: 1) resource Shape { int32 s; public ctor make() { this.s = 1; } public give fn int32 t() { return 1; } }   // -> REJECT
fn uint8 main() { return 0; }
