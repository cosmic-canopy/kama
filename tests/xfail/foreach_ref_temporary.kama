// A collection a call returns is kept for a by-value or `const ref` loop (KR-165), but a `ref` loop over it is
// refused: its writes would land in a temporary about to be dropped.
import { std::collections::DynamicArray };

fn DynamicArray<int32> digits() { DynamicArray<int32> d = DynamicArray.empty(); d.add(item: 1); return give d; }

fn uint8 main() {
    foreach (ref int32 k in digits()) { k = 9; }   // -> REJECT
    return 0;
}
