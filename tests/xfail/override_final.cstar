// A `final` method seals its slot — no subclass may override it.
type virtual resource Base { protected virtual fn int h() { return 0; } }
type virtual resource Mid extends Base { protected final override fn int h() { return 1; } }   // seals h
type virtual resource Leaf extends Mid { protected override fn int h() { return 2; } }          // ERROR: h is final
fn int main() { return 0; }
