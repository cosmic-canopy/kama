// A `foreach (ref …)` is a writable window over its operand, and one storage takes one name. The loop calls the
// container's `iterMut()` itself, never through a method call's freeze check, so through 0.9.793 a second `ref` loop
// over the same container inside the first compiled: `x` and `y` were two writable names for one element.
import { std::collections::DynamicArray };
fn uint8 main() {
    DynamicArray<int32> d = DynamicArray.empty();
    d.add(item: 1);
    foreach (ref int32 x in d) { foreach (ref int32 y in d) { y = 1; x = 2; } }
    return 0;
}
