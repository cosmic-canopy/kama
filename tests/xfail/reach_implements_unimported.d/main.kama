// KR-46: an `implements` contract, naming a name `geo` exports that this file does not import. Must be rejected with the import that fixes it.
type value W implements ShownC { int32 a; public ctor make() { this.a = 1; } public fn int32 cm() { return this.a; } }
fn int32 main() { W w = W.make(); return w.cm() - 1; }
