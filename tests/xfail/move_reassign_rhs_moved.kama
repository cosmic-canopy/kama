// The assignment's target is a write, not a read — but only the target: a `give` of the same moved local on the
// right side is still a use after move (KRD-1 exempts the target by node, not by name).
type resource Res { int32 v; public ctor make(int32 v) { this.v = v; } public const fn int32 get() { return this.v; } ~Res() { } }
fn void sink(Res r) { }
fn Res wrap(Res r) { return Res.make(v: r.get() + 1); }

fn int32 main() {
    Res r = Res.make(v: 1);
    sink(r: give r);
    r = wrap(r: give r);
    return 0;
}
