// KR-181. Passing the subject by `ref` is a write to it: the callee may replace the payload.
import { std::collections::DynamicArray };
type enum U { A(DynamicArray<int64> xs), B(int64 p, int64 n, int64 c, int64 m) }
fn U mk() { DynamicArray<int64> xs = DynamicArray.empty(); xs.add(item: 7i64); return U::A(xs: give xs); }
fn void reset(ref U s) { s = U::B(p: 1i64, n: 1i64, c: 1i64, m: 0i64); }
fn int32 main() {
    U u = mk(); int64 n = 0i64;
    match (u) { case A(xs: a): { reset(s: ref u); n = a[0]; } case B(p: p, n: q, c: c, m: m): { } };
    return cast<int32>(n);
}
