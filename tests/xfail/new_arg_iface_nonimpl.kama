import std::memory::{Owned};
type contract Shape for both { fn int32 area(); }
type value Square { int32 s; public Square(int32 s){ this.s=s; } }   // does NOT implement Shape
fn int32 take(Owned<Shape> c){ return c.area(); }
fn int32 main(){ return take(c: new Square(s: 4)); }   // ERROR: Square does not implement Shape
