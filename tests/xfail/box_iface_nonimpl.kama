extern "<stdlib.h>";
extern fn void free(UnsafePtr p);
type contract Shape for value { fn int32 area(); }
type value Circle implements Shape { int32 r; public ctor make(int32 r){this.r=r;} public fn int32 area(){return this.r;} }
type value Square { int32 s; public ctor make(int32 s){this.s=s;} }   // does NOT implement Shape
type resource Box<T> implements Deref<T>, HeapOwner<T> {
    UnsafePtr<T> p;
    public ctor adopt(UnsafePtr<T> raw) { this.p = raw; return this; }
    public fn ref T deref() { unsafe { return this.p[0]; } }
    ~Box() { unsafe { free(p: cast<UnsafePtr>(this.p)); } }
}
fn int32 main() { Box<Shape> b = new Square.make(s: 4); return 0; }   // ERROR: Square does not implement Shape
