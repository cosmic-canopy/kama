// A `ref` argument hands the callee a mutable borrow, which is exactly what the window forbids — the
// callee can grow the frozen container and the view is left dangling. The place test is the same one
// that keeps a disjoint sibling field mutable; `a` is the borrowed place itself.
import std::collections::{View, DynamicArray};

fn int32 sum(View<int32> xs) { int32 t = 0; foreach (int32 x in xs) { t = t + x; } return t; }
fn void grow(ref DynamicArray<int32> d) { d.add(item: 7); d.add(item: 8); d.add(item: 9); }

fn int32 main() {
    DynamicArray<int32> a = DynamicArray.withCapacity(capacity: 2);
    a.add(item: 1); a.add(item: 2);
    int32 r = 0;
    borrow a.view() as v {
        grow(d: ref a);              // a mutable borrow of frozen storage
        r = sum(xs: v);
    }
    return r;
}
