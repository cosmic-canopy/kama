// Construction-model M4: dot-on-type `Type.name(...)` names a constructor that does not exist -> rejected.
type value Point {
    int32 x;
    public ctor make(int32 x) { slot Point p; p.x = x; return p; }
}
fn int32 main() {
    Point p = Point.nope(x: 1);   // ERROR: no constructor `nope` on Point
    return 0;
}
