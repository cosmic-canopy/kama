// M27b-beta: a generic type must be given exactly as many type arguments as it has parameters.
// `Pair<int32>` supplies one argument to a two-parameter template — a compile-time error.
type value Pair<A, B> { public A a; public B b; public ctor make(A x, B y) { Pair<A, B> r; r.a = x; r.b = y; return give r; } }
fn int main() { Pair<int32> p = Pair.make(x: 1, y: 2); return 0; }
