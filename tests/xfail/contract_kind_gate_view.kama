// A `type view` is its own kind, not a `value`. It codegens like one (TypeKind::Value drives layout and
// copying) but the conformance gate keys on `isBorrow`, so a contract that does not list `view` rejects it.
type contract Drawable for value { fn int32 draw(); }
type view Span implements Drawable {
    UnsafePtr<int32> data; int32 len;
    public unsafe ctor make(UnsafePtr<int32> data, int32 len) { this.data = data; this.len = len; }
    public fn int32 draw() { return this.len; }
}
fn int32 main() { return 0; }
