// M26f-4 — `copy` of a `resource` that has NOT opted into `Copyable` (no `copy` method) is a
// compile error: it guides you to add a `copy` method (opt into `Copyable`) or `give` to move.
type resource Res { DynamicArray<int32> items; public ctor make(int32 v){ Res r; r.items.add(item: v); return give r; } ~Res(){} }
fn int32 main() { Res a = Res.make(v: 1); Res b = copy a; return 0; }   // ERROR: Res has no `copy` method
