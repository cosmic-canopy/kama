// M4.2 disjointness (the no-footgun guard): two children of one `scope` may not `ref`-borrow OVERLAPPING
// places — they would race on that cell. M4 guarantees LIFETIME (join-before-drop), not EXCLUSIVITY, so
// the compiler forbids the overlap outright rather than trusting the programmer.
//
// Borrowing the same root twice is the degenerate case: a place is a prefix of itself. Two DISJOINT
// fields of one local are admitted (scope_borrow_disjoint_fields), and `ref w` beside `ref w.bodies` is
// still caught because `{w}` is a prefix of `{w, bodies}` (scope_borrow_nested_prefix). Distinct locals
// are fine (scope_borrow_disjoint); splitting one buffer by index is `parallel_for`. Must fail.
import { std::concurrent::Isolate };

type value Acc implements Sendable {
    public int32 total;
    int32 lo;
    int32 hi;
    public ctor range(int32 lo, int32 hi) { this.total = 0; this.lo = lo; this.hi = hi; return this; }
    public fn void run() { int32 i = this.lo; while (i < this.hi) { this.total = this.total + i; i = i + 1; } }
}

fn void accumulate(ref Acc a) { a.run(); }

fn int32 main() {
    Acc shared = Acc.range(lo: 0, hi: 100);
    scope {
        spawn accumulate(a: ref shared);   // borrows `shared`
        spawn accumulate(a: ref shared);   // ERROR: second child borrows the SAME root -> would race
    }
    return shared.total % 256;
}
