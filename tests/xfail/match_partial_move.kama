// A `resource` value moved in SOME match arms but not others is MaybeMoved at the join and live at
// scope exit -> compile error (the conditional-drop guard; `match` is exhaustive, no implicit arm).
import { std::collections::DynamicArray };
type resource Res { DynamicArray<int32> items; public ctor make(int32 v){ this.items.add(item: v); } ~Res(){} public fn int32 head(){ return this.items[0]; } }
fn int32 sink(Res r) { return r.head(); }
type enum Two { A, B }
fn int32 main() {
    Res a = Res.make(v: 1);
    Two t = Two::A;
    int32 z = 0;
    match (t) {
        case A: sink(r: give a);   // moved on this arm only
        case B: z = 9;
    };
    return z;   // ERROR: `a` moved on some paths but not others, live at scope exit
}
