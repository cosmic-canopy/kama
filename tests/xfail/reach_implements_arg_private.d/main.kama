// KR-46: a type argument of an `implements` contract, naming a name private to `geo/lib.kama`, spelled bare. Must be rejected, naming it.
type contract Holds<X> for value { fn int32 cm(); }
type value W implements Holds<HidVal> { int32 a; public ctor make() { this.a = 1; } public fn int32 cm() { return this.a; } }
fn uint8 main() { W w = W.make(); return cast<uint8>(w.cm() - 1); }
