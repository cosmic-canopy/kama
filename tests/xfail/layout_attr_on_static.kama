// Layout control is a property of a TYPE, not of one declaration — so there is exactly one way to align
// an object instead of two. Rust makes the same call: `#[repr(align(N))]` is types-only, and a static is
// aligned by wrapping it in an aligned type. The diagnostic names that route rather than just refusing.
@align(64)
static uint32 dmaBuf;

fn int32 main() { return cast<int32>(dmaBuf); }
