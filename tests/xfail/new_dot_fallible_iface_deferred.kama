// Construction-model M4b: fallible `new` into an interface-element handle (`Result<Owned<Contract>, E>`) is
// NOT yet supported — a follow-on milestone (mirroring the intricate infallible interface boxing inside the
// Ok branch, with full SAN leak-path coverage). It fails with a precise "not yet supported" diagnostic,
// distinct from the old M4a "coming in M4b" text. Concrete `Owned`/`Shared` fallible `new` DOES work (see
// tests/dot_on_type_new_fallible.kama).
import std::memory::{Owned};
extern "<stdlib.h>";
extern fn Ptr malloc(usize n);
extern fn void free(Ptr p);

type contract Shape for both { fn int32 area(); }
type resource Circle implements Shape {
    Ptr<int32> buf;
    public ctor Result<Circle, int32> open(int32 r) {
        if (r < 0) { return Result::Err(error: -1); }
        Circle c; unsafe { c.buf = cast<Ptr<int32>>(malloc(n: sizeof(int32))); c.buf[0] = r; } return Result::Ok(value: c);
    }
    public fn int32 area() { unsafe { return this.buf[0] * this.buf[0]; } }
    ~Circle() { unsafe { free(p: cast<Ptr>(this.buf)); } }
}
fn int32 main() {
    Result<Owned<Shape>, int32> c = new Circle.open(r: 5);   // ERROR: interface fallible `new` — a follow-on
    return 0;
}
