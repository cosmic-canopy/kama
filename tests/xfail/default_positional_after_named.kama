// M8: once a named type-arg override appears, a following positional arg is a compile-time error.
type value Trip<T, U = int32, V = int32> { public T a; public ctor make(T x){ slot Trip<T, U, V> r; r.a = x; return give r; } }
fn int main() { Trip<int32, U: float64, bool> t = Trip.make(x: 1); return 0; }
