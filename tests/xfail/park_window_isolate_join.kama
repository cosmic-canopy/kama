// The park rule (KR-3 step 4) follows an isolate's join once it parks (step 6): on an isolate that runs fibers, a
// `scope`'s close over an isolate child waits by parking, so a lasting access to `Shared` storage may not make one.
// `Crew.run` iterates `this.shifts` — reached through the `Shared` the fiber was handed — and closes a scope with an
// isolate in it inside the loop, so another fiber could free the buffer the loop is reading while this one waits.
import { std::concurrent::Fiber, std::memory::Shared, std::collections::DynamicArray };
type resource Shift implements Sendable {
    int32 n = 0;
    public ctor of(int32 n) { this.n = n; }
}
fn void work(Shift s) { }
type resource Crew {
    DynamicArray<int32> shifts;
    public ctor make() { this.shifts = DynamicArray::<int32>.empty(); this.shifts.add(item: 1); }
    public fn int32 run() {
        int32 total = 0;
        foreach (int32 s in this.shifts) {
            Shift one = Shift.of(n: s);
            scope { spawn work(s: give one); }   // ERROR: an isolate's join, inside the window
            total = total + s;
        }
        return total;
    }
}
fn int32 walk(Shared<Crew> c) { return c.run(); }
fn uint8 main() {
    Shared<Crew> c = new Crew.make();
    Fiber<int32> w = spawn fiber walk(c: copy c);
    return cast<uint8>(give w.join());
}
