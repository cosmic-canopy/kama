// M26i — an inline constructor materializes a temporary rvalue, so it can't be passed to a
// `ref`/`out` parameter (nothing stable to borrow). Rejected with a clear diagnostic guiding
// the user to bind a local first.
type value Counter {
    int32 n;
    public Counter(int32 start) { this.n = start; }
    public fn void bump() { this.n = this.n + 1; }
}
fn void bump(ref Counter c) { c.bump(); }
fn int32 main() {
    bump(c: ref Counter(start: 1));    // inline ctor to a `ref` param -> REJECT
    return 0;
}
