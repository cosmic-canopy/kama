// `drop(value: p[0])` through a raw `UnsafePtr<T>` element is refused. The element is untyped to
// ownership, so the call used to compile to a literal `(void)0;` — a drop that dropped nothing, silently.
// A library owner drops its pointee through `deref()`'s `ref T` instead (see lib/std/memory/owned.kama).
extern fn UnsafePtr malloc(usize n);

type resource Big {
    int32 n;
    public ctor sized(int32 n) { this.n = n; return this; }
    ~Big() { }
}

unsafe fn int32 run() {
    UnsafePtr<Big> p = cast<UnsafePtr<Big>>(malloc(n: cast<usize>(sizeof(Big))));
    p[0] = Big.sized(n: 14);
    drop(value: p[0]);   // rejected: nothing would be dropped
    return 0;
}

fn int32 main() { return run(); }
