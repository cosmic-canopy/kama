extern "<stdlib.h>";
extern fn UnsafePtr malloc(usize n);
extern fn void free(UnsafePtr p);
type value Ctrl { public int32 strong; public int32 weak; }
type value Counter { public int32 n; public ctor make(int32 s){ this.n=s; } }
type resource Rc<T> implements Deref<T>, HeapOwner<T>, Copyable<This> {
    UnsafePtr<T> p; UnsafePtr<Ctrl> c;
    public ctor make(UnsafePtr<T> p, UnsafePtr<Ctrl> c) { this.p = p; this.c = c; }
    public unsafe ctor adopt(UnsafePtr<T> raw) { UnsafePtr<Ctrl> k = null; k = cast<UnsafePtr<Ctrl>>(malloc(n: sizeof(Ctrl))); k[0].strong = 1; k[0].weak = 0; return Rc.make(p: raw, c: k); }
    public unsafe fn ref T deref() { return this.p[0]; }
    public unsafe ctor copy(ref Rc<T> source) { source.c[0].strong = source.c[0].strong + 1; return Rc.make(p: source.p, c: source.c); }
    unsafe ~Rc() { this.c[0].strong = this.c[0].strong - 1; if (this.c[0].strong == 0) { drop(value: this.deref()); free(p: cast<UnsafePtr>(this.p)); if (this.c[0].weak == 0) { free(p: cast<UnsafePtr>(this.c)); } } }
}
fn int32 main() {
    Rc<Counter> a = new Counter.make(s: 5);
    Rc<Counter> b = a;   // (never reached: the type errors first)
    return b.n;
}
