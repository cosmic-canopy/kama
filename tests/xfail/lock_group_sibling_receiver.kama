// A lock reached through another binding of the same `borrow` (KR-226): the group makes every view before any place
// exists, so `x.held()` names nothing yet. Open a `borrow` inside this one for it.
import { std::concurrent::Locked };
type value Counter implements Sendable { public int32 n; public ctor zero() { this.n = 0; } }
type resource Outer implements Sendable {
    Locked<Counter> inner;
    public ctor make() { this.inner = Locked.make(value: Counter.zero()); }
    public fn ref Locked<Counter> held() { return this.inner; }
}
fn uint8 main() {
    Locked<Outer> o = Locked.make(value: Outer.make());
    borrow o.lock().value() as x, x.held().lock().value() as y { y.n = 1; }
    return 0;
}
