// A `foreach` binding is a typed value: the element type is MANDATORY in the grammar, two tokens away.
// This built clean and truncated 300 to 44 until the classifier learned to answer for one.
fn uint8 main() { InlineArray<int64>#(2) xs = [300i64; 2]; foreach (int64 x in xs) { int8 n = x; return cast<uint8>(n); } return 0; }
