// A primitive has no constructors of its own, so a name before `.` that no contract supplies is refused as that: the
// advice a declared type gets ("add `ctor make(...)`", `@generate(of)`) would be wrong for it. This MUST fail to
// compile.
import { std::fmt::ParseError };

fn uint8 main() {
    int32 a = int32.nope(x: 1);
    return 0;
}
