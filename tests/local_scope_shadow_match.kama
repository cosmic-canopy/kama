// A `match` payload binding may shadow an enclosing local of its name — including a move-tracked
// `resource` — and inside the arm the name is the payload, with the payload's type and no move state.
//
// The binding writes no `_localCTypes` entry, by design, so the outer `Res m`'s entry answered for the
// `int32` payload and `r = m` was refused: "an assignment expects a number, so it cannot be given a type
// value". The binder now hides the enclosing entries (type, const, slot, ref, move state) for the arm;
// the arm scope's snapshot restores them at its close, so `give m` after the match moves the resource.
import { std::memory::Owned };
type value Box { int32 v; public ctor make(int32 v) { this.v = v; } public fn int32 get() { return this.v; } }
type resource Res { Owned<Box> a; public ctor make(int32 v) { Owned<Box> b = new Box.make(v: v); this.a = give b; } public fn int32 head() { return this.a.get(); } }
fn int32 sink(Res r) { return r.head(); }
fn int32 main() {
    Res m = Res.make(v: 1);
    Optional<int32> o = Optional::Some(value: 3);
    int32 r = 0;
    match (o) { case Some(value: m): { r = m; } case None: { } };   // 3 — the payload
    r = r + sink(r: give m);                                          // + 1 — the resource, moved once
    return r;   // 4
}
