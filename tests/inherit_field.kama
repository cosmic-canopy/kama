// Base-field embedding: a derived class reaches inherited base data.
// M25b: fields are private (kind-decides), so the base exposes `x` to subclasses via a `protected`
// reader (`getX`).
// A derived factory installs the base part by calling the base's OWN constructor — so `x` is initialized
// by the type that owns it, and `Base` can enforce whatever invariant it likes on the way in. This used
// to be a `protected` SETTER called from the derived ctor, which was the workaround for the base ctor
// never running: it left `Base` unable to require that `x` was ever set at all.
type virtual(maxDepth: 1) resource Base
{
    int32 x;                                       // private; embedded in the derived layout
    public ctor make(int32 x) { this.x = x; }      // the base's own ctor — the only way its data is set
    protected fn int32 getX() { return this.x; }   // visible to subclasses, not to the world
    protected virtual fn int32 tag() { return 0; }
    public fn int32 sum() { return this.sumImpl(); }   // public surface is fixed at the ROOT (decision A)
    protected virtual fn int32 sumImpl() { return this.getX(); }
}
type final resource Derived extends Base
{
    int32 y;
    public ctor make(int32 x, int32 y)
    {
        this.base = Base.make(x: x);   // FIRST — the inherited part is built by its own ctor
        this.y = y;
    }
    protected override fn int32 tag() { return 1; }
    protected override fn int32 sumImpl() { return this.getX() + y; }   // base data via the protected accessor
}
fn int32 main()
{
    Derived d = Derived.make(x: 30, y: 12);
    return d.sum();
}
