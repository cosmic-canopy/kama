// Base-field embedding: a derived class reaches inherited base data.
// M25b: fields are private (kind-decides), so the base exposes `x` to subclasses via `protected`
// accessors — read (`getX`) and, for construction, write (`setX`).
// M8 Phase E: construction is a named factory (no `: base(...)` delegation — a factory builds a bare
// local, it has no `self` to chain a base ctor). A derived factory initializes the inherited base part
// through the base's `protected` setter, then sets its own fields; the bare local's `__vptr` is set by
// the vtable-typed bare-local store.
type virtual resource Base
{
    int x;                                       // private; embedded in the derived layout
    protected fn void setX(int x) { this.x = x; }   // subclasses initialize base data through this
    protected fn int getX() { return this.x; }   // visible to subclasses, not to the world
    protected virtual fn int tag() { return 0; }
    public fn int sum() { return this.sumImpl(); }   // public surface is fixed at the ROOT (decision A)
    protected virtual fn int sumImpl() { return this.getX(); }
}
type final resource Derived extends Base
{
    int y;
    public ctor make(int x, int y)
    {
        this.setX(x: x);      // initialize the inherited base field
        this.y = y;
    }
    protected override fn int tag() { return 1; }
    protected override fn int sumImpl() { return this.getX() + y; }   // base data via the protected accessor
}
fn int main()
{
    Derived d = Derived.make(x: 30, y: 12);
    return d.sum();
}
