// 6b-2 Stage B: a module-level `const static` is a named compile-time constant. It sizes a module
// static array AND a local const-generic array, feeds another `const static` (cross-const reference,
// baked as a literal so there is no C init-order dependency), and is readable at runtime.
const static int32 CAP  = 4;
const static int32 CAP2 = CAP + 1;                 // cross-const ref -> baked to 5

static InlineArray<int32, (CAP)> g_buf;            // module static array sized by the const (4 zeros)

fn int32 main() {
    InlineArray<int32, (CAP2)> local = [7; (CAP2)];    // 5 sevens
    int32 t = 0;
    foreach (int32 e in local) { t = t + e; }          // 35
    return t + cast<int32>(g_buf.length()) + CAP;      // 35 + 4 + 4 = 43
}
