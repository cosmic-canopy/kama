// M9 — pluggable hash finalizer. `Map<K,V>` uses `DefaultHasher` (splitmix64, the M8 default);
// `Map<K,V,FastHasher>` / `Set<K,FastHasher>` swap in a cheaper single-multiply mixer via the named
// type param. The finalizer changes only WHICH slot a key lands in, never lookup correctness, so both
// hashers must round-trip identically across grows. The two choices produce DISTINCT monomorphs
// (`Map_int32_int32_DefaultHasher` vs `Map_int32_int32_FastHasher`) — proof `H` is threaded + selected.
import std::collections::{Map, Set, FastHasher};

fn int32 main() {
    int32 r = 0;

    Map<int32, int32> strong = Map.empty();                 // DefaultHasher (filled by the default)
    Map<int32, int32, FastHasher> fast = Map.empty();        // explicit FastHasher override — a distinct monomorph
    int32 i = 0;
    while (i < 100) { strong.put(key: i, value: i * i); fast.put(key: i, value: i * i); i = i + 1; }  // forces grows
    strong.put(key: 7, value: 999); fast.put(key: 7, value: 999);   // overwrite in both

    if (strong.length() == 100 && fast.length() == 100) { r = r + 10; }

    // Every key resolves to the SAME value in both maps — the hasher affects slot placement, not results.
    int32 mism = 0;
    i = 0;
    while (i < 100) {
        Optional<int32> oa = strong.get(key: i);      // bind first — a method call isn't a valid match subject
        Optional<int32> ob = fast.get(key: i);
        int32 a = match (oa) { case Some(value: x): x; case None: 0 - 1; };
        int32 b = match (ob) { case Some(value: x): x; case None: 0 - 1; };
        if (a != b) { mism = mism + 1; }
        i = i + 1;
    }
    if (mism == 0) { r = r + 10; }

    Optional<int32> o7 = fast.get(key: 7);
    int32 v7 = match (o7) { case Some(value: x): x; case None: 0 - 1; };
    if (v7 == 999) { r = r + 5; }                     // overwrite took
    if (!fast.contains(key: 500)) { r = r + 5; }      // absent key

    // FastHasher over STRING keys (FNV content hash + fibonacci finish) round-trips too.
    Map<string, int32, FastHasher> byName = Map.empty();
    byName.put(key: "one", value: 1); byName.put(key: "two", value: 2); byName.put(key: "three", value: 3);
    Optional<int32> s1 = byName.get(key: "one");
    Optional<int32> s2 = byName.get(key: "two");
    Optional<int32> s3 = byName.get(key: "three");
    int32 v1 = match (s1) { case Some(value: x): x; case None: 0; };
    int32 v2 = match (s2) { case Some(value: x): x; case None: 0; };
    int32 v3 = match (s3) { case Some(value: x): x; case None: 0; };
    if (v1 + v2 + v3 == 6 && byName.length() == 3) { r = r + 10; }

    // Set threads H through its backing Map<K,Unit,H>.
    Set<int32, FastHasher> s = Set.empty();
    i = 0; while (i < 64) { s.add(key: i); s.add(key: i); i = i + 1; }   // duplicate adds are idempotent
    if (s.length() == 64 && s.contains(key: 7) && !s.contains(key: 64)) { r = r + 10; }

    return r;   // 10+10+5+5+10+10 = 50
}
