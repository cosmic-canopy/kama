import { std::collections::DynamicArray };
// `ref a[i]` borrows the element in place (bounds-checked) — the callee mutates the real element.
fn void addTo(ref int32 dst, int32 by) { dst = dst + by; }
fn int32 main() {
    InlineArray<int32, 3> a = [5, 6, 7];
    addTo(dst: ref a[1], by: 100);     // a[1] -> 106
    DynamicArray<int32> l = DynamicArray.empty();
    l.add(item: 9);
    addTo(dst: ref l[0], by: 20);      // l[0] -> 29
    return a[1] + l[0];                 // 106 + 29 = 135
}
