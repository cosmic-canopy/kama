import { std::collections::DynamicArray };
// DynamicArray<T> RAII + element-dtor chaining over the LIVE length (len=3, cap=4):
// the list's dtor must destroy exactly its 3 live elements, not its capacity.
//
// M26f-2: `add(item:)` takes the element BY VALUE, and a `resource` (destructible) value
// MOVES on a bare hand-off — so each source local (a,b,c) is moved INTO the list and its
// own dtor is suppressed (no double-drop). Only the 3 list elements destruct: ~[1,2,4] ->
// fold ((1*31+2)*31+4)=1027 -> exit 1027 & 0xFF = 3.
extern fn void kama_trace(int32 code);
extern fn int32 kama_trace_get();
unsafe fn int32 traceGet() { return kama_trace_get(); }   // the FFI call, contained — `main` may not be `unsafe`

type resource Probe
{
    int32 id;
    public ctor make(int32 id) { this.id = id; }
    unsafe ~Probe() { kama_trace(code: id); }
}

fn int32 build()
{
    DynamicArray<Probe> xs = DynamicArray.empty();
    Probe a = Probe.make(id: 1);
    Probe b = Probe.make(id: 2);
    Probe c = Probe.make(id: 4);
    xs.add(item: a);
    xs.add(item: b);
    xs.add(item: c);
    return 0;
    // scope exit: a,b,c were moved into xs (dtors suppressed); xs -> ~[1,2,4]
}

fn int32 main()
{
    int32 r = build();
    return traceGet();
}
