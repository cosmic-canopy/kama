// A InlineArray element may itself be a InlineArray (`InlineArray<InlineArray<int32,N>,M>` — the row/col shape a matrix
// needs) and a InlineArray can be a class FIELD held by value. Nested literals resolve each inner `[…]`
// to the element InlineArray; a row bound to a local is a plain value you can then index.
@generate(of)
type value Grid {
    public InlineArray<int32, 4> cells;
    public fn int32 at(int32 i) { return this.cells[i]; }
}
fn int32 main() {
    InlineArray<int32, 4> c = [3, 6, 9, 12];
    Grid g = Grid.of(cells: c);                         // InlineArray as a by-value field
    InlineArray<InlineArray<int32, 2>, 2> m = [[1, 2], [3, 4]];  // nested InlineArray
    InlineArray<int32, 2> row = m[1];                       // the inner row is a value copy
    return g.at(i: 2) + row[0] + row[1];              // 9 + 3 + 4 = 16
}
