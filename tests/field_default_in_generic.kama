// A field default is resolved in the scope of the type that declares it. The fill runs wherever a
// value of the type comes into being — here inside `DynamicArray<Item>`'s own body, which declares a local `T`
// — and `Kind kind = Kind::First;` was resolved against dynamic_array.kama's names: "`Kind` is not a type or
// module in reach here", pointing into std. The multi-module twin is tests/field_default_in_generic.d.
import { std::collections::DynamicArray };

type enum Kind { First, Second }

type resource Item {
    string name;
    Kind kind = Kind::First;
    public ctor make(string name, Kind kind) { this.name = give name; this.kind = kind; }
    public fn int32 rank() { return match (this.kind) { case First: 1; case Second: 2; }; }
}

fn int32 main() {
    DynamicArray<Item> list = DynamicArray.empty();
    list.add(item: Item.make(name: "a", kind: Kind::Second));
    list.add(item: Item.make(name: "b", kind: Kind::First));
    return list[0].rank() * 10 + list[1].rank();   // 21
}
