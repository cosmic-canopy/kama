// KBIN graph decodeJsonBuffer surfaces a DANGLING reference. We hand-drive a NamedBinarySerializer to craft a graph whose only
// entry (id 1, a Pair) references id 2 for both fields, but id 2 is never defined — so the two-pass wire can't
// resolve it and `decodeJsonBuffer` returns `DeError::UnresolvedReference` (the specific code, via failWith), not a crash
// or the generic Malformed. This is the binary analog of the JSON string-edit dangling test. Returns 0.
import {
    std::serialization::binary::encodeBinaryNamedBuffer,
    std::serialization::binary::decodeBinaryNamedBuffer,
    std::serialization::binary::NamedBinarySerializer,
    std::collections::DynamicArray,
    std::io::StringWriter,
    std::memory::Shared,
};

@generate(Serializable, Deserializable)
type resource Leaf { @field int32 v; public ctor make(int32 v) { this.v = v; } }

@generate(Serializable, Deserializable)
type resource Pair {
    @field Shared<Leaf> a;
    @field Shared<Leaf> b;
    public ctor make(Shared<Leaf> a, Shared<Leaf> b) { this.a = give a; this.b = give b; }
}

fn int32 main() {
    // Craft {root:1, objects:{ 1:{__type:Pair, a:ref(2), b:ref(2)} }} — id 2 (the Leaf) is MISSING.
    NamedBinarySerializer<StringWriter> w = NamedBinarySerializer::<StringWriter>.make(sink: StringWriter.make());
    w.beginGraph(rootId: cast<uint64>(1));
    w.beginTableEntry(id: cast<uint64>(1), ty: "Pair");
    w.field(name: "a", id: 0ui32); w.writeRef(id: cast<uint64>(2));
    w.field(name: "b", id: 1ui32); w.writeRef(id: cast<uint64>(2));
    w.endTableEntry();
    w.endGraph();
    DynamicArray<uint8> bytes = w.innerRefMut().takeBytes();

    Result<Shared<Pair>, Owned<Error>> res = decodeBinaryNamedBuffer::<Shared<Pair>>(src: give bytes);
    match (res) {
        case Ok(value: sh): { return 1; }                          // must NOT succeed
        case Err(error: e): {
            match (e.as<DeError>()) {
                case Some(value: ec): { match (ec) {
                    case UnresolvedReference: { return 0; }  // expected
                    case Malformed: { return 2; }
                    case UnexpectedEnd: { return 3; }
                    case TypeMismatch: { return 4; }
                    case MissingField: { return 5; }
                    case DuplicateId: { return 7; }
                }; }
                case None: { return 8; }
            };
        }
    };
    return 6;
}
