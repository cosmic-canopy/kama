// KBIN graph decode surfaces a DANGLING reference. We hand-drive a NamedBinarySerializer to craft a graph whose only
// entry (id 1, a Pair) references id 2 for both fields, but id 2 is never defined — so the two-pass wire can't
// resolve it and `deserializeJsonBuffer` returns `DeError::UnresolvedReference` (the specific code, via failWith), not a crash
// or the generic Malformed. This is the binary analog of the JSON string-edit dangling test. Returns 0.
import {
    std::serialization::binary::serializeBinaryNamedBuffer,
    std::serialization::binary::deserializeBinaryNamedBuffer,
    std::serialization::binary::NamedBinarySerializer,
    std::collections::DynamicArray,
    std::io::StringWriter,
    std::memory::Shared,
    std::serialization::graph::ObjectGraph,
};

@generate(Serializable, Deserializable)
type resource Leaf { @field int32 v; public ctor make(int32 v) { this.v = v; } }

@generate(Serializable, Deserializable)
type resource Pair {
    @field Shared<Leaf> a;
    @field Shared<Leaf> b;
    public ctor make(Shared<Leaf> a, Shared<Leaf> b) { this.a = give a; this.b = give b; }
}

fn int32 main() {
    // Craft {root:1, objects:[{id:1, type:Pair, value:{a:2, b:2}}]} through the ordinary token protocol —
    // the envelope IS ordinary tokens now — with id 2 (the Leaf) MISSING from the table.
    NamedBinarySerializer<StringWriter> w = NamedBinarySerializer::<StringWriter>.make(sink: StringWriter.make());
    w.beginObject(count: 2);
    w.field(name: "root", id: 0ui32); w.writeU64(v: cast<uint64>(1));
    w.field(name: "objects", id: 1ui32);
    w.beginArray(count: cast<usize>(1));
    w.beginObject(count: 3);
    w.field(name: "id", id: 0ui32); w.writeU64(v: cast<uint64>(1));
    w.field(name: "type", id: 1ui32); w.variant(name: "Pair", index: 0ui32);
    w.field(name: "value", id: 2ui32);
    w.beginObject(count: 2);
    w.field(name: "a", id: 0ui32); w.writeU64(v: cast<uint64>(2));
    w.field(name: "b", id: 1ui32); w.writeU64(v: cast<uint64>(2));
    w.endObject();
    w.endObject();
    w.endArray();
    w.endObject();
    DynamicArray<uint8> bytes = w.innerRefMut().takeBytes();

    Result<ObjectGraph<Pair>, Owned<Error>> res = deserializeBinaryNamedBuffer::<ObjectGraph<Pair>>(src: give bytes);
    match (res) {
        case Ok(value: sh): { return 1; }                          // must NOT succeed
        case Err(error: e): {
            match (e.as<DeError>()) {
                case Some(value: ec): { match (ec) {
                    case UnresolvedReference: { return 0; }  // expected
                    case Malformed: { return 2; }
                    case UnexpectedEnd: { return 3; }
                    case TypeMismatch: { return 4; }
                    case MissingField: { return 5; }
                    case DuplicateId: { return 7; }
                }; }
                case None: { return 8; }
            };
        }
    };
    return 6;
}
