import std::collections::{DynamicArray};
import std::memory::{Shared};
// M27 — a `DynamicArray<Shared<Shape>>` drops each stored smart pointer (ref-count decrement) at teardown
// and dispatches polymorphically through the borrowed element in `foreach`. Exercises the nested
// collection-element registration fixed in this slice: `elemClass`/`elemDestructible` now resolve
// because the inner `Shared_IShape` is registered before the outer `DynamicArray` (was outer-first -> the
// list silently leaked its elements). Each Sq is freed exactly once -> ASan-clean is the real proof.
// (Written with no space in `Shared<Shape>>` — the `>>` lexer split handles the nested close.)
type contract Shape for both { fn int32 area(); }
type resource Sq implements Shape {
    DynamicArray<int32> side;                                          // owns heap -> destructible impl
    public ctor make(int32 s) { Sq r; r.side.add(item: s); return give r; }
    public fn int32 area() { return this.side[0] * this.side[0]; }
}
fn int32 main() {
    DynamicArray<Shared<Shape>> xs = DynamicArray.empty();
    Shared<Shape> a = new Sq.make(s: 3);
    Shared<Shape> b = new Sq.make(s: 4);
    Shared<Shape> c = new Sq.make(s: 5);
    xs.add(item: give a);                                      // move each shared into the list
    xs.add(item: give b);
    xs.add(item: give c);
    int32 sum = 0;
    foreach (ref Shared<Shape> s in xs) { sum = sum + s.area(); } // borrow each handle; polymorphic dispatch
    return sum;                                                // 9 + 16 + 25 = 50; xs drops -> each Sq freed once
}
