// M31c — operators in a `contract` are a BOUND for generic math. `Summable` declares
// `T operator+(T rhs)`; a `sum<T: Summable<T>>` monomorphizes `a + b` to a STATIC
// `Vec2__op_add(&a, b)` — zero-cost, reusing M27's bound + `This` machinery. (The prelude's `Arithmetic`
// is the same shape over all four operators: tests/arith_bound.)
type contract Summable<T is This> for value { T operator+(T rhs); }

@generate(of)
type value Vec2 implements Summable<This> {
    public int32 x;
    public int32 y;
    public This operator+(This rhs) { return Vec2.of(x: this.x + rhs.x, y: this.y + rhs.y); }
}

fn T sum<T: Summable<T>>(T a, T b) { return a + b; }   // `a + b` via the bound → static dispatch

fn int32 main() {
    Vec2 p = Vec2.of(x: 10, y: 20);
    Vec2 q = Vec2.of(x: 3, y: 9);
    Vec2 r = sum(a: p, b: q);   // (13, 29)
    return r.x + r.y;           // 42
}
