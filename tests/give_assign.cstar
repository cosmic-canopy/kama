// M26d tail — give/copy markers in ASSIGNMENT position (uniform with init/arg/return).
// A bare reassignment uses the kind default (Owned=move, Shared=retain); an explicit
// `give` opts into moving a Shared handle instead of retaining.
type value C { int32 n; public C(int32 n){ this.n = n; } public fn int32 g(){ return this.n; } }
fn int32 main() {
    Owned<C> a = new C(n: 20);
    Owned<C> b = new C(n: 9);
    b = give a;                 // move a into b (b's old is freed); a consumed
    Shared<C> s = new C(n: 22);
    Shared<C> t = new C(n: 1);
    t = give s;                 // opt-in move of the share (default would retain)
    return b.g() + t.g();       // 20 + 22 = 42
}
