import { std::ptr::relocate };
// Session E (hardening) work item 1 — `give` a move-only `resource` into a bare `UnsafePtr<T>` LOCAL slot
// (`buf[0] = give w`), the same raw-slot move already allowed through a FIELD (`this.data[0] = give w`).
// Proves the store happens (read it back = 42) and the moved source is consumed (its scope dtor is
// skipped, so no double-drop — ASan-clean; a bare copy would leave `w` live and drop it twice).
// An `extern` is a reference to a C symbol, not a module symbol, so a file that names one declares it —
// inheriting the prelude's declaration is what the file rung closed.
extern "<stdlib.h>";
extern fn UnsafePtr malloc(usize n);
extern fn void free(UnsafePtr p);

type resource Widget {
    int32 id;
    public ctor make(int32 id) { this.id = id; }
    public fn int32 get() { return this.id; }
    ~Widget() { }
}

unsafe fn int32 run() {
    UnsafePtr<Widget> buf = null;
    buf = cast<UnsafePtr<Widget>>(malloc(n: cast<usize>(sizeof(Widget)) * cast<usize>(2)));
    Widget w = Widget.make(id: 42);
    buf[0] = give w;               // the bare-local raw-slot MOVE (consumes w)
    slot Widget got;                          // the hole `relocate`'s `out` parameter fills
    relocate(from: buf, at: 0, into: out got);   // untracked raw copy back out of the raw slot
    int32 r = got.get();                      // 42 — proves the give actually stored w's bytes
    free(p: cast<UnsafePtr>(buf));
    return r;                                 // 42
}

// The body above is the raw work, so IT carries the marker; `main` may not be `unsafe`
// (it encloses the whole program). Calling an `unsafe fn` from safe code is allowed.
fn int32 main() { return run(); }
