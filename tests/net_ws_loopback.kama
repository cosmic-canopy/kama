// std::net::web WebSocket E2E (wasm/node) — connect to the hand-rolled echo server (tests/support/ws_echo.js),
// send 4 bytes, receive the echo, verify, exit 55. Uses std::app's run loop so the browser/Node event loop
// runs between ticks and the async handshake + echo actually complete (a synchronous poll would never see
// them). Drives the JS glue on an int32 handle: a WsConnection resource's RAII close would fire on
// emscripten's main-loop stack unwind and kill the socket mid-test — the connection is owned JS-side here.
// (WsConnection's API is covered by net_ws_smoke.) The tick's persistent state is one raw heap block (handle
// + phase + scratch) threaded through the loop's UnsafePtr arg, since the loop is host-driven and kama has no
// globals. The socket is CLOSED before quit(): an open handle keeps Node's event loop alive so the process
// would never actually exit (a game likewise closes its sockets on quit).
import std::app::{run, TickFn, quit};
extern "<stdlib.h>";
extern fn UnsafePtr malloc(usize n);
extern "kama_net_web.h";
extern fn int32 kama_ws_connect(UnsafePtr<int8> url);
extern fn int32 kama_ws_state(int32 h);
extern fn int32 kama_ws_send(int32 h, UnsafePtr<uint8> buf, usize n);
extern fn int32 kama_ws_recv(int32 h, UnsafePtr<uint8> buf, usize n);
extern fn void  kama_ws_close(int32 h);

// Close the socket (drain Node's event loop) then exit with `code`.
unsafe fn void finish(int32 h, int32 code) { kama_ws_close(h: h); quit(code: code); }

// state block: int32 header [handle, phase, ticks] at bytes 0..11; byte scratch at offset 16 (send/recv).
unsafe fn int32 tick(UnsafePtr state) {
    UnsafePtr<int32> hdr = cast<UnsafePtr<int32>>(state);
    UnsafePtr<uint8> sc  = cast<UnsafePtr<uint8>>(state);
    int32 h = hdr[0];
    hdr[2] = hdr[2] + 1;
    if (hdr[2] > 2000000) { finish(h: h, code: 70); }    // timeout — never completed
    int32 st = kama_ws_state(h: h);
    if (st == 3) { finish(h: h, code: 71); }             // closed before we finished
    if (hdr[1] == 0) {
        if (st == 1) {                                   // Open -> send 4 bytes
            sc[16] = cast<uint8>(10); sc[17] = cast<uint8>(20);
            sc[18] = cast<uint8>(30); sc[19] = cast<uint8>(40);
            if (kama_ws_send(h: h, buf: addr(of: sc[16]), n: cast<usize>(4)) != 0) { finish(h: h, code: 72); }
            hdr[1] = 1;
        }
    } else {
        int32 n = kama_ws_recv(h: h, buf: addr(of: sc[16]), n: cast<usize>(64));
        if (n == 4) {
            bool ok = (cast<int32>(sc[16]) == 10) && (cast<int32>(sc[17]) == 20)
                   && (cast<int32>(sc[18]) == 30) && (cast<int32>(sc[19]) == 40);
            if (ok) { finish(h: h, code: 55); } else { finish(h: h, code: 73); }
        }
    }
    return 1;
}

unsafe fn int main() {
    UnsafePtr<uint8> block = cast<UnsafePtr<uint8>>(malloc(n: cast<usize>(128)));
    UnsafePtr<int32> hdr = cast<UnsafePtr<int32>>(cast<UnsafePtr>(block));
    string url = "ws://127.0.0.1:47670";
    int32 h = kama_ws_connect(url: url.cstr());
    if (h < 0) { quit(code: 60); }
    hdr[0] = h; hdr[1] = 0; hdr[2] = 0;
    TickFn t = tick;
    run(tick: t, state: cast<UnsafePtr>(block));
    return 1;
}
