// `char` and `uint32` hold DISTINCT conformances.
//
// The two share the C type `uint32_t`, and the conformance registry used to be keyed by that C type — so
// it could hold a `Format` for one of them or the other, never both. The prelude recorded `uint32`'s, and
// a `char` reaching any contract through a generic bound rendered as its numeric scalar. The registry is
// now keyed by the KAMA type (`primKey`), which is what lets both conformances exist at once.
//
// Every assertion here goes through a BOUND (`render` below is `<T: Format>`), because that is the path
// that was broken: a `${c}` interpolation hole always rendered correctly, via a compiler fast path that
// exists precisely to route around the collision. The point is that the two agree now — so this fixture
// must NOT use `${…}`, or it would only ever exercise the fast path.
//
// The known residual: a place whose kama type node was already erased — an element of a collection, an
// index into an array — recovers its key from the C type, and `uint32_t` answers `uint32`. That is why
// nothing here reaches a char through a container.

import std::serialization::binary::{encode};
import std::collections::{DynamicArray};

// A user contract over both types proves the mechanism independently of the prelude: one body per target,
// visibly different results, dispatched through a bound.
type contract Widthy for value, intrinsic { fn int32 width(); }

type intrinsic <char> implements Widthy {
    public fn int32 width() { return 100; }
}
type intrinsic <uint32> implements Widthy {
    public fn int32 width() { return 7; }
}

fn int32 widthOf<T: Widthy>(ref T v) { return v.width(); }

type value Marker {
    public char at;
    public ctor make(char at) { this.at = at; return this; }
}

// The Formatter build, behind a bound. The prelude carried this as `toString` until `"${x}"` made it
// redundant everywhere EXCEPT here, where the whole point is to avoid the interpolation fast path.
fn string render<T: Format>(ref T x) {
    Formatter f = Formatter.make();
    x.format(f: ref f);
    return f.finish();
}

fn int32 main() {
    int32 score = 0;

    // The prelude conformance, through `<T: Format>`. `char` renders its CHARACTER; `uint32` renders the
    // number. Before the re-key both produced "65".
    char c = 'A';
    uint32 u = 65ui32;
    string cs = render(x: ref c);
    string us = render(x: ref u);
    assert(cond: cs.equals(other: "A"), msg: "char formats as its character through a bound");
    assert(cond: us.equals(other: "65"), msg: "uint32 still formats as its number");
    if (cs.equals(other: "A")) { score = score + 40; }
    if (us.equals(other: "65")) { score = score + 40; }

    // The other two receiver shapes the dispatch path resolves a kama type node for: a foreach binding
    // over `.chars()`, and a field reached through an instance. Both need the turbofish — inference does
    // not see through either shape, for ANY type (it wants a literal or a locally-typed value), which is a
    // pre-existing limitation and nothing to do with `char`.
    string built = "";
    foreach (char ch in "hi".chars()) { built = built.concat(other: render::<char>(x: ref ch)); }
    assert(cond: built.equals(other: "hi"), msg: "a decoded codepoint formats as its character");
    if (built.equals(other: "hi")) { score = score + 40; }

    Marker m = Marker.make(at: 'Z');
    string ms = render::<char>(x: ref m.at);
    assert(cond: ms.equals(other: "Z"), msg: "a char field formats as its character");
    if (ms.equals(other: "Z")) { score = score + 40; }

    // The user contract: one type, two conformances, two answers.
    assert(cond: widthOf(v: ref c) == 100, msg: "char has its own Widthy");
    assert(cond: widthOf(v: ref u) == 7, msg: "uint32 has its own Widthy");
    if (widthOf(v: ref c) == 100 && widthOf(v: ref u) == 7) { score = score + 40; }

    // Serialize, on the WIRE. A round-trip alone proves nothing here — encode and decode would agree
    // whichever conformance they shared. What discriminates is the KBIN tag: `writeChar` emits 14,
    // `writeU32` emits 7, and before the re-key a `char` element rode the latter. This element reaches
    // `Serialize` through the collection's `<T: Serialize>` bound inside a monomorph, where the recorded
    // type node is still the unsubstituted `T` — the case that needs `primKey`'s substitution hop.
    DynamicArray<char> arr = DynamicArray.empty();
    arr.add(item: 'k');
    Result<DynamicArray<uint8>, Owned<Error>> enc = encode(v: arr);
    DynamicArray<uint8> wire = match (give enc) { case Ok(value: w): give w; case Err(error: __e): { return 1; } };
    uint8 tag = wire[1];                      // [0] is beginArray (18), [1] is the element's tag
    assert(cond: tag == 14ui8, msg: "a char element serializes as a char, not as a uint32");
    if (tag == 14ui8) { score = score + 40; }

    return score;
}
