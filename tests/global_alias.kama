// `global::` names the ROOT scope explicitly (docs/SPEC.md § Modules; C# precedent): `global::X` is the
// same symbol as bare `X` — the always-in-scope floor. The point is that it still resolves where a LOCAL
// declaration shadows the spelling, which is what this file sets up: its own `envOr` hides the floor's
// for bare lookups.
//
// It had a SECOND form, `global::a::b::X`, naming a namespace absolutely. That form is gone with the
// `namespace` declaration (SPEC.md § Modules): `global` is a project name now, so
// `global::a::b::X` would have to mean module `a/b` OF a project called `global`. The job it did — reach
// a name past an `as` alias that shadows it — is done at the source instead, by refusing such an alias.

fn string envOr(string name, string dflt) { return "shadowed"; }

fn int32 pick(int32 a, int32 b) { return a + b; }

fn int32 main() {
    // Bare `envOr` finds this file's own — the file's scope wins over the floor.
    string mine = envOr(name: "KAMA_NOT_SET", dflt: "1");
    // `global::` skips the file's scope entirely and reaches the floor's `envOr`.
    string floor = global::envOr(name: "KAMA_NOT_SET", dflt: "7");
    // The file's own declaration, which needs no prefix to reach: this file is its own scope.
    int32 sum = pick(a: 20, b: 15);
    int32 r = sum;                                    // 35
    if (mine == "shadowed") { r = r + 4; }            // 39
    if (floor == "7") { r = r + 3; }                  // 42
    return r;
}
