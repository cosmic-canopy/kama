// Tagged strings — `html"…"`: hole values are HTML-escaped, literal template parts are NOT (XSS-safe by
// construction — only interpolated, untrusted values are escaped). Exit code is a bitset of the checks (7 = all).
import std::fmt::{html};

fn int32 main() {
    string name = "Alice";
    string bad = "<&'\">";               // the five HTML metacharacters, as an untrusted value
    int32 r = 0;

    string a = html"<b>${name}</b>";
    if (a == "<b>Alice</b>") { r = r + 1; }                             // 1: literal <b> kept raw, plain hole

    string b = html"${bad}";
    if (b == "&lt;&amp;&#39;&quot;&gt;") { r = r + 2; }                 // 2: every special in a hole escaped

    string c = html"x${name}y${bad}z";
    if (c == "xAlicey&lt;&amp;&#39;&quot;&gt;z") { r = r + 4; }         // 3: interleave — only holes escaped

    return r;
}
