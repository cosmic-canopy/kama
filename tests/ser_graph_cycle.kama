// Object-graph round-trip with a cycle: node 1 owns node 2 (Shared forward edge), node 2 holds a Weak
// back-edge to node 1. Serialize terminates (the parent is already interned, so the back-edge writes its id)
// and is leak-free (the Weak breaks the ownership cycle). Deserialize rebuilds both edges — the forward
// `Shared` and the `Weak` back-edge (re-`downgrade`d onto the reconstructed owner) — proven by a re-encode
// that reproduces the exact wire; ASan proves the rebuilt cycle is still leak-free. A never-null Shared can't
// bootstrap a cycle, so the edges are nullable (Optional); `0` = absent/expired.
import std::serialization::json::{encode, decode};
import std::memory::{Shared, Weak};

@generate(Serialize, Deserialize)
type resource Node {
    @field int32 id;
    @field Optional<Shared<Node>> next;   // owns (forward edge)
    @field Optional<Weak<Node>> back;     // weak (back edge), wired after construction
    public ctor make(int32 id) { this.id = id; this.next = Optional::None; this.back = Optional::None; }
    public fn void setNext(Shared<Node> n) { this.next = Optional::Some(value: give n); }
    public fn void setBack(Weak<Node> w) { this.back = Optional::Some(value: give w); }
}

fn int32 main() {
    Shared<Node> a = new Node.make(id: 1);
    Shared<Node> b = new Node.make(id: 2);
    b.setBack(w: a.downgrade());          // b -> a (weak)
    a.setNext(n: give b);                 // a -> b (owns); a is the root
    Result<string, Owned<Error>> j_r = encode(v: a);
    string j = match (give j_r) { case Ok(value: __ok): give __ok; case Err(error: __e): { return 250; } };
    // root a = id 1 (next -> 2, no back); b = id 2 (no next, back -> 1). 0 = absent/expired.
    if (j != "{\"root\":1,\"objects\":{\"1\":{\"__type\":\"Node\",\"id\":1,\"next\":2,\"back\":0},\"2\":{\"__type\":\"Node\",\"id\":2,\"next\":0,\"back\":1}}}") {
        return cast<int32>(j.length());
    }
    Result<Shared<Node>, Owned<Error>> res = decode::<Shared<Node>>(src: copy j);
    match (res) {
        case Ok(value: sh): { Result<string, Owned<Error>> j2_r = encode(v: sh); string j2 = match (give j2_r) { case Ok(value: __ok): give __ok; case Err(error: __e): { return 1; } }; if (j2 == j) { return 0; } return 1; }
        case Err(error: e): { return 2; }
    };
    return 3;
}
