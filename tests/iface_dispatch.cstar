type contract Shape for both{
    fn int64 area();
}
type value Circle implements Shape
{
    int64 r;
    public Circle(int64 r) { this.r = r; }
    public fn int64 area() { return r * r; }
}
type value Square implements Shape
{
    int64 s;
    public Square(int64 s) { this.s = s; }
    public fn int64 area() { return s * s; }
}
fn int64 measure(Shape sh)
{
    return sh.area();
}
fn int main()
{
    Circle c = Circle(r: 7);
    Square q = Square(s: 5);
    int64 a = measure(sh: c);
    int64 b = measure(sh: q);
    uint64 sum = cast<uint64>(a) + cast<uint64>(b);
    uint64 m = sum % 256;
    return cast<int>(m);
}
