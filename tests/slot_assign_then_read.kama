// A slot is readable once an `out` argument has filled it. The CALLEE may fill through any control flow
// it likes — both arms of an if/else here — because `verifyOutsAssigned` proves the parameter assigned at
// every return. The DECLARATION's rule is the stricter one: the fill must sit on the slot's own
// unconditional path, so a reader never has to ask whether the storage holds a value.
fn void pick(bool hi, out int32 v) {
    if (hi) { v = 30; } else { v = 12; }   // both arms assign -> definite at the join
}
fn void five(out int32 v) { v = 5; }
fn int main() {
    slot int32 a;   five(v: out a);
    slot int32 hi;  pick(hi: true,  v: out hi);
    slot int32 lo;  pick(hi: false, v: out lo);
    return a + hi + lo;   // 5 + 30 + 12
}
