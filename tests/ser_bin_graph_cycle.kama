// KBIN object-graph round-trip with a cycle: node 1 owns node 2 (Shared forward edge), node 2 holds a Weak
// back-edge to node 1. Serialize terminates + is leak-free (Weak breaks the ownership cycle); decode rebuilds
// both edges — proven by a byte-identical re-encode; ASan proves the rebuilt cycle stays leak-free. Nullable
// edges (Optional); 0 = absent/expired. Returns 55.
import {
    std::serialization::binary::encode,
    std::serialization::binary::decode,
    std::collections::DynamicArray,
    std::memory::Shared,
    std::memory::Weak,
};

@generate(Serialize, Deserialize)
type resource Node {
    @field int32 id;
    @field Optional<Shared<Node>> next;   // owns (forward edge)
    @field Optional<Weak<Node>> back;     // weak (back edge), wired after construction
    public ctor make(int32 id) { this.id = id; this.next = Optional::None; this.back = Optional::None; }
    public fn void setNext(Shared<Node> n) { this.next = Optional::Some(value: give n); }
    public fn void setBack(Weak<Node> w) { this.back = Optional::Some(value: give w); }
}

fn DynamicArray<uint8> clone(ref DynamicArray<uint8> src) {
    DynamicArray<uint8> c = DynamicArray.empty();
    isize i = 0; isize n = src.length();
    while (i < n) { c.add(item: src[i]); i = i + 1; }
    return give c;
}
fn bool bytesEqual(ref DynamicArray<uint8> a, ref DynamicArray<uint8> b) {
    if (a.length() != b.length()) { return false; }
    isize i = 0; isize n = a.length();
    while (i < n) { if (a[i] != b[i]) { return false; } i = i + 1; }
    return true;
}

fn int32 main() {
    Shared<Node> a = new Node.make(id: 1);
    Shared<Node> b = new Node.make(id: 2);
    b.setBack(w: a.downgrade());          // b -> a (weak)
    a.setNext(n: give b);                 // a -> b (owns); a is the root
    Result<DynamicArray<uint8>, Owned<Error>> e1 = encode(v: a);
    DynamicArray<uint8> b1 = match (give e1) { case Ok(value: x): give x; case Err(error: __e): { return 250; } };

    Result<Shared<Node>, Owned<Error>> res = decode::<Shared<Node>>(src: clone(src: ref b1));
    match (res) {
        case Ok(value: sh): {
            Result<DynamicArray<uint8>, Owned<Error>> e2 = encode(v: sh);
            DynamicArray<uint8> b2 = match (give e2) { case Ok(value: x): give x; case Err(error: __e): { return 1; } };
            return bytesEqual(a: ref b1, b: ref b2) ? 55 : 40;
        }
        case Err(error: e): { return 2; }
    };
    return 3;
}
