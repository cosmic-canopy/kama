// An imported `comptime InlineArray` is the same table as in the file that declares it: indexed in safe code,
// iterated, and `.view()`ed. It was typed only in its own file, because the lookups that type a module-level
// name resolved it as THIS file's own (peer KPG-24): indexing fell to the raw-pointer path ("requires an
// `unsafe fn`", then clang), `.view()` had no receiver, and a `foreach` lost the table's `const`.
import { std::collections::ConstView, RANGES, tables::gen::WEIGHTS };

fn uint32 last() { return RANGES[3]; }
fn isize count() { return RANGES.view().length(); }
fn uint32 sum() { uint32 s = 0ui32; foreach (uint32 x in RANGES) { s = s + x; } return s; }
fn int32 weight() { int32 s = 0; foreach (int32 w in WEIGHTS) { s = s + w; } return s + WEIGHTS[1] + cast<int32>(WEIGHTS.view().length()); }

fn int32 main() {
    if (last() != 0x200Bui32) { return 1; }
    if (count() != 4) { return 2; }
    if (sum() != 160ui32 + 160ui32 + 8192ui32 + 8203ui32) { return 3; }
    if (weight() != 23 + 7 + 3) { return 4; }
    return 0;
}
