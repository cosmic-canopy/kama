// A JSON number that does not FIT the field it is read into must fail the DOCUMENT, not the process.
// `{"n":300}` into an `int8` field is bad input, and input is untrusted by definition — so `readI8` uses
// `try cast` and records `TypeMismatch`, where a plain `cast` would now trap and take a server down with
// a malformed request. Nothing in the corpus covered this, which is how it stayed invisible.
//
// Both directions are checked, because "rejects everything" would also pass the second half alone.
import { std::serialization::json::encode, std::serialization::json::decode };

@generate(Serializable, Deserializable)
type value Small {
    @field int8 n;
    public ctor make(int8 n) { this.n = n; }
    public const fn int8 get() { return this.n; }
}

fn int32 main() {
    // In range — including a NEGATIVE, whose sign bit is the half a width-only rule would miss.
    Result<string, Owned<Error>> e = encode(v: Small.make(n: 0i8 - 56i8));
    string js = match (give e) { case Ok(value: s): give s; case Err(error: _x): { return 250; } };
    Result<Small, Owned<Error>> d = decode::<Small>(src: give js);
    int32 ok = match (d) { case Ok(value: v): (v.get() == 0i8 - 56i8 ? 1 : 0); case Err(error: _y): 0; };

    // Out of range — an error, and the program is still alive to report it.
    string tooBig = "{\"n\":300}";
    Result<Small, Owned<Error>> bad = decode::<Small>(src: copy tooBig);
    int32 rejected = match (bad) { case Ok(value: _v2): 0; case Err(error: _z): 1; };

    if (ok == 1 && rejected == 1) { return 42; }
    return 1;
}
