// The kama face of the package's C++. The consumer never mentions `shim.cpp` — the package's manifest
// does, and the consumer's build compiles it with the package's `cxxflags`.
export { sumTo };

extern "shim.h";
extern fn int32 kama_test_cxxshim_sum(int32 n);

unsafe fn int32 sumTo(int32 n) { return kama_test_cxxshim_sum(n: n); }
