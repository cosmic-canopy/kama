// `TarReader` (KR-5): what `tarfile` in python3 reads, read the same. Archives python3 wrote as ustar, GNU and pax, and blocks built by hand
// for what it cannot write: v7, an unknown type flag, a symlink declaring a size, a global record, an empty value, a 2 MiB record of an
// unknown key. Each is listed against python3's own reading of it, every field of every entry and each body's CRC-32, reading 1, 7
// and 4,096 bytes at a time, each through a `GzipReader`, as a `.tar.gz` is read. Then: a body left unread is skipped by `next`; a source
// that stalls before every byte reads the same, stopping inside every header and body and resuming there; a read of nothing is not
// the end; `finish` before `next` has found the end answers `InvalidInput` and the reader reads on, and it hands the source back
// exactly after the end; and `abandon` hands it back wherever it stands. Returns 42.
import { std::archive::tar::TarReader, std::archive::tar::TarHeader, std::archive::tar::TarEndMarker, std::compress::gzip::GzipReader,
         std::compress::gzip::GzipMembers, std::io::BufReader, std::io::SliceReader, std::io::Reader, std::io::IoError, std::io::IoErrorKind,
         std::collections::DynamicArray, std::collections::FixedArray, std::collections::View, std::encoding::hex::decode,
         std::encoding::hex::encode, std::digest::crc32::Crc32, std::time::Timestamp };

fn DynamicArray<uint8> bytesOf(const ref string text) {
    return match (decode(text: text)) { case Ok(value: b): give b; case Err(error: e): DynamicArray.empty(); };
}

fn string hexOf(const ref DynamicArray<uint8> b) { return encode(bytes: b.view()); }

fn string kindText(const ref TarHeader h) {
    return match (h.kind()) {
        case File(size: s): "file:${s}";
        case Directory: "dir";
        case Symlink(target: t): { string x = hexOf(b: t); := "sym:${x}"; }
        case HardLink(target: t): { string x = hexOf(b: t); := "hard:${x}"; }
        case CharDevice(major: a, minor: b): "chr:${a}:${b}";
        case BlockDevice(major: a, minor: b): "blk:${a}:${b}";
        case Fifo: "fifo";
        case Other(flag: f, size: s): "other:${f}:${s}";
        case _: "unknown";
    };
}

fn string ownerText(const ref TarHeader h) {
    return match (h.owner()) {
        case None: "none";
        case Named(uid: u, gid: g, uname: un, gname: gn): { string a = hexOf(b: un); string b = hexOf(b: gn); := "${u},${g},${a},${b}"; }
    };
}

fn string timeText(const ref TarHeader h) {
    Optional<Timestamp> t = h.mtime();
    return match (t) {
        case Some(value: x): { int64 n = x.asUnixNanos(); := "${n}"; }
        case None: "none";
    };
}

// Lists an archive, every field, reading each body `chunk` bytes at a time. "" on any error.
fn string list(ref TarReader<GzipReader<SliceReader>> t, isize chunk) {
    string text = "";
    FixedArray<uint8> buf = FixedArray.make(size: chunk);
    while (true) {
        Optional<TarHeader> next = match (t.next()) { case Ok(value: o): give o; case Err(error: e): { return ""; } };
        bool done = false;
        match (give next) {
            case None: { done = true; }
            case Some(value: h): {
                Crc32 c = Crc32.make();
                isize len = 0;
                while (true) {
                    isize n = match (t.read(into: buf.viewMut())) { case Ok(value: k): k; case Err(error: e): -1; };
                    if (n < 0) { return ""; }
                    if (n == 0) { break; }
                    c.update(bytes: buf.view().slice(from: 0, count: n));
                    len = len + n;
                }
                string p = hexOf(b: h.path());
                string k = kindText(h: h);
                uint32 m = h.mode();
                string w = timeText(h: h);
                string o = ownerText(h: h);
                uint32 s = c.finish();
                text = text + "${p}|${k}|${m}|${w}|${o}|${len}|${s}\n";
            }
        };
        if (done) { return text; }
    }
}

fn TarReader<GzipReader<SliceReader>> over(const ref string gz, TarEndMarker end) {
    GzipReader<SliceReader> g = GzipReader.make(source: BufReader.make(inner: SliceReader.fromBytes(bytes: bytesOf(text: gz))),
                                                limit: 100000000ui64, members: GzipMembers::All);
    return TarReader.make(source: give g, endMarker: end);
}

fn int32 check(const ref string gz, const ref string want) {
    TarReader<GzipReader<SliceReader>> a = over(gz: gz, end: TarEndMarker::Required);
    TarReader<GzipReader<SliceReader>> b = over(gz: gz, end: TarEndMarker::NotRequired);
    TarReader<GzipReader<SliceReader>> c = over(gz: gz, end: TarEndMarker::Required);
    if (list(t: ref a, chunk: 1) != want) { return 1; }
    if (list(t: ref b, chunk: 7) != want) { return 2; }
    if (list(t: ref c, chunk: 4096) != want) { return 3; }
    return 0;
}

// What the fixture's raw streams are stored as, since a tar is mostly zeros.
fn DynamicArray<uint8> ungzip(const ref string gz) {
    GzipReader<SliceReader> g = GzipReader.make(source: BufReader.make(inner: SliceReader.fromBytes(bytes: bytesOf(text: gz))),
                                                limit: 100000000ui64, members: GzipMembers::All);
    DynamicArray<uint8> got = DynamicArray.empty();
    FixedArray<uint8> buf = FixedArray.make(size: 4096);
    while (true) {
        isize n = match (g.read(into: buf.viewMut())) { case Ok(value: k): k; case Err(error: e): -1; };
        if (n <= 0) { break; }
        for (isize i = 0; i < n; i = i + 1) { got.add(item: buf[i]); }
    }
    return got;
}

// A source that gives one byte per read and answers `WouldBlock` before each one.
type resource Choppy implements Reader {
    DynamicArray<uint8> bytes;
    isize pos;
    bool ready;

    public ctor make(DynamicArray<uint8> bytes) { this.bytes = give bytes; this.pos = 0; this.ready = false; }

    public fn Result<isize, IoError> read(View<uint8> into) {
        if (!this.ready) {
            this.ready = true;
            return Result::Err(error: IoError.of(kind: IoErrorKind::WouldBlock));
        }
        this.ready = false;
        if (this.pos >= this.bytes.length() || into.length() == 0) { return Result::Ok(value: 0); }
        into[0] = this.bytes[this.pos];
        this.pos = this.pos + 1;
        return Result::Ok(value: 1);
    }
}

fn int32 stalled(const ref string hex, const ref string wantPath) {
    TarReader<Choppy> t = TarReader.make(source: Choppy.make(bytes: ungzip(gz: hex)), endMarker: TarEndMarker::Required);
    FixedArray<uint8> buf = FixedArray.make(size: 3);
    string paths = "";
    int32 stalls = 0;
    bool done = false;
    while (!done) {
        Optional<TarHeader> next = Optional::None;
        bool have = false;
        while (!have) {
            match (t.next()) {
                case Ok(value: o): { next = give o; have = true; }
                case Err(error: e): {
                    bool blocked = match (e.kind()) { case WouldBlock: true; case _: false; };
                    if (!blocked) { return 1; }
                    stalls = stalls + 1;
                }
            };
        }
        match (give next) {
            case None: { done = true; }
            case Some(value: h): {
                string p = hexOf(b: h.path());
                paths = paths + p + ",";
                while (true) {
                    isize n = match (t.read(into: buf.viewMut())) {
                        case Ok(value: k): k;
                        case Err(error: e): match (e.kind()) { case WouldBlock: -2; case _: -1; };
                    };
                    if (n == -1) { return 2; }
                    if (n == 0) { break; }
                }
            }
        };
    }
    if (paths != wantPath) { return 3; }
    if (stalls < 1024) { return 4; }   // well over two blocks of headers, each byte of which stalled
    return match (give t.finish()) { case Ok(value: s): 0; case Err(error: u): 5; };
}

fn int32 kindOfError(IoError e) { return match (e.kind()) { case InvalidInput: 1; case _: 9; }; }

fn int32 readOn(TarReader<SliceReader> t, int32 kind) {
    TarReader<SliceReader> mine = give t;
    if (kind != 1) { return 1; }
    Optional<TarHeader> first = match (mine.next()) { case Ok(value: o): give o; case Err(error: e): { return 2; } };
    bool some = match (first) { case Some(value: h): true; case None: false; };
    if (!some) { return 3; }
    // Its body is left unread, and `next` skips it to find the end.
    Optional<TarHeader> second = match (mine.next()) { case Ok(value: o): give o; case Err(error: e): { return 4; } };
    bool none = match (second) { case Some(value: h): false; case None: true; };
    if (!none) { return 5; }
    SliceReader rest = match (give mine.finish()) { case Ok(value: s): give s; case Err(error: u): { return 6; } };
    FixedArray<uint8> t4 = FixedArray.make(size: 16);
    isize k = match (rest.read(into: t4.viewMut())) { case Ok(value: m): m; case Err(error: e): -1; };
    return (k == 4 && t4[0] == 84ui8 && t4[3] == 76ui8) ? 0 : 7;      // "TAIL"
}

