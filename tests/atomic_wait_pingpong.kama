// `Atomic.wait` and `notifyOne` between two threads (KR-3 step 2): 20,000 hand-offs over two cells, each side waiting
// for the other. A wake lost anywhere — a waiter that counts itself in after the notifier looked, a notify that reads a
// stale count — hangs this fixture rather than fail it, which the harness reports as a timeout.
import { std::concurrent::Atomic };

fn void ponger(ref Atomic<uint32> ping, ref Atomic<uint32> pong, uint32 rounds) {
    uint32 i = 0;
    while (i < rounds) {
        uint32 seen = ping.wait(whileEquals: i);
        if (seen != i + 1) { return; }      // a value it was not sent: pong never answers, and main's check fails
        pong.store(value: i + 1);
        pong.notifyOne();
        i = i + 1;
    }
}

fn uint8 main() {
    uint32 rounds = 20000;
    Atomic<uint32> ping = Atomic.make(value: 0);
    Atomic<uint32> pong = Atomic.make(value: 0);
    uint32 last = 0;
    scope {
        spawn ponger(ping: ref ping, pong: ref pong, rounds: rounds);
        uint32 i = 0;
        while (i < rounds) {
            ping.store(value: i + 1);
            ping.notifyOne();
            last = pong.wait(whileEquals: i);
            if (last != i + 1) { i = rounds; } else { i = i + 1; }
        }
    }
    if (last != rounds) { return 1; }
    return 42;
}
