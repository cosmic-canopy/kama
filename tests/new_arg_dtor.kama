// B4 ASan gate — a DESTRUCTIBLE resource boxed via inline `new` in a call-arg, consumed by value: the
// callee owns it and its param-drop frees the heap buffer. LeakSanitizer/ASan-clean == exactly one free
// (the box was moved into the callee, not also dropped by the caller).
import { std::memory::Owned };
extern "<stdlib.h>";
extern fn UnsafePtr malloc(usize n);
extern fn void free(UnsafePtr p);

type resource Cell {
    UnsafePtr<int32> buf;
    public unsafe ctor make(int32 v) { this.buf = cast<UnsafePtr<int32>>(malloc(n: sizeof(int32))); this.buf[0] = v; }
    public unsafe fn int32 get() { return this.buf[0]; }
    unsafe ~Cell() { free(p: cast<UnsafePtr>(this.buf)); }
}
fn int32 sink(Owned<Cell> c) { return c.get(); }   // c drops at fn-end -> Cell ~dtor frees buf
fn int32 main() { return sink(c: new Cell.make(v: 36)); }
