// M8: default TYPE parameters. A trailing type param may carry `= DefaultType`, filled automatically when
// the use site omits it — so `Wrap<bool>` means `Wrap<bool, int32>`. Proves default-fill, positional
// override of the default, and monomorphization dedup (the omitted and explicit spellings are ONE instance).
type value Wrap<T, U = int32> {
    public T first;
    public U second;
    public ctor make(T a, U b) { this.first = a; this.second = b; }
}

fn int32 main() {
    int32 r = 0;

    // U omitted -> fills from its default (int32).
    Wrap<bool> a = Wrap.make(a: true, b: 7);
    if (a.first && a.second == 7) { r = r + 10; }

    // Spelling the default explicitly resolves to the SAME monomorph as `Wrap<bool>` (dedup): if the two
    // minted separate C structs this translation unit would still compile, but the point is one instance —
    // and both coexisting cleanly is the observable proof there is no duplicate-emission clash.
    Wrap<bool, int32> b = Wrap.make(a: false, b: 42);
    if (!b.first && b.second == 42) { r = r + 10; }

    // Override the default positionally (U = float64).
    Wrap<bool, float64> c = Wrap.make(a: true, b: 3.5);
    if (c.first && c.second > 3.0 && c.second < 4.0) { r = r + 10; }

    return r;   // 30
}
