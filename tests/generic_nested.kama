// M27b-beta: a NESTED generic argument — `Box<Pair<int32,int32>>` — proves the recursive mangler
// (the inner `Pair<int32,int32>` is mangled INTO the name, not dropped, so no collision). Written
// with NO space before the final `>` (the `>>` lexer split lands with this fixture).
type value Pair<A, B>
{
    public A a;
    public B b;
    public ctor make(A x, B y) { slot Pair<A, B> r; r.a = x; r.b = y; return give r; }
    public fn A first() { return this.a; }
}
type value Box<T>
{
    public T value;
    public ctor make(T v) { slot Box<T> r; r.value = v; return give r; }
    public fn T unbox() { return this.value; }
}
fn int main()
{
    Pair<int32, int32> p = Pair.make(x: 3, y: 4);
    Box<Pair<int32, int32>> b = Box.make(v: p);    // nested arg, no space — `>>` splits into two closes
    Pair<int32, int32> q = b.unbox();
    return q.first() + 5;                      // 3 + 5 = 8
}
