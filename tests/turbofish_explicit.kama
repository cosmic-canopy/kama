// When a type parameter can't be inferred from the arguments (it appears only in the body/return),
// pass it explicitly with turbofish `f::<T>()`. Here T is used only in `sizeof(T)`.
fn int32 byteSize<T>() { return cast<int32>(sizeof(T)); }

fn uint8 main() {
    return cast<uint8>(byteSize::<int32>() + byteSize::<uint8>() * 38);   // 4 + 1*38 = 42
}
