// Cross-platform child helper for the std::process `proc_*` fixtures. The M1 fixtures drove POSIX-only
// utilities (sh/echo/cat/printenv/pwd/sleep/true/false); those don't exist on Windows, so the Windows CI leg
// couldn't run them. This one binary — built once by run_tests.sh and located by the fixtures via the
// KAMA_PROCUTIL env var — provides deterministic subcommands that behave identically on POSIX and Windows,
// dogfooding the kama floor (args()/env()/print) + std::fs. NOT swept as a fixture (lives under tests/support,
// no .expect). Subcommands:
//   echo <text...>   print the args (space-joined) + newline to stdout; exit 0
//   echo2 <o> <e>    print "<o>\n" to stdout AND "<e>\n" to stderr; exit 0   (dual-stream capture)
//   exit <n>         exit with code n
//   cat              copy stdin -> stdout until EOF; exit 0
//   sleep <ms>       sleep ms milliseconds; exit 0
//   printenv <k>     if env k is set: print its value + newline, exit 0; else exit 1
//   spew <n>         emit n lines of 19 'A'+newline to stdout AND 19 'B'+newline to stderr (20 bytes each)
//   hasfile <name>   exit 0 if a file <name> can be opened (relative to cwd), else 1   (proves cwd())
//   tick <ms> <n>    n times: sleep ms, then print "tick"; exit 0   (a quiet child, for a reader that must park)
//   drain <ms>       sleep ms, then read stdin to EOF and print the byte count; exit 0   (a writer that must park)
//   fiberin          read stdin to EOF ON A FIBER while another fiber ticks every 5 ms; print "<bytes> ticked" if the
//                    ticker ran 3+ times while the reader waited, else "<bytes> still"; exit 0   (KR-7: stdin parks)
import { core::env, core::args, core::eprintln, core::println, std::fs::File, std::fs::OpenMode, std::io::IoError, std::io::pump, std::io::stdin, std::io::stdout,
         std::io::StdIn, std::collections::DynamicArray, std::collections::FixedArray, std::concurrent::Fiber,
         std::time::sleep, std::time::Duration };

extern "kama_os.h";
extern fn void kama_sleep_ms(int32 ms);

// The i-th user arg (0-based; argv[0] excluded by the floor), or "" if absent.
fn string argAt(int32 i) {
    Optional<string> o = args().get(at: i);
    return match (give o) { case Some(value: v): { := give v; } case None: { := ""; } };
}

// `fiberin`'s two fibers: the reader counts stdin's bytes to EOF, the ticker counts its naps until it is done.
static bool readerDone = false;
static int32 ticks = 0;
static int64 stdinBytes = 0;
unsafe fn void countStdin(isize bufSize) {   // a fiber entry takes one argument, the bundle
    StdIn input = stdin();
    FixedArray<uint8> buf = FixedArray.make(size: bufSize);
    bool more = true;
    while (more) {
        isize n = match (input.read(into: buf.viewMut())) { case Ok(value: k): k; case Err(error: e): -1; };
        if (n <= 0) { more = false; } else { stdinBytes = stdinBytes + cast<int64>(n); }
    }
    readerDone = true;
}
fn void ticker(int64 ms) { while (!readerDone) { sleep(d: Duration.fromMillis(ms: ms)); ticks = ticks + 1; } }

// Parse a non-negative decimal string (the numeric subcommand args are always well-formed digits here).
unsafe fn int32 parseIntArg(string s) {
    isize n = s.length();
    UnsafeConstPtr<uint8> p = cast<UnsafeConstPtr<uint8>>(s.cstr());   // the bytes of a C string: `cchar` is opaque, `uint8` is what a byte reads as
    int32 v = 0;
    isize i = 0;
    while (i < n) {
        uint8 c = 0;
        c = p[i];
        v = v * 10 + (cast<int32>(c) - 48);
        i = i + 1;
    }
    return v;
}

unsafe fn int32 run() {
    string cmd = argAt(i: 0);

    if (cmd == "echo") {
        int32 c = args().count();
        string line = "";
        int32 i = 1;
        while (i < c) {
            if (i > 1) { line = line + " "; }
            line = line + argAt(i: i);
            i = i + 1;
        }
        println(s: give line);
        return 0;
    }
    if (cmd == "echo2") {
        println(s: argAt(i: 1));
        eprintln(s: argAt(i: 2));
        return 0;
    }
    if (cmd == "exit") {
        return parseIntArg(s: argAt(i: 1));
    }
    if (cmd == "cat") {
        // The standard streams, not a `File` claiming descriptors 0 and 1 — which it would then close at drop.
        Result<isize, IoError> cp = pump(from: stdin(), to: stdout());
        return match (cp) { case Ok(value: n): 0; case Err(error: e): 1; };
    }
    if (cmd == "sleep") {
        kama_sleep_ms(ms: parseIntArg(s: argAt(i: 1)));
        return 0;
    }
    if (cmd == "printenv") {
        return match (env(name: argAt(i: 1))) {
            case Some(value: _): { := 0; }
            case None: { := 1; }
        };
    }
    if (cmd == "spew") {
        int32 n = parseIntArg(s: argAt(i: 1));
        string a = ""; string b = "";
        int32 k = 0;
        while (k < 19) { a = a + "A"; b = b + "B"; k = k + 1; }
        int32 i = 0;
        while (i < n) { println(s: copy a); eprintln(s: copy b); i = i + 1; }
        return 0;
    }
    if (cmd == "tick") {
        int32 ms = parseIntArg(s: argAt(i: 1));
        int32 n = parseIntArg(s: argAt(i: 2));
        int32 i = 0;
        while (i < n) { kama_sleep_ms(ms: ms); println(s: "tick"); i = i + 1; }
        return 0;
    }
    if (cmd == "drain") {
        kama_sleep_ms(ms: parseIntArg(s: argAt(i: 1)));
        StdIn input = stdin();
        FixedArray<uint8> buf = FixedArray.make(size: 65536);
        int64 total = 0;
        bool more = true;
        while (more) {
            isize n = match (input.read(into: buf.viewMut())) { case Ok(value: k): k; case Err(error: e): -1; };
            if (n <= 0) { more = false; } else { total = total + cast<int64>(n); }
        }
        println(s: "${total}");
        return 0;
    }
    if (cmd == "fiberin") {
        scope {
            spawn fiber ticker(ms: 5);
            spawn fiber countStdin(bufSize: 4096);
        }
        println(s: ticks >= 3 ? "${stdinBytes} ticked" : "${stdinBytes} still");   // one tick lands even if the read blocks the thread
        return 0;
    }
    if (cmd == "hasfile") {
        string name = argAt(i: 1);
        Result<File, IoError> r = File.open(path: name, mode: OpenMode::Read);
        return match (give r) { case Ok(value: f): { := 0; } case Err(error: e): { := 1; } };
    }
    return 3;   // unknown subcommand
}

// The body above is the raw work, so IT carries the marker; `main` may not be `unsafe`
// (it encloses the whole program). Calling an `unsafe fn` from safe code is allowed.
// The status is typed as the platform's: one byte on POSIX, 32 bits on Windows, where `exit 70000` is a real status
// (tests/proc_exit_status_range reads it back through `ExitStatus`). A status that does not fit traps in `cast`.
@compileFor(!OS_WINDOWS) fn uint8 main()  { return cast<uint8>(run()); }
@compileFor(OS_WINDOWS)  fn uint32 main() { return cast<uint32>(run()); }
