// Task #2 probe fixture, driven by tools/check-argv-env.sh (NOT the standard harness — it can't set
// argv/env). Contract with the script: run with user args `alpha beta gamma`, env KAMA_PROBE_VAR=probe-value,
// and KAMA_PROBE_MISSING unset. Returns 0 iff every check passes; a distinct nonzero code pinpoints the
// first failing check (so a break is diagnosable). Exercises random access, the None tail, foreach order,
// env hit/miss, envOr both branches, programInvocation()/programName() (basename suffix of it), programPath().
fn int32 main() {
    // Random access over the user args (argv[0] excluded).
    if (args().count() != 3) { return 1; }
    string a0 = match (args().get(at: 0)) { case Some(v): copy v; case None: ""; };
    if (a0 != "alpha") { return 2; }
    string a1 = match (args().get(at: 1)) { case Some(v): copy v; case None: ""; };
    if (a1 != "beta") { return 3; }
    string a2 = match (args().get(at: 2)) { case Some(v): copy v; case None: ""; };
    if (a2 != "gamma") { return 4; }
    // Out-of-range is None.
    int32 tail = match (args().get(at: 3)) { case Some(v): 1; case None: 0; };
    if (tail != 0) { return 5; }

    // foreach yields the same args in order.
    string joined = "";
    foreach (string a in args()) { joined = joined + a + ","; }
    if (joined != "alpha,beta,gamma,") { return 6; }

    // env hit: value present and correct.
    int32 hit = match (env(name: "KAMA_PROBE_VAR")) {
        case Some(v): { int32 x = 0; if (v == "probe-value") { x = 1; } := x; }
        case None: 0;
    };
    if (hit != 1) { return 7; }
    // env miss: unset var is None.
    int32 miss = match (env(name: "KAMA_PROBE_MISSING")) { case Some(v): 1; case None: 0; };
    if (miss != 0) { return 8; }

    // envOr: fallback on miss, actual value on hit.
    if (envOr(name: "KAMA_PROBE_MISSING", dflt: "d") != "d") { return 9; }
    if (envOr(name: "KAMA_PROBE_VAR", dflt: "d") != "probe-value") { return 10; }

    // programName() is present, non-empty, and a bare basename (no path separator) regardless of how the
    // probe binary was invoked (direct temp path vs `kama run` temp path).
    string pname = match (programName()) { case Some(p): copy p; case None: ""; };
    if (pname.length() == 0) { return 11; }
    if (pname.contains(substring: "/")) { return 12; }

    // programInvocation() is the raw argv[0]; the basename must be a suffix of it (holds for any temp path).
    string pinv = match (programInvocation()) { case Some(p): copy p; case None: ""; };
    if (pinv.length() == 0) { return 13; }
    if (!pinv.endsWith(suffix: pname)) { return 14; }

    // programPath() resolves to a non-empty absolute exe path on this hosted platform.
    int32 hasPath = match (programPath()) { case Some(p): 1; case None: 0; };
    if (hasPath != 1) { return 15; }

    return 0;
}
