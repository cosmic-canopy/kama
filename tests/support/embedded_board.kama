// KR-341: std on a bare-metal board, declared in kama and RUN on an emulated Cortex-M3 by tools/check-mcu.sh (and built
// by tools/check-embedded.sh). The board's monotonic clock is a `@monotonicClock` type: here one that advances a
// millisecond each time it is read, since this harness arms no timer interrupt; a real board's SysTick handler calls
// `tick()` on it through `global::<T>()`. `sleep` and `Atomic.waitUntil` spin on it, a collection and the math run with
// no C library, and `main` returns 42.
import { std::time::MonotonicClock, std::time::monotonicNow, std::time::sleep, std::time::Duration, std::time::Instant,
         std::concurrent::Atomic, std::concurrent::cpuCount, std::collections::InlineDynamicArray, std::math::sqrt };

@monotonicClock
type resource ReadClock implements MonotonicClock {
    Atomic<uint32> reads;   // starts at zero: the instance is a C global
    public fn uint64 nanos() { return cast<uint64>(this.reads.fetchAdd(delta: 1ui32)) * 1000000ui64; }
    public fn uint32 count() { return this.reads.load(); }
}

fn uint8 main() {
    Instant start = monotonicNow();
    sleep(d: Duration.fromMillis(ms: 5));
    if (monotonicNow().since(earlier: start).nanos < 5000000i64) { return 1; }
    if (global::<ReadClock>().count() < 7ui32) { return 2; }
    Atomic<uint32> flag = Atomic.make(value: 0ui32);
    match (flag.waitUntil(whileEquals: 0ui32, deadline: monotonicNow() + Duration.fromMillis(ms: 3))) {
        case Ok(value: v): { return 3; }
        case Err(error: e): { }
    };
    InlineDynamicArray<int32>#(4) sides = InlineDynamicArray.empty();
    _ = sides.add(item: 3);
    _ = sides.add(item: 4);
    float64 hyp = sqrt(x: cast<float64>(sides[0] * sides[0] + sides[1] * sides[1]));
    if (hyp != 5.0 || cpuCount() != 1) { return 4; }
    return 42;
}
