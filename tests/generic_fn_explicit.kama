// Turbofish `f::<T>()` — explicit type arguments. The `zero` calls are return-only generics that
// argument inference cannot reach; the `pick` call gives explicit args on an inferable function.
fn T zero<T>() { return cast<T>(0); }
fn T pick<T>(T a, T b, bool useA) { if (useA) { return a; } return b; }

fn int32 main()
{
    int32 x = zero::<int32>();
    int64 y = zero::<int64>();
    int32 z = pick::<int32>(a: 40, b: 99, useA: true);
    return cast<int32>(x) + cast<int32>(y) + cast<int32>(z) + 2;   // 0 + 0 + 40 + 2
}
