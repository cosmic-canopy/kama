// A serde failure under a DECLARED pool: the `Err` and its boxed `Error` draw from the program's own storage,
// and nothing else is touched. Two things are pinned here, both broken when this was written.
//
//  1. The serde error path draws from the pool and nothing else does.
//  2. `deallocate` PANICS on a pointer it never handed out, so a regression is a named failure and not a wild
//     read. `give`-ing a string into a variant payload used to leave the source's `cap` set, so its scope drop
//     released a NULL — invisible under libc (`free(NULL)` is a no-op), memory corruption under a pool.
//  3. The document is bad input (`300` does not fit an `int8`), so the reader boxes an `Error` and returns
//     `Err`: the error path is the one that had never been run against a declared pool.
import { std::concurrent::Atomic, std::serialization::text::json::deserializeJsonBuffer };

@generate(Serializable, Deserializable)
type value Small {
    @field int8 n;
    public ctor make(int8 n) { this.n = n; }
    public fn int8 get() { return this.n; }
}

// 32 slots of 1024 bytes over storage the program owns. Every field starts at zero, which is how the instance
// always starts: an empty free list, nothing bumped yet.
@globalAllocator type resource Pool implements GlobalHeap {
    InlineArray<uint64>#(4096) storage;   // 32 KiB, 8-aligned
    Atomic<int32> lock;                   // 0 = free
    Atomic<usize> bumped;
    Atomic<usize> head;                   // free list: slot index + 1, 0 = empty
    Atomic<isize> live;                   // blocks handed out and not yet returned

    unsafe fn usize origin() { UnsafePtr<uint64> p = addr(of: this.storage[0]); return cast<usize>(p); }
    fn void acquire() { int32 open = 0; while (!this.lock.compareExchange(expected: open, desired: 1)) { open = 0; } }
    fn void release() { this.lock.store(value: 0); }

    public unsafe fn Optional<UnsafePtr> allocate(usize bytes, usize align) {
        if (bytes + align - 1 > 1024) { return Optional::None; }
        this.acquire();
        usize slot = 0;
        usize h = this.head.load();
        if (h != 0) {
            slot = h - 1;
            UnsafePtr<usize> link = cast<UnsafePtr<usize>>(this.origin() + slot * 1024);
            this.head.store(value: link[0]);
        } else {
            slot = this.bumped.load();
            if (slot == 32) { this.release(); return Optional::None; }
            this.bumped.store(value: slot + 1);
        }
        this.live.store(value: this.live.load() + 1);
        this.release();
        usize at = (this.origin() + slot * 1024 + align - 1) & ~(align - 1);
        return Optional::Some(value: cast<UnsafePtr>(at));
    }

    public unsafe fn void deallocate(UnsafePtr pointer, usize bytes, usize align) {
        usize p = cast<usize>(pointer);
        // The whole point of the fixture: a pool only ever gets back what it handed out. A NULL (a moved-from
        // value whose drop still ran) or any address outside the storage is a compiler defect, named here.
        if (p < this.origin() || p >= this.origin() + 32768) { panic(msg: "the pool was handed a pointer it never returned"); }
        usize slot = (p - this.origin()) / 1024;
        this.acquire();
        UnsafePtr<usize> link = cast<UnsafePtr<usize>>(this.origin() + slot * 1024);
        link[0] = this.head.load();
        this.head.store(value: slot + 1);
        this.live.store(value: this.live.load() - 1);
        this.release();
    }
}

fn int32 main() {
    // `300` does not fit the `int8` field: the document is rejected, which boxes an `Error` — from the pool.
    Result<Small, Owned<Error>> bad = deserializeJsonBuffer::<Small>(src: "{\"n\":300}");
    int32 rejected = match (bad) { case Ok(value: _v): 0; case Err(error: _e): 1; };
    // ...and a document that DOES fit still reads, so the fixture is not passing by rejecting everything.
    Result<Small, Owned<Error>> good = deserializeJsonBuffer::<Small>(src: "{\"n\":42}");
    int32 read = match (good) { case Ok(value: v): cast<int32>(v.get()); case Err(error: _e2): 0; };
    return rejected + read;   // 1 + 42
}
