import std::memory::{Shared, Weak};
// Weak<T> RAII: a weak doesn't keep the pointee alive and doesn't double-free or
// leak the control block. One construction, one destruction despite the weak ref.
extern fn void kama_trace(int code);
extern fn int kama_trace_get();

type resource Probe
{
    int32 id;
    public unsafe ctor make(int32 id) { this.id = id; kama_trace(code: 1); }
    unsafe ~Probe() { kama_trace(code: 2); }
}

fn int build()
{
    Shared<Probe> a = new Probe.make(id: 9);   // construct -> 1 (strong=1)
    Weak<Probe> w = a.downgrade();                 // weak=1 (does not keep alive)
    return 0;
    // scope exit: ~w (weak 1->0, strong still 1: ctrl kept, pointee untouched),
    //             ~a (strong 1->0: ~Probe -> 2; weak==0: free ctrl)
}

unsafe fn int main()
{
    int r = build();
    return kama_trace_get();   // fold(1,2) = 33
}
