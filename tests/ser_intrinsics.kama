// The intrinsic Serialize/Deserialize retro-impls compose inside a collection for every scalar width.
import std::serialization::json::{encode, decode};
import std::collections::{DynamicArray};
fn int main() {
    DynamicArray<bool> bs = DynamicArray(); bs.add(item: true); bs.add(item: false); bs.add(item: true);
    if (!encode(v: bs).equals(other: "[true,false,true]")) { return 1; }
    DynamicArray<float64> fs = DynamicArray(); fs.add(item: 1.5); fs.add(item: 2.5);
    Result<DynamicArray<float64>, Owned<Error>> res = decode::<DynamicArray<float64>>(src: give encode(v: fs));
    return match (res) { case Ok(b): cast<int32>(b[0] + b[1]); case Err(e): 0 - 1; };  // 4
}
