// The intrinsic Serialize/Deserialize retro-impls compose inside a collection for every scalar width.
import std::serialization::json::{encode, decode};
import std::collections::{DynamicArray};
fn int main() {
    DynamicArray<bool> bs = DynamicArray.empty(); bs.add(item: true); bs.add(item: false); bs.add(item: true);
    Result<string, Owned<Error>> __encB = encode(v: bs);
    string __bsj = match (give __encB) { case Ok(value: __ok): give __ok; case Err(error: __e): { return 1; } };
    if (!__bsj.equals(other: "[true,false,true]")) { return 1; }
    DynamicArray<float64> fs = DynamicArray.empty(); fs.add(item: 1.5); fs.add(item: 2.5);
    Result<string, Owned<Error>> __encF = encode(v: fs);
    string __fsStr = match (give __encF) { case Ok(value: __ok): give __ok; case Err(error: __e): { return 250; } };
    Result<DynamicArray<float64>, Owned<Error>> res = decode::<DynamicArray<float64>>(src: give __fsStr);
    return match (res) { case Ok(value: b): cast<int32>(b[0] + b[1]); case Err(error: e): 0 - 1; };  // 4
}
