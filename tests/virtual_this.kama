// M25b: a public method (`describe`) over a `protected virtual` hook (`area`) — the
// sanctioned way to publish polymorphism from a class hierarchy (vs. an interface).
type virtual(maxDepth: 1) resource Shape
{
    public ctor make() { }
    public fn int32 describe() { return this.area(); }
    protected virtual fn int32 area() { return 1; }
}
type final resource Circle extends Shape
{
    int32 r;
    public ctor make(int32 r) { this.base = Base.make(); this.r = r; }
    protected override fn int32 area() { return r * r; }
}
fn int32 main()
{
    Circle c = Circle.make(r: 7);
    return c.describe();
}
