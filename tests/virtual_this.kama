// M25b: a public method (`describe`) over a `protected virtual` hook (`area`) — the
// sanctioned way to publish polymorphism from a class hierarchy (vs. an interface).
type virtual resource Shape
{
    public fn int describe() { return this.area(); }
    protected virtual fn int area() { return 1; }
}
type final resource Circle extends Shape
{
    int r;
    public ctor make(int r) { this.r = r; }
    protected override fn int area() { return r * r; }
}
fn int main()
{
    Circle c = Circle.make(r: 7);
    return c.describe();
}
