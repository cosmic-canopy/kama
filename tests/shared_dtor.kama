import std::memory::{Shared};
// Shared<T> refcount: the pointee is destructed exactly once when the LAST
// handle drops — not per-handle (no double-free), and not never (no leak).
extern fn void kama_trace(int code);
extern fn int kama_trace_get();

type resource Probe
{
    int32 id;
    Probe(int32 id) { this.id = id; kama_trace(code: 1); }
    ~Probe() { kama_trace(code: 2); }
}

fn int build()
{
    Shared<Probe> a = new Probe(id: 9);   // construct -> 1, strong=1
    Shared<Probe> b = a;                           // retain, strong=2
    return 0;
    // scope exit: ~b (strong 2->1, no dtor), ~a (strong 1->0, ~Probe -> 2)
}

fn int main()
{
    int r = build();
    return kama_trace_get();   // fold(1,2) = 33
}
