import std::memory::{Shared};
// Shared<T> refcount: the pointee is destructed exactly once when the LAST
// handle drops — not per-handle (no double-free), and not never (no leak).
extern fn void kama_trace(int32 code);
extern fn int32 kama_trace_get();
unsafe fn int32 traceGet() { return kama_trace_get(); }   // the FFI call, contained — `main` may not be `unsafe`

type resource Probe
{
    int32 id;
    public unsafe ctor make(int32 id) { this.id = id; kama_trace(code: 1); }
    unsafe ~Probe() { kama_trace(code: 2); }
}

fn int32 build()
{
    Shared<Probe> a = new Probe.make(id: 9);   // construct -> 1, strong=1
    Shared<Probe> b = a;                           // retain, strong=2
    return 0;
    // scope exit: ~b (strong 2->1, no dtor), ~a (strong 1->0, ~Probe -> 2)
}

fn int32 main()
{
    int32 r = build();
    return traceGet();   // fold(1,2) = 33
}
