// The real smart-pointer shape: a heap-owning RAII `resource` over `Ptr<T>` + `unsafe` that
// `implements Deref<Point>`. `o.sum()`/`o.x` auto-deref to the heap pointee; the dtor frees it.
// This is exactly how a library `Owned` would be written (RAII + move-only come free from `resource`).
extern "<stdlib.h>";
extern fn Ptr malloc(usize n);
extern fn void free(Ptr p);

@generate(of)
type value Point {
    public int32 x; public int32 y;
    public fn int32 sum() { return this.x + this.y; }
}

type resource OwnPoint implements Deref<Point> {
    Ptr<Point> p;
    public ctor make(Point v) { OwnPoint r;
        unsafe { r.p = cast<Ptr<Point>>(malloc(n: sizeof(Point))); r.p[0] = v; }
     return give r; }
    public fn ref Point deref() { unsafe { return this.p[0]; } }   // place into the heap object
    ~OwnPoint() { unsafe { free(p: cast<Ptr>(this.p)); } }
}

fn int32 main() {
    OwnPoint o = OwnPoint.make(v: Point.of(x: 30, y: 12));
    return o.sum() + o.x;   // 42 + 30 = 72 (then RAII frees the heap Point)
}
