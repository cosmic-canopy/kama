// The real smart-pointer shape: a heap-owning RAII `resource` over `UnsafePtr<T>` + `unsafe` that
// `implements Deref<Point>`. `o.sum()`/`o.x` auto-deref to the heap pointee; the dtor frees it.
// This is exactly how a library `Owned` would be written (RAII + move-only come free from `resource`).
extern "<stdlib.h>";
extern fn UnsafePtr malloc(usize n);
extern fn void free(UnsafePtr p);

@generate(of)
type value Point {
    public int32 x; public int32 y;
    public fn int32 sum() { return this.x + this.y; }
}

type resource OwnPoint implements Deref<Point> {
    UnsafePtr<Point> p;
    public unsafe ctor make(Point v) { 
        this.p = cast<UnsafePtr<Point>>(malloc(n: sizeof(Point))); this.p[0] = v;
 }
    public unsafe fn ref Point deref() { return this.p[0]; }   // place into the heap object
    unsafe ~OwnPoint() { free(p: cast<UnsafePtr>(this.p)); }
}

fn int32 main() {
    OwnPoint o = OwnPoint.make(v: Point.of(x: 30, y: 12));
    return o.sum() + o.x;   // 42 + 30 = 72 (then RAII frees the heap Point)
}
