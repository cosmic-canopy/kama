import { std::memory::Shared };
type resource Probe
{
    int32 id;
    public ctor make(int32 id) { this.id = id; }
    ~Probe() { }
}
type enum Box
{
    Full(Shared<Probe> p),
    Empty
}
fn int32 main()
{
    Shared<Probe> s = new Probe.make(id: 7);
    Box a = Box::Full(p: copy s);
    Box b = Box::Empty;
    return 0;
}
