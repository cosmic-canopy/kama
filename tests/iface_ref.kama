type contract Shape for both { fn int64 area(); }
type value Circle implements Shape {
    int64 r;
    public ctor make(int64 r) { Circle r2; r2.r = r; return give r2; }
    public fn int64 area() { return r * r; }
}
type value Square implements Shape {
    int64 s;
    public ctor make(int64 s) { Square r; r.s = s; return give r; }
    public fn int64 area() { return s * s; }
}
fn void swapTo(out Shape sh, Shape other) { sh = other; }   // reseat the caller's handle
fn int64 read(ref Shape sh) { return sh.area(); }
fn int main() {
    Circle c = Circle.make(r: 6);
    Square q = Square.make(s: 5);
    Shape s = c;
    int64 a = read(sh: ref s);     // 36
    swapTo(sh: out s, other: q);  // now s holds the square — `out` reseats, so the call site says `out`
    int64 b = read(sh: ref s);     // 25
    int64 total = a + b;           // 61
    return cast<int>(total);
}
