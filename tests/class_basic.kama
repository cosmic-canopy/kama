type value Counter
{
    int32 value;
    public ctor make(int32 start)
    {
        this.value = start;
    }
    public fn void add(int32 n)
    {
        value = value + n;
    }
    public fn int32 get()
    {
        return value;
    }
}
fn int32 main()
{
    Counter c = Counter.make(start: 40);
    c.add(n: 2);
    return c.get();
}
