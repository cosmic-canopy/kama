type value Counter
{
    int value;
    public ctor make(int start)
    {
        this.value = start;
    }
    public fn void add(int n)
    {
        value = value + n;
    }
    public fn int get()
    {
        return value;
    }
}
fn int main()
{
    Counter c = Counter.make(start: 40);
    c.add(n: 2);
    return c.get();
}
