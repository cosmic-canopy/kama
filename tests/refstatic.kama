// A `static fn ref T` method returns a PLACE, called as `Type::at(...)`. A static method has no `this`
// (like a free fn), so the place must borrow a `ref` param. Locks the static-method call-site deref
// (the `Type::m()` path now derefs place returns, closing a pre-existing gap).
type value Buf {
    InlineArray<int32, 4> d;
    public ctor make() { this.d = [0; 4]; }
    public static fn ref int32 at(ref Buf b, usize i) { return b.d[i]; }
}
fn int32 main() {
    Buf b = Buf.make();
    Buf::at(b: ref b, i: 0) = 7;
    Buf::at(b: ref b, i: 0) += 1;      // 8
    return Buf::at(b: ref b, i: 0);    // 8
}
