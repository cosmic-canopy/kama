// Construction-model M4: dot-on-type constructor calls — `Type.name(...)`. A named `ctor` is a static
// factory, so `Point.make(...)` reaches the SAME C as the M2 bridge `Point.make(...)` (byte-identical).
// Covers both fallibility modes through the dot spelling: an infallible ctor returns `T`, a fallible one
// returns `Result<T,E>`. Distinct from `Type::staticFn()` (a static fn stays `::` — see
// dot_vs_static_greppable) and `Enum::Variant` (stays `::`).
enum PointErr { NegativeX }
implements Error for PointErr { public fn string message() { return "negative x"; } }
type value Point {
    int32 x;
    int32 y;
    public ctor make(int32 x, int32 y) { this.x = x; this.y = y; return this; }
    public ctor Result<Point, PointErr> checked(int32 x, int32 y) {
        if (x < 0) { return Result::Err(error: PointErr::NegativeX); }   // fail before the object exists
        return Result::Ok(value: Point.make(x: x, y: y));   // delegate to the infallible ctor (dot chain)
    }
    public fn int32 sum() { return this.x + this.y; }
}
fn int32 main() {
    Point p = Point.make(x: 10, y: 20);                    // infallible dot-on-type
    Result<Point, PointErr> ok  = Point.checked(x: 5, y: 7);  // fallible dot-on-type
    Result<Point, PointErr> bad = Point.checked(x: -1, y: 0);
    int32 a = match (ok)  { case Ok(value: q): q.sum(); case Err(error: e): 0 - 1; };   // 12
    int32 b = match (bad) { case Ok(value: q): 999;     case Err(error: e): 0 - 1; };   // -1
    return p.sum() + a + b + 1;   // 30 + 12 - 1 + 1 = 42
}
