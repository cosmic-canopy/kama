// std::process — RAII hygiene under load. 3000x: spawn `true` with a piped stdout, then DROP the Process
// without wait(). The dtor must leave NO zombie behind — reaping the child if it already exited, else
// parking the pid for the runtime's reaper to sweep on a later drop (POSIX can't reparent a live child to
// init while we're still running, so an un-swept pid pins a process-table slot until `fork` fails with
// EAGAIN — this loop exceeds macOS's kern.maxprocperuid of 2666). Its File fields must also close the pipe
// ends (no fd leak -> no EMFILE). Stays ASan-clean under KAMA_SAN.
import { std::process::Command, std::process::Process, std::process::Stdio, std::io::IoError };

fn int32 main() {
    int32 i = 0;
    while (i < 3000) {
        Command c = Command.make(program: envOr(name: "KAMA_PROCUTIL", dflt: "procutil"));
        c.arg(a: "exit"); c.arg(a: "0");
        c.stdout(s: Stdio::Piped);
        Result<Process, IoError> sr = c.start();
        match (give sr) {
            case Ok(value: p): {}                 // p drops here: dtor WNOHANG-reaps + closes the pipe read end
            case Err(error: e): { return 120; }
        };
        i = i + 1;
    }
    return 42;
}
