// `Simd<T>#(comptime N)` — the lane batch. Values only here; that the emitted C actually reaches the
// vector spelling is a separate assertion, in tools/check-simd-type.sh, because a value fixture passes
// just as happily against a scalar fallback and would not notice the difference.
//
// Construction is an ARRAY LITERAL, the same spelling `InlineArray` uses: `[a, b, c, d]` writes the
// lanes out and `[v; N]` splats. One way to spell "N values of T", which is what the two shapes have in
// common; everything below it differs.
fn int32 main() {
    Simd<float32>#(4) a = [1.0f32, 2.0f32, 3.0f32, 4.0f32];
    Simd<float32>#(4) t = [10.0f32; 4];                  // splat -> 10,10,10,10

    // Elementwise arithmetic is C's own operator on the vector type — one instruction, not a loop.
    Simd<float32>#(4) m = a * t;                          // 10, 20, 30, 40
    Simd<float32>#(4) s = m + a;                          // 11, 22, 33, 44
    Simd<float32>#(4) d = s - a;                          // 10, 20, 30, 40
    Simd<float32>#(4) q = d / t;                          //  1,  2,  3,  4

    int32 r = 0;
    r = r + cast<int32>(q.lane(index: 0));               //  1   — a bounds-checked lane read
    r = r + cast<int32>(q.lane(index: 3));               //  4   => 5

    // abs / min / max: no libm, so they hold on a freestanding target too (see KAMA_SIMD_FUNCS).
    Simd<float32>#(4) neg = [0.0f32 - 3.0f32, 2.0f32, 0.0f32 - 7.0f32, 4.0f32];
    Simd<float32>#(4) one = [1.0f32; 4];
    r = r + cast<int32>(neg.abs().lane(index: 2));       //  7   => 12
    r = r + cast<int32>(neg.min(rhs: one).lane(index: 0)); // -3 => 9
    r = r + cast<int32>(neg.max(rhs: one).lane(index: 1)); //  2 => 11

    // `toArray` is the way back to addressable memory — an `InlineArray<T>#(N)`, which the rest of the
    // language already knows how to index and iterate. A Simd itself has NO `foreach` and no `[i]`:
    // taking a lane batch apart one lane at a time is what it exists to avoid.
    InlineArray<float32>#(4) back = q.toArray();
    foreach (float32 e in back) { r = r + cast<int32>(e); }   // 1+2+3+4 = 10 => 21

    // A Simd is a plain value: copies by value, owns nothing, has no destructor. (`copy` is a keyword
    // — the give/copy ownership model — so the binding cannot be named that.)
    Simd<float32>#(4) dup = q;
    r = r + cast<int32>(dup.lane(index: 1));            //  2   => 23


    // ---- The lane work: the operations that have NO scalar spelling at all -------------------------
    // This is what the type exists for. Everything above it, a loop over `Vec4`s already compiles to
    // SIMD on its own, and often better (ROADMAP_DETAIL.md §2). These three cannot be written any other way.

    // An arbitrary permutation. The lane indices must be COMPILE-TIME constants because the CPU encodes
    // the permutation in the instruction; a runtime pattern spills the vector to the stack.
    Simd<float32>#(4) rev = a.shuffle(pattern: [3, 2, 1, 0]);       // 4, 3, 2, 1
    r = r + cast<int32>(rev.lane(index: 0));                        //  4  => 27

    // A two-vector blend: lanes 0..3 select from the receiver, 4..7 from `rhs`.
    Simd<float32>#(4) ten = [10.0f32, 20.0f32, 30.0f32, 40.0f32];
    Simd<float32>#(4) mix = a.blend(rhs: ten, pattern: [0, 5, 2, 7]);  // 1, 20, 3, 40
    r = r + cast<int32>(mix.lane(index: 1));                        // 20  => 47

    // A lane mask as a VALUE. `Mask<T>#(N)` carries T because a compare's lane width follows its
    // operand's, so a bare `Mask#(4)` would have no C type.
    Simd<float32>#(4) four = [4.0f32; 4];
    Simd<float32>#(4) vals = [1.0f32, 5.0f32, 3.0f32, 7.0f32];
    Mask<float32>#(4) gt = vals.greaterThan(rhs: four);              // F, T, F, T
    Simd<float32>#(4) picked = gt.select(ifTrue: vals, ifFalse: four); // 4, 5, 4, 7
    r = r + cast<int32>(picked.reduceAdd());                        // 20  => 67
    if (gt.anyTrue()) { r = r + 1; }                                //      => 68
    if (gt.allTrue()) { r = r + 100; }                              // not taken
    Mask<float32>#(4) inv = gt.not();
    if (inv.anyTrue()) { r = r + 1; }                               //      => 69

    // Horizontal reductions — the deliberate collapse to a scalar.
    r = r + cast<int32>(vals.reduceMax());                          //  7  => 76
    r = r + cast<int32>(vals.reduceMin());                          //  1  => 77

    // sqrt / floor / ceil — the libm trio, on FLOAT lanes only (kama_math.h; an integer batch has no
    // `sqrt` — tests/xfail/simd_int_sqrt). Both float widths, so each KAMA_SIMD_MATH instance is built.
    Simd<float32>#(4) sq = [4.0f32, 9.0f32, 16.0f32, 2.25f32];
    r = r + cast<int32>(sq.sqrt().lane(index: 2));                  //  4  => 81
    Simd<float32>#(4) fr = [1.5f32, 0.0f32 - 1.5f32, 2.75f32, 0.0f32 - 0.25f32];
    r = r + cast<int32>(fr.floor().lane(index: 0));                 //  1  => 82
    r = r + cast<int32>(fr.floor().lane(index: 1));                 // -2  => 80
    r = r + cast<int32>(fr.ceil().lane(index: 2));                  //  3  => 83
    r = r + cast<int32>(fr.ceil().lane(index: 3));                  //  0  => 83  (-0.25 ceils to -0)
    Simd<float64>#(2) dq = [49.0, 0.25];
    r = r + cast<int32>(dq.sqrt().lane(index: 0));                  //  7  => 90
    r = r + cast<int32>(dq.floor().lane(index: 1));                 //  0  => 90
    r = r + cast<int32>(dq.ceil().lane(index: 1));                  //  1  => 91

    return r;
}
