import std::memory::{Owned};
// A local constructed at its declaration is definitely assigned -> reads are fine.
type value Box { int32 v; public ctor make(int32 v) { slot Box r; r.v = v; return give r; } public fn int32 get() { return this.v; } }
fn int32 main() {
    Owned<Box> b = new Box.make(v: 41);
    return b.get() + 1;   // 42
}
