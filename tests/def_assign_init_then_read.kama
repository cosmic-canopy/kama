import { std::memory::Owned };
// A local constructed at its declaration is definitely assigned -> reads are fine.
type value Box { int32 v; public ctor make(int32 v) { this.v = v; } public fn int32 get() { return this.v; } }
fn uint8 main() {
    Owned<Box> b = new Box.make(v: 41);
    return cast<uint8>(b.get() + 1);   // 42
}
