// Comparison consolidation, the payoff: a type conforms to `Equatable`/`Comparable` ONCE and gets both
// the operators AND container eligibility. Before the contracts were the single truth, `Duration` carried
// `operator==`/`<`/`>` yet implemented neither contract — so `a < b` worked while `SortedSet<Duration>`
// and `Map<Duration, _>` were compile errors. This fixture is exactly what used to be impossible.
import std::collections::{SortedSet, Map};
import std::time::{Duration};

// A user type mirroring the same shape: one `implements`, six operators, plus sorted/keyed containers.
type value Cents implements Equatable<This>, Comparable<This>, Hashable {
    public int32 v;
    public ctor of(int32 v) { this.v = v; }
    public fn uint64 hash() { return cast<uint64>(this.v); }
    public fn bool equals(ref Cents other) { return this.v == other.v; }
    public fn Ordering compareTo(ref Cents other) {
        if (this.v < other.v) { return Ordering::Less; }
        if (this.v > other.v) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

fn int32 main() {
    int32 r = 0;

    // `<`/`>`/`<=`/`>=` route through `compareTo`; `==`/`!=` through `equals`.
    Duration a = Duration.fromMillis(ms: 10i64);
    Duration b = Duration.fromMillis(ms: 20i64);
    Duration a2 = Duration.fromMillis(ms: 10i64);
    if (a < b)   { r = r + 1; }
    if (b > a)   { r = r + 1; }
    if (a <= a2) { r = r + 1; }     // `<=` is "not Greater" — the operator the raw set never had
    if (a >= a2) { r = r + 1; }
    if (a == a2) { r = r + 1; }
    if (a != b)  { r = r + 1; }     // `!=` is `!equals`, never separately defined

    // The container eligibility that conforming buys — a Duration is now an ordered key.
    SortedSet<Duration> deadlines = SortedSet.empty();
    deadlines.add(key: b);
    deadlines.add(key: a);
    deadlines.add(key: a2);        // equal to `a` -> deduped
    r = r + cast<int32>(deadlines.length());          // 2

    // And a user type is simultaneously a hashed key and a sorted one, off the same two contracts.
    Map<Cents, int32> prices = Map.empty();
    Cents k = Cents.of(v: 7);
    prices.put(key: k, value: 42);
    int32 got = match (prices.get(key: k)) { case Some(value: v): v; case None: 0; };
    r = r + got;                                      // 42

    SortedSet<Cents> tiers = SortedSet.empty();
    tiers.add(key: Cents.of(v: 3));
    tiers.add(key: Cents.of(v: 1));
    r = r + cast<int32>(tiers.length());              // 2

    return r;   // 6 + 2 + 42 + 2 = 52
}
