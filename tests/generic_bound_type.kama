// M27c-1 — a contract BOUND on a generic TYPE: `type value Scale<T: Weighable>`. The bound lets a
// method call `x.weight()` on a T PARAMETER (static dispatch after monomorphization). Enforcement:
// `Scale<Rock>` requires Rock to satisfy Weighable. (T is a method param, not a by-value field — a
// generic instance holding a user value-type BY VALUE is a separate pre-existing emit-order gap.)
type contract Weighable for both { fn int32 weight(); }
type value Rock implements Weighable {
    int32 g;
    public ctor make(int32 g) { Rock r; r.g = g; return give r; }
    public fn int32 weight() { return this.g; }
}
type value Scale<T: Weighable> {
    int32 factor;
    public ctor make(int32 f) { Scale<T> r; r.factor = f; return give r; }
    public fn int32 apply(T x) { return this.factor * x.weight(); }
}
fn int32 main() {
    Scale<Rock> s = Scale.make(f: 3);
    Rock r = Rock.make(g: 14);
    return s.apply(x: r);   // 3 * 14 = 42
}
