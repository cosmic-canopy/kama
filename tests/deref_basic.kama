// Auto-deref via the prelude `Deref<T>` contract: a wrapper that `implements Deref<Point>, DerefMut<Point>` forwards
// member access to its pointee — `b.sum()` resolves to `Point__sum(BoxP__deref(&b))` and `b.x` reads
// through `BoxP__deref(&b)->x`. Nominal/opt-in: the `implements` is the gate. No heap, no lifetimes.
@generate(of)
type value Point {
    public int32 x; public int32 y;
    public fn int32 sum() { return this.x + this.y; }
}

type value BoxP implements Deref<Point>, DerefMut<Point> {
    Point inner;
    public ctor make(Point p) { this.inner = p; }
    public const fn const ref Point deref() { return this.inner; }   // a place rooted at `this`
    public fn ref Point derefMut() { return this.inner; }
}

fn int32 main() {
    BoxP b = BoxP.make(p: Point.of(x: 30, y: 12));
    int32 viaMethod = b.sum();   // auto-deref to a Point method -> 42
    int32 viaField  = b.x;       // auto-deref to a Point field  -> 30
    return viaMethod + viaField; // 72
}
