import std::memory::{Owned};
// Owned<T> factory: a function that returns an Owned<T> moves ownership out to
// the caller — the pointee survives the callee's unwind and is freed exactly
// once at the caller's scope exit (no callee-free, no leak, no double-free).
extern fn void kama_trace(int code);
extern fn int kama_trace_get();

type resource Node
{
    int32 id;
    public unsafe ctor make(int32 id) { this.id = id; kama_trace(code: 5); }
    unsafe ~Node() { kama_trace(code: 6); }
}

fn Owned<Node> make(int32 v)
{
    Owned<Node> n = new Node.make(id: v);   // construct -> 5
    return n;                                  // MOVE OUT (make's unwind no-ops)
}

unsafe fn int main()
{
    {
        Owned<Node> p = make(v: 7);   // p owns the Node
    }                                  // p drops here -> ~Node -> 6
    return kama_trace_get();          // fold(5,6) = 161
}
