// std::fs — readDir returns real entries and filters "." / "..".
import { std::fs::readDir, std::io::IoError, std::collections::DynamicArray };

fn int32 checkNames(ref DynamicArray<string> names) {
    isize n = names.length();
    if (n <= 0) { return 31; }                 // the working dir must have entries
    bool bad = false;
    foreach (ref string nm in names) {
        if (nm == ".")  { bad = true; }
        if (nm == "..") { bad = true; }
    }
    if (bad) { return 32; }                     // "." / ".." must have been filtered
    return 0;
}

fn int32 main() {
    string dot = ".";
    return match (readDir(path: dot)) { case Ok(value: names): checkNames(names: names); case Err(error: e): 30; };
}
