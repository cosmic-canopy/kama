import std::collections::{DynamicArray};
// M26f-1 — a class may hold a collection BY VALUE as a field. Needs (1) the collection
// struct typedef emitted before the class struct body (macro TYPE/FUNCS split) and
// (2) the field auto-initialized to a valid empty collection by the ctor.
type resource Bag {
    DynamicArray<int32> items;
    public ctor make() { Bag r; return give r; }
    public fn void add(int32 v) { this.items.add(item: v); }
    public fn int32 sum() {
        int32 s = 0;
        for (int32 i = 0; i < this.items.length(); i = i + 1) { s = s + this.items[i]; }
        return s;
    }
}
fn int32 main() { Bag b = Bag.make(); b.add(v: 20); b.add(v: 22); return b.sum(); }   // 42
