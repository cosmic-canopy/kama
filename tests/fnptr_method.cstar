// M21b: an UNBOUND method reference `Type::method`. A method lowers to
// Class__method(Class* self, …), so it's a function pointer whose first param is
// the receiver (`ref Vec2 self`). The object is passed explicitly at the call.
class Vec2 {
    int32 x; int32 y;
    Vec2(int32 x, int32 y) { this.x = x; this.y = y; }
    fn int32 dot(ref Vec2 o) { return this.x * o.x + this.y * o.y; }
}
fnptr int32 DotFn(ref Vec2 self, ref Vec2 o);   // receiver is an explicit first param

fn int32 main() {
    Vec2 u = new Vec2(x: 3, y: 4);
    Vec2 v = new Vec2(x: 6, y: 6);
    DotFn d = Vec2::dot;                          // unbound method ref (:: = no binding)
    return d(self: ref u, o: ref v);             // pass the object explicitly: 3*6+4*6 = 42
}
