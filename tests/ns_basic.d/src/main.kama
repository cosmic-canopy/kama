// Two modules of one project declaring the SAME type name, kept apart. `graphics::Texture` comes in
// unqualified; `physics::Texture` is reached by its qualified spelling, which stays available because
// importing any symbol of a module loads that module.
import { nsbasic::graphics::Texture, nsbasic::physics::Texture as PhysTexture };

fn int32 main()
{
    Texture g = Texture.make(id: 10);                     // graphics::Texture (imported bare)
    PhysTexture p = nsbasic::physics::Texture.make(m: 7); // alias in type position, qualified to construct
    int32 s = nsbasic::graphics::scale(x: 3);             // qualified call into an imported module -> 6
    return g.get() + p.get() + s;                         // 10 + 7 + 6 = 23
}
