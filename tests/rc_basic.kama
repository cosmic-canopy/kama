// A reference-counted smart pointer written entirely in kama (dev name `Rc`; final rename to `Shared`
// at the intrinsic-removal step). A Copyable `resource` over the object + a heap control block: `copy r`
// retains (strong++); the object is released exactly once when the last handle drops. No compiler support
// beyond new/HeapOwner/Deref/drop/Copyable.
extern "<stdlib.h>";
extern fn Ptr malloc(usize n);
extern fn void free(Ptr p);

type value Ctrl { public int32 strong; public int32 weak; }

type value Counter {
    public int32 n;
    public ctor make(int32 start) { slot Counter r; r.n = start; return give r; }
    public fn int32 bump() { this.n = this.n + 1; return this.n; }
}

type resource Rc<T> implements Deref<T>, HeapOwner<T>, Copyable(bare: copy) {
    Ptr<T> p;
    Ptr<Ctrl> c;
    public ctor adopt(Ptr<T> raw) {
        slot Rc<T> r;
        r.p = raw;
        unsafe { r.c = cast<Ptr<Ctrl>>(malloc(n: sizeof(Ctrl))); r.c[0].strong = 1; r.c[0].weak = 0; }
        return give r;
    }
    public fn ref T deref() { unsafe { return this.p[0]; } }
    public ctor copy(ref Rc<T> source) {                         // Copyable -> retain
        unsafe { source.c[0].strong = source.c[0].strong + 1; }
        slot Rc<T> r; r.p = source.p; r.c = source.c; return give r;
    }
    ~Rc() {
        unsafe {
            this.c[0].strong = this.c[0].strong - 1;
            if (this.c[0].strong == 0) {
                drop(value: this.deref());           // run the pointee's dtor (no-op for a value)
                free(p: cast<Ptr>(this.p));
                if (this.c[0].weak == 0) { free(p: cast<Ptr>(this.c)); }
            }
        }
    }
}

fn int32 main() {
    Rc<Counter> a = new Counter.make(start: 10);
    Rc<Counter> b = copy a;   // retain — a and b share one Counter + one ctrl
    int32 x = a.bump();       // auto-deref -> 11
    int32 y = b.n;            // auto-deref field -> 11 (shared object)
    return x + y;             // 22 (both drop; object + ctrl each freed once)
}
