// Landing D: the two fallible boundaries compose — a value round-trips through the fallible `encode`
// (Result<string, Owned<Error>>) and the fallible `deserializeJsonBuffer` (Result<This, Owned<Error>>), both `Ok`.
import { std::serialization::json::serializeJsonBuffer, std::serialization::json::deserializeJsonBuffer };
@generate(Serializable, Deserializable)
type value Point {
    @field int32 x;
    @field int32 y;
    public ctor make(int32 x, int32 y) { this.x = x; this.y = y; }
    public fn int32 sum() { return this.x + this.y; }
}
fn int32 main() {
    Point p = Point.make(x: 30, y: 12);
    Result<string, Owned<Error>> je = serializeJsonBuffer(v: p);
    string j = match (give je) { case Ok(value: s): give s; case Err(error: e): { return 250; } };
    Result<Point, Owned<Error>> pr = deserializeJsonBuffer::<Point>(src: give j);
    return match (pr) { case Ok(value: q): q.sum(); case Err(error: e): 0 - 1; };   // 42
}
