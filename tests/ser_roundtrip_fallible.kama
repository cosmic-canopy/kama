// Landing D: the two fallible boundaries compose — a value round-trips through the fallible `encode`
// (Result<string, Owned<Error>>) and the fallible `decode` (Result<This, Owned<Error>>), both `Ok`.
import std::serialization::json::{encode, decode};
@generate(Serialize, Deserialize, noOnConstruction)
type value Point {
    @field int32 x;
    @field int32 y;
    public ctor make(int32 x, int32 y) { Point r; r.x = x; r.y = y; return give r; }
    public fn int32 sum() { return this.x + this.y; }
}
fn int main() {
    Point p = Point.make(x: 30, y: 12);
    Result<string, Owned<Error>> je = encode(v: p);
    string j = match (give je) { case Ok(s): give s; case Err(e): { return 250; } };
    Result<Point, Owned<Error>> pr = decode::<Point>(src: give j);
    return match (pr) { case Ok(q): q.sum(); case Err(e): 0 - 1; };   // 42
}
