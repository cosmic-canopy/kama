// LSP reference-index COVERAGE fixture, second half — the dispatch and allocation forms. Split from
// spellings.kama so each checked-in table stays small enough to read a diff of. See spellings.kama's
// header for what these files are and how to regenerate them.
//
//     ./kama query tests/query/coverage/dispatch.kama --coverage > tests/query/coverage/dispatch.coverage
namespace dispatch;

import std::collections::{DynamicArray};

type contract Speaker for both { fn int32 speak(); }

type value Cat implements Speaker {
    int32 volume;
    public ctor loud() { Cat c; c.volume = 9; return c; }
    public fn int32 speak() { return this.volume; }
}

type value Dog implements Speaker {
    public ctor quiet() { Dog d; return d; }
    public fn int32 speak() { return 1; }
}

// A generic FREE function — its body is a template too, instantiated per call.
fn T firstOr<T>(DynamicArray<T> xs, T fallback) {
    foreach (T x in xs) { return x; }
    return fallback;
}

fn int32 twice(int32 n) { return n + n; }

fn int32 main() {
    Cat c = Cat.loud();
    Dog d = Dog.quiet();
    int32 direct = c.speak() + d.speak();       // direct calls on the concrete types

    // Contract dispatch through an owned fat pointer — the vtbl path.
    Owned<Speaker> s = new Cat.loud();          // `new Type.ctor(...)` heap construction
    int32 viaContract = s.speak();              // dispatch through the contract, NOT the concrete type

    DynamicArray<int32> xs = DynamicArray.empty();
    xs.add(item: 4);                            // a method call on a library collection
    int32 got = firstOr(xs: xs, fallback: 0);   // generic free-function call

    int32 t = twice(n: 3);

    return direct + viaContract + got + t;
}
