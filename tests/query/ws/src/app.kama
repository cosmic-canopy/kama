// LSP M3.5 workspace-indexing fixture — the CONSUMING half (see widget.kama for why the pair exists).
// Three uses of `Widget` and one of `defaultSize`, none of them reachable from widget.kama.
import widget::{Widget, defaultSize};

fn Widget make(int32 n) {
    Widget w = Widget.of(size: n);
    return w;
}

fn int32 main() {
    Widget w = make(n: defaultSize());
    return w.size;
}
