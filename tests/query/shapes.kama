// LSP query-index fixture (M0 T4/T5) — exercised by tools/check-query.sh, NOT the main run_tests loop
// (that scans tests/*.kama, tests/*.d, tests/xfail only). Positions below are asserted by the harness, so
// keep the layout stable: line/column changes here mean updating check-query.sh.
// A file in a loose build's ROOT is in no module, so it is file-private (design/module-system.md §2e.27).

type value Point {
    public int32 x;
    public int32 y;   public ctor at(int32 x, int32 y) { this.x = x; this.y = y; }
}

type resource Widget {
    Point origin;
    public ctor make(Point at) { this.origin = at; }
    public fn int32 originX() { return this.origin.x; }
}

fn Point midpoint(Point a, Point b) {
    Point m = Point.at(x: 0, y: 0);
    m.x = (a.x + b.x) / 2;
    m.y = (a.y + b.y) / 2;
    return m;
}

fn int32 main() {
    Point p = Point.at(x: 0, y: 0);
    p.x = 4; p.y = 6;
    Widget w = Widget.make(at: p);
    return w.originX();
}
