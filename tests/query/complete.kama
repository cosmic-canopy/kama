// LSP completion fixture (M4) — exercised by tools/check-query.sh, NOT the main run_tests loop.
//
// Cursor positions are asserted by line:column, so KEEP THE LAYOUT STABLE and APPEND rather than insert.
// The trick that makes this work: every probe points at a cursor position INSIDE otherwise-valid source
// (the column of the character just after a `.`, or just inside a `(`), so the file still parses, analyzes
// clean, and the index is real — while the lexical scan sees exactly what it would see in a half-typed
// buffer. That is why this fixture must stay free of diagnostics: run `kama check` on it after any edit.
//
// Coverage, in order: the block-bearing statement kinds (the collectBindings under-cover guard — a local
// declared in each of Block / If / Else / While / DoWhile / For / ForEach / Unsafe / Scope / match arm),
// inheritance + visibility, a smart-pointer receiver, a generic-instance receiver, a generic type-param
// receiver, chained and call/index receivers, and the literal/comment suppression cases.
namespace completeprobe;

import std::collections::{DynamicArray};

type contract Sized for both { fn int32 size(); }

type value Cell implements Sized {
    public int32 value;
    private int32 secret;
    public fn int32 size() { return this.value; }
    public fn int32 doubled() { return this.value * 2; }
}

type virtual resource Base {
    int32 shared = 0;
    int32 hidden = 0;
    public ctor make() { slot Base b; return give b; }
    protected virtual fn int32 baseOnly() { return this.shared; }
}

type final resource Derived extends Base {
    int32 own = 0;
    public ctor make() { slot Derived d; return give d; }
    public fn int32 total() { return this.own + this.baseOnly(); }
}

type value Holder {
    public Cell cell;
    public fn Cell get() { return this.cell; }
}

type resource Node {
    int32 tag;
    public ctor make(int32 tag) { slot Node n; n.tag = tag; return give n; }
    public fn int32 read() { return this.tag; }
}

enum Level { Low, High }

fn int32 measure<T: Sized>(T item) {
    return item.size();
}

fn int32 blend(int32 lo, int32 hi) { return lo + hi; }

fn Holder makeHolder() { slot Holder h; return h; }

// The collectBindings under-cover guard. Every block-bearing statement kind declares a local of a type WITH
// members, and immediately reads one — so a probe at the column just after each `.` proves the walker
// descended into that statement kind. A miss here is silent in every other test: it just means fewer
// suggestions. (scanStmtForCollections has under-scanned `unsafe` and `scope` since it was written.)
fn int32 statements(int32 n) {
    slot Cell inBlock;
    int32 total = inBlock.value;
    {
        slot Cell inNested;
        total = total + inNested.value;
    }
    if (n > 0) {
        slot Cell inThen;
        total = total + inThen.value;
    } else {
        slot Cell inElse;
        total = total + inElse.value;
    }
    while (total < 0) {
        slot Cell inWhile;
        total = total + inWhile.value;
    }
    do {
        slot Cell inDo;
        total = total + inDo.value;
    } while (total < 0);
    for (int32 i = 0; i < 2; i = i + 1) {
        slot Cell inFor;
        total = total + inFor.value;
    }
    slot DynamicArray<Cell> nums;
    nums.add(item: inBlock);
    foreach (Cell each in nums) {
        slot Cell inForeach;
        total = total + each.value + inForeach.value;
    }
    unsafe {
        slot Cell inUnsafe;
        total = total + inUnsafe.value;
    }
    scope {
        slot Cell inScope;
        total = total + inScope.value;
    }
    Optional<Cell> maybe = Optional::Some(value: inBlock);
    int32 fromMatch = match (maybe) { case Some(value: bound): bound.value; case None: 0; };
    return total + fromMatch;
}

fn int32 receivers() {
    slot Cell c;
    c.value = 1;
    int32 direct = c.value + c.doubled();
    slot Holder h;
    int32 chained = h.cell.value;
    int32 viaCall = makeHolder().cell.value;
    int32 viaChain = makeHolder().get().value;
    slot DynamicArray<Cell> cells;
    cells.add(item: c);
    int32 viaIndex = cells[0].value;
    Owned<Node> owned = new Node.make(tag: 2);
    int32 viaOwned = owned.read();
    Owned<Derived> derived = new Derived.make();
    int32 inherited = derived.total();
    int32 labelled = blend(lo: 3, hi: 4);
    string text = "c.value is not code";
    string held = "interp ${c.value} hole";
    // comment c.value is not code either
    /* block c.value is not code either */
    char ch = 'c';
    return direct + chained + viaCall + viaChain + viaIndex + viaOwned + inherited + labelled;
}

fn int32 main() {
    slot Cell c;
    c.value = 5;
    int32 lvl = (Level::High == Level::Low) ? 1 : 0;
    return statements(n: 1) + receivers() + measure(item: c) + lvl;
}

// M4.2 — a `::` head is always a TYPE or a NAMESPACE (SPEC forbids `::` on a value). Appended AFTER main
// so every line number above stays valid; `scopes()` is never called, which analysis does not mind.
type value Stat implements Sized {
    public int32 n;
    public comptime int32 LIMIT = 7;
    public static fn int32 zero() { return 0; }
    public ctor of(int32 n) { slot Stat s; s.n = n; return give s; }
    public fn int32 size() { return this.n; }
}

fn int32 scopes() {
    int32 viaStatic = Stat::zero();
    int32 viaConst = Stat::LIMIT;
    int32 viaNs = completeprobe::blend(lo: 1, hi: 2);
    Stat made = Stat.of(n: 1);
    return viaStatic + viaConst + viaNs + made.size();
}

// M4.3 — a USER's own `extern` FFI binding must still complete (only LIBRARY C bindings are filtered).
extern fn int32 myOwnFfi(int32 x);

fn int32 bareNames(int32 seed) {
    slot Cell near;
    int32 far = near.value + seed;
    return far;
}

// M4.8 — `global::` names the ROOT scope explicitly: the same symbol as the bare spelling, reachable
// even where a local declaration shadows it. Its completion payoff is why the alias waited for an LSP.
fn int32 rootScope() {
    global::println(s: "root scope");                  // a FLOOR symbol, named explicitly
    return global::completeprobe::blend(lo: 1, hi: 2);  // ... and an absolute namespace path
}
