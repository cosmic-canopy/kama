// LSP M3.4 fixture (locals / params / fields / enum members) — exercised by tools/check-query.sh.
// NOT scanned by the main run_tests loop (that reads tests/*.kama, tests/*.d, tests/xfail).
//
// Deliberately covers every span shape the AST used to get wrong (measured 2026-07-27, see
// the grammar prerequisite): a name was precise ONLY when its production
// was the bare IDENTIFIER token. M3.4's STAMP_LOC pass fixed the rest, so each kind appears BOTH with and
// without an initializer/value to keep that fixed, and `shadow` is declared twice in sibling scopes so
// keys must be per-declaration, not per-name.
//
// Positions are asserted by the harness — keep the layout stable, and APPEND rather than insert.
namespace scopes;

type enum Code {
    Ok,          // no value  -> name span already precise
    Bad = 2      // `= value` -> end span currently swallows the value
}

type value Cfg {
    public int32 limit;        // no initializer -> precise
    public int32 scale = 3;    // initializer    -> end span currently swallows `= 3`

    public fn int32 scaled(int32 bias) {   // `bias` is a PARAM: both ends currently wrong
        return this.limit * this.scale + bias;   // `limit`/`scale` are field USES via MemberAccessNode
    }
}

fn int32 tally(int32 first, int32 second) {
    slot int32 plain;                      // no initializer -> precise
    int32 seeded = first + second;    // initializer -> end span currently swallows the initializer
    sum(a: seeded, b: first, into: out plain);
    return plain;
}

// Two `shadow` locals in SIBLING scopes: distinct symbols. Find-references on either must return only
// its own uses, and renaming one must not touch the other.
fn int32 shadowing(int32 n) {
    int32 acc = 0;
    {
        int32 shadow = n + 1;
        acc = acc + shadow;
    }
    {
        int32 shadow = n + 2;
        acc = acc + shadow;
    }
    return acc;
}

// Enum-member USES. `Code::Ok` is an expression use; the `match` arms are the ones that used to be
// invisible to the index (the AST held the arm name as a bare string), which would have made renaming a
// member rewrite the `Code::…` uses and silently leave `case Ok:` behind.
fn int32 classify(Code c) {
    Code seen = Code::Ok;
    int32 rank = match (c) {
        case Ok:  0;
        case Bad: 1;
    };
    return rank + cast<int32>(seen);
}

// A `foreach` loop variable is a local too, though it never enters the shadowing table.
fn int32 total(InlineArray<int32, 3> xs) {
    int32 sum = 0;
    foreach (int32 item in xs) {
        sum = sum + item;
    }
    return sum;
}

// Appended (see the header): the `out` callee that fills `plain` above, so its declaration can stay
// initializer-free — the shape the decl-span probes contrast against `seeded`.
fn void sum(int32 a, int32 b, out int32 into) { into = a + b; }
