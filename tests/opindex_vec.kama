// A generic, heap-owning, bounds-checked `Vec<T>` written entirely IN kama — the payoff of the
// stdlib prerequisites: `sizeof(T)` sizes the allocation, `panic`/`assert` guard the bounds, a
// place-returning `operator[]` gives `v[i] = x`, `Ptr<T>`+`unsafe` back the buffer, RAII frees it.
extern "<stdlib.h>";
extern fn Ptr malloc(usize n);
extern fn void free(Ptr p);

type resource Vec<T> {
    Ptr<T> data;
    int32 len;
    public ctor make(int32 n) { Vec<T> r;
        r.data = cast<Ptr<T>>(malloc(n: cast<usize>(n) * sizeof(T)));
        r.len = n;
     return give r; }
    public ref T operator[](int32 i) {
        if (i < 0) { panic(msg: "Vec: negative index"); }
        assert(cond: i < this.len, msg: "");
        unsafe { return this.data[i]; }
    }
    public fn int32 length() { return this.len; }
    ~Vec() { free(p: cast<Ptr>(this.data)); }
}
fn int32 main() {
    Vec<int32> v = Vec.make(n: 3);
    v[0] = 40;  v[1] = 2;  v[2] = 0;
    v[2] += 100;
    int32 s = 0;  int32 i = 0;
    while (i < v.length()) { s = s + v[i]; i = i + 1; }
    return s;   // 142; buffer freed by RAII (ASan-clean)
}
