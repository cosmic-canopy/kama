type value Account {
    int64 balance;
    public ctor make(int64 b) { slot Account r; r.balance = b; return give r; }
    friend readBalance[balance];     // a free function
    friend Bank[balance];            // a whole class
    friend Ledger::post[balance];    // a single method
}
fn int64 readBalance(ref Account a) { return a.balance; }   // free-fn friend reaches in
type value Bank {
    public fn int64 viaBank(ref Account a) { return a.balance; }   // any Bank method may
}
type value Ledger {
    public fn int64 post(ref Account a) { return a.balance; }      // granted method
}
fn int main() {
    Account acc = Account.make(b: 14);
    Bank bk = Bank();
    Ledger lg = Ledger();
    int64 total = readBalance(a: ref acc) + bk.viaBank(a: ref acc) + lg.post(a: ref acc);
    return cast<int>(total);   // 14 * 3 = 42
}
