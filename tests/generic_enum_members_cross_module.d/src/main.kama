import { genenumxm::opt::Tag, genenumxm::opt::Maybe };
type value Leaf implements Tag { public int32 v; public ctor of(int32 v) { this.v = v; } public fn int32 tag() { return this.v; } }
fn int32 main() {
    Maybe<Leaf> m = Maybe::Has(v: Leaf.of(v: 7));
    Tag t = m;
    return (m.has() ? 1 : 0) + t.tag();   // 1 + 107
}
