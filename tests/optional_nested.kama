fn uint8 main()
{
    Optional<int32> inner = Optional::Some(value: 5);
    Optional<Optional<int32>> outer = Optional::Some(value: inner);
    int32 r = match (outer) {
        case Some(value: o): match (o) { case Some(value: x): x; case None: -1; };
        case None: -2;
    };
    return cast<uint8>(r);
}
