// @generate(Serializable) on a value type -> exact JSON for scalar fields (ints, float, bool).
import { std::serialization::json::encodeJsonBuffer };
@generate(Serializable)
type value Vitals {
    @field int32 hp;
    @field int32 mp;
    @field float64 ratio;
    @field bool alive;
    public ctor make(int32 hp, int32 mp, float64 ratio, bool alive) {
        this.hp = hp; this.mp = mp; this.ratio = ratio; this.alive = alive;
    }
}
fn int32 main() {
    Vitals v = Vitals.make(hp: 100, mp: 0i32 - 5i32, ratio: 0.5, alive: true);
    Result<string, Owned<Error>> j_r = encodeJsonBuffer(v: v);
    string j = match (give j_r) { case Ok(value: __ok): give __ok; case Err(error: __e): { return 250; } };
    if (j == "{\"hp\":100,\"mp\":-5,\"ratio\":0.5,\"alive\":true}") { return 0; }
    isize n = j.length();
    if (n == 0) { return 255; }
    return cast<int32>(n);
}
