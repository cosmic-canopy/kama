// @generate(Serialize) on a value type -> exact JSON for scalar fields (ints, float, bool).
import std::serialization::json::{toString};
@generate(Serialize)
type value Vitals {
    @field int32 hp;
    @field int32 mp;
    @field float64 ratio;
    @field bool alive;
    public Vitals(int32 hp, int32 mp, float64 ratio, bool alive) {
        this.hp = hp; this.mp = mp; this.ratio = ratio; this.alive = alive;
    }
}
fn int main() {
    Vitals v = Vitals(hp: 100, mp: 0i32 - 5i32, ratio: 0.5, alive: true);
    string j = toString(v: v);
    if (j == "{\"hp\":100,\"mp\":-5,\"ratio\":0.5,\"alive\":true}") { return 0; }
    int32 n = cast<int32>(j.length());
    if (n == 0) { return 255; }
    return n;
}
