// Map under stress: many grows (rehash), heavy tombstoning, tombstone reclamation, and churn — the
// paths most likely to corrupt an open-addressing table. Verifies correctness throughout; ASan-clean.
import std::collections::{Map};
fn int main() {
    Map<int32, int32> m = Map.empty();
    int32 i = 0;
    while (i < 1000) { m.put(key: i, value: i * 3); i = i + 1; }   // ~7 grows

    int32 r = 0;
    r = r + (m.length() == 1000 ? 5 : 0);

    // every key resolves after all the rehashes
    int32 ok = 0; i = 0;
    while (i < 1000) {
        int32 v = match (m.get(key: i)) { case Some(value: x): x; case None: 0 - 1; };
        if (v == i * 3) { ok = ok + 1; }
        i = i + 1;
    }
    r = r + (ok == 1000 ? 5 : 0);

    // remove all evens -> 500 tombstones; odds must still probe correctly past them
    i = 0; while (i < 1000) { if (i % 2 == 0) { m.remove(key: i); } i = i + 1; }
    r = r + (m.length() == 500 ? 5 : 0);
    ok = 0; i = 1; while (i < 1000) {
        int32 v = match (m.get(key: i)) { case Some(value: x): x; case None: 0 - 1; };
        if (v == i * 3) { ok = ok + 1; }
        i = i + 2;
    }
    r = r + (ok == 500 ? 5 : 0);

    // re-insert the evens (reclaim tombstones) + push further to force a rehash that sheds them
    i = 0; while (i < 2000) { if (i >= 1000 || i % 2 == 0) { m.put(key: i, value: i * 3); } i = i + 1; }
    r = r + (m.length() == 2000 ? 6 : 0);

    // churn: remove then re-add the same key many times (tombstone create/reclaim in a loop)
    int32 c = 0; int32 churn = 0;
    while (c < 500) {
        int32 k = 42;
        m.remove(key: k);
        m.put(key: k, value: 123);
        int32 v = match (m.get(key: k)) { case Some(value: x): x; case None: 0 - 1; };
        if (v == 123) { churn = churn + 1; }
        c = c + 1;
    }
    r = r + (churn == 500 ? 5 : 0);

    // final: a spot key still correct, and clear empties it
    int32 f = match (m.get(key: 1999)) { case Some(value: x): x; case None: 0 - 1; };
    r = r + (f == 1999 * 3 ? 3 : 0);
    m.clear();
    r = r + (m.length() == 0 ? 3 : 0);
    return r;   // 5+5+5+5+6+5+3+3 = 37... will confirm
}
