// Object-graph round-trip: two owners share one leaf. Serializable writes the shared leaf ONCE into the id
// table (deduped by identity), both pointer fields referencing the same id; deserialize rebuilds the graph
// into a `Shared<Pair>` — the two-pass build re-shares the single leaf (`a` and `b` resolve to the same id),
// proven by a re-encodeJsonBuffer that reproduces the exact wire (and ASan proves the refcounts balance).
import { std::serialization::json::encodeJsonBuffer, std::serialization::json::decodeJsonBuffer, std::memory::Shared };

@generate(Serializable, Deserializable)
type resource Leaf { @field int32 v; public ctor make(int32 v) { this.v = v; } }

@generate(Serializable, Deserializable)
type resource Pair {
    @field Shared<Leaf> a;
    @field Shared<Leaf> b;
    public ctor make(Shared<Leaf> a, Shared<Leaf> b) { this.a = give a; this.b = give b; }
}

fn int32 main() {
    Shared<Leaf> leaf = new Leaf.make(v: 42);
    Shared<Leaf> l2 = leaf;                    // second owner of the SAME leaf
    Pair p = Pair.make(a: give leaf, b: give l2);
    Result<string, Owned<Error>> j_r = encodeJsonBuffer(v: p);
    string j = match (give j_r) { case Ok(value: __ok): give __ok; case Err(error: __e): { return 250; } };
    // root Pair = id 1; a and b share the leaf = id 2 (written once)
    if (j != "{\"root\":1,\"objects\":{\"1\":{\"__type\":\"Pair\",\"a\":2,\"b\":2},\"2\":{\"__type\":\"Leaf\",\"v\":42}}}") {
        return cast<int32>(j.length());
    }
    // Round-trip: decodeJsonBuffer into a Shared<Pair>, re-encodeJsonBuffer, and require the exact same wire (id dedup survived).
    Result<Shared<Pair>, Owned<Error>> res = decodeJsonBuffer::<Shared<Pair>>(src: copy j);
    match (res) {
        case Ok(value: sh): { Result<string, Owned<Error>> j2_r = encodeJsonBuffer(v: sh); string j2 = match (give j2_r) { case Ok(value: __ok): give __ok; case Err(error: __e): { return 1; } }; if (j2 == j) { return 0; } return 1; }
        case Err(error: e): { return 2; }
    };
    return 3;
}
