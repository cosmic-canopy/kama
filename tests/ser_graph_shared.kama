// Object-graph serialize: two owners share one leaf. The shared leaf is written ONCE into the id table
// (deduped by identity) and both pointer fields reference the same id. (Serialize side; the deserialize
// round-trip lands with graph read support.)
import std::serialization::json::{encode};
import std::memory::{Shared};

@generate(Serialize)
type resource Leaf { @field int32 v; public Leaf(int32 v) { this.v = v; } }

@generate(Serialize)
type resource Pair {
    @field Shared<Leaf> a;
    @field Shared<Leaf> b;
    public Pair(Shared<Leaf> a, Shared<Leaf> b) { this.a = give a; this.b = give b; }
}

fn int main() {
    Shared<Leaf> leaf = new Leaf(v: 42);
    Shared<Leaf> l2 = leaf;                    // second owner of the SAME leaf
    Pair p = Pair(a: give leaf, b: give l2);
    string j = encode(v: p);
    // root Pair = id 1; a and b share the leaf = id 2 (written once)
    if (j == "{\"root\":1,\"objects\":{\"1\":{\"__type\":\"Pair\",\"a\":2,\"b\":2},\"2\":{\"__type\":\"Leaf\",\"v\":42}}}") { return 0; }
    return cast<int32>(j.length());
}
