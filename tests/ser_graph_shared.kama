// Object-graph round-trip: two owners share one leaf. The library walker (`ObjectGraph<T>`) writes the shared
// leaf ONCE into the id table (deduped by identity), both pointer fields carrying the same id; deserialize
// rebuilds the graph and hands back the root — the two-pass read re-shares the single leaf (`a` and `b`
// resolve to one shell), proven by a re-encode that reproduces the exact wire (ASan proves the refcounts
// balance). The envelope is ordinary tokens: `{root, objects: [{id, type, value}]}`.
import { std::serialization::json::serializeJsonBuffer, std::serialization::json::deserializeJsonBuffer, std::memory::Shared, std::serialization::graph::ObjectGraph };

@generate(Serializable, Deserializable)
type resource Leaf { @field int32 v; public ctor make(int32 v) { this.v = v; } }

@generate(Serializable, Deserializable)
type resource Pair {
    @field Shared<Leaf> a;
    @field Shared<Leaf> b;
    public ctor make(Shared<Leaf> a, Shared<Leaf> b) { this.a = give a; this.b = give b; }
}

fn int32 main() {
    Shared<Leaf> leaf = new Leaf.make(v: 42);
    Shared<Leaf> l2 = leaf;                    // second owner of the SAME leaf
    Shared<Pair> p = new Pair.make(a: give leaf, b: give l2);
    ObjectGraph<Pair> og = ObjectGraph.of(root: give p);
    Result<string, Owned<Error>> j_r = serializeJsonBuffer(v: og);
    string j = match (give j_r) { case Ok(value: __ok): give __ok; case Err(error: __e): { return 250; } };
    // root Pair = id 1; a and b share the leaf = id 2 (written once)
    if (j != "{\"root\":1,\"objects\":[{\"id\":1,\"type\":\"Pair\",\"value\":{\"a\":2,\"b\":2}},{\"id\":2,\"type\":\"Leaf\",\"value\":{\"v\":42}}]}") {
        return cast<int32>(j.length());
    }
    // Round-trip: decode into a Shared<Pair>, re-encode, and require the exact same wire (id dedup survived).
    Result<ObjectGraph<Pair>, Owned<Error>> res = deserializeJsonBuffer::<ObjectGraph<Pair>>(src: copy j);
    match (res) {
        case Ok(value: sh): { Result<string, Owned<Error>> j2_r = serializeJsonBuffer(v: sh); string j2 = match (give j2_r) { case Ok(value: __ok): give __ok; case Err(error: __e): { return 1; } }; if (j2 == j) { return 0; } return 1; }
        case Err(error: e): { return 2; }
    };
    return 3;
}
