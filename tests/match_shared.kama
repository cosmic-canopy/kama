import std::memory::{Shared};
type resource Probe
{
    int32 id;
    public ctor make(int32 id) { slot Probe r; r.id = id; return give r; }
    ~Probe() { }
    public fn int32 val() { return this.id; }
}
enum Box { Full(Shared<Probe> p), Empty }
fn int main()
{
    Shared<Probe> s = new Probe.make(id: 42);
    Box a = Box::Full(p: copy s);
    Box e = Box::Empty;
    int32 v = match (a) {
        case Full(p: p): p.val();
        case Empty: 0;
    };
    int32 w = match (e) {
        case Full(p: p): p.val();
        case Empty: 7;
    };
    return v + w;
}
