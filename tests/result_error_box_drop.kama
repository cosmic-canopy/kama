// P2 drop-glue: an error enum OWNS a `Shared<Probe>` (a heap resource). Boxing it into `Owned<Error>` and
// then dropping the box must run `Enum__dtor` through the fat-handle vtbl `.__dtor`, dropping the Shared
// (and freeing the Probe). A leak or double-free surfaces only under container SAN.
extern "<stdlib.h>";
extern fn Ptr malloc(usize n);
extern fn void free(Ptr p);
type resource Probe {
    Ptr p;
    public ctor make() { Probe r; unsafe { r.p = malloc(n: 32); } return give r; }
    ~Probe() { unsafe { free(p: this.p); } }
    public fn int32 live() { return 1; }
}
enum LoadError { Missing, Wrapped(Shared<Probe> probe) }
implements Error for LoadError {
    public fn string message() { return match (this) { case Missing: "m"; case Wrapped(p): "w"; }; }
}
fn Result<int32, Owned<Error>> load(bool ok) {
    if (ok) { return Result::Ok(value: 5); }
    Shared<Probe> sp = new Probe.make();
    return Result::Err(error: LoadError::Wrapped(probe: give sp));   // box owns the Shared now
}
fn int32 use(Result<int32, Owned<Error>> r) {
    return match (r) { case Ok(v): v; case Err(e): { string m = e.message(); := cast<int32>(m.length()); } };
    // r (and its boxed error, and the Shared<Probe>, and the Probe) all drop here — leak-clean under SAN
}
fn int32 main() { return use(r: load(ok: true)) * 10 + use(r: load(ok: false)); }  // 5*10 + 1 = 51
