// Landing D: `serialize` is FALLIBLE (the write mirror of the fallible `deserialize` ctor). JSON can't
// represent a non-finite float, so encoding one surfaces `Err(SerError::NotRepresentable)` — never a
// half-written string — recovered via `err.as<SerError>()`. A finite value encodes to `Ok`.
import std::serialization::json::{encode};
@generate(Serialize)
type value Measure {
    @field float64 v;
    public ctor make(float64 v) { Measure r; r.v = v; return give r; }
}
fn int main() {
    // finite -> Ok
    Measure ok = Measure.make(v: 1.5);
    Result<string, Owned<Error>> okr = encode(v: ok);
    int32 okv = match (okr) { case Ok(s): 40; case Err(e): 0 - 1; };

    // non-finite (Inf via overflow) -> Err(NotRepresentable), recovered as a concrete SerError
    float64 big = 1.0e308; float64 inf = big * 10.0;
    Measure bad = Measure.make(v: inf);
    Result<string, Owned<Error>> badr = encode(v: bad);
    int32 errv = match (badr) {
        case Ok(s): 0 - 3;                                   // must NOT succeed
        case Err(e): match (e.as<SerError>()) {              // recover the concrete serialize error
            case Some(se): match (se) { case NotRepresentable: 100; case IoError: 0 - 4; };
            case None: 0 - 5;
        };
    };
    return okv + errv;   // 40 + 100 = 140
}
