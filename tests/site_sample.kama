// The code sample on the kama-lang.org home page. It lives here, as a fixture with an asserted
// exit code, so the front page's code is compiled and run by every leg of the test suite and
// cannot rot. tools/site/build.mjs reads this file verbatim.
enum ForgeError { TooFewFolds }
implements Error for ForgeError { public fn string message() { return "too few folds"; } }

type resource Blade                          // a resource moves; its fields stay private
{
    int32 folds;
    public ctor make(int32 folds) { Blade b; b.folds = folds; return give b; }
    public fn int32 sharpness() { return this.folds * 3; }
    ~Blade() { }                             // runs at end of scope — no GC, no runtime
}

fn Result<Blade, ForgeError> temper(string name, int32 folds)
{
    if (folds < 8) { return Result::Err(error: ForgeError::TooFewFolds); }
    println(s: "forging ${name} at ${folds} folds");
    return Result::Ok(value: Blade.make(folds: folds));
}

fn int main()
{
    return match (temper(name: "kama", folds: 12)) {   // named arguments; exhaustive match
        case Ok(value: blade): blade.sharpness();             // 36
        case Err(error: e):    1;
    };
}
