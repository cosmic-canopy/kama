// A `DynamicArray<string>` owns its OWNED string elements: `add(item: give s)` moves them in, by-value
// `foreach` yields owned copies (dropped each pass), and `~DynamicArray` frees each — ASan-clean is the proof.
// (A literal element mixes in fine — it is borrowed, cap==0, a no-op to drop.)
import { std::collections::DynamicArray };
fn int32 main() {
    DynamicArray<string> xs = DynamicArray.empty();
    string a = "ab" + ""; string b = "cde" + "";
    xs.add(item: give a);
    xs.add(item: give b);
    xs.add(item: "f");
    isize total = 0;
    foreach (string p in xs) { total = total + p.length(); }   // 2 + 3 + 1 = 6
    return cast<int32>(total);
}
