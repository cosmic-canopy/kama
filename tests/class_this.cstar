class Accum
{
    int total;
    public Accum(int init)
    {
        total = init;
    }
    public fn void bump()
    {
        this.total = this.total + 1;
    }
    public fn int run()
    {
        this.bump();
        return this.total;
    }
}
fn int main()
{
    Accum a = new Accum(init: 40);
    a.bump();
    return a.run();
}
