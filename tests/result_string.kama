enum DescribeErr { Fail }
implements Error for DescribeErr { public fn string message() { return "fail"; } }
fn int describe(int32 code)
{
    Result<int32, DescribeErr> r = code == 0 ? Result::Ok(value: 200) : Result::Err(error: DescribeErr::Fail);
    return match (r) { case Ok(value: v): v; case Err(error: e): cast<int32>(e.message().length()); };
}
fn int main() { return describe(code: 0) + describe(code: 1); }
