// A primitive LITERAL or an inline CONSTRUCTOR passed to a `const ref` parameter is materialized into a
// temp (an addressable lvalue) instead of being rejected — so `m.get(key: 5)` / `m.get(key: Point(1,2))`
// work without binding a local first (a `string` literal already did).
//
// ⚠️ `const` is the whole licence, and until `0.9.139` this file said "the temp is a read-only borrow
// here" and nothing checked it. The temp dies at the end of the statement, so a NON-const `ref` writes
// where nothing can read back; that is now rejected (tests/xfail/ref_literal_mutable). `Map.get`/`getRef`
// are `const ref K key` for that reason — they hand the key straight to `slotOf(const ref K key)` and
// never wrote it, which is exactly what the old `ref` spelling failed to say.
import { std::collections::Map };

type value Point implements Hashable, Equatable<This> {
    int32 x; int32 y;
    public ctor make(int32 x, int32 y) { this.x = x; this.y = y; }
    public const fn uint64 hash() { return cast<uint64>(this.x) * 31ui64 + cast<uint64>(this.y); }
    public const fn bool equals(const ref Point other) { return this.x == other.x && this.y == other.y; }
}

fn int32 main() {
    Map<int32, int32> m = Map.empty();
    m.put(key: 5, value: 50);
    int32 r = 0;
    int32 v = match (m.get(key: 5)) { case Some(value: x): x; case None: 0; };   // inline int literal key
    if (v == 50)            { r = r + 10; }
    if (m.contains(key: 5)) { r = r + 10; }                              // inline literal again

    Map<Point, int32> pm = Map.empty();
    Point origin = Point.make(x: 1, y: 2);
    pm.put(key: origin, value: 99);
    int32 pv = match (pm.get(key: Point.make(x: 1, y: 2))) { case Some(value: x): x; case None: 0; };  // inline ctor key
    if (pv == 99)                          { r = r + 10; }
    if (!pm.contains(key: Point.make(x: 9, y: 9))) { r = r + 12; }            // inline ctor, absent
    return r;   // 42
}
