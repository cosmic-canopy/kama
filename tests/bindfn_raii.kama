import { std::memory::Owned };
// M22 RAII: the bound object's destructor fires EXACTLY ONCE when the bindable
// drops. The moved-from Owned must NOT also drop it (trace fold a*31+code: one
// drop -> 9, a double drop -> 288).
extern fn void kama_trace(int32 code);
extern fn int32 kama_trace_get();
unsafe fn int32 traceGet() { return kama_trace_get(); }   // the FFI call, contained — `main` may not be `unsafe`
fnptr int32 Get(int32 d);
type resource Probe {
    int32 id;
    public ctor make(int32 id) { this.id = id; }
    unsafe ~Probe() { kama_trace(code: 9); }
    fn int32 read(int32 d) { return this.id + d; }
}
fn int32 use() {
    Owned<Probe> p = new Probe.make(id: 1);
    BindableFunctionPtr<Get> g = new BindableFunctionPtr<Get>(obj: p, method: Probe::read);
    return g(d: 41);                                 // 42; on exit g drops -> Probe::~ once
}
fn int32 main() {
    int32 r = use();
    return traceGet();                        // single dtor -> 9
}
