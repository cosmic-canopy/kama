// A fallible `ctor` result (called via the `::` bridge — inline dot-on-type ctor calls as a match subject
// are the A1 residual) can be a `match` subject inline (no typed-binding first), even when the Ok payload
// is a move-only resource. Returns 6.
enum WidgetErr { Negative }
implements Error for WidgetErr { public fn string message() { return "negative"; } }
type resource Widget {
    int32 id;
    private ctor fromId(int32 id) { Widget r; r.id = id; return give r; }
    public ctor Result<Widget, WidgetErr> make(int32 n) {
        if (n < 0) { return Result::Err(error: WidgetErr::Negative); }
        return Result::Ok(value: Widget.fromId(id: n));
    }
    public fn int32 value() { return this.id; }
    ~Widget() {}
}

fn int main() {
    int32 a = match (Widget::make(n: 7))     { case Ok(w): w.value(); case Err(e): 0 - 1; };  // 7
    int32 b = match (Widget::make(n: 0 - 5)) { case Ok(w): 100;       case Err(e): 0 - 1; };   // -1
    return a + b;                                                                              // 6
}
