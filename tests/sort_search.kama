// M2a: searching a sorted range. Rust folds found/insertion-point into `Result<usize, usize>`; kama's
// `Result<T, E>` constrains `E` to `Error`, so that spelling does not exist here — `binarySearch` answers
// "where is it" as an `Optional`, and `lowerBound` answers "where would it go" as a total `int32`.
import std::collections::{DynamicArray, View, sort, binarySearch, lowerBound};

fn int main() {
    DynamicArray<int32> xs = DynamicArray::<int32>.empty();
    xs.add(item: 10); xs.add(item: 20); xs.add(item: 20); xs.add(item: 30); xs.add(item: 40);
    View<int32> v = xs.view();
    sort(items: v);

    int32 t20 = 20;
    int32 t35 = 35;
    int32 t5  = 5;
    int32 t99 = 99;

    Optional<int32> f20 = binarySearch(items: v, target: t20);
    Optional<int32> f35 = binarySearch(items: v, target: t35);
    int32 a = match (f20) { case Some(value: i): i; case None: 99; };   // 1 — the FIRST of the duplicates
    int32 b = match (f35) { case Some(value: i): i; case None: 7; };    // 7 — absent

    int32 c = lowerBound(items: v, target: t35);   // 4 — first index whose element is >= 35
    int32 d = lowerBound(items: v, target: t5);    // 0 — before everything
    int32 e = lowerBound(items: v, target: t99);   // 5 — past the end
    int32 g = lowerBound(items: v, target: t20);   // 1 — first position a 20 could go

    return a + b + c + d + e + g;   // 1 + 7 + 4 + 0 + 5 + 1 = 18
}
