// M2a: searching a sorted range. Rust folds found/insertion-point into `Result<usize, usize>`; kama's
// `Result<T, E>` constrains `E` to `Error`, so that spelling does not exist here — `binarySearch` answers
// "where is it" as an `Optional`, and `lowerBound` answers "where would it go" as a total `int32`.
import std::collections::{DynamicArray, View, sort, binarySearch, lowerBound};

fn int32 main() {
    DynamicArray<int32> xs = DynamicArray::<int32>.empty();
    xs.add(item: 10); xs.add(item: 20); xs.add(item: 20); xs.add(item: 30); xs.add(item: 40);
    int32 a = 0; int32 b = 0; int32 c = 0; int32 d = 0; int32 e = 0; int32 g = 0;
    borrow xs.view() as v {
        sort(items: v);

        int32 t20 = 20;
        int32 t35 = 35;
        int32 t5  = 5;
        int32 t99 = 99;

        Optional<isize> f20 = binarySearch(items: v, target: t20);
        Optional<isize> f35 = binarySearch(items: v, target: t35);
        a = match (f20) { case Some(value: i): i; case None: 99; };   // 1 — the FIRST of the duplicates
        b = match (f35) { case Some(value: i): i; case None: 7; };    // 7 — absent

        c = cast<int32>(lowerBound(items: v, target: t35));   // 4 — first index whose element is >= 35
        d = cast<int32>(lowerBound(items: v, target: t5));    // 0 — before everything
        e = cast<int32>(lowerBound(items: v, target: t99));   // 5 — past the end
        g = cast<int32>(lowerBound(items: v, target: t20));   // 1 — first position a 20 could go
    }

    return a + b + c + d + e + g;   // 1 + 7 + 4 + 0 + 5 + 1 = 18
}
