// Milestone E — a method call on an OWNED rvalue RECEIVER used to leak. `make(n).length()` /
// `R().n()` materialize a fresh heap-owning receiver (a `DynamicArray`, a `resource`) that `.length()`/`.n()`
// only BORROW, and the temporary was never dropped (addrOfOperand's throwaway compound literal). It is
// now materialized into a scope-dtor'd temp and RAII-freed — a plain scope-drop, no lifetime tracking.
// Restricted to fresh by-value rvalues (operator / bare ctor / free-fn call), never a place/borrow, so it
// cannot double-free. Also pins the sound case: a fresh owned rvalue passed by value to an owning param is
// a move (the callee frees it once) — not a leak. Whole fixture is ASan/UBSan-clean.
import std::collections::{DynamicArray};

type resource R {
    DynamicArray<int32> xs;
    public ctor make() { slot R r; r.xs = DynamicArray.empty(); r.xs.add(item: 1); r.xs.add(item: 2); return give r; }
    public fn int32 n() { return this.xs.length(); }
}
fn DynamicArray<int32> make(int32 n) { DynamicArray<int32> xs = DynamicArray.empty(); xs.add(item: n); xs.add(item: n + 1); return give xs; }
fn int32 sumLen(DynamicArray<int32> a, DynamicArray<int32> b) { return a.length() + b.length(); }

fn int32 main() {
    int32 a = make(n: 1).length();                    // free-function-call owned receiver (was: leak)
    int32 b = R.make().n();                                // inline-ctor owned resource receiver (was: leak)
    int32 c = sumLen(a: make(n: 1), b: make(n: 5));   // owned rvalues moved into owning params (sound; guard)
    return a + b + c;   // 2 + 2 + (2 + 2) = 8
}
