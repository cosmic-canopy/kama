// The shape as reported: the constant is private to this PACKAGE's file, and the generic type that reads
// it is instantiated by the package that depends on it.
export { Box };

comptime int32 LIMIT = 7;

type resource Box<T> {
    T v;
    public ctor make(T v) { this.v = give v; }
    public fn int32 limit() { return LIMIT; }
}
