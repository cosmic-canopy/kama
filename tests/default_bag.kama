// Construction-model M6: `@generate(default)` synthesizes the bag's default `V.default()` on a transparent value, each
// field its own default else its type's: here every field is an `int32` with no initializer, so 0. A type may derive
// both `of` and `default`.
@generate(of, default)
type value Counters {
    public int32 a;
    public int32 b;
    public int32 c;
}

fn uint8 main() {
    Counters z = Counters.default();               // all fields zero
    Counters v = Counters.of(a: 1, b: 2, c: 3);
    return cast<uint8>(z.a + z.b + z.c + v.a + v.b + v.c);   // 0 + 6 = 6
}
