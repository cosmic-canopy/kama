// `Rc<T>` is a Copyable resource: `give a` MOVES (source consumed), `copy a` retains. A moved-from handle
// is not released (no double free).
extern "<stdlib.h>";
extern fn Ptr malloc(usize n);
extern fn void free(Ptr p);
type value Ctrl { public int32 strong; public int32 weak; }
type value Counter { public int32 n; public ctor make(int32 s){ Counter r; r.n=s; return give r; } }
type resource Rc<T> implements Deref<T>, HeapOwner<T>, Copyable(bare: copy) {
    Ptr<T> p; Ptr<Ctrl> c;
    public ctor make(Ptr<T> p, Ptr<Ctrl> c) { Rc<T> r; r.p = p; r.c = c; return give r; }
    public ctor adopt(Ptr<T> raw) { Ptr<Ctrl> k; unsafe { k = cast<Ptr<Ctrl>>(malloc(n: sizeof(Ctrl))); k[0].strong = 1; k[0].weak = 0; } return Rc.make(p: raw, c: k); }
    public fn ref T deref() { unsafe { return this.p[0]; } }
    public ctor copy(ref Rc<T> source) { unsafe { source.c[0].strong = source.c[0].strong + 1; } return Rc.make(p: source.p, c: source.c); }
    ~Rc() { unsafe { this.c[0].strong = this.c[0].strong - 1; if (this.c[0].strong == 0) { drop(value: this.deref()); free(p: cast<Ptr>(this.p)); if (this.c[0].weak == 0) { free(p: cast<Ptr>(this.c)); } } } }
}
fn int32 main() {
    Rc<Counter> a = new Counter.make(s: 5);
    Rc<Counter> b = give a;   // MOVE — a consumed, only b owns
    return b.n;               // 5
}
