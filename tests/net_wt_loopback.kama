// std::net::web WebTransport datagram E2E (browser) — connect to the aioquic HTTP/3 echo server
// (tests/support/wt_echo.py), whose self-signed certificate the browser accepts by the SHA-256 the program is handed as
// its argument (`WtConnection.connectPinned`), send a 4-byte datagram, receive the echo, verify, exit 55. WebTransport is
// browser-only (no node), so the suite runs this with `kama run --target WASM --headless -- <hash>`. std::app's run loop
// lets the asynchronous session and the round trip complete; on the web `run` never returns, so the app quits.
import { std::app::App, std::app::Lifecycle, std::app::run, std::app::quit,
         std::net::web::WtConnection, std::net::web::WtState, std::io::IoError, std::io::IoErrorKind,
         std::collections::DynamicArray, std::encoding::hex::decode, core::env::args };

type resource Echo implements App {
    WtConnection conn;
    bool sent;
    int32 ticks;
    public ctor make(WtConnection conn) { this.conn = give conn; this.sent = false; this.ticks = 0; }
    public fn bool tick() {
        this.ticks = this.ticks + 1;
        if (this.ticks > 2000000) { quit(code: 70); }                 // timeout
        WtState st = this.conn.state();
        if (st == WtState::Closed) { quit(code: 71); }                // closed, or the connection failed
        if (!this.sent) {
            if (st == WtState::Connected) {
                InlineArray<uint8>#(4) datagram = [10ui8, 20ui8, 30ui8, 40ui8];
                match (this.conn.send(bytes: datagram.view())) {
                    case Ok(value: n): { this.sent = true; }
                    case Err(error: e): { quit(code: 72); }
                };
            }
            return true;
        }
        InlineArray<uint8>#(64) buf = [0ui8; 64];
        match (this.conn.recv(into: buf.viewMut())) {
            case Ok(value: n): {
                bool ok = n == 4 && buf[0] == 10ui8 && buf[1] == 20ui8 && buf[2] == 30ui8 && buf[3] == 40ui8;
                quit(code: ok ? 55ui8 : 73ui8);
            }
            case Err(error: e): { if (e.kind() != IoErrorKind::WouldBlock) { quit(code: 74); } }
        };
        return true;
    }
    public fn void lifecycle(Lifecycle event) { }
}

fn uint8 main() {
    // The server's certificate hash, as hex: 32 bytes.
    string text = match (args().get(at: 0)) { case Some(value: s): give s; case None: ""; };
    InlineArray<uint8>#(32) hash = [0ui8; 32];
    match (decode(text: text)) {
        case Ok(value: bytes): {
            if (bytes.length() != 32) { return 61; }
            isize i = 0;
            while (i < 32) { hash[i] = bytes[i]; i = i + 1; }
        }
        case Err(error: e): { return 61; }
    };
    DynamicArray<InlineArray<uint8>#(32)> hashes = DynamicArray.empty();
    hashes.add(item: hash);
    string url = "https://127.0.0.1:47680/echo";
    match (WtConnection.connectPinned(url: url, certificateHashes: hashes.view())) {
        case Ok(value: conn): { Owned<App> app = new Echo.make(conn: give conn); run(app: give app); }   // never returns on the web
        case Err(error: e): { return 60; }
    };
    return 1;
}
