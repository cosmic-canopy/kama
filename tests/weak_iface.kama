// Weak POLYMORPHIC references — Rust's Weak<dyn Trait>. `RcWeak<Shape>` shares the control block with
// `Rc<Shape>` (both the fat {obj,vtbl,ctrl} representation); `a.downgrade()` and `w.tryUpgrade()` are
// compiler-provided for the contract case, mapping the library API onto the runtime IFACE conversions.
extern "<stdlib.h>";
extern fn UnsafePtr malloc(usize n);
extern fn void free(UnsafePtr p);
type value Ctrl { public int32 strong; public int32 weak; }
type contract Shape for value { fn int32 area(); }
type value Circle implements Shape { int32 r; public ctor make(int32 r){ this.r=r; } public fn int32 area(){return this.r*this.r;} }
type value Square implements Shape { int32 s; public ctor make(int32 s){ this.s=s; } public fn int32 area(){return this.s*this.s;} }

type resource RcWeak<T> {
    UnsafePtr<T> p; UnsafePtr<Ctrl> c;
    public ctor make(UnsafePtr<T> p, UnsafePtr<Ctrl> c) { this.p = p; this.c = c; }
    public unsafe fn Optional<Rc<T>> tryUpgrade() {
        if (this.c[0].strong > 0) { this.c[0].strong = this.c[0].strong + 1; return Optional::Some(value: Rc.make(p: this.p, c: this.c)); }
        return Optional::None;
    }
    unsafe ~RcWeak() { this.c[0].weak = this.c[0].weak - 1; if (this.c[0].strong == 0 && this.c[0].weak == 0) { free(p: cast<UnsafePtr>(this.c)); } }
}
type resource Rc<T> implements Deref<T>, HeapOwner<T>, Copyable<This>(bare: copy) {
    UnsafePtr<T> p; UnsafePtr<Ctrl> c;
    public ctor make(UnsafePtr<T> p, UnsafePtr<Ctrl> c) { this.p = p; this.c = c; }
    public unsafe ctor adopt(UnsafePtr<T> raw) { UnsafePtr<Ctrl> k = null; k = cast<UnsafePtr<Ctrl>>(malloc(n: sizeof(Ctrl))); k[0].strong = 1; k[0].weak = 0; return Rc.make(p: raw, c: k); }
    public unsafe fn ref T deref() { return this.p[0]; }
    public unsafe ctor copy(ref Rc<T> source) { source.c[0].strong = source.c[0].strong + 1; return Rc.make(p: source.p, c: source.c); }
    public unsafe fn RcWeak<T> downgrade() { this.c[0].weak = this.c[0].weak + 1; return RcWeak.make(p: this.p, c: this.c); }
    unsafe ~Rc() { this.c[0].strong = this.c[0].strong - 1; if (this.c[0].strong == 0) { drop(value: this.deref()); free(p: cast<UnsafePtr>(this.p)); if (this.c[0].weak == 0) { free(p: cast<UnsafePtr>(this.c)); } } }
}

fn RcWeak<Shape> makeExpired() {
    Rc<Shape> a = new Circle.make(r: 10);
    return a.downgrade();   // `a` drops on return -> object freed -> expired weak
}
fn int32 main() {
    Rc<Shape> a = new Circle.make(r: 5);
    RcWeak<Shape> w = a.downgrade();
    Optional<Rc<Shape>> o1 = w.tryUpgrade();
    int32 alive = match (o1) { case Some(value: r): r.area(); case None: -1; };   // 25 (a alive)

    RcWeak<Shape> dead = makeExpired();
    Optional<Rc<Shape>> o2 = dead.tryUpgrade();
    int32 expired = match (o2) { case Some(value: r): r.area(); case None: 90; }; // 90 (expired)

    return alive + expired;   // 115
}
