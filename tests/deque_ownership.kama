// M2 — Deque<T> across the full ownership spectrum, proving a container is agnostic to how its element
// owns: a VALUE lives inline (borrow it in place with `ref`), an `Owned<T>` moves out intact on pop, a
// `Shared<T>` retains on `copy` / transfers on move (shared ownership survives the pop), and a `Weak<T>`
// handle round-trips through the deque and still upgrades. The deque never boxes the element — the element
// type carries its own ownership, so no `Owned` wrapper is imposed by the container.
import std::collections::{Deque};
@generate(of)
type value Cell { public int32 v; }

fn int32 main() {
    int32 r = 0;

    // (1) VALUE elements stored inline; `operator[]` returns `ref Cell`, so a write goes THROUGH the borrow
    // (no move, no copy — the stack/in-place path).
    Deque<Cell> vals = Deque.empty();
    vals.pushBack(item: Cell.of(v: 1)); vals.pushBack(item: Cell.of(v: 2));
    vals[0].v = 40;
    if (vals[0].v == 40) { r = r + 10; }

    // (2) OWNED elements: pop moves the `Owned<Cell>` OUT intact; the remainder drop in ~Deque (ASan gate).
    Deque<Owned<Cell>> owned = Deque.empty();
    owned.pushBack(item: new Cell.of(v: 7)); owned.pushBack(item: new Cell.of(v: 8));
    Optional<Owned<Cell>> po = owned.popFront();
    int32 ov = match (po) { case Some(p): p.v; case None: 0 - 1; };   // Deref forwards `.v` on the moved-out Owned
    if (ov == 7 && owned.length() == 1) { r = r + 10; }

    // (3) SHARED elements: a bare `copy` retains (refcount) into the deque, move transfers the handle out;
    // the original handle is still valid after the pop (shared ownership).
    Deque<Shared<Cell>> shared = Deque.empty();
    Shared<Cell> sc = new Cell.of(v: 5);
    shared.pushBack(item: copy sc);
    shared.pushBack(item: new Cell.of(v: 6));
    Optional<Shared<Cell>> ps = shared.popFront();
    int32 sv = match (ps) { case Some(p): p.v; case None: 0 - 1; };
    if (sv == 5 && sc.v == 5) { r = r + 10; }

    // (4) WEAK elements: a deque of weak handles upgrades while the owning Shared is alive.
    Shared<Cell> keep = new Cell.of(v: 9);
    Deque<Weak<Cell>> weaks = Deque.empty();
    weaks.pushBack(item: keep.downgrade());
    int32 wv = match (weaks[0].tryUpgrade()) { case Some(s): s.v; case None: 0 - 1; };
    if (wv == 9) { r = r + 10; }

    return r;   // 40
}
