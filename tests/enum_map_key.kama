// A payload-less enum as a `Map` key, by declaring `implements` and writing the two methods by hand.
// The counterpart is now tests/generate_plain_enum, which asks for the SAME two contracts with
// `@generate(Equatable, Hashable)` and gets the derived bodies — both roads go through the same
// promotion to a variant ClassInfo, which is the whole reason `@generate` on such an enum could stop
// being refused. This one pins the hand-written road: a derive must never be the only way in.
import { std::collections::Map };

type enum Color implements Hashable, Equatable<This> {
    Red, Green, Blue;

    public const fn uint64 hash() { return match (this) { case Red: 0ui64; case Green: 1ui64; case Blue: 2ui64; }; }

    public const fn bool equals(const ref Color other) { return this.hash() == other.hash(); }
}

fn int32 main() {
    Map<Color, int32> m = Map.empty();
    m.put(key: Color::Red,  value: 5);
    m.put(key: Color::Blue, value: 9);
    int32 a = match (m.get(key: Color::Red))  { case Some(value: x): x; case None: 0; };
    int32 b = match (m.get(key: Color::Blue)) { case Some(value: x): x; case None: 0; };
    return a + b + cast<int32>(m.length());   // 5 + 9 + 2 = 16
}
