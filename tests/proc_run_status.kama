// std::process — run the helper `exit 0` and `exit 1` via run() (spawn + concurrent stdout/stderr drain +
// wait). Proves the spawn/exec/pipe path + ExitStatus.success()/code. Returns 42 on success.
import std::process::{Command, Output, ExitStatus};
import std::io::{IoError};

fn int main() {
    Command t = Command.make(program: envOr(name: "KAMA_PROCUTIL", dflt: "procutil"));
    t.arg(a: "exit"); t.arg(a: "0");
    Result<Output, IoError> tr = t.run();
    int32 a = match (give tr) {
        case Ok(value: o): (o.status().success() ? 0 : 91);
        case Err(error: e): 92;
    };
    if (a != 0) { return a; }

    Command f = Command.make(program: envOr(name: "KAMA_PROCUTIL", dflt: "procutil"));
    f.arg(a: "exit"); f.arg(a: "1");
    Result<Output, IoError> fr = f.run();
    int32 b = match (give fr) {
        case Ok(value: o): ((o.status().code == 1) ? 0 : 93);
        case Err(error: e): 94;
    };
    if (b != 0) { return b; }
    return 42;
}
