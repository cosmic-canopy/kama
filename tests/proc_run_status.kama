// std::process — run the helper `exit 0` and `exit 1` via run() (spawn + concurrent stdout/stderr drain +
// wait). Proves the spawn/exec/pipe path + ExitStatus.success()/code. Returns 42 on success.
import { core::envOr, std::process::Command, std::process::Output, std::process::ExitStatus, std::io::IoError };

// The exit code, or -1 when the child did not exit (a signal): `ExitStatus` is a per-platform enum (`uint8` code on
// POSIX, `uint32` on Windows), read with `match` — widened here so one comparison serves both.
fn int64 codeOf(ExitStatus s) { return match (s) { case Exited(code: c): cast<int64>(c); case _: -1; }; }

fn int32 main() {
    Command t = Command.make(program: envOr(name: "KAMA_PROCUTIL", dflt: "procutil"));
    t.arg(a: "exit"); t.arg(a: "0");
    Result<Output, IoError> tr = t.run();
    int32 a = match (give tr) {
        case Ok(value: o): (o.status().success() ? 0 : 91);
        case Err(error: e): 92;
    };
    if (a != 0) { return a; }

    Command f = Command.make(program: envOr(name: "KAMA_PROCUTIL", dflt: "procutil"));
    f.arg(a: "exit"); f.arg(a: "1");
    Result<Output, IoError> fr = f.run();
    int32 b = match (give fr) {
        case Ok(value: o): ((codeOf(s: o.status()) == 1) ? 0 : 93);
        case Err(error: e): 94;
    };
    if (b != 0) { return b; }
    return 42;
}
