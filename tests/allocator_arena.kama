// M10 custom allocator — the arena round-trip (the ASan-critical case). One caller-owned `Arena`
// backs BOTH a `DynamicArray` and a `Map` (proving several containers share one region). The `Map`
// uses the NAMED type-arg override `A: BumpAllocator` to skip the defaulted hasher `H`. ASan-clean =
// exactly one malloc (the Arena buffer) + one free (its dtor); every container `deallocate` is a
// no-op, so no leak and no double-free. `arena` is declared FIRST so it drops LAST (outlives them).
import {
    std::collections::DynamicArray,
    std::collections::Map,
    std::collections::Arena,
    std::collections::BumpAllocator,
};

fn int32 main() {
    int32 r = 0;
    Arena arena = Arena.make(capacity: 65536);                              // 64 KiB caller-owned region

    // A DynamicArray drawing from the arena — force several grows (all in-arena).
    DynamicArray<int32, BumpAllocator> xs = DynamicArray.withAllocator(allocator: arena.handle());
    int32 i = 0; while (i < 200) { xs.add(item: i * i); i = i + 1; }
    if (xs.length() == 200 && xs[199] == 199 * 199) { r = r + 20; }

    // A Map from the SAME arena (named override skips the defaulted H) — force rehash grows.
    Map<int32, int32, A: BumpAllocator> m = Map.withAllocator(allocator: arena.handle());
    i = 0; while (i < 100) { m.put(key: i, value: i + 1); i = i + 1; }
    Optional<int32> o = m.get(key: 50);
    int32 v = match (o) { case Some(value: x): x; case None: 0 - 1; };
    if (m.length() == 100 && v == 51) { r = r + 20; }

    return r;   // 40
}
