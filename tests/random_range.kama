// std::random — the two bounded draws. `range(rng:, lo:, hi:)` is ONE generic spelling over every
// numeric width (int32 from literals, isize from typed locals, uint8, float32/float64, and the extreme
// signed span that a naive `hi - lo` would trap on); `below(n:)` is the index draw that takes a length
// directly. Every draw stays inside its half-open range, and a narrow range reaches both of its ends.
// Eight flags sum to 255.
import { std::random::Rng, std::random::range, std::collections::DynamicArray,
         std::num::int64Min, std::num::int64Max };

fn int32 main() {
    int32 r = 0;
    Rng g = Rng.seeded(seed: 2024ui64);
    isize i = 0;

    // int32 from two literals: a die, [1, 7). Both 1 and 6 must show up in a thousand rolls.
    bool inBounds = true;
    bool sawLo = false;
    bool sawHi = false;
    i = 0;
    while (i < 1000) {
        int32 d = range(rng: g, lo: 1, hi: 7);
        if (d < 1 || d > 6) { inBounds = false; }
        if (d == 1) { sawLo = true; }
        if (d == 6) { sawHi = true; }
        i = i + 1;
    }
    if (inBounds && sawLo && sawHi)                            { r = r + 1; }

    // isize from two typed locals: the shape a size takes (a bare literal would infer int32).
    isize lo = 0;
    isize hi = 3;
    int32 seen0 = 0; int32 seen1 = 0; int32 seen2 = 0;
    bool sizeOk = true;
    i = 0;
    while (i < 300) {
        isize k = range(rng: g, lo: lo, hi: hi);
        if (k == 0) { seen0 = seen0 + 1; } else if (k == 1) { seen1 = seen1 + 1; } else if (k == 2) { seen2 = seen2 + 1; } else { sizeOk = false; }
        i = i + 1;
    }
    if (sizeOk && seen0 > 0 && seen1 > 0 && seen2 > 0)         { r = r + 2; }

    // uint8, at the top of its width: [250, 255).
    bool byteOk = true;
    i = 0;
    while (i < 300) {
        uint8 b = range(rng: g, lo: 250ui8, hi: 255ui8);
        if (b < 250ui8 || b > 254ui8) { byteOk = false; }
        i = i + 1;
    }
    if (byteOk)                                                { r = r + 4; }

    // float64 [-1, 1) and float32 [0, 1): never `hi`, never below `lo`.
    bool f64Ok = true;
    bool f32Ok = true;
    i = 0;
    while (i < 1000) {
        float64 x = range(rng: g, lo: -1.0, hi: 1.0);
        float32 y = range(rng: g, lo: 0.0f32, hi: 1.0f32);
        if (x < -1.0 || x >= 1.0)         { f64Ok = false; }
        if (y < 0.0f32 || y >= 1.0f32)    { f32Ok = false; }
        i = i + 1;
    }
    if (f64Ok && f32Ok)                                        { r = r + 8; }

    // `below` takes a length straight from the collection, and a literal; n = 1 is always 0.
    DynamicArray<int32> xs = DynamicArray::<int32>.empty();
    xs.add(item: 10); xs.add(item: 20); xs.add(item: 30); xs.add(item: 40); xs.add(item: 50);
    bool belowOk = true;
    i = 0;
    while (i < 200) {
        isize j = g.below(n: xs.length());
        if (j < 0 || j >= 5) { belowOk = false; }
        if (g.below(n: 6) >= 6) { belowOk = false; }
        if (g.below(n: 1) != 0) { belowOk = false; }
        i = i + 1;
    }
    if (belowOk)                                               { r = r + 16; }

    // The extreme signed span: [int64Min, int64Max) has 2^64 - 1 values, and `hi - lo` would trap.
    // A hundred draws with no trap, landing on both signs, is the proof the wrapping arithmetic holds.
    int64 wideLo = int64Min();
    int64 wideHi = int64Max();
    bool sawNeg = false;
    bool sawPos = false;
    i = 0;
    while (i < 100) {
        int64 w = range(rng: g, lo: wideLo, hi: wideHi);
        if (w < 0i64) { sawNeg = true; } else { sawPos = true; }
        i = i + 1;
    }
    if (sawNeg && sawPos)                                      { r = r + 32; }

    // A 2-wide range reaches both ends, and never a third value.
    bool twoOk = true;
    bool saw10 = false;
    bool saw11 = false;
    i = 0;
    while (i < 100) {
        int32 t = range(rng: g, lo: 10, hi: 12);
        if (t == 10) { saw10 = true; } else if (t == 11) { saw11 = true; } else { twoOk = false; }
        i = i + 1;
    }
    if (twoOk && saw10 && saw11)                               { r = r + 64; }

    // The full unsigned width (a literal above int64Max reaching a generic `T` — `generic_wide_literal`
    // pins that on its own), and a usize: neither traps, both stay in range.
    usize slo = 5;
    usize shi = 8;
    bool wideOk = true;
    i = 0;
    while (i < 100) {
        uint64 u = range(rng: g, lo: 1ui64, hi: 18446744073709551615ui64);
        usize s = range(rng: g, lo: slo, hi: shi);
        if (u < 1ui64) { wideOk = false; }
        if (s < 5ui64 || s > 7ui64) { wideOk = false; }
        i = i + 1;
    }
    if (wideOk)                                                { r = r + 128; }

    return r;   // 255
}
