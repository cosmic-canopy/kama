// Compound assignment through a subscript must evaluate the index expression exactly ONCE (a single
// bounds-checked lookup), not twice (a read then a separate write). We prove it with a side-effecting
// index: idx() records one trace event per call (acc = acc*31 + code), so a single evaluation leaves the
// accumulator at 1, while a double evaluation would leave it at 32.
extern fn void kama_trace(int code);
extern fn int kama_trace_get();

fn int32 idx() { kama_trace(code: 1); return 1; }   // side effect: one event; returns index 1

fn int32 main() {
    InlineArray<int32, 3> a = [10, 20, 30];
    a[idx()] += 5;                                  // a[1] -> 25; idx() must run exactly once
    // 42 iff the element updated once AND the index was evaluated exactly once (trace acc == 1).
    return (a[1] == 25 && kama_trace_get() == 1) ? 42 : 0;
}
