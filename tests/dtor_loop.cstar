extern fn void cstar_trace(int code);
extern fn int cstar_trace_get();

type resource Res
{
    int id;
    public Res(int id) { this.id = id; }
    ~Res() { cstar_trace(code: id); }
}

fn int f()
{
    Res outer = Res(id: 1);
    while (true)
    {
        Res inner = Res(id: 2);
        break;
    }
    return 0;
}

fn int main()
{
    int r = f();
    return cstar_trace_get();
}
