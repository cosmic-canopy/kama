// Field ADDRESSING: every `@field` carries a name AND an id. `id` defaults to the declaration index and an
// author may override it with a stable, sparse protobuf-style number; the derive emits fields in ASCENDING
// ID, which is what makes ids and positions one thing — a positional backend keeps this order, a numbered
// one keeps the values. A named backend (JSON here) writes the name and ignores the id, so it is the
// EMISSION ORDER that shows the ids took effect.
//
// Also pins `@deprecated`: read when present, never written. Its name and id stay reserved (it still takes
// part in duplicate detection), so a stream written by an older version still decodes.
import { std::serialization::json::serializeJsonBuffer, std::serialization::json::deserializeJsonBuffer };

@generate(Serializable, Deserializable)
type value Rec {
    @field(id: 20) public int32 a;                 // declared first, emitted LAST
    @field(id: 10) public int32 b;
    @field @deprecated public int32 old;           // still read, never written
    public ctor make(int32 a, int32 b, int32 old) { this.a = a; this.b = b; this.old = old; }
}

fn int32 main() {
    Result<string, Owned<Error>> j = serializeJsonBuffer(v: Rec.make(a: 1, b: 2, old: 9));
    string s = match (give j) { case Ok(value: v): give v; case Err(error: e): { return 250; } };
    // ascending id, and the deprecated field is absent
    if (!s.equals(other: "{\"b\":2,\"a\":1}")) { return 251; }

    // an OLD stream still carries `old` — a deprecated field is READ
    Result<Rec, Owned<Error>> d = deserializeJsonBuffer::<Rec>(src: "{\"b\":2,\"a\":1,\"old\":7}");
    int32 got = match (d) { case Ok(value: q): q.old + q.a + q.b; case Err(error: e): 0 - 1; };
    if (got != 10) { return 252; }          // 7 + 1 + 2

    // an unknown key still skips cleanly (the named backend's forward compatibility, unchanged)
    Result<Rec, Owned<Error>> u = deserializeJsonBuffer::<Rec>(src: "{\"b\":5,\"zz\":99,\"a\":4}");
    int32 uv = match (u) { case Ok(value: q): q.a + q.b; case Err(error: e): 0 - 1; };
    if (uv != 9) { return 253; }
    return 42;
}
