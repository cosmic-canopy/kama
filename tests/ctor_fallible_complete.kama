import std::memory::{Owned};
// Construction-model M3: complete-init is enforced on FALLIBLE ctors too. `make` returns `Result<Holder,E>`:
// `Err` before the object exists (no completeness obligation), or `Ok(value: h)` where `h` must be fully
// built — the checker unwraps the `Ok` and verifies the wrapped object's owning fields are all set.
enum HolderErr { Negative }
implements Error for HolderErr { public fn string message() { return "negative"; } }
type value Box {
    int32 v;
    public ctor make(int32 v) { Box r; r.v = v; return give r; }
    public fn int32 get() { return this.v; }
}
type resource Holder {
    Owned<Box> a;
    public ctor Result<Holder, HolderErr> make(int32 v) {
        if (v < 0) { return Result::Err(error: HolderErr::Negative); }   // fail before the object exists
        Owned<Box> b = new Box.make(v: v);
        Holder h;
        h.a = give b;                                    // complete before Ok-wrapping
        return Result::Ok(value: h);
    }
    public fn int32 get() { return this.a.get(); }
}
fn int32 main() {
    Result<Holder, HolderErr> ok  = Holder.make(v: 42);
    Result<Holder, HolderErr> bad = Holder.make(v: -5);
    int32 a = match (ok)  { case Ok(h): h.get(); case Err(e): 0 - 1; };   // 42
    int32 b = match (bad) { case Ok(h): 100;     case Err(e): 0 - 1; };   // -1
    return a + b + 1;   // 42 - 1 + 1 = 42
}
