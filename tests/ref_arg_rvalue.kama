// A class RVALUE (a factory / call result) passed to a `const ref` parameter is materialized
// into a scope-dtor'd temp instead of emitting `&(rvalue)` (illegal C). The borrow is read-only
// and freed at scope end. A non-const `ref` rvalue is rejected instead (see xfail). ROADMAP §2.
type value Vec2 {
    int32 x; int32 y;
    public ctor make(int32 x, int32 y) { Vec2 r; r.x = x; r.y = y; return give r; }
    public const fn int32 sum() { return this.x + this.y; }
}
fn Vec2 makeVec(int32 x, int32 y) { return Vec2.make(x: x, y: y); }
fn int32 readVec(const ref Vec2 v) { return v.sum(); }

fn int32 main() {
    int32 a = readVec(v: makeVec(x: 30, y: 12));   // rvalue factory result -> const ref: 42
    Vec2 named = Vec2.make(x: 1, y: 2);
    int32 b = readVec(v: ref named);               // named lvalue path unchanged: 3
    return a - b + 3;                              // 42 - 3 + 3 = 42
}
