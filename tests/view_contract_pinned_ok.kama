// A `type view` MAY implement a pinned contract (`type contract C<S is This>`). The escape rule fires
// only on a self-CONSTRUCTING slot with nothing borrowable in its parameter list; these three shapes stay
// legal, and this fixture is the guard that they do:
//
//   * a `ctor` slot whose parameters DO carry the borrow (`UnsafePtr<int64> p`)  -> `over`
//   * an INSTANCE method returning the self-type, which borrows `this`     -> `rest` (the `Real<T is This>`
//     shape, and the same reason `View.slice()` is legal)
//   * an UNPINNED generic contract, whose slots return some other type     -> `Iterable<T>` on `View<T>`
//
// The rejected counterpart is `xfail/view_contract_ctor_escape.kama`.
//
// A view exists only relative to the type it views, so the buffer's OWNER is what hands one out: `Buf`
// holds the storage and `Buf.span()` is the single place the raw `addr(of:)` lives. `main` never sees a
// raw pointer, which is why it needs no `unsafe` — and `main` may not be `unsafe` in any case, since it
// encloses the whole program.
import std::collections::{DynamicArray, View};

type contract Windowed<S is This> for value, view {
    fn int32 length();
    fn S rest();                             // instance method: borrows the receiver — always legal
    ctor S over(UnsafePtr<int64> p, int32 n);      // a self-constructing ctor WITH a borrow source — legal
}

type view Span implements Windowed<This> {
    UnsafePtr<int64> p; int32 n;

    unsafe ctor over(UnsafePtr<int64> p, int32 n) { this.p = p; this.n = n; }
    public fn int32 length() { return this.n; }
    public unsafe fn int64 at(int32 i) { return this.p[i]; }
    // Returns a view over `this`'s buffer — roots at `this`, so the return escape check accepts it.
    public unsafe fn Span rest() { return Span.over(p: addr(of: this.p[1]), n: this.n - 1); }
}

// The owner of the memory. `Spanned` is how it DECLARES that its storage is what a `Span` views — which
// is what entitles `span()` to mint one, since a view's constructor is private.
@viewable type contract Spanned<S> for resource { fn S span(); }

type resource Buf implements Spanned<Span> {
    DynamicArray<int64> a;

    public ctor empty() { this.a = DynamicArray.empty(); }
    public fn void add(int64 v) { this.a.add(item: v); }
    public unsafe fn Span span() { return Span.over(p: addr(of: this.a[0]), n: cast<int32>(this.a.length())); }
}

fn int32 main() {
    int32 r = 0;

    Buf buf = Buf.empty();
    buf.add(v: 7i64); buf.add(v: 8i64); buf.add(v: 9i64);

    // A user's own mint opens a window through its own grant — nothing here is named `view`.
    borrow buf.span() as s {
        if (s.length() == 3 && s.at(i: 0) == 7i64) { r = r + 1; }    // 1
        Span t = s.rest();                                           // a DERIVE off the alias — no window
        if (t.length() == 2 && t.at(i: 0) == 8i64) { r = r + 1; }    // 2
    }

    // The unpinned-contract path is untouched: `View<T>` implements `Iterable<T>`/`IterableMut<T>`.
    DynamicArray<int32> b = DynamicArray.empty();
    b.add(item: 1); b.add(item: 2);
    borrow b.view() as v {
        if (v.length() == 2) { r = r + 1; }                              // 3
    }

    return r;   // 3
}
