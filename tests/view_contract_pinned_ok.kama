// A `type view` MAY implement a pinned contract (`type contract C<S is This>`). The escape rule fires
// only on a self-CONSTRUCTING slot with nothing borrowable in its parameter list; these three shapes stay
// legal, and this fixture is the guard that they do:
//
//   * a `ctor` slot whose parameters DO carry the borrow (`Ptr<int64> p`)  -> `over`
//   * an INSTANCE method returning the self-type, which borrows `this`     -> `rest` (the `Real<T is This>`
//     shape, and the same reason `View.slice()` is legal)
//   * an UNPINNED generic contract, whose slots return some other type     -> `Iterable<T>` on `View<T>`
//
// The rejected counterpart is `xfail/view_contract_ctor_escape.kama`.
import std::collections::{DynamicArray, View};

type contract Windowed<S is This> for value {
    fn int32 length();
    fn S rest();                             // instance method: borrows the receiver — always legal
    ctor S over(Ptr<int64> p, int32 n);      // a self-constructing ctor WITH a borrow source — legal
}

type view Span implements Windowed<This> {
    Ptr<int64> p; int32 n;

    public ctor over(Ptr<int64> p, int32 n) { this.p = p; this.n = n; }
    public fn int32 length() { return this.n; }
    public fn int64 at(int32 i) { unsafe { return this.p[i]; } }
    // Returns a view over `this`'s buffer — roots at `this`, so the return escape check accepts it.
    public fn Span rest() { unsafe { return Span.over(p: addr(of: this.p[1]), n: this.n - 1); } }
}

fn int32 main() {
    int32 r = 0;

    DynamicArray<int64> a = DynamicArray.empty();
    a.add(item: 7i64); a.add(item: 8i64); a.add(item: 9i64);

    unsafe {
        Span s = Span.over(p: addr(of: a[0]), n: 3);
        if (s.length() == 3 && s.at(i: 0) == 7i64) { r = r + 1; }        // 1
        Span t = s.rest();
        if (t.length() == 2 && t.at(i: 0) == 8i64) { r = r + 1; }        // 2
    }

    // The unpinned-contract path is untouched: `View<T>` implements `Iterable<T>`/`IterableMut<T>`.
    DynamicArray<int32> b = DynamicArray.empty();
    b.add(item: 1); b.add(item: 2);
    View<int32> v = b.view();
    if (v.length() == 2) { r = r + 1; }                                  // 3

    return r;   // 3
}
