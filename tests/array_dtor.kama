// Element-dtor chaining: an FixedArray<Probe> of destructible elements must run
// Probe's destructor on every live element when the array leaves scope (RAII),
// then free the buffer. Each element dtor traces a constant code; the trace
// fold proves exactly `size` dtor calls fired.
import std::collections::{FixedArray};
extern fn void kama_trace(int code);
extern fn int kama_trace_get();
unsafe fn int traceGet() { return kama_trace_get(); }   // the FFI call, contained — `main` may not be `unsafe`

type resource Probe
{
    int id;
    unsafe ~Probe() { kama_trace(code: 5); }
}

fn int build()
{
    FixedArray<Probe> a = FixedArray.make(size: 3);
    return 0;   // `a` drops here -> Array_Probe__dtor -> 3x Probe__dtor
}

fn int main()
{
    int r = build();
    return traceGet();
}
