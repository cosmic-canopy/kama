// A type carries several forms of one operator told apart by operand type, as SPEC promises: `v * v` beside `v * s`,
// `v * s` for two widths of `s` and an integer, `s * v` for two widths as free forms, and a contract's bound on a number
// form. Through 0.9.946 a number operand took the C name of the type's own, and every free form one name, so each pair
// was refused as a duplicate (`v * v` beside `v * 0.5` was a downstream engine's node-material case). A number picks
// its form by its width; a literal written without a suffix takes the one form of its kind.
type contract Scale<T is This> for value { T operator*(float32 s); }

@generate(of)
type value V {
    public float64 x;
    public V operator*(V rhs)          { return V.of(x: this.x * rhs.x); }
    // Each number form adds its own tag, so the test sees which one ran.
    public V operator*(float32 s)      { return V.of(x: this.x * cast<float64>(s) + 1000.0); }
    public V operator*(float64 s)      { return V.of(x: this.x * s + 2000.0); }
    public V operator*(int32 n)        { return V.of(x: this.x * cast<float64>(n) + 3000.0); }
    public V operator*(float32 s, V v) { return V.of(x: cast<float64>(s) * v.x + 4000.0); }
    public V operator*(float64 s, V v) { return V.of(x: s * v.x + 5000.0); }
}

// One number form: a literal without a suffix goes to it, whatever the literal's own default width.
@generate(of)
type value W implements Scale<This> {
    public float32 x;
    public W operator*(W rhs)     { return W.of(x: this.x * rhs.x); }
    public W operator*(float32 s) { return W.of(x: this.x * s); }
}

fn T twice<T: Scale<T>>(T v) { return v * 2.0f32; }   // the bound's number form, resolved per instantiation

fn uint8 main() {
    V a = V.of(x: 2.0);
    V vv = a * a;
    if (vv.x != 4.0) { return 1; }
    V f32 = a * 0.5f32;
    if (f32.x != 1001.0) { return 2; }
    V f64 = a * 0.5f64;
    if (f64.x != 2001.0) { return 3; }
    V i = a * 3i32;
    if (i.x != 3006.0) { return 4; }
    V lit = a * 3;                 // an integer literal: the one integer form
    if (lit.x != 3006.0) { return 5; }
    float64 h = 0.25;
    V typed = a * h;
    if (typed.x != 2000.5) { return 6; }
    V l32 = 0.5f32 * a;
    if (l32.x != 4001.0) { return 7; }
    V l64 = 0.5f64 * a;
    if (l64.x != 5001.0) { return 8; }

    W w = W.of(x: 2.0);
    W ww = w * w * 0.5;            // both forms in one chain, and an unsuffixed literal
    if (ww.x != 2.0) { return 9; }
    w *= 0.25;
    if (w.x != 0.5) { return 10; }
    W t = twice(v: W.of(x: 3.0));
    if (t.x != 6.0) { return 11; }
    return 42;
}
