// std::process — shell("echo out; echo err 1>&2") captures stdout "out\n" (4) AND stderr "err\n" (4),
// proving run()'s concurrent (Poller-driven) drain of both pipes.
import std::process::{Command, Output};
import std::io::{IoError};
import std::collections::{DynamicArray};

fn int main() {
    Command c = Command.shell(line: "echo out; echo err 1>&2");
    Result<Output, IoError> r = c.run();
    return match (give r) {
        case Ok(o): {
            int32 n = cast<int32>(o.stdout().length());
            int32 e = cast<int32>(o.stderr().length());
            int32 code = 42;
            if (n != 4) { code = 60; }
            else if (e != 4) { code = 61; }
            else if (o.stdout()[0] != cast<uint8>(111)) { code = 62; }   // 'o'
            else if (o.stderr()[0] != cast<uint8>(101)) { code = 63; }   // 'e'
            := code;
        }
        case Err(x): 64;
    };
}
