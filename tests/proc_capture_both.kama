// std::process — the helper's `echo2 out err` writes "out\n" (4) to stdout AND "err\n" (4) to stderr,
// proving run()'s concurrent drain of both pipes.
import { core::envOr, std::process::Command, std::process::Output, std::io::IoError, std::collections::DynamicArray };

fn uint8 main() {
    Command c = Command.make(program: envOr(name: "KAMA_PROCUTIL", dflt: "procutil"));
    c.arg(a: "echo2"); c.arg(a: "out"); c.arg(a: "err");
    Result<Output, IoError> r = c.run();
    return match (give r) {
        case Ok(value: o): {
            isize n = o.stdout().length();
            isize e = o.stderr().length();
            int32 code = 42;
            if (n != 4) { code = 60; }
            else if (e != 4) { code = 61; }
            else if (o.stdout()[0] != cast<uint8>(111)) { code = 62; }   // 'o'
            else if (o.stderr()[0] != cast<uint8>(101)) { code = 63; }   // 'e'
            // ...and taken apart, the captured bytes moved out rather than copied off the borrows (KR-261).
            isize both = match (give o.intoParts()) { case Parts(status: s, stdout: so, stderr: se): so.length() + se.length(); };
            if (code == 42 && both != 8) { code = 65; }
            := cast<uint8>(code);
        }
        case Err(error: x): 64;
    };
}
