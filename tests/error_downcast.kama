// P3 (Model C): `error.as<T>()` recovers the concrete enum from a boxed `Owned<Error>` — a runtime vtbl
// compare yielding `Optional<T>` (Some by value if it matches, else None). It BORROWS the box, so the
// operand stays valid on the None branch (there we still call `e.message()`). Some pulls the payload out.
type enum IoError implements Error {
    NotFound, Other(int32 code);

    public fn string message() { return match (this) { case NotFound: "nf"; case Other(code: c): "io"; }; }
}
type enum ParseError implements Error {
    Bad, Eof;

    public fn string message() { return match (this) { case Bad: "bad"; case Eof: "eof"; }; }
}

fn Result<int32, Owned<Error>> f(int32 w) {
    if (w == 0) { return Result::Ok(value: 50); }
    if (w == 1) { return Result::Err(error: IoError::Other(code: 9)); }
    return Result::Err(error: ParseError::Bad);
}
fn int32 handle(Result<int32, Owned<Error>> r) {
    return match (r) {
        case Ok(value: v): v;
        case Err(error: e): {
            := match (e.as<IoError>()) {
                case Some(value: io): match (io) { case Other(code: c): c; case NotFound: 0; };   // recovered payload
                case None: { string m = e.message(); := cast<int32>(m.length()); }   // e survives the borrow
            };
        }
    };
}
fn int32 main() { return handle(r: f(w: 0)) + handle(r: f(w: 1)) + handle(r: f(w: 2)); }  // 50 + 9 + 3 = 62
