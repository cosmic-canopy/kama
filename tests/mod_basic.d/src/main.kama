// Entry (private file) pulling public symbols via per-symbol `import`.
import {
    std::memory::Owned,
    std::collections::DynamicArray,
    modbasic::math::add,
    modbasic::math::Counter,
    modbasic::shapes::Box,
};

fn int32 main()
{
    int32 s = add(a: 10, b: 5);            // 15
    Counter c = Counter.make(start: 0);
    c.bump();
    Box b = Box.make(w: 3, h: 4);          // area 12
    Owned<Box> o = new Box.make(w: 2, h: 5);   // imported type in Owned -> area 10

    DynamicArray<int32> xs = DynamicArray.empty();
    xs.add(item: s);
    xs.add(item: c.get());
    xs.add(item: b.area());
    xs.add(item: o.area());
    int32 total = 0;
    foreach (int32 v in xs) { total = total + v; }
    return total;                          // 15 + 1 + 12 + 10 = 38
}
