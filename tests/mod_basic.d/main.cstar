// Entry (private file) pulling public namespaces via `using`.
using Math;
using Shapes;

int main()
{
    int32 s = add(a: 10, b: 5);            // 15  (Math.add via using)
    Counter c = new Counter(start: 0);     // Math.Counter via using
    c.bump();
    Box b = new Box(w: 3, h: 4);           // Shapes.Box via using -> area 12
    Owned<Box> o = new Owned<Box>(w: 2, h: 5);  // cross-namespace type in Owned -> area 10

    List<int32> xs = new List<int32>();
    xs.add(item: s);
    xs.add(item: c.get());
    xs.add(item: b.area());
    xs.add(item: o.area());
    int32 total = 0;
    foreach (int32 v in xs) { total = total + v; }
    return total;                          // 15 + 1 + 12 + 10 = 38
}
