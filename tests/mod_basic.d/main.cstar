// Entry (private file) pulling public symbols via per-symbol `import`.
import Math::{add, Counter};
import Shapes::{Box};

fn int main()
{
    int32 s = add(a: 10, b: 5);            // 15
    Counter c = Counter(start: 0);
    c.bump();
    Box b = Box(w: 3, h: 4);               // area 12
    Owned<Box> o = new Box(w: 2, h: 5);    // imported type in Owned -> area 10

    List<int32> xs = new List<int32>();
    xs.add(item: s);
    xs.add(item: c.get());
    xs.add(item: b.area());
    xs.add(item: o.area());
    int32 total = 0;
    foreach (int32 v in xs) { total = total + v; }
    return total;                          // 15 + 1 + 12 + 10 = 38
}
