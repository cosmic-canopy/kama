import std::memory::{Owned};
// Construction-model M3: complete-init enforcement on a NAMED ctor (a static factory). `make` builds the
// object field-by-field on a bare local and returns it. Enforcement ACCEPTS it because every owning
// (`Owned`) field is unconditionally assigned before the return — the never-null seal, generalized from the
// legacy instance ctor to the factory path. (Reject counterpart: xfail/ctor_missing_owning_ptr.)
type value Box {
    int32 v;
    public ctor make(int32 v) { Box r; r.v = v; return give r; }
    public fn int32 get() { return this.v; }
}
type resource Holder {
    Owned<Box> a;
    public ctor make(int32 v) {
        Owned<Box> b = new Box.make(v: v);
        Holder h;
        h.a = give b;              // the one owning field, set before return -> complete
        return h;
    }
    public fn int32 get() { return this.a.get(); }
}
fn int32 main() {
    Holder h = Holder.make(v: 42);
    return h.get();               // 42
}
