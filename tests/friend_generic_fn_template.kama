// A `friend` grant to a GENERIC free function reaches the function's own body — checked once, before any
// instance exists — and not only each instance. A library's generic accessor is instantiated by its users and
// never by the library, so its `kama check` refused the grant it relies on. `reader` below is
// never instantiated; `count` is, and both use the grant.
import { core::println };

type resource Box {
    int32 v = 0;
    public ctor make(int32 v) { this.v = v; }
    const fn int32 secret() { return this.v; }
    friend reader[secret];
    friend count[secret];
}

fn T reader<T: Deserializable<T>>(const ref Box b, T fallback) { int32 s = b.secret(); return fallback; }
fn int32 count<T>(const ref Box b, T unused) { return b.secret(); }

fn int32 main() {
    Box b = Box.make(v: 7);
    println(s: "reader is never instantiated");
    return count::<bool>(b: b, unused: true) == 7 ? 0 : 1;
}
