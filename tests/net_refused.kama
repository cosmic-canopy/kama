// std::net error path — connecting to a port with nothing listening yields Err(ConnectionRefused).
import std::net::{TcpStream};
import std::io::{IoError};

fn int32 isRefused(IoError e) { return match (e) { case ConnectionRefused: 1; case _: 0; }; }

fn int main() {
    string host = "127.0.0.1";
    uint16 port = cast<uint16>(47655);              // nothing bound here
    Result<TcpStream, IoError> rc = TcpStream.connect(host: host, port: port);
    return match (rc) { case Ok(value: s): 10; case Err(error: e): ((isRefused(e: e) == 1) ? 0 : 20); };
}
