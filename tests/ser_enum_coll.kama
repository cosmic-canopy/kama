// A DynamicArray of enums with a string payload, an int payload, and a no-payload variant — composition + tag dispatch.
import std::serialization::json::{encode, decode};
import std::collections::{DynamicArray};
@generate(Serialize, Deserialize)
type enum Tok { Word(string s), Num(int32 n), End }
fn int main() {
    DynamicArray<Tok> ts = DynamicArray.empty(); string w = "hi";
    ts.add(item: Tok::Word(s: give w)); ts.add(item: Tok::Num(n: 42)); ts.add(item: Tok::End);
    Result<string, Owned<Error>> __enc = encode(v: ts);
    string __encStr = match (give __enc) { case Ok(value: __ok): give __ok; case Err(error: __e): { return 250; } };
    Result<DynamicArray<Tok>, Owned<Error>> res = decode::<DynamicArray<Tok>>(src: give __encStr);
    return match (res) { case Ok(value: b):
        (match (b[0]) { case Word(s: s): cast<int32>(s.length()); case Num(n: n): 0; case End: 0; })
        + (match (b[1]) { case Num(n: n): n; case Word(s: s): 0; case End: 0; })
        + b.length(); case Err(error: e): 0 - 1; };   // 2 + 42 + 3 = 47
}
