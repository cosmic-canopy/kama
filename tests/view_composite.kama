// A type that holds views is a view (KR-225 decisions 1–3). `Words` is a zero-copy tokenizer over a byte view: it
// holds a `ConstView`, its constructor is public because it holds no raw pointer — it only re-holds the view it was
// handed, so it roots where that view roots — and a view read from its field is a derive off it. 16 bytes on the
// stack; nothing is allocated and no byte is copied.
import { std::collections::ConstView };

type view Words {
    ConstView<uint8> rest;
    public ctor over(ConstView<uint8> input) { this.rest = input; }
    public const fn bool done() { return this.rest.length() == 0; }
    // The next space-separated word, a view into the input; the cursor moves past it.
    public fn ConstView<uint8> next() {
        isize n = 0;
        while (n < this.rest.length() && this.rest[n] != 32) { n = n + 1; }
        ConstView<uint8> word = this.rest.slice(from: 0, count: n);
        isize skip = n < this.rest.length() ? n + 1 : n;
        this.rest = this.rest.slice(from: skip, count: this.rest.length() - skip);
        return word;
    }
}

// Two views held together: a composite constructor roots at every view it is handed.
type view Pair {
    ConstView<uint8> a;
    ConstView<uint8> b;
    public ctor of(ConstView<uint8> a, ConstView<uint8> b) { this.a = a; this.b = b; }
    public const fn isize total() { return this.a.length() + this.b.length(); }
}

// A composite parameter is bounded by the caller's frame, so a derive off it may be returned.
fn ConstView<uint8> firstWord(Words w) { return w.next(); }

fn uint8 main() {
    string text = "zero copy words";
    int32 r = 0;
    borrow text.bytes() as b {
        Words t = Words.over(input: b);
        while (!t.done()) { ConstView<uint8> w = t.next(); r = r + cast<int32>(w.length()); }   // 4 + 4 + 5 = 13
        Words u = Words.over(input: b);
        r = r + cast<int32>(firstWord(w: u).length());   // + 4 = 17
        Pair p = Pair.of(a: b.slice(from: 0, count: 4), b: b.slice(from: 5, count: 4));
        r = r + cast<int32>(p.total()) * 3;              // + 24 = 41
        r = r + (b[0] == 122 ? 1 : 0);                   // 'z' + 1 = 42
    }
    return cast<uint8>(r);
}
