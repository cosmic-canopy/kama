import std::collections::{List};
// M26f-3 — `copy` of a collection is a real DEEP copy: the source and the copy have
// independent buffers, so mutating one doesn't touch the other (and each frees its own).
fn int32 main() {
    List<int32> a = List();
    a.add(item: 7);
    a.add(item: 8);
    List<int32> b = copy a;    // deep copy — independent buffer
    b[0] = 100;                // mutate b's first element only
    return a[0] + b[0];        // 7 + 100 = 107  (a shared buffer would give 200)
}
