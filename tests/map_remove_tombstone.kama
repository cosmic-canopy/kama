// Tombstones: removing an entry must NOT break the probe run of other keys that collided into the same
// chain, and a later insert should be able to reuse the tombstoned slot. Build a batch, remove every
// even key (leaving tombstones), verify the odds still resolve, then re-insert to reclaim tombstones.
import std::collections::{Map};

fn string keyN(int32 n) {
    string s = "k";
    int32 i = 0;
    while (i < n) { s = s + "x"; i = i + 1; }
    return s;
}

fn int main() {
    Map<string, int32> m = Map.empty();
    int32 i = 0;
    while (i < 30) { m.put(key: keyN(n: i), value: i); i = i + 1; }

    i = 0; while (i < 30) { if (i % 2 == 0) { m.remove(key: keyN(n: i)); } i = i + 1; }  // 15 tombstones

    int32 r = 0;
    r = r + m.length();                               // 15 (odds remain)
    int32 ok = 0;
    i = 1; while (i < 30) {                            // every odd key still probes correctly past tombstones
        int32 v = match (m.get(key: keyN(n: i))) { case Some(value: x): x; case None: 0 - 1; };
        if (v == i) { ok = ok + 1; }
        i = i + 2;
    }
    r = r + ok;                                       // +15 -> 30
    if (!m.contains(key: keyN(n: 4))) { r = r + 5; }  // an even key is gone -> 35
    m.put(key: keyN(n: 4), value: 400);               // reuse a tombstone
    if (m.contains(key: keyN(n: 4))) { r = r + 5; }   // -> 40
    r = r + m.length();                               // +16 -> 56
    return r;   // 56
}
