// Drop-only-if-live (A) — field-slot liveness. A `Wrapper` owns a raw-handle `resource` field and is
// built field-by-field (`w.inner = give hh`). The field-first-write must NOT drop the freshly-{0}
// `inner` slot: a raw-handle dtor has NO drop-safe zero (here it traces a fixed code; for a real fd it
// would close(0)=stdin). Handle's dtor is GUARD-FREE on purpose — correctness must come from the
// compiler never dropping the non-live slot, not from an author band-aid.
extern fn void kama_trace(int code);
extern fn int kama_trace_get();

type resource Handle {
    int32 h;
    public ctor open(int32 v) { this.h = v; }
    public fn int32 val() { return this.h; }
    ~Handle() { kama_trace(code: 5); }               // one trace per REAL drop
}

type resource Wrapper {
    Handle inner;
    public ctor wrap(Handle hh) { this.inner = give hh; }   // field-first-write (A)
    public fn int32 val() { return this.inner.val(); }
}

fn int build() {
    Handle h = Handle.open(v: 7);
    Wrapper w = Wrapper.wrap(hh: give h);            // h moves into w.inner (its scope-drop suppressed)
    return w.val();                                  // w drops here -> Wrapper__dtor -> Handle__dtor -> trace(5) ONCE
}

fn int main() {
    int v = build();
    // exactly ONE Handle drop (the live one). fold of a single trace(5): 0*31 + 5 = 5.
    // A spurious drop of the zeroed `inner` at the field-first-write would fold in a second 5 -> 160.
    if (v != 7) { return 90; }
    return kama_trace_get();                         // expect 5
}
