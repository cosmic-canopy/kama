// Generic inference reads a field of `this` the way it reads a field of any other receiver. `cos(x:
// this.yaw)` inside a method failed with "cannot infer generic type parameter 'T' — argument 'x' is not a
// literal or a locally-typed value", while `cos(x: cam.yaw)` on a local and `float32 y = this.yaw;
// cos(x: y)` both inferred: discovery typed `v.f` through the receiver's declared type, and `this` had none.
import { std::math::cos, std::math::sin, std::math::abs };

fn bool sized<T>(const ref T x) { return sizeof(T) > 0; }

type value Camera {
    public float32 yaw;
    public float64 pitch;
    public ctor make(float32 yaw) { this.yaw = yaw; this.pitch = 0.0;
                                    this.pitch = abs(x: this.pitch) + 2.0; }          // a ctor body too
    public const fn float32 facing() { return cos(x: this.yaw); }                       // the reported shape
    public const fn float64 tilt() { return sin(x: this.pitch) + this.pitch; }
    public const fn bool whole() { return sized(x: this); }                             // `this` itself
}

type value Box<T> {
    public T v;
    public ctor make(T v) { this.v = v; }
    public const fn T magnitude() { return abs(x: this.v); }                            // inside a generic type
}

fn int32 main() {
    Camera c = Camera.make(yaw: 0.0f32);
    int32 r = 0;
    if (c.facing() == 1.0f32) { r = r + 1; }
    if (c.tilt() > 2.9 && c.tilt() < 3.0) { r = r + 1; }   // sin(2) + 2 ≈ 2.909
    if (c.whole()) { r = r + 1; }
    Box<float64> b = Box.make(v: -7.5);
    if (b.magnitude() == 7.5) { r = r + 1; }
    return r;                                               // 4
}
