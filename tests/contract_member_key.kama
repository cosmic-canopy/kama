// KR-8 — who may call a contract member is said by its PARAMETERS, not by a visibility word on it (a contract
// member is public by definition). `hidden` takes a `DriverKey`, and only `driver` is granted the key's
// `ctor`, so only `driver` can call `hidden` through any `Tok`. The refusal of everyone else is
// tests/xfail/contract_member_key_outsider.kama.
type value DriverKey {
    friend driver[mint];
    int32 unused;
    ctor mint() { this.unused = 0; }
}

type contract Tok for value { fn int32 hidden(DriverKey key); }

type value Impl implements Tok {
    int32 v;
    public ctor make() { this.v = 42; }
    public fn int32 hidden(DriverKey key) { return this.v; }
}

fn int32 driver(Tok t) { return t.hidden(key: DriverKey.mint()); }

fn int32 main()
{
    Impl i = Impl.make();
    return driver(t: i);
}
