#!/bin/sh
# dev — everyday contributor tasks (no secrets). Run `./dev` for help.
#
# The one rule this script exists to enforce: EVERY TEST TASK BUILDS THE BINARY IT IS ABOUT TO TEST.
# Build artifacts are platform-scoped (`out/<os>-<arch>/`), so a host build and a container build
# coexist — which is convenient right up until you edit the compiler, rebuild one, and test the other.
# That failure is silent: the suite runs and passes against last week's compiler.
set -eu

usage() { cat <<'EOF'
kama dev — usage: ./dev <task>

Build
  build             build the compiler for this host (make)
  build container   build the compiler inside the container
  rebuild           clean + build — use after a git stash/checkout cycle (see below)
  clean             make clean

Test — each task builds first, so it can never run against a stale compiler
  fixture <name>…   build + run JUST these tests/<name>.kama against their .expect  ← ITERATE WITH THIS
  test              native fixture suite            (host)
  test san          ASan/UBSan fixture suite        (container — see below)
  test wasm         wasm/node fixture suite         (container)
  test linux        the CI Linux leg, exactly       (container — opt-in, see below)
  test all          native + san + wasm
  check             the tools/check-*.sh guard scripts (host)
  matrix            test all + check — the full pre-commit gate

Site & packaging
  assets            regenerate icon + favicons from assets/logo.png
  site              build the static site into _site/
  serve [port] [dir]  build + serve the site over examples/httpd (default :8080, _site/)
  ext-package       package the VS Code extension (.vsix), no publish
  help              this help

The full suite is the GATE, not the inner loop. It stays mandatory — nothing is believed or committed
without it — but `./dev test` is minutes and `test san`/`test wasm` are longer still, so running one after
every experiment is where a session's wall-clock goes. Match the rung to the question you are asking:

  while iterating   `./dev fixture a b c`   seconds — "do the files I just touched still pass?"
  before believing  `./dev test`            once per logical change, not per edit
  before committing `./dev test san|wasm`   both, once — they catch what native cannot
  when relevant     `./dev check`           grammar, LSP, docs, packaging
  the whole gate    `./dev matrix`
  closing a campaign `./dev test linux`     the one leg nothing else here reproduces

The trap this replaces: with no way to run three fixtures, the only honest answer to "did I break
anything?" was the whole suite — so it got run dozens of times in one session, mostly to learn that one
fixture still failed.

If the compiler suddenly SEGFAULTS on fixtures that passed a moment ago, run `./dev rebuild`. Header
dependencies are declared, but a `git stash`/`git checkout` cycle can restore sources without make
deciding to rebuild, and the result is objects compiled against two different class layouts — a corrupt
compiler that builds cleanly. A clean rebuild is the fix; the symptom is never a real code bug.

Why `san` and `wasm` are container-only:
  - macOS has no LeakSanitizer, so a host KAMA_SAN run reports "detect_leaks is not supported on
    this platform" for every fixture and tells you nothing.
  - `tools/cdev` does not forward host env, hence the `env KAMA_SAN=1` form used below.

Deploy / publish / provision live in ./ops (they need secrets from .env).
EOF
}

# `-j`: the compiler is ~10 translation units and a from-scratch build is 23.5s serial / 12.7s at -j10
# (it was 8s / 3s until the compiler itself started building at -O2 — see ROADMAP section 9 lever 7; the
# 3x is bought back many times over at every use of the binary). Verified safe by building both ways and
# comparing objects — every .o is byte-identical, so the dependency graph is complete (including the
# generated bison/flex sources). The BINARY hash still varies run to run, but that is the macOS linker,
# not parallelism: two serial builds differ from each other too.
JOBS="${KAMA_JOBS:-$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)}"
build_host()      { make -j"$JOBS"; }
build_container() { tools/cdev make -j"$JOBS"; }

task="${1:-help}"; [ $# -gt 0 ] && shift || true
case "$task" in
  build)
    case "${1:-host}" in
      host)      build_host ;;
      container) build_container ;;
      *) echo "dev build: expected 'host' or 'container'" >&2; exit 2 ;;
    esac ;;

  fixture)
    # The missing rung between "one build" and "the whole suite". Same .expect contract as run_tests.sh:
    # the file's single line is the expected process exit code.
    [ $# -gt 0 ] || { echo "dev fixture: name a fixture (e.g. ./dev fixture comparable sort_stable)" >&2; exit 2; }
    build_host >/dev/null
    ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)   # kama-bin.sh is SOURCED and needs $ROOT
    . "$ROOT/tools/kama-bin.sh"
    tmp=$(mktemp -d); rc=0
    for n in "$@"; do
      n=${n%.kama}; n=${n#tests/}
      src="tests/$n.kama"; exp="tests/$n.expect"
      [ -f "$src" ] || { echo "MISSING $n (no $src)"; rc=1; continue; }
      if ! "$KAMA" build "$src" -o "$tmp/$n" >"$tmp/$n.err" 2>&1; then
        echo "FAIL $n (build)"; sed 's/^/    /' "$tmp/$n.err" | head -5; rc=1; continue
      fi
      # a fixture's exit code IS its result, so it must not trip `set -e` — hence the `if`
      if "$tmp/$n" >/dev/null 2>&1; then got=0; else got=$?; fi
      if [ -f "$exp" ]; then
        want=$(cat "$exp")
        if [ "$got" = "$want" ]; then echo "PASS $n ($got)"; else echo "FAIL $n (got $got, want $want)"; rc=1; fi
      else
        echo "BUILT $n (no .expect; exit $got)"
      fi
    done
    rm -rf "$tmp"; exit $rc ;;

  test)
    case "${1:-native}" in
      native) build_host;      ./run_tests.sh ;;
      san)    build_container; tools/cdev exec env KAMA_SAN=1  ./run_tests.sh ;;
      wasm)   build_container; tools/cdev exec env KAMA_WASM=1 ./run_tests.sh ;;
      # The CI Linux leg, run the way CI runs it: plain run_tests.sh on Linux, no KAMA_SAN/KAMA_WASM.
      # NOTHING else here is that. `native` runs it on the host; `san`/`wasm` run a DIFFERENT set on Linux
      # and carry 1 and 0 guards respectively. So a Linux-only guard failure was invisible locally — a
      # bashism in a guard (`sh` is bash on macOS, dash on Debian) sat green here and red in CI.
      # Deliberately NOT in `all` or `matrix`: it is a container round-trip, and paying it per commit is a
      # tax. Run it before closing a campaign, or before any push that touches tools/check-*.sh.
      linux)  build_container; tools/cdev exec ./run_tests.sh ;;
      all)
        build_host;      ./run_tests.sh
        build_container; tools/cdev exec env KAMA_SAN=1  ./run_tests.sh
                         tools/cdev exec env KAMA_WASM=1 ./run_tests.sh ;;
      *) echo "dev test: expected native|linux|san|wasm|all" >&2; exit 2 ;;
    esac ;;

  check)
    # The guard scripts resolve out/<os>-<arch>/kama directly (tools/kama-bin.sh), so they need the
    # HOST binary current — a container-only rebuild leaves them testing stale code while sitting green.
    #
    # `--all` includes the `# check-heavy:` guards (check-no-inheritance builds a second compiler), which
    # run_tests.sh's set leaves out. The runner is shared with run_tests.sh so the two can't drift.
    build_host
    exec sh tools/run-checks.sh --leg native --all ;;

  matrix)
    # Skip the guards inside the NATIVE test leg: `./dev check` runs the same set, on the same host,
    # moments later, and that block is ~60s serial / ~38s parallel — paying it twice is pure waste.
    #
    # The variable reaches the native leg (a plain child process) and NOT the san/wasm legs, because
    # `tools/cdev` does not forward host env. That is what we want, not an accident to be tidied up:
    # check-argv-env under KAMA_SAN builds the probe WITH sanitizers, which is a different assertion
    # from the one `./dev check` makes on the host, so the container legs must keep running it.
    KAMA_SKIP_CHECKS=1 "$0" test all
    "$0" check ;;

  assets)         sh tools/gen-assets ;;
  site)           sh tools/build-site; echo "preview: ./dev serve   (dogfoods examples/httpd; or: python3 -m http.server -d _site)" ;;
  serve)
    # Serve the site with Kama's own httpd. Prefer a runnable host-built ./kama; otherwise fall back to
    # the container path (tools/serve), which also builds the binary and publishes the port to the host.
    port="${1:-8080}"; dir="${2:-_site}"
    if ./kama --version >/dev/null 2>&1; then
      [ "$dir" = "_site" ] && sh tools/build-site >/dev/null
      ./kama build examples/httpd/httpd.kama -o .scratch/httpd
      echo "kama httpd: serving ./$dir on http://localhost:$port   (Ctrl-C to stop)"
      HTTPD_HOST=127.0.0.1 HTTPD_PORT="$port" HTTPD_ROOT="$dir" exec ./.scratch/httpd
    else
      exec tools/serve "$port" "$dir"
    fi
    ;;
  ext-package)    cd editor/vscode && npx --yes @vscode/vsce package ;;
  rebuild)        make clean && build_host ;;
  clean)          make clean ;;
  -h|--help|help) usage ;;
  *)              echo "unknown task: $task (deploy/publish live in ./ops)" >&2; usage; exit 2 ;;
esac
