// Allocation/RAII stress: build, fill, sum, and drop a growable DynamicArray 2000 times
// (~2M appends + 2000 deterministic frees). Stresses GC churn vs kama's RAII.
import std::collections::{DynamicArray};
fn int main()
{
    uint64 total = 0;
    for (int32 iter = 0; iter < 2000; iter++)
    {
        DynamicArray<int32> xs = DynamicArray();
        for (int32 j = 1; j <= 1000; j++)
        {
            xs.add(item: j);
        }
        uint64 s = 0;
        foreach (int32 v in xs)
        {
            s += cast<uint64>(v);
        }
        total += s;
        // xs drops here -> DynamicArray_int32__dtor frees the buffer (no GC)
    }
    uint64 m = total % 256;
    return cast<int>(m);
}
