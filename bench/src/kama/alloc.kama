// Allocation/RAII stress: build, fill, sum, and drop a growable DynamicArray 2000 times
// (~2M appends + 2000 deterministic frees). Stresses GC churn vs kama's RAII.
import { std::collections::DynamicArray };
fn int32 main()
{
    uint64 total = 0;
    for (int32 iter = 0; iter < 2000; iter++)
    {
        DynamicArray<int32> xs = DynamicArray.empty();
        for (int32 j = 1; j <= 1000; j++)
        {
            xs.add(item: j);
        }
        uint64 s = 0;
        foreach (int32 v in xs)
        {
            // `truncate`, not `cast`, to keep this apples-to-apples: every peer in the table converts
            // UNCHECKED here — C `(uint64_t)xs[k]`, Rust `*v as u64`, Go `uint64(v)` — and `cast` would
            // add a signed->unsigned range check none of them pay, in the inner loop of a benchmark whose
            // subject is allocation churn, not conversion. (Measured: 2.86ms vs 2.46ms.) The values are
            // 1..1000, so the two verbs agree on every one of them.
            s += truncate<uint64>(v);
        }
        total += s;
        // xs drops here -> DynamicArray_int32__dtor frees the buffer (no GC)
    }
    uint64 m = total % 256;
    return cast<int32>(m);
}
