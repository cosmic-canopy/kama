// dispatch — dynamic-dispatch cost. The shapes live in a heap-owned, heterogeneous
// `DynamicArray<Owned<Shape>>` built at runtime, so no compiler can prove the concrete type at a
// call site: every `area()` is a genuine indirect (contract-vtable) call. That is the honest
// dynamic-dispatch measurement — a monomorphic call site (two stack locals) instead lets an
// optimizer devirtualize the call away, which is what the earlier variant inadvertently measured.
import std::collections::{DynamicArray};
import std::memory::{Owned};
type contract Shape for both { fn int64 area(); }
type resource Circle implements Shape
{
    int64 r;
    public ctor make(int64 r) { this.r = r; }
    public fn int64 area() { return this.r * this.r; }
}
type resource Square implements Shape
{
    int64 s;
    public ctor make(int64 s) { this.s = s; }
    public fn int64 area() { return this.s * this.s; }
}
fn int main()
{
    DynamicArray<Owned<Shape>> shapes = DynamicArray.empty();
    for (int32 j = 0; j < 512; j++)
    {
        if ((j % 2) == 0) { Owned<Shape> sh = new Circle.make(r: 3); shapes.add(item: give sh); }
        else              { Owned<Shape> sh = new Square.make(s: 4); shapes.add(item: give sh); }
    }
    uint64 sum = 0;
    for (uint64 i = 0; i < 8000000; i++)
    {
        uint64 r = i % 512;
        int32 idx = cast<int32>(r);
        sum += cast<uint64>(shapes[idx].area());
    }
    uint64 m = sum % 256;
    return cast<int>(m);
    // shapes drops here -> each Owned<Shape> frees its object (deterministic, no GC)
}
