// Function-pointer dispatch: 8M indirect calls through an `fnptr`, alternating two
// free functions and routed through a function boundary (`apply`) so the call stays
// genuinely indirect (the fnptr analog of `dispatch`'s virtual calls). kama's fnptr
// is a bare C function pointer — zero-cost, so this is the indirect-call cost itself.
fnptr int64 Op(int64 x);
fn int64 add1(int64 x) { return x + 1; }
fn int64 mul3(int64 x) { return x * 3; }
fn int64 apply(Op op, int64 x) { return op(x: x); }
fn int32 main()
{
    Op a = add1;
    Op b = mul3;
    uint64 sum = 0;
    for (uint64 i = 0; i < 8000000; i++)
    {
        if ((i % 2) == 0) { sum += cast<uint64>(apply(op: a, x: cast<int64>(i))); }
        else              { sum += cast<uint64>(apply(op: b, x: cast<int64>(i))); }
    }
    uint64 m = sum % 256;
    return cast<int32>(m);
}
