fn uint64 collatz_len(uint64 n)
{
    uint64 steps = 0;
    while (n != 1)
    {
        if ((n % 2) == 0) { n = n / 2; }
        else { n = 3 * n + 1; }
        steps += 1;
    }
    return steps;
}
fn int main()
{
    uint64 sum = 0;
    for (uint64 i = 1; i < 700000; i++)
    {
        sum += collatz_len(n: i);
    }
    uint64 m = sum % 256;
    return cast<int>(m);
}
