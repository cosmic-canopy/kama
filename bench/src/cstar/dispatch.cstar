class Shape
{
    virtual fn int64 area() { return 0; }
}
class Circle extends Shape
{
    int64 r;
    Circle(int64 r) { this.r = r; }
    override fn int64 area() { return r * r; }
}
class Square extends Shape
{
    int64 s;
    Square(int64 s) { this.s = s; }
    override fn int64 area() { return s * s; }
}
fn int64 measure(ref Shape sh)
{
    return sh.area();
}
fn int main()
{
    Circle c = new Circle(r: 3);
    Square q = new Square(s: 4);
    uint64 sum = 0;
    for (uint64 i = 0; i < 8000000; i++)
    {
        if ((i % 2) == 0) { sum += cast<uint64>(measure(sh: ref c)); }
        else { sum += cast<uint64>(measure(sh: ref q)); }
    }
    uint64 m = sum % 256;
    return cast<int>(m);
}
