// dispatch — dynamic-dispatch cost: virtual calls through a base reference.
// M25b: polymorphism is opt-in (`virtual class`) with a `protected virtual` hook behind
// a public `area()`. The trivial wrapper inlines under -O2, so the measured cost is the
// vtable call itself (`compute`), unchanged from the pre-M25 version.
virtual class Shape
{
    public fn int64 area() { return this.compute(); }
    protected virtual fn int64 compute() { return 0; }
}
final class Circle extends Shape
{
    int64 r;
    public Circle(int64 r) { this.r = r; }
    protected override fn int64 compute() { return r * r; }
}
final class Square extends Shape
{
    int64 s;
    public Square(int64 s) { this.s = s; }
    protected override fn int64 compute() { return s * s; }
}
fn int64 measure(ref Shape sh)
{
    return sh.area();
}
fn int main()
{
    Circle c = new Circle(r: 3);
    Square q = new Square(s: 4);
    uint64 sum = 0;
    for (uint64 i = 0; i < 8000000; i++)
    {
        if ((i % 2) == 0) { sum += cast<uint64>(measure(sh: ref c)); }
        else { sum += cast<uint64>(measure(sh: ref q)); }
    }
    uint64 m = sum % 256;
    return cast<int>(m);
}
