// today.kama — KR-3 step 8's brief (ROADMAP_DETAIL s6-windows-io): what a fiber gets on Windows before step 8, measured
// beside what a thread gets, so the brief's "before" column is rerunnable on any later compiler.
//
// Rows, one TSV line each (all times in microseconds):
//   sleep  thread|fiber  <asked>  <n>  <p50>  <p90>  <p99>  <max>
//     A thread's `sleep` is a high-resolution waitable timer per call (kama_time.h). A fiber's parks on its scheduler's
//     timer heap, whose wait is the Poller's millisecond `GetQueuedCompletionStatusEx`, so it lands on the ~15.6 ms tick.
//   echo   thread|fiber  1  <round trips>  <us per round trip, as a float in tenths>
//     One byte there and back over loopback TCP. On threads both ends block in `recv`; on fibers both ends are fibers on
//     one isolate, and every park is an AFD poll (an allocation, a base-handle `WSAIoctl` and the IOCTL; kama_os.h).
//
// Build and run: kama build bench/winio/today.kama -o <scratch>/today.exe --release; <scratch>/today.exe
import { core::println, std::concurrent::Fiber, std::time::sleep, std::time::Duration, std::time::Instant,
         std::time::monotonicNow, std::collections::FixedArray, std::net::TcpListener, std::net::TcpStream,
         std::io::IoError, std::io::writeAll };

comptime int32 NAPS = 200;
comptime int32 TRIPS = 20000;

fn void sortAsc(ref FixedArray<int64> a, int32 n) {
    for (int32 i = 1; i < n; i = i + 1) {
        int64 v = a[i];
        int32 j = i - 1;
        while (j >= 0 && a[j] > v) { a[j + 1] = a[j]; j = j - 1; }
        a[j + 1] = v;
    }
}

fn void naps(bool onFiber, int64 askedUs) {
    FixedArray<int64> s = FixedArray.make(size: cast<isize>(NAPS));
    for (int32 i = 0; i < NAPS; i = i + 1) {
        Instant t = monotonicNow();
        sleep(d: Duration.fromMicros(us: askedUs));
        s[i] = t.elapsed().asNanos() / 1000i64;
    }
    sortAsc(a: ref s, n: NAPS);
    string where = onFiber ? "fiber" : "thread";
    int64 p50 = s[NAPS / 2];
    int64 p90 = s[NAPS * 9 / 10];
    int64 p99 = s[NAPS * 99 / 100];
    int64 most = s[NAPS - 1];
    int32 n = NAPS;
    println(s: "sleep\t${where}\t${askedUs}\t${n}\t${p50}\t${p90}\t${p99}\t${most}");
}

fn void allNaps(bool onFiber) {
    naps(onFiber: onFiber, askedUs: 100i64);
    naps(onFiber: onFiber, askedUs: 1000i64);
    naps(onFiber: onFiber, askedUs: 5000i64);
}

fn uint16 portOf(const ref TcpListener l) { return match (l.localAddr()) { case Ok(value: a): a.port; case Err(error: e): 0ui16; }; }

// The server side of one connection: one byte back for each byte in, until the peer closes.
unsafe fn void echoOne(TcpStream conn) {
    FixedArray<uint8> buf = FixedArray.make(size: 1);
    while (true) {
        Result<isize, IoError> r = conn.read(into: buf.viewMut());
        isize got = match (r) { case Ok(value: n): n; case Err(error: e): cast<isize>(0 - 1); };
        if (got <= 0) { return; }
        Result<Unit, IoError> w = writeAll(w: conn, bytes: buf.view());
        bool failed = match (w) { case Ok(value: u): false; case Err(error: e): true; };
        if (failed) { return; }
    }
}

unsafe fn void serveOne(TcpListener l) {
    Result<TcpStream, IoError> ra = l.accept();
    match (give ra) {
        case Ok(value: c): { echoOne(conn: give c); }
        case Err(error: e): { return; }
    };
}

unsafe fn void serveOneRef(ref TcpListener l) {
    Result<TcpStream, IoError> ra = l.accept();
    match (give ra) {
        case Ok(value: c): { echoOne(conn: give c); }
        case Err(error: e): { return; }
    };
}

// The client: TRIPS one-byte round trips, timed as a whole.
unsafe fn void trips(bool onFiber, uint16 port) {
    Result<TcpStream, IoError> rc = TcpStream.connect(host: "127.0.0.1", port: port);
    TcpStream s = match (give rc) { case Ok(value: x): give x; case Err(error: e): { return; } };
    FixedArray<uint8> one = FixedArray.make(size: 1);
    one[0] = 107ui8;
    FixedArray<uint8> back = FixedArray.make(size: 1);
    Instant t = monotonicNow();
    for (int32 i = 0; i < TRIPS; i = i + 1) {
        Result<Unit, IoError> w = writeAll(w: s, bytes: one.view());
        Result<isize, IoError> r = s.read(into: back.viewMut());
        isize n = match (r) { case Ok(value: k): k; case Err(error: e): 0; };
        if (n != 1) { println(s: "echo: short read at ${i}"); return; }
    }
    int64 tenths = t.elapsed().asNanos() / cast<int64>(TRIPS) / 100i64;
    string where = onFiber ? "fiber" : "thread";
    int64 whole = tenths / 10i64;
    int64 frac = tenths % 10i64;
    int32 count = TRIPS;
    println(s: "echo\t${where}\t1\t${count}\t${whole}.${frac}");
}

unsafe fn uint8 run() {
    // Threads first: the root isolate makes its scheduler at its first `spawn fiber`, and sleeps on the thread before it.
    allNaps(onFiber: false);
    Result<TcpListener, IoError> rl = TcpListener.bind(host: "127.0.0.1", port: 0ui16);
    TcpListener l = match (give rl) { case Ok(value: x): give x; case Err(error: e): { return 2; } };
    uint16 port = portOf(l: l);
    scope {
        spawn serveOne(l: give l);                        // an isolate of its own: blocking accept and recv
        trips(onFiber: false, port: port);
    }

    scope { spawn fiber allNaps(onFiber: true); }
    Result<TcpListener, IoError> rl2 = TcpListener.bind(host: "127.0.0.1", port: 0ui16);
    TcpListener l2 = match (give rl2) { case Ok(value: x): give x; case Err(error: e): { return 3; } };
    uint16 port2 = portOf(l: l2);
    scope {
        spawn fiber serveOneRef(l: ref l2);
        spawn fiber trips(onFiber: true, port: port2);
    }
    return 0;
}

fn uint8 main() { return run(); }
