// server.kama — the "kama today" arm of KR-243: an isolate per connection, blocking reads and writes. It is the
// number the fiber arm replaces (KR-3 step 5): today a connection costs an OS thread, because a blocked read stalls
// whatever runs on its thread. The fiber arm, fibers.kama, is the same code with `spawn fiber` and an isolate per core.
//
// Usage: BENCH_MODE=echo|http|skew BENCH_PORT=<port> [BENCH_DEADLINE_MS=<ms>] ./server   (the idle limit: fibers.kama says)
import { core::env::envOr,
    std::net::TcpListener,
    std::net::TcpStream,
    std::io::IoError,
    std::io::writeAll,
    std::concurrent::Isolate,
    std::collections::DynamicArray,
    std::collections::FixedArray,
    std::time::Duration,
    std::time::monotonicNow,
};

fn uint16 parsePort(ref string s) {
    int32 v = 0;
    for (isize i = 0; i < s.length(); i = i + 1) {
        int32 c = cast<int32>(s[i]);
        if (c < 48 || c > 57) { return cast<uint16>(0); }
        v = v * 10 + c - 48;
    }
    return cast<uint16>(v);
}

fn int64 parseMs(ref string s) {
    int64 v = 0i64;
    for (isize i = 0; i < s.length(); i = i + 1) {
        int64 c = cast<int64>(s[i]);
        if (c < 48i64 || c > 57i64) { return 0i64; }
        v = v * 10i64 + c - 48i64;
    }
    return v;
}

// The idle limit, set again before each read (`BENCH_DEADLINE_MS`; 0 sets none).
fn void arm(ref TcpStream conn, int64 ms) {
    if (ms > 0i64) { conn.setReadDeadline(at: Optional::Some(value: monotonicNow() + Duration.fromMillis(ms: ms))); }
}

// Writes back whatever arrives, until the client closes.
unsafe fn void echo(TcpStream conn, int64 dl) {
    FixedArray<uint8> buf = FixedArray.make(size: 4096);
    while (true) {
        arm(conn: conn, ms: dl);
        Result<isize, IoError> rr = conn.read(into: buf.viewMut());
        isize got = match (rr) { case Ok(value: n): n; case Err(error: e): cast<isize>(0 - 1); };
        if (got <= 0) { return; }
        Result<Unit, IoError> w = writeAll(w: conn, bytes: buf.slice(from: 0, count: got));
        bool failed = match (w) { case Ok(value: u): false; case Err(error: e): true; };
        if (failed) { return; }
    }
}

// Answers each complete request (`\r\n\r\n` ends one), however the reads split it, until the client closes.
unsafe fn void http(TcpStream conn, int64 dl) {
    FixedArray<uint8> buf = FixedArray.make(size: 4096);
    DynamicArray<uint8> reply = DynamicArray.empty();
    string r = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 13\r\n\r\nHello, World!";
    for (isize i = 0; i < r.length(); i = i + 1) { reply.add(item: r[i]); }
    int32 state = 0;   // how much of "\r\n\r\n" the bytes so far end with
    while (true) {
        arm(conn: conn, ms: dl);
        Result<isize, IoError> rr = conn.read(into: buf.viewMut());
        isize got = match (rr) { case Ok(value: n): n; case Err(error: e): cast<isize>(0 - 1); };
        if (got <= 0) { return; }
        for (isize i = 0; i < got; i = i + 1) {
            uint8 c = buf[i];
            bool cr = c == 13;
            bool lf = c == 10;
            if (cr) { state = state == 2 ? 3 : 1; }
            else if (lf && (state == 1 || state == 3)) { state = state + 1; }
            else { state = 0; }
            if (state == 4) {
                state = 0;
                Result<Unit, IoError> w = writeAll(w: conn, bytes: reply.view());
                bool failed = match (w) { case Ok(value: u): false; case Err(error: e): true; };
                if (failed) { return; }
            }
        }
    }
}

// The skew burst, the same in every arm: `rounds` passes of FNV-1a over the request's 64 bytes.
fn uint32 mix(ref FixedArray<uint8> b, uint32 rounds) {
    uint32 h = 2166136261;
    for (uint32 r = 0; r < rounds; r = r + 1) {
        for (isize i = 0; i < 64; i = i + 1) { h = (h ^ cast<uint32>(b[i])) * 16777619; }
    }
    return h;
}

// Answers each 64-byte request after the rounds of mixing it asks for (client.c says how), until the client closes.
unsafe fn void skew(TcpStream conn, int64 dl) {
    FixedArray<uint8> buf = FixedArray.make(size: 64);
    while (true) {
        isize have = 0;
        while (have < 64) {
            arm(conn: conn, ms: dl);
            Result<isize, IoError> rr = conn.read(into: buf.sliceMut(from: have, count: 64 - have));
            isize got = match (rr) { case Ok(value: n): n; case Err(error: e): cast<isize>(0 - 1); };
            if (got <= 0) { return; }
            have = have + got;
        }
        uint32 rounds = cast<uint32>(buf[0]) | (cast<uint32>(buf[1]) << 8) | (cast<uint32>(buf[2]) << 16) | (cast<uint32>(buf[3]) << 24);
        uint32 h = mix(b: buf, rounds: rounds);
        for (isize i = 0; i < 4; i = i + 1) { buf[4 + i] = cast<uint8>((h >> cast<uint32>(8 * i)) & 255); }
        Result<Unit, IoError> w = writeAll(w: conn, bytes: buf.slice(from: 0, count: 64));
        bool failed = match (w) { case Ok(value: u): false; case Err(error: e): true; };
        if (failed) { return; }
    }
}

fn void serveEcho(TcpStream conn, int64 dl) { echo(conn: give conn, dl: dl); }
fn void serveHttp(TcpStream conn, int64 dl) { http(conn: give conn, dl: dl); }
fn void serveSkew(TcpStream conn, int64 dl) { skew(conn: give conn, dl: dl); }

// Accepts forever; a connection's isolate joins when the server ends.
unsafe fn void serve(ref TcpListener listener, int32 mode, int64 dl) {   // mode: 0 echo, 1 http, 2 skew
    DynamicArray<Isolate> held = DynamicArray.empty();
    while (true) {
        Result<TcpStream, IoError> ra = listener.accept();
        match (give ra) {
            case Ok(value: c): {
                Result<Unit, IoError> nd = c.setNoDelay(on: true);   // as every other arm: Go's default
                if (mode == 1)      { Isolate h = spawn serveHttp(conn: give c, dl: dl); held.add(item: give h); }
                else if (mode == 2) { Isolate h = spawn serveSkew(conn: give c, dl: dl); held.add(item: give h); }
                else                { Isolate h = spawn serveEcho(conn: give c, dl: dl); held.add(item: give h); }
            }
            case Err(error: e): { }
        };
    }
}

unsafe fn uint8 start() {
    string mode = envOr(name: "BENCH_MODE", dflt: "echo");
    string portStr = envOr(name: "BENCH_PORT", dflt: "8080");
    string dlStr = envOr(name: "BENCH_DEADLINE_MS", dflt: "0");
    int64 dl = parseMs(s: dlStr);
    Result<TcpListener, IoError> rl = TcpListener.bind(host: "127.0.0.1", port: parsePort(s: portStr));
    match (rl) {
        case Ok(value: listener): { serve(listener: listener, mode: mode == "http" ? 1 : mode == "skew" ? 2 : 0, dl: dl); }
        case Err(error: e): { return 1; }
    };
    return 0;
}

fn uint8 main() { return start(); }
