// pool_kama.kama — the fork path of pool.c's deques, written in kama (KR-3's pool brief): a fork, a push, a pop, a steal, on
// `Atomic`, `UnsafePtr` and a module `static`, with no C of its own. The ruling put the pool in kama code while every sibling seam
// (kama_isolate.h, kama_sched.h, kama_channel.h) is a C header, and this asks what that costs where it would cost most.
//
// Only `nested` is written: fib(BENCH_ELEMS), each fork two chunks, forking down to fib(BENCH_LEAF). A worker here spins and never
// sleeps, since `Atomic` has no wait: compare it with pool.c's `pool-2ms`, whose workers spin through the same shape. `Atomic` has no
// fence either, so pop and steal use seq-cst operations where pool.c uses a seq-cst fence, which is equally correct on the C memory
// model's one total order.
//
// Usage: BENCH_SHAPE=nested BENCH_POOL=<threads> BENCH_CALLS=<n> BENCH_ELEMS=<n> BENCH_LEAF=<n> ./pool_kama
// Prints the same TSV row as pool.c.
import { core::env::envOr, core::println,
    std::collections::DynamicArray,
    std::collections::sort,
    std::concurrent::Atomic,
    std::concurrent::MemoryOrder,
    std::concurrent::Isolate,
    std::time::Instant,
    std::time::monotonicNow,
};

fn int64 parseInt(const ref string s) {
    int64 v = 0i64;
    for (isize i = 0; i < s.length(); i = i + 1) {
        int64 c = cast<int64>(s[i]);
        if (c < 48i64 || c > 57i64) { return 0i64; }
        v = v * 10i64 + c - 48i64;
    }
    return v;
}
fn int64 setting(string name, string dflt) { return parseInt(s: envOr(name: give name, dflt: give dflt)); }

fnptr void Run(UnsafePtr ctx, int32 i);

comptime int64 DEQUE_N = 1024i64;

type value Task {
    public Run run;
    public UnsafePtr ctx;
    public UnsafePtr<Atomic<uint32>> remaining;
    public int32 i;
    public unsafe ctor make(Run run, UnsafePtr ctx, UnsafePtr<Atomic<uint32>> remaining, int32 i) {
        this.run = run; this.ctx = ctx; this.remaining = remaining; this.i = i;
    }
}

type resource Deque implements Sendable {
    Atomic<int64> top;
    InlineArray<int64>#(14) padTop;      // top and bottom on their own lines: 128 B on Apple silicon
    Atomic<int64> bottom;
    InlineArray<int64>#(15) padBottom;
    UnsafePtr<UnsafePtr> buf;             // DEQUE_N cells, cast to `Atomic<UnsafePtr>` per access

    public unsafe ctor make(UnsafePtr<UnsafePtr> buf) {
        this.top = Atomic.make(value: 0i64);
        this.padTop = [0i64; 14];
        this.bottom = Atomic.make(value: 0i64);
        this.padBottom = [0i64; 15];
        this.buf = buf;
    }

    unsafe fn UnsafePtr<Atomic<UnsafePtr>> cell(int64 at) {
        return cast<UnsafePtr<Atomic<UnsafePtr>>>(addr(of: this.buf[cast<isize>(at & (DEQUE_N - 1i64))]));
    }

    public unsafe fn bool push(UnsafePtr<Task> t) {
        int64 b = this.bottom.loadExplicit(order: MemoryOrder::Relaxed);
        int64 tp = this.top.loadExplicit(order: MemoryOrder::Acquire);
        if (b - tp >= DEQUE_N) { return false; }
        UnsafePtr<Atomic<UnsafePtr>> c = this.cell(at: b);
        c[0].storeExplicit(value: cast<UnsafePtr>(t), order: MemoryOrder::Release);
        this.bottom.storeExplicit(value: b + 1i64, order: MemoryOrder::Release);
        return true;
    }

    public unsafe fn UnsafePtr<Task> pop() {
        int64 b = this.bottom.loadExplicit(order: MemoryOrder::Relaxed) - 1i64;
        _ = this.bottom.swapExplicit(value: b, order: MemoryOrder::SeqCst);
        int64 tp = this.top.load();
        if (tp > b) {
            this.bottom.storeExplicit(value: b + 1i64, order: MemoryOrder::Relaxed);
            return cast<UnsafePtr<Task>>(null);
        }
        UnsafePtr<Atomic<UnsafePtr>> c = this.cell(at: b);
        UnsafePtr<Task> x = cast<UnsafePtr<Task>>(c[0].loadExplicit(order: MemoryOrder::Relaxed));
        if (tp == b) {
            if (!this.top.compareExchange(expected: ref tp, desired: tp + 1i64)) { x = cast<UnsafePtr<Task>>(null); }
            this.bottom.storeExplicit(value: b + 1i64, order: MemoryOrder::Relaxed);
        }
        return x;
    }

    public unsafe fn UnsafePtr<Task> steal() {
        int64 tp = this.top.load();
        int64 b = this.bottom.load();
        if (tp >= b) { return cast<UnsafePtr<Task>>(null); }
        UnsafePtr<Atomic<UnsafePtr>> c = this.cell(at: tp);
        UnsafePtr<Task> x = cast<UnsafePtr<Task>>(c[0].loadExplicit(order: MemoryOrder::Acquire));
        if (!this.top.compareExchange(expected: ref tp, desired: tp + 1i64)) { return cast<UnsafePtr<Task>>(null); }
        return x;
    }
}

// The pool, per thread: this thread's deque, every deque, and how many. A module `static` is per isolate, which is what a worker's
// own deque wants.
static UnsafePtr<Deque> mine;
static UnsafePtr<Deque> deques;
static int32 count = 0;
static uint32 seed = 1ui32;
static UnsafePtr<Atomic<UnsafePtr>> injected;
static UnsafePtr<Atomic<int32>> stopping;

unsafe fn void finish(UnsafePtr<Task> t) {
    t[0].run(ctx: t[0].ctx, i: t[0].i);
    _ = t[0].remaining[0].fetchSubExplicit(delta: 1ui32, order: MemoryOrder::AcqRel);
}

unsafe fn bool runStolen() {
    seed = seed * 1664525ui32 + 1013904223ui32;
    int32 from = cast<int32>(seed >> 16) % count;
    for (int32 k = 0; k < count; k = k + 1) {
        UnsafePtr<Deque> d = addr(of: deques[cast<isize>((from + k) % count)]);
        if (d == mine) { continue; }
        UnsafePtr<Task> t = d[0].steal();
        if (t != null) { finish(t: t); return true; }
    }
    return false;
}

unsafe fn void waitFor(UnsafePtr<Atomic<uint32>> remaining) {
    while (remaining[0].loadExplicit(order: MemoryOrder::Acquire) != 0ui32) {
        UnsafePtr<Task> t = mine[0].pop();
        if (t != null) { finish(t: t); continue; }
        _ = runStolen();
    }
}

// The fork of pool.c's pool_run on a worker: chunk 0 here, chunk 1 on this worker's deque.
unsafe fn void fork2(Run run, UnsafePtr ctx) {
    Atomic<uint32> remaining = Atomic.make(value: 2ui32);
    Task one = Task.make(run: run, ctx: ctx, remaining: addr(of: remaining), i: 1i32);
    if (!mine[0].push(t: addr(of: one))) { run(ctx: ctx, i: 1i32); _ = remaining.fetchSubExplicit(delta: 1ui32, order: MemoryOrder::AcqRel); }
    run(ctx: ctx, i: 0i32);
    _ = remaining.fetchSubExplicit(delta: 1ui32, order: MemoryOrder::AcqRel);
    waitFor(remaining: addr(of: remaining));
}

static int32 leaf = 10;

fn int64 fibSeq(int32 n) { return n < 2i32 ? cast<int64>(n) : fibSeq(n: n - 1i32) + fibSeq(n: n - 2i32); }

type value ForkCtx {
    public int32 n;
    public int64 r0;
    public int64 r1;
    public ctor make(int32 n) { this.n = n; this.r0 = 0i64; this.r1 = 0i64; }
}

unsafe fn void forkArm(UnsafePtr ctx, int32 i) {
    UnsafePtr<ForkCtx> f = cast<UnsafePtr<ForkCtx>>(ctx);
    int64 v = fib(n: f[0].n - 1i32 - i);
    if (i == 0i32) { f[0].r0 = v; } else { f[0].r1 = v; }
}

unsafe fn int64 fib(int32 n) {
    if (n < leaf) { return fibSeq(n: n); }
    ForkCtx f = ForkCtx.make(n: n);
    fork2(run: forkArm, ctx: cast<UnsafePtr>(addr(of: f)));
    return f.r0 + f.r1;
}

type resource WorkerSetup implements Sendable {
    UnsafePtr<Deque> all;
    int32 n;
    int32 index;
    int32 cut;
    UnsafePtr<Atomic<UnsafePtr>> root;
    UnsafePtr<Atomic<int32>> stop;
    public unsafe ctor make(UnsafePtr<Deque> all, int32 n, int32 index, int32 cut, UnsafePtr<Atomic<UnsafePtr>> root, UnsafePtr<Atomic<int32>> stop) {
        this.all = all; this.n = n; this.index = index; this.cut = cut; this.root = root; this.stop = stop;
    }
    public unsafe fn void serve() {
        deques = this.all; count = this.n; leaf = this.cut; injected = this.root; stopping = this.stop;
        mine = addr(of: deques[cast<isize>(this.index)]);
        seed = cast<uint32>(this.index) * 2654435761ui32 + 1ui32;
        while (stopping[0].loadExplicit(order: MemoryOrder::Relaxed) == 0i32) {
            UnsafePtr<Task> t = mine[0].pop();
            if (t != null) { finish(t: t); continue; }
            UnsafePtr r = injected[0].swapExplicit(value: cast<UnsafePtr>(null), order: MemoryOrder::AcqRel);
            if (r != null) { finish(t: cast<UnsafePtr<Task>>(r)); continue; }
            _ = runStolen();
        }
    }
}
unsafe fn void worker(WorkerSetup s) { s.serve(); }

type value RootCtx {
    public int32 n;
    public int64 r;
    public ctor make(int32 n) { this.n = n; this.r = 0i64; }
}
unsafe fn void rootArm(UnsafePtr ctx, int32 i) {
    UnsafePtr<RootCtx> q = cast<UnsafePtr<RootCtx>>(ctx);
    q[0].r = fib(n: q[0].n);
}

unsafe fn uint8 bench() {
    int32 pool = cast<int32>(setting(name: "BENCH_POOL", dflt: "10"));
    int32 calls = cast<int32>(setting(name: "BENCH_CALLS", dflt: "7"));
    int32 n = cast<int32>(setting(name: "BENCH_ELEMS", dflt: "36"));
    int32 cut = cast<int32>(setting(name: "BENCH_LEAF", dflt: "10"));
    int32 workers = pool > 1i32 ? pool - 1i32 : 1i32;

    // The deques and their cells, made up front and never grown.
    DynamicArray<UnsafePtr> cells = DynamicArray::<UnsafePtr>.empty();
    for (int64 c = 0i64; c < cast<int64>(workers) * DEQUE_N; c = c + 1i64) { cells.add(item: cast<UnsafePtr>(null)); }
    DynamicArray<Deque> ds = DynamicArray::<Deque>.empty();
    for (int32 w = 0; w < workers; w = w + 1) {
        ds.add(item: Deque.make(buf: addr(of: cells[cast<isize>(cast<int64>(w) * DEQUE_N)])));
    }
    Atomic<UnsafePtr> root = Atomic.make(value: cast<UnsafePtr>(null));
    Atomic<int32> stop = Atomic.make(value: 0i32);

    DynamicArray<Isolate> threads = DynamicArray::<Isolate>.empty();
    for (int32 w = 0; w < workers; w = w + 1) {
        WorkerSetup su = WorkerSetup.make(all: addr(of: ds[0]), n: workers, index: w, cut: cut, root: addr(of: root), stop: addr(of: stop));
        Isolate h = spawn worker(s: give su);
        threads.add(item: give h);
    }

    DynamicArray<int64> t = DynamicArray::<int64>.empty();
    int64 check = 0i64;
    Instant start = monotonicNow();
    for (int32 c = 0; c < calls; c = c + 1) {
        RootCtx q = RootCtx.make(n: n);
        Atomic<uint32> remaining = Atomic.make(value: 1ui32);
        Task task = Task.make(run: rootArm, ctx: cast<UnsafePtr>(addr(of: q)), remaining: addr(of: remaining), i: 0i32);
        Instant t0 = monotonicNow();
        root.storeExplicit(value: cast<UnsafePtr>(addr(of: task)), order: MemoryOrder::Release);
        while (remaining.loadExplicit(order: MemoryOrder::Acquire) != 0ui32) { }
        t.add(item: monotonicNow().since(earlier: t0).asNanos());
        check = check + q.r;
    }
    int64 total = monotonicNow().since(earlier: start).asNanos();
    stop.store(value: 1i32);
    threads.clear();

    borrow t.viewMut() as v { sort(items: v); }
    int64 p50 = t[cast<isize>(calls / 2i32)];
    int64 p99 = t[cast<isize>(calls - 1i32 - calls / 100i32)];
    println(s: "nested\t${pool}\t${calls}\t${n}\t${total}\t${p50}\t${p99}\t${check}");
    return 0;
}
fn uint8 main() { return bench(); }
