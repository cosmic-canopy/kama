#!/usr/bin/env bash
# bench/run — drive the cross-language benchmark harness in a container.
# Portable across podman (preferred) and docker; mirrors tools/cdev.
#
#   bench/run build-image     build the kama-bench toolchain image (heavy, ~3-4 GB)
#   bench/run build           compile kama + every language into bench/build/
#   bench/run run [workload]  measure time/RSS/size (default: all nine workloads)
#   bench/run report          render docs/benchmarks/RESULTS.md from results
#   bench/run all             build + run + report (the image must already exist: build-image)
#   bench/run server [out] [rounds]  KR-243's server benchmark (bench/server/), out under .scratch/ by default.
#                             run.sh's knobs (SLOTS, CONFIGS, CORES, WARMUP, SECONDS_, WRAP, SKEW_*, ALLOW_SLOW_CLOCK)
#                             pass through when set; KAMA_B_TREE=<a worktree> builds that tree's compiler for the
#                             `kama-fibers-b` arm; WRAP (perf, strace) gets the container what they need
#   bench/run uring [out] [rounds]   KR-253's io_uring measurement (bench/uring/), out under .scratch/ by default; the
#                             container gets seccomp unconfined and its SELinux label off, which io_uring needs; SLOTS
#                             and CONFIGS pass through when set
#   bench/run sh              interactive shell in the bench image
#
# Override the engine with KAMA_ENGINE=docker|podman.
set -euo pipefail

IMAGE="${KAMA_BENCH_IMAGE:-kama-bench}"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

ENGINE="${KAMA_ENGINE:-}"
if [ -z "$ENGINE" ]; then
  if command -v podman >/dev/null 2>&1; then ENGINE=podman
  elif command -v docker >/dev/null 2>&1; then ENGINE=docker
  else echo "bench: need podman or docker on PATH" >&2; exit 1; fi
fi

run_ni() { "$ENGINE" run --rm -v "$ROOT:/work" -w /work "$IMAGE" "$@"; }

# The server benchmark's knobs, set on this side, reach run.sh inside the container.
server_args=()
for v in SLOTS CONFIGS CORES WARMUP SECONDS_ WRAP SKEW_HOT SKEW_ROUNDS ALLOW_SLOW_CLOCK; do
  [ -n "${!v:-}" ] && server_args+=(-e "$v=${!v}")
done
uring_args=()   # KR-253 decision 8: io_uring needs seccomp unconfined and the SELinux label off (bench/uring/run.sh)
for v in SLOTS CONFIGS; do [ -n "${!v:-}" ] && uring_args+=(-e "$v=${!v}"); done
server_pre=""
if [ -n "${KAMA_B_TREE:-}" ]; then   # the variant compiler, built inside the container from its own tree
  server_args+=(-v "$(cd "$KAMA_B_TREE" && pwd):/variant")
  server_pre='make -s -C /variant kama >/dev/null && export KAMA_B=$(ROOT=/variant; . /variant/tools/kama-bin.sh; echo "$KAMA") && '
fi
# The engine's seccomp profile and, on a Fedora CoreOS podman machine, the container SELinux type each refuse two things
# a server run needs. One is io_uring, which kama's fiber arm runs on (KR-253): without it, `kama-fibers` and
# `kama-fibers-epoll` would both measure epoll. The other is perf_event_open, for WRAP, and no capability gets past
# either refusal. For perf the VM must also allow it:
# `podman machine ssh sudo sysctl -w kernel.perf_event_paranoid=-1 kernel.kptr_restrict=0` (lost on restart).
server_args+=(--security-opt seccomp=unconfined --security-opt label=disable)

case "${1:-}" in
  build-image) "$ENGINE" build -t "$IMAGE" -f "$ROOT/bench/Dockerfile" "$ROOT" ;;
  build)       run_ni bash bench/scripts/build.sh ;;
  run)         run_ni bash bench/scripts/measure.sh "${2:-all}" ;;
  report)      run_ni python3 bench/scripts/report.py ;;
  all)         run_ni bash -c "bash bench/scripts/build.sh && bash bench/scripts/measure.sh all && python3 bench/scripts/report.py" ;;
  # The server benchmark holds 10k connections, and today's kama arm a thread per connection: the container's own
  # limits on descriptors and processes would be the thing measured, so they are lifted for it. 524288 descriptors, not
  # more: a rootless engine cannot raise a container above its own user's hard limit, which is 524288 in the podman
  # machine (systemd's default), and asking for more fails the start. A run needs about 10k per process.
  server)      "$ENGINE" run --rm --ulimit nofile=524288:524288 --pids-limit=-1 ${server_args[@]+"${server_args[@]}"} \
                 -v "$ROOT:/work" -w /work "$IMAGE" \
                 bash -c "${server_pre}make -s kama >/dev/null && bash bench/server/run.sh ${2:-.scratch/bench-server.tsv} ${3:-15}" ;;
  uring)       "$ENGINE" run --rm --ulimit nofile=524288:524288 --security-opt seccomp=unconfined --security-opt label=disable \
                 ${uring_args[@]+"${uring_args[@]}"} -v "$ROOT:/work" -w /work "$IMAGE" \
                 sh bench/uring/run.sh "${2:-.scratch/uring.tsv}" "${3:-15}" ;;
  # KR-253 §8 step 5's counts: perf's tracepoints need the container privileged and the VM's tracefs inside it, beside the
  # seccomp and SELinux relaxation every server run has. The VM must also allow perf (see WRAP above).
  count)       "$ENGINE" run --rm --privileged --ulimit nofile=524288:524288 --pids-limit=-1 ${server_args[@]+"${server_args[@]}"} \
                 -v /sys/kernel/tracing:/sys/kernel/tracing -v "$ROOT:/work" -w /work "$IMAGE" \
                 bash -c "make -s kama >/dev/null && bash bench/server/count.sh ${2:-.scratch/counts.tsv} ${3:-3}" ;;
  sh|shell)    "$ENGINE" run --rm -it -v "$ROOT:/work" -w /work "$IMAGE" bash ;;
  *) echo "usage: bench/run {build-image|build|run [workload]|report|all|server [out] [rounds]|uring [out] [rounds]|count [out] [runs]|sh}" >&2; exit 2 ;;
esac
