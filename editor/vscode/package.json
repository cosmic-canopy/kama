{
  "name": "cstar",
  "displayName": "cstar",
  "description": "Syntax highlighting and language support for the cstar language (.cstar). Debug .cstar with CodeLLDB.",
  "version": "0.1.0",
  "publisher": "cosmic-canopy",
  "license": "MIT",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "keywords": ["cstar", "transpiler", "c", "wasm"],
  "repository": { "type": "git", "url": "https://github.com/cosmic-canopy/cstar" },
  "contributes": {
    "languages": [
      {
        "id": "cstar",
        "aliases": ["cstar", "Cstar"],
        "extensions": [".cstar", ".str"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cstar",
        "scopeName": "source.cstar",
        "path": "./syntaxes/cstar.tmLanguage.json"
      }
    ]
  },
  "extensionPack": [
    "vadimcn.vscode-lldb"
  ]
}
