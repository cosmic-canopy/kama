{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "kama",
  "scopeName": "source.kama",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#cast" },
    { "include": "#declarations" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.kama", "match": "//.*$" },
        { "name": "comment.block.kama", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "comment": "html\"…\" tagged string — inject HTML highlighting into the body, keep ${…} holes live",
          "begin": "(html)(\")",
          "end": "\"",
          "beginCaptures": { "1": { "name": "entity.name.function.tag.kama" }, "2": { "name": "punctuation.definition.string.begin.kama" } },
          "name": "string.quoted.double.tagged.html.kama",
          "patterns": [ { "include": "#interp-body" }, { "include": "text.html.basic" } ]
        },
        {
          "comment": "sql\"…\" tagged string — inject SQL highlighting into the body, keep ${…} holes live",
          "begin": "(sql)(\")",
          "end": "\"",
          "beginCaptures": { "1": { "name": "entity.name.function.tag.kama" }, "2": { "name": "punctuation.definition.string.begin.kama" } },
          "name": "string.quoted.double.tagged.sql.kama",
          "patterns": [ { "include": "#interp-body" }, { "include": "source.sql" } ]
        },
        {
          "comment": "a generic tag\"…\" tagged string (stripIndent, user tags) — highlight the tag, keep ${…} holes",
          "begin": "([A-Za-z_][A-Za-z0-9_]*)(\")",
          "end": "\"",
          "beginCaptures": { "1": { "name": "entity.name.function.tag.kama" }, "2": { "name": "punctuation.definition.string.begin.kama" } },
          "name": "string.quoted.double.tagged.kama",
          "patterns": [ { "include": "#interp-body" } ]
        },
        {
          "name": "string.quoted.double.kama",
          "begin": "\"",
          "end": "\"",
          "patterns": [ { "include": "#interp-body" } ]
        },
        {
          "name": "string.quoted.verbatim.kama",
          "begin": "@\"",
          "end": "\""
        }
      ]
    },
    "interp-body": {
      "patterns": [
        { "name": "constant.character.escape.kama", "match": "\\\\(u\\{[0-9A-Fa-f]+\\}|.)" },
        {
          "comment": "string interpolation hole ${ident.field[index]:spec} — an identifier with .field/[index] accessors and an optional format spec",
          "name": "meta.interpolation.kama",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.definition.interpolation.begin.kama" } },
          "endCaptures": { "0": { "name": "punctuation.definition.interpolation.end.kama" } },
          "patterns": [
            { "comment": "format specifier :.2 / :0x / :+06 — highlighted as a unit before the accessor rules", "name": "keyword.other.format-spec.kama", "match": ":[-+.0-9A-Za-z]+" },
            { "name": "variable.other.kama", "match": "[A-Za-z_][A-Za-z0-9_]*" },
            { "name": "punctuation.accessor.kama", "match": "[.\\[\\]]" },
            { "name": "constant.numeric.kama", "match": "[0-9]+" }
          ]
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.kama",
      "begin": "'",
      "end": "'",
      "patterns": [
        { "name": "constant.character.escape.kama", "match": "\\\\(u\\{[0-9A-Fa-f]+\\}|.)" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.kama", "match": "\\b(if|else|match|case|while|do|for|foreach|parallel_for|break|continue|return|spawn)\\b" },
        { "name": "keyword.other.modifier.kama", "match": "\\b(abstract|override|virtual|final|static|default|private|protected|public|friend|const|comptime|hardware|immutable|ref|out|in|extern|export|expose)\\b" },
        { "name": "keyword.other.kama", "match": "\\b(fn|fnptr|ctor|type|namespace|using|import|extends|implements|operator|unsafe|asm|scope|give|copy|cast|bitcast|as|when|sizeof|alignof)\\b" },
        { "name": "keyword.operator.new.kama", "match": "\\b(new|try)\\b" },
        { "name": "variable.language.kama", "match": "\\b(this|base)\\b" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(type)\\s+(value|resource|view|contract)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.kama" },
            "2": { "name": "storage.modifier.kama" },
            "3": { "name": "entity.name.type.kama" }
          }
        },
        {
          "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.kama" },
            "2": { "name": "entity.name.type.kama" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.primitive.kama", "match": "\\b(bool|char|int|int8|int16|int32|int64|uint8|uint16|uint32|uint64|float32|float64|double|string|void)\\b" },
        { "name": "entity.name.type.kama", "match": "\\b([A-Z][A-Za-z0-9_]*)\\b" }
      ]
    },
    "constants": {
      "name": "constant.language.kama",
      "match": "\\b(true|false|null)\\b"
    },
    "cast": {
      "match": "\\b(bitcast|cast)\\s*<\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*>",
      "captures": {
        "1": { "name": "keyword.operator.cast.kama" },
        "2": { "name": "entity.name.type.kama" }
      }
    },
    "numbers": {
      "comment": "Mirrors kama.l exactly; guarded by tools/check-syntax-drift.sh. Three things the earlier rules got wrong: the integer suffix is `u?i(8|16|32|64)`, so it is `42ui32` and there is NO bare `42u32`; kama has NO digit separators, so `1_000` is not a literal; and a float suffix needs a fractional part, so `42f32` is not one either. Each literal splits its digits from its TYPE SUFFIX via captures, so `i32` in `42i32` colors like the `int32` keyword rather than like the digits. Anything else starting with a digit is flagged illegal instead of being coloured as a valid number.",
      "patterns": [
        {
          "comment": "Based literal `0b<digits>_<base 2..32>` (e.g. 0b1010_2) — must precede the integer rule.",
          "match": "\\b(0[bB][0-9A-Za-z]+_(?:[12][0-9]|3[0-2]|[2-9]))((?:u?i(?:8|16|32|64))?)\\b",
          "captures": {
            "1": { "name": "constant.numeric.other.kama" },
            "2": { "name": "storage.type.numeric.kama" }
          }
        },
        {
          "match": "\\b(0[xX][0-9A-Fa-f]+)((?:u?i(?:8|16|32|64))?)\\b",
          "captures": {
            "1": { "name": "constant.numeric.hex.kama" },
            "2": { "name": "storage.type.numeric.kama" }
          }
        },
        {
          "match": "\\b(0[oO][0-7]+)((?:u?i(?:8|16|32|64))?)\\b",
          "captures": {
            "1": { "name": "constant.numeric.octal.kama" },
            "2": { "name": "storage.type.numeric.kama" }
          }
        },
        {
          "comment": "`digits.digits` with an optional exponent, or `digits` with a required one (1e10). A dot needs digits on both sides, so `1.` and `.5` fall through to the illegal rule.",
          "match": "\\b((?:[0-9]+\\.[0-9]+(?:[eE][-+]?[0-9]+)?|[0-9]+[eE][-+]?[0-9]+))((?:f32|f64)?)\\b",
          "captures": {
            "1": { "name": "constant.numeric.float.kama" },
            "2": { "name": "storage.type.numeric.kama" }
          }
        },
        {
          "match": "\\b([0-9]+)((?:u?i(?:8|16|32|64))?)\\b",
          "captures": {
            "1": { "name": "constant.numeric.integer.kama" },
            "2": { "name": "storage.type.numeric.kama" }
          }
        },
        {
          "comment": "Reached only when every rule above failed: a bad suffix (42u32, 42f32), a digit separator (1_000), or a based literal with no `_<base>` (0b1010).",
          "name": "invalid.illegal.numeric.kama",
          "match": "\\b[0-9][0-9A-Za-z_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.kama"
        }
      ]
    }
  }
}
