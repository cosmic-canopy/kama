#!/bin/sh
# Assemble the deployable static site into _site/ (Cloudflare Pages direct-upload input).
#
# The generator is tools/site/build.mjs: it copies site/ verbatim, renders the home page, and
# renders one page per entry in tools/site/pages.mjs from the repo's own markdown — so the site
# never holds a second copy of a doc. It also copies the canonical installers and llms.txt to the
# root, so kama-lang.org/install.sh and /install.ps1 serve the same files the installer and
# `kama update` reference.
#
# Needs node >= 20 and one pinned dependency (marked); `npm ci` fetches it on first run.
set -eu
cd "$(dirname "$0")/.."   # repo root
[ -d node_modules/marked ] || npm ci --no-audit --no-fund
exec node tools/site/build.mjs
