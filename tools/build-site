#!/bin/sh
# Assemble the deployable static site into _site/ (Cloudflare Pages direct-upload input).
# Copies the page + brand assets + the canonical installers, so kama-lang.org/install.sh
# and /install.ps1 serve the same files the installer and `kama update` reference.
set -eu
cd "$(dirname "$0")/.."   # repo root
rm -rf _site && mkdir -p _site/assets
cp -R site/. _site/
cp assets/logo.png _site/assets/ 2>/dev/null || true
cp install.sh install.ps1 _site/
echo "built _site/"
