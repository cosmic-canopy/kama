def load(src, name):
    data = open(os.path.join(src, name), "rb").read()
    got = hashlib.sha256(data).hexdigest()
    if got != SHA256[name]:
        sys.exit("gen-libm: %s is not the pinned musl %s file (sha256 %s, expected %s)"
                 % (name, MUSL_VERSION, got, SHA256[name]))
    text = data.decode("utf-8")
    if "\r" in text:
        sys.exit("gen-libm: %s has CR line endings" % name)
    return text

def comment_spans(text):
    """(start, end) of every comment in `text`. These files hold no string or character literal (checked below)."""
    spans, i, n = [], 0, len(text)
    while i < n:
        if text.startswith("/*", i):
            j = text.index("*/", i + 2) + 2
        elif text.startswith("//", i):
            j = text.find("\n", i)
            j = n if j < 0 else j
        else:
            i += 1
            continue
        spans.append((i, j))
        i = j
    return spans

def blank(text, spans):
    """`text` with each span replaced by spaces, newlines kept, so every offset still lines up."""
    out = list(text)
    for s, e in spans:
        for k in range(s, e):
            if out[k] != "\n":
                out[k] = " "
    return "".join(out)

def directive_spans(code):
    spans = []
    for m in re.finditer(r"(?m)^[ \t]*#", code):
        e = m.start()
        while True:
            nl = code.find("\n", e)
            if nl < 0:
                e = len(code)
                break
            if code[nl - 1] != "\\":
                e = nl
                break
            e = nl + 1
        spans.append((m.start(), e))
    return spans

def top_level(code):
    """Every name a top-level declaration in `code` declares: (name, is static, offset of its declaration). A
    declarator's name is the last identifier before the `(`, `[`, `=`, `,` or `;` that ends it; a struct tag is not."""
    out = []
    depth, in_stmt, body = 0, False, False
    for m in TOKEN.finditer(code):
        t = m.group()
        if depth:
            if t in "({[":
                depth += 1
            elif t in ")}]":
                depth -= 1
                if depth == 0 and body and t == "}":
                    in_stmt = body = False
            continue
        if not in_stmt:
            in_stmt, start, static = True, m.start(), False
            init, last, named, fn, tag = False, None, False, False, False
        if t[0].isalpha() or t[0] == "_":
            if t == "static":
                static = True
            elif not init and not tag:
                last = t
            tag = t in ("struct", "union", "enum")
            continue
        tag = False
        if t in "([=,;" and not init and not named and last:
            out.append((last, static, start))
            named, fn = True, t == "("
        if t in "([{":
            if t == "{" and fn and not init:
                body = True
            depth += 1
        elif t == "=":
            init = True
        elif t == ",":
            init, last, named, fn = False, None, False, False
        elif t == ";":
            in_stmt = False
    if depth or in_stmt:
        sys.exit("gen-libm: unbalanced top level")
    return out

def rename(text, spans, names):
    """Every identifier in `text` outside a comment that `names` maps, renamed; a member after `.` or `->` never is."""
    sub = lambda s: IDENT.sub(lambda m: names.get(m.group(), m.group()), s)
    out, at = [], 0
    for s, e in spans:
        out.append(sub(text[at:s]))
        out.append(text[s:e])
        at = e
    out.append(sub(text[at:]))
    return "".join(out)

def main():
    if len(sys.argv) != 2:
        sys.exit("usage: tools/gen-libm <musl source tree>")
    src = sys.argv[1]
    if load(src, "VERSION").strip() != MUSL_VERSION:
        sys.exit("gen-libm: the tree is not musl %s" % MUSL_VERSION)
    # The MIT grant (through its closing rule) and the paragraph naming the math code's authors.
    copyright = load(src, "COPYRIGHT").splitlines()
    rules = [i for i, line in enumerate(copyright) if line and set(line) == {"-"}]
    licence = copyright[:rules[1] + 1]
    m = copyright.index("Much of the math library code (src/math/* and src/complex/*) is")
    licence += [""] + copyright[m:copyright.index("", m)]

    shared = {n: PREFIX + n for n in PRELUDE_NAMES}

    headers = {}
    for h in DATA_HEADERS:
        text = load(src, "src/math/%s.h" % h)
        text, n = re.subn(r"#ifndef (_\w+_H)\n#define \1\n", "", text)
        text, k = re.subn(r"\n#endif\n$", "\n", text)
        text, d = re.subn(r"extern hidden const struct (\w+) \{(.*?)\n\} (\w+);", r"struct \1 {\2\n};", text, flags=re.S)
        if (n, k, d) != (1, 1, 1):
            sys.exit("gen-libm: %s.h is not the shape this expects" % h)
        text = re.sub(r"(?m)^#include [<\"][^>\"]+[>\"]\n", "", text)
        code = blank(text, comment_spans(text))
        for name in re.findall(r"(?m)^[ \t]*#[ \t]*define[ \t]+([A-Za-z_]\w*)", code) + re.findall(r"\bstruct (\w+) \{", code):
            shared[name] = PREFIX + name
        headers[h] = text

    files, local = {}, {}
    for f in FILES:
        text = re.sub(r"(?m)^#include [<\"][^>\"]+[>\"]\n", "", load(src, "src/math/%s.c" % f))
        code = blank(text, comment_spans(text))
        if '"' in code or "'" in code:
            sys.exit("gen-libm: %s.c holds a literal this does not handle" % f)
        macros = re.findall(r"(?m)^[ \t]*#[ \t]*define[ \t]+([A-Za-z_]\w*)", code)
        decls = top_level(blank(code, directive_spans(code)))
        local[f] = {n: "%s%s__%s" % (PREFIX, f, n) for n in macros}
        for name, static, _ in decls:
            if static:
                local[f][name] = "%s%s__%s" % (PREFIX, f, name)
            else:
                shared[name] = PREFIX + name
        files[f] = (text, macros, decls)

    exact, exact_files = {}, {}
    for f in EXACT_FILES:
        text = re.sub(r"(?m)^#include [<\"][^>\"]+[>\"]\n", "", load(src, "src/math/%s.c" % f))
        code = blank(text, comment_spans(text))
        if '"' in code or "'" in code:
            sys.exit("gen-libm: %s.c holds a literal this does not handle" % f)
        macros = re.findall(r"(?m)^[ \t]*#[ \t]*define[ \t]+([A-Za-z_]\w*)", code)
        decls = top_level(blank(code, directive_spans(code)))
        local[f] = {n: "%s%s__%s" % (PREFIX, f, n) for n in macros}
        for name, static, _ in decls:
            if static:
                local[f][name] = "%s%s__%s" % (PREFIX, f, name)
            else:
                exact[name] = EXACT_PREFIX + name
        exact_files[f] = (text, macros, decls)

    new = list(shared.values()) + list(exact.values()) + [v for names in local.values() for v in names.values()]
    if len(new) != len(set(new)):
        sys.exit("gen-libm: two names would be renamed alike")

    body = []
    for h in DATA_HEADERS:
        text = headers[h]
        body.append("// ---- musl src/math/%s.h %s\n" % (h, "-" * (100 - len(h))))
        body.append(rename(text, comment_spans(text), shared))
    for f in FILES:
        text, macros, decls = files[f]
        # `static` ahead of every declaration that had none, the last first so the offsets hold.
        for at in sorted({at for _, static, at in decls if not static}, reverse=True):
            text = text[:at] + "static " + text[at:]
        names = dict(shared)
        names.update(local[f])
        body.append("// ---- musl src/math/%s.c %s\n" % (f, "-" * (100 - len(f))))
        body.append(rename(text, comment_spans(text), names))
        if macros:
            body.append("".join("#undef %s\n" % local[f][n] for n in dict.fromkeys(macros)))
        body.append("\n")

    body.append("// ---- the exact ones, for a bare-metal build only (tools/gen-libm, EXACT_FILES) %s\n" % ("-" * 25))
    for f in EXACT_FILES:
        text, macros, decls = exact_files[f]
        for at in sorted({at for _, static, at in decls if not static}, reverse=True):
            text = text[:at] + "static " + text[at:]
        names = dict(shared)
        names.update(exact)
        names.update(local[f])
        body.append("// ---- musl src/math/%s.c %s\n" % (f, "-" * (100 - len(f))))
        body.append(rename(text, comment_spans(text), names))
        if macros:
            body.append("".join("#undef %s\n" % local[f][n] for n in dict.fromkeys(macros)))
        body.append("\n")

    h = []
    h.append("#ifndef KAMA_LIBM_H\n#define KAMA_LIBM_H\n\n")
    h.append("// GENERATED by tools/gen-libm from musl %s — do not edit; change the generator.\n" % MUSL_VERSION)
    h.append("//\n")
    h.append("// std::math's sin, cos, tan, asin, acos, atan, exp, log, log2, log10, cbrt, pow, atan2 and hypot, in both widths,\n")
    h.append("// as a program built with `reproducible-float` computes them: kama_math.h routes kama_sin and the rest here when the\n")
    h.append("// driver defines KAMA_REPRODUCIBLE_FLOAT, and nothing else includes it. IEEE 754 does not require these correctly\n")
    h.append("// rounded and every libm rounds them its own way, so the key's promise, the same bits on every target, needs this one\n")
    h.append("// copy compiled into the program everywhere, wasm included. tests/repro_math.d holds the bits on every leg, and\n")
    h.append("// tools/gen-libm says what was changed from musl's own files (only names, `static`, and two switches). A bare-metal\n")
    h.append("// build, which has no libm, includes it as well, with musl's exact ones (sqrt, floor, ...) at the end (KR-341).\n")
    h.append("//\n")
    h.append("// musl's licence follows. The files that carry Sun's or Arm's notice keep it above their code.\n")
    h.append("//\n")
    h.extend(("// " + line).rstrip() + "\n" for line in licence)
    h.append("\n")
    h.append("// musl's code is written to musl's warning flags, not to a project's `-Wall -Werror`, which every other kama header\n")
    h.append("// builds under; as a system header it warns about nothing (an error is still an error). Its bits do not change.\n")
    h.append("#pragma GCC system_header\n\n")
    h.append(PRELUDE)
    h.append("\n")
    h.extend(body)
    h.append("#endif /* KAMA_LIBM_H */\n")
    with open(os.path.join(ROOT, "include/kama_libm.h"), "w", encoding="utf-8", newline="\n") as out:
        out.write("".join(h))

if __name__ == "__main__":
    main()
