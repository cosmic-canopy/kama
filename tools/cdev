#!/usr/bin/env bash
# cdev — run cstar's build toolchain inside a container.
#
# Portable across podman (preferred) and docker. The repo is bind-mounted at
# /work so edits on the host are visible in the container with no image rebuild.
#
#   tools/cdev build-image          build the cstar-dev toolchain image
#   tools/cdev make [args...]       run `make` in the container (build cstar)
#   tools/cdev test                 run ./run_tests.sh in the container
#   tools/cdev exec <cmd...>        run an arbitrary command in the container
#   tools/cdev sh                   interactive shell in the container
#
# Override the engine with CSTAR_ENGINE=docker|podman.
set -euo pipefail

IMAGE="${CSTAR_IMAGE:-cstar-dev}"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

ENGINE="${CSTAR_ENGINE:-}"
if [ -z "$ENGINE" ]; then
  if command -v podman >/dev/null 2>&1; then ENGINE=podman
  elif command -v docker >/dev/null 2>&1; then ENGINE=docker
  else echo "cdev: need podman or docker on PATH" >&2; exit 1; fi
fi

# Non-interactive container run (for scripted commands).
run_ni() { "$ENGINE" run --rm -v "$ROOT:/work" -w /work "$IMAGE" "$@"; }
# Interactive container run (for a shell).
run_it() { "$ENGINE" run --rm -it -v "$ROOT:/work" -w /work "$IMAGE" "$@"; }

cmd="${1:-}"; shift || true
case "$cmd" in
  build-image) "$ENGINE" build -t "$IMAGE" "$ROOT" ;;
  make)        run_ni make "$@" ;;
  test)        run_ni ./run_tests.sh "$@" ;;
  exec)        [ "$#" -gt 0 ] || { echo "cdev exec: missing command" >&2; exit 2; }; run_ni "$@" ;;
  sh|shell)    run_it bash ;;
  *) echo "usage: cdev {build-image|make|test|exec <cmd...>|sh}" >&2; exit 2 ;;
esac
