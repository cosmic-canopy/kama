#!/usr/bin/env bash
# Generate docs/grammar.bnf from kama.y — the Bison grammar is the single source
# of truth (the "self-describing" goal). Extracts the rules section (between the
# %% markers) and strips the C++ semantic-action { ... } blocks, leaving clean BNF.
#
# Usage: tools/gen-grammar [output-file]   (default: docs/grammar.bnf)
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SRC="$ROOT/src/kama.y"
OUT="${1:-$ROOT/docs/grammar.bnf}"
mkdir -p "$(dirname "$OUT")"

{
  echo "// kama grammar (BNF) — GENERATED from src/kama.y by tools/gen-grammar. Do not edit."
  echo "// The Bison grammar is the source of truth; regenerate after any grammar change."
  echo
  awk '
    /^%%/ { sec++; next }            # 0=declarations, 1=rules, 2=C epilogue
    sec==1 {
      line=$0; out=""; n=length(line)
      for (i=1; i<=n; i++) {
        c = substr(line, i, 1)
        if (depth > 0) { if (c=="{") depth++; else if (c=="}") depth--; continue }
        if (c=="{") { depth++; continue }
        out = out c
      }
      sub(/[ \t]+$/, "", out)
      print out
    }
  ' "$SRC" | cat -s
} > "$OUT"

echo "wrote $OUT"
