// The library surface. This file sits at the top of `source`, so it is in the project's ROOT module —
// the one `kama.json`'s `name` names — and `export` is what importers can see:
// `import KAMA_SEED_IDENT::{ answer };`
//
// To add a module, make a folder under `source` and list it in `modules`. A folder with no entry is not
// a module: its files belong to the nearest listed folder above them, so nothing joins your API by
// accident.

export { answer };

fn int32 answer()
{
    return 42;
}
