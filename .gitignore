.DS_store
*.o
*.bc
bison_report
*.llvm.bak

# all build artifacts (objects + generated parser/lexer) live here
build/

# per-machine local manifest override (deep-merges over kama.json; dev-local, never committed — see M5)
kama.local.json
**/kama.local.json

# fetched native SDKs (wgpu-native for native --webgpu) — never vendored; tools/fetch-webgpu.sh fills it
third_party/

# the root compiler binary (anchored to root so it doesn't also ignore bench/src/kama/)
/kama

# generated C from `./kama build foo.kama` without -o (lands next to the source as foo.c);
# anchored to root so hand-written C in tests/webgpu/ and bench/src/c/ stays tracked
/*.c

# build output / generated transpiler artifacts
out/
*.wasm
*.html
*.js
# hand-written stdlib JS glue (emcc --js-library) — source, not build output
!lib/std/net/web/*.js
# hand-written test support scripts (e.g. the WebSocket echo server), not build output
!tests/support/*.js
# generated C from `kama transpile`/`build` (keep generated .c out of the tree)
tests/**/*.c
!tests/webgpu/smoke.c
# multi-unit build intermediates + the shared header a `kama build` emits next to -o
tests/**/*.c.tmp
tests/**/*.gen.h
# Top-level tests/ is SOURCE ONLY — ignore every direct-child build artifact (compiled fixture binaries a
# bare `kama build tests/x.kama` drops next to the source — a stem with NO extension — plus generated .c/
# .gen.h). Subdirs (support/, webgpu/, xfail/, *.d/) are un-ignored so their own tracked files stay tracked.
tests/*
!tests/*.kama
!tests/*.expect
!tests/*.msg
!tests/*/

# benchmark build artifacts
bench/build/

# dotnet build output (lands in the bind-mounted bench source dir)
bench/src/csharp/bin/
bench/src/csharp/obj/

# qemu core dumps (from emulated-arch crashes)
*.core

# benchmark JS sources are real (override the global *.js ignore)
!bench/src/js/*.js
# the VSCode extension's hand-written JS is real, too
!editor/vscode/*.js
# the website sources are real (override the global *.html/*.js ignores)
!site/**
*.wasm.map
*.wasm

# local secrets — seed from .env.example
.env
# assembled site output (from tools/build-site) and packaged extension
/_site/
*.vsix
