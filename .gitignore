.DS_store
*.o
*.bc
bison_report
*.llvm.bak

# all build artifacts (objects + generated parser/lexer) live here
build/

# the root compiler binary (anchored to root so it doesn't also ignore bench/src/kama/)
/kama

# generated C from `./kama build foo.kama` without -o (lands next to the source as foo.c);
# anchored to root so hand-written C in tests/webgpu/ and bench/src/c/ stays tracked
/*.c

# build output / generated transpiler artifacts
out/
*.wasm
*.html
*.js
# generated C from `kama transpile`/`build` (keep generated .c out of the tree)
tests/**/*.c
!tests/webgpu/smoke.c

# benchmark build artifacts
bench/build/

# dotnet build output (lands in the bind-mounted bench source dir)
bench/src/csharp/bin/
bench/src/csharp/obj/

# qemu core dumps (from emulated-arch crashes)
*.core

# benchmark JS sources are real (override the global *.js ignore)
!bench/src/js/*.js
# the VSCode extension's hand-written JS is real, too
!editor/vscode/*.js
*.wasm.map
*.wasm
